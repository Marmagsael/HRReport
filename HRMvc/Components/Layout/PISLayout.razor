@* -- Razor version of Views/Shared/_PISLayout.cshtml : header + PIS left menu + page (static SSR) -- *@
@inherits LayoutComponentBase
@using HRMvc.StartupConfig
@inject UserClaimsContextService ClaimsContext
@inject NavigationManager Nav
@inject PisAccessService Access

<div class="main-wrapper d-flex flex-column vh-100 w-100 bg-light">

    <!-- 🔹 HEADER -->
    <header class="bg-gray-10 txt-white sticky-top p-0 ">
        <ReportHeader Uc="userClaims" />
    </header>

    <!-- 🔹 BODY -->
    <div class="d-flex flex-grow-1 w-100 p-0 ">

        <!-- 🔹 LEFT MENU -->
        <div class="rail-slot">
            <aside class="rail border-end bg-white floating-panel">
                <PISLeftMenu Uc="userClaims" />
            </aside>
        </div>

        <!-- 🔹 MAIN CONTENT -->
        <main class="bg-gray-95 overflow-auto w-100 flex-fill  bg-gray-95 ">
            @if (denied)
            {
                <div class="p-4 txt-red">You do not have access to this module. Please ask your administrator to grant it in PIS User Management.</div>
            }
            else
            {
                @Body
            }
        </main>

    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    UserClaimsModel? userClaims;

    bool denied;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext == null) return;
        userClaims = ClaimsContext.Build(HttpContext.User);

        var parts = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/');
        if (parts.Length == 2 && parts[0] == "14" && int.TryParse(parts[1], out var id))
            denied = !await Access.CanOpenAsync(HttpContext.User, id);
    }
}
