@* -- From Views/Shared/Main/ReportLayout/_ReportLeftMenu.cshtml : same HTML / CSS classes.
      The <li class="menu-item"> blocks the .cshtml left open are closed here (Razor components need closed tags);
      browsers closed them at </ul> anyway, so the page is the same. -- *@
@inject IMainmenuDataAccess _menu

<!-- Custom CSS -->
<link rel="stylesheet" href="css/ReportLayout/report-left-menu.css" />


