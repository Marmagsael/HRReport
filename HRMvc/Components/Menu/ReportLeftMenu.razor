<style>
    .report-menu-section-header {
        background-color: #f1f3f5;
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 10px 12px;
        border-bottom: 1px solid #e9ecef;
    }
</style>

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    List<MainmenuModel?> menus      = new();
    List<MainmenuModel?> menuspay   = new();
    List<MainmenuModel?> menuspis   = new();

    // -- Load the menu lists once --
    protected override async Task OnInitializedAsync()
    {
        menus       = await _menu._02("Main",    Uc?.Conn ?? "") ?? [];
        menuspay    = await _menu._02("MainPay", Uc?.Conn ?? "") ?? [];
        menuspis    = await _menu._02("MainPis", Uc?.Conn ?? "") ?? [];
    }
}
