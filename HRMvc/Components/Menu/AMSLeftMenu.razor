@inject IMainmenuDataAccess _menu
@inject HRMvc.StartupConfig.AmsAccessService _access

<link rel="stylesheet" href="css/ReportLayout/report-left-menu.css" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

<div class="leftmenu-header pis-leftmenu-header ">
    <h6>AMS System</h6>
</div>

<div class="report-left-menu">
    <ul>
        @if (HttpContext != null && !HRMvc.StartupConfig.CompanyRole.IsEmployee(HttpContext.User))
        {
            <div class="text-primary" style="background-color: lightgrey;">
                <ReportLeftMenuMain Menus="menus" ParentId="1501" />
            </div>
        }
        <ReportLeftMenuMainParentDtl Menus="menus" ParentId="1001" />
    </ul>
</div>

<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-folder-open fs-5"></i>
                    <span>Management</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menusPay" ParentId="11001" />
                <ReportLeftMenuDtl1 Menus="menusPay" ParentId="11101" />
                <ReportLeftMenuDtl1 Menus="menusPay" ParentId="11301" />
            </ul>
        </li>
    </ul>
</div>

<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-receipt fs-5"></i>
                    <span>Transaction</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menusPay" ParentId="11201" />
            </ul>
        </li>
    </ul>
</div>

<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-file-lines fs-5"></i>
                    <span>Report Module</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menusPay" ParentId="13001" />
            </ul>
        </li>
    </ul>
</div>

<style>
    .report-menu-section-header {
        background-color: #f1f3f5;
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 10px 12px;
        border-bottom: 1px solid #e9ecef;
    }
</style>

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    List<MainmenuModel?> menus      = new();
    List<MainmenuModel?> menusPay   = new();

    protected override async Task OnInitializedAsync()
    {
        menus       = await _menu._02("Main", Uc?.Conn ?? "") ?? [];
        menusPay    = await _menu._02("MainPay", Uc?.Conn ?? "") ?? [];
        if (HttpContext != null)
        {
            var allowed = await _access.AllowedMenuIdsAsync(HttpContext.User);
            menusPay    = HRMvc.StartupConfig.PisAccessService.Filter(menusPay, allowed);
        }
    }
}
