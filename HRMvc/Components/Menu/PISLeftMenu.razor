@* -- From Views/Shared/PIS/_PISLeftMenu.cshtml : same HTML / CSS classes -- *@
@inject IMainmenuDataAccess _menu

<!-- Custom CSS -->
<link rel="stylesheet" href="css/ReportLayout/report-left-menu.css" />

<div class="leftmenu-header pis-leftmenu-header ">
    <h6>PIS System</h6>
</div>

@* --- Employee Portal Menus --- *@
<div class="report-left-menu">
    <ul>
        @*---- System Application : not for an Employee (portal only) ----*@
        @if (HttpContext != null && !HRMvc.StartupConfig.CompanyRole.IsEmployee(HttpContext.User))
        {
            <div class="text-primary">
                <ReportLeftMenuMain Menus="menus" ParentId="1501" />
            </div>
        }
        <ReportLeftMenuMainParentDtl Menus="menus" ParentId="1001" />
    </ul>
</div>

@* --- Management --- *@
<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid  fa-folder-open fs-5"></i>
                    <span>Management</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2001" />
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2051" />
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2401" />
            </ul>
        </li>
    </ul>
</div>

@* --- Transaction --- *@
<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-receipt fs-5"></i>
                    <span>Transaction</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2301" />
            </ul>
        </li>
    </ul>
</div>

@* --- Report --- *@
<div class="report-left-menu w-100p">
    <ul>
        <li class="menu-item">
            <a href="#" onclick="event.preventDefault();">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-file-lines fs-5"></i>
                    <span>Report Module</span>
                </div>
                <i class="fa fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2101" />
                <ReportLeftMenuDtl1 Menus="menuspis" ParentId="2201" />
            </ul>
        </li>
    </ul>
</div>

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    List<MainmenuModel?> menus      = new();
    List<MainmenuModel?> menuspis   = new();

    // -- Load the menu lists once --
    protected override async Task OnInitializedAsync()
    {
        menus       = await _menu._02("Main", Uc?.Conn ?? "") ?? [];
        menuspis    = await _menu._02("MainPis", Uc?.Conn ?? "") ?? [];
    }
}
