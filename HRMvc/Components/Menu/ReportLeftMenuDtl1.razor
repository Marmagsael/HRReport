@* -- From Views/Shared/Main/ReportLayout/_ReportLeftMenuDtl1.cshtml -- *@
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />


@if (menuParent != null && menuDtls.Any())
{
    <li class="menu-item">
        <a href="#" onclick="event.preventDefault();">
            <div class="d-flex justify-content-between">
                <div class="d-flex gap-2">
                    <span class="material-symbols-outlined">@menuParent.Icon</span>
                    <span>@menuParent.DispText</span>
                </div>

                <i class="fa fa-chevron-right arrow"></i>
            </div>
        </a>

        <ul class="submenu">
            @foreach (var d in menuDtls)
            {
                if (d!.Type == "NoAccess")
                {
                    <li title="No access">
                        <div class="d-flex align-items-center p-1 gap-2" style="display:block;padding:9px 14px;color:#9ca3af;cursor:not-allowed;font-size:13px;">
                            <span class="material-symbols-outlined">@d.Icon</span>
                            @d.DispText
                        </div>
                    </li>
                    continue;
                }
                if (d!.Type == "Separator")
                {
                    <li class="menu-separator"><hr style="margin:1px 10px;border:0;border-top:1px solid #9ca3af;opacity:1;" /></li>
                    continue;
                }
                <li>
                    <a href="@d!.Action">
                        <div class="d-flex align-items-center p-1 gap-2">
                            <span class="material-symbols-outlined">@d.Icon</span>
                            @d.DispText
                        </div>
                    </a>
                </li>
            }
        </ul>
    </li>
}

@code {
    [Parameter] public List<MainmenuModel?> Menus { get; set; } = new();
    [Parameter] public int ParentId { get; set; }

    MainmenuModel? menuParent => Menus.FirstOrDefault(m => m?.Id == ParentId);
    List<MainmenuModel?> menuDtls => Menus.Where(m => m?.IdParent == ParentId && (!string.IsNullOrEmpty(m.Action) || m.Type == "Separator")).ToList();
}
