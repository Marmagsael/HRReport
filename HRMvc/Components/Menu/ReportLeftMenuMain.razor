@* -- From Views/Shared/Main/ReportLayout/_ReportLeftMenuMain.cshtml -- *@
@if (menuParent != null && menuDtls.Any())
{
    @foreach (var d in menuDtls)
    {
        <li class="menu-item">
            <a href="@d!.Action">
                <div class="d-flex align-items-center p-1 gap-2">
                    <i class="@d.Icon fs-6"></i>
                    @d.DispText
                </div>
            </a>
        </li>
    }
}

@code {
    [Parameter] public List<MainmenuModel?> Menus { get; set; } = new();
    [Parameter] public int ParentId { get; set; }

    MainmenuModel? menuParent => Menus.FirstOrDefault(m => m?.Id == ParentId);
    List<MainmenuModel?> menuDtls => Menus.Where(m => m?.IdParent == ParentId && !string.IsNullOrEmpty(m.Action)).ToList();
}
