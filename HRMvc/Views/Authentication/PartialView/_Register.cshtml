@model HRMvc.Models.Authentication.RegisterUiModel;
@{
    var CoName = ViewData["CoName"];
    var exclusive = ViewData["Exclusive"] as String;
}

<style>
    .login-input {
        border: 1px solid #d1d5db;
        border-radius: 4px;
        padding: .75rem .9rem;
        font-size: .95rem;
        background: #fff;
        transition: all .15s ease;
    }

    .login-input:focus {
        border-color: #2563eb !important; 
        box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        outline: none;
    }

    .btn-login {
        background: #2563eb;
        border: none;
        border-radius: 4px;
        padding: .8rem;
        font-weight: 600;
        font-size: .95rem;
        color: #fff;
        transition: all .15s ease;
    }

        .btn-login:hover {
            background: #1d4ed8 ;
            color: #fff;
        }

    .form-label-sm {
        font-size: .8rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: .5rem;
    }
</style>

<div class="main-body-center-content">

    @*---- HEADER ----*@
    <div class="main-body-center-content-hdr">
        <h1 class="page-title">Welcome to @CoName</h1>
        <p class="body-text-lg mt-2">Please fill out all the fields to register an account with your employee number.</p>
    </div>

    @*---- BODY ----*@
    <div class="main-body-center-content-body">
        <form>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @*---- EMPLOYEE NUMBER ----*@
            <div class="form-group mb-3">
                <label asp-for="EmpNumber" class="form-label-sm d-block"></label>
                <input asp-for="EmpNumber" class="form-control login-input" />
                <span asp-validation-for="EmpNumber" class="err-input-msg text-danger small"></span>
            </div>

            @if (exclusive == "true")
            {
                @*---- COMPANY ----*@
                <div class="form-group mb-3">
                    <label asp-for="CompanyId" class="form-label-sm d-block"></label>
                    <select asp-for="CompanyId" class="form-select login-input">
                        <option value="MySqlConn">GSIA</option>
                        <option value="MySqlConnBF">Blueflame</option>
                        <option value="MySqlConnGIMEL">GIMEL</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="err-input-msg text-danger small"></span>
                </div>
            }

            @* <div class="row"> *@
                @*---- Deployment Code ----
                @* <div class="form-group col-md-6 mb-3"> *@
                    @* <label asp-for="Position_" class="form-label-sm d-block"></label> *@
                    @* <input asp-for="Position_" class="form-control login-input" /> *@
                    @* <span asp-validation-for="Position_" class="err-input-msg text-danger small"></span> *@
                @* </div> *@
                @*---- Latest Movement No. ----*@
                @* <div class="form-group col-md-6 mb-3"> *@
                    @* <label asp-for="MovNumber" class="form-label-sm d-block"></label> *@
                    @* <input asp-for="MovNumber" class="form-control login-input" /> *@
                    @* <span asp-validation-for="MovNumber" class="err-input-msg text-danger small"></span> *@
                @* </div> *@
            @* </div> *@

            @* <div class="row"> *@
                @*---- Sec License ----*@
                @* <div class="form-group col-md-6 mb-3"> *@
                    @* <label asp-for="SecLicense" class="form-label-sm d-block"></label> *@
                    @* <input asp-for="SecLicense" class="form-control login-input" /> *@
                    @* <span asp-validation-for="SecLicense" class="err-input-msg text-danger small"></span> *@
                @* </div> *@
                @*---- Date Hired ----*@
                @* <div class="form-group col-md-6 mb-3"> *@
                    @* <label asp-for="DateHired" class="form-label-sm d-block"></label> *@
                    @* <input asp-for="DateHired" class="form-control login-input" type="date" /> *@
                    @* <span asp-validation-for="DateHired" class="err-input-msg text-danger small"></span> *@
                @* </div> *@
            @* </div> *@ 

            @* ---- PASSWORD ---- *@
            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label-sm d-block"></label>
                <input asp-for="Password" class="form-control login-input" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            @* ---- Confirm Password ---- *@
            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="form-label-sm d-block"></label>
                <input asp-for="ConfirmPassword" class="form-control login-input" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            @* ---- REGISTER BUTTON ---- *@
            <div class="auth-primary-cta">
                <button type="submit" class="btn btn-login w-100">
                    Register <i class="fa-solid fa-arrow-right ms-1" style="font-size:.8rem;"></i>
                </button>
            </div>
        </form>

        @* ---- LOGIN LINK ---- *@
        <div class="register-empno-link-wrapper text-center mt-3" style="font-size:.875rem; color:#6b7280;">
            Already have an account?
            <a asp-controller="Authentication" asp-action="Login" class="fw-semibold text-decoration-none ms-1" style="color:#2563eb;">Login</a>
        </div>
    </div>

    @* @*---- FOOTER ---- *@ 
    <div class="main-body-center-content-footer">© 2023 All Rights Reserved.</div>
</div>