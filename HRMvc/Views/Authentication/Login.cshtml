@model HRMvc.Models.Authentication.LoginUiModel

@{
    Layout              = "~/Views/Shared/Authentication/_AuthenticationLayout.cshtml";
    var coName   = ViewData["CoName"];
    var exclusive       = ViewData["Exclusive"] as String;
    string register     = "register";
    if (exclusive       != "true") register = "registerOrdinary";

    string? errorMsg    = ViewData["ErrorMsg"] as String;
}



@*---- MAIN BODY ----*@
<div class="position-relative bg-white w-100 h-100 d-flex overflow-hidden">
    <div class="right  rounded col-12 col-lg-7 p-3 p-lg-4 d-flex flex-column align-items-center h-100 gap-5 ">
        <div class="backdrop d-flex flex-column h-100">
            <div class="border-bottom border-2 text-center w-100 p-1">
                <h1 >@coName</h1>
                <div class="bg-success mt-2" style="height:5px">&nbsp;</div>
            </div>

            <div class="d-flex flex-column justify-content-center align-items-center  w-100 h-100">

                <div class="d-flex flex-column gap-5 form-width ">
                    <div>
                        <h2 class="page-title">Employee Portal Access</h2>
                        <p class="body-text-lg mt-2">Enter your credentials below to access your account</p>
                    </div>


                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2"
                             style="background:#fef2f2; border:1px solid #fecaca; border-radius:4px; color:#b91c1c; font-size:.875rem;">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>@errorMsg</span>
                        </div>
                    }


                    <form id="loginForm" action="/login" method="post" class="d-flex gap-5 flex-column">
                        <div>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            @*---- EMAIL ----*@
                            <div class="form-group d-md-flex mb-2">
                                <label asp-for="Email" class="control-label flex-nowrap w-200p" style=" width: 200px; font-weight: 500;"></label>
                                <div class="w-100">
                                    <input asp-for="Email" type="email" class="form-control " />
                                    <span asp-validation-for="Email" class="err-input-msg text-danger"></span>
                                </div>
                            </div>
                            @*---- PASSWORD ----*@
                            <div class="form-group d-md-flex">
                                <label asp-for="Password" class="control-label flex-nowrap  w-200p" style=" width: 200px; font-weight: 500;"></label>
                                <div class="w-100">
                                    <input asp-for="Password" class="form-control " />
                                    <span asp-validation-for="Password" class="err-input-msg text-danger"></span>
                                </div>
                            </div>
                            @*---- COMPANY ----*@
                            @*<div class="form-group d-md-flex">
                                <label asp-for="CompanyId" class="control-label"></label>
                                <div class="w-100">
                                    <select asp-for="CompanyId" class="form-control">
                                        <option value="MySqlConn">GSIA</option>
                                        <option value="MySqlConnBF">Blueflame</option>
                                        <option value="MySqlConnGIMEL">GIMEL</option>
                                    </select>
                                    <span asp-validation-for="CompanyId" class="err-input-msg text-danger"></span>
                                </div>
                            </div>*@
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @*---- LOGIN BUTTON ----*@
                            <input type="submit" value="Login" class="btn b-btn-primary w-100" />
                        </div>
                    </form>

                    @*---- REGISTER ----*@
                    <div class="text-center small">
                        Don't have an account? <a href="~/signup" style="color:#047959; font-weight:600; text-decoration:none;">Create an account</a>
                    </div>

                </div>
            </div>

            <div class="mt-auto border rounded p-3" style="background:#e6f2ee">
                <p class="small">
                    <b>Disclaimer : </b>
                    This commercial application contains proprietary and confidential information of <b>@coName</b> 
                    Access is limited to authorized users only. Use of this system constitutes consent to monitoring and 
                    compliance with applicable data protection and privacy laws.
                </p>
            </div>
        </div>

    </div>

    <div class="left border border-left col-12 col-lg-5" style="padding-top: 95px; background:#047959;">
        <div class="bg-white p-md-3 h-100" >
            <h2 class="p-3 text-center">Business Solution Application</h2>
            <div class="card rounded" >
                <img src="~/images/login-bg.jpg" class="h-100 opacity-75" style="object-fit:cover">
            </div>
        </div>
    </div>
</div>

@* --- Login loading overlay : shown on submit, stays until the next page loads ------------- *@
<div id="loginLoading" class="login-loading" aria-live="polite" aria-hidden="true">
    <div class="login-loading-box">
        <div class="login-loading-rings">
            <span></span><span></span><span></span>
            <i class="fa-solid fa-user-shield"></i>
        </div>
        <div class="login-loading-title">Signing you in</div>
        <div id="loginLoadingMsg" class="login-loading-msg">Verifying your account…</div>
        <div class="login-loading-bar"><div></div></div>
    </div>
</div>

<style>
    .login-loading {
        position: fixed; inset: 0; z-index: 2000;
        display: flex; align-items: center; justify-content: center;
        background: rgba(220, 224, 228, .20);
        backdrop-filter: blur(2px);
        opacity: 0; visibility: hidden;
        transition: opacity .25s ease, visibility .25s ease;
    }
    .login-loading.show { opacity: 1; visibility: visible; }

    .login-loading-box {
        width: 300px; padding: 28px 24px 22px;
        background: #fff; border-radius: 14px; text-align: center;
        box-shadow: 0 18px 50px rgba(0,0,0,.25);
        transform: translateY(8px) scale(.98);
        transition: transform .25s ease;
    }
    .login-loading.show .login-loading-box { transform: none; }

    .login-loading-rings { position: relative; width: 84px; height: 84px; margin: 0 auto 16px; }
    .login-loading-rings span {
        position: absolute; inset: 0; border-radius: 50%;
        border: 4px solid transparent; border-top-color: #047959;
        animation: login-spin 1.1s cubic-bezier(.5,.1,.5,.9) infinite;
    }
    .login-loading-rings span:nth-child(2) { inset: 10px; border-top-color: #34b38a; animation-duration: 1.5s; animation-direction: reverse; }
    .login-loading-rings span:nth-child(3) { inset: 20px; border-top-color: #9ad9c3; animation-duration: 1.9s; }
    .login-loading-rings i {
        position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        color: #047959; font-size: 18px;
    }

    .login-loading-title { font-weight: 600; font-size: 1.05rem; color: #1f2d27; }
    .login-loading-msg   { font-size: .85rem; color: #6b7a74; min-height: 1.3em; margin-top: 2px; transition: opacity .2s; }

    .login-loading-bar { height: 4px; margin-top: 16px; border-radius: 4px; background: #e6f2ee; overflow: hidden; }
    .login-loading-bar div {
        width: 40%; height: 100%; border-radius: 4px; background: #047959;
        animation: login-bar 1.4s ease-in-out infinite;
    }

    @@keyframes login-spin { to { transform: rotate(360deg); } }
    @@keyframes login-bar  { 0% { transform: translateX(-110%); } 100% { transform: translateX(260%); } }

    @@media (prefers-reduced-motion: reduce) {
        .login-loading-rings span, .login-loading-bar div { animation-duration: 3s; }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const form    = document.getElementById('loginForm');
            const overlay = document.getElementById('loginLoading');
            const msgEl   = document.getElementById('loginLoadingMsg');
            const steps   = ['Verifying your account…', 'Loading your company…', 'Preparing your workspace…', 'Almost there…'];
            let timer     = null;

            function show() {
                let i = 0;
                msgEl.textContent = steps[0];
                overlay.classList.add('show');
                overlay.setAttribute('aria-hidden', 'false');
                timer = setInterval(() => {
                    i = Math.min(i + 1, steps.length - 1);
                    msgEl.style.opacity = 0;
                    setTimeout(() => { msgEl.textContent = steps[i]; msgEl.style.opacity = 1; }, 200);
                }, 2500);
            }

            function hide() {
                clearInterval(timer);
                overlay.classList.remove('show');
                overlay.setAttribute('aria-hidden', 'true');
            }

            form.addEventListener('submit', function () {
                // --- skip when client-side validation fails
                if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) return;
                show();
            });

            // --- coming back with the browser Back button : don't leave the overlay up
            window.addEventListener('pageshow', hide);
        })();
    </script>
 }

