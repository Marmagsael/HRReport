@inject Microsoft.Extensions.Configuration.IConfiguration _cfg
@model (List<HRApiLibrary.Models._90_Utils.MainmenuModel?> Menus, int ParentId)
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />


@{
    var menuParent = Model.Menus.FirstOrDefault(m => m?.Id == Model.ParentId);
    var menuDtls = Model.Menus
        .Where(m => m?.IdParent == Model.ParentId && (!string.IsNullOrEmpty(m.Action) || m.Type == "Separator"))
        .ToList();
    if (menuParent == null || !menuDtls.Any()) { return; }
}

<li class="menu-item">
    <a href="#" onclick="event.preventDefault();">
        <div class="d-flex justify-content-between">
            <div class="d-flex gap-2">
                @*<i class="@menuParent.Icon"></i>*@
                <span class="material-symbols-outlined">@menuParent.Icon</span>
                <span>@menuParent.DispText</span>
            </div>

            <i class="fa fa-chevron-right arrow"></i>
            @* <span class="arrow">?</span> *@
        </div>
    </a>

    <ul class="submenu">
        @foreach (var d in menuDtls)
        {
            if (d!.Type == "Separator")
            {
                <li class="menu-separator"><hr style="margin:4px 10px;border:0;border-top:1px solid #9ca3af;opacity:1;" /></li>
                continue;
            }
            <li>
                <a href="@d!.Action">
                    <div class="d-flex align-items-center p-1 gap-2">
                        @* <i class="@d.Icon"></i> *@
                        <span class="material-symbols-outlined">@d.Icon</span>
                        @(d.Action == "14/2053" && string.Equals(_cfg["CompanyInfo:IsSecurityAgency"], "true", StringComparison.OrdinalIgnoreCase) ? "Client Entry" : d.DispText)
                    </div>
                </a>
            </li>
        }
    </ul>
</li>
