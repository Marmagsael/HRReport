@model (List<HRApiLibrary.Models._90_Utils.MainmenuModel?> Menus, int ParentId)

@{
    var menuParent = Model.Menus
        .FirstOrDefault(m => m?.Id == Model.ParentId);

    var menuDtls = Model.Menus
        .Where(m => m?.IdParent == Model.ParentId)
        .ToList();
}

@if (menuParent != null && menuDtls.Any())
{
    <li class="fw-semibold mb-1 d-flex align-items-center gap-2">
        <i class="rz-icon rz-icon-@menuParent.Icon"></i>
        <span>@menuParent.DispText</span>
    </li>

    <ul class="list-unstyled ps-4 mb-2">
        @foreach (var d in menuDtls)
        {
            <li class="py-1">
                <a href="@d!.Action" class="d-flex align-items-center gap-2 text-decoration-none disabled">

                    <i class="rz-icon rz-icon-@d.Icon"></i>
                    <span>@d.DispText</span>

                </a>
            </li>
        }
    </ul>
}