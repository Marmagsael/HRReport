@model (List<HRApiLibrary.Models._90_Utils.MainmenuModel?> Menus, int ParentId)

@{
    var menuParent = Model.Menus.FirstOrDefault(m => m?.Id == Model.ParentId);
    var menuDtls = Model.Menus
        .Where(m => m?.IdParent == Model.ParentId && !string.IsNullOrEmpty(m.Action))
        .ToList();
    if (menuParent == null || !menuDtls.Any()) { return; }
}

<li class="menu-item">
    <a href="#" onclick="event.preventDefault();">
        <div class="d-flex justify-content-between">
            <div class="d-flex gap-2">
                @*<i class="@menuParent.Icon"></i>*@
                <span class="material-symbols-outlined">@menuParent.Icon</span>
                <span>@menuParent.DispText</span>
            </div>

            <i class="fa fa-chevron-right arrow"></i>
            @* <span class="arrow">▶</span> *@
        </div>
    </a>

    <ul class="submenu">
        @foreach (var d in menuDtls)
        {
            <li>
                <a href="@d!.Action">
                    <div class="d-flex align-items-center p-1 gap-2">
                        @*<i class="@d.Icon"></i>*@
                        <span class="material-symbols-outlined">@d.Icon</span>
                        @d.DispText 
                    </div>
                </a>
            </li>
        }
    </ul>
</li>
