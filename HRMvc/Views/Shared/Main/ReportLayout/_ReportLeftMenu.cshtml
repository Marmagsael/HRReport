@model HRApiLibrary.Models._00_Main.UserClaimsModel

@using HRApiLibrary.DataAccess._90_Utils
@inject IMainmenuDataAccess _menu

@{
    // Load menu list ONCE
    var menus    = await _menu._02("Main", Model.Conn ?? "") ?? [];
    var menuspay = await _menu._02("MainPay", Model.Conn ?? "") ?? [];
    var menuspis = await _menu._02("MainPis", Model.Conn ?? "") ?? [];

    const string childCshtmlMain    = "~/Views/Shared/Main/ReportLayout/_ReportLeftMenuMain.cshtml";
    const string childCshtmlMainDtl = "~/Views/Shared/Main/ReportLayout/_ReportLeftMenuMainDtl.cshtml";
    const string childCshtml        = "~/Views/Shared/Main/ReportLayout/_ReportLeftMenuDtl1.cshtml";
}

<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/ReportLayout/report-left-menu.css" />

@* =======================================================================================*@
@* --- Employee Portal Menus -------------------------------------------------------------*@
@* =======================================================================================*@
<div class=" bg-primary text-white p-2"> Employee Portal </div>
<div class="report-left-menu">
    <ul>
        @await Html.PartialAsync(childCshtmlMain,    (menus, 1101))
        @await Html.PartialAsync(childCshtmlMainDtl, (menus, 1201)) 
        @await Html.PartialAsync(childCshtmlMainDtl, (menus, 1301)) 
    </ul>
</div>



@* =======================================================================================*@
@* --- PIS Report ------------------------------------------------------------------------*@
@* =======================================================================================*@
<div class=" bg-secondary text-white p-2">PIS System</div>
<div class="report-left-menu">
    <ul>
        @await Html.PartialAsync(childCshtml, (menuspis, 2101))
        @await Html.PartialAsync(childCshtml, (menuspis, 2201))
    </ul>
</div>

@* =======================================================================================*@
@* --- Payroll Report --------------------------------------------------------------------*@
@* =======================================================================================*@
<div class=" bg-success text-white p-2">Payroll System</div>
<div class="report-left-menu">
    <ul>
        @await Html.PartialAsync(childCshtml, (menuspay, 1101))
        @await Html.PartialAsync(childCshtml, (menuspay, 1151))
        @await Html.PartialAsync(childCshtml, (menuspay, 1201))
        @await Html.PartialAsync(childCshtml, (menuspay, 1251))
        @await Html.PartialAsync(childCshtml, (menuspay, 1301))
    </ul>
</div>





