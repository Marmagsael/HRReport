@model (List<HRApiLibrary.Models._90_Utils.MainmenuModel?> Menus, int ParentId)

@{
    var menuParent = Model.Menus.FirstOrDefault(m => m?.Id == Model.ParentId);
    var menuDtls = Model.Menus
        .Where(m => m?.IdParent == Model.ParentId && !string.IsNullOrEmpty(m.Action))
        .ToList();
    if (menuParent == null || !menuDtls.Any()) { return; }
}

<li class="menu-item bordered ">
    
    <a class=" bg-secondary text-white " href="#"  onclick="event.preventDefault();">
        <div class="d-flex gap-2">
            @* <i class="@menuParent.Icon fs-5 txt mb-a-lightblue "></i> *@
            <span class="fs-6" >@menuParent.DispText</span>
        </div>
        
        <i class="fa fa-chevron-right arrow text-white "></i>
    </a>


    <ul class="submenu">
        @foreach (var d in menuDtls)
        {
            <li>
                <a  href="@d!.Action" class=" border-bottom ">
                    <div class="d-flex align-items-center p-1 gap-2">
                        <i class="@d.Icon fs-6"></i>
                        @d.DispText 
                    </div>
                </a>
            </li>
        }
    </ul>
</li>
