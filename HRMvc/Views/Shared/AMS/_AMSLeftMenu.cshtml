    const string? childCshtmlMain           = "~/Views/Shared/AMS/_AMSLeftMenuMain.cshtml";
    const string? childCshtmlMain1          = "~/Views/Shared/ReportLayout/_ReportLeftMenuMain.cshtml";
    const string? childCshtmlMainDtl        = "~/Views/Shared/ReportLayout/_ReportLeftMenuMainDtl.cshtml";
    const string? childCshtml               = "~/Views/Shared/ReportLayout/_ReportLeftMenuDtl1.cshtml";

    var IsExclusiveCompany = User.Claims.Where(c => c.Type == "IsExclusiveCompany").FirstOrDefault();
}

<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/ReportLayout/report-left-menu.css" />


@* =======================================================================================*@
