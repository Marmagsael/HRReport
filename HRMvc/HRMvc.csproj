<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Core Settings -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>20bd3c22-c82f-40ee-9fe3-601760111754</UserSecretsId>

    <!-- Suppressed Warnings -->
    <NoWarn>
      CS0168;
      CS0169;
      CS0219;
      CS0414;
      CS0649;
      CS0162;
      CS1998;
      CS1591;
      CS1573;
      CS8600;
      CS8601;
      CS8602;
      CS8604;
      CS8618;
      CS8622;
      CS0618
    </NoWarn>
  </PropertyGroup>

  <!-- ✅ WATCH CONFIG (FIXED PLACEMENT) -->
  <ItemGroup>
    <Watch Include="**\*.cs" />
    <Watch Include="**\*.razor" />
    <Watch Include="**\*.cshtml" />

    <Watch Remove="bin\**\*" />
    <Watch Remove="obj\**\*" />
  </ItemGroup>

  <!-- Reports -->
  <ItemGroup>
    <Content Update="Reports\**\*.trdp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 🔥 Custom Views (Applications folder) -->
  <ItemGroup>
    <Content Update="Applications\**\*.cshtml">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Packages -->
  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Blazored.SessionStorage" Version="2.4.0" />
    <PackageReference Include="Blazorise" Version="1.6.1" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="FastReport.OpenSource" Version="2024.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="6.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="6.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Radzen.Blazor" Version="4.33.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
    <PackageReference Include="Telerik.Drawing.Skia" Version="19.3.25.1119" />
    <PackageReference Include="Telerik.Reporting" Version="19.3.25.1119" />
    <PackageReference Include="Telerik.Reporting.OpenXmlRendering" Version="19.3.25.1119" />
    <PackageReference Include="Telerik.Reporting.Services.AspNetCore" Version="19.3.25.1119" />
  </ItemGroup>

  <!-- Project Reference -->
  <ItemGroup>
    <ProjectReference Include="..\HRApiLibrary\HRApiLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Applications\PisModules\Vars\" />
    <Folder Include="Filters\" />
  </ItemGroup>

</Project>