@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Modules._100O
@using Telerik.Blazor.Components

@inject IDA_100O _da

<style>
    .pr-root { font-size:13px; color:#1f2a37; }
    .pr-intro { color:#5b6573; margin-bottom:12px; max-width:900px; }
    .pr-sum { font-weight:700; margin-bottom:10px; }
    .pr-card { background:#fff; border:1px solid #7d8895; border-radius:6px; }
    .pr-row { display:grid; grid-template-columns:34px minmax(0,1.1fr) minmax(0,1.6fr) 110px 230px; gap:12px; align-items:center; padding:11px 16px; border-bottom:1px solid #e5e8ec; }
    .pr-row:last-child { border-bottom:0; }
    .pr-head { font-size:11.5px; font-weight:700; color:#5b6573; background:#f4f6f9; border-radius:6px 6px 0 0; }
    .pr-no { width:26px; height:26px; border-radius:50%; background:#eef0f3; font-weight:700; display:flex; align-items:center; justify-content:center; font-size:12px; }
    .pr-title { font-weight:700; }
    .pr-sub { font-size:12px; color:#7a8491; }
    .pr-badge { font-size:11.5px; font-weight:700; padding:2px 10px; border-radius:20px; text-align:center; }
    .pr-Confirmed { background:#e6f4ea; color:#1e7d34; }
    .pr-Review { background:#fff4e0; color:#b26a00; }
    .pr-Missing { background:#fdeaea; color:#c62828; }
    .pr-act { display:flex; gap:8px; justify-content:flex-end; align-items:center; }
    .pr-link { font-size:12.5px; text-decoration:none; color:#1a56c4; font-weight:600; }
</style>

<TelerikRootComponent>
<TelerikNotification @ref="@NotificationRef" HorizontalPosition="NotificationHorizontalPosition.Center" VerticalPosition="NotificationVerticalPosition.Top" />

<_00BT_FullW HdrCaption="Pre-requisites">
    <Details>
    <div class="p-3 pr-root">
        <div class="pr-intro">
            Review each setup before running payroll. Some values were filled in automatically for your company. Open a step to check or change it,
            then confirm it. A step with nothing set up cannot be confirmed yet.
        </div>
        <div class="pr-sum">@steps.Count(s => s.Status == "Confirmed") of @steps.Count confirmed</div>

        <div class="pr-card">
            <div class="pr-row pr-head"><div></div><div>Setup</div><div>What is set</div><div>Status</div><div></div></div>
            @for (int i = 0; i < steps.Count; i++)
            {
                var s = steps[i];
                <div class="pr-row">
                    <div class="pr-no">@(i + 1)</div>
                    <div>
                        <div class="pr-title">@s.Title</div>
                        @if (s.Status == "Confirmed") { <div class="pr-sub">Confirmed by @s.ConfirmedBy on @s.ConfirmedAt?.ToString("MMM dd, yyyy")</div> }
                    </div>
                    <div>@s.Detail</div>
                    <div><div class="pr-badge pr-@s.Status">@s.Status</div></div>
                    <div class="pr-act">
                        <a class="pr-link" href="@s.Link">Open</a>
                        @if (s.Status == "Confirmed")
                        {
                            <TelerikButton OnClick="@(() => Undo(s))" Size="sm">Undo</TelerikButton>
                        }
                        else
                        {
                            <TelerikButton OnClick="@(() => Confirm(s))" ThemeColor="primary" Size="sm" Enabled="@(s.Status != "Missing")">Confirm</TelerikButton>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    </Details>
</_00BT_FullW>
</TelerikRootComponent>

@code {
    [Parameter] public UserClaimsModel? UserClaims { get; set; }

    TelerikNotification? NotificationRef;
    List<M100_Step> steps = new();

    string Opay => UserClaims?.OpayDb ?? "";
    string Opis => UserClaims?.OpisDb ?? "";
    string Conn => UserClaims?.Conn ?? "";
    string User => UserClaims?.UserName ?? UserClaims?.Email ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Opay)) return;
        await Reload();
    }

    async Task Reload()
    {
        try { steps = await _da._02Steps(Opis, Opay, Conn); }
        catch (Exception ex) { Console.Error.WriteLine("100 load failed: " + ex); NotificationRef?.Show("Unable to load the setup.", ThemeConstants.Notification.ThemeColor.Warning); }
    }

    async Task Confirm(M100_Step s)
    {
        try { await _da._03Confirm(s.Key, User, Opay, Conn); await Reload(); }
        catch (Exception ex) { Console.Error.WriteLine("100 confirm failed: " + ex); NotificationRef?.Show("Unable to confirm.", ThemeConstants.Notification.ThemeColor.Warning); }
    }

    async Task Undo(M100_Step s)
    {
        try { await _da._03Unconfirm(s.Key, Opay, Conn); await Reload(); }
        catch (Exception ex) { Console.Error.WriteLine("100 undo failed: " + ex); NotificationRef?.Show("Unable to undo.", ThemeConstants.Notification.ThemeColor.Warning); }
    }
}
