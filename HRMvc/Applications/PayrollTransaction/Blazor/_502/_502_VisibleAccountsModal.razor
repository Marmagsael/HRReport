@using HRApiLibrary.DataAccess._20_Pay.OPay
@using Telerik.Blazor.Components

<TelerikDialog Visible="@v502.IsVisibleAccountsOpen" VisibleChanged="@OnVisibleChanged"
               Title="Visible Accounts"
               Width="520px">
    <DialogContent>
        <div class="d-flex align-items-center gap-2 mb-2">
            <label class="fw-normal">Period</label>
            <span class="fw-semibold">@period</span>
            <div class="flex-grow-1"></div>
            <TelerikButton OnClick="@SetDefault" Size="@ThemeConstants.Button.Size.Small">Load Default</TelerikButton>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="small text-danger mb-2">@error</div>
        }

        <TelerikGrid Data="@accounts" Height="420px" Pageable="false" Sortable="false" SelectionMode="@GridSelectionMode.None">
            <GridColumns>
                <GridColumn Title="" Width="50px" TextAlign="@ColumnTextAlign.Center">
                    <Template Context="item">
                        @{ var a = (VisibleAccountModel)item; }
                        <input type="checkbox" class="form-check-input" checked="@a.IsShown" @onchange="@((ChangeEventArgs e) => a.IsShown = (bool)(e.Value ?? false))" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VisibleAccountModel.AcctName)" Title="Account Name" />
            </GridColumns>
        </TelerikGrid>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" OnClick="@LoadSelected" Enabled="@(!saving)">Load</TelerikButton>
        <TelerikButton OnClick="@SaveAsDefault" Enabled="@(!saving)">Save as Default</TelerikButton>
        <TelerikButton OnClick="@Close">Cancel</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@inject IOVisibleAccountDataAccess _visible

@code {
    [CascadingParameter] public UserClaimsModel Uc   { get; set; } = new();
    [CascadingParameter] public V502            v502 { get; set; } = new();

    List<VisibleAccountModel> accounts = [];
    string  period = "01";
    string  error  = string.Empty;
    bool    saving;
    bool    wasOpen;

    protected override async Task OnInitializedAsync()
    {
        period = string.IsNullOrWhiteSpace(v502.Prd) || v502.Prd == "PP" ? "01" : v502.Prd!;
        await Load();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool opening = v502.IsVisibleAccountsOpen && !wasOpen;
        wasOpen = v502.IsVisibleAccountsOpen;
        if (!opening) return;

        period = string.IsNullOrWhiteSpace(v502.Prd) || v502.Prd == "PP" ? "01" : v502.Prd!;
        error  = string.Empty;
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    async Task Load()
    {
        try   { accounts = await _visible._02(period, Uc.OpayDb!, Uc.Conn!); }
        catch (Exception ex) { accounts = []; error = "Unable to load the accounts."; Console.Error.WriteLine(ex); }
    }

    void SetDefault()
    {
        foreach (var a in accounts) a.IsShown = a.IsDefault;
    }

    async Task SaveAsDefault()
    {
        saving = true;
        error  = string.Empty;
        try
        {
            var shown = accounts.Where(a => a.IsShown).Select(a => a.AcctNumber).ToList();
            await _visible._03("01", shown, Uc.OpayDb!, Uc.Conn!);
            await _visible._03("02", shown, Uc.OpayDb!, Uc.Conn!);
            v502.IsVisibleAccountsOpen = false;
            wasOpen = false;
            v502.Msg = "Visible accounts saved as default for both periods.";
            if (v502.Changed != null) await v502.Changed();
        }
        catch (Exception ex)
        {
            error = "Unable to save the default.";
            Console.Error.WriteLine(ex);
        }
        finally { saving = false; }
    }

    async Task LoadSelected()
    {
        v502.VisibleAcctNumbers = accounts.Where(a => a.IsShown).Select(a => a.AcctNumber.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        v502.IsVisibleAccountsOpen = false;
        wasOpen = false;
        v502.Msg = $"{v502.VisibleAcctNumbers.Count} visible accounts loaded for period {period}.";
        if (v502.Changed != null) await v502.Changed();
    }

    async Task Close()
    {
        v502.IsVisibleAccountsOpen = false;
        wasOpen = false;
        if (v502.Changed != null) await v502.Changed();
    }

    async Task OnVisibleChanged(bool visible)
    {
        v502.IsVisibleAccountsOpen = visible;
        if (!visible) wasOpen = false;
        if (v502.Changed != null) await v502.Changed();
    }
}
