@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay.M0605
@using HRApiLibrary.Models._20_Pay.OPay

@if (s != null)
{
    <div id="manhourGridContainer">
        <TelerikGrid Data="@s.Results" Class="payroll-grid" Height="80vh" Pageable="false" Sortable="false"
                     Size="@ThemeConstants.Grid.Size.Small" OnRowClick="@OnRowClick" OnRowRender="@OnRowRender">
            <GridColumns>
                <GridColumn Title="No." Width="50px" Locked="true" TextAlign="ColumnTextAlign.Center">
                    <Template>@((s.Results.IndexOf((OPayEmpResult)context) + 1)) )</Template>
                </GridColumn>
                <GridColumn Title="Mrk" Width="50px" Locked="true" TextAlign="ColumnTextAlign.Center">
                    <Template>
                        @{ var r = (OPayEmpResult)context; }
                        <TelerikCheckBox @bind-Value="@r.IsSelected" Enabled="@(!s.IsLocked)" />
                    </Template>
                </GridColumn>
                <GridColumn Title="Name ↔" Width="250px" Locked="true">
                    <Template>@(((OPayEmpResult)context).Name)</Template>
                </GridColumn>
                @foreach (var c in cols)
                {
                    var col = c;
                    <GridColumn Width="100px" TextAlign="ColumnTextAlign.Right">
                        <HeaderTemplate><span title="@OPayrollCompute.Acct(s, col)">@((MarkupString)Label(col))</span></HeaderTemplate>
                        <Template>
                            @{ var r = (OPayEmpResult)context; }
                            <TelerikNumericTextBox T="double"
                                                   Value="@(r.Hours.TryGetValue(col, out var h) ? h : 0)"
                                                   ValueChanged="@((double v) => SetHours(r, col, v))"
                                                   Enabled="@(!s.IsLocked)"
                                                   Decimals="2" Format="N2" Arrows="false" Step="0"
                                                   FillMode="flat" Width="100%" />
                        </Template>
                    </GridColumn>
                }
                
                <GridColumn Title="Earnings" Width="100px" TextAlign="ColumnTextAlign.Right">
                    <Template>@(((OPayEmpResult)context).Earnings.ToString("N2"))</Template>
                </GridColumn>
                <GridColumn Title="Deductions" Width="100px" TextAlign="ColumnTextAlign.Right">
                    <Template>@(((OPayEmpResult)context).Deductions.ToString("N2"))</Template>
                </GridColumn>
                <GridColumn Title="Net Pay" Width="110px" TextAlign="ColumnTextAlign.Right">
                    <Template>
                        @{ var r = (OPayEmpResult)context; }
                        <span class="@(r.NetStatus == NetPayStatus.Negative ? "text-danger fw-bold" : r.NetStatus == NetPayStatus.BelowMinimum ? "text-warning fw-bold" : "")">@r.Net.ToString("N2")</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
}
else
{
    <div class="p-3 text-secondary">Select a client and period, then Load.</div>
}

@inject IJSRuntime JSRuntime

@code {
    [CascadingParameter]    public  V502? v502 { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (s != null) await JSRuntime.InvokeVoidAsync("attachGridKeyboardNav", "manhourGridContainer");
    }

    void OnRowRender(GridRowRenderEventArgs e)
    {
        if (e.Item is OPayEmpResult r && r == v502?.CurrentEmp) e.Class = "current";
    }

    async Task OnRowClick(GridRowClickEventArgs e)
    {
        if (e.Item is OPayEmpResult r) await Select(r);
    }

    OPayrollSession? s => v502?.Session;
    List<string> cols  => s == null ? [] : OPayrollCompute.InputColumns(s);

    //--- grdrow_hide_unhide : the header is the account's short description when it has one ---
    string Label(string c)
    {
        if (c == "daywrk") return "Days Wrk<br>(Basic)";
        var a = s?.Coas.FirstOrDefault(x => x.AcctNumber == OPayrollCompute.Acct(s, c));
        return !string.IsNullOrWhiteSpace(a?.ShortDesc) ? System.Net.WebUtility.HtmlEncode(a!.ShortDesc!.Trim())
             : c == "rn" ? "Ordinary<br>(Hrs)" : c == "absent" ? "Absent<br>(Hrs)" : c.ToUpper();
    }

    //--- Inputs changed: figures are stale until Process, as in payroll4 ------------------------------------------------
    async Task SetHours(OPayEmpResult r, string col, double v)
    {
        r.Hours[col] = v;
        v502!.IsProcessed = false;
        await Select(r);
    }

    async Task Select(OPayEmpResult r)
    {
        if (v502!.CurrentEmp == r && v502.IsProcessed) return;
        v502.CurrentEmp = r;
        if (v502.Changed != null) await v502.Changed();
    }
}
