@using Telerik.Blazor.Components
<style>
    /* First 3 TD - frozen horizontally */
    .payroll-table td:nth-child(1) { position: sticky; left: 0; background: white; z-index: 10; }
    .payroll-table td:nth-child(2) { position: sticky; left: 50px; background: white; z-index: 10; }
    .payroll-table td:nth-child(3) { position: sticky; left: 85px; background: white; z-index: 10; box-shadow: inset -1px 0 0 #198754;}
    /* Header - frozen vertically */
    .payroll-table thead th { position: sticky; top: 0; background-color: white; z-index: 20; box-shadow: inset 0 -1px 0 #198754; }
    /* Header + first 3 columns = highest layer */
    .payroll-table thead th:nth-child(1) { left: 0; z-index: 30; }
    .payroll-table thead th:nth-child(2) { left: 50px; z-index: 30; }
    .payroll-table thead th:nth-child(3) { left: 85px; z-index: 30; border-right: 1px solid #dee2e6;}
    /* Remove gaps between cells */
    .payroll-table { border-collapse: collapse !important; border-spacing: 0 !important; }

    .payroll-table th:nth-child(n+4),
    .payroll-table td:nth-child(n+4) { border-right: 1px solid #dee2e6; }
</style>

