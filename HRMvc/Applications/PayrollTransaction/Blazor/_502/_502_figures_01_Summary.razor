@using HRApiLibrary.Models._00_Main

<div>
    <table border="1" class="w-100 table table-bordered table-hover">
        <thead>
            <tr>
                <th class="txt-fcolor" colspan="2"><strong>PAYROLL SUMMARY</strong></th>
            </tr>
        </thead>
        <tbody>
            <tr class="bordered-bottom">
                <td class="w-60">Total Hours</td>
                <td class="text-end">@totalHours.ToString("N2")</td>
            </tr>
            <tr>
                <td>Basic Earnings</td>
                <td class="text-end">@basic.ToString("N2")</td>
            </tr>
            <tr>
                <td>Other Earnings</td>
                <td class="text-end">@((earnings - basic).ToString("N2"))</td>
            </tr>
            <tr>
                <td>Deductions</td>
                <td class="text-end">@deductions.ToString("N2")</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th>Net Salary</th>
                <th class="text-end"> @((earnings - deductions).ToString("N2")) </th>
            </tr>
            <tr>
                <td class="small text-secondary" colspan="2">
                    @(v502.CurrentEmp?.Name ?? "")
                    @if (v502.Session != null)
                    {
                        <br /><span>Payroll total net: @v502.Session.Results.Sum(r => r.Net).ToString("N2") (@v502.Session.Results.Count)</span>
                    }
                </td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [CascadingParameter] public V502 v502 { get; set; } = new();

    string basicAcct  => v502.Session == null ? "" : HRApiLibrary.DataAccess._20_Pay.OPay.OPayrollCompute.Acct(v502.Session, "daywrk");
    double totalHours => v502.CurrentEmp?.Dtls.FirstOrDefault(d => d.DtlCd == "TH")?.NVal ?? 0;
    double basic      => v502.CurrentEmp != null && v502.CurrentEmp.Amounts.TryGetValue(basicAcct, out var b) ? b : 0;
    double earnings   => v502.CurrentEmp?.Earnings ?? 0;
    double deductions => v502.CurrentEmp?.Deductions ?? 0;
}
