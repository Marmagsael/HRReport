@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay.M0605
@using HRApiLibrary.Models._20_Pay.OPay
@using ClosedXML.Excel
@using Microsoft.AspNetCore.DataProtection

<div class="p-1 bordered-bottom d-flex gap-1 ">

    <div class="card p-2 w-75p text-center h-35p mb-btn mb-btn-gray mb-tooltip disabled-div">
        <span class="tooltip-text">Upload Excel File</span>
        <i class="fa-solid fa-file-circle-plus fa-lg txt-blue"></i>
    </div>
    <div class="card p-2 w-65p text-center h-35p mb-btn mb-btn-gray mb-tooltip @cssSave" @onclick="Save">
        <span class="tooltip-text">Save Transaction</span>
        <i class="fa-solid fa-floppy-disk fa-lg txt-fcolor1"></i>
    </div>

    <div class="bordered-right"></div>
    <div class="card p-2 w-50p text-center h-35p mb-btn mb-btn-green mb-tooltip @cssProcess" @onclick="Process">
        <span class="tooltip-text">Process Transaction</span>
        <i class="fa-solid fa-gears fa-lg  txt-fcolor1"></i>
    </div>
    <div class="card p-2 w-50p text-center h-35p mb-btn mb-btn-gray mb-tooltip @cssLock" @onclick="AskLock">
        <span class="tooltip-text">Lock Transaction</span>
        <i class="fa-solid fa-lock txt-maroon"></i>
    </div>

    <div class="bordered-right"></div>
    @* --- Employee -------------------------- *@
    <div class="card p-2 w-50p text-center h-35p mb-btn mb-btn-gray mb-tooltip disabled-div">
        <span class="tooltip-text">Add Employee</span>
        <i class="fa-solid fa-user-plus fa-lg txt-blue"></i>
    </div>
    <div class="card p-2 w-50p text-center h-35p mb-btn mb-btn-gray mb-tooltip @cssRemoveEmployee" @onclick="RemoveSelected">
        <span class="tooltip-text">Remove Selected Employee</span>
        <i class="fa-solid fa-user-minus fa-lg txt-blue"></i>
    </div>

    <div class="bordered-right"></div>
    @* --- Excel -------------------------- *@
    <div class="card p-2 w-90p text-center h-35p mb-btn mb-btn-green d-flex mb-tooltip @cssCreateExcel" @onclick="CreateExcel">
        <span class="tooltip-text">Create Excel File</span>
        <div class="d-flex gap-1">
            <div class="txt-green"><i class="fa-solid fa-file-excel fa-lg"></i></div>
            <div> Create </div>
        </div>
    </div>
    <div class="card p-2 w-90p text-center h-35p mb-btn mb-btn-green d-flex mb-tooltip @cssUploadExcel" @onclick="OpenUploadExcel">
        <span class="tooltip-text">Upload Excel File</span>
        <div class="d-flex gap-1">
            <div class="txt-green"><i class="fa-solid fa-file-excel fa-lg"></i></div>
            <div> Upload </div>
        </div>
    </div>
</div>

@if (confirmLock)
{
    <div class="p-2 bordered-bottom bg-warning-subtle d-flex gap-2 align-items-center">
        <div>
            <strong>Lock transaction @v502.TRN?</strong> This action cannot be undone.
            @if (belowMinimum > 0)
            {
                <span class="text-danger"> @belowMinimum employee(s) have a net pay below the minimum.</span>
            }
        </div>
        <button class="btn btn-sm btn-danger"    @onclick="Lock">Lock</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => confirmLock = false">Cancel</button>
    </div>
}

@inject IOPayrollDataAccess _payroll
@inject IJSRuntime JS
@inject IDataProtectionProvider DataProtection

@code {
    [CascadingParameter] public UserClaimsModel Uc   { get; set; } = new();
    [CascadingParameter] public V502            v502 { get; set; } = new();

    bool confirmLock = false;
    int  belowMinimum => v502.Session?.Results.Count(r => r.NetStatus == NetPayStatus.BelowMinimum) ?? 0;
    bool hasSession   => v502.Session != null && v502.Session.Results.Count > 0;
    bool editable     => hasSession && !v502.Session!.IsLocked && !v502.IsBusy;

    string? cssSave             => editable ? "" : " disabled-div ";
    string? cssProcess          => editable ? "" : " disabled-div ";
    string? cssLock             => editable && v502.IsProcessed ? "" : " disabled-div ";
    string? cssRemoveEmployee   => editable && v502.Session!.Results.Any(r => r.IsSelected) ? "" : " disabled-div ";
    string? cssCreateExcel      => hasSession && !v502.IsBusy ? "" : " disabled-div ";
    string? cssUploadExcel      => editable ? "" : " disabled-div ";

    //--- payroll4 bProcess: compute every employee from the manhours ------------------------------------------------------
    async Task Process()
    {
        if (!editable) return;
        OPayrollCompute.Compute(v502.Session!);
        v502.IsProcessed = true;
        var neg = v502.Session!.Results.Count(r => r.NetStatus == NetPayStatus.Negative);
        v502.Msg = "Processed." + (neg > 0 ? $" {neg} employee(s) with negative net pay." : "");
        await Notify();
    }

    async Task Save()
    {
        if (!editable) return;
        await Run("Saving...", async () =>
        {
            var err = await _payroll._03SaveDraft(v502.Session!, Uc.UserName ?? "");
            v502.IsProcessed = err == null;
            v502.Msg = err ?? $"Saved {DateTime.Now:hh:mm tt}.";
        });
    }

    void AskLock()
    {
        if (!editable || !v502.IsProcessed) return;
        OPayrollCompute.Compute(v502.Session!);
        confirmLock = true;
    }

    async Task Lock()
    {
        confirmLock = false;
        await Run("Locking...", async () =>
        {
            var err = await _payroll._04Lock(v502.Session!, Uc.UserName ?? "");
            v502.Msg = err ?? $"Payroll {v502.TRN} locked.";
        });
    }

    async Task RemoveSelected()
    {
        if (!editable) return;
        v502.Session!.Results.RemoveAll(r => r.IsSelected);
        if (v502.CurrentEmp != null && !v502.Session.Results.Contains(v502.CurrentEmp)) v502.CurrentEmp = v502.Session.Results.FirstOrDefault();
        await _payroll._01LoadEmployeeData(v502.Session);
        OPayrollCompute.Compute(v502.Session);
        v502.Msg = "Employee(s) removed. Save to keep the change.";
        await Notify();
    }

    //--- Create Excel : manhour sheet like 1100/12002 Export to Excel; row 5 keeps the column keys for Upload Excel ---------
    async Task CreateExcel()
    {
        if (!hasSession || v502.IsBusy) return;
        var s    = v502.Session!;
        var cols = OPayrollCompute.InputColumns(s);
        int last = 2 + cols.Count;

        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("ManHour");

        // Row 1 - Payroll Group, Row 2 - Coverage, Row 3 - Payroll Code (the validation key itself is in the hidden "Key" sheet)
        ws.Cell(1, 1).Value = $"Payroll Group: {s.Client.Code} - {s.Client.ClName}";
        ws.Cell(1, 1).Style.Font.Bold = true;
        ws.Range(1, 1, 1, last).Merge();
        ws.Cell(2, 1).Value = $"Coverage: {s.AttStart:MM/dd/yyyy} to {s.AttEnd:MM/dd/yyyy}";
        ws.Cell(2, 1).Style.Font.Bold = true;
        ws.Range(2, 1, 2, last).Merge();
        ws.Cell(3, 1).Value = $"Payroll Code: {s.Trn}";
        ws.Cell(3, 1).Style.Font.Bold = true;
        ws.Range(3, 1, 3, last).Merge();

        // Row 4 - headers, Row 5 - column keys (read back by Upload Excel)
        ws.Cell(4, 1).Value = "EmpNumber";
        ws.Cell(4, 2).Value = "Name";
        ws.Range(4, 1, 5, 1).Merge();
        ws.Range(4, 2, 5, 2).Merge();
        for (int i = 0; i < cols.Count; i++)
        {
            ws.Cell(4, 3 + i).Value = ExcelLabel(s, cols[i]);
            ws.Cell(5, 3 + i).Value = cols[i];
            ws.Cell(4, 3 + i).Style.Fill.BackgroundColor = XLColor.FromHtml(i % 2 == 0 ? "#dbeafe" : "#dcfce7");
        }
        var hdr = ws.Range(4, 1, 5, last);
        hdr.Style.Font.Bold = true;
        hdr.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        hdr.Style.Alignment.Vertical   = XLAlignmentVerticalValues.Center;
        hdr.Style.Alignment.WrapText   = true;
        ws.Range(5, 3, 5, last).Style.Font.Italic = true;
        ws.Range(5, 3, 5, last).Style.Font.FontColor = XLColor.Gray;

        // Row 6+ - data; EmpNumber kept as text so the leading zeros stay
        int row = 6;
        foreach (var r in s.Results)
        {
            ws.Cell(row, 1).SetValue(r.EmpNumber ?? "");
            ws.Cell(row, 2).Value = r.Name;
            for (int i = 0; i < cols.Count; i++)
            {
                var cell = ws.Cell(row, 3 + i);
                cell.Value = r.Hours.TryGetValue(cols[i], out var h) ? h : 0;
                cell.Style.NumberFormat.Format = "0.00";
                cell.Style.Font.FontColor = i % 2 == 0 ? XLColor.Blue : XLColor.Black;
            }
            row++;
        }

        ws.Column(1).Width = 12;
        ws.Column(2).Width = 30;
        for (int c = 3; c <= last; c++) ws.Column(c).Width = 12;
        ws.SheetView.FreezeRows(5);

        _502_ExcelKey.Write(DataProtection, wb, s);

        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.InvokeVoidAsync("downloadFile", $"ManHour_{s.Trn}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(ms.ToArray()));
    }

    // -- Same names as the manhour grid; OT columns use the account name --
    static string ExcelLabel(OPayrollSession s, string c) => c switch
    {
        "daywrk" => "Days Wrk (Basic)",
        "rn"     => "Ordinary (Hrs)",
        "absent" => "Absent (Hrs)",
        _        => s.Coas.FirstOrDefault(a => a.AcctNumber == OPayrollCompute.Acct(s, c))?.AcctName?.Trim() is { Length: > 0 } n ? n : c.ToUpper()
    };

    async Task OpenUploadExcel()
    {
        if (!editable) return;
        v502.IsUploadExcelOpen = true;
        await Notify();
    }

    async Task Run(string busyMsg, Func<Task> action)
    {
        v502.IsBusy = true; v502.Msg = busyMsg; await Notify();
        try { await action(); }
        catch (Exception ex) { v502.Msg = "Error: " + ex.Message; }
        finally { v502.IsBusy = false; await Notify(); }
    }

    async Task Notify() { if (v502.Changed != null) await v502.Changed(); }
}
