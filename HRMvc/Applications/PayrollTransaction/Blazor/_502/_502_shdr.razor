<div class="w-100 p-2  bg-white bordered-bottom ">
    @* -- Each label with its value, all on one baseline -- *@
    <div class=" d-flex flex-wrap align-items-baseline row-gap-2 mt-2  ">
        <div class="d-flex align-items-baseline gap-2 pe-4">
            <span class="fw-bold small">PAYROLL CODE :</span>
            <span>@(v502.Session?.Trn ?? v502.TRN)</span>
        </div>
        <div class="d-flex align-items-baseline gap-2 px-4 border-start">
            <span class="fw-bold small">PAYROLL GROUP :</span>
            <span>@v502.Session?.Client.Code - @v502.Session?.Client.ClName</span>
        </div>
        <div class="d-flex align-items-baseline gap-2 px-4 border-start">
            <span class="fw-bold small">PAYROLL PERIOD :</span>
            <span>@v502.Session?.AttStart.ToString("MMM dd") - @v502.Session?.AttEnd.ToString("MMM dd, yyyy")</span>
        </div>
        <div class="d-flex align-items-baseline gap-2 px-4 border-start">
            <span class="fw-bold small">STATUS :</span>
            <span class="@(v502.Session?.IsLocked == true ? "txt-maroon fw-bold" : "")">@v502.Session?.Status</span>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(v502.Msg))
    {
        <div class="small mt-1 @(v502.Msg.StartsWith("Error") || v502.Msg.StartsWith("Unable") || v502.Msg.StartsWith("Load failed") ? "text-danger" : "text-secondary")">@v502.Msg</div>
    }
</div>

@code {
    [CascadingParameter]    public  V502? v502 { get; set; } = new();
}
