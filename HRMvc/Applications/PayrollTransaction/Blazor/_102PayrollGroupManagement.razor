@using Blazorise
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.Models._00_Main
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PayrollTransaction.Blazor._102


@inject NotificationService _notify
@inject DialogService _DialogService


<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />


 <TelerikRootComponent>
    <div class="card w-1080p">
        <BodyHdr pageTitle="Payroll Group Management"  />

        <div class="card-body p-0">
            <div class="mb-tabs bordered-bottom-darkgreen ">
                <div onclick="@(() => TabClick(1))" class="mb-tab mb-a-blue @(tab == 1 ? "active" : "")">Payroll Group</div>
                <div onclick="@(() => TabClick(2))" class="mb-tab mb-a-blue @(tab == 2 ? "active" : "")">Payroll Group Assignment</div>
                <div onclick="@(() => TabClick(3))" class="mb-tab mb-a-blue @(tab == 3 ? "active" : "")">Change Schedule Assignment</div>
            </div>
        </div>


            @switch (tab) 
        {
            case 1 : { <_102_PayrollGrpEntry            Uc="@Uc"  V="v"      ChildAction="ChilAction"/> break;  }
            case 2 : { <_102_PayrollGrpAssignment       Uc="@Uc"  V="v"      ChildAction="ChilAction"/> break;  } 
            case 3 : { <_102_ChangeScheduleMgt          Uc="@Uc"  V="v"      ChildAction="ChilAction" /> break;  }

            default: { break; }
        }

    </div>
</TelerikRootComponent>

@inject IPayrollgrpDataAccess _paygrps;
@inject IPayrateDataAccess    _payrate;


@code {
    [Parameter]public UserClaimsModel   Uc  {get; set;} = new();
    V102Model   v  {get; set;} = new();


    int tab = 1;

    protected override async Task OnInitializedAsync()
    {
        if (Uc == null) return;

        v.pisdb = Uc.SchemaUserPis;
        v.paydb = Uc.SchemaUserPay;
        v.conn  = Uc.Conn;

        await LoadPayrollGroups();
        await LoadPayRates();
    }


    private async Task ChilAction()
    {
        if (v.Action == "LoadPayrollGroups") await LoadPayrollGroups();
    }



    private async Task LoadPayrollGroups()
    {
        try
        {
            var result = await _paygrps._02(v.paydb, v.conn);
            v.PayrollGrps = result;
        }
        catch (Exception)
        {
            _notify.ShowError("Load Error", $"Failed to load payroll groups");
        }
    }


    private async Task LoadPayRates()
    {
        try
        {
            var result = await _payrate._02(v.paydb, v.conn);
            v.PayRates = result;
        }
        catch (Exception)
        {
            _notify.ShowError("Load Error", $"Failed to load payroll rates");
        }
    }


    void TabClick(int no) 
    {
        tab = no;
        v.SelectedPayrollGroup = 0;
    }


   

}