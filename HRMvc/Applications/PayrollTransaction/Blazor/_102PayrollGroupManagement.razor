@using Blazorise
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PayrollTransaction.Blazor._102

@inject IOPayrollgrpDataAccess _paygrps
@inject IOClientDataAccess _clients


<TelerikRootComponent>
    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />




    <CascadingValue Value="@Uc">
        <CascadingValue Value="@v">
            <CascadingValue Value="@NotificationRef">
                <CascadingValue Value="@ChildAction">

                    <div class="position-relative">

                        <TelerikLoaderContainer Visible="@v.IsLoading"
                                                LoaderType="@LoaderType.ConvergingSpinner" />

                        <div class="card">

                            <BodyHdr pageTitle="Payroll Group Management" />


                            <div class="card-body p-0">

                                <div class="mb-tabs bordered-bottom-darkgreen">

                                    <div onclick="@(() => TabClick(1))"
                                            class="mb-tab mb-a-blue @(tab == 1 ? "active" : "")">
                                        Payroll Group
                                    </div>

                                    <div onclick="@(() => TabClick(2))"
                                            class="mb-tab mb-a-blue @(tab == 2 ? "active" : "")">
                                        Payroll Group Assignment
                                    </div>

                                    <div onclick="@(() => TabClick(3))"
                                            class="mb-tab mb-a-blue @(tab == 3 ? "active" : "")">
                                        Change Schedule Assignment
                                    </div>

                                </div>

                            </div>


                            @switch (tab)
                            {
                                case 1:

                                    <_102_PayrollGrpEntry   />
                                    break;


                                case 2:

                                    <_102_PayrollGrpAssignment />
                                    break;


                                case 3:

                                    <_102_ChangeScheduleMgt/>
                                    break;
                            }

                        </div>

                    </div>

                </CascadingValue>
            </CascadingValue>
            </CascadingValue>
        </CascadingValue>

</TelerikRootComponent>


@code {

    private TelerikNotification? NotificationRef;


    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();
    private V102Model v { get; set; } = new();
    private int tab = 1;


    protected override async Task OnInitializedAsync()
    {
        if (Uc == null) return;


        v.pisdb = Uc.OpisDb;
        v.paydb = Uc.OpayDb;
        v.conn = Uc.Conn;

        v.IsLoading = true;


        try
        {
            await LoadDeployments();
        }
        catch (Exception)
        {
            NotificationRef?.Show( "Unable to load payroll group data.",  ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
    }



    private async Task ChildAction()
    {
        if (v.Action == "LoadPayrollGroups")
        {
            await LoadPayrollGroups();
        }
    }



    private async Task LoadPayrollGroups()
    {
        try
        {
            var result = await _paygrps._02( v.paydb, v.pisdb,v.conn);
            v.PayrollGrps =  result ?? new List<PayrollgrpModel>();
        }
        catch (Exception)
        {
            NotificationRef?.Show( "Failed to load payroll groups.", ThemeConstants.Notification.ThemeColor.Error);
            throw;
        }
    }


   
    private async Task LoadDeployments()
    {
        try
        {
            var statuses = new List<string>
            {
                "Active",
                "Inactive"
            };


            var result = await _clients._02ByStatuses(  statuses, v.pisdb, v.conn);
            v.Deployments = result!;
        }
        catch (Exception)
        {
            NotificationRef?.Show(  "Failed to load deployments.", ThemeConstants.Notification.ThemeColor.Error);
            throw;
        }
    }



    private void TabClick(int no)
    {
        tab = no;

        v.SelectedPayrollGroup = 0;
    }
}