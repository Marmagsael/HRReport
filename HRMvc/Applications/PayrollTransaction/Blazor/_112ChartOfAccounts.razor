@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using Telerik.Blazor.Components
@using Telerik.SvgIcons

<TelerikRootComponent>
<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="NotificationHorizontalPosition.Center"
                     VerticalPosition="NotificationVerticalPosition.Top" />

<TelerikWindow Modal="true" @bind-Visible="@modalOpen" Width="760px">
    <WindowTitle>@(editingCode is null ? "Add Entry" : "Edit Account")</WindowTitle>
    <WindowContent>
        <div class="d-flex gap-2 mb-3">
            <TelerikButton OnClick="@Save" ThemeColor="primary" Icon="@SvgIcon.Save" Enabled="@(!saving)">@(editingCode is null ? "Add" : "Update")</TelerikButton>
            <TelerikButton OnClick="@CloseModal" FillMode="outline">Cancel</TelerikButton>
        </div>

        <div class="d-flex flex-wrap align-items-end gap-3">
            <div>
                <label class="form-label fw-bold mb-1">Account No.</label>
                <div><TelerikTextBox @bind-Value="form.AcctNumber" MaxLength="5" Width="110px" Enabled="@(editingCode is null)" /></div>
            </div>
            <div>
                <label class="form-label fw-bold mb-1">Account Name</label>
                <div><TelerikTextBox @bind-Value="form.AcctName" MaxLength="60" Width="320px" /></div>
            </div>
            <div>
                <label class="form-label fw-bold mb-1">Type</label>
                <div><TelerikDropDownList Data="@types" TextField="Text" ValueField="Value" @bind-Value="form.AcctType" Width="140px" Enabled="@(editingCode is null)" /></div>
            </div>
            <div>
                <label class="form-label fw-bold mb-1">Short Name</label>
                <div><TelerikTextBox @bind-Value="form.ShortDesc" MaxLength="10" Width="120px" /></div>
            </div>
            <div>
                <label class="form-label fw-bold mb-1">Rate (x hourly)</label>
                <div><TelerikNumericTextBox Class="num-right" @bind-Value="form.OtRate" Min="0" Decimals="4" Format="N4" Width="120px" /></div>
            </div>
        </div>

        <div class="card mt-3 coa-card">
            <div class="card-header py-2 fw-bold">Rules</div>
            <div class="card-body py-2">
                <div class="text-secondary small mb-2">Check what applies to this account.</div>
                <div class="d-flex flex-wrap gap-2">
                    <label class="coa-chip @(form.IsTaxable == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.IsTaxable == 1)" ValueChanged="@((bool v) => form.IsTaxable = v ? 1 : 0)" /> Taxable</label>
                    <label class="coa-chip @(form.IsTaxExcl == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.IsTaxExcl == 1)" ValueChanged="@((bool v) => form.IsTaxExcl = v ? 1 : 0)" /> Tax exempt</label>
                    <label class="coa-chip @(form.IsYtdAcct == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.IsYtdAcct == 1)" ValueChanged="@((bool v) => form.IsYtdAcct = v ? 1 : 0)" /> Year-to-date</label>
                    <label class="coa-chip @(form.WithSss == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.WithSss == 1)" ValueChanged="@((bool v) => form.WithSss = v ? 1 : 0)" /> SSS</label>
                    <label class="coa-chip @(form.WithPhic == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.WithPhic == 1)" ValueChanged="@((bool v) => form.WithPhic = v ? 1 : 0)" /> PHIC</label>
                    <label class="coa-chip @(form.WithPagibig == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.WithPagibig == 1)" ValueChanged="@((bool v) => form.WithPagibig = v ? 1 : 0)" /> Pag-IBIG</label>
                    <label class="coa-chip @(form.IsOt == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.IsOt == 1)" ValueChanged="@((bool v) => form.IsOt = v ? 1 : 0)" /> Overtime</label>
                    <label class="coa-chip @(form.IsLegalHoliday == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.IsLegalHoliday == 1)" ValueChanged="@((bool v) => form.IsLegalHoliday = v ? 1 : 0)" /> Legal holiday</label>
                    <label class="coa-chip @(form.HasRateOverBasic == 1 ? "on" : "")"><TelerikCheckBox Value="@(form.HasRateOverBasic == 1)" ValueChanged="@((bool v) => form.HasRateOverBasic = v ? 1 : 0)" /> Hours-based (shows in Payroll Entry)</label>
                </div>
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<div class="card w-100 p-1">
    <BodyHdr pageTitle="Chart of Accounts" />
    <div class="card-body p-2 w-100">

        <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
            <TelerikButton OnClick="@OpenAdd" ThemeColor="primary" Icon="@SvgIcon.Plus">Add Entry</TelerikButton>
            <input class="form-control" style="width:280px;" placeholder="Search number or name..." @bind="search" @bind:event="oninput" />
        </div>

        <TelerikTabStrip>
            <TabStripTab Title="@($"Earnings ({Shown("E").Count})")">
                @AccountGrid("E")
            </TabStripTab>
            <TabStripTab Title="@($"Deductions ({Shown("D").Count})")">
                @AccountGrid("D")
            </TabStripTab>
        </TelerikTabStrip>

    </div>
</div>
</TelerikRootComponent>

<style>
    .num-right input.k-input-inner { text-align: right; }
    .coa-card { background: #fff; }
    .coa-chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 1px solid #ced4da; border-radius: 999px; cursor: pointer; user-select: none; background: #fff; }
    .coa-chip.on { border-color: #23774f; background: #e1f2e8; color: #1b5e3b; font-weight: 600; }
</style>

@inject IOChartAccountDataAccess _coaDa

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    record Opt(string Text, string Value);

    TelerikNotification     NotificationRef { get; set; } = new();
    List<ChartAcctModel>    accounts        = new();
    ChartAcctModel          form            = NewForm();
    string?                 editingCode;
    string?                 deleteCode;
    string                  search          = string.Empty;
    bool                    saving;
    bool                    modalOpen;

    readonly List<Opt> types = [new("Earnings", "E"), new("Deductions", "D")];

    static ChartAcctModel NewForm(string type = "E") => new() { AcctType = type, OtRate = 1 };

    List<ChartAcctModel> Shown(string type) => accounts.Where(a =>
        a.AcctType == type
        && (string.IsNullOrWhiteSpace(search)
            || (a.AcctNumber ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (a.AcctName ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    MarkupString Flag(int v) => new MarkupString(v == 1 ? "<span style=\"color:#23774f;font-weight:700\">&#10003;</span>" : "<span style=\"color:#9aa5b1\">-</span>");

    RenderFragment AccountGrid(string type) => @<TelerikGrid Data="@Shown(type)" Height="calc(100vh - 320px)" Sortable="true" Size="@ThemeConstants.Grid.Size.Small">
        <GridColumns>
            <GridColumn Field="@nameof(ChartAcctModel.AcctNumber)" Title="Acct No." Width="90px" />
            <GridColumn Field="@nameof(ChartAcctModel.AcctName)" Title="Account Name" />
            <GridColumn Field="@nameof(ChartAcctModel.ShortDesc)" Title="Short Name" Width="110px" />
            <GridColumn Field="@nameof(ChartAcctModel.OtRate)" Title="Rate" DisplayFormat="{0:N4}" Width="90px" TextAlign="ColumnTextAlign.Right" />
            <GridColumn Title="Tax" Width="55px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).IsTaxable)</Template></GridColumn>
            <GridColumn Title="SSS" Width="55px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).WithSss)</Template></GridColumn>
            <GridColumn Title="PHIC" Width="60px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).WithPhic)</Template></GridColumn>
            <GridColumn Title="Pag-IBIG" Width="75px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).WithPagibig)</Template></GridColumn>
            <GridColumn Title="OT" Width="50px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).IsOt)</Template></GridColumn>
            <GridColumn Title="Hours" Width="65px" TextAlign="ColumnTextAlign.Center"><Template>@Flag(((ChartAcctModel)context).HasRateOverBasic)</Template></GridColumn>
            <GridColumn Title="Lock" Width="70px" TextAlign="ColumnTextAlign.Center">
                <Template>
                    @{ var g = (ChartAcctModel)context; }
                    <span class="badge @(g.IsLock == 1 ? "bg-secondary" : "bg-success")">@(g.IsLock == 1 ? "Locked" : "Open")</span>
                </Template>
            </GridColumn>
            <GridColumn Title="" Width="160px">
                <Template>
                    @{ var r = (ChartAcctModel)context; var locked = r.IsLock == 1; }
                    @if (!locked)
                    {
                        <TelerikButton OnClick="@(() => OpenEdit(r))" FillMode="outline" Size="sm">Edit</TelerikButton>
                        @if (deleteCode == r.AcctNumber)
                        {
                            <TelerikButton OnClick="@(() => Delete(r))" ThemeColor="error" Size="sm">Confirm</TelerikButton>
                        }
                        else
                        {
                            <TelerikButton OnClick="@(() => deleteCode = r.AcctNumber)" FillMode="outline" ThemeColor="error" Size="sm">Delete</TelerikButton>
                        }
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>;

    protected override async Task OnInitializedAsync()
    {
        if (Uc is null) return;
        await Reload();
    }

    async Task Reload()
    {
        try { accounts = await _coaDa._02(Uc!.OpayDb!, Uc.Conn!); }
        catch (Exception ex) { Show("error", $"Load failed: {ex.Message}"); }
    }

    void OpenAdd()
    {
        editingCode = null;
        form        = NewForm();
        modalOpen   = true;
    }

    void OpenEdit(ChartAcctModel r)
    {
        editingCode = r.AcctNumber;
        form = new ChartAcctModel
        {
            AcctNumber = r.AcctNumber, AcctName = r.AcctName, AcctType = r.AcctType, ShortDesc = r.ShortDesc,
            IsTaxable = r.IsTaxable, IsYtdAcct = r.IsYtdAcct, IsTaxExcl = r.IsTaxExcl, HasRateOverBasic = r.HasRateOverBasic,
            OtRate = r.OtRate, IsOt = r.IsOt, IsLegalHoliday = r.IsLegalHoliday, WithSss = r.WithSss, WithPhic = r.WithPhic, WithPagibig = r.WithPagibig
        };
        modalOpen = true;
    }

    void CloseModal()
    {
        modalOpen   = false;
        editingCode = null;
        form        = NewForm();
    }

    async Task Save()
    {
        saving = true;
        try
        {
            var msg = editingCode is null
                ? await _coaDa._01(form, Uc!.OpayDb!, Uc.Conn!)
                : await _coaDa._03(form, Uc!.OpayDb!, Uc.Conn!);
            if (msg != null) { Show("error", msg); return; }

            Show("success", editingCode is null ? "Account added." : "Account updated.");
            CloseModal();
            await Reload();
        }
        catch (Exception ex) { Show("error", $"Save failed: {ex.Message}"); }
        finally { saving = false; }
    }

    async Task Delete(ChartAcctModel r)
    {
        try
        {
            var msg = await _coaDa._04(r.AcctNumber!, Uc!.OpayDb!, Uc.Conn!);
            deleteCode = null;
            if (msg != null) { Show("error", msg); return; }

            Show("success", "Account deleted.");
            await Reload();
        }
        catch (Exception ex) { Show("error", $"Delete failed: {ex.Message}"); }
    }

    void Show(string type, string text) =>
        NotificationRef.Show(new NotificationModel { Text = text, ThemeColor = type, CloseAfter = 4000 });
}
