@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay.OPay
@using HRMvc.Applications._00GeneralComponents.FormComponents
@using HRMvc.Applications.PayrollTransaction.Vars
@using Telerik.SvgIcons

@inject I_00UsersAccess _user
@inject IMenuDataAccess _menu
@inject IODomainaccessDataAccess _domainaccess

<TelerikStackLayout Orientation="StackLayoutOrientation.Vertical"
                    Spacing="12px">


    @* =====================================================
        FILTERS
        ===================================================== *@

    <TelerikCard Class="bg-light-grey">

            <CardBody>

                <TelerikStackLayout Orientation="StackLayoutOrientation.Vertical"
                                    Spacing="12px">

                    @* =========================
                        USER
                        ========================= *@

                    <CInputLabel Label="User">

                        <TelerikDropDownList TItem="UsersModel"
                                                TValue="string"
                                                Value="@V.SelectedUser"
                                                ValueChanged="@UserChanged"
                                                TextField="@nameof(UsersModel.AFullName)"
                                                ValueField="@nameof(UsersModel.LoginName)"
                                                Filterable="true"
                                                FilterPlaceholder="Showing first 50 users - type at least 3 characters..."
                                                Width="100%"
                                                OnRead="@SearchUser">

                            <DropDownListSettings>
                                <DropDownListPopupSettings Width="450px"
                                                            Height="600px" />
                            </DropDownListSettings>

                            <ItemTemplate>
                                <span>@context.AFullName</span>
                                <span class="text-muted ms-2">
                                    (@context.LoginName)
                                </span>
                            </ItemTemplate>

                            <NoDataTemplate>
                                <span>No users available</span>
                            </NoDataTemplate>

                        </TelerikDropDownList>

                    </CInputLabel>

                </TelerikStackLayout>

            </CardBody>

        </TelerikCard>


        @* =====================================================
            GRIDS
            ===================================================== *@
        <div class="col-12  col-md-10 col-xl-8"  >
            <TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal"
                                Spacing="12px"
                                Width="100%">


                @* =================================================
                    SYSTEM MENU
                    ================================================= *@

                <TelerikCard Width="50%" Class="h-100">

                    <CardHeader Class="">
                        <TelerikSvgIcon Icon="@SvgIcon.AggregateFields"
                                        ThemeColor="primary" />
                    <span class="fw-medium ms-2">
                            System Menu
                        </span>

                    </CardHeader>

                    <CardBody Class="p-0">

                        <TelerikGrid @ref="@SystemMenuGridRef"
                                        TItem="MenuModel"
                                        Data="@V.SystemMenus"
                                        Height="500px"
                                        Pageable="true"
                                        Sortable="true"
                                        FilterMode="@GridFilterMode.FilterMenu"
                                        Resizable="true"
                                        Reorderable="true"
                                        Navigable="true"
                                        SelectionMode="@GridSelectionMode.Single"
                                        SelectedItems="@V.SelectedSystemMenu"
                                        SelectedItemsChanged="@SystemMenuSelectionChanged">

                            <GridColumns>

                                <GridCheckboxColumn Width="50px"
                                                    Resizable="false"
                                                    SelectAll="false" />

                                <GridColumn Field="@nameof(MenuModel.DispText)"
                                            Title="Menu" />

                            </GridColumns>

                        </TelerikGrid>

                    </CardBody>

                </TelerikCard>


                @* =================================================
                    SUB MENU
                    ================================================= *@

                <TelerikCard Width="50%" Class="h-100">

                    <CardHeader Class="">

                        <TelerikSvgIcon Icon="@SvgIcon.AggregateFields"
                                        ThemeColor="primary" />
                        <span class="fw-medium ms-2">
                                Sub Menu
                            </span>

                    </CardHeader>

                    <CardBody Class="p-0">

                        <TelerikGrid @ref="@DtlsMenuGridRef"
                                        TItem="MenuModel"
                                        Data="@V.DtlsMenus"
                                        Height="500px"
                                        Pageable="true"
                                        Sortable="true"
                                        FilterMode="@GridFilterMode.FilterMenu"
                                        Resizable="true"
                                        Reorderable="true"
                                        Navigable="true"
                                        SelectionMode="@GridSelectionMode.Multiple"
                                        SelectedItems="@V.SelectedDtlsMenu"
                                        SelectedItemsChanged="@DtlsMenuSelectionChanged">

                            <GridColumns>

                                <GridCheckboxColumn Width="50px"
                                                    Resizable="false" />

                                <GridColumn Field="@nameof(MenuModel.DispText)"
                                            Title="Menu" />

                            </GridColumns>

                        </TelerikGrid>

                    </CardBody>

                </TelerikCard>

            </TelerikStackLayout>

        </div>
      
</TelerikStackLayout>




@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V103Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification NotificationRef { get; set; }

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<MenuModel>? SystemMenuGridRef;
    private TelerikGrid<MenuModel>? DtlsMenuGridRef;


    private string SelectedDatabase => V.SelectedMenu switch
    {
        "main" => V.Maindb,
        "pis" => V.Mainpisdb,
        "pay" => V.Mainpaydb,
        _ => string.Empty
    };


    protected override async Task OnInitializedAsync()
    {
        if (!V.UcLoaded)
            return;

        LoadMenuType();
    }


    private void LoadMenuType()
    {
        V.MenuTypes = new List<MenuTypeModel>
        {
            new() { Code = "pis", Name = "Pis" },
            new() { Code = "pay", Name = "Pay" },
            new() { Code = "main", Name = "Main" }
        };
    }




    private async Task SearchUser(DropDownListReadEventArgs args)
    {
        try
        {
            string searchText = string.Empty;

            if (args.Request.Filters.Count > 0 && args.Request.Filters[0] is Telerik.DataSource.FilterDescriptor filter)
            {
                searchText = filter.Value?.ToString()?.Trim() ?? string.Empty;
            }

            if (!string.IsNullOrWhiteSpace(searchText) && searchText.Length < 3)
            {
                args.Data = new List<UsersModel?>();
                args.Total = 0;
                return;
            }

            var result = await _user._02(searchText, V.OPisdb, V.Maindb, V.Conn);
            var users = result.ToList();

            if (string.IsNullOrWhiteSpace(searchText) && !string.IsNullOrWhiteSpace(V.SelectedUser) && !users.Any(x => x?.LoginName == V.SelectedUser))
            {
                var selectedUser = await _user._02LoginName_ForUserAccess(V.SelectedUser, V.OPisdb, V.Maindb, V.Conn);

                if (selectedUser != null)
                {
                    users.Add(selectedUser);
                }
            }

            args.Data = users;
            args.Total = users.Count;
        }
        catch (Exception ex)
        {
            args.Data = new List<UsersModel?>();
            args.Total = 0;

            NotificationRef?.Show("Unable to load users. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }




    private async Task UserChanged(string value)
    {
        V.SelectedUser = value;
        V.DtlsMenus = [];
        V.SelectedSystemMenu = [];
        V.SelectedDtlsMenu = [];

        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();

    }



    private async Task MenuChanged(string value)
    {
        V.SelectedMenu = value;

        V.SystemMenus = [];
        V.DtlsMenus = [];
        V.SelectedSystemMenu = [];
        V.SelectedDtlsMenu = [];

        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();

        try
        {
            if (string.IsNullOrWhiteSpace(V.SelectedMenu) || string.IsNullOrWhiteSpace(SelectedDatabase))
                return;

            var result = await _menu._02ByType("shdr", SelectedDatabase, V.Conn);
            V.SystemMenus = result ?? [];
        }
        catch (Exception ex)
        {
            NotificationRef?.Show($"Unable to load menu data. Please try again. {ex}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task SystemMenuSelectionChanged(IEnumerable<MenuModel> selectedItems)
    {
        V.SelectedSystemMenu = selectedItems.ToList();

        V.DtlsMenus = [];
        V.SelectedDtlsMenu = [];

        await ResetDtlsMenuGrid();

        var selectedMenu = V.SelectedSystemMenu.FirstOrDefault();

        if (selectedMenu != null)
        {
            await LoadDetailsMenu(selectedMenu.Id);
        }
    }


    // =========================================================
    // LOAD DETAIL MENUS
    // =========================================================

    private async Task LoadDetailsMenu(int? idparent)
    {
        try
        {
            var result = await _menu._02ByIdParent(idparent, SelectedDatabase, V.Conn);
            V.DtlsMenus = result ?? [];

            var access = await _domainaccess._02ByUserName_Module(V.SelectedUser, V.SelectedMenu, V.OPaydb, V.Conn);
            var accessMenuIds = access.Where(a => a.Idsysmenu.HasValue).Select(a => a.Idsysmenu!.Value).ToList();
            V.SelectedDtlsMenu = V.DtlsMenus.Where(m => m.Id.HasValue && accessMenuIds.Contains(m.Id.Value)).ToList();
        }
        catch (Exception ex)
        {
            NotificationRef?.Show($"Unable to load sub menus. Please try again. {ex}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task DtlsMenuSelectionChanged(IEnumerable<MenuModel> selectedItems)
    {
        var newSelections = selectedItems.ToList();
        var oldSelections = V.SelectedDtlsMenu?.ToList() ?? [];

        var toInsert = newSelections.Where(n => !oldSelections.Any(o => o.Id == n.Id)).ToList();
        var toRemove = oldSelections.Where(o => !newSelections.Any(n => n.Id == o.Id)).ToList();

        V.SelectedDtlsMenu = newSelections;

        if (toInsert.Any())
        {
            await InsertDtlsMenu(toInsert);
        }

        if (toRemove.Any())
        {
            await RemoveDtlsMenu(toRemove);
        }
    }



    private async Task InsertDtlsMenu(List<MenuModel> data)
    {
        try
        {
            foreach (var menu in data)
            {
                var domainaccess = new ODomainaccessModel { Username = V.SelectedUser, Idsysmenu = menu.Id, Module = V.SelectedMenu };
                await _domainaccess._01(domainaccess, V.OPaydb, V.Conn);
            }
            NotificationRef?.Show("User access has been updated.", ThemeConstants.Notification.ThemeColor.Success);

        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to update user access. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task RemoveDtlsMenu(List<MenuModel> data)
    {
        try
        {
            foreach (var menu in data)
            {
                var domainaccess = new ODomainaccessModel { Username = V.SelectedUser, Idsysmenu = menu.Id, Module = V.SelectedMenu };
                await _domainaccess._04ByUserName_Idsysmenu_Module(domainaccess, V.OPaydb, V.Conn);
            }
            NotificationRef?.Show("User access has been updated.", ThemeConstants.Notification.ThemeColor.Success);

        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to update user access. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    // =========================================================
    // RESET  MENU GRID
    // =========================================================

    private async Task ResetSystemMenuGrid()
    {
        if (SystemMenuGridRef != null)
        {
            var state = SystemMenuGridRef.GetState();

            state.FilterDescriptors.Clear();
            state.SortDescriptors.Clear();
            state.Page = 1;

            await SystemMenuGridRef.SetStateAsync(state);
        }
    }




    private async Task ResetDtlsMenuGrid()
    {
        if (DtlsMenuGridRef != null)
        {
            var state = DtlsMenuGridRef.GetState();

            state.FilterDescriptors.Clear();
            state.SortDescriptors.Clear();
            state.Page = 1;

            await DtlsMenuGridRef.SetStateAsync(state);
        }
    }

    public async  Task ResetTab()
    {

        V.SelectedMenu          = string.Empty;
        V.SelectedUser          = string.Empty;

        V.SystemMenus           = [];
        V.DtlsMenus             = [];
        V.SelectedSystemMenu    = [];
        V.SelectedDtlsMenu      = [];


        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();
        Console.WriteLine("reset");
    }

}




<style>
    .bg-light-grey{
        background: #f9fafb;
    }
    .fw-medium{font-weight:500;}
</style>