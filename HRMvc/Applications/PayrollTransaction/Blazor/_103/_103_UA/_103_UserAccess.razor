@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay.OPay
@using HRMvc.Applications._00GeneralComponents.FormComponents
@using HRMvc.Applications.PayrollTransaction.Vars
@using Telerik.SvgIcons

@inject I_00UsersAccess _user
@inject IMenuDataAccess _menu
@inject IODomainaccessDataAccess _domainaccess

<TelerikStackLayout Orientation="StackLayoutOrientation.Vertical"
                    Spacing="12px">

    @* =====================================================
        MODAL
        ===================================================== *@

    @if (V.ShowUserList == true)
    {
        <_00Modal ModuleCaption="Select User" ChildAction="() => V.ShowUserList = false">

            <Content>
                <_103_UserList ChildAction="ChilActionCatcher" />
            </Content>

        </_00Modal>
    }


    @* =====================================================
        FILTERS
        ===================================================== *@

    <TelerikCard Class="bg-light-grey">

        <CardBody>

            <TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal"
                                Spacing="12px"
                                HorizontalAlign="StackLayoutHorizontalAlign.Left">

                @if (!string.IsNullOrWhiteSpace(V.SelectedUserFullName))
                {
                    <CInputLabel Label="User">

                        <TelerikTextBox @bind-Value="V.SelectedUserFullName"
                                        Enabled="false" />

                    </CInputLabel>
                }

                <TelerikButton Icon="FontIcon.Search"
                               Title="Search for user"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               FillMode="@ThemeConstants.Button.FillMode.Solid"
                               OnClick="@ShowUserListModal">

                    Search for user

                </TelerikButton>

            </TelerikStackLayout>

        </CardBody>

    </TelerikCard>


    @* =====================================================
        GRIDS
        ===================================================== *@

    <div class="col-12 col-md-10 col-xl-8">

        <TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal"
                            Spacing="12px"
                            Width="100%">


            @* =================================================
                SYSTEM MENU
                ================================================= *@

            <TelerikCard Width="50%" Class="h-100">

                <CardHeader>

                    <TelerikSvgIcon Icon="@SvgIcon.AggregateFields"
                                    ThemeColor="primary" />

                    <span class="fw-medium ms-2">
                        System Menu
                    </span>

                </CardHeader>

                <CardBody Class="p-0">

                    <TelerikGrid @ref="@SystemMenuGridRef"
                                 TItem="MenuModel"
                                 Data="@V.SystemMenus"
                                 Height="500px"
                                 Pageable="true"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Resizable="true"
                                 Reorderable="true"
                                 Navigable="true"
                                 SelectionMode="@GridSelectionMode.Single"
                                 SelectedItems="@V.SelectedSystemMenu"
                                 SelectedItemsChanged="@SystemMenuSelectionChanged">

                        <GridColumns>

                            <GridCheckboxColumn Width="50px"
                                                Resizable="false"
                                                SelectAll="false" />

                            <GridColumn Field="@nameof(MenuModel.DispText)"
                                        Title="Menu" />

                        </GridColumns>

                    </TelerikGrid>

                </CardBody>

            </TelerikCard>


            @* =================================================
                SUB MENU
                ================================================= *@

            <TelerikCard Width="50%" Class="h-100">

                <CardHeader>

                    <TelerikSvgIcon Icon="@SvgIcon.AggregateFields"
                                    ThemeColor="primary" />

                    <span class="fw-medium ms-2">
                        Sub Menu
                    </span>

                </CardHeader>

                <CardBody Class="p-0">

                    <TelerikGrid @ref="@DtlsMenuGridRef"
                                 TItem="MenuModel"
                                 Data="@V.DtlsMenus"
                                 Height="500px"
                                 Pageable="true"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Resizable="true"
                                 Reorderable="true"
                                 Navigable="true"
                                 SelectionMode="@GridSelectionMode.Multiple"
                                 SelectedItems="@V.SelectedDtlsMenu"
                                 SelectedItemsChanged="@DtlsMenuSelectionChanged">

                        <GridColumns>

                            <GridCheckboxColumn Width="50px"
                                                Resizable="false" />

                            <GridColumn Field="@nameof(MenuModel.DispText)"
                                        Title="Menu" />

                        </GridColumns>

                    </TelerikGrid>

                </CardBody>

            </TelerikCard>

        </TelerikStackLayout>

    </div>

</TelerikStackLayout>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V103Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification NotificationRef { get; set; }

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<MenuModel>? SystemMenuGridRef;
    private TelerikGrid<MenuModel>? DtlsMenuGridRef;

    private List<MenuModel> _previousDtlsSelections = [];


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        if (V.UcLoaded == false)
            return;

        await LoadSystemMenu();
    }


    // =========================================================
    // LOAD SYSTEM MENU
    // =========================================================

    private async Task LoadSystemMenu()
    {
        ClearMenuState();

        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();

        try
        {
            var result = await _menu._02ByType("shdr", V.Mainpaydb, V.Conn);

            V.SystemMenus = result ?? [];
        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to load system menu. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private void ShowUserListModal()
    {
        V.ShowUserList = true;
    }



    private async Task ChilActionCatcher()
    {
        if (V.Action == "EditUserAccess")
        {
            await EditUserAccess();
        }
    }


    // =========================================================
    // USER SELECTED
    // =========================================================

    private async Task EditUserAccess()
    {
        if (V.SelectedUser == null)
            return;

        V.ShowUserList = false;
        V.SelectedUserFullName = V.SelectedUser.FullName;

        V.SelectedSystemMenu = [];
        V.DtlsMenus = [];
        V.SelectedDtlsMenu = [];

        _previousDtlsSelections = [];

        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();
    }


    // =========================================================
    // SYSTEM MENU SELECTION
    // =========================================================

    private async Task SystemMenuSelectionChanged(IEnumerable<MenuModel> selectedItems)
    {
        V.SelectedSystemMenu = selectedItems?.ToList() ?? [];

        V.DtlsMenus = [];
        V.SelectedDtlsMenu = [];

        _previousDtlsSelections = [];

        await ResetDtlsMenuGrid();

        var selectedMenu = V.SelectedSystemMenu.FirstOrDefault();

        if (selectedMenu?.Id is int id)
        {
            await LoadDetailsMenu(id);
        }
    }


    // =========================================================
    // LOAD DETAIL MENUS
    // =========================================================

    private async Task LoadDetailsMenu(int idparent)
    {
        if (V.SelectedUser == null)
            return;

        if (string.IsNullOrWhiteSpace(V.SelectedUser.UserName))
            return;

        try
        {
            var result = await _menu._02ByIdParent(idparent, V.Mainpaydb, V.Conn);

            V.DtlsMenus = result ?? [];

            var access = await _domainaccess._02ByUserName_Module(V.SelectedUser.UserName, "pay", V.OPaydb, V.Conn) ?? [];

            var accessMenuIds = access
                .Where(a => a.Idsysmenu.HasValue)
                .Select(a => a.Idsysmenu!.Value)
                .ToHashSet();

            V.SelectedDtlsMenu = V.DtlsMenus
                .Where(m => m.Id.HasValue && accessMenuIds.Contains(m.Id.Value))
                .ToList();

            _previousDtlsSelections = V.SelectedDtlsMenu.ToList() ?? new();
        }
        catch (Exception ex)
        {
            V.DtlsMenus = [];
            V.SelectedDtlsMenu = [];
            _previousDtlsSelections = [];

            NotificationRef?.Show("Unable to load sub menus. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task DtlsMenuSelectionChanged(IEnumerable<MenuModel> selectedItems)
    {
        if (V.SelectedUser == null || string.IsNullOrWhiteSpace(V.SelectedUser.UserName))
        {
            V.SelectedDtlsMenu = _previousDtlsSelections.ToList();

            NotificationRef?.Show("Unable to assign access. Please select a user first.", ThemeConstants.Notification.ThemeColor.Warning);

            return;
        }

        var newSelections = selectedItems?.ToList() ?? [];

        var toInsert = newSelections
            .Where(n => !_previousDtlsSelections.Any(o => o.Id == n.Id))
            .ToList();

        var toRemove = _previousDtlsSelections
            .Where(o => !newSelections.Any(n => n.Id == o.Id))
            .ToList();


        if (!toInsert.Any() && !toRemove.Any())
        {
            V.SelectedDtlsMenu = newSelections;
            return;
        }


        // =====================================================
        // INSERT
        // =====================================================

        var insertSuccess = true;

        if (toInsert.Any())
        {
            insertSuccess = await InsertDtlsMenu(toInsert);
        }


        // =====================================================
        // REMOVE
        // =====================================================

        var removeSuccess = true;

        if (toRemove.Any())
        {
            removeSuccess = await RemoveDtlsMenu(toRemove);
        }


        // =====================================================
        // SUCCESS
        // =====================================================

        if (insertSuccess && removeSuccess)
        {
            V.SelectedDtlsMenu = newSelections;
            _previousDtlsSelections = newSelections.ToList();

            NotificationRef?.Show("User access has been updated.", ThemeConstants.Notification.ThemeColor.Success);

            return;
        }


        // =====================================================
        // FAILURE
        // =====================================================

        V.SelectedDtlsMenu = _previousDtlsSelections.ToList();

        await ResetDtlsMenuGrid();

        NotificationRef?.Show("Unable to update user access. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
    }


    // =========================================================
    // INSERT DETAIL ACCESS
    // =========================================================

    private async Task<bool> InsertDtlsMenu(List<MenuModel> data)
    {
        if (V.SelectedUser == null)
            return false;

        if (string.IsNullOrWhiteSpace(V.SelectedUser.UserName))
            return false;

        try
        {
            foreach (var menu in data)
            {
                var domainaccess = new ODomainaccessModel()
                {
                    Username = V.SelectedUser.UserName,
                    Idsysmenu = menu.Id,
                    Module = "pay"
                };

                await _domainaccess._01(domainaccess, V.OPaydb, V.Conn);
            }

            return true;
        }
        catch (Exception ex)
        {
            return false;
        }
    }


    // =========================================================
    // REMOVE DETAIL ACCESS
    // =========================================================

    private async Task<bool> RemoveDtlsMenu(List<MenuModel> data)
    {
        if (V.SelectedUser == null)
            return false;

        if (string.IsNullOrWhiteSpace(V.SelectedUser.UserName))
            return false;

        try
        {
            foreach (var menu in data)
            {
                var domainaccess = new ODomainaccessModel()
                {
                    Username = V.SelectedUser.UserName,
                    Idsysmenu = menu.Id,
                    Module = "pay"
                };

                await _domainaccess._04ByUserName_Idsysmenu_Module(domainaccess, V.OPaydb, V.Conn);
            }

            return true;
        }
        catch (Exception ex)
        {
            return false;
        }
    }




    private void ClearMenuState()
    {
        V.SystemMenus = [];
        V.DtlsMenus = [];
        V.SelectedSystemMenu = [];
        V.SelectedDtlsMenu = [];

        _previousDtlsSelections = [];
    }


    // =========================================================
    // RESET  MENU GRID
    // =========================================================

    private async Task ResetSystemMenuGrid()
    {
        if (SystemMenuGridRef == null)
            return;

        var state = SystemMenuGridRef.GetState();

        state.FilterDescriptors.Clear();
        state.SortDescriptors.Clear();
        state.Page = 1;

        await SystemMenuGridRef.SetStateAsync(state);
    }



    private async Task ResetDtlsMenuGrid()
    {
        if (DtlsMenuGridRef == null)
            return;

        var state = DtlsMenuGridRef.GetState();

        state.FilterDescriptors.Clear();
        state.SortDescriptors.Clear();
        state.Page = 1;

        await DtlsMenuGridRef.SetStateAsync(state);
    }


    // =========================================================
    // RESET TAB
    // =========================================================

    public async Task ResetTab()
    {
        V.SelectedMenu = string.Empty;
        V.SelectedUser = new OUsrModel();
        V.SelectedUserFullName = string.Empty;

        ClearMenuState();

        await ResetSystemMenuGrid();
        await ResetDtlsMenuGrid();
    }
}


<style>

    .bg-light-grey {
        background: #f9fafb;
    }

    .fw-medium {
        font-weight: 500;
    }

</style>
