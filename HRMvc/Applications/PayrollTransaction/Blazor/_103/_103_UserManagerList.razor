@using HRApiLibrary.DataAccess._20_Pay.OPay;
@using HRApiLibrary.Models._20_Pay.OPay;
@using HRMvc.Applications.PayrollTransaction.Vars;


<TelerikGrid Data="@V.Users"
             TItem="OUsrModel"
             Sortable="true"
             Navigable="true"
             SelectionMode="GridSelectionMode.Single"
             FilterMode="GridFilterMode.FilterMenu"
             Pageable="true"
             @bind-PageSize="@PageSize"
             @ref="@UserGridRef"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>


    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" 
                        @onclick="@(() => OpenUserEntryModal(new OUsrModel()))">
            Add User
        </button>
    </GridToolBarTemplate>

    <GridColumns>

        @* --- LOGIN NAME --- *@
        <GridColumn Field="@nameof(OUsrModel.UserName)"
                    Title="Login Name"
                    Width="150px" />

        @* --- USER NAME --- *@
        <GridColumn Field="@nameof(OUsrModel.FullName)"
                    Title="User Name"
                    Width="200px" />

        @* --- STATUS  --- *@
        <GridColumn Field="@nameof(OUsrModel.StatusName)"
                    Title="Status"
                    Width="140px">

            <Template Context="item" >
                @{
                    var user = (OUsrModel)item;
                }

                  <div class="d-flex justify-content-center">
                    @if (user.Stat_ == "1")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Disabled</span>
                    }
                </div>
            </Template>

        </GridColumn>


        <GridCommandColumn Title="Action"
                           Width="180px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var usr = (OUsrModel)item;
                }

                <div class="d-flex justify-content-center gap-2">
                    @* ---  EDIT BUTTON --- *@
                    <button class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="@(() => OpenUserEntryModal(usr))">
                        Edit
                    </button>

                    @* ---  ACCESS BUTTON --- *@
                    <button class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="@(() => OpenUserAccessModal(usr))">
                        Access
                    </button>

                    <TelerikDropDownButton Icon="@FontIcon.MoreVertical"
                                           Class="card p-2 text-center h-35p mb-btn mb-btn-blue">

                        <DropDownButtonItems>
                            @* ---  ENABLE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => EnableUser(usr))">
                                Enable
                            </DropDownButtonItem>

                            @* ---  DISBALE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => DisableUser(usr))">
                                Disable
                            </DropDownButtonItem>

                            @* ---  DELETE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => DeleteUser(usr))">
                                Delete
                            </DropDownButtonItem>

                        </DropDownButtonItems>

                    </TelerikDropDownButton>

                </div>
            </Template>

        </GridCommandColumn>


    </GridColumns>


    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No users found.
        </div>
    </NoDataTemplate>
</TelerikGrid>


@inject IOUsrDataAccess _usr;

@code {
    [CascadingParameter]
    public V103Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification NotificationRef { get; set; }

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private int PageSize { get; set; } = 25;
    private List<int?> PageSizes = new() { 25, 50, 75, 100, null };

    private TelerikGrid<OUsrModel> UserGridRef;




    public async Task SetInitialFilter()
    {
        var state = UserGridRef.GetState();

        state.FilterDescriptors = new List<IFilterDescriptor>
        {
            new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OUsrModel.StatusName),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = "Active"
            }
        };

        await UserGridRef.SetStateAsync(state);
    }




    private async Task OpenUserEntryModal(OUsrModel usr)
    {
        V.ShowUserAccessModal = false;

        V.User = new OUsrModel();
        V.ModalCaption = "Add User";

        if (!string.IsNullOrWhiteSpace(usr.UserName))
        {
            V.User = usr;
            V.ModalCaption = "Edit User";
        }

        V.ShowUserEntryModal = true;
        await ChildAction.InvokeAsync();

    }




    private async Task OpenUserAccessModal(OUsrModel usr)
    {
        V.ShowUserEntryModal = false;

        V.User = new OUsrModel();

        V.User = usr;
        V.ModalCaption = "Select User Access";

        V.ShowUserAccessModal = true;

        V.Action = "OpenUserAccessModal";
        await ChildAction.InvokeAsync();
    }

    private void EnableUser(OUsrModel usr)
    {

    }

    private void DisableUser(OUsrModel usr)
    {

    }

    private void DeleteUser(OUsrModel usr)
    {

    }
}
