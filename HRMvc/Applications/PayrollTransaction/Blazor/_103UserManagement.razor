@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRMvc.Applications.PayrollTransaction.Blazor._103
@using HRMvc.Applications.PayrollTransaction.Blazor._103._103_UA
@using HRMvc.Applications.PayrollTransaction.Blazor._103._103_UM
@using HRMvc.Applications.PayrollTransaction.Vars


<TelerikRootComponent>


    @* =================================================
         NOTIFICATION
        ================================================= *@
    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />


    <CascadingValue Value="@v">
        <CascadingValue Value="@NotificationRef">

            @* =================================================
             MODULE TITLE
            ================================================= *@
            <TelerikCard Height="100%">
                <CardHeader>
                    <h2 class="k-font-weight-bold  k-font-size-md">User Management</h2>
                </CardHeader>



                <CardBody>
                    <TelerikTabStrip ActiveTabId="@tab"
                                     ActiveTabIdChanged="@OnTabChanged"
                                     Height="calc(100vh - 120px)">

                        @* =================================================
                           USER MANAGER TAB
                        ================================================= *@
                        <TabStripTab Id="usermanager" Title="User Manager">
                            <_103_UserManager  />
                        </TabStripTab>


                        @* =================================================
                            USER ACCESS TAB
                        ================================================= *@
                        <TabStripTab Id="useraccess" Title="User Access">
                            <_103_UserAccess @ref="UserAccessRef" ChildAction="@ChilAction" />
                        </TabStripTab>


                    </TelerikTabStrip>
                </CardBody>
            </TelerikCard>
        </CascadingValue>
    </CascadingValue>




</TelerikRootComponent>

@inject I_00UsersAccess _user

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    private V103Model v = new();
    private TelerikNotification? NotificationRef;
    private string tab = "useraccess";

    private _103_UserAccess? UserAccessRef;

    protected override async Task OnInitializedAsync()
    {
        if (Uc?.Conn == null || Uc.OpisDb == null ||
             Uc.OpayDb == null || Uc.SchemaMain == null ||
             Uc.SchemaMainPis == null || Uc.SchemaMainPay == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        v.OPisdb = Uc.OpisDb;
        v.OPaydb = Uc.OpayDb;
        v.Maindb = Uc.SchemaMain;
        v.Mainpisdb = Uc.SchemaMainPis;
        v.Mainpaydb = Uc.SchemaMainPay;
        v.Conn = Uc.Conn;

        v.UcLoaded = true;
    }

    private async Task OnTabChanged(string id)
    {
        tab = id;

        if (id == "usermanager")
        {

        }


        if (id == "useraccess" && UserAccessRef != null)
        {
            await UserAccessRef.ResetTab();
        }
    }



    private async Task ChilAction()
    {
    }
 


}
