@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Modules._552O
@using HRApiLibrary.Modules._553O
@using HRApiLibrary.Modules._603O
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using Telerik.Blazor.Components
@using Telerik.SvgIcons

@inject IDA_553O _da
@inject IDA_552O _da552
@inject IOPisReportDataAccess _pisRep

<style>
    .ge-root { font-size:13px; color:#1f2a37; }
    .ge-root .k-input-inner, .ge-root .k-input-value-text, .ge-root .k-button, .ge-win .k-button { font-size:13px; }
    .ge-root .k-input-inner { padding:4px 8px; }
    .ge-root .k-input, .ge-root .k-picker { min-height:30px; }
    .ge-root .k-grid, .ge-win .k-grid { font-size:12.5px; }
    .ge-root .k-grid td, .ge-root .k-grid th, .ge-win .k-grid td, .ge-win .k-grid th { padding:5px 8px; font-size:12.5px !important; }
    .ge-root .k-grid th, .ge-root .k-grid .k-header, .ge-root .k-grid .k-column-title, .ge-win .k-grid th, .ge-win .k-grid .k-column-title { font-size:12.5px !important; font-weight:600; background:#f4f6f9; }
    .ge-root .k-button, .ge-win .k-button { padding:5px 12px; }
    .ge-root .k-numerictextbox .k-input-inner { text-align:right !important; }
    .ge-root .k-numerictextbox .k-input-spinner { display:none !important; }
    .ge-root .k-grid tbody tr, .ge-win .k-grid tbody tr { cursor:pointer; }
    .ge-bar { display:flex; align-items:center; gap:8px; margin-bottom:10px; flex-wrap:wrap; }
    .ge-card { background:#fff; border:1px solid #7d8895; border-radius:6px; padding:12px 16px 14px; margin-bottom:12px; }
    .ge-card .k-input, .ge-card .k-picker, .ge-card .k-input-inner, .ge-card .k-input-button { border-color:#8a95a3 !important; }
    .ge-title { font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:#5b6573; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; }
    .ge-f label { display:block; font-size:11.5px; font-weight:600; color:#5b6573; margin-bottom:3px; }
    .ge-left { width:340px; flex-shrink:0; display:flex; flex-direction:column; }
    .ge-grow { flex:1 1 auto; display:flex; flex-direction:column; margin-bottom:0; }
    .ge-remarks { margin-top:auto; padding-top:12px; }
    .ge-row { display:flex; gap:8px; margin-bottom:8px; align-items:center; }
    .ge-checks { display:flex; gap:14px; align-items:center; height:30px; }
    .ge-checks label { margin:0; font-size:13px; font-weight:500; color:#222; display:flex; align-items:center; gap:5px; }
    .ge-win .ge-note { font-size:12px; color:#6b7480; }
    .ge-red td { color:#c62828; }
    .ge-gray td { color:#8a93a0; }
</style>

<TelerikRootComponent>
<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="NotificationHorizontalPosition.Center"
                     VerticalPosition="NotificationVerticalPosition.Top" />

<_00BT_FullW HdrCaption="Group Earnings Entry">
    <Details>
    <div class="p-2 ge-root">

        <div class="ge-bar">
            <TelerikButton OnClick="@Save" ThemeColor="primary" Icon="@SvgIcon.Save" Enabled="@(!busy)">Save</TelerikButton>
            <TelerikButton OnClick="@AskDelete" ThemeColor="error" FillMode="outline" Icon="@SvgIcon.Trash" Enabled="@(!busy)">Delete</TelerikButton>
            <TelerikButton OnClick="@(() => showPrintOpt = true)" FillMode="outline" Icon="@SvgIcon.Print">Print</TelerikButton>
            <TelerikButton OnClick="@OpenStatus" FillMode="outline" Icon="@SvgIcon.Gear">Emp. Status Setting</TelerikButton>
            <span class="ms-auto small text-muted"><b>@marked.Count</b> employee(s) marked</span>
        </div>

        <div class="d-flex gap-3 flex-wrap flex-xl-nowrap">

            <div class="ge-left">
                <div class="ge-card">
                    <div class="ge-f mb-2">
                        <label>Payroll Group / Client</label>
                        <TelerikDropDownList Data="@clientOptions" @bind-Value="clientFilter" TextField="ClName" ValueField="ClNumber" Width="100%" Filterable="true" FilterOperator="Telerik.Blazor.StringFilterOperator.Contains">
                            <DropDownListSettings><DropDownListPopupSettings Height="420px" /></DropDownListSettings>
                        </TelerikDropDownList>
                    </div>
                    <div class="ge-f">
                        <label>Employee Name</label>
                        <input class="form-control form-control-sm" placeholder="Locate..." @bind="empSearch" @bind:event="oninput" />
                    </div>
                </div>

                <div class="ge-card ge-grow">
                    <div class="ge-title">Other earnings</div>
                    @for (int i = 0; i < deds.Count; i++)
                    {
                        var d = deds[i];
                        <div class="ge-row">
                            <TelerikDropDownList Data="@accounts" Value="@d.AcctNumber" ValueChanged="@((string v) => SetAcct(d, v))" TextField="AcctName" ValueField="AcctNumber" DefaultText="Select earning" Width="190px" Filterable="true" FilterOperator="Telerik.Blazor.StringFilterOperator.Contains">
                                <DropDownListSettings><DropDownListPopupSettings Height="420px" /></DropDownListSettings>
                            </TelerikDropDownList>
                            <TelerikNumericTextBox Arrows="false" Step="0" Class="num-right" @bind-Value="d.Amount" Min="0" Decimals="2" Format="N2" Width="100px" />
                            @if (!string.IsNullOrEmpty(d.AcctNumber)) { <TelerikButton OnClick="@(() => RemoveDed(d))" FillMode="flat" Icon="@SvgIcon.X" Title="Remove" /> }
                        </div>
                    }
                    <div class="ge-f ge-remarks">
                        <label>Remarks</label>
                        <TelerikTextBox @bind-Value="remarks" MaxLength="45" Width="100%" />
                    </div>
                </div>
            </div>

            <div class="flex-fill" style="min-width:0;">
                <div class="ge-card">
                    <div class="ge-title">Posting period</div>
                    <div class="d-flex gap-3 flex-wrap align-items-end">
                        <div class="ge-f"><label>Year</label><TelerikDropDownList Data="@years" @bind-Value="year" Width="100px" /></div>
                        <div class="ge-f"><label>Month</label><TelerikDropDownList Data="@months" @bind-Value="month" TextField="Text" ValueField="Value" Width="150px" /></div>
                        <div class="ge-f"><label>Period</label><TelerikDropDownList Data="@periods" Value="@period" ValueChanged="@((string v) => SetPeriod(v))" TextField="PdName" ValueField="PdNumber" Width="150px" /></div>
                        <div class="ge-f"><label>Effective Date</label><TelerikDatePicker @bind-Value="effective" Format="MM/dd/yyyy" Width="150px" /></div>
                    </div>
                    <div class="ge-checks mt-2">
                        <label><TelerikCheckBox @bind-Value="contProc" /> <b>Cont. Process</b></label>
                        <label><TelerikCheckBox @bind-Value="p1" /> Prd1</label>
                        <label><TelerikCheckBox @bind-Value="p2" /> Prd2</label>
                        <label><TelerikCheckBox @bind-Value="p3" /> Prd3</label>
                        <label><TelerikCheckBox @bind-Value="p4" /> Prd4</label>
                        <label><TelerikCheckBox @bind-Value="p5" /> Prd5</label>
                    </div>
                </div>

                <TelerikGrid Data="@shownEmps" Height="calc(100vh - 430px)" Size="@ThemeConstants.Grid.Size.Small" Sortable="false"
                             Pageable="true" PageSize="25">
                    <GridColumns>
                        <GridColumn Width="44px" TextAlign="ColumnTextAlign.Center">
                            <HeaderTemplate><TelerikCheckBox Value="@AllMarked" ValueChanged="@((bool v) => MarkAll(v))" /></HeaderTemplate>
                            <Template>@{ var e = (M553_Emp)context; }<TelerikCheckBox Value="@marked.Contains(e.EmpNumber)" ValueChanged="@((bool v) => Mark(e, v))" /></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(M553_Emp.EmpNumber)" Title="Emp. No." Width="90px" />
                        <GridColumn Field="@nameof(M553_Emp.EmpName)" Title="Employee Name" />
                        <GridColumn Field="@nameof(M553_Emp.Position)" Title="Position" Width="170px" />
                        <GridColumn Field="@nameof(M553_Emp.Status)" Title="Status" Width="150px" />
                    </GridColumns>
                    <NoDataTemplate><div class="p-2 text-muted">No employees.</div></NoDataTemplate>
                </TelerikGrid>
            </div>

        </div>
    </div>
    </Details>
</_00BT_FullW>

@* ---------- Save view : new entries and entries for update ---------- *@
<TelerikWindow Modal="true" @bind-Visible="@showPrev" Width="min(1060px, 96vw)" Height="86vh" Class="ge-win">
    <WindowTitle>Review before saving</WindowTitle>
    <WindowContent>
        <div class="ge-win d-flex flex-column" style="height:100%">
            <div class="d-flex gap-3 flex-fill" style="min-height:0">
                <div style="width:280px;flex-shrink:0">
                    <TelerikGrid Data="@prevAccts" Height="100%" Size="@ThemeConstants.Grid.Size.Small" Sortable="false"
                                 SelectionMode="GridSelectionMode.Single" SelectedItems="@selPrevAcct" SelectedItemsChanged="@((IEnumerable<M603_Ded> e) => PickPrevAcct(e.FirstOrDefault()))">
                        <GridColumns>
                            <GridColumn Field="@nameof(M603_Ded.AcctName)" Title="Account Name" />
                            <GridColumn Field="@nameof(M603_Ded.Amount)" Title="Amount" DisplayFormat="{0:N2}" Width="100px" TextAlign="ColumnTextAlign.Right" />
                        </GridColumns>
                    </TelerikGrid>
                </div>
                <div class="flex-fill" style="min-width:0">
                    <TelerikTabStrip>
                        <TabStripTab Title="@($"New Entry ({newRows.Count})")">
                            <TelerikGrid Data="@newRows" Height="46vh" Size="@ThemeConstants.Grid.Size.Small" Sortable="false">
                                <GridColumns>
                                    <GridColumn Field="@nameof(M553_Prev.EmpName)" Title="Name" />
                                    <GridColumn Field="@nameof(M553_Prev.NewAmt)" Title="Amount" DisplayFormat="{0:N2}" Width="110px" TextAlign="ColumnTextAlign.Right" />
                                    <GridColumn Field="@nameof(M553_Prev.ClName)" Title="Deployment" Width="200px" />
                                </GridColumns>
                                <NoDataTemplate><div class="p-2 text-muted">No new entry for this account.</div></NoDataTemplate>
                            </TelerikGrid>
                        </TabStripTab>
                        <TabStripTab Title="@($"For Update ({updRows.Count})")">
                            <TelerikGrid Data="@updRows" Height="46vh" Size="@ThemeConstants.Grid.Size.Small" Sortable="false"
                                         OnRowRender="@OnPrevRowRender">
                                <GridColumns>
                                    <GridColumn Width="44px" TextAlign="ColumnTextAlign.Center">
                                        <Template>@{ var r = (M553_Prev)context; }<TelerikCheckBox @bind-Value="r.Apply" Enabled="@(r.ContProc == 0 && r.Processed == 0)" /></Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(M553_Prev.EmpName)" Title="Name" />
                                    <GridColumn Field="@nameof(M553_Prev.ExistingAmt)" Title="Existing Amt" DisplayFormat="{0:N2}" Width="110px" TextAlign="ColumnTextAlign.Right" />
                                    <GridColumn Field="@nameof(M553_Prev.NewAmt)" Title="New Amt" DisplayFormat="{0:N2}" Width="110px" TextAlign="ColumnTextAlign.Right" />
                                    <GridColumn Field="@nameof(M553_Prev.ClName)" Title="Deployment" Width="200px" />
                                </GridColumns>
                                <NoDataTemplate><div class="p-2 text-muted">Nothing to update for this account.</div></NoDataTemplate>
                            </TelerikGrid>
                        </TabStripTab>
                    </TelerikTabStrip>
                    <div class="ge-note mt-2">
                        Note : - Uncheck an entry to disregard its change.<br />
                        - Records with CONT PROCESS (red) or already processed (gray) are exempt from changes.
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <TelerikButton OnClick="@(() => showCommit = true)" ThemeColor="primary" Icon="@SvgIcon.Save" Enabled="@(!busy)">Save</TelerikButton>
                <TelerikButton OnClick="@(() => showPrev = false)">Cancel</TelerikButton>
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showCommit" Width="360px">
    <WindowTitle>Confirm Save</WindowTitle>
    <WindowContent>
        <div class="p-1">Commit Changes?</div>
        <div class="d-flex gap-2 justify-content-end mt-3">
            <TelerikButton OnClick="@Commit" ThemeColor="primary" Enabled="@(!busy)">Yes</TelerikButton>
            <TelerikButton OnClick="@(() => showCommit = false)">No</TelerikButton>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showDelete" Width="440px">
    <WindowTitle>Confirm Delete</WindowTitle>
    <WindowContent>
        <div class="p-1">
            Delete <b>@delCount</b> earning record(s) of the <b>@marked.Count</b> marked employee(s) for the earning(s) in the list,
            @months.First(x => x.Value == month).Text @year, @(periods.FirstOrDefault(x => x.PdNumber == period)?.PdName ?? period)?
            <div class="small text-muted mt-2">Only earnings that are not yet processed and not continuous are deleted.</div>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-3">
            <TelerikButton OnClick="@DoDelete" ThemeColor="error" Enabled="@(delCount > 0 && !busy)">Yes, delete</TelerikButton>
            <TelerikButton OnClick="@(() => showDelete = false)">No</TelerikButton>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showPrintOpt" Width="360px">
    <WindowTitle>Print Options</WindowTitle>
    <WindowContent>
        <div class="p-1">
            <div class="small text-muted mb-2">@months.First(x => x.Value == month).Text @year, @(periods.FirstOrDefault(x => x.PdNumber == period)?.PdName ?? period)</div>
            <label class="d-block mb-1"><input type="radio" name="geprint" checked="@(printGroup == 1)" @onchange="@(() => printGroup = 1)" /> group by employee</label>
            <label class="d-block mb-1"><input type="radio" name="geprint" checked="@(printGroup == 2)" @onchange="@(() => printGroup = 2)" /> group by payroll group</label>
            <label class="d-block mb-1"><input type="radio" name="geprint" checked="@(printGroup == 3)" @onchange="@(() => printGroup = 3)" /> group by earning description</label>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-3">
            <TelerikButton OnClick="@DoPrint" ThemeColor="primary" Enabled="@(!busy)">Ok</TelerikButton>
            <TelerikButton OnClick="@(() => showPrintOpt = false)">Cancel</TelerikButton>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showReport" Width="min(1000px, 95vw)" Height="92vh">
    <WindowTitle>Other Earnings Summary</WindowTitle>
    <WindowContent>
        @if (showReport)
        {
            <IframeReportRenderer DataSource="@reportData" ReportRelativePath="@reportPath" OutputFormat="PDF" Parameters="@reportParams"
                                  AutoGenerate="true" RefreshToken="@reportToken" />
        }
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showStatus" Width="520px" Class="ge-win">
    <WindowTitle>Other Earnings Status Settings</WindowTitle>
    <WindowContent>
        <div class="ge-win">
            <div class="ge-note mb-2">Employees with a ticked status are listed in this module.</div>
            <TelerikGrid Data="@statusFlags" Height="60vh" Size="@ThemeConstants.Grid.Size.Small">
                <GridColumns>
                    <GridColumn Field="@nameof(M552_Flag.Name)" Title="Employment Status" />
                    <GridColumn Title="Included" Width="90px" TextAlign="ColumnTextAlign.Center">
                        <Template>@{ var x = (M552_Flag)context; }<TelerikCheckBox Value="@x.On" ValueChanged="@((bool v) => SetStatus(x, v))" /></Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
            <div class="d-flex justify-content-end mt-3"><TelerikButton OnClick="@CloseStatus">Close</TelerikButton></div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>
</TelerikRootComponent>

@code {
    [Parameter] public UserClaimsModel? UserClaims { get; set; }

    record Opt<T>(string Text, T Value);

    TelerikNotification? NotificationRef;

    string Opay => UserClaims?.OpayDb ?? "";
    string Opis => UserClaims?.OpisDb ?? "";
    string Conn => UserClaims?.Conn ?? "";

    List<int> years = Enumerable.Range(DateTime.Today.Year - 3, 6).ToList();
    List<Opt<int>> months = Enumerable.Range(1, 12).Select(i => new Opt<int>(System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(i), i)).ToList();
    int year = DateTime.Today.Year, month = DateTime.Today.Month;
    List<M603_Period> periods = new();
    string period = "01";
    DateTime? effective = DateTime.Today;
    bool contProc, p1 = true, p2, p3, p4, p5;

    List<M603_Client> clientOptions = new();
    string clientFilter = "_";
    string empSearch = "";
    List<M553_Emp> emps = new();
    HashSet<string> marked = new();

    List<M603_Acct> accounts = new();
    List<M603_Ded> deds = new() { new() };
    string remarks = "";
    bool busy;

    List<M553_Emp> shownEmps => emps.Where(e =>
        (clientFilter == "_" || (clientFilter == "+" ? e.InPayroll : (e.ClNumber == clientFilter && e.EmpStat == "A")))
        && (string.IsNullOrWhiteSpace(empSearch) || e.EmpName.Contains(empSearch, StringComparison.OrdinalIgnoreCase) || e.EmpNumber.Contains(empSearch))).ToList();

    bool AllMarked => shownEmps.Count > 0 && shownEmps.All(e => marked.Contains(e.EmpNumber));

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Opay)) return;
        try
        {
            var cl = await _da._02Clients(Opis, Conn);
            clientOptions = new() { new() { ClNumber = "_", ClName = "***ALL***" }, new() { ClNumber = "+", ClName = "***IN PAYROLL LIST***" } };
            clientOptions.AddRange(cl);
            emps = await _da._02Employees(Opis, Conn);
            accounts = await _da._02Accounts(Opay, Conn);
            periods = await _da._02Periods(Opay, Conn);
            if (periods.Count > 0) period = periods[0].PdNumber;
        }
        catch (Exception ex) { Console.Error.WriteLine("553 load failed: " + ex); Warn("Unable to load the data."); }
    }

    void Mark(M553_Emp e, bool v) { if (v) marked.Add(e.EmpNumber); else marked.Remove(e.EmpNumber); }

    void MarkAll(bool v)
    {
        foreach (var e in shownEmps) { if (v) marked.Add(e.EmpNumber); else marked.Remove(e.EmpNumber); }
    }

    void SetPeriod(string v)
    {
        period = v;
        p1 = v == "01"; p2 = v == "02"; p3 = v == "03"; p4 = v == "04"; p5 = v == "05";
    }

    void SetAcct(M603_Ded d, string v)
    {
        d.AcctNumber = v;
        d.AcctName = accounts.FirstOrDefault(a => a.AcctNumber == v)?.AcctName ?? "";
        if (deds.Count > 0 && !string.IsNullOrEmpty(deds[^1].AcctNumber)) deds.Add(new());
    }

    void RemoveDed(M603_Ded d)
    {
        deds.Remove(d);
        if (deds.Count == 0 || !string.IsNullOrEmpty(deds[^1].AcctNumber)) deds.Add(new());
    }

    // ---------- Save view ----------
    bool showPrev, showCommit;
    List<M553_Prev> prev = new();
    IEnumerable<M603_Ded> selPrevAcct = Array.Empty<M603_Ded>();
    string prevAcct = "";
    List<M603_Ded> prevAccts => deds.Where(d => !string.IsNullOrEmpty(d.AcctNumber)).ToList();
    List<M553_Prev> newRows => prev.Where(r => r.ControlNo == 0 && r.AcctNumber == prevAcct).ToList();
    List<M553_Prev> updRows => prev.Where(r => r.ControlNo > 0 && r.AcctNumber == prevAcct).ToList();

    void OnPrevRowRender(GridRowRenderEventArgs args)
    {
        if (args.Item is M553_Prev r) args.Class = r.ContProc == 1 ? "ge-red" : r.Processed == 1 ? "ge-gray" : "";
    }

    void PickPrevAcct(M603_Ded? d)
    {
        if (d == null) return;
        selPrevAcct = new[] { d }; prevAcct = d.AcctNumber.Trim();
    }

    async Task Save()
    {
        if (busy) return;
        await Task.Delay(300);
        var err = _da._02Validate(marked.ToList(), deds, contProc, p1, p2, p3, p4, p5, effective);
        if (err != null) { Warn(err); return; }
        busy = true;
        try
        {
            var chosen = emps.Where(e => marked.Contains(e.EmpNumber)).ToList();
            prev = await _da._02Preview(chosen, deds, year, month, period, effective!.Value, Opay, Conn);
            var first = prevAccts.FirstOrDefault();
            if (first != null) PickPrevAcct(first);
            showPrev = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("553 preview failed: " + ex); Warn("Unable to prepare the review."); }
        finally { busy = false; }
    }

    async Task Commit()
    {
        if (busy) return;
        busy = true;
        try
        {
            var (ins, upd) = await _da._01Commit(prev, year, month, period, remarks, effective!.Value, contProc, p1, p2, p3, p4, p5, Opay, Conn);
            showCommit = false; showPrev = false;
            NotificationRef?.Show($"Successfully Saved! ({ins} new, {upd} updated)", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex) { Console.Error.WriteLine("553 commit failed: " + ex); Warn("Unable to save."); }
        finally { busy = false; }
    }

    // ---------- Delete ----------
    bool showDelete;
    int delCount;

    async Task AskDelete()
    {
        if (marked.Count < 1) { Warn("No employee selected."); return; }
        if (!deds.Any(d => !string.IsNullOrEmpty(d.AcctNumber))) { Warn("No earnings selected."); return; }
        try
        {
            delCount = await _da._02DeleteCount(marked.ToList(), deds, year, month, period, Opay, Conn);
            if (delCount < 1) { Warn("Nothing to delete for the marked employees and earnings in this period."); return; }
            showDelete = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("553 delete count failed: " + ex); Warn("Unable to check the records."); }
    }

    async Task DoDelete()
    {
        if (busy) return;
        busy = true;
        try
        {
            await _da._04Delete(marked.ToList(), deds, year, month, period, Opay, Conn);
            showDelete = false;
            NotificationRef?.Show(delCount + " record(s) deleted", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex) { Console.Error.WriteLine("553 delete failed: " + ex); Warn("Unable to delete."); }
        finally { busy = false; }
    }

    // ---------- Print ----------
    bool showPrintOpt, showReport;
    int printGroup = 1, reportToken;
    List<R603_Print> reportData = new();
    string reportPath = "";
    Dictionary<string, object> reportParams = new();

    async Task DoPrint()
    {
        if (busy) return;
        busy = true;
        try
        {
            var data = await _da._02Print(year, month, period, printGroup, Opis, Opay, Conn);
            if (data.Count < 1) { showPrintOpt = false; Warn("No transcations at this period"); return; }
            string name = "-", addr = "-";
            var co = (await _pisRep._02CoInfo(Opis, Conn) ?? []).FirstOrDefault();
            if (co != null) { name = co.CoName ?? ""; addr = co.CoAdd ?? ""; }
            reportParams = new() { ["CoName"] = name, ["CoAddress"] = addr, ["RunDate"] = DateTime.Now };
            reportData = data;
            reportPath = "Reports/_03Payroll/K_OtherEarn" + printGroup + ".trdp";
            reportToken++;
            showPrintOpt = false;
            showReport = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("553 print failed: " + ex); Warn("Unable to print."); }
        finally { busy = false; }
    }

    // ---------- Emp. Status Setting ----------
    bool showStatus, statusChanged;
    List<M552_Flag> statusFlags = new();

    async Task OpenStatus()
    {
        try { statusFlags = await _da552._02StatusFlags(Opis, Conn); statusChanged = false; showStatus = true; }
        catch (Exception ex) { Console.Error.WriteLine("553 status failed: " + ex); Warn("Unable to load the settings."); }
    }

    async Task SetStatus(M552_Flag x, bool v)
    {
        try { await _da552._03StatusFlag(x.Key, v, Opis, Conn); x.On = v; statusChanged = true; }
        catch (Exception ex) { Console.Error.WriteLine("553 status set failed: " + ex); Warn("Unable to save the setting."); }
    }

    async Task CloseStatus()
    {
        showStatus = false;
        if (!statusChanged) return;
        emps = await _da._02Employees(Opis, Conn);
        marked.RemoveWhere(n => !emps.Any(e => e.EmpNumber == n));
    }

    void Warn(string msg) => NotificationRef?.Show(msg, ThemeConstants.Notification.ThemeColor.Warning);
}
