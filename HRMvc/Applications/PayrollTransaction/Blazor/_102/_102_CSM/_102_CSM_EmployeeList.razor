@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PayrollTransaction.Vars

@inject IAtttemplateDataAccess _atttemplate

<div class="employee-list h-100 d-flex flex-column">
    <TelerikGrid TItem="OEmpmasModel"
                 @ref="EmployeeAssignedGrid"
                 Data="@V.AssignedEmployees"
                 SelectionMode="@GridSelectionMode.Multiple"
                 SelectedItems="@V.SelectedAssignedEmployees"
                 SelectedItemsChanged="@OnSelectedEmployeesChanged"
                 Pageable="true"
                 PageSize="11"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Sortable="true"
                 Resizable="true"
                 Navigable="true"
                 Width="100%"
                 Height="100%">
        <GridColumns>
            <GridCheckboxColumn SelectAll="true"
                                SelectAllMode="@GridSelectAllMode.Current"
                                Width="50px" />
            <GridColumn Field="@nameof(OEmpmasModel.Fullname)"
                        Title="Employee Name" />
        </GridColumns>
        <NoDataTemplate>
            <div class="text-center text-secondary p-3">
                @if (V.SelectedPayrollGroup <= 0)
                {
                    <div>Select a payroll group to see assigned employees.</div>
                }
                else if (HasActiveFilter)
                {
                    <div>No employees match the current filter.</div>
                    <div class="k-font-size-sm">Clear the column filter to see everyone.</div>
                }
                else
                {
                    <div>No one is assigned to this group yet.</div>
                }
            </div>
        </NoDataTemplate>
    </TelerikGrid>
</div>

@code {
    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public V102Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OEmpmasModel>? EmployeeAssignedGrid;

    private bool HasActiveFilter =>
        EmployeeAssignedGrid?.GetState().FilterDescriptors?.Any() == true;

    private async Task OnSelectedEmployeesChanged(IEnumerable<OEmpmasModel> employees)
    {
        var lastEmployee = string.Empty;

        try
        {
            V.SelectedAssignedEmployees = employees?.ToList() ?? [];
            V.SelectedEmployee = string.Empty;
            V.CurrentAttendance = new AtttemplateModel();

            if (V.SelectedAssignedEmployees.Count == 0)
            {
                await ChildAction.InvokeAsync();
                return;
            }

            var employee = V.SelectedAssignedEmployees.LastOrDefault();

            if (employee == null)
            {
                await ChildAction.InvokeAsync();
                return;
            }

            lastEmployee = employee.Fullname ?? "-";

            if (Uc == null)
            {
                NotificationRef?.Show(
                    "User information is unavailable.",
                    ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            var result = await _atttemplate._02(
                employee.UserId,
                Uc.SchemaUserPis,
                V.conn);

            if (result != null && result.EmpmasId > 0)
            {
                V.SelectedEmployee = employee.Fullname;
                V.CurrentAttendance = result;
            }

            await ChildAction.InvokeAsync();
        }
        catch (Exception)
        {
            NotificationRef?.Show(
                $"Couldn't get the current schedule of {lastEmployee}",
                ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    public async Task UnselectAllEmployees()
    {
        V.SelectedAssignedEmployees = [];

        if (EmployeeAssignedGrid != null)
        {
            var state = EmployeeAssignedGrid.GetState();
            state.SelectedItems = [];
            await EmployeeAssignedGrid.SetStateAsync(state);
        }

        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();
        await ChildAction.InvokeAsync();
    }

    public async Task ResetGrid()
    {
        V.SelectedAssignedEmployees = [];
        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();

        if (EmployeeAssignedGrid != null)
        {
            await EmployeeAssignedGrid.SetStateAsync(
                new GridState<OEmpmasModel>());
        }
    }
}

<style>
    .employee-list {
        width: 100%;
    }
</style>
