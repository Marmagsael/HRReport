@using System.ComponentModel
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._90_Utils
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications._00GeneralComponents.TelerikComponents.Grid

@inject IODeprecDataAccess _deprec

<div class="employee-list">


    @*========= GRID ===========*@
    <TelerikGrid TItem="ODeprecModel"
                 @ref="DeprecGrid"
                 OnRead="@OnGridRead"
                 SelectionMode="@GridSelectionMode.Multiple"
                 @bind-SelectedItems="@SelectedEmployees"
                 Pageable="true"
                 PageSize="11"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Sortable="true"
                 Resizable="true"
                 Navigable="true"
                 CustomKeyboardShortcuts="@GridCustomShortcuts"
                 Width="100%"
                 Height="calc(100vh - 350px)">

        <GridColumns>

            <GridCheckboxColumn SelectAll="true"
                                SelectAllMode="@GridSelectAllMode.Current"
                                Width="50px" />

            <GridColumn Field="@nameof(ODeprecModel.EmpName)" Title="Employee name" />

        </GridColumns>

        <NoDataTemplate>
            <div class="text-center text-secondary p-3">

                @if (V.SelectedPayrollGroup <= 0)
                {
                    <div>Select a payroll group to see assigned employees.</div>
                }
                else if (HasActiveFilter)
                {
                    <div>No employees match the current filter.</div>
                    <div class="k-font-size-sm">Clear the column filter to see everyone.</div>
                }
                else
                {
                    <div>No one assigned to this group yet</div>
                    <div class="k-font-size-sm">Click the '+' to add employees.</div>
                }

            </div>
        </NoDataTemplate>

    </TelerikGrid>

</div>

@code {

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public Telerik.Blazor.DialogFactory? TelerikDialogs { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public V102Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<ODeprecModel>? DeprecGrid;
    private IEnumerable<ODeprecModel> SelectedEmployees { get; set; } = new List<ODeprecModel>();

    private bool HasActiveFilter => DeprecGrid?.GetState().FilterDescriptors?.Any() == true;


    private readonly Dictionary<GridKeyboardScope, Dictionary<string, GridKeyboardCommand?>>
        GridCustomShortcuts = new()
        {
            [GridKeyboardScope.Common] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["W"] = GridKeyboardCommand.NavigateUp,
                    ["S"] = GridKeyboardCommand.NavigateDown,
                    ["A"] = GridKeyboardCommand.NavigateLeft,
                    ["D"] = GridKeyboardCommand.NavigateRight,

                    ["ArrowUp"] = GridKeyboardCommand.NavigateUp,
                    ["ArrowDown"] = GridKeyboardCommand.NavigateDown,
                    ["ArrowLeft"] = GridKeyboardCommand.NavigateLeft,
                    ["ArrowRight"] = GridKeyboardCommand.NavigateRight
                },

            [GridKeyboardScope.HeaderCell] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["O"] = GridKeyboardCommand.SortColumn,
                    ["Enter"] = GridKeyboardCommand.SortColumn
                },

            [GridKeyboardScope.DataCell] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["Enter"] = GridKeyboardCommand.Select
                }
        };


    private async Task OnGridRead(GridReadEventArgs args)
    {
        if (V.SelectedPayrollGroup <= 0)
        {
            args.Data = new List<ODeprecModel>();
            args.Total = 0;
            return;
        }

        var pageSize = args.Request.PageSize > 0 ? args.Request.PageSize : 10;
        var page = args.Request.Page > 0 ? args.Request.Page : 1;
        var offset = (page - 1) * pageSize;

        var sort = args.Request.Sorts.FirstOrDefault();
        var sortField = sort?.Member ?? nameof(ODeprecModel.EmpName);
        var sortDirection = sort?.SortDirection == Telerik.DataSource.ListSortDirection.Descending ? "DESC" : "ASC";

        var filters = GridHelper.GetFilters(args);

        var request = new GridRequestModel
        {
            PageSize = pageSize,
            Offset = offset,
            SortField = sortField,
            SortDirection = sortDirection,
            Filters = filters
        };

        var result = await _deprec._02Grid(V.SelectedPayrollGroup, request, V.pisdb, V.conn);

        args.Data = result.Data;
        args.Total = result.Total;
    }


    public Task RefreshGrid()
    {
        DeprecGrid?.Rebind();

        return Task.CompletedTask;
    }


    public async Task ResetGrid()
    {
        if (DeprecGrid == null)
        {
            return;
        }

        var state = DeprecGrid.GetState();
        state.FilterDescriptors.Clear();
        state.SortDescriptors.Clear();
        state.Page = 1;

        SelectedEmployees = new List<ODeprecModel>();

        await DeprecGrid.SetStateAsync(state);
    }


 
    

}

<style>

    .employee-list {
        width: 100%;
    }

</style>