@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PisModules.Vars
@using HRMvc.Applications.Vars
@using Radzen
@using Radzen.Blazor

<div class="border rounded">
    <div class="d-flex justify-content-between align-items-center p-2 bg-light border-bottom">
        <div class="d-flex align-items-center gap-2">
            <RadzenCheckBox @bind-Value="isAllSelected"
                            Change="@((bool value) => OnSelectAll(value))" />
            <h6 class="mb-0">Name</h6>
        </div>
    </div>

    <div class="border-bottom" style="height: calc(100vh - 260px); overflow-y: auto; overflow-x: hidden;">
        @if (V.EmpmasList?.Count > 0)
        {
            <table class="table table-sm table-hover mb-0">
                <tbody>
                    @foreach (var e in V.EmpmasList!)
                    {
                        <tr class="@(e.Sel ? "table-primary fw-bold" : "")" style="cursor: pointer;">
                            <td style="width: 40px;" class="p-2">
                                <RadzenCheckBox @bind-Value="e.Sel"
                                                Change="@((bool value) => ToggleEmployee(e, value))" />
                            </td>
                            <td class="p-2">
                                @e.Fullname - [@e?.EmpNumber]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="w-100 text-center bg-light text-muted border p-2">
                Record is empty.
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="bg-light text-dark text-center p-2 border-top small rounded-bottom">
        Employee Listing
    </div>
</div>



@inject IOEmpmasDataAccess _empmas
@inject I_00MainDA _main
@inject IEmpmovementDataAccess _empMovement
@inject IAtttemplateDataAccess _atttemplate
@inject NotificationService _notify

@code {
    int selectedCount = 0;
    bool isAllSelected = false;

    [Parameter]
    public V102Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }


    private async Task OnSelectAll(bool isChecked)
    {
        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();

        foreach (var e in V.EmpmasList)
        {
            e.Sel = isChecked;

            if (isChecked)
            {
                if (!V.SelectedEmployees.Contains(e))
                    V.SelectedEmployees.Add(e);
            }
            else
            {
                V.SelectedEmployees.Remove(e);
            }
        }

        isAllSelected = isChecked;

        if (V.SelectedEmployees.Count > 0) await GetCurrentSchedule(V.SelectedEmployees.LastOrDefault());
        await ChildAction.InvokeAsync();
    }

    private async Task ToggleEmployee(EmpmasInternalModel employee, bool isChecked)
    {
        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();

        employee.Sel = isChecked;

        var unSelectedEmployee = V.EmpmasList.Count(e => e.Sel == false);
        isAllSelected = unSelectedEmployee == 0;


        if (isChecked)
        {
            if (!V.SelectedEmployees.Contains(employee))
                V.SelectedEmployees.Add(employee);
        }
        else
        {
            V.SelectedEmployees.Remove(employee);
        }

        if (V.SelectedEmployees.Count > 0) await GetCurrentSchedule(V.SelectedEmployees.LastOrDefault());
        await ChildAction.InvokeAsync();
    }

    private async Task GetCurrentSchedule(EmpmasInternalModel employee)
    {
        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();


        try
        {
            if (employee == null)
            {
                return;
            }

            var result = await _atttemplate._02(employee.SystemId, V.pisdb, V.conn);

            if (result.EmpmasId > 0)
            {
                V.SelectedEmployee = employee.Fullname;
                V.CurrentAttendance = result;
                Console.WriteLine("res");
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
