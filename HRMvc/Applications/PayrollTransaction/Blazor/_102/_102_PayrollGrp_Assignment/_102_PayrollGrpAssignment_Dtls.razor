@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._90_Utils
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications._00GeneralComponents.TelerikComponents.Grid

@inject IODeprecDataAccess _deprec

<div class="w-100 h-100 d-flex flex-column">

    @* =========================================================
       SELECTED EMPLOYEES ACTION BAR

       This appears only when at least one employee is selected.
       flex-shrink-0 prevents the action bar from affecting the
       Grid's ability to display its pager.
       ========================================================= *@
    @if (SelectedEmployees.Any())
    {
        <div class="d-flex justify-content-between align-items-center p-2 border-bottom flex-shrink-0">

            <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Primary"
                          Position="@BadgePosition.Inline"
                          Rounded="@ThemeConstants.Badge.Rounded.Medium"
                          Size="@ThemeConstants.Badge.Size.Small"
                          FillMode="@ThemeConstants.Badge.FillMode.Solid">
                @SelectedEmployees.Count selected
            </TelerikBadge>

            <TelerikButton OnClick="@RemoveSelected"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           FillMode="@ThemeConstants.Button.FillMode.Clear"
                           Size="@ThemeConstants.Button.Size.Small"
                           Icon="@FontIcon.Trash">
                Remove selected
            </TelerikButton>

        </div>
    }


    @* =========================================================
       ASSIGNED EMPLOYEES GRID
       ========================================================= *@
    <TelerikGrid TItem="ODeprecModel"
                 @ref="DeprecGrid"
                 OnRead="@OnGridRead"
                 OnRowClick="@OnRowClick"
                 SelectionMode="@GridSelectionMode.Multiple"
                 SelectedItems="@SelectedEmployees"
                 SelectedItemsChanged="@OnSelectedEmployeesChanged"
                 Pageable="true"
                 @bind-PageSize="@PageSize"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Sortable="true"
                 Resizable="true"
                 Navigable="true"
                 Width="100%"
                 Class="flex-grow-1">

        @* =====================================================
           GRID PAGER
           ===================================================== *@
        <GridSettings>

            <GridPagerSettings PageSizes="@PageSizes" />

        </GridSettings>


        <GridColumns>

            @* =================================================
               CHECKBOX COLUMN

               IMPORTANT:

               - Clicking the checkbox itself is handled by
                 Telerik.
               - Clicking the employee name/row is handled by
                 OnRowClick.
               - Both selection methods are supported.
               ================================================= *@
            <GridCheckboxColumn SelectAll="true"
                                SelectAllMode="@GridSelectAllMode.All"
                                Width="50px" />

            @* =================================================
               EMPLOYEE NAME

               Clicking this cell triggers OnRowClick because
               the Grid handles the row click.
               ================================================= *@
            <GridColumn Field="@nameof(ODeprecModel.EmpName)"
                        Title="Employee name" />

        </GridColumns>


        @* =========================================================
           NO DATA MESSAGE
           ========================================================= *@
        <NoDataTemplate>

            <div class="text-center text-secondary p-3">

                @if (V.SelectedPayrollGroup <= 0)
                {
                    <div>
                        Select a payroll group to see assigned employees.
                    </div>
                }
                else if (HasActiveFilter)
                {
                    <div>
                        No employees match the current filter.
                    </div>

                    <div class="k-font-size-sm">
                        Clear the column filter to see everyone.
                    </div>
                }
                else
                {
                    <div>
                        No one assigned to this group yet.
                    </div>

                    <div class="k-font-size-sm">
                        Click the '+' to add employees.
                    </div>
                }

            </div>

        </NoDataTemplate>

    </TelerikGrid>

</div>


@code {

    [CascadingParameter]
    public Telerik.Blazor.DialogFactory? TelerikDialogs { get; set; }


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }


    [CascadingParameter]
    public V102Model V { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }


    private TelerikGrid<ODeprecModel>? DeprecGrid;


    @* =========================================================
       SELECTED EMPLOYEES

       This is the collection used by the component to keep
       track of all selected employees.

       Example:

       A selected
       B selected
       C selected

       Clicking B again removes only B.
       ========================================================= *@
    private List<ODeprecModel> SelectedEmployees { get; set; } = new();


    @* =========================================================
       ROW CLICK SELECTION FLAG

       When the employee name/row is clicked, Telerik will also
       perform its own selection processing.

       We use this flag to ignore ONLY that automatic
       SelectedItemsChanged event.

       Checkbox selection is NOT ignored.

       This allows both mechanisms to work:
       
       1. Row/name click
       2. Checkbox click
       ========================================================= *@
    private bool IgnoreNextSelectionChanged { get; set; }


    @* =========================================================
       DYNAMIC PAGE SIZE
       ========================================================= *@
    private int PageSize { get; set; } = 25;


    @* =========================================================
       AVAILABLE PAGE SIZES
       ========================================================= *@
    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100
    };


    @* =========================================================
       CHECK IF GRID HAS AN ACTIVE FILTER
       ========================================================= *@
    private bool HasActiveFilter =>
        DeprecGrid?.GetState().FilterDescriptors?.Any() == true;


    @* =========================================================
       ROW CLICK

       This provides custom multiple selection behavior.

       Telerik's normal multiple row selection can require
       Ctrl + Click.

       We do NOT want that.

       Our behavior is:

       Click A
           -> A selected

       Click B
           -> A + B selected

       Click C
           -> A + B + C selected

       Click B again
           -> A + C selected


       IMPORTANT:

       This method is for ROW/EMPLOYEE NAME clicks.

       Clicking the actual checkbox uses Telerik's normal
       checkbox selection mechanism.
       ========================================================= *@
    private void OnRowClick(GridRowClickEventArgs args)
    {
        var employee =
            (ODeprecModel)args.Item;


        var alreadySelected =
            SelectedEmployees.Any(
                x => x.EmpNumber == employee.EmpNumber);


        @* =====================================================
           IGNORE TELERIK'S AUTOMATIC SELECTION EVENT

           OnRowClick happens before Telerik completes its
           normal selection process.

           We handle the selection ourselves below.

           Therefore the next SelectedItemsChanged event
           generated by this row click must be ignored.
           ===================================================== *@
        IgnoreNextSelectionChanged = true;


        if (alreadySelected)
        {
            @* =============================================
               REMOVE ONLY THE CLICKED EMPLOYEE
               ============================================= *@

            SelectedEmployees =
                SelectedEmployees
                    .Where(x =>
                        x.EmpNumber != employee.EmpNumber)
                    .ToList();
        }
        else
        {
            @* =============================================
               ADD ONLY THE CLICKED EMPLOYEE

               Existing selections remain untouched.
               ============================================= *@

            SelectedEmployees =
                SelectedEmployees
                    .Concat(new[] { employee })
                    .ToList();
        }


        @* Force the Grid to render the updated selection. *@
        args.ShouldRender = true;
    }


    @* =========================================================
       TELERIK SELECTION CHANGED

       This method handles CHECKBOX selection.

       There are two possible sources:

       A. Employee row/name click
          -> Ignore the next event because OnRowClick already
             handled the selection.

       B. Actual checkbox click
          -> Accept Telerik's selection.

       This allows:

       - individual checkbox selection
       - individual checkbox deselection
       - multiple checkbox selection
       - Select All
       - Unselect All
       ========================================================= *@
    private void OnSelectedEmployeesChanged(
        IEnumerable<ODeprecModel> employees)
    {
        @* =====================================================
           ROW CLICK EVENT

           Ignore Telerik's automatic selection because
           OnRowClick already updated SelectedEmployees.
           ===================================================== *@
        if (IgnoreNextSelectionChanged)
        {
            IgnoreNextSelectionChanged = false;

            return;
        }


        @* =====================================================
           CHECKBOX EVENT

           This includes:

           - clicking an individual checkbox
           - clicking multiple checkboxes
           - Select All
           - Unselect All
           ===================================================== *@
        SelectedEmployees =
            employees.ToList();
    }


    @* =========================================================
       GRID READ

       Handles:

       - Server-side paging
       - Dynamic page size
       - Sorting
       - Filtering
       - Database loading
       ========================================================= *@
    private async Task OnGridRead(
        GridReadEventArgs args)
    {
        if (V.SelectedPayrollGroup <= 0)
        {
            args.Data =
                new List<ODeprecModel>();

            args.Total = 0;

            return;
        }


        @* =====================================================
           GET PAGE SIZE FROM TELERIK
           ===================================================== *@
        var pageSize =
            args.Request.PageSize;


        @* =====================================================
           FALLBACK TO CURRENT PAGE SIZE
           ===================================================== *@
        if (pageSize <= 0)
        {
            pageSize =
                PageSize;
        }


        @* =====================================================
           SAVE CURRENT PAGE SIZE
           ===================================================== *@
        PageSize =
            pageSize;


        @* =====================================================
           GET CURRENT PAGE
           ===================================================== *@
        var page =
            args.Request.Page > 0
                ? args.Request.Page
                : 1;


        @* =====================================================
           GET SORT
           ===================================================== *@
        var sort =
            args.Request.Sorts
                .FirstOrDefault();


        @* =====================================================
           BUILD DATABASE REQUEST
           ===================================================== *@
        var request =
            new GridRequestModel
            {
                PageSize =
                    pageSize,

                Offset =
                    (page - 1) * pageSize,

                SortField =
                    sort?.Member
                    ?? nameof(ODeprecModel.EmpName),

                SortDirection =
                    sort?.SortDirection ==
                    Telerik.DataSource.ListSortDirection.Descending
                        ? "DESC"
                        : "ASC",

                Filters =
                    GridHelper.GetFilters(args)
            };


        @* =====================================================
           LOAD DATA
           ===================================================== *@
        var result =
            await _deprec._02Grid(
                V.SelectedPayrollGroup,
                request,
                V.pisdb,
                V.conn);


        @* =====================================================
           SET GRID DATA
           ===================================================== *@
        args.Data =
            result?.Data
            ?? new List<ODeprecModel>();


        @* =====================================================
           SET TOTAL RECORD COUNT

           Telerik uses this value to calculate the number
           of pages in the pager.
           ===================================================== *@
        args.Total =
            result?.Total
            ?? 0;
    }


    @* =========================================================
       REFRESH GRID
       ========================================================= *@
    public Task RefreshGrid()
    {
        DeprecGrid?.Rebind();

        return Task.CompletedTask;
    }


    @* =========================================================
       RESET GRID
       ========================================================= *@
    public async Task ResetGrid()
    {
        @* Clear our selected employees. *@
        SelectedEmployees =
            new List<ODeprecModel>();


        @* Reset selection event handling. *@
        IgnoreNextSelectionChanged = false;


        if (DeprecGrid == null)
            return;


        var state =
            DeprecGrid.GetState();


        @* Clear filters. *@
        state.FilterDescriptors.Clear();


        @* Clear sorting. *@
        state.SortDescriptors.Clear();


        @* Return to first page. *@
        state.Page = 1;


        @* Clear Telerik selection. *@
        state.SelectedItems =
            new List<ODeprecModel>();


        await DeprecGrid.SetStateAsync(state);
    }


    @* =========================================================
       REMOVE SELECTED EMPLOYEES
       ========================================================= *@
    private async Task RemoveSelected()
    {
        var employees =
            SelectedEmployees.ToList();


        if (!employees.Any() ||
            TelerikDialogs == null)
            return;


        var message =
            employees.Count == 1
                ? $"Remove {employees[0].EmpName} ({employees[0].EmpNumber}) from this payroll group?"
                : $"Remove {employees.Count} selected employees from this payroll group?";


        var confirmed =
            await TelerikDialogs.ConfirmAsync(
                message,
                "Confirm removal");


        if (!confirmed)
            return;


        var failed =
            new List<string>();


        var removedCount = 0;


        @* =====================================================
           REMOVE EACH SELECTED EMPLOYEE
           ===================================================== *@
        foreach (var employee in employees)
        {
            try
            {
                await RemoveEmployee(employee);

                removedCount++;
            }
            catch
            {
                failed.Add(
                    employee.EmpName
                    ?? employee.EmpNumber
                    ?? "unknown");
            }
        }


        @* =====================================================
           CLEAR SELECTED EMPLOYEES
           ===================================================== *@
        SelectedEmployees =
            new List<ODeprecModel>();


        @* Reset selection event handling. *@
        IgnoreNextSelectionChanged = false;


        @* =====================================================
           CLEAR TELERIK GRID SELECTION
           ===================================================== *@
        if (DeprecGrid != null)
        {
            var state =
                DeprecGrid.GetState();


            state.Page = 1;


            state.SelectedItems =
                new List<ODeprecModel>();


            await DeprecGrid.SetStateAsync(state);
        }


        @* =====================================================
           NOTIFY PARENT
           ===================================================== *@
        if (removedCount > 0)
        {
            await ChildAction.InvokeAsync();
        }


        @* =====================================================
           SUCCESS
           ===================================================== *@
        if (failed.Count == 0)
        {
            NotificationRef?.Show(
                removedCount == 1
                    ? "Employee removed."
                    : $"{removedCount} employees removed.",
                ThemeConstants.Notification.ThemeColor.Success);
        }


        @* =====================================================
           PARTIAL SUCCESS
           ===================================================== *@
        else if (removedCount > 0)
        {
            NotificationRef?.Show(
                $"{removedCount} removed. Couldn't remove: {string.Join(", ", failed)}",
                ThemeConstants.Notification.ThemeColor.Warning);
        }


        @* =====================================================
           COMPLETE FAILURE
           ===================================================== *@
        else
        {
            NotificationRef?.Show(
                $"Couldn't remove: {string.Join(", ", failed)}",
                ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    @* =========================================================
       REMOVE ONE EMPLOYEE
       ========================================================= *@
    private async Task RemoveEmployee(
        ODeprecModel emp)
    {
        if (string.IsNullOrWhiteSpace(
                emp.EmpNumber))
        {
            throw new Exception(
                "Employee number is required.");
        }


        var updateEmp =
            new ODeprecModel
            {
                EmpNumber =
                    emp.EmpNumber,

                PayrollgrpId =
                    0
            };


        var result =
            await _deprec._01PayrollGrp(
                updateEmp,
                V.pisdb,
                V.conn);


        if (result == null)
        {
            throw new Exception(
                $"Failed to remove {emp.EmpName}.");
        }
    }
}


