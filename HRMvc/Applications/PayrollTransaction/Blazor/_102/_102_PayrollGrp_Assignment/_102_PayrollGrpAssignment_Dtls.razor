@inject DialogService _DialogService
<RadzenDialog />

<div class="p-0 bordered ">
    <div class="card-header small fw-bold text-secondary">
        Employee List
    </div>

    @if (V.Empmasgrps == null || V.Empmasgrps.Count == 0)
    {
        <div class="text-center text-secondary "> No assigned employee found. </div>
    } 


    <div class="card-body p-0 @lockDtlsCss ">
        @{
            int i = 0;
        }

         @foreach (EmpmasgrpModel emp in V.Empmasgrps)
            {
                i++;
                string? cssClass = i % 2 == 0 ? "bg-light" : "bg-white";

                <div class="d-flex w-100 p-2 @cssClass ">
                    <div class=" w-100 "> @emp?.EmpmasName</div>
                    <div @onclick="() => Remove(emp)" class="txt mb-a-red px-2 cur-pointer ">
                        <i class="fa-solid fa-xmark"></i>
                    </div>
                </div>
            } 
    </div>
</div>

