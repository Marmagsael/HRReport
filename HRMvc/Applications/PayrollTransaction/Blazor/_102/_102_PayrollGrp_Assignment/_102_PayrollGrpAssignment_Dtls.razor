@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications.PayrollTransaction.Vars

@inject IODeprecDataAccess _deprec

<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top"
                     AnimationType="@AnimationType.SlideLeft" />

<div class="bordered">

    <div class="d-flex justify-content-between align-items-center p-2 border-bottom">

        <div class="small fw-bold text-secondary">
            Employee List

            @if (SelectedEmployees.Any())
            {
                <span class="ms-2 badge bg-primary">
                    @SelectedEmployees.Count() selected
                </span>
            }
        </div>

        @if (SelectedEmployees.Any())
        {
            <TelerikButton OnClick="RemoveSelected"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           FillMode="@ThemeConstants.Button.FillMode.Clear"
                           Size="@ThemeConstants.Button.Size.Small"
                           Icon="@FontIcon.Trash"
                           Title="Remove selected employees">
            </TelerikButton>
        }

    </div>

    <div class="@lockDtlsCss">

        <TelerikGrid Data="@V.Deprecs"
                     SelectionMode="@GridSelectionMode.Multiple"
                     @bind-SelectedItems="@SelectedEmployees"
                     Pageable="true"
                     PageSize="10"
                     FilterMode="@GridFilterMode.FilterMenu"
                     Sortable="true"
                     Resizable="true"
                     Height="100%">

            <GridColumns>

                <GridCheckboxColumn SelectAll="true"
                                    SelectAllMode="@GridSelectAllMode.Current"
                                    Width="50px" />

                <GridColumn Field="@nameof(ODeprecModel.EmpName)"
                            Title="Employee Name" />

            </GridColumns>

            <NoDataTemplate>
                <div class="text-center text-secondary p-3">
                    No assigned employee found.
                </div>
            </NoDataTemplate>

        </TelerikGrid>

    </div>

</div>

@code {

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public Telerik.Blazor.DialogFactory? TelerikDialogs { get; set; }

    private TelerikNotification? NotificationRef;

    [Parameter]
    public V102Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private IEnumerable<ODeprecModel> SelectedEmployees { get; set; }   = new List<ODeprecModel>();

    private string lockDtlsCss =>  V.ShowAddMember ? "disabled-div-50" : "";

    private async Task RemoveSelected()
    {
        var employees = SelectedEmployees.ToList();

        if (!employees.Any())
        {
            return;
        }

        if (TelerikDialogs == null)
        {
            return;
        }

        string message = employees.Count == 1  ? $"Do you want to remove {employees[0].EmpName}?"  : $"Do you want to remove {employees.Count} selected employees?";
        var confirmed = await TelerikDialogs.ConfirmAsync(  message, "Confirm Delete");

        if (!confirmed)
        {
            return;
        }

        try
        {
            foreach (var employee in employees)
            {
                await RemoveEmployee(employee);
            }

            SelectedEmployees = new List<ODeprecModel>();
            NotificationRef?.Show(  employees.Count == 1 ? "Employee removed successfully."  : "Selected employees removed successfully.",  ThemeConstants.Notification.ThemeColor.Success);

            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef?.Show(ex.Message,  ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task RemoveEmployee(ODeprecModel emp)
    {
        if (string.IsNullOrWhiteSpace(emp.EmpNumber))
        {
            throw new Exception("Employee number is required.");
        }



        var updateEmp = new ODeprecModel
        {
            EmpNumber = emp.EmpNumber,
            PayrollgrpId = 0
        };

        await _deprec._01PayrollGrp( updateEmp, V.pisdb,  V.conn);
        V.Deprecs.Remove(emp);
        Console.Write(emp.EmpName);
    }
}