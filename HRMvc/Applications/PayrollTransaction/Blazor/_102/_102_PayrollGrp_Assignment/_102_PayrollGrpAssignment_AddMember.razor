@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PayrollTransaction.Vars

<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top"
                     AnimationType="@AnimationType.SlideLeft" />



@if (V.ShowAddMember)
{
    <TelerikCard Class="mb-2">
        <CardBody Class="p-2">

            <div class="d-flex gap-2 align-items-center">

                <div class="w-500p">
                    <TelerikTextBox @bind-Value="searchName"
                                    Placeholder="Search employee..."
                                    Class="w-100" />
                </div>

                <div class="d-flex gap-1">
                    <TelerikButton OnClick="SearchEmployee"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   Enabled="@(!IsSearchDisabled)"
                                   Icon="@FontIcon.Search">
                    </TelerikButton>

                    <TelerikButton OnClick="Close"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   Icon="@FontIcon.X">
                    </TelerikButton>
                </div>
               

            </div>

        </CardBody>

        @if (V.EmployeesNoPayGrp.Any())
        {
            <CardBody Class="bg-secondary bg-opacity-10 p-2">

                @foreach (var emp in V.EmployeesNoPayGrp)
                {
                    <div class="d-flex w-100 p-1 align-items-center">

                        <div class="w-100 text-end">
                            @emp?.Fullname
                            <span class="k-text-secondary k-font-size-sm">
                                [@emp.EmpNumber]
                            </span>
                        </div>

                        <TelerikButton OnClick="() => AddEmployee(emp)"
                                       FillMode="@ThemeConstants.Button.FillMode.Clear"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Icon="@FontIcon.Plus"
                                       Title="Add employee">
                        </TelerikButton>

                    </div>
                }

            </CardBody>
        }

    </TelerikCard>
}

@inject IOEmpmasDataAccess _oempmas;
@* @inject IDeprecDataAccess _odeprec; *@
@inject IODeprecDataAccess _deprec;

@code {

    [CascadingParameter]    public UserClaimsModel? Uc { get; set; }
    [Parameter]             public V102Model V { get; set; } = new();
    [Parameter]             public EventCallback ChildAction { get; set; }


    string? _searchName = "";

    string? searchName { get => _searchName; set { _searchName = value; V.EmployeesNoPayGrp = []; } }
    bool IsSearchDisabled => string.IsNullOrWhiteSpace(searchName) || searchName.Length < 3;


    private TelerikNotification? NotificationRef;

    // --- existing method --------------------------------------------------------------
    private async Task SearchEmployee()
    {
        try
        {
            V.EmployeesNoPayGrp = [];

            var search = searchName?.Trim();
            if (string.IsNullOrWhiteSpace(search))  return;

            var res = await _oempmas._02ByLNameAndFNamesNoPayGrpAssignment( search,V.pisdb,  V.conn);
            V.EmployeesNoPayGrp = res ?? [];
        }
        catch (Exception ex)
        {
            NotificationRef?.Show(  $"Unable to load unassigned employees. {ex}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    async Task Close()
    {
        V.ShowAddMember = false;
        searchName = "";
        V.EmployeesNoPayGrp = [];
        await ChildAction.InvokeAsync();

    }

    private async Task AddEmployee(OEmpmasModel? emp)
    {
        try
        {
            var res = await _deprec._02ByEmpnumber(emp.EmpNumber, V.pisdb, V.conn);

            if (res != null && res.PayrollgrpId != 0)
            {
                NotificationRef?.Show(  $"{emp.EmpName} is already assigned to another payroll group.", ThemeConstants.Notification.ThemeColor.Warning );
                return;  
            }

            var deprec = new ODeprecModel()
            {
                EmpNumber = emp.EmpNumber,
                PayrollgrpId = V.SelectedPayrollGroup,
            };

            var insertRes = await _deprec._01PayrollGrp(deprec, V.pisdb, V.conn);

            if (insertRes != null && !string.IsNullOrWhiteSpace(insertRes.EmpNumber))
            {
                V.EmployeesNoPayGrp.Remove(emp);
                await LoadAssignedEmployees();
            }
            NotificationRef?.Show("Employee added successfully.", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to add employee in this payroll group.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }
    private async Task LoadAssignedEmployees()
    {
        V.Action = "PayrollGrpChange";
        await ChildAction.InvokeAsync();
    }
} 