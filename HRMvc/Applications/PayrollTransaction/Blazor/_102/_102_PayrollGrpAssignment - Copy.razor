@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PayrollTransaction.Blazor._102._102_PayrollGrp_Assignment

@inject IODeprecDataAccess _deprec

<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top"
                     AnimationType="@AnimationType.SlideLeft" />

<div class="position-relative">

    <TelerikCard Class="w-300px">

        <CardHeader Class="bg-secondary bg-opacity-10">
            <div class="d-flex align-items-center gap-3">

                <label class="k-label">
                    Payroll group
                </label>

                <div style="width: 400px;">

                    <TelerikDropDownList Data="@V.PayrollGrps"
                                         @bind-Value="V.SelectedPayrollGroup"
                                         TextField="@nameof(PayrollgrpModel.Name)"
                                         ValueField="@nameof(PayrollgrpModel.Id)"
                                         Filterable="true"
                                         FilterPlaceholder="Search payroll group..."
                                         Width="100%"
                                         OnChange="@PayrollGrpChange">

                        <DropDownListSettings>
                            <DropDownListPopupSettings Width="450px"
                                                       Height="600px" />
                        </DropDownListSettings>

                    </TelerikDropDownList>

                </div>
            </div>
        </CardHeader>

        <CardBody>


            <TelerikCard Width="600px">

                <CardHeader Class="bg-secondary bg-opacity-10">

                    <div class="d-flex justify-content-between align-items-center w-100">

                        <span class="small fw-bold">
                            Assigned employees
                        </span>


                        <TelerikButton OnClick="@ToggleAddMember"
                                       Enabled="@(V.SelectedPayrollGroup > 0)"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       FillMode="@ThemeConstants.Button.FillMode.Clear"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Icon="@(V.ShowAddMember ? FontIcon.ChevronUp : FontIcon.Plus)"
                                       Title="@(V.ShowAddMember ? "Hide search" : "Add employee")" />

                    </div>

                </CardHeader>

                <CardBody>

                    @if (V.ShowAddMember)
                    {
                        <_102_PayrollGrpAssignment_AddMember ChildAction="CA_Catcher" />
                    }

                    <_102_PayrollGrpAssignment_Dtls ChildAction="CA_Catcher" />

                </CardBody>
            </TelerikCard>

        </CardBody>

    </TelerikCard>
</div>

@code {

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public V102Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public DialogFactory? TelerikDialogs { get; set; }

    private int AssignedCount => V.Deprecs?.Count ?? 0;


    private void ToggleAddMember()
    {
        V.ShowAddMember = !V.ShowAddMember;
    }


    private async Task PayrollGrpChange()
    {
        try
        {
            ResetPayrollGroupData();

            var result = await _deprec._02ByFieldId(  "PayrollgrpId",  V.SelectedPayrollGroup,  V.pisdb, V.conn);

            if (result.Any())
            {
                V.Deprecs = result?.ToList() ?? new List<ODeprecModel>();
            }

            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef?.Show( $"Couldn't load assigned employees. {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private void ResetPayrollGroupData()
    {
        V.ShowAddMember = false;
        V.Deprecs = [];
    }



    private async Task CA_Catcher()
    {
        if (V.Action == "PayrollGrpChange") await PayrollGrpChange();
        await ChildAction.InvokeAsync();
    }
}
