@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PayrollTransaction.Blazor._102._102_PayrollGrp_Assignment

<TelerikNotification @ref="@NotificationRef"
                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top"
                     AnimationType="@AnimationType.SlideLeft" />

<div class="position-relative">
    


    <CascadingValue Value="Uc" IsFixed="true">

        <TelerikCard>

            <CardHeader class="bg-secondary bg-opacity-10">
                <div class="d-flex align-items-center gap-3">
                    <label class="k-label">
                        Payroll Group
                    </label>

                    <div style="width: 400px;">
                        <TelerikDropDownList Data="@V.PayrollGrps"
                                             @bind-Value="V.SelectedPayrollGroup"
                                             TextField="@nameof(PayrollgrpModel.Name)"
                                             ValueField="@nameof(PayrollgrpModel.Id)"
                                             Filterable="true"
                                             FilterPlaceholder="Search payroll group..."
                                             Width="100%"
                                             OnChange="@PayrollGrpChange">

                            <DropDownListSettings>
                                <DropDownListPopupSettings Width="450px"
                                                           Height="600px" />
                            </DropDownListSettings>

                        </TelerikDropDownList>
                    </div>
                </div>
            </CardHeader>

            <CardBody>

                <div class="d-flex gap-2 w-100">

                    <div class="w-600p">

                        <TelerikCard>

                            <CardHeader Class="bg-secondary bg-opacity-10">
                                <div class="d-flex justify-content-between align-items-center w-100">

                                    <span class="small fw-bold">
                                        Assigned Employees
                                    </span>

                                    <TelerikButton OnClick="() => V.ShowAddMember = true"
                                                   Class="@enableAddMemberCSS"
                                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                   FillMode="@ThemeConstants.Button.FillMode.Clear"
                                                   Size="@ThemeConstants.Button.Size.Small"
                                                   Icon="@FontIcon.Plus"
                                                   Title="Add employee">
                                    </TelerikButton>


                                </div>
                            </CardHeader>

                            <CardBody>

                                @if (V.ShowAddMember)
                                {
                                    <_102_PayrollGrpAssignment_AddMember V="V" ChildAction="CA_Catcher" />
                                }

                                <_102_PayrollGrpAssignment_Dtls V="V" ChildAction="CA_Catcher" />

                            </CardBody>

                        </TelerikCard>

                    </div>

                </div>

            </CardBody>

        </TelerikCard>

    </CascadingValue>

</div>


@inject IODeprecDataAccess _deprec;

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    [Parameter] public V102Model V { get; set; } = new();

    [Parameter] public EventCallback ChildAction { get; set; }

    List<EmpmasInternalModel?>? sEmpmas = [];
    private TelerikNotification? NotificationRef;

    string? enableAddMemberCSS =>  V.SelectedPayrollGroup > 0 ? "" : "disabled-div";

    async Task PayrollGrpChange()
    {
        try
        {
            V.ShowAddMember = false;
            V.Deprecs = [];
            var res = await _deprec._02ByFieldId("PayrollgrpId", V.SelectedPayrollGroup, V.pisdb, V.conn);
            if (res.Any()) V.Deprecs = res!;
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef?.Show($"Unable to load assigned employees. {ex}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    async Task CA_Catcher()
    {
        if (V.Action == "PayrollGrpChange") await PayrollGrpChange();
        await ChildAction.InvokeAsync();
    }
}