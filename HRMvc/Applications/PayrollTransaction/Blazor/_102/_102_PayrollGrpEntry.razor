@using FluentValidation
@using System.ComponentModel
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.Models._20_Pay
@using HRApiLibrary.Models._90_Utils
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PayrollTransaction.Blazor._102._102_PayrollGrp
@using HRMvc.Applications._00GeneralComponents.TelerikComponents.Grid

@inject IOPayrollgrpDataAccess _paygrp


<TelerikGrid TItem="PayrollgrpModel"
             @ref="PayrollGrpGrid"
             OnRead="@OnGridRead"
             OnAdd="@OnGridAdd"
             OnCreate="@OnGridCreate"
             OnUpdate="@OnGridUpdate"
             OnDelete="@OnGridDelete"
             OnCancel="@OnGridCancel"
             EditMode="@GridEditMode.Inline"
             ConfirmDelete="true"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             CustomKeyboardShortcuts="@GridCustomShortcuts"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 200px)">


    <GridSettings>

        <GridValidationSettings>

            <ValidatorTemplate>

                <FluentValidator Validator="@GridFluentValidator" />

            </ValidatorTemplate>

        </GridValidationSettings>


        <GridPagerSettings PageSizes="@PageSizes" />

    </GridSettings>


    <GridToolBarTemplate>

        <GridCommandButton Command="Add">
            Add Payroll Group
        </GridCommandButton>


        <GridToolBarSpacerTool />

        <GridToolBarSearchBoxTool />

    </GridToolBarTemplate>


    <GridColumns>


        <GridColumn Field="@nameof(PayrollgrpModel.Code)"
                    Title="Code"
                    Width="100px"
                    Locked="true"
                    Editable="false" />


        <GridColumn Field="@nameof(PayrollgrpModel.Name)"
                    Title="Payroll Group"
                    Width="250px"
                    Locked="true" />


        <GridColumn Field="@nameof(PayrollgrpModel.Deployment)"
                    Title="Deployment"
                    Width="220px">

            <EditorTemplate Context="item">

                @{
                    var pg = (PayrollgrpModel)item;
                }

                <TelerikDropDownList Data="@AvailableDeployments(pg)"
                                     @bind-Value="pg.ClNumber"
                                     @bind-Value:after="() => OnDeploymentChanged(pg)"
                                     ValueField="@nameof(OClientModel.ClNumber)"
                                     TextField="@nameof(OClientModel.ClName)"
                                     Filterable="true"
                                     FilterPlaceholder="Search deployment..."
                                     Width="100%">

                    <DropDownListSettings>

                        <DropDownListPopupSettings Width="450px"
                                                   Height="600px" />

                    </DropDownListSettings>

                </TelerikDropDownList>

            </EditorTemplate>

        </GridColumn>


        <GridColumn Title="RATE"
                    HeaderClass="header-center">

            <Columns>

                <GridColumn Field="@nameof(PayrollgrpModel.MinDailyRate)"
                            Title="Min. Rate"
                            Width="110px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}" />

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerHr)"
                            Title="Hourly"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}" />

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerDay)"
                            Title="Daily"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}" />

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerMonth)"
                            Title="Monthly"
                            Width="110px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}" />

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerYr)"
                            Title="Yearly"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}" />

            </Columns>

        </GridColumn>


        <GridColumn Field="@nameof(PayrollgrpModel.Status)"
                    Title="Status"
                    Width="100px"
                    TextAlign="@ColumnTextAlign.Center">


            <FilterMenuTemplate Context="context">

                <_01FilteCheckbox TItem="PayrollGroupStatusModel"
                                  Context="context"
                                  Items="@V.PayrollGroupStatus"
                                  ValueSelector="@(x => x.Code)"
                                  TextSelector="@(x => x.Name)"
                                  Member="@nameof(PayrollgrpModel.Status)" />

            </FilterMenuTemplate>


            <Template Context="item">

                @{
                    var pg = (PayrollgrpModel)item;

                    var status =
                    V.PayrollGroupStatus
                    .FirstOrDefault(
                    x => x.Code == pg.Status);

                    var statusName =
                    status?.Name ?? pg.Status;

                    var statusColor =
                    pg.Status == "A"
                    ? ThemeConstants.Badge.ThemeColor.Success
                    : ThemeConstants.Badge.ThemeColor.Error;
                }

                <div class="d-flex justify-content-center">

                    <TelerikBadge ThemeColor="@statusColor"
                                  Position="@BadgePosition.Inline"
                                  Rounded="@ThemeConstants.Badge.Rounded.Medium"
                                  Size="@ThemeConstants.Badge.Size.Small"
                                  FillMode="@ThemeConstants.Badge.FillMode.Solid">

                        @statusName

                    </TelerikBadge>

                </div>

            </Template>


            <EditorTemplate Context="item">

                @{
                    var pg = (PayrollgrpModel)item;
                }

                <TelerikDropDownList Data="@V.PayrollGroupStatus"
                                     @bind-Value="pg.Status"
                                     ValueField="@nameof(PayrollGroupStatusModel.Code)"
                                     TextField="@nameof(PayrollGroupStatusModel.Name)"
                                     Width="100%" />

            </EditorTemplate>

        </GridColumn>


        <GridCommandColumn Width="180px"
                           Title="Action"
                           HeaderClass="header-center">

            <div class="d-flex justify-content-center gap-2">

                <GridCommandButton Command="Edit">
                    Edit
                </GridCommandButton>

                <GridCommandButton Command="Save"
                                   ShowInEdit="true">
                    Save
                </GridCommandButton>

                <GridCommandButton Command="Cancel"
                                   ShowInEdit="true">
                    Cancel
                </GridCommandButton>

                <GridCommandButton Command="Delete">
                    Delete
                </GridCommandButton>

            </div>

        </GridCommandColumn>

    </GridColumns>


    <NoDataTemplate>

        <div class="text-center text-secondary p-4">

            No payroll groups found.

        </div>

    </NoDataTemplate>


</TelerikGrid>


@code {


    // ============================================================
    // CASCADING PARAMETERS
    // ============================================================

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }


    [CascadingParameter]
    public V102Model V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }


    [CascadingParameter]
    public DialogFactory? TelerikDialogs { get; set; }


    [Parameter]
    public EventCallback ChildAction { get; set; }


    // ============================================================
    // PAGE SIZE
    //
    // IMPORTANT:
    //
    // DO NOT USE:
    //
    // PageSize="25"
    //
    // We bind PageSize so the selected pager value
    // becomes the actual Telerik Grid PageSize.
    // ============================================================

    private int PageSize { get; set; } = 25;


    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };


    // ============================================================
    // GRID
    // ============================================================

    private TelerikGrid<PayrollgrpModel>? PayrollGrpGrid;


    // ============================================================
    // VALIDATOR
    // ============================================================

    private readonly PayrollgrpValidator GridFluentValidator = new();


    // ============================================================
    // KEYBOARD SHORTCUTS
    // ============================================================

    private readonly Dictionary<GridKeyboardScope, Dictionary<string, GridKeyboardCommand?>>
        GridCustomShortcuts = new()
        {

            [GridKeyboardScope.Common] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["ArrowUp"] =
                        GridKeyboardCommand.NavigateUp,

                    ["ArrowDown"] =
                        GridKeyboardCommand.NavigateDown,

                    ["ArrowLeft"] =
                        GridKeyboardCommand.NavigateLeft,

                    ["ArrowRight"] =
                        GridKeyboardCommand.NavigateRight
                },


            [GridKeyboardScope.HeaderCell] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["O"] =
                        GridKeyboardCommand.SortColumn,

                    ["Enter"] =
                        GridKeyboardCommand.SortColumn
                },


            [GridKeyboardScope.DataCell] =
                new Dictionary<string, GridKeyboardCommand?>
                {
                    ["Enter"] =
                        GridKeyboardCommand.Select
                }

        };


    // ============================================================
    // GRID READ
    // ============================================================

    private async Task OnGridRead(GridReadEventArgs args)
    {

        // ========================================================
        // PAGE SIZE
        //
        // After selecting 50:
        //
        // args.Request.PageSize = 50
        //
        // After selecting 75:
        //
        // args.Request.PageSize = 75
        // ========================================================

        var pageSize =
            args.Request.PageSize;


        // ========================================================
        // FALLBACK
        // ========================================================

        if (pageSize <= 0)
        {
            pageSize = PageSize;
        }


        // ========================================================
        // KEEP LOCAL PAGE SIZE SYNCHRONIZED
        // ========================================================

        PageSize = pageSize;


        // ========================================================
        // CURRENT PAGE
        // ========================================================

        var page =
            args.Request.Page > 0
                ? args.Request.Page
                : 1;


        // ========================================================
        // DEBUG
        // ========================================================

        Console.WriteLine(
            $"PAGE={page}, SIZE={pageSize}"
        );


        // ========================================================
        // OFFSET
        // ========================================================

        var offset =
            (page - 1) * pageSize;


        Console.WriteLine(
            $"OFFSET={offset}"
        );


        // ========================================================
        // SORT
        // ========================================================

        var sort =
            args.Request.Sorts
                .FirstOrDefault();


        var sortField =
            sort?.Member
            ?? nameof(PayrollgrpModel.Name);


        var sortDirection =
            sort?.SortDirection ==
            Telerik.DataSource.ListSortDirection.Descending
                ? "DESC"
                : "ASC";


        // ========================================================
        // FILTER
        // ========================================================

        var filters =
            GridHelper.GetFilters(args);


        // ========================================================
        // DEFAULT ACTIVE FILTER
        // ========================================================

        if (!filters.Any())
        {

            filters.Add(
                new GridFilterModel
                {
                    Field =
                        nameof(PayrollgrpModel.Status),

                    Operator =
                        "=",

                    Value =
                        "A",

                    LogicalOperator =
                        "AND"
                });

        }


        // ========================================================
        // DATABASE REQUEST
        // ========================================================

        var request =
            new GridRequestModel
            {

                PageSize =
                    pageSize,

                Offset =
                    offset,

                SortField =
                    sortField,

                SortDirection =
                    sortDirection,

                Filters =
                    filters

            };


        // ========================================================
        // DEBUG DATABASE REQUEST
        // ========================================================

        Console.WriteLine(
            $"GRID REQUEST => PageSize={request.PageSize}, Offset={request.Offset}"
        );


        // ========================================================
        // GET DATA
        // ========================================================

        var result =
            await _paygrp._02Grid(
                request,
                V.paydb,
                V.pisdb,
                V.conn);


        // ========================================================
        // GIVE DATA TO TELERIK
        // ========================================================

        args.Data =
            result.Data;


        // ========================================================
        // TOTAL RECORD COUNT
        // ========================================================

        args.Total =
            result.Total;

    }


    // ============================================================
    // ADD
    // ============================================================

    private Task OnGridAdd(GridCommandEventArgs args)
    {

        if (args.Item is PayrollgrpModel pg)
        {
            SetDefaults(pg);
        }

        return Task.CompletedTask;

    }


    // ============================================================
    // CREATE
    // ============================================================

    private async Task OnGridCreate(
        GridCommandEventArgs args)
    {

        try
        {

            var pg =
                (PayrollgrpModel)args.Item;


            SetDefaults(pg);


            var exists =
                await _paygrp._02ByName(
                    pg.Name?.Trim(),
                    V.paydb,
                    V.conn);


            if (exists.Any())
            {

                args.IsCancelled =
                    true;


                NotificationRef?.Show(
                    "Payroll group name already exists.",
                    ThemeConstants.Notification.ThemeColor.Error);


                return;

            }


            await _paygrp._01(
                pg,
                V.paydb,
                V.conn);


            NotificationRef?.Show(
                "Payroll group created successfully.",
                ThemeConstants.Notification.ThemeColor.Success);


            V.Action =
                "LoadPayrollGroups";


            await ChildAction.InvokeAsync();


            RefreshGrid();

        }
        catch (Exception ex)
        {

            args.IsCancelled =
                true;


            NotificationRef?.Show(
                $"Unable to create payroll group: {ex.Message}",
                ThemeConstants.Notification.ThemeColor.Error);

        }

    }


    // ============================================================
    // UPDATE
    // ============================================================

    private async Task OnGridUpdate(
        GridCommandEventArgs args)
    {

        try
        {

            var pg =
                (PayrollgrpModel)args.Item;


            SetDefaults(pg);


            var exists =
                await _paygrp._02ByName(
                    pg.Name?.Trim(),
                    V.paydb,
                    V.conn);


            var existing =
                exists.FirstOrDefault();


            if (existing != null &&
                existing.Id != pg.Id)
            {

                args.IsCancelled =
                    true;


                NotificationRef?.Show(
                    "Payroll group name already exists.",
                    ThemeConstants.Notification.ThemeColor.Error);


                return;

            }


            await _paygrp._03(
                pg.Id,
                pg,
                V.paydb,
                V.conn);


            NotificationRef?.Show(
                "Payroll group updated successfully.",
                ThemeConstants.Notification.ThemeColor.Success);


            V.Action =
                "LoadPayrollGroups";


            await ChildAction.InvokeAsync();


            RefreshGrid();

        }
        catch (Exception ex)
        {

            args.IsCancelled =
                true;


            NotificationRef?.Show(
                $"Update failed: {ex.Message}",
                ThemeConstants.Notification.ThemeColor.Error);

        }

    }


    // ============================================================
    // DELETE
    // ============================================================

    private async Task OnGridDelete(
        GridCommandEventArgs args)
    {

        try
        {

            var pg =
                (PayrollgrpModel)args.Item;


            var tbltran =
                await _paygrp._02CheckToTblTran(
                    pg.Code,
                    V.paydb,
                    V.conn);


            var deprec =
                await _paygrp._02CheckToDeprec(
                    pg.Id,
                    V.pisdb,
                    V.conn);


            if (tbltran.Any() ||
                deprec.Any())
            {

                args.IsCancelled =
                    true;


                NotificationRef?.Show(
                    $"'{pg.Name}' cannot be deleted because it is already in use.",
                    ThemeConstants.Notification.ThemeColor.Warning);


                return;

            }


            await _paygrp._04(
                pg.Id,
                V.paydb,
                V.conn);


            NotificationRef?.Show(
                "Payroll group deleted successfully.",
                ThemeConstants.Notification.ThemeColor.Success);


            V.Action =
                "LoadPayrollGroups";


            await ChildAction.InvokeAsync();


            RefreshGrid();

        }
        catch (Exception ex)
        {

            args.IsCancelled =
                true;


            NotificationRef?.Show(
                $"Unable to delete payroll group: {ex.Message}",
                ThemeConstants.Notification.ThemeColor.Error);

        }

    }


    // ============================================================
    // CANCEL
    // ============================================================

    private async Task OnGridCancel(
        GridCommandEventArgs args)
    {

        if (TelerikDialogs == null)
        {
            return;
        }


        var confirmed =
            await TelerikDialogs.ConfirmAsync(
                "Do you want to discard your changes?",
                "Discard Changes");


        if (!confirmed)
        {

            args.IsCancelled =
                true;

        }

    }


    // ============================================================
    // REFRESH
    // ============================================================

    private void RefreshGrid()
    {

        if (PayrollGrpGrid == null)
        {
            return;
        }


        PayrollGrpGrid.Rebind();

    }


    // ============================================================
    // DEFAULTS
    // ============================================================

    private static void SetDefaults(
        PayrollgrpModel pg)
    {

        if (string.IsNullOrWhiteSpace(pg.Status))
        {
            pg.Status = "A";
        }

    }


    // ============================================================
    // AVAILABLE DEPLOYMENTS
    // ============================================================

    private List<OClientModel> AvailableDeployments(
        PayrollgrpModel payrollGrp)
    {

        return V.Deployments
            .Where(
                d =>
                    d.Status == "Active"
                    ||
                    (
                        payrollGrp.Id > 0
                        &&
                        d.ClNumber?.Trim()
                        ==
                        payrollGrp.ClNumber?.Trim()
                    ))
            .ToList();

    }


    // ============================================================
    // DEPLOYMENT CHANGED
    // ============================================================

    private void OnDeploymentChanged(
        PayrollgrpModel payrollGrp)
    {

        var deployment =
            V.Deployments
                .FirstOrDefault(
                    x =>
                        x.ClNumber?.Trim()
                        ==
                        payrollGrp.ClNumber?.Trim());


        payrollGrp.Deployment =
            deployment?.ClName?.Trim()
            ?? string.Empty;

    }


    // ============================================================
    // VALIDATION
    // ============================================================

    public class PayrollgrpValidator
        : AbstractValidator<PayrollgrpModel>
    {

        public PayrollgrpValidator()
        {

            RuleFor(x => x.Name)

                .NotEmpty()

                .WithMessage(
                    "Payroll Group is required.")

                .MaximumLength(80)

                .WithMessage(
                    "Payroll Group cannot exceed 80 characters.");


            RuleFor(x => x.MinDailyRate)

                .GreaterThanOrEqualTo(0)

                .WithMessage(
                    "Minimum rate cannot be negative.");


            RuleFor(x => x.RatePerHr)

                .GreaterThanOrEqualTo(0)

                .WithMessage(
                    "Hourly rate cannot be negative.");


            RuleFor(x => x.RatePerDay)

                .GreaterThanOrEqualTo(0)

                .WithMessage(
                    "Daily rate cannot be negative.");


            RuleFor(x => x.RatePerMonth)

                .GreaterThanOrEqualTo(0)

                .WithMessage(
                    "Monthly rate cannot be negative.");


            RuleFor(x => x.RatePerYr)

                .GreaterThanOrEqualTo(0)

                .WithMessage(
                    "Yearly rate cannot be negative.");


            RuleFor(x => x.Status)

                .NotEmpty()

                .WithMessage(
                    "Status is required.");

        }

    }

}


<style>

    .header-center .k-column-title {
        width: 100%;
        text-align: center;
    }

</style>
