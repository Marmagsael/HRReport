@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.Models._20_Pay
@using HRApiLibrary.Models._90_Utils
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PayrollTransaction.Blazor._102._102_PayrollGrp
@using HRMvc.Applications._00GeneralComponents.TelerikComponents.Grid

@inject IOPayrollgrpDataAccess _paygrp



<TelerikGrid TItem="PayrollgrpModel"
             @ref="PayrollGrpGrid"
             OnRead="@OnGridRead"
             OnAdd="@OnGridAdd"
             OnCreate="@OnGridCreate"
             OnUpdate="@OnGridUpdate"
             OnDelete="@OnGridDelete"
             OnCancel="@OnGridCancel"
             EditMode="@GridEditMode.Inline"
             ConfirmDelete="true"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="100%">

    @* ============================== *@
    @* Grid Settings                  *@
    @* ============================== *@

    <GridSettings>
        <GridValidationSettings>
            <ValidatorTemplate>
            </ValidatorTemplate>
        </GridValidationSettings>

        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>


    @* ============================== *@
    @* Grid Toolbar                   *@
    @* ============================== *@

    <GridToolBarTemplate>
        <GridCommandButton Command="Add">
            Add Payroll Group
        </GridCommandButton>
    </GridToolBarTemplate>



    <GridColumns>

        @* ============================== *@
        @* Code                           *@
        @* ============================== *@

        <GridColumn Field="@nameof(PayrollgrpModel.Code)"
                    Title="Code"
                    Width="100px"
                    Locked="true"
                    Editable="false" />


        @* ============================== *@
        @* Payroll Group                  *@
        @* ============================== *@

        <GridColumn Field="@nameof(PayrollgrpModel.Name)"
                    Title="Payroll Group"
                    Width="250px"
                    Locked="true">

            <EditorTemplate Context="item">
                @{
                    var pg = (PayrollgrpModel)item;
                }

                <TelerikTextBox @bind-Value="pg.Name"
                                Width="100%" />
                @ErrorFor(nameof(PayrollgrpModel.Name))
            </EditorTemplate>

        </GridColumn>


        @* ============================== *@
        @* Deployment                     *@
        @* ============================== *@

        <GridColumn Field="@nameof(PayrollgrpModel.Deployment)"
                    Title="Deployment"
                    Width="220px">

            <EditorTemplate Context="item">
                @{
                    var pg = (PayrollgrpModel)item;
                }

                <TelerikDropDownList Data="@AvailableDeployments(pg)"
                                     @bind-Value="pg.ClNumber"
                                     @bind-Value:after="() => OnDeploymentChanged(pg)"
                                     ValueField="@nameof(OClientModel.ClNumber)"
                                     TextField="@nameof(OClientModel.ClName)"
                                     Filterable="true"
                                     FilterPlaceholder="Search deployment..."
                                     Width="100%">
                    <DropDownListSettings>
                        <DropDownListPopupSettings Width="450px"
                                                   Height="600px" />
                    </DropDownListSettings>
                </TelerikDropDownList>
                @ErrorFor(nameof(PayrollgrpModel.ClNumber))
            </EditorTemplate>

        </GridColumn>


        @* ============================== *@
        @* RATE                           *@
        @* ============================== *@

        <GridColumn Title="RATE"
                    HeaderClass="header-center">
            <Columns>

                @* ============================== *@
                @* Minimum daily rate              *@
                @* ============================== *@

                <GridColumn Field="@nameof(PayrollgrpModel.MinDailyRate)"
                            Title="Min. Daily Rate"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}">

                    <EditorTemplate Context="item">
                        @{
                            var pg = (PayrollgrpModel)item;
                        }

                        <TelerikNumericTextBox @bind-Value="pg.MinDailyRate"
                                               Width="100%"
                                               Decimals="2"
                                               Format="N2"
                                               Arrows="false" />
                        @ErrorFor(nameof(PayrollgrpModel.MinDailyRate))
                    </EditorTemplate>

                </GridColumn>


                @* ============================== *@
                @* Hourly rate                    *@
                @* ============================== *@

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerHr)"
                            Title="Hourly"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}">

                    <EditorTemplate Context="item">
                        @{
                            var pg = (PayrollgrpModel)item;
                        }

                        <TelerikNumericTextBox @bind-Value="pg.RatePerHr"
                                               Width="100%"
                                               Decimals="2"
                                               Format="N2"
                                               Arrows="false" />
                        @ErrorFor(nameof(PayrollgrpModel.RatePerHr))
                    </EditorTemplate>

                </GridColumn>


                @* ============================== *@
                @* Daily rate                     *@
                @* ============================== *@

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerDay)"
                            Title="Daily"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}">

                    <EditorTemplate Context="item">
                        @{
                            var pg = (PayrollgrpModel)item;
                        }

                        <TelerikNumericTextBox @bind-Value="pg.RatePerDay"
                                               Width="100%"
                                               Decimals="2"
                                               Format="N2"
                                               Arrows="false" />
                        @ErrorFor(nameof(PayrollgrpModel.RatePerDay))
                    </EditorTemplate>

                </GridColumn>


                @* ============================== *@
                @* Monthly rate                   *@
                @* ============================== *@

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerMonth)"
                            Title="Monthly"
                            Width="110px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}">

                    <EditorTemplate Context="item">
                        @{
                            var pg = (PayrollgrpModel)item;
                        }

                        <TelerikNumericTextBox @bind-Value="pg.RatePerMonth"
                                               Width="100%"
                                               Decimals="2"
                                               Format="N2"
                                               Arrows="false" />
                        @ErrorFor(nameof(PayrollgrpModel.RatePerMonth))
                    </EditorTemplate>

                </GridColumn>


                @* ============================== *@
                @* Yearly rate                    *@
                @* ============================== *@

                <GridColumn Field="@nameof(PayrollgrpModel.RatePerYr)"
                            Title="Yearly"
                            Width="100px"
                            TextAlign="@ColumnTextAlign.Right"
                            DisplayFormat="{0:N2}">

                    <EditorTemplate Context="item">
                        @{
                            var pg = (PayrollgrpModel)item;
                        }

                        <TelerikNumericTextBox @bind-Value="pg.RatePerYr"
                                               Width="100%"
                                               Decimals="2"
                                               Format="N2"
                                               Arrows="false" />
                        @ErrorFor(nameof(PayrollgrpModel.RatePerYr))
                    </EditorTemplate>

                </GridColumn>

            </Columns>
        </GridColumn>


        @* ============================== *@
        @* Status                         *@
        @* ============================== *@

        <GridColumn Field="@nameof(PayrollgrpModel.Status)"
                    Title="Status"
                    Width="100px"
                    TextAlign="@ColumnTextAlign.Center">

            <FilterMenuTemplate Context="context">
                <_01FilterCheckbox TItem="PayrollGroupStatusModel"
                                   Context="context"
                                   Items="@V.PayrollGroupStatus"
                                   ValueSelector="@(x => x.Code)"
                                   TextSelector="@(x => x.Name)"
                                   Member="@nameof(PayrollgrpModel.Status)" />
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var pg = (PayrollgrpModel)item;
                    var status = V.PayrollGroupStatus.FirstOrDefault(x => x.Code == pg.Status);
                    var statusName = status?.Name ?? pg.Status;
                    var statusColor = pg.Status == "A"
                    ? ThemeConstants.Badge.ThemeColor.Success
                    : ThemeConstants.Badge.ThemeColor.Error;
                }

                <div class="d-flex justify-content-center">
                    <TelerikBadge ThemeColor="@statusColor"
                                  Position="@BadgePosition.Inline"
                                  Rounded="@ThemeConstants.Badge.Rounded.Medium"
                                  Size="@ThemeConstants.Badge.Size.Small"
                                  FillMode="@ThemeConstants.Badge.FillMode.Solid">
                        @statusName
                    </TelerikBadge>
                </div>
            </Template>

            <EditorTemplate Context="item">
                @{
                    var pg = (PayrollgrpModel)item;
                }

                <TelerikDropDownList Data="@V.PayrollGroupStatus"
                                     @bind-Value="pg.Status"
                                     ValueField="@nameof(PayrollGroupStatusModel.Code)"
                                     TextField="@nameof(PayrollGroupStatusModel.Name)"
                                     Width="100%" />
                @ErrorFor(nameof(PayrollgrpModel.Status))
            </EditorTemplate>

        </GridColumn>


        @* ============================== *@
        @* Action                         *@
        @* ============================== *@

        <GridCommandColumn Width="180px"
                           Title="Action"
                           HeaderClass="header-center">

            <div class="d-flex justify-content-center gap-2">

                <GridCommandButton Command="Edit">
                    Edit
                </GridCommandButton>

                <GridCommandButton Command="Save"
                                   ShowInEdit="true">
                    Save
                </GridCommandButton>

                <GridCommandButton Command="Cancel"
                                   ShowInEdit="true">
                    Cancel
                </GridCommandButton>

                <GridCommandButton Command="Delete">
                    Delete
                </GridCommandButton>

            </div>
        </GridCommandColumn>

    </GridColumns>


    @* ============================== *@
    @* No Data                        *@
    @* ============================== *@

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No payroll groups found.
        </div>
    </NoDataTemplate>

</TelerikGrid>



@code {

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public V102Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }


    [CascadingParameter]
    public DialogFactory? TelerikDialogs { get; set; }


    [Parameter]
    public EventCallback ChildAction { get; set; }


    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private TelerikGrid<PayrollgrpModel>? PayrollGrpGrid;


    // ==============================
    // Field-level validation errors
    // ==============================

    private Dictionary<string, string> FieldErrors { get; set; } = new();


    private bool TryValidate(PayrollgrpModel pg)
    {
        FieldErrors = new Dictionary<string, string>();

        if (string.IsNullOrWhiteSpace(pg.Name))
            FieldErrors[nameof(PayrollgrpModel.Name)] = "Payroll group name is required.";

        if (string.IsNullOrWhiteSpace(pg.ClNumber))
            FieldErrors[nameof(PayrollgrpModel.ClNumber)] = "Deployment is required.";

        if (pg.MinDailyRate < 0)
            FieldErrors[nameof(PayrollgrpModel.MinDailyRate)] = "Cannot be negative.";

        if (pg.RatePerHr < 0)
            FieldErrors[nameof(PayrollgrpModel.RatePerHr)] = "Cannot be negative.";

        if (pg.RatePerDay < 0)
            FieldErrors[nameof(PayrollgrpModel.RatePerDay)] = "Cannot be negative.";

        if (pg.RatePerMonth < 0)
            FieldErrors[nameof(PayrollgrpModel.RatePerMonth)] = "Cannot be negative.";

        if (pg.RatePerYr < 0)
            FieldErrors[nameof(PayrollgrpModel.RatePerYr)] = "Cannot be negative.";

        return FieldErrors.Count == 0;
    }


    private string? GetError(string field) =>
        FieldErrors.TryGetValue(field, out var msg) ? msg : null;


    private RenderFragment ErrorFor(string field) => builder =>
    {
        var msg = GetError(field);
        if (!string.IsNullOrEmpty(msg))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "field-error");
            builder.AddContent(2, msg);
            builder.CloseElement();
        }
    };



    private async Task OnGridRead(GridReadEventArgs args)
    {
        var pageSize = args.Request.PageSize;

        if (pageSize <= 0)
            pageSize = PageSize;

        PageSize = pageSize;

        var page = args.Request.Page > 0 ? args.Request.Page : 1;

        var offset = (page - 1) * pageSize;

        var sort = args.Request.Sorts.FirstOrDefault();
        var sortField = sort?.Member ?? nameof(PayrollgrpModel.Name);
        var sortDirection = sort?.SortDirection == Telerik.DataSource.ListSortDirection.Descending
            ? "DESC"
            : "ASC";

        var filters = GridHelper.GetFilters(args);

        if (!filters.Any())
        {
            filters.Add(new GridFilterModel
            {
                Field = nameof(PayrollgrpModel.Status),
                Operator = "=",
                Value = "A",
                LogicalOperator = "AND"
            });
        }

        var request = new GridRequestModel
        {
            PageSize = pageSize,
            Offset = offset,
            SortField = sortField,
            SortDirection = sortDirection,
            Filters = filters
        };

        var result = await _paygrp._02Grid(request, V.paydb, V.pisdb, V.conn);

        args.Data = result.Data;
        args.Total = result.Total;
    }



    private Task OnGridAdd(GridCommandEventArgs args)
    {
        FieldErrors = new Dictionary<string, string>();

        if (args.Item is PayrollgrpModel pg)
            SetDefaults(pg);

        return Task.CompletedTask;
    }



    private async Task OnGridCreate(GridCommandEventArgs args)
    {
        try
        {
            var pg = (PayrollgrpModel)args.Item;

            SetDefaults(pg);

            if (!TryValidate(pg))
            {
                args.IsCancelled = true;
                NotificationRef?.Show("Please fix the highlighted fields.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            var exists = await _paygrp._02ByName(
                pg.Name?.Trim(),
                V.paydb,
                V.conn);

            if (exists.Any())
            {
                args.IsCancelled = true;
                FieldErrors[nameof(PayrollgrpModel.Name)] = "Payroll group name already exists.";
                NotificationRef?.Show("Payroll group name already exists.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            await _paygrp._01(pg, V.paydb, V.conn);

            FieldErrors = new Dictionary<string, string>();

            NotificationRef?.Show("Payroll group created successfully.", ThemeConstants.Notification.ThemeColor.Success);

            V.Action = "LoadPayrollGroups";
            await ChildAction.InvokeAsync();

            RefreshGrid();
        }
        catch (Exception ex)
        {
            args.IsCancelled = true;

            NotificationRef?.Show($"Unable to create payroll group: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task OnGridUpdate(GridCommandEventArgs args)
    {
        try
        {
            var pg = (PayrollgrpModel)args.Item;

            SetDefaults(pg);

            if (!TryValidate(pg))
            {
                args.IsCancelled = true;
                NotificationRef?.Show("Please fix the highlighted fields.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            var exists = await _paygrp._02ByName(pg.Name?.Trim(), V.paydb, V.conn);
            var existing = exists.FirstOrDefault();

            if (existing != null && existing.Id != pg.Id)
            {
                args.IsCancelled = true;

                FieldErrors[nameof(PayrollgrpModel.Name)] = "Payroll group name already exists.";
                NotificationRef?.Show("Payroll group name already exists.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            await _paygrp._03(pg.Id, pg, V.paydb, V.conn);

            FieldErrors = new Dictionary<string, string>();

            NotificationRef?.Show("Payroll group updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            V.Action = "LoadPayrollGroups";

            await ChildAction.InvokeAsync();

            RefreshGrid();
        }
        catch (Exception ex)
        {
            args.IsCancelled = true;
            NotificationRef?.Show($"Update failed: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }




    private async Task OnGridDelete(GridCommandEventArgs args)
    {
        try
        {
            var pg = args.Item as PayrollgrpModel;

            if (pg == null)
            {
                args.IsCancelled = true;

                NotificationRef?.Show("Invalid payroll group.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            var hasTblTran = await _paygrp._02CheckToTblTran(pg.Code, V.paydb, V.conn);
            var hasDeprec = await _paygrp._02CheckToDeprec(pg.Id, V.pisdb, V.conn);

            if (hasTblTran || hasDeprec)
            {
                args.IsCancelled = true;
                NotificationRef?.Show($"'{pg.Name}' cannot be deleted because it is already in use.", ThemeConstants.Notification.ThemeColor.Warning);
                return;
            }

            await _paygrp._04(pg.Id, V.paydb, V.conn);
            NotificationRef?.Show($"Payroll group '{pg.Name}' was deleted successfully.", ThemeConstants.Notification.ThemeColor.Success);

            V.Action = "LoadPayrollGroups";

            RefreshGrid();

            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            args.IsCancelled = true;

            NotificationRef?.Show($"Unable to delete payroll group: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task OnGridCancel(GridCommandEventArgs args)
    {
        if (TelerikDialogs == null)
            return;

        var confirmed = await TelerikDialogs.ConfirmAsync(
            "Do you want to discard your changes?",
            "Discard Changes");

        if (!confirmed)
        {
            args.IsCancelled = true;
        }
        else
        {
            FieldErrors = new Dictionary<string, string>();
        }
    }



    private void RefreshGrid()
    {
        if (PayrollGrpGrid != null)
        {
            PayrollGrpGrid.Rebind();
        }
    }



    private static void SetDefaults(PayrollgrpModel pg)
    {
        if (string.IsNullOrWhiteSpace(pg.Status))
            pg.Status = "A";
    }



    private List<OClientModel?> AvailableDeployments(
        PayrollgrpModel payrollGrp)
    {
        return V.Deployments
            .Where(d =>
                d.Status == "Active" ||
                (payrollGrp.Id > 0 &&
                 d.ClNumber?.Trim() == payrollGrp.ClNumber?.Trim()))
            .ToList();
    }



    private void OnDeploymentChanged(PayrollgrpModel payrollGrp)
    {
        var deployment = V.Deployments.FirstOrDefault(x => x.ClNumber?.Trim() == payrollGrp.ClNumber?.Trim());

        payrollGrp.Deployment = deployment?.ClName?.Trim() ?? string.Empty;
    }







    public async Task ResetGrid()
    {
        if (PayrollGrpGrid == null) return;

        V.SelectedPayrollGroup = 0;
        FieldErrors = new Dictionary<string, string>();
        var state = PayrollGrpGrid.GetState();
        state.FilterDescriptors.Clear();
        state.SortDescriptors.Clear();
        state.Page = 1;
        state.SelectedItems = new List<PayrollgrpModel>();
        await PayrollGrpGrid.SetStateAsync(state);
    }



}




<style>
    .header-center .k-column-title {
        width: 100%;
        text-align: center;
    }

    .field-error {
        color: var(--kendo-color-error, #dc3545);
        font-size: 0.75rem;
        margin-top: 2px;
        line-height: 1.2;
    }
</style>
