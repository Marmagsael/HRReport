@inject IAtttemplateDataAccess          _atttemplate;
@inject IOEmpmasDataAccess              _empmas; 
@inject IAtttemplatereqhdrDataAccess    _attTemplateReqhdr; 
@inject IAtttemplatereqdtlDataAccess    _attTemplateReqdtl; 
@inject IOEmpmasDataAccess              _iempmas;
@inject IAtttemplatereqhistDataAccess   _iattTemplateReqHis;

@code {

    [Parameter] public UserClaimsModel? Uc { get; set; } = new();
    [Parameter] public V102Model V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }


    V12_102CS Cs = new();

    string saveRemarks = string.Empty;
    AtttemplatereqhdrModel attTempReqHdr = new();



    async Task PayrollgrpChange()
    {

        int pgrpId = V.SelectedPayrollGroup;
        try
        {
            if (pgrpId <= 0)
            {
                _notify.ShowWarning("Invalid Input", "Please select a valid payroll group");
                return;
            }

            V.EmpmasList = [];
            V.SelectedEmployees = [];
            V.SelectedPayrollGroup = pgrpId;

            var result = await _empmas._02ByPayrollGrpId(pgrpId, V.pisdb, V.conn);

            if (result?.Any() == true)
            {
                V.EmpmasList = result!;
            }
            else
            {
                _notify.ShowInfo("No Data", "No employees found for this payroll group");
            }
        }
        catch (Exception ex)
        {
            _notify.ShowError("Error", "An error occurred. Please contact your system administrator.");
        }
    }




    private async Task ApplySchedule()
    {
        try
        {
            if (!ValidateApplySchedule()) return;

            var schedule = MapAttendanceRec(Cs.Atttemplatereqdtl);

            int successCount = 0;
            int skippedCount = 0;
            List<string> failedEmployees = new();

            foreach (var employee in V.SelectedEmployees)
            {
                // if (employee.SystemId == 0)
                // {
                //     skippedCount++;
                //     _notify.ShowInfo("Employee Skipped", $"{employee.Fullname} could not be updated because no System ID is assigned.");
                //     continue;
                // }

                // schedule.EmpmasId = employee.SystemId;

                bool dbUpdated = await InsertUpdateSchedule(schedule);

                if (dbUpdated)
                {
                    // var attreqhistory = AssignValuesToRequestHistory(employee.SystemId, Uc.OempNumber);
                    // await _iattTemplateReqHis._01(attreqhistory, V.pisdb, V.conn);
                    // successCount++;
                }
                else
                {
                    skippedCount++;
                    failedEmployees.Add(employee.Fullname);
                }
            }

            ShowApplyScheduleSummary(successCount, skippedCount, failedEmployees);
            V.SelectedEmployee = string.Empty;

            foreach (var e in V.EmpmasList)
            {
                e.Sel = false;
            }
            V.IsAllSelected = false;
            await OnInitializedAsync();

            StateHasChanged();
            await ChildActionCatcher();
        }
        catch (Exception ex)
        {
            _notify.ShowError("Error", "An error occurred. Please contact your system administrator.");
        }
    }


    private bool ValidateApplySchedule()
    {
        if (Cs.Atttemplatereqdtl == null)
        {
            _notify.ShowError("No Schedule", "No schedule is available to apply.");
            return false;
        }

        if (V.SelectedEmployees == null || !V.SelectedEmployees.Any())
        {
            _notify.ShowWarning("No Employees Selected", "Please select at least one employee.");
            return false;
        }

        return true;
    }


    private void ShowApplyScheduleSummary(int successCount, int skippedCount, List<string> failedEmployees)
    {
        if (successCount > 0)
        {
            string summary = $"Successfully updated schedules for {successCount} employee(s).";

            if (skippedCount > 0)
                summary += $" {skippedCount} employee(s) could not be updated.";

            _notify.ShowSuccess("Schedule Update Completed", summary);
        }
        else
        {
            _notify.ShowWarning("No Updates Applied", "No employee schedules were updated.");
        }

        if (!failedEmployees.Any()) return;

        string errorMsg = string.Join(", ", failedEmployees.Take(3));

        if (failedEmployees.Count > 3)
        {
            errorMsg += $", and {failedEmployees.Count - 3} more.";
        }

        _notify.ShowError("Update Incomplete", $"The following employee(s) could not be updated: {errorMsg}");
    }



