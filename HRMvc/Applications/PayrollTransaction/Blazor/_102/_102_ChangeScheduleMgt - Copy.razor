            Cs.Atttemplatereqdtl = resd.FirstOrDefault()??new(); 


        }

        if(Hdr.Id > 0) {

            var r =res.FirstOrDefault(); 
            if (r?.Id is not null && r?.Id != Hdr.Id)
            {
                await _DialogService.Alert(
                    "Unable to update. A saved request with the same effectivity date already exists.",
                    "Existing Request",
                    new AlertOptions() { OkButtonText = "OK" });

                var res1 = await _attTemplateReqhdr._02s(Hdr.Id, Uc.SchemaUserPis, Uc.Conn); 

