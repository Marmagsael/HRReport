@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.DataAccess._90_Utils
@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications.PayrollTransaction.Vars
@using HRMvc.Applications.PisModules.Vars
@using HRMvc.Applications.Vars
@using Radzen
@using Radzen.Blazor
@using HRMvc.Applications.PayrollTransaction.Blazor._102._102_CSM
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_102._12_102_Child.TS
@using HRMvc.Applications.PisModules.Views.Blazor.F2052
@using HRMvc.Applications._03Payroll.Views.BlazorPages._00_Utility


@inject NotificationService _notify
@inject DialogService _DialogService


<TelerikMediaQuery Media="(max-width: 768px)"
                   OnChange="@((bool matches) => { IsMobile = matches; StateHasChanged(); })" />

<TelerikMediaQuery Media="(max-width: 1200px)"
                   OnChange="@((bool matches) => { IsNarrow = matches; StateHasChanged(); })" />

<TelerikCard Class="@(IsMobile ? "csm-mobile" : "")">

    <CardHeader class="bg-secondary bg-opacity-10">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3">

            <!-- Payroll Group -->
            <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2 gap-md-3">

                <label class="k-label text-nowrap">
                    Payroll group
                </label>

                <div class="paygrp-picker">

                    <TelerikDropDownList Data="@V.PayrollGrps"
                                         @bind-Value="V.SelectedPayrollGroup"
                                         TextField="@nameof(PayrollgrpModel.Name)"
                                         ValueField="@nameof(PayrollgrpModel.Id)"
                                         Filterable="true"
                                         FilterPlaceholder="Search payroll group..."
                                         Width="100%"
                                         OnChange="@PayrollgrpChange">

                        <DropDownListSettings>
                            <DropDownListPopupSettings Width="450px"
                                                       Height="600px" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
            </div>


            <!-- Apply Schedule Button : DESKTOP ONLY -->
            @if (!IsMobile)
            {
                <div>
                    <TelerikButton OnClick="@ApplySchedule"
                                   Class="w-100"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Size="@ThemeConstants.Button.Size.Small">
                        Apply schedule to selected employee(s)
                    </TelerikButton>
                </div>
            }

        </div>
    </CardHeader>

    <CardBody Class="@(IsMobile ? "p-1" : "")">

        <div class="@(IsMobile ? "p-0" : "card-body p-0")">

            <div class="d-flex flex-column flex-md-row gap-1">

                @*========= EMPLOYEE LIST ===========*@
                @if (IsMobile)
                {
                    <TelerikExpansionPanel Title="@EmployeeListTitle" @bind-Expanded="@EmployeeListExpanded">
                        <Content>
                            <_102_CSM_EmployeeList ChildAction="@ChildActionCatcher" />
                        </Content>
                    </TelerikExpansionPanel>
                }
                else
                {
                    <div class="w-30">
                        <_102_CSM_EmployeeList ChildAction="@ChildActionCatcher" />
                    </div>
                }

                <div class="flex-grow-1 grid-col">

                    <TelerikGrid Data="@Days"
                                 TItem="DayRow"
                                 Sortable="false"
                                 Pageable="false"
                                 Width="100%">

                        <GridColumns>

                            <GridColumn Field="@nameof(DayRow.Label)" Title="Day" Width="@(IsNarrow ? "130px" : "120px")">
                                <Template>
                                    @{
                                        var d = (DayRow)context;
                                    }
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold @dutyTypeCss(d.CurDuty)">@d.Label</span>
                                        @if (IsNarrow)
                                        {
                                            <span class="text-secondary" style="font-size: 11px;">@CurrentSummary(d)</span>
                                        }
                                    </div>
                                </Template>
                            </GridColumn>

                            @*========= CURRENT ===========*@
                            <GridColumn Title="@CurrentScheduleTitle" HeaderClass="header-center" Visible="@(!IsNarrow)">
                                <Columns>
                                    <GridColumn Title="Duty Type" Width="110px" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            <span class="@dutyTypeCss(d.CurDuty)">@d.CurDuty</span>
                                        </Template>
                                    </GridColumn>

                                    <GridColumn Title="IN" Width="110px" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            <span class="@dutyTypeCss(d.CurDuty)">@(d.CurDuty == "R" ? d.CurIn?.ToString() : "-")</span>
                                        </Template>
                                    </GridColumn>

                                    <GridColumn Title="Duration" Width="110px" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            <span class="@dutyTypeCss(d.CurDuty)">@(d.CurDuty == "R" ? ((d.CurHrs ?? 0) / 100.00).ToString("0.#") + " H" : "-")</span>
                                        </Template>
                                    </GridColumn>
                                </Columns>
                            </GridColumn>

                            @*========= NEW ===========*@
                            <GridColumn Title="New Schedule" HeaderClass="header-center">
                                <Columns>
                                    <GridColumn Title="Duty Type" Width="@(IsNarrow ? "95px" : "120px")" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            <RadzenDropDown Data="@dutyTypes"
                                                            @bind-Value="@d.ReqDuty"
                                                            Change="@(() => { d.ReqIn = 0; d.ReqHrs = 0; })"
                                                            Style="width:80px;"
                                                            Placeholder="Select Duty Type" />
                                        </Template>
                                    </GridColumn>

                                    <GridColumn Title="IN" Width="@(IsNarrow ? "125px" : "150px")" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            @if (d.ReqDuty == "R")
                                            {
                                                <RadzenDropDown Data="@timeOptions"
                                                                TextProperty="Text"
                                                                ValueProperty="Value"
                                                                @bind-Value="@d.ReqIn"
                                                                Placeholder="Select Time"
                                                                Style="@(IsNarrow ? "width:110px" : "width:125px")" />
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </Template>
                                    </GridColumn>

                                    <GridColumn Title="Duration" Width="@(IsNarrow ? "125px" : "150px")" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            @if (d.ReqDuty == "R")
                                            {
                                                <RadzenDropDown Data="@timedurations"
                                                                TextProperty="Text"
                                                                ValueProperty="Value"
                                                                @bind-Value="@d.ReqHrs"
                                                                Placeholder="Select Duration"
                                                                Style="@(IsNarrow ? "width:110px;" : "width:125px;")"
                                                                Class="center-dropdown" />
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </Template>
                                    </GridColumn>

                                    <GridColumn Title="OUT" Width="@(IsNarrow ? "90px" : "110px")" TextAlign="@ColumnTextAlign.Center">
                                        <Template>
                                            @{
                                                var d = (DayRow)context;
                                            }
                                            @(d.ReqDuty == "R" ? outRes(d.ReqDuty, d.ReqIn, d.ReqHrs) : "-")
                                        </Template>
                                    </GridColumn>
                                </Columns>
                            </GridColumn>

                        </GridColumns>

                    </TelerikGrid>


                      @*========= APPLY BUTTON : MOBILE ONLY ===========*@
                        @if (IsMobile)
                        {
                            <div class="apply-bar">
                                <TelerikButton OnClick="@ApplySchedule"
                                               Class="w-100"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                               Size="@ThemeConstants.Button.Size.Small">
                                    Apply schedule
                                </TelerikButton>
                            </div>
                        }

                    <_102_CSM_Notes />
                </div>
            </div>

          

        </div>
    </CardBody>
</TelerikCard>


@inject IAtttemplateDataAccess _atttemplate;
@inject IOEmpmasDataAccess _empmas;
@inject IAtttemplatereqhdrDataAccess _attTemplateReqhdr;
@inject IAtttemplatereqdtlDataAccess _attTemplateReqdtl;
@inject IOEmpmasDataAccess _iempmas;
