    async Task PayrollgrpChange()
    {

        int pgrpId = V.SelectedPayrollGroup;
        try
        {
            if (pgrpId <= 0)
            {
                _notify.ShowWarning("Invalid Input", "Please select a valid payroll group");
                return;
            }

            V.EmpmasList = [];
            V.SelectedEmployees = [];
            V.SelectedPayrollGroup = pgrpId;

            var result = await _empmas._02ByPayrollGrpId(pgrpId, V.pisdb, V.conn);

            if (result?.Any() == true)
            {
                V.EmpmasList = result!;
            }
            else
            {
                _notify.ShowInfo("No Data", "No employees found for this payroll group");
            }
        }
        catch (Exception ex)
        {
            _notify.ShowError("Error", "An error occurred. Please contact your system administrator.");
        }
    }




