@using System.Security.Claims
@using HRApiLibrary.DataAccess._00_Main.Interface
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration


@inject I_00MainDA      _mainDA
@inject IConfiguration  _config;

@{
    Layout = "~/Views/Shared/Main/_ReportLayout2.cshtml";
    
    var userid            = User.Claims.Where(c => c.Type == "UserId").FirstOrDefault();
    IEnumerable<Claim?> claims  = User.Claims;
    var userClaims              = _mainDA._02UserClaimsContent(claims);
    
    var oldPis = Context.Session.GetString("OldPis");
    var oldPay = Context.Session.GetString("OldPay");
    var empnumber = Context.Session.GetString("EmpNumber");
}


<div>
    
    <div>User Id    : @userid</div>
    <div>Email      : @userClaims.Email</div>
    <div>Connection : @userClaims.Conn</div>
    <hr />
    <div>DefCompanyId  : @userClaims.DefCompanyId</div>
    <div>SchemaUserPay : @userClaims.SchemaUserPay</div>
    <div>SchemaUserPis : @userClaims.SchemaUserPis</div>
    <div>ConnNoDb      : @userClaims.ConnNoDb</div>
    <hr />
    <div>Empnumber      : @empnumber</div>
    <div>Old PIS Schema : @oldPis</div>
    <div>Old Pay Schema : @oldPay</div>
    



</div>