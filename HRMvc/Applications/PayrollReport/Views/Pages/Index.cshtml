    <div>Connection : @userClaims.Conn</div>
    <hr />
    <div>DefCompanyId  : @userClaims.DefCompanyId</div>
    <div>SchemaUserPay : @userClaims.SchemaUserPay</div>
    <div>SchemaUserPis : @userClaims.SchemaUserPis</div>
    <div>ConnNoDb      : @userClaims.ConnNoDb</div>
    <hr />
    <div>Empnumber      : @empnumber</div>
    <div>Old PIS Schema : @oldPis</div>
    <div>Old Pay Schema : @oldPay</div> *@
    



</div>