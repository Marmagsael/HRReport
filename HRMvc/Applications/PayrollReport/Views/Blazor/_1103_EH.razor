@using HRApiLibrary.DataAccess._20_Pay_Report
@using HRApiLibrary.Models._00_Main

@using HRApiLibrary.Models._20_PayGeneric
@using HRMvc.Applications.PayrollReport.Views.Blazor.Components; 
<_DtlHdrPay caption="EARNINGS SUMMARY" />

@using HRMvc.Applications.PayrollReport.Views.Blazor._1102;
@using System.Threading.Tasks

@* <div>Accounts Count : @v1102.ChartOfAccts.Count </div>
<div>Conn   : @conn </div>
<div>Paydb  : @paydb </div> *@

<div class="p-3 bordered br-6 mt-2"> 
    <_1102_button   UserClaims="@UserClaims"></_1102_button>
    <_1102_Coverage UserClaims="@UserClaims"></_1102_Coverage>
    <_1102_Grid V1102="@v1102"></_1102_Grid>
</div>



<IframeReportRenderer
    DataSource          ="report"
    ReportRelativePath  ="@relativePath"
    OutputFormat        ="@selectedFormat"
    Parameters          ="reportParams"
    AutoGenerate="@(report?.Any() == true)"
    RefreshToken        ="@refreshToken" />

@inject IPayrollgrpDataAccess _pg; 


@code {

    [Parameter] public UserClaimsModel?             UserClaims   { get; set; }
    [Parameter] public List<GChartofacctModel?>?    ChartOfAccts { get; set; } = [];

    bool showModal = false; 

    public  V1102?      v1102 { get; set; } = new V1102();
    private string      conn                = string.Empty;
    private string      paydb               = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (v1102.ChartOfAccts.Count > 0 ) return;
        await LoadData();

    }


    async Task LoadData()
    {
        conn                = UserClaims?.Conn            ?? string.Empty;
        paydb               = "Pay";
        v1102.ChartOfAccts  = ChartOfAccts;
    }

    void ShowHideModal(bool ans) { showModal = ans;  }

    
}
