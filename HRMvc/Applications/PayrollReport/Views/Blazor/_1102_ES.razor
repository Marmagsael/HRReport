@using HRApiLibrary.Models._00_Main

<div>
    <button class="btn btn-primary" @onclick="CreateReport">
        Create Report
    </button>
    
    <button class="btn btn-danger" @onclick="@(() => Console.WriteLine("FIRED"))">
        TEST CLICK
    </button>
    
</div>

<div>
    Message : @msg
</div>

<div>
    paydb = @paydb
</div>

@if (isLoading)
{
    <p class="mt-3 text-info">Generating report, please wait...</p>
}
else if (pdfBytes != null)
{
    var mime = selectedFormat == "XLSX" ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" : "application/pdf";

    <div style="height:85vh; margin-top:10px;">
        <iframe src="data:@mime;base64,@Convert.ToBase64String(pdfBytes)"
                style="width:100%;height:100%;border:none;">
        </iframe>
    </div>
}

@code {

    [Parameter]
    public UserClaimsModel? UserClaims { get; set; }

    private byte[]? pdfBytes;
    private bool isLoading = false;
    private string selectedFormat = "PDF";

    private string? pisdb;
    private string? paydb;
    private string? conn;
    private string? msg;

    // ✅ Correct lifecycle method
    protected override Task OnParametersSetAsync()
    {
        try
        {
            paydb = UserClaims?.SchemaUserPay;
            pisdb = UserClaims?.SchemaUserPis;
            conn  = UserClaims?.Conn;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PayrollReport] Initialization failed: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    // ✅ Proper event handler
    private async Task CreateReport()
    {
        msg = "Button Clicked...";
        Console.WriteLine("Hello!.....");

        // simulate async work
        await Task.Delay(10);
    }
}