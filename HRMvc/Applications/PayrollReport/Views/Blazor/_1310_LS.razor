@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PayrollReport.Class
@using Telerik.Blazor
@using Telerik.Blazor.Components

@* --- Loan Summary (MBPay loans_management): one loan, the latest loan of each chosen employee. Screen grid + Excel
       (MBPay only had the Excel export). Employees are all selected at first; MBPay started with none --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="Loan Summary" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (pdfBase64 != null)
                {
                    <div style="height:90vh; margin-top:10px;">
                        <iframe src="data:application/pdf;base64,@pdfBase64" style="width:100%;height:100%;border:none;"></iframe>
                    </div>
                }
            </Details>
        </_02BTModal>


        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @*--- Loan ------------------------------------------------*@
                    <RadzenDropDown @bind-Value="loanCode" Data="@loans" TextProperty="Name" ValueProperty="Code"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="Select loan" Style="width: 320px;" />
                    <RadzenCheckBox TValue="bool" Value="includeResigned" Change="@(async (bool v) => { includeResigned = v; await LoadEmployees(); })" />
                    <span>View Resigned Employees</span>
                    @*--- Fetch / Excel ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="DownloadExcel"> Export to Excel</div>
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="DownloadPdf"> Export to PDF</div>
                </div>
            </div>
        </div>

<style>
    .tg-root .k-grid { font-size:12.5px; }
    .tg-root .k-grid td, .tg-root .k-grid th { padding:4px 8px; font-size:12.5px !important; }
    .tg-root .k-grid th, .tg-root .k-grid .k-header, .tg-root .k-grid .k-column-title { font-size:12.5px !important; font-weight:600; background:#f4f6f9; }
    .tg-chk td:first-child, .tg-chk th:first-child { text-align:center; }
</style>
        <TelerikRootComponent>
        <div class="p-2 tg-root">
            <div class="d-flex gap-3">
                <div style="width:420px;flex-shrink:0" class="tg-chk">
                    <div class="fw-bold mb-1">Employees (@emps.Count(e => e.IsSelectedB) of @emps.Count)</div>
                    <TelerikGrid Data="@emps" Height="calc(100vh - 290px)" Size="@ThemeConstants.Grid.Size.Small" Sortable="false">
                        <GridColumns>
                            <GridColumn Width="44px" Title="">
                                <HeaderTemplate>
                                    <TelerikCheckBox Value="@(emps.Count > 0 && emps.All(x => x.IsSelectedB))" ValueChanged="@((bool v) => { foreach (var x in emps) x.IsSelectedB = v; })" />
                                </HeaderTemplate>
                                <Template>
                                    @{ var e = (OClientModel)context; }
                                    <TelerikCheckBox @bind-Value="e.IsSelectedB" />
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(OClientModel.ClName)" Title="Employee" />
                        </GridColumns>
                    </TelerikGrid>
                </div>
                <div style="flex:1 1 auto;min-width:0">
                    <TelerikGrid Data="@reps" Height="calc(100vh - 290px)" Size="@ThemeConstants.Grid.Size.Small" Sortable="false">
                        <GridColumns>
                            <GridColumn Field="@nameof(RLoanSummaryModel.Empname)" Title="Emp. Name" Width="220px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Date)" Title="Loan Date" DisplayFormat="{0:MM/dd/yyyy}" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Amount)" Title="Loan Amt" DisplayFormat="{0:N2}" TextAlign="ColumnTextAlign.Right" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.PayrollDeduction)" Title="Pay Pymt" DisplayFormat="{0:N2}" TextAlign="ColumnTextAlign.Right" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Balance)" Title="Pay Bal." DisplayFormat="{0:N2}" TextAlign="ColumnTextAlign.Right" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Pymt)" Title="Actual Pymt" DisplayFormat="{0:N2}" TextAlign="ColumnTextAlign.Right" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Unpaid)" Title="Balance" DisplayFormat="{0:N2}" TextAlign="ColumnTextAlign.Right" Width="110px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Status)" Title="Stat." Width="70px" />
                            <GridColumn Field="@nameof(RLoanSummaryModel.Clname)" Title="Client" Width="200px" />
                        </GridColumns>
                        <NoDataTemplate><div class="p-3 text-muted">Select loan, then Fetch Data.</div></NoDataTemplate>
                    </TelerikGrid>
                </div>
            </div>
        </div>
        </TelerikRootComponent>
    </Details>
</_00BT_FullW>



@inject IGPayrollReportDataAccess   _payRep;
@inject IJSRuntime                  _js;

@code{
    [Parameter] public UserClaimsModel  Uc          { get; set; } = new();
    V00_RepVars                         rv          = new();
    List<RLoanSummaryModel>             reps        = [];
    List<RLoanSummaryModel>             loans       = [];
    string?                             loanCode;
    bool                                includeResigned;

    //--- Employee list reuses the client list component: ClNumber holds the employee number ---
    List<OClientModel>                  emps        = [];
    Dictionary<string, object>          listClass   = new() { ["VH"] = "vh60" };

    string? pdfBase64;
    void CloseReportModal(bool ans) { rv.ShowModal = ans; if (!ans) pdfBase64 = null; }

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv.MCaption = "Loan Summary";
        loans = await _payRep._02LoanTypes(Uc.OpayDb!, Uc.Conn!);
        await LoadEmployees();
    }

    void ChildActionCatcher(){}

    private async Task LoadEmployees()
        => emps = (await _payRep._02LoanEmployees(includeResigned, Uc.OpisDb!, Uc.Conn!))
                    .Select(e => new OClientModel { ClNumber = e.Empnumber, ClName = $"{e.Empname}   ({e.Clname})", IsSelectedB = true }).ToList();

    private async Task FetchData()
    {
        reps = [];
        if (!HasConnection()) return;
        if (string.IsNullOrWhiteSpace(loanCode)) { Notify(NotificationSeverity.Warning, "Warning", "Please select loan from the list."); return; }

        try
        {
            rv.Isloaded = true;
            reps = await _payRep._02LoanSummary(loanCode, emps.Where(e => e.IsSelectedB).Select(e => e.ClNumber!).ToList(), Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!reps.Any()) Notify(NotificationSeverity.Info, "Info", "No records found in database!");
    }

    private async Task DownloadExcel()
    {
        if (!reps.Any()) { Notify(NotificationSeverity.Warning, "Warning", "Nothing to export."); return; }
        try
        {
            string loanName = loans.FirstOrDefault(l => l.Code == loanCode)?.Name ?? "";
            var bytes = LoanSummarySheet.Build(reps, loanName);
            await _js.InvokeVoidAsync("downloadFile", $"LoanSummary_{loanCode}.xlsx", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Excel download failed", ex.Message);
            Console.WriteLine(ex);
        }
    }

    private async Task DownloadPdf()
    {
        if (!reps.Any()) { Notify(NotificationSeverity.Warning, "Warning", "Nothing to export."); return; }
        try
        {
            string loanName = loans.FirstOrDefault(l => l.Code == loanCode)?.Name ?? "";
            var cols = new List<PdfCol>
            {
                new() { Title = "Emp. Name", Width = 2.4 }, new() { Title = "Loan Date", Width = 0.9 },
                new() { Title = "Loan Amount", Width = 1.1, Right = true }, new() { Title = "Payroll Deduction", Width = 1.2, Right = true },
                new() { Title = "Payroll Balance", Width = 1.2, Right = true }, new() { Title = "Payment Made", Width = 1.2, Right = true },
                new() { Title = "Unpaid Balance", Width = 1.2, Right = true }, new() { Title = "Status", Width = 0.7 },
                new() { Title = "Client", Width = 2.0 }, new() { Title = "Amort", Width = 0.9, Right = true }
            };
            var rows = reps.Select(r => (new[] { r.Empname ?? "", r.Date?.ToString("MM/dd/yyyy") ?? "", r.Amount.ToString("N2"), r.PayrollDeduction.ToString("N2"),
                r.Balance.ToString("N2"), r.Pymt.ToString("N2"), r.Unpaid.ToString("N2"), r.Status ?? "", r.Clname ?? "", r.Amort.ToString("N2") }, 0)).ToList();
            var bytes = TablePdf.Build("Loan Report Summary", new List<string> { "Loan Name : " + loanName }, cols, rows);
            pdfBase64 = Convert.ToBase64String(bytes);
            rv.ShowModal = true;
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "PDF download failed", ex.Message);
            Console.WriteLine(ex);
        }
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
