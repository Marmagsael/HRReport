@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using System.Globalization



<_02BTModal MCaption="@Rv.MCaption" ShowModal="Rv.ShowModal" ChildAction="CloseReportModal">
    <Details>

        @if (Rv.ShowReport)
        {
            <IframeReportRenderer DataSource="@Rv.ReportData"
                                  ReportRelativePath="@Rv.RelativePath"
                                  OutputFormat="@Rv.SelectedFormat"
                                  Parameters="@Rv.ReportParams"
                                  AutoGenerate="@(Rv.ReportData?.Any() == true)"
                                  RefreshToken="@Rv.RefreshToken" />
        }
        else
        {


            <div class="pt-0 p-2">
                <div class="sticky-top bg-white ">
                    <div class="pt-2 p-2 border-bottom">
                        <div class="p-0">
                            <div class="card-header">
                                <div class="d-flex gap-2">
                                    <_01ReportFormat Rv="@Rv" ChildAction="ValueChanged" />
                                    @*--- Fetch Button ------------------------------------------------*@
                                    <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 py-2 border-bottom fw-bold  bg-lightgray ">
                        <div class=" w-75p text-center">No.</div>
                        <div class=" w-100p">Last Name</div>
                        <div class=" w-150p">First Name</div>
                        <div class=" w-150p">Middle Name</div>
                        <div class=" w-300p">Current Deployment</div>
                        <div class=" w-100p">Date Hired</div>
                        <div class=" w-100p text-end">EE</div>
                        <div class=" w-100p text-end">ER</div>
                        <div class=" w-100p text-end">EC</div>
                    </div>
                </div>

                @{
                    int ctr = 0; int row = 0; string stat = string.Empty;
                }
                @foreach (var rec in V)
                {
                    ctr++;
                    row++;

                    <div class="d-flex gap-2 border-bottom py-1 @(row % 2 == 0 ? "bg-light" : "") " ">
                        <div class=" w-75p text-center ">@ctr.</div>
                        <div class=" w-100p">@rec.EmpLastNm</div>
                        <div class=" w-150p">@rec.EmpFirstNm</div>
                        <div class=" w-150p">@rec.EmpMidNm</div>
                        <div class=" w-300p">@rec.Payrollgrp</div> 
                        <div class=" w-100p">@rec.DateHired?.ToString("MM/dd/yyyy")</div>
                        <div class=" w-100p text-end">@rec.Ee?.ToString("N2")</div>
                        <div class=" w-100p text-end">@rec.Er?.ToString("N2")</div>
                        <div class=" w-100p text-end">@rec.Ec?.ToString("N2")</div>
                    </div>

                }
            </div>

        }

    </Details>
</_02BTModal>





@inject IOCoinfoDataAccess          _coinfo;
@inject IGPayrollReportDataAccess   _payreport; 



@code {
    [Parameter] public V00_RepVars              Rv  { get; set; } = new();
    [Parameter] public List<RSssPremModel>      V   { get; set; } = new();
    [Parameter] public EventCallback<object>    ChildAction { get; set; }

    async Task CreateReport()
    {


        Rv.ReportData = V;
        int monthNumber = Convert.ToInt32(Rv.Month);
        string monthName = new DateTime(1, monthNumber, 1).ToString("MMMM", CultureInfo.InvariantCulture);

        Rv.ReportParams["MonthYearCoverage"] = $"For the Month of {monthName} {Rv.Year}";
        Rv.ShowReport = true;

        if (Rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(2500); 
            Rv.ShowReport = false;
        };
    }

    async Task CloseReportModal(bool ans)
    {
        if (Rv.ShowReport == true) Rv.ShowReport = ans;
        else Rv.ShowModal = ans;
        await ChildAction.InvokeAsync(ans);

    }

    async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFormat);
    }
}