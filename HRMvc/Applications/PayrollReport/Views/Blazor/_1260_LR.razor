@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars

@* --- Loan remittance of a month. Mode hdmf: MBPay frmhdmfloanremit (ACCT_HDMFLOAN, every client);
       pagibig: frmpagibigloanremit (ACCT_HDMFLOAN + ACCT_PAGIBIGLOAN, chosen clients). Employer SSS ID = coinfo.sss --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (rv.ShowReport)
                {
                    <IframeReportRenderer DataSource="@rv.ReportData"
                                          ReportRelativePath="@rv.RelativePath"
                                          OutputFormat="@rv.SelectedFormat"
                                          Parameters="@rv.ReportParams"
                                          AutoGenerate="@(rv.ReportData?.Any() == true)"
                                          RefreshToken="@rv.RefreshToken" />
                }
                else
                {
                    <div class="sticky-top bg-white border-bottom">
                        <div class="card-header">
                            <div class="d-flex gap-2">
                                <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                                <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2 py-2 border-bottom fw-bold bg-lightgray">
                            <div class=" w-125p">@(Pagibig ? "Pag-IBIG No." : "TIN")</div>
                            <div class=" w-100p">Birth Date</div>
                            <div class=" w-250p">Employee</div>
                            <div class=" w-125p text-end">Amount</div>
                        </div>
                    </div>
                    @foreach (var r in reps)
                    {
                        <div class="d-flex gap-2 border-bottom py-1">
                            <div class=" w-125p">@(Pagibig ? r.PagibigNo : r.Tin)</div>
                            <div class=" w-100p">@r.Empbirth</div>
                            <div class=" w-250p">@r.Empname</div>
                            <div class=" w-125p text-end">@r.Amount.ToString("N2")</div>
                        </div>
                    }
                    <div class="d-flex gap-2 py-1 fw-bold">
                        <div class=" w-125p"></div><div class=" w-100p"></div><div class=" w-250p">TOTAL (@reps.Count)</div>
                        <div class=" w-125p text-end">@reps.Sum(x => x.Amount).ToString("N2")</div>
                    </div>
                }
            </Details>
        </_02BTModal>

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center">
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @if (Pagibig || Cont)
        {
            <div class="w-100"> <_00TClientList Clients="@rv.Clients" ClassParams="@listClass" ChildAction="ChildActionCatcher" /> </div>
        }
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess       _pisRep;
@inject IOClientDataAccess          _client;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc      { get; set; } = new();
    [Parameter] public string           Mode    { get; set; } = "hdmf";

    V00_RepVars                         rv      = new();
    List<RLoanRemitModel>               reps    = [];
    Dictionary<string, object>          listClass = new() { ["VH"] = "vh70" };

    bool Pagibig => Mode == "pagibig";
    //--- pagibigcont: Pag-IBIG Contribution Remittance (MBPay frmpagibigcontremit / frmpagibigperclient); no client picked = every client ---
    bool Cont => Mode == "pagibigcont";
    private string yymm => $"{rv.Year.ToString()!.Substring(2, 2)}{rv.Month}";

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv.RefreshToken = Cont ? 12610000 : Pagibig ? 12550000 : 12600000;
        rv.MCaption     = Cont ? "Pag-IBIG Contribution Remittance" : Pagibig ? "Pag-IBIG Loan Remittance" : "HDMF Loan Remittance";
        rv.ReportParams = new() { ["CoName"] = "-", ["CoAddress"] = "-", ["Month"] = "", ["Year"] = "", ["EmployerSss"] = "", ["RunDate"] = DateTime.Now };

        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if ((res ?? []).Any())
        {
            var c = res!.First()!;
            rv.ReportParams["CoName"]      = c.CoName ?? "";
            rv.ReportParams["CoAddress"]   = c.CoAdd ?? "";
            rv.ReportParams["EmployerSss"] = c.Sss ?? "";
        }
        if (Pagibig || Cont)
        {
            var cl = await _client._02ByStatuss("Active", Uc.OpisDb!, Uc.Conn!);
            if (cl?.Any() == true) rv.Clients = cl!;
        }
    }

    void ChildActionCatcher(){}

    private async Task FetchData()
    {
        reps = [];
        rv.ShowModal = false;
        rv.ShowReport = false;
        var cls = Pagibig ? rv.Clients.Where(c => c.IsSelectedB).Select(c => c.ClNumber!).ToList() : null;
        if (Pagibig && !cls!.Any()) { Notify(NotificationSeverity.Warning, "Warning", "Please select the clients."); return; }

        try
        {
            rv.Isloaded = true;
            var accts = Pagibig ? new List<string> { "ACCT_HDMFLOAN", "ACCT_PAGIBIGLOAN" } : ["ACCT_HDMFLOAN"];
            reps = Cont ? await _payRep._02PagibigContRemit(yymm, Cls(), Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!)
                        : await _payRep._02Remittance(accts, yymm, cls, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
            rv.ReportParams["Month"]   = new DateTime(rv.Year ?? DateTime.Now.Year, int.Parse(rv.Month!), 1).ToString("MMMM");
            rv.ReportParams["Year"]    = rv.Year.ToString()!;
            rv.ReportParams["RunDate"] = DateTime.Now;
        }
        catch (InvalidOperationException ex)
        {
            Notify(NotificationSeverity.Error, "Missing setting", ex.Message);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!reps.Any()) { Notify(NotificationSeverity.Info, "Info", "No data found for this month."); return; }
        rv.ShowModal = true;
    }

    private List<string>? Cls() { var c = rv.Clients.Where(x => x.IsSelectedB).Select(x => x.ClNumber!).ToList(); return c.Any() ? c : null; }

    private void CreateReport()
    {
        rv.ReportData   = reps;
        rv.RelativePath = Cont ? "Reports/_03Payroll/K_PagibigContRemit.trdp" : Pagibig ? "Reports/_03Payroll/K_PagibigLoanRemit.trdp" : "Reports/_03Payroll/K_HDMFLoanRemit.trdp";
        rv.RefreshToken++;
        rv.ShowReport   = true;
    }

    private void CloseReportModal(bool ans)
    {
        if (rv.ShowReport) rv.ShowReport = ans;
        else rv.ShowModal = ans;
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
