@using Telerik.Reporting
@using Telerik.Reporting.Processing

@if (IsLoading)
{
    <p class="mt-3 text-info">Generating report, please wait...</p>
}
else if (ReportBytes != null && OutputFormat == "PDF")
{
    <div style="height:90vh; margin-top:10px;">
        
        <iframe src="data:application/pdf;base64,@Convert.ToBase64String(ReportBytes)"
                style="width:100%;height:100%;border:none;">
        </iframe>
    </div>
}

@code {

    // ===============================
    // PARAMETERS 
    // ===============================
    [Parameter, EditorRequired] public IEnumerable<object>?         DataSource              { get; set; }
    [Parameter, EditorRequired] public string?                       ReportRelativePath      { get; set; } = default!;
    [Parameter]                 public string?                       OutputFormat            { get; set; } = "PDF";
    [Parameter]                 public Dictionary<string, object>?  Parameters              { get; set; }
    [Parameter]                 public bool                         AutoGenerate            { get; set; } = false;
    [Parameter]                 public int?                          RefreshToken            { get; set; }

    // ===============================
    // INTERNAL STATE
    // ===============================
    private byte[]?     ReportBytes;
    private bool        IsLoading;
    private string?     lastHash;

    [Inject] private IWebHostEnvironment    Env { get; set; } = default!;
    [Inject] private IJSRuntime             JS  { get; set; } = default!;

    // ===============================
    // LIFECYCLE (FIXED)
    // ===============================
    protected override async Task OnParametersSetAsync()
    {
        // ❗ DO NOTHING UNTIL DATA EXISTS
        if (!AutoGenerate)  return;
        if (DataSource == null || !DataSource.Any())    return;

        //var currentHash =   $"{OutputFormat}|{ReportRelativePath}|{DataSource.Count()}";
        var currentHash     = $"{OutputFormat}|{ReportRelativePath}|{RefreshToken}";


        if (currentHash == lastHash) return;

        lastHash = currentHash;
        await GenerateAsync();
    }

    // ===============================
    // CORE LOGIC
    // ===============================
    private async Task GenerateAsync()
    {
        try
        {
            IsLoading   = true;
            ReportBytes = null;
            StateHasChanged();

            // SAFETY GUARD
            if (DataSource == null || !DataSource.Any())    return;

            // -----------------------------
            // Resolve TRDP
            // -----------------------------
            var fullPath = Path.Combine(Env.ContentRootPath, ReportRelativePath );

            if (!File.Exists(fullPath)) return;

            // -----------------------------
            // Load report
            // -----------------------------
            var packager = new ReportPackager();
            Telerik.Reporting.Report report;

            using var fs    = File.OpenRead(fullPath);
            report          = (Telerik.Reporting.Report)packager.UnpackageDocument(fs);

            // -----------------------------
            // Parameters
            // -----------------------------
            if (Parameters != null)
            {
                Console.WriteLine($"=========================>");
                foreach (var p in Parameters)
                {

                    Console.WriteLine($"Key : {p.Key} * {p.Value}");
                    if (report.ReportParameters[p.Key] != null)
                        report.ReportParameters[p.Key].Value = p.Value;
                }
            }


            // -----------------------------
            // ObjectDataSource
            // -----------------------------
            report.DataSource = new ObjectDataSource
            {
                DataSource = DataSource
            };

            // -----------------------------
            // Render
            // -----------------------------
            var processor   = new ReportProcessor();
            var result      = processor.RenderReport(OutputFormat, new InstanceReportSource { ReportDocument = report }, null );

            ReportBytes     = result.DocumentBytes;

            // -----------------------------
            // Excel auto-download
            // -----------------------------
            if (OutputFormat == "XLSX")
            {
                await JS.InvokeVoidAsync("downloadFile", $"Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(ReportBytes) );
                ReportBytes = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ IframeReportRenderer.GenerateAsync ERROR");
            Console.WriteLine(ex.Message);
            Console.WriteLine(ex.StackTrace);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
