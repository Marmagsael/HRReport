@using HRMvc.Applications.PisReport.Vars

@* --- Account Total (MBPay frmaccounttotals -> rptAcctTotals (ATM) / rptAcctTotals1 (cash)); all TRNs of the period --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (rv.ShowReport)
                {
                    <IframeReportRenderer DataSource="@rv.ReportData"
                                          ReportRelativePath="@rv.RelativePath"
                                          OutputFormat="@rv.SelectedFormat"
                                          Parameters="@rv.ReportParams"
                                          AutoGenerate="@(rv.ReportData?.Any() == true)"
                                          RefreshToken="@rv.RefreshToken" />
                }
                else
                {
                    <div class="sticky-top bg-white border-bottom">
                        <div class="card-header">
                            <div class="d-flex gap-2">
                                <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                                <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2 py-2 border-bottom fw-bold bg-lightgray">
                            <div class=" w-300p">Account</div>
                            <div class=" w-150p text-end">Amount</div>
                            <div class=" w-150p text-end">Employer's Share</div>
                            <div class=" w-125p text-end">Hours</div>
                        </div>
                    </div>
                    @foreach (var s in reps.GroupBy(r => r.Section))
                    {
                        <div class="fw-bold py-1">@s.Key</div>
                        @foreach (var r in s)
                        {
                            <div class="d-flex gap-2 border-bottom py-1">
                                <div class=" w-300p ps-3">@r.Acctname</div>
                                <div class=" w-150p text-end">@r.Amount.ToString("N2")</div>
                                <div class=" w-150p text-end">@(r.Sss_ershare > 0 ? r.Sss_ershare.ToString("N2") : "")</div>
                                <div class=" w-125p text-end">@(r.Hrs > 0 ? r.Hrs.ToString("N2") : "")</div>
                            </div>
                        }
                        <div class="d-flex gap-2 border-bottom py-1 fw-bold">
                            <div class=" w-300p">TOTAL @s.Key</div>
                            <div class=" w-150p text-end">@s.Sum(x => x.Amount).ToString("N2")</div>
                        </div>
                    }
                    @if (reps.Any())
                    {
                        <div class="d-flex gap-2 py-1 fw-bold"><div class=" w-300p">NET PAY</div><div class=" w-150p text-end">@reps[0].NetPay.ToString("N2")</div></div>
                        <div class="d-flex gap-2 py-1 fw-bold"><div class=" w-300p">@rv.ReportParams["EmpLabel"]</div><div class=" w-150p text-end">@reps[0].TotalEmp</div></div>
                    }
                }
            </Details>
        </_02BTModal>

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center">
                    @*--- Period ------------------------------------------------*@
                    <_01YYMMPP Rv="rv" ChildAction="ChildActionCatcher" />
                    <RadzenRadioButtonList @bind-Value="isAtm" TValue="bool">
                        <Items>
                            <RadzenRadioButtonListItem Text="ATM" Value="true" />
                            <RadzenRadioButtonListItem Text="Cash" Value="false" />
                        </Items>
                    </RadzenRadioButtonList>
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess       _pisRep;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc      { get; set; } = new();
    V00_RepVars                         rv      = new();
    List<RAcctTotalModel>               reps    = [];
    bool                                isAtm   = true;

    private string yymmpp => $"{rv.Year.ToString()!.Substring(2, 2)}{rv.Month}{rv.Period}";

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv.RefreshToken = 13090000;
        rv.MCaption     = "Account Total";
        rv.ReportParams = new() { ["CoName"] = "-", ["CoAddress"] = "-", ["Period"] = "", ["EmpLabel"] = "", ["RunDate"] = DateTime.Now };

        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if ((res ?? []).Any())
        {
            rv.ReportParams["CoName"]    = res!.First()!.CoName ?? "";
            rv.ReportParams["CoAddress"] = res!.First()!.CoAdd ?? "";
        }
    }

    void ChildActionCatcher(){}

    private async Task FetchData()
    {
        reps = [];
        rv.ShowModal = false;
        rv.ShowReport = false;
        if (!HasConnection()) return;

        try
        {
            rv.Isloaded = true;
            reps = await _payRep._02AccountTotal(yymmpp, isAtm, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
            rv.ReportParams["EmpLabel"] = await _payRep._02ReportSetting("ACCTTOTAL_EMPLABEL", Uc.OpayDb!, Uc.Conn!);
            rv.ReportParams["Period"]   = CalendarPeriod();
            rv.ReportParams["RunDate"]  = DateTime.Now;
        }
        catch (InvalidOperationException ex)
        {
            Notify(NotificationSeverity.Error, "Missing setting", ex.Message);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!reps.Any())
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period.");
            return;
        }
        rv.ShowModal = true;
    }

    //--- MBPay lcFinPeriod: "May 16-31, 2026" ---
    private string CalendarPeriod()
    {
        int y = rv.Year ?? DateTime.Now.Year, m = int.Parse(rv.Month!);
        string days = rv.Period == "01" ? "1-15" : $"16-{DateTime.DaysInMonth(y, m)}";
        return $"{new DateTime(y, m, 1):MMMM} {days}, {y}";
    }

    private void CreateReport()
    {
        rv.ReportData   = reps;
        rv.RelativePath = isAtm ? "Reports/_03Payroll/K_AcctTotals.trdp" : "Reports/_03Payroll/K_AcctTotalsCash.trdp";
        rv.RefreshToken++;
        rv.ShowReport   = true;
    }

    private void CloseReportModal(bool ans)
    {
        if (rv.ShowReport) rv.ShowReport = ans;
        else rv.ShowModal = ans;
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
