<h3> Clients.Count : @rv.Clients.Count </h3>

<div>
    <button class="mb-cbtn  mb-cbtn-blue card p-2" @onclick="Clicked">Click me </button>
</div>

<div>
    @rv.ClNumber 
</div>


@code {


    [Parameter] public V00_RepVars rv { get; set; } = new(); 
    [Parameter] public EventCallback     ChildAction      { get; set; }


    async Task Clicked() {
        rv.ClNumber = "00640"; 
        await ChildAction.InvokeAsync(); 
    }

}
