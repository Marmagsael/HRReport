@using HRMvc.Applications.PayrollReport.Views.Blazor.Components



<div class="p-0 bordered-darkgreen br-5 w-650p overflow-auto" style="min-height:65vh; max-height:75vh; ">


    <table class="table table-sm table-bordered mb-0 earnings-grid" >
        <thead class="sticky-top bg-light h-35p">
        <tr>
            <th style="width:26px;"></th>
            <th>Description</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in V1104.ChartOfAccts)
        {
            <tr>
                    <td>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Text="New Entry" Click="@InsertRow" />

                    </td>
                <td>@c.AcctName</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {

    [Parameter] public V1104? V1104 { get; set; } = new(); 

    void InsertRow()
    {
        Console.WriteLine("Insert Row Clicked");
    }

}
