@using HRApiLibrary.Models._20_Pay.Report


@{ int ctr = 0 ;}
@foreach(var r in r1254s){
    ctr++; 
<div class="d-flex gap-1 text-start">
    <div class="w-40p text-end px-1 "> @ctr) </div>
    <div class="w-175p text-start ">@r.Pin.Trim() </div>
    <div class="w-125p text-start ">@r.EmpLastNm </div>
    <div class="w-125p">@r.EmpSuffixNm</div>
    <div class="w-125p">@r.EmpFirstNm</div>
    <div class="w-125p">@r.EmpMidNm </div>
    <div class="w-100p">SALARY</div>
    <div class="w-100p">STATUS</div>
    <div class="w-100p">EFFECT_DATE</div>
    <div class="w-100p">@r.BithDate?.ToString("MMM dd, yyyy")</div>
    <div class="w-100p">@r.Ps?.ToString("N2")</div>
    <div class="w-100p">@r.Es?.ToString("N2")</div>
    <div class="w-100p">@r.Gender</div>

</div>
}


@code {
    [Parameter] public List<R1254Model> r1254s {get; set; } = new(); 

}
