@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications.PisReport.Vars

@* --- Monthly Earnings (MBPay frmearnmonthly) / Monthly Deductions (frmdedmonthly) -> rptDedMonthly. Mode earn / ded;
       month (yymm) and ONE account (MBPay used the account highlighted in the grid), per employee: period 1-15, 16-end, total --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (rv.ShowReport)
                {
                    <IframeReportRenderer DataSource="@rv.ReportData"
                                          ReportRelativePath="@rv.RelativePath"
                                          OutputFormat="@rv.SelectedFormat"
                                          Parameters="@rv.ReportParams"
                                          AutoGenerate="@(rv.ReportData?.Any() == true)"
                                          RefreshToken="@rv.RefreshToken" />
                }
                else
                {
                    <div class="sticky-top bg-white border-bottom">
                        <div class="card-header">
                            <div class="d-flex gap-2">
                                <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                                <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2 py-2 border-bottom fw-bold bg-lightgray">
                            <div class=" w-200p">Last Name</div>
                            <div class=" w-200p">First Name</div>
                            <div class=" w-150p text-end">@rv.ReportParams["P1"]</div>
                            <div class=" w-150p text-end">@rv.ReportParams["P2"]</div>
                            <div class=" w-150p text-end">TOTAL</div>
                        </div>
                    </div>
                    @foreach (var r in reps)
                    {
                        <div class="d-flex gap-2 border-bottom py-1">
                            <div class=" w-200p">@r.Ln</div>
                            <div class=" w-200p">@r.Fn @r.Mi</div>
                            <div class=" w-150p text-end">@r.Amount01.ToString("N2")</div>
                            <div class=" w-150p text-end">@r.Amount02.ToString("N2")</div>
                            <div class=" w-150p text-end">@((r.Amount01 + r.Amount02).ToString("N2"))</div>
                        </div>
                    }
                    <div class="d-flex gap-2 py-1 fw-bold">
                        <div class=" w-200p">Count: @reps.Count</div><div class=" w-200p">Total</div>
                        <div class=" w-150p text-end">@reps.Sum(x => x.Amount01).ToString("N2")</div>
                        <div class=" w-150p text-end">@reps.Sum(x => x.Amount02).ToString("N2")</div>
                        <div class=" w-150p text-end">@reps.Sum(x => x.Amount01 + x.Amount02).ToString("N2")</div>
                    </div>
                }
            </Details>
        </_02BTModal>

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @*--- Month ------------------------------------------------*@
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    @*--- Account ------------------------------------------------*@
                    <RadzenDropDown @bind-Value="acctNumber" Data="@accounts" TextProperty="AcctName" ValueProperty="AcctNumber"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@(IsEarn ? "Select earning" : "Select deduction")" Style="width: 320px;" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess       _pisRep;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc          { get; set; } = new();
    [Parameter] public string           Mode        { get; set; } = "earn";
    V00_RepVars                         rv          = new();
    List<REarnDedMonthlyModel>          reps        = [];
    List<GChartofacctModel?>            accounts    = [];
    string?                             acctNumber;

    private bool IsEarn => Mode == "earn";
    private string yymm => $"{rv.Year.ToString()!.Substring(2, 2)}{rv.Month}";

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv.RefreshToken = IsEarn ? 11040000 : 11550000;
        rv.MCaption     = IsEarn ? "Monthly Earnings Report" : "Monthly Deductions Report";
        rv.ReportParams = new() { ["CoName"] = "-", ["CoAddress"] = "-", ["P1"] = "", ["P2"] = "", ["MM"] = "", ["YY"] = "" };

        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if ((res ?? []).Any())
        {
            rv.ReportParams["CoName"]    = res!.First()!.CoName ?? "";
            rv.ReportParams["CoAddress"] = res!.First()!.CoAdd ?? "";
        }

        var coa = await _payRep._02s(Uc.OpayDb!, Uc.Conn!) ?? [];
        string type = IsEarn ? "E" : "D";
        accounts = coa.Where(a => a?.AcctNumber?.StartsWith(type, StringComparison.OrdinalIgnoreCase) == true).OrderBy(a => a!.AcctName).ToList();
    }

    void ChildActionCatcher(){}

    private async Task FetchData()
    {
        reps = [];
        rv.ShowModal = false;
        rv.ShowReport = false;
        if (!HasConnection()) return;
        if (string.IsNullOrWhiteSpace(acctNumber)) { Notify(NotificationSeverity.Warning, "Warning", "Please select the account."); return; }

        try
        {
            rv.Isloaded = true;
            reps = await _payRep._02EarnDedMonthly(yymm, acctNumber, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);

            //--- MBPay lcP1 = "May 1-15", lcP2 = "May 16-31" ---
            var first = new DateTime(rv.Year!.Value, int.Parse(rv.Month!), 1);
            string mm = first.ToString("MMMM");
            rv.ReportParams["MM"] = mm;
            rv.ReportParams["YY"] = rv.Year.ToString()!;
            rv.ReportParams["P1"] = $"{mm} 1-15";
            rv.ReportParams["P2"] = $"{mm} 16-{DateTime.DaysInMonth(first.Year, first.Month)}";
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!reps.Any()) { Notify(NotificationSeverity.Info, "Info", "No records found in database!"); return; }
        rv.ShowModal = true;
    }

    private void CreateReport()
    {
        rv.ReportData   = reps;
        rv.RelativePath = "Reports/_03Payroll/K_EarnDedMonthly.trdp";
        rv.RefreshToken++;
        rv.ShowReport   = true;
    }

    private void CloseReportModal(bool ans)
    {
        if (rv.ShowReport) rv.ShowReport = ans;
        else rv.ShowModal = ans;
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
