@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars

@* --- Monthly PHIC Report per payroll group (MBPay frmphmoperclient -> rptPhMo). Month and the clients of its TRNs; the employees with
       a PhilHealth premium (ACCT_PHIC) in those clients, their premium for the whole month. Employer share = employee share --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (rv.ShowReport)
                {
                    <IframeReportRenderer DataSource="@rv.ReportData"
                                          ReportRelativePath="@rv.RelativePath"
                                          OutputFormat="@rv.SelectedFormat"
                                          Parameters="@rv.ReportParams"
                                          AutoGenerate="@(rv.ReportData?.Any() == true)"
                                          RefreshToken="@rv.RefreshToken" />
                }
                else
                {
                    <div class="sticky-top bg-white border-bottom">
                        <div class="card-header">
                            <div class="d-flex gap-2">
                                <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                                <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2 py-2 border-bottom fw-bold bg-lightgray">
                            <div class=" w-150p">PHIC No.</div>
                            <div class=" w-250p">Name of Employees</div>
                            <div class=" w-125p text-end">Employee</div>
                            <div class=" w-125p text-end">Employer</div>
                            <div class=" w-125p text-end">Total</div>
                        </div>
                    </div>
                    @foreach (var r in reps)
                    {
                        <div class="d-flex gap-2 border-bottom py-1">
                            <div class=" w-150p">@r.Phic</div>
                            <div class=" w-250p">@r.Empname</div>
                            <div class=" w-125p text-end">@r.Amount.ToString("N2")</div>
                            <div class=" w-125p text-end">@r.Amount.ToString("N2")</div>
                            <div class=" w-125p text-end">@((r.Amount * 2).ToString("N2"))</div>
                        </div>
                    }
                    <div class="d-flex gap-2 py-1 fw-bold">
                        <div class=" w-150p"></div><div class=" w-250p">Grand Total (@reps.Count)</div>
                        <div class=" w-125p text-end">@reps.Sum(x => x.Amount).ToString("N2")</div>
                        <div class=" w-125p text-end">@reps.Sum(x => x.Amount).ToString("N2")</div>
                        <div class=" w-125p text-end">@((reps.Sum(x => x.Amount) * 2).ToString("N2"))</div>
                    </div>
                }
            </Details>
        </_02BTModal>

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center">
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    @*--- Clients of the month ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="Search"> Search</div>
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @*--- Clients ------------------------------------------------*@
        <div class="w-100"><div class="fw-bold p-1">Clients</div><_00TClientList Clients="@clients" ClassParams="@listClass" ChildAction="ChildActionCatcher" /></div>
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess       _pisRep;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc          { get; set; } = new();
    V00_RepVars                         rv          = new();
    List<RPhicMonthlyModel>              reps        = [];

    //--- Client list reuses the client list component: ClNumber holds the client code ---
    List<OClientModel>                  clients     = [];
    Dictionary<string, object>          listClass   = new() { ["VH"] = "vh60" };

    private string yymm => $"{rv.Year.ToString()!.Substring(2, 2)}{rv.Month}";

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv.RefreshToken = 12650000;
        rv.MCaption     = "PHIC Monthly per Pay Group";
        rv.ReportParams = new() { ["CoName"] = "-", ["CoAddress"] = "-", ["MM"] = "", ["YY"] = "" };

        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if ((res ?? []).Any())
        {
            var c = res!.First()!;
            rv.ReportParams["CoName"]      = c.CoName ?? "";
            rv.ReportParams["CoAddress"]   = c.CoAdd ?? "";
        }
    }

    void ChildActionCatcher(){}

    //--- Clients of the month's TRNs, all selected ---
    private async Task Search()
    {
        if (!HasConnection()) return;
        var res = await _payRep._02MonthClients(yymm, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
        clients = res.Select(c => new OClientModel { ClNumber = c.Clnumber, ClName = c.Clname, IsSelectedB = true }).ToList();
        if (!clients.Any()) Notify(NotificationSeverity.Info, "Info", "No clients found for this month.");
    }

    private async Task FetchData()
    {
        reps = [];
        rv.ShowModal = false;
        rv.ShowReport = false;
        if (!HasConnection()) return;

        var cls = clients.Where(c => c.IsSelectedB).Select(c => c.ClNumber!).ToList();
        if (!cls.Any()) { Notify(NotificationSeverity.Warning, "Warning", "Please search and select the clients."); return; }

        try
        {
            rv.Isloaded = true;
            reps = await _payRep._02PhicMonthly(yymm, cls, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
            rv.ReportParams["MM"] = new DateTime(rv.Year ?? DateTime.Now.Year, int.Parse(rv.Month!), 1).ToString("MMMM");
            rv.ReportParams["YY"] = rv.Year.ToString()!;
        }
        catch (InvalidOperationException ex)
        {
            Notify(NotificationSeverity.Error, "Missing setting", ex.Message);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!reps.Any()) { Notify(NotificationSeverity.Info, "Info", "No data found for this month."); return; }
        rv.ShowModal = true;
    }

    private void CreateReport()
    {
        rv.ReportData   = reps;
        rv.RelativePath = "Reports/_03Payroll/K_PhicMonthly.trdp";
        rv.RefreshToken++;
        rv.ShowReport   = true;
    }

    private void CloseReportModal(bool ans)
    {
        if (rv.ShowReport) rv.ShowReport = ans;
        else rv.ShowModal = ans;
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
