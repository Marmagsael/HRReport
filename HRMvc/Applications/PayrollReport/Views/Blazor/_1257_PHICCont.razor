@using Blazorise
@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PayrollReport.Views.Blazor._1257

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>

        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />


        @if ((reps ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_1257_Report Rv="rv" V="@reps" ChildAction="ChildActionCatcher" />
        }


        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2">
                    @*--- Period ------------------------------------------------*@
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @*--- Client List ------------------------------------------------*@
        <div class="w-100"> <_00TClientList Clients="@rv.Clients" ClassParams="@clientClass" ChildAction="ChildActionCatcher" /> </div>
    </Details>
</_00BT_FullW>





@inject IOPisReportDataAccess _pisRep;
@inject IOClientDataAccess _client;
@inject IGPayrollReportDataAccess _payRep;

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V00_RepVars             rv = new();
    List<RPhicPremModel?>?  reps = [];

    private List<string?> clients => rv.Clients?.Where(x => x.IsSelectedB).Select(x => x.ClNumber).ToList() ?? new();

    Dictionary<string, object> periodClass = new() { ["FlexDirection"] = "flex-column" };
    Dictionary<string, object> clientClass = new() { ["VH"] = "vh77" };

    protected override async Task OnInitializedAsync()
    {

        if (!HasConnection()) return;

        InitializeReport();
        await LoadInitialData();
    }

    //===================================
    // Initial Data =====================
    private void InitializeReport()
    {
        rv.RefreshToken = 12520000;
        rv.MCaption = "PHIC Contribution";
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "PHIC Contribution",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task LoadInitialData()
    {
        await LoadCompanyInfo();
        await LoadClients();
    }

    private async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }

    private async Task LoadClients()
    {
        var res = await _client._02ByStatuss("Active", Uc.OpisDb!, Uc.Conn!);
        if (res?.Any() == true) rv.Clients = res!;
        // rv.Clients.Insert(0, new() { ClNumber = "-", ClName = "Undeployed" });
    }



    void ChildActionCatcher() { }

    private async Task FetchData()
    {
        ResetVars();

        if (!HasConnection() || !ValidateFilters()) return;

        try
        {
            rv.Isloaded = true;
            reps = await _payRep._02PHICPrem_ByPGrps_ByYYMM(clients!, rv.Year, rv.Month, "D003", Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!) ?? []; ; 
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (reps?.Any() != true)
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period and deployment.");
            return;
        }


        rv.ShowModal = true;

    }


    private bool ValidateFilters()
    {
        if (!clients.Any())
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select at least one deployment to proceed.");
            return false;
        }

        if (rv.DStart == null)
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select a starting date to proceed.");
            return false;
        }

        if (rv.DEnd == null)
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select an ending date to proceed.");
            return false;
        }

        return true;
    }

    private void ResetVars()
    {
        reps = new();
        rv.ShowModal = false;
        rv.ShowReport = false;

        if (rv.ReportFormats?.Any() == true) rv.SelectedFormat = "PDF";
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }

        return true;
    }

    private void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }

    void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }

}

}