@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PayrollReport.Views.Blazor._1203

@* --- Payroll Register (MBPay frmpayrollregister: per Client / per Batch -> rptPYR_04b) --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        @if ((reps ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_1203_Report Rv="rv" V="@reps" ChildAction="ChildActionCatcher" />
        }


        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2">
                    @*--- Period ------------------------------------------------*@
                    <_01YYMMPP Rv="rv" ChildAction="PeriodChanged" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @*--- Payroll groups (TRNs) of the period ------------------------------------------------*@
        <div class="w-100"> <_00TClientList Clients="@rv.Clients" ClassParams="@clientClass" ChildAction="ChildActionCatcher" /> </div>
    </Details>
</_00BT_FullW>





@inject IOPisReportDataAccess       _pisRep;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc      { get; set; } = new();
    V00_RepVars                         rv      = new();
    List<RPayrollRegisterModel>         reps    = [];

    //--- The list shows one row per TRN: ClNumber holds the TRN ---
    private List<string> trns => rv.Clients?.Where(x => x.IsSelectedB).Select(x => x.ClNumber!).ToList() ?? new();
    private string yymmpp => $"{rv.Year.ToString()!.Substring(2, 2)}{rv.Month}{rv.Period}";

    Dictionary<string, object> clientClass = new(){ ["VH"] = "vh77"};

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        InitializeReport();
        await LoadCompanyInfo();
        await LoadTrns();
    }

    //===================================
    // Initial Data =====================
    private void InitializeReport()
    {
        rv.RefreshToken     = 12030000;
        rv.MCaption         = "Payroll Register";
        rv.ReportParams     = new()
        {
            ["CoName"]      = "-",
            ["CoAddress"]   = "-",
            ["RunDate"]     = DateTime.Now
        };
    }

    private async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"]    = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }

    private async Task LoadTrns()
    {
        var res = await _payRep._02PayrollRegisterTrns(yymmpp, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
        rv.Clients = res.Select(t => new OClientModel { ClNumber = t.Trn, ClName = $"{t.ClName}   [Batch {t.Batch}]  {t.Trn}" }).ToList();
    }

    async Task PeriodChanged()
    {
        reps = [];
        await LoadTrns();
    }

    void ChildActionCatcher(){}

    private async Task FetchData()
    {
        ResetVars();

        if (!HasConnection() || !ValidateFilters()) return;

        try
        {
            rv.Isloaded = true;
            rv.ReportParams["RunDate"] = DateTime.Now;
            reps = await _payRep._02PayrollRegister(trns, yymmpp, rv.ReportParams["CoName"]?.ToString(), Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
        }
        catch (InvalidOperationException ex)
        {
            Notify(NotificationSeverity.Error, "Missing setting", ex.Message);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (reps?.Any() != true)
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period and payroll group.");
            return;
        }

        rv.ShowModal = true;
    }


    private bool ValidateFilters()
    {
        if (!trns.Any())
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select payroll group from the list.");
            return false;
        }

        return true;
    }

    private void ResetVars()
    {
        reps = new();
        rv.ShowModal = false;
        rv.ShowReport = false;

        if (rv.ReportFormats?.Any() == true) rv.SelectedFormat = "PDF";
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }

        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }

}
