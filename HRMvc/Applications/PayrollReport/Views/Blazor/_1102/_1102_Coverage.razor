@using HRApiLibrary.DataAccess._90_Utils
@using HRApiLibrary.Models._90_Utils
@using HRMvc.Applications.PayrollReport.Views.Blazor.Components
<div class="w-100 mb-2">
    <div class="d-flex gap-2 bordered-bottom py-1">
        <div class="p-2">Year</div>
        <div>
            <RadzenDropDown 
                TValue          ="int"
                @bind-Value     =@v1102.Yr
                Data            =@yrs
                TextProperty    ="Name"
                ValueProperty   ="Year"
                Style           ="width: 100%; max-width: 125px;"
                Name            ="ddYears" />
        </div>
        <div class="p-2">Month</div>
        <div>
            <RadzenDropDown 
                TValue="int"
                @bind-Value=@v1102.Mo
                Data=@mos
                TextProperty="Name"
                ValueProperty="Month"
                Style="width: 100%; max-width: 200px;"
                PopupStyle="max-height: 460px; overflow-y: auto;"
                Name="ddMonths" />
        </div>


    </div>
    @* --- Content Details ---------------------------- *@
    <div>

    </div>


</div>

@code {
    [Parameter] public UserClaimsModel? UserClaims { get; set; }

    List<YearsModel?>   yrs             = [];
    List<MonthsModel?>  mos             = new();
    bool                _isPrerendering = true;
    V1102               v1102           = new V1102();


    protected override void OnInitialized()
    {
        yrs = MsdsDataAccess.GetYears(3);
        mos = MsdsDataAccess.GetMonths();
    }

}
