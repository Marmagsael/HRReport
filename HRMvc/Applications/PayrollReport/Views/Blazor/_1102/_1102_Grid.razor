@using HRMvc.Applications.PayrollReport.Views.Blazor.Components


<button class="btn btn-success mb-2" @onclick="Refresh">Refresh</button>

<div class="p-0 bordered-darkgreen br-5 w-650p overflow-auto" style="min-height:65vh; max-height:75vh; ">


    <table class="table table-sm table-bordered mb-0 earnings-grid" >
        <thead class="sticky-top bg-light h-35p">
            <tr>
                <th style="width:26px;"></th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            
            @foreach (var coa in V1102.ChartOfAccts??[] )
            {
                <tr>
                    <td class="text-center"><input type="checkbox" @bind="coa.IsSelectedB">
                        <RadzenCheckBox 
                            @bind-Value="coa.IsSelectedB"
                            TValue="bool" />
                    </td>
                    <td>@coa.AcctName * @coa.IsSelectedB </td>
                </tr>
            }



            
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>13th Month</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>13th Month (Nov. 16-30)</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Additional Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Allowance Adjustment</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Annual Incentive Leave 2017</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox" checked></td>
                <td><strong>Basic Pay</strong></td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Boarding House Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Canteen Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Client Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Clothing/Uniform Allowance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>COLA</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>COLA REFUND</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>CTPA</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>CTPA RDLH</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>CTPA Reg Holiday</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>DC Mtg Attendance</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Des Minimis</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Double Hol</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>Double Hol OT</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>ECOLA</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>ECOLA (added)</td>
            </tr>
            <tr>
                <td class="text-center"><input type="checkbox"></td>
                <td>ECOLA LH</td>
            </tr>
        </tbody>
    </table>




</div>

@code {
    [Parameter] public V1102? V1102 { get; set; }

    void Refresh()
    {
        StateHasChanged();
    }
}
