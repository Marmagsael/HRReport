@using Blazorise
@using System.Globalization

<div class="w-100 d-flex gap-2 mt-2 bordered-bottom py-1 bg-gray ">
    <div class="p-2">Year</div>
    <div>
        <select @bind="selectedYear" class="form-select w-100p ">
            @for (int year = selectedYear??0; year >= xYear - 4; year--)
            {
                <option value="@year">@year</option>
            }
        </select>


    </div>
    <div class="p-2">Month</div>
    <div >
        <select @bind="selectedMonth" class="form-select w-150p ">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
            }
</select>

    </div>

</div>

@code {

    int? selectedYear;
    int? xYear = DateTime.Now.Year;
    int? selectedMonth = DateTime.Now.Month;




    protected override void OnInitialized()
    {
        selectedYear = xYear;
        selectedMonth = DateTime.Now.Month;
    }



}
