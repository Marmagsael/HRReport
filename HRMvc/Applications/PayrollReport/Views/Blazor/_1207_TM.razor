@using HRApiLibrary.Models._10_Pis.OPis

@* --- 13th Month reports (MBPay: frm13thmonthdetailed / frm13dtlperclient / frm13dtlperemp, frm13thmonthsummary / frm13summaryclient /
       frm13summaryemp, frm13register / frm132register, frmba13). Kind: detailed | summary | register | bank.
       Scope: all (statuses + clients) | client (one client) | emp (one employee). Basic pay (E001) of June-November (01) or
       December-May (02); 13th month = total / 12. Statuses and clients are all selected at first (MBPay started with none) --- *@

@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        <_02BTModal MCaption="@rv.MCaption" ShowModal="rv.ShowModal" ChildAction="CloseReportModal">
            <Details>
                @if (rv.ShowReport)
                {
                    <IframeReportRenderer DataSource="@rv.ReportData"
                                          ReportRelativePath="@rv.RelativePath"
                                          OutputFormat="@rv.SelectedFormat"
                                          Parameters="@rv.ReportParams"
                                          AutoGenerate="@(rv.ReportData?.Any() == true)"
                                          RefreshToken="@rv.RefreshToken" />
                }
                else
                {
                    <div class="sticky-top bg-white border-bottom">
                        <div class="card-header">
                            <div class="d-flex gap-2">
                                <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                                <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2 py-2 border-bottom fw-bold bg-lightgray">
                            <div class=" w-75p text-end">No.</div>
                            <div class=" w-250p">Client</div>
                            <div class=" w-300p">Name</div>
                            <div class=" w-150p text-end">Total</div>
                            <div class=" w-150p text-end">13th Month</div>
                        </div>
                    </div>
                    int no = 0;
                    @foreach (var r in shown)
                    {
                        no++;
                        <div class="d-flex gap-2 border-bottom py-1">
                            <div class=" w-75p text-end">@no</div>
                            <div class=" w-250p">@r.Clname</div>
                            <div class=" w-300p">@r.Emplastnm, @r.Empfirstnm</div>
                            <div class=" w-150p text-end">@r.Total.ToString("N2")</div>
                            <div class=" w-150p text-end">@((r.Total / 12).ToString("N2"))</div>
                        </div>
                    }
                    <div class="d-flex gap-2 py-1 fw-bold">
                        <div class=" w-75p"></div><div class=" w-250p"></div><div class=" w-300p">Grand Total (@shown.Count)</div>
                        <div class=" w-150p text-end">@shown.Sum(x => x.Total).ToString("N2")</div>
                        <div class=" w-150p text-end">@((shown.Sum(x => x.Total) / 12).ToString("N2"))</div>
                    </div>
                }
            </Details>
        </_02BTModal>

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @*--- Coverage ------------------------------------------------*@
                    <RadzenDropDown @bind-Value="half" Data="@halves" TextProperty="Text" ValueProperty="Value" Style="width: 160px;" />
                    <RadzenDropDown @bind-Value="year" Data="@years" Style="width: 100px;" />

                    @if (Scope == "client")
                    {
                        <RadzenDropDown @bind-Value="clientCode" Data="@clients" TextProperty="ClName" ValueProperty="ClNumber"
                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Select client" Style="width: 300px;" />
                    }
                    else if (Scope == "emp")
                    {
                        <RadzenDropDown @bind-Value="empNumber" Data="@emps" TextProperty="ClName" ValueProperty="ClNumber"
                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Select employee" Style="width: 300px;" />
                    }
                    else if (Kind != "bank")
                    {
                        <RadzenCheckBox TValue="bool" @bind-Value="noClient" />
                        <span>View employees with no deployment</span>
                    }

                    @if (Kind == "bank")
                    {
                        <RadzenRadioButtonList @bind-Value="isAtm" TValue="bool">
                            <Items>
                                <RadzenRadioButtonListItem Text="ATM" Value="true" />
                                <RadzenRadioButtonListItem Text="Cash" Value="false" />
                            </Items>
                        </RadzenRadioButtonList>
                    }
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @*--- Employee status / Clients ------------------------------------------------*@
        @if (Scope != "emp")
        {
            <div class="d-flex gap-2 w-100">
                <div class="flex-fill"><div class="fw-bold p-1">Employee status</div><_00TClientList Clients="@statuses" ClassParams="@listClass" ChildAction="ChildActionCatcher" /></div>
                @if (Scope == "all")
                {
                    <div class="flex-fill"><div class="fw-bold p-1">Clients</div><_00TClientList Clients="@clientList" ClassParams="@listClass" ChildAction="ChildActionCatcher" /></div>
                }
            </div>
        }
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess       _pisRep;
@inject IGPayrollReportDataAccess   _payRep;

@code{
    [Parameter] public UserClaimsModel  Uc          { get; set; } = new();
    [Parameter] public string           Kind        { get; set; } = "detailed";
    [Parameter] public string           Scope       { get; set; } = "all";
    V00_RepVars                         rv          = new();
    List<R13thMonthModel>               reps        = [];

    //--- Bank advice: ATM employees (with an account code) or cash ones; only those with an amount ---
    List<R13thMonthModel>               shown       => Kind != "bank" ? reps : (isAtm ? reps.Where(r => r.Acctcode != "" && r.Amount > 0) : reps.Where(r => r.Acctcode == "" && r.Amount > 0)).ToList();
    bool                                isAtm       = true;

    string                              half        = "02";
    int                                 year        = DateTime.Today.Year;
    bool                                noClient    = true;
    string?                             clientCode;
    string?                             empNumber;
    List<object>                        halves      = [new { Text = "June - November", Value = "01" }, new { Text = "December - May", Value = "02" }];
    List<int>                           years       = Enumerable.Range(2000, 28).Reverse().ToList();

    //--- Lists reuse the client list component: ClNumber holds the status / client code / employee number ---
    List<OClientModel>                  statuses    = [];
    List<OClientModel>                  clients     = [];
    List<OClientModel>                  clientList  = [];
    List<OClientModel>                  emps        = [];
    Dictionary<string, object>          listClass   = new() { ["VH"] = "vh60" };

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        string scopeCap = Scope == "client" ? " (Per Client)" : Scope == "emp" ? " (Per Employee)" : "";
        rv.MCaption = Kind switch { "summary" => "13th Month Summary", "register" => "13th Month Register", "bank" => "13th Month Bank Advice", _ => "13th Month Detailed" } + scopeCap;
        rv.RefreshToken = 1207000 + (Kind.Length * 10) + (Scope == "all" ? 0 : Scope == "client" ? 1 : 2);
        rv.ReportParams = new() { ["CoName"] = "-", ["CoAddress"] = "-", ["PP"] = "" };

        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if ((res ?? []).Any())
        {
            rv.ReportParams["CoName"]    = res!.First()!.CoName ?? "";
            rv.ReportParams["CoAddress"] = res!.First()!.CoAdd ?? "";
        }

        statuses   = (await _payRep._02EmpStatuses(Uc.OpisDb!, Uc.Conn!)).Select(s => new OClientModel { ClNumber = s.Code, ClName = s.Name, IsSelectedB = true }).ToList();
        var cl     = await _payRep._02ActiveClients(Uc.OpisDb!, Uc.Conn!);
        clients    = cl.Select(c => new OClientModel { ClNumber = c.Code, ClName = c.Name }).ToList();
        clientList = cl.Select(c => new OClientModel { ClNumber = c.Code, ClName = c.Name, IsSelectedB = true }).ToList();
        if (Scope == "emp")
            emps = (await _payRep._02ReportEmployees(Uc.OpisDb!, Uc.Conn!)).Select(e => new OClientModel { ClNumber = e.Empnumber?.Trim(), ClName = $"{e.Empname}   ({e.Empnumber?.Trim()})" }).ToList();
    }

    void ChildActionCatcher(){}

    private async Task FetchData()
    {
        reps = [];
        rv.ShowModal = false;
        rv.ShowReport = false;
        if (!HasConnection()) return;

        var st = statuses.Where(s => s.IsSelectedB).Select(s => s.ClNumber!).ToList();
        List<string>? cls = null;
        string? emp = null;
        if (Scope == "client")
        {
            if (string.IsNullOrWhiteSpace(clientCode)) { Notify(NotificationSeverity.Warning, "Warning", "Please select the client."); return; }
            cls = [clientCode];
        }
        else if (Scope == "emp")
        {
            if (string.IsNullOrWhiteSpace(empNumber)) { Notify(NotificationSeverity.Warning, "Warning", "Please select the employee."); return; }
            emp = empNumber;
        }
        else cls = clientList.Where(c => c.IsSelectedB).Select(c => c.ClNumber!).ToList();
        if (Scope != "emp" && !st.Any()) { Notify(NotificationSeverity.Warning, "Warning", "Please select the employee status."); return; }

        try
        {
            rv.Isloaded = true;
            //--- MBPay's bank advice always took the employees with no client; the client report only that client ---
            reps = await _payRep._02ThirteenthMonth(half, year, st, cls, Scope == "client" ? false : (Kind == "bank" || noClient), emp, Uc.OpayDb!, Uc.OpisDb!, Uc.Conn!);
            //--- MBPay lcPP ---
            rv.ReportParams["PP"] = half == "02" ? $"December, {year - 1} - May, {year}" : $"June, {year} - November, {year}";
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh or contact your system administrator.");
            Console.WriteLine(ex);
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!shown.Any()) { Notify(NotificationSeverity.Info, "Info", "No record found on search criteria. Nothing to print!"); return; }
        rv.ShowModal = true;
    }

    private void CreateReport()
    {
        string h = half == "02" ? "DM" : "JN";
        rv.ReportData   = Kind == "bank" && !isAtm ? shown.OrderBy(r => r.Clname).ThenBy(r => r.Emplastnm).ThenBy(r => r.Empfirstnm).ToList() : shown;
        rv.RelativePath = "Reports/_03Payroll/" + (Kind, Scope) switch
        {
            ("detailed", "client") => $"K_13PerClient{h}.trdp",
            ("detailed", "emp")    => $"K_13PerEmp{h}.trdp",
            ("detailed", _)        => $"K_13Detailed{h}.trdp",
            ("summary", "client")  => "K_13SummaryClient.trdp",
            ("summary", "emp")     => "K_13SummaryEmp.trdp",
            ("summary", _)         => "K_13Summary.trdp",
            ("register", _)        => "K_13Register.trdp",
            _                      => isAtm ? "K_13BankAdvise.trdp" : "K_13CashBasis.trdp"
        };
        rv.RefreshToken++;
        rv.ShowReport   = true;
    }

    private void CloseReportModal(bool ans)
    {
        if (rv.ShowReport) rv.ShowReport = ans;
        else rv.ShowModal = ans;
    }

    private bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.OpayDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect", "Please refresh or contact administrator.");
            return false;
        }
        return true;
    }

    private void Notify(NotificationSeverity severity, string? summary, string? detail)
        => _NotificationService.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
