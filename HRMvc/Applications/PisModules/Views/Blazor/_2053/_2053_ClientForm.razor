<div style="max-height:60vh">

    <EditForm Model="@V.Client" OnSubmit="@SaveClient" class="h-100 d-flex flex-column">

        @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="1">
                Save
            </button>

        </div>


        <div class="px-2 ps-md-3 pt-3  ">

            @* --- Mother Unit Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Mother Unit 
                </label>

                <div class="col-12 col-md-8  ">

                    <TelerikDropDownList Data="DropDownListData"
                                         TextField="MyTextField"
                                         ValueField="MyValueField"
                                         @bind-Value="@V.Client.ParentCd"
                                         DefaultText="Select an item..."
                                         Filterable="true"
                                         TabIndex="2" />

                </div>

            </div>


            @* --- Client Code --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Client Code
                </label>

                <div class="col-12 col-md-4 ">

                    <TelerikTextBox @bind-Value="@V.Client.ClNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="3" />

                </div>

            </div>


            @* --- Client Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Client Name
                </label>

                <div class="col-12 col-md-4  ">

                    <TelerikTextBox @bind-Value="@V.Client.ClName"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="4" />

                </div>

            </div>


            @* --- Current Address --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Current Address
                </label>

                <div class="col-12 col-md-8  ">
                    <TelerikTextArea @bind-Value="@V.Client.Addr1"
                                     MaxLength="200"
                                     Rows="5"
                                     TabIndex="5" />

                </div>

            </div>


            @* --- Area Code--- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Area Code
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikTextBox @bind-Value="@V.Client.AreaCode"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="6" />

                </div>

            </div>


            @* --- Telephone No. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Telephone No.
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikTextBox @bind-Value="@V.Client.Tel1"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="7" />

                </div>

            </div>

            @* --- Fax No. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Fax No.
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikTextBox @bind-Value="@V.Client.FaxNo"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="8" />

                </div>

            </div>

            @* --- Contact Person. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Contact Person
                </label>

                <div class="col-12 col-md-8  ">
                    <TelerikTextBox @bind-Value="@V.Client.Contact"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    TabIndex="9" />

                </div>

            </div>

            @* --- End of Contract --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    End of Contract
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikDateInput @bind-Value="@V.Client.ContEnd"
                                      Format="dd MMMM yyyy"
                                      Width="200px"
                                      TabIndex="10" />

                </div>

            </div>

            @* --- Contract Expiration --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Contract Expiration
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikDateInput @bind-Value="@V.Client.ContExp"
                                      Format="dd MMMM yyyy"
                                      Width="200px"
                                      TabIndex="11" />

                </div>

            </div>

            @* --- Remarks --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Remarks
                </label>

                <div class="col-12 col-md-8  ">
                    <TelerikTextArea @bind-Value="@V.Client.Remarks"
                                     MaxLength="200"
                                     Rows="5"
                                     TabIndex="12" />

                </div>

            </div>

            @* --- Status --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Status
                </label>

                <div class="col-12 col-md-4  ">
                    <TelerikDropDownList Data="DropDownListData"
                                         TextField="MyTextField"
                                         ValueField="MyValueField"
                                         @bind-Value="@V.Client.ParentCd"
                                         DefaultText="Select an item..."
                                         Filterable="true"
                                         TabIndex="13" />

                </div>

            </div>

        </div>

    </EditForm>

</div>

@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    private V2053Model V { get; set; } = new();

    [CascadingParameter]
    private TelerikNotification? NotificationRef { get; set; }



    // Dummy ---
    private List<DropDownListItem> DropDownListData { get; set; } = [];
    private int SelectedValue { get; set; }

    public class DropDownListItem
    {
        public int MyValueField { get; set; }
        public string MyTextField { get; set; }
    }


    private void SaveClient()
    {

    }
}
