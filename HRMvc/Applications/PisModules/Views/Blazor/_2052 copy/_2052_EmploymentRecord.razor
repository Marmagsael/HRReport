            <div></div>
        </div>

        <div class="d-flex align-items-center px-2">
            @*---------------------- Address --------------------*@
            <div class="w-70">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-end pe-3 me-3 py-2"> Address</div>
                    <div></div>
                </div>
            </div>

            @*---------------------- Employment Dates --------------------*@
            <div class="w-30">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-start border-end px-3 me-3 py-2"> Employment Dates</div>
                    <div></div>
                </div>
            </div>
        </div>



        <div class="d-flex align-items-center px-2 border-top">
            @*---------------------- Job Title/Positions --------------------*@
            <div class="w-30">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-end pe-3 me-3 py-2"> Job Title/Position</div>
                    <div></div>
                </div>
            </div>

            @*---------------------- Pay/Salary Per Month --------------------*@
            <div class="w-40">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-start border-end px-3 me-3 py-2"> Pay/Salary per month</div>
