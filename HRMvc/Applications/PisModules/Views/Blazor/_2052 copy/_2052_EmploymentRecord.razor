            @*---------------------- Violation Committed --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-start border-end px-3 me-3 py-2"> Violation committed (if any)</div>
                    <div></div>
                </div>
            </div>
          
        </div>



        @*---------------------- Reason for living --------------------*@
        <div class="d-flex align-items-center w-100 px-2 border-top">
            <div class="label border-end pe-3 me-3 py-2"> Reason for living or wanting to leave</div>
            <div></div>
