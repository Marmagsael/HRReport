<div class="card-header">   Personal Data </div>

<div class="card-body">

    <div class="d-flex gap-5">
        @* ----- Birth Date ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Birth Date :</div>
                <div class="line"></div>
                <small class="text-muted">(Month/Day/Year)</small>
            </div>
        </div>

        <div class="w-30">
            @* ----- Sex ----------*@
            <div class="field d-flex  mt-2">
                <div class="label">Sex</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-30">
            @* ----- Weight ----------*@
            <div class="field d-flex  mt-2">
                <div class="label">Weight</div>
                <div class="line"></div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-5">
        @* ----- Religion ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Religion :</div>
                <div class="line"></div>
            </div>
        </div>

        @* ----- Birth Place ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Birth Place :</div>
                <div class="line"></div>
            </div>
        </div>

        @* ----- Blood Type  ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Blood Type :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>


    <div class="d-flex gap-5">
        @* ----- Age ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Age :</div>
                <div class="line"></div>
            </div>
        </div>

        @* ----- Height ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Height :</div>
                <div class="line"></div>
            </div>
        </div>

        @* ----- Citizenship  ----------*@
        <div class="w-30">
            <div class="field d-flex  mt-2">
                <div class="label">Citizenship :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>


    @* ----- Language  ----------*@
    <div class="w-50">
        <div class="field d-flex  mt-2">
            <div class="label">Language / Dialect spoken :</div>
            <div class="line"></div>
        </div>
    </div>

</div>

<div class="card-body border-top">
    <div class="d-flex align-items-center">
        <div class="label">Civil Status</div>

        <div class="d-flex  align-items-center gap-1 w-100 mt-2">
            <div class="field d-flex align-items-center">
                <div class="label p-0 pe-2 w-0">Single</div>
                <RadzenCheckBox Value="true" Disabled />
            </div>

            <div class="field d-flex align-items-center ">
                <div class="label p-0 pe-2 w-0">Married</div>
                <RadzenCheckBox Value="true" Disabled />
            </div>

            <div class="field d-flex align-items-center">
                <div class="label p-0 pe-2 w-0">Window/Widower</div>
                <RadzenCheckBox Value="true" Disabled />
            </div>

            <div class="field d-flex align-items-center">
                <div class="label p-0 pe-2 w-0">Single Parent</div>
                <RadzenCheckBox Value="true" Disabled />
            </div>


        </div>
    </div>
</div>


@code {
    DateTime date = new();
}
