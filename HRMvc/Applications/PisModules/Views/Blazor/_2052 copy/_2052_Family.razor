<div class="card-header">    Spouse <small><em>(if married)</em> </small> </div>

<div class="card-body">
    <div class="border">
        <div class="d-flex gap-2 px-3 py-2 border-bottom fw-bold  bg-lightgray ">
            <div class="w-250p">   Name of Spouse</div>
            <div class="w-250p">   Adress </div>
            <div class="w-250p">   Age  </div>
            <div class="w-250p">   Work  </div>
            <div class="w-250p">   Company Name</div>
        </div>

        <div class="d-flex gap-2 px-3 py-2 ">
            <div class="w-250p">   Name of Spouse</div>
            <div class="w-250p">   Adress </div>
            <div class="w-250p">   Age  </div>
            <div class="w-250p">   Work  </div>
            <div class="w-250p">   Company Name</div>
        </div>

    </div>
</div>






<div class="card-header">    Parents </div>

<div class="card-body">
    <div class="border">
        <div class="d-flex align-items-center px-2 ">
            @*---------------------- Father's Name --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-end pe-3 me-3 py-2 lx-min-w-150p"> Father's Name</div>
                    <div></div>
                </div>
            </div>

            @*---------------------- Mother's Name --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="border-start border-start border-end px-3 me-3 py-2 lx-min-w-150p"> Mother's Name</div>
                    <div></div>
                </div>
            </div>

        </div>


        <div class="d-flex align-items-center px-2 border-top">
            @*---------------------- Father's Job --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-end pe-3 me-3 py-2 lx-min-w-150p"> Work</div>
                    <div></div>
                </div>
            </div>

            @*---------------------- Mother's Job --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-start border-start border-end px-3 me-3 py-2 lx-min-w-150p"> Work</div>
                    <div></div>
                </div>
            </div>

        </div>

        <div class="d-flex align-items-center px-2 border-top">
            @*---------------------- Father's Address --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-end pe-3 me-3 py-2 lx-min-w-150p"> Address</div>
                    <div></div>
                </div>
            </div>

            @*---------------------- Mother's Address --------------------*@
            <div class="w-50">
                <div class="d-flex align-items-center w-100">
                    <div class="label border-start border-end px-3 me-3 py-2 lx-min-w-150p"> Address</div>
                    <div></div>
                </div>
            </div>

        </div>

    </div>

   
</div>


@code {
    DateTime date = new();
}

