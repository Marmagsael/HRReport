<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                type="button" tabindex="6" @onclick="NewEntry">
            New
        </button>
    </div>


    <div class="p-2">
        <div class="card p-0 mb-2">
            <div class="card-header txt-fcolor">
                SEARCH OPTION
            </div>


            <div class="py-2 px-3 d-flex flex-column flex-md-row gap-2">

                @* --- LEFT SIDE: FORM --- *@
                <div class="col-12 col-md-7">

                    @* --- TYPE AND MODEL --- *@
                    <div class="d-flex flex-column flex-md-row gap-2">

                        @* --- Type --- *@
                        <div class="d-flex flex-column flex-md-row mb-2 flex-fill">
                            <label class="fw-normal w-100p">Type</label>

                            <div class="col-12 col-md-7">
                                <TelerikDropDownList Data="@V.OEmpStatuses"
                                                     TextField="Code"
                                                     ValueField="Name"
                                                     @bind-Value="@V.OEmpStatus.Code"
                                                     DefaultText="Select an item..."
                                                     Filterable="true"
                                                     TabIndex="1"
                                                     Width="100%">
                                    <DropDownListSettings>
                                        <DropDownListPopupSettings Height="auto" />
                                    </DropDownListSettings>
                                </TelerikDropDownList>
                            </div>
                        </div>

                        @* --- Model --- *@
                        <div class="d-flex flex-column flex-md-row mb-2 flex-fill">
                            <label class="fw-normal w-100p">Model</label>

                            <div class="col-12 col-md-7">
                                <TelerikDropDownList Data="@V.OEmpStatuses"
                                                     TextField="Code"
                                                     ValueField="Name"
                                                     @bind-Value="@V.OEmpStatus.Code"
                                                     DefaultText="Select an item..."
                                                     Filterable="true"
                                                     TabIndex="2"
                                                     Width="100%">
                                    <DropDownListSettings>
                                        <DropDownListPopupSettings Height="auto" />
                                    </DropDownListSettings>
                                </TelerikDropDownList>
                            </div>
                        </div>

                    </div>

                    @* --- MAKE AND CALIBER --- *@
                    <div class="d-flex flex-column flex-md-row gap-2">

                        @* --- Make --- *@
                        <div class="d-flex flex-column flex-md-row mb-2 flex-fill">
                            <label class="fw-normal w-100p">Make</label>

                            <div class="col-12 col-md-7">
                                <TelerikDropDownList Data="@V.OEmpStatuses"
                                                     TextField="Code"
                                                     ValueField="Name"
                                                     @bind-Value="@V.OEmpStatus.Code"
                                                     DefaultText="Select an item..."
                                                     Filterable="true"
                                                     TabIndex="3"
                                                     Width="100%">
                                    <DropDownListSettings>
                                        <DropDownListPopupSettings Height="auto" />
                                    </DropDownListSettings>
                                </TelerikDropDownList>
                            </div>
                        </div>

                        @* --- Caliber --- *@
                        <div class="d-flex flex-column flex-md-row mb-2 flex-fill">
                            <label class="fw-normal w-100p">Caliber</label>

                            <div class="col-12 col-md-7">
                                <TelerikDropDownList Data="@V.OEmpStatuses"
                                                     TextField="Code"
                                                     ValueField="Name"
                                                     @bind-Value="@V.OEmpStatus.Code"
                                                     DefaultText="Select an item..."
                                                     Filterable="true"
                                                     TabIndex="4"
                                                     Width="100%">
                                    <DropDownListSettings>
                                        <DropDownListPopupSettings Height="auto" />
                                    </DropDownListSettings>
                                </TelerikDropDownList>
                            </div>
                        </div>

                    </div>

                    @* --- DESCRIPTION --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Description</label>

                        <div class="col-12 col-md-10">
                            <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                             Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                             FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                             MaxLength="150"
                                             Width="100%"
                                             TabIndex="5" />
                        </div>
                    </div>

                    @* --- CLIENT --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Client</label>

                        <div class="col-12 col-md-10">
                            <TelerikDropDownList Data="@V.OEmpStatuses"
                                                 TextField="Code"
                                                 ValueField="Name"
                                                 @bind-Value="@V.OEmpStatus.Code"
                                                 DefaultText="Select an item..."
                                                 Filterable="true"
                                                 TabIndex="6"
                                                 Width="100%">
                                <DropDownListSettings>
                                    <DropDownListPopupSettings Height="auto" />
                                </DropDownListSettings>
                            </TelerikDropDownList>
                        </div>
                    </div>

                </div>

                @* --- RIGHT SIDE: GRID --- *@
                <div class="col-12 col-md-5">

                    <TelerikGrid TItem="OClientModel"
                                 SelectionMode="@GridSelectionMode.Single"
                                 Navigable="true"
                                 Pageable="true"
                                 @bind-PageSize="@PageSize"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Height="100%">

                        <GridSettings>
                            <GridPagerSettings PageSizes="@PageSizes" />
                        </GridSettings>

                        <GridColumns>
                            <GridCheckboxColumn SelectAll="false" Width="10px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Status"
                                        Width="80px" />
                        </GridColumns>

                        <NoDataTemplate>
                            <div class="text-center text-secondary p-4">
                                No records found.
                            </div>
                        </NoDataTemplate>

                    </TelerikGrid>

                </div>

            </div>

        </div>

        <TelerikGrid TItem="OClientModel"
                     SelectionMode="@GridSelectionMode.Single"
                     Navigable="true"
                     Pageable="true"
                     @bind-PageSize="@PageSize"
                     Sortable="true"
                     FilterMode="@GridFilterMode.FilterMenu"
                     Height="calc(100vh - 45vh)">

            <GridSettings>
                <GridPagerSettings PageSizes="@PageSizes" />
            </GridSettings>

            <GridColumns>
                @* --- MODEL --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Model"
                            Width="80px" />

                @* --- MAKE --- *@
                <GridColumn Field="@nameof(OClientModel.Status)"
                            Title="Make"
                            Width="80px"
                            HeaderClass="text-center" />

                @* --- CALIBER --- *@
                <GridColumn Field="@nameof(OClientModel.Status)"
                            Title="Caliber"
                            Width="80px"
                            HeaderClass="text-center" />

                @* --- DESCRIPTION --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Description"
                            Width="200px" />

                @* --- QTY --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Qty."
                            Width="80px" />

                @* --- STATUS --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Status"
                            Width="80px" />

                @* --- DEPLOYMENT --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Deployment"
                            Width="80px" />
            </GridColumns>

            <NoDataTemplate>
                <div class="text-center text-secondary p-4">
                    No records found.
                </div>
            </NoDataTemplate>

        </TelerikGrid>
    </div>




</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2404Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        V.ModalCaption = "Inventory Entry";
        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

}

