<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="5" @onclick="OpenSearchEmployeeModal">
           Search Employee
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="5">
            Change Status
        </button>

    </div>
</div>

<div class="px-2 ps-md-3 pt-3">

    <div class="card py-2  px-3 mb-2">
        @* --- Empnumber --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Emp. No.</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpNumber"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid">
                    <TextBoxSuffixTemplate>
                        <TelerikFontIcon Icon="@FontIcon.Search" Size="@ThemeConstants.FontIcon.Size.Small" />
                    </TextBoxSuffixTemplate>
                </TelerikTextBox>
            </div>
        </div>


        @* --- Emp Name --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Name</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>

        @* --- Lic. # --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Lic. #</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.SecLicense"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>


        @* --- Lic. Expiration --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Lic. Expiration</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.Licexpire"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   ReadOnly
                                   Enabled="false" />
            </div>
        </div>


        @* -- Client --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Client</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.ClName"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>


        @* -- Date Resigned --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Date Resigned</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.Separate"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   ReadOnly
                                   Enabled="false" />
            </div>
        </div>




        @* -- Reason --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Reason</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Reason"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />


            </div>
        </div>

    </div>


    <div class="card py-2  px-3 mb-2">
        @* -- Curren Status --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Current Status</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpStatus"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />


            </div>
        </div>

        @* -- New Empstat --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Change To</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikDropDownList Data="@V.OEmpStatuses"
                                     TextField="Name"
                                     ValueField="Code"
                                     @bind-Value="@V.NewStatus"
                                     DefaultText="Select new employee status..."
                                     Filterable="true"
                                     TabIndex="1"
                >

                    <DropDownListSettings>
                        <DropDownListPopupSettings Height="auto" />
                    </DropDownListSettings>

                </TelerikDropDownList>

              

            </div>
        </div>
    </div>





    <div class="card py-2 px-3 mb-2">
        @* -- Status Remarks --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Status Remarks</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                 Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                 FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                 MaxLength="150"
                                 Width="100%" />
            </div>

            <div class="ms-md-2 mt-2 mt-md-0 d-flex align-items-center">
                <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue text-nowrap"
                        type="button"
                        tabindex="5">
                    Save Remarks
                </button>
            </div>
        </div>
    </div>
</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2302Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }


    private async Task OpenSearchEmployeeModal()
    {
        V.ShowSearchModal = true;
        V.ModalCaption = "Search Employee";
        await ChildAction.InvokeAsync();
    }
}
