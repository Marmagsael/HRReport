@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis


@inject IAtttemplateDataAccess _atttemplate

<div class="employee-list h-100 d-flex flex-column">

  
    <TelerikGrid TItem="OEmpmasModel"
                 @ref="EmployeeAssignedGrid"
                 Data="@V.AssignedEmployees"
                 OnRowClick="@OnRowClick"
                 OnRowRender="@OnRowRender"
                 SelectionMode="@GridSelectionMode.Multiple"
                 SelectedItems="@SelectedEmployees"
                 SelectedItemsChanged="@OnSelectedEmployeesChanged"
                 Pageable="true"
                 @bind-Page="@CurrentPage"
                 @bind-PageSize="@PageSize"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Sortable="true"
                 Resizable="true"
                 Navigable="true"
                 Width="100%"
                 Height="100%">

        @* =====================================================
           GRID SETTINGS / PAGINATION
           ===================================================== *@
        <GridSettings>

            <GridPagerSettings InputType="@PagerInputType.Input"
                               PageSizes="@PageSizes"
                               Responsive="true" />

        </GridSettings>


        <GridColumns>

            @* =================================================
               CHECKBOX COLUMN
               ================================================= *@
            <GridCheckboxColumn SelectAll="true"
                                SelectAllMode="@GridSelectAllMode.Current"
                                Width="50px" />


            @* =================================================
               EMPLOYEE NAME
               ================================================= *@
            <GridColumn Field="@nameof(OEmpmasModel.Fullname)"
                        Title="Employee Name">

                <Template>

                    @{
                        var employee = (OEmpmasModel)context;
                    }

                    <div class="employee-name-cell">

                        <div>
                            @employee.Fullname
                        </div>

                        @if (employee.UserId == 0)
                        {
                            <div class="no-login-message">
                                User has no login credentials yet
                            </div>
                        }

                    </div>

                </Template>

            </GridColumn>

        </GridColumns>


        @* =========================================================
           NO DATA MESSAGE
           ========================================================= *@
        <NoDataTemplate>

            <div class="text-center text-secondary p-3">

                @if (V.SelectedPayrollGroup <= 0)
                {
                    <div>
                        Select a payroll group to see assigned employees.
                    </div>
                }
                else if (HasActiveFilter)
                {
                    <div>
                        No employees match the current filter.
                    </div>

                    <div class="k-font-size-sm">
                        Clear the column filter to see everyone.
                    </div>
                }
                else
                {
                    <div>
                        No one is assigned to this group yet.
                    </div>
                }

            </div>

        </NoDataTemplate>

    </TelerikGrid>

</div>


@code {

    [CascadingParameter]
    public UserClaimsModel? Uc { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public V2004Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OEmpmasModel>? EmployeeAssignedGrid;

    private int CurrentPage { get; set; } = 1;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        10,
        25,
        50,
        100,
        null
    };

    private List<OEmpmasModel?> SelectedEmployees { get; set; } = new();

    private bool IgnoreNextSelectionChanged { get; set; }

    private bool HasActiveFilter => EmployeeAssignedGrid?.GetState().FilterDescriptors?.Any() == true;

    private void OnRowRender(GridRowRenderEventArgs args)
    {
        var employee = (OEmpmasModel)args.Item;

        if (employee.UserId <= 0)
        {
            args.Class = "row-disabled";
        }
    }

    private async Task OnRowClick(GridRowClickEventArgs args)
    {
        var employee = (OEmpmasModel)args.Item;

        if (employee.UserId <= 0)
        {
            args.ShouldRender = false;
            return;
        }

        var alreadySelected = SelectedEmployees.Any(x => x.UserId == employee.UserId);

        IgnoreNextSelectionChanged = true;

        if (alreadySelected)
        {
            SelectedEmployees = SelectedEmployees
                .Where(x => x.UserId != employee.UserId)
                .ToList();
        }
        else
        {
            SelectedEmployees = SelectedEmployees
                .Concat(new[] { employee })
                .ToList();
        }

        await ProcessSelectedEmployees();

        args.ShouldRender = true;

    }

    private async Task OnSelectedEmployeesChanged(IEnumerable<OEmpmasModel?> employees)
    {
        if (IgnoreNextSelectionChanged)
        {
            IgnoreNextSelectionChanged = false;
            return;
        }

        SelectedEmployees = employees.Where(x => x.UserId > 0).ToList();

        await ProcessSelectedEmployees();
    }

    private async Task ProcessSelectedEmployees()
    {
        var lastEmployee = string.Empty;

        try
        {
            var selectedEmployees = SelectedEmployees
                .Where(x => x.UserId > 0)
                .ToList();

            V.SelectedEmployee = string.Empty;
            V.CurrentAttendance = new AtttemplateModel();
            V.SelectedAssignedEmployees = [];

            V.SelectedAssignedEmployees = selectedEmployees;

            if (!selectedEmployees.Any())
            {
                await ChildAction.InvokeAsync();
                return;
            }

            var employee = selectedEmployees.LastOrDefault();

            if (employee == null)
            {
                await ChildAction.InvokeAsync();
                return;
            }

            lastEmployee = employee.Fullname ?? "-";

            if (Uc == null)
            {
                NotificationRef?.Show(
                    "User information is unavailable.",
                    ThemeConstants.Notification.ThemeColor.Error);

                return;
            }

            var result = await _atttemplate._02(
                employee.UserId,
                Uc.SchemaUserPis,
                V.conn);

            var schedule = new AtttemplateModel
            {
                EmpmasId = 0,
                AttendancetypeId = 0,

                D1_in = 0,
                D1_hrslength = 0,
                D1_dutytype = "-",

                D2_in = 0,
                D2_hrslength = 0,
                D2_dutytype = "-",

                D3_in = 0,
                D3_hrslength = 0,
                D3_dutytype = "-",

                D4_in = 0,
                D4_hrslength = 0,
                D4_dutytype = "-",

                D5_in = 0,
                D5_hrslength = 0,
                D5_dutytype = "-",

                D6_in = 0,
                D6_hrslength = 0,
                D6_dutytype = "-",

                D7_in = 0,
                D7_hrslength = 0,
                D7_dutytype = "-",

                Attendancetype = "-"
            };

            if (result != null && result.EmpmasId > 0)
            {
                schedule = result;
            }

            V.SelectedEmployee = employee.Fullname;
            V.CurrentAttendance = schedule;

            await ChildAction.InvokeAsync();
        }
        catch
        {
            NotificationRef?.Show(
                $"Couldn't get the current schedule of {lastEmployee}",
                ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    public async Task ResetGrid()
    {
        SelectedEmployees = [];
        IgnoreNextSelectionChanged = false;
        CurrentPage = 1;

        V.SelectedEmployee = string.Empty;
        V.CurrentAttendance = new AtttemplateModel();

        if (EmployeeAssignedGrid == null)
            return;

        var state = EmployeeAssignedGrid.GetState();

        state.FilterDescriptors.Clear();
        state.SortDescriptors.Clear();
        state.Page = CurrentPage;
        state.SelectedItems = new List<OEmpmasModel>();

        await EmployeeAssignedGrid.SetStateAsync(state);
    }

    public async Task UnselectAllEmployees()
    {
        await ResetGrid();
    }

}

<style>

    .employee-list {
        width: 100%;
    }


    .employee-name-cell {
        width: 100%;
        cursor: pointer;
        user-select: none;
    }


    .no-login-message {
        font-size: 11px;
        color: #999;
    }


    .row-disabled {
        pointer-events: none;
        opacity: 0.5;
        cursor: not-allowed;
    }

</style>
