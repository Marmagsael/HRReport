<TelerikCard Width="100%" Class="mt-3">
    <CardHeader Class="bg-secondary bg-opacity-10">
        <div class="d-flex align-items-center gap-2">
            <TelerikFontIcon Icon="@FontIcon.InfoCircle" />
            <span class="fw-semibold">Duty type reference</span>
        </div>
    </CardHeader>

    <CardBody Class="p-2">
        <div class="d-flex flex-column gap-2 small">
            <div class="d-flex gap-2 align-items-start">
                <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Info"
                              Position="@BadgePosition.Inline"
                              Rounded="@ThemeConstants.Badge.Rounded.Medium"
                              Size="@ThemeConstants.Badge.Size.Small"
                              FillMode="@ThemeConstants.Badge.FillMode.Outline"
                              Class="note-code">
                    R
                </TelerikBadge>
                <span>Regular day</span>
            </div>

            <div class="d-flex gap-2 align-items-start">
                <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Error"
                              Position="@BadgePosition.Inline"
                              Rounded="@ThemeConstants.Badge.Rounded.Medium"
                              Size="@ThemeConstants.Badge.Size.Small"
                              FillMode="@ThemeConstants.Badge.FillMode.Outline"
                              Class="note-code">
                    RD
                </TelerikBadge>
                <span>Rest day</span>
            </div>

            <div class="d-flex gap-2 align-items-start">
                <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Warning"
                              Position="@BadgePosition.Inline"
                              Rounded="@ThemeConstants.Badge.Rounded.Medium"
                              Size="@ThemeConstants.Badge.Size.Small"
                              FillMode="@ThemeConstants.Badge.FillMode.Outline"
                              Class="note-code">
                    RN
                </TelerikBadge>
                <span>Regular non-working day — not required to work, but paid regular rate when on duty.</span>
            </div>
        </div>
    </CardBody>
</TelerikCard>

<style>
    .note-code {
        min-width: 34px;
        justify-content: center;
        flex: 0 0 auto;
    }
</style>
