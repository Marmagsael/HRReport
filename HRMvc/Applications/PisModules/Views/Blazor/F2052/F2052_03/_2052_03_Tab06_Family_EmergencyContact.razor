@using HRApiLibrary.DataAccess._10_Pis.Interface
@inject NotificationService _NotificationService;
@inject DialogService _DialogService;
@inject I_10_EmpmasDataAccess _empmas;

<div class="p-2">
    @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
    {
        <div class="p-2 bordered mb-2 w-100">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Text="New Entry" Click="@InsertRow" Disabled="@(editMode || isLoading)" class="bg-primary-green" />
        </div>
    }

    <div class="custom-grid mt-2">
        <RadzenDataGrid Data="@V.EmergencyContacts"
                        TItem="OEmergencModel"
                        @ref="V.EmergencyContactGrid"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        ColumnWidth="200px"
                        IsLoading="isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="OEmergencModel"
                                      Context="OEmergencModel"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="100%">
                    <HeaderTemplate>
                        <RadzenRow Gap="0" Style="padding-inline-end:1rem;">
                            <RadzenColumn Size="5" class="custom-grid-sm">Details</RadzenColumn>
                            <RadzenColumn Size="7" class="custom-grid-md">Name</RadzenColumn>
                            <RadzenColumn Size="5" class="custom-grid-md">Relationship</RadzenColumn>
                        </RadzenRow>
                    </HeaderTemplate>

                    <Template Context="rec">
                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Name" Component="Name" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Name" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Relationship" Component="Relationship" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Rela" Disabled="true" MaxLength="20" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Address" Component="Addr" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Addr" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Tel No." Component="TelNo" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Tel" Disabled="true" MaxLength="15" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow>
                                <RadzenColumn Size="7">
                                    <div>@rec.Name</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                Address: <span class="text-muted text-decoration-underline" style="word-break: break-word; white-space: normal;">@rec.Addr</span>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="5">
                                    <div class="fw-bold">@rec.Rela</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            @if (rec.Tel is not null && rec.Tel.Length > 0)
                                            {
                                                <RadzenColumn Size="12">
                                                    Tel No.: <span class="text-muted text-decoration-underline">@rec.Tel</span>
                                                </RadzenColumn>
                                            }
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </Template>

                    <EditTemplate Context="rec">
                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Name" Component="NameSm" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Name" Change="@(args => rec.Name = args.ToString().Trim())" class="w-100" Name="NameSm" MaxLength="60" />
                                        <RadzenRequiredValidator Component="NameSm" Text="Name is required" Popup="true" Style="position: absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Relationship" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Rela" Change="@(args => rec.Rela = args.ToString().Trim())" class="w-100" Name="RelSm" MaxLength="20" />
                                        <RadzenRequiredValidator Component="RelSm" Text="Relationship is required" Popup="true" Style="position: absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Address" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Addr" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Telephone No." /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Tel" class="w-100" MaxLength="15" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow Gap=".3rem">
                                <RadzenColumn Size="7">
                                    <RadzenTextBox @bind-Value="rec.Name" Change="@(args => rec.Name = args.ToString().Trim())" class="w-100" Name="NameLg" MaxLength="60" Style="display: block" />
                                    <RadzenRequiredValidator Component="NameLg" Text="Name is required" Popup="true" Style="position: absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Address" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Addr" class="w-100" MaxLength="60" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="5">
                                    <RadzenTextBox @bind-Value="rec.Rela" Change="@(args => rec.Rela = args.ToString().Trim())" class="w-100" Name="RelLg" MaxLength="20" Style="display: block" />
                                    <RadzenRequiredValidator Component="RelLg" Text="Relationship is required" Popup="true" Style="position: absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Tel No." Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Tel" class="w-100" MaxLength="15" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* Actions Column *@
                <RadzenDataGridColumn TItem="OEmergencModel" Context="OEmergencModel" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Title="Actions" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="120px">
                    <Template Context="rec">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditRow(rec))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                    <EditTemplate Context="rec">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@((args) => SaveRow(rec))"></RadzenButton>
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@((args) => CancelEdit(rec))" Size="ButtonSize.Small" class="my-1 ms-1"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(rec))" class="my-1 ms-1"></RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@inject IOEmergencDataAccess _empmas;

@code {

    string? empnumber = string.Empty;

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    List<OEmergencModel?>? emergencycontactToInsert = new();
    List<OEmergencModel?>? emergencycontactToUpdate = new();
    string? errorMsg = string.Empty;
    bool isLoading = true;
    bool editMode = false;

    OEmergencModel? recBackup;



    protected override async Task OnParametersSetAsync()
    {
        if (empnumber != V.SelectedEmpnumber)
        {
            empnumber = V.SelectedEmpnumber;
            await Task.Delay(250);
            V.EmergencyContacts = await _empmas._02(V.SelectedEmpnumber, V.pisdb!, V.conn!) ?? new();
        }
        isLoading = false;
        StateHasChanged();
    }

    //-- InsertRow ----------------
    private async Task InsertRow()
    {
        errorMsg = string.Empty;
        Reset();

        var rec = new OEmergencModel();
        rec.EmpNumber = V.SelectedEmpnumber;

        V.EmergencyContacts ??= new();
        V.EmergencyContacts.Insert(0, rec);
        emergencycontactToInsert!.Add(rec);
        await V.EmergencyContactGrid!.InsertRow(rec);
        editMode = true;
    }

    //-- Reset ----------------
    private void Reset()
    {
        emergencycontactToInsert!.Clear();
        emergencycontactToUpdate!.Clear();
    }

    //-- Reset ----------------
    private void Reset(OEmergencModel rec)
    {
        emergencycontactToInsert!.Remove(rec);
        emergencycontactToUpdate!.Remove(rec);
    }

    //-- Edit Row ----------------
    private async Task EditRow(OEmergencModel rec)
    {
        editMode = true;

        if (V.EmergencyContactGrid != null)
        {
            Reset();
            emergencycontactToUpdate?.Add(rec);

            recBackup = new OEmergencModel
            {
                EmpNumber = rec.EmpNumber,
                Name = rec.Name,
                Rela = rec.Rela,
                Addr = rec.Addr,
                Tel = rec.Tel
            };

            await V.EmergencyContactGrid.EditRow(rec);
        }
    }

    //-- Delete Row ----------------
    private async Task DeleteRow(OEmergencModel rec)
    {
        if (V.EmergencyContacts == null) return;
        if (V.EmergencyContactGrid == null) return;

        Reset(rec);

        if (V.EmergencyContacts.Contains(rec))
        {
            if (rec != null)
            {
                var option = await _DialogService.Confirm($"Delete {rec.Name}'s record?", "Confirm Delete",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
                if (option == true)
                {
                    await _empmas._04(rec.EmpNumber, rec.Name, rec.Rela, V.pisdb!, V.conn!);
                    V.EmergencyContacts.Remove(rec);
                    ShowSuccess("Successfully deleted", "Record has been successfully deleted.", 4000);
                }
            }
        }
        else
        {
            V.EmergencyContactGrid.CancelEditRow(rec);
        }
        await V.EmergencyContactGrid.Reload();
        editMode = false;
        errorMsg = string.Empty;
    }


    //-- Cancel Edit ----------------
    private async Task CancelEdit(OEmergencModel rec)
    {
        errorMsg = string.Empty;
        if (V.EmergencyContactGrid == null) return;

        bool isNew = emergencycontactToInsert!.Contains(rec);

        Reset(rec);
        editMode = false;

        if (isNew)
        {
            V.EmergencyContacts?.Remove(rec);
        }
        else if (recBackup != null)
        {
            rec.Name = recBackup.Name;
            rec.Rela = recBackup.Rela;
            rec.Addr = recBackup.Addr;
            rec.Tel = recBackup.Tel;
        }

        V.EmergencyContactGrid.CancelEditRow(rec);
        recBackup = null;

        await V.EmergencyContactGrid.Reload();
    }

    //-- Save Row ----------------
    private async Task SaveRow(OEmergencModel rec)
    {
        if (V.EmergencyContactGrid == null || rec == null) return;
        if (!SafeToSave(rec))
        {
            await V.EmergencyContactGrid.UpdateRow(rec);
            return;
        }
        try
        {
            bool isNew = emergencycontactToInsert!.Contains(rec);
            var res = await _empmas._02CheckExisting(rec.EmpNumber, rec.Name, rec.Rela, V.pisdb!, V.conn!);
            bool exists = res != null && res.Count > 0;

            if (exists)
            {
                bool isSameAsOriginal = !isNew && recBackup != null
                && recBackup.Name == rec.Name
                && recBackup.Rela == rec.Rela;

                if (!isSameAsOriginal)
                {
                    ShowError("Duplicate entry", "A record with the same name and relationship already exists.", 5000);
                    return;
                }
            }

            if (isNew)
            {
                await _empmas._01(rec, V.pisdb!, V.conn!);
                V.EmergencyContacts = await _empmas._02(V.SelectedEmpnumber, V.pisdb!, V.conn!) ?? new();
            }
            else
            {
                await _empmas._03(rec.EmpNumber, rec.Name, rec.Rela, rec, V.pisdb!, V.conn!);
                V.EmergencyContactGrid.CancelEditRow(rec);
            }

            Reset(rec);
            await V.EmergencyContactGrid.Reload();
            ShowSuccess("Successfully saved", "Record has been successfully saved.", 4000);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to save", "Something went wrong while saving. Please try again.", 6000);
            return;
        }

        recBackup = null;
        editMode = false;
        errorMsg = string.Empty;
    }



    //-- Safe to Save ----------------
    private bool SafeToSave(OEmergencModel rec)
    {
        if (string.IsNullOrWhiteSpace(rec.Name)) return false;
        if (string.IsNullOrWhiteSpace(rec.Rela)) return false;
        return true;
    }

    void ShowSuccess(string summary, string detail, int duration = 5000) =>
      _NotificationService.Notify(new NotificationMessage
      {
          Severity = NotificationSeverity.Success,
          Summary = summary,
          Detail = detail,
          Duration = duration
      });

    void ShowError(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });
}



  
