@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject NotificationService _NotificationService;
@inject DialogService _DialogService;

<style>
    .s222-t1-lbl-01 {
        color: darkgreen;
        width: 20%;
    }
</style>


<div class="p-2 overflow-auto" style="height:49.5vh;">
    <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Government" />

    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>
        <div class="h-10p"></div>
        @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
        {
            <div class="p-2 bordered mb-2 w-100">
                <input class="btn btn-secondary bg-primary-green w-100p" type="submit" value="Save" />
            </div>
        }
        <RadzenFieldset>

            <div class="h-10p"></div>
            <RadzenFieldset Text="******">
                @* ----- Sss ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="s222-t1-lbl-01">SSS </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Sss class="form-control" Name="Sss" MaxLength="12" Placeholder="SSS" />
                        <RadzenRequiredValidator Component="Sss" Text="SSS is required" Style="color: red; display:block" />
                    </div>
                </div>

                @* ----- Tin ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20 s222-t1-lbl-01">TIN </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Tin class="form-control" Name="Tin" MaxLength="15" Placeholder="TIN" />
                        <RadzenRequiredValidator Component="Tin" Text="TIN is required" Style="color: red; display:block" />
                    </div>
                </div>
            </RadzenFieldset>

            <div class="h-10p"></div>
            <RadzenFieldset Text="******">
                @* ----- PagIbigNo ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">PAG-IBIG No. </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.PagIbigNo class="form-control" Name="PagIbigNo" MaxLength="12" Placeholder="PAG-IBIG No." />
                        <RadzenRequiredValidator Component="PagIbigNo" Text="PAG-IBIG No. is required" Style="color: red; display:block" />
                    </div>
                </div>

                @* ----- Phic ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">PhilHealth No. </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Phic class="form-control" Name="Phic" MaxLength="12" Placeholder="PhilHealth No." />
                        <RadzenRequiredValidator Component="Phic" Text="PhilHealth No. is required" Style="color: red; display:block" />
                    </div>
                </div>

                @* ----- Hdmf ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">HMDF </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Hdmf class="form-control" Name="Hdmf" MaxLength="12" Placeholder="HMDF" />
                    </div>
                </div>
            </RadzenFieldset>

            <div class="h-10p">&nbsp</div>
            <RadzenFieldset Text="******">
                @* ----- Drv_License ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">Driver's License </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Drv_License class="form-control" Name="DrvLicense" MaxLength="20" Placeholder="Driver's License" />
                    </div>
                </div>

                @* ----- Drv_Exp (date) ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">Drv Lic Expiration </div>
                    <div class="w-40">
                        <RadzenDatePicker @bind-Value=@V.Empmas.Drv_Exp Name="DrvExp" DateFormat="MM/dd/yyyy" />
                    </div>
                </div>
            </RadzenFieldset>

            <div class="h-10p">&nbsp</div>
            <RadzenFieldset Text="******">
                @* ----- AcctCode ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">Bank Account No. </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.AcctCode class="form-control" Name="AcctCode" MaxLength="20" Placeholder="Bank Account No." />
                    </div>
                </div>

                @* ----- Bank ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">Bank/Branch </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.Bank class="form-control" Name="Bank" MaxLength="50" Placeholder="Bank/Branch" />
                    </div>
                </div>

                @* ----- TaxCode ----------*@
                <div class="w-100 d-flex p-1">
                    <div class="w-20">Tax Table Code </div>
                    <div class="w-40">
                        <RadzenTextBox @bind-Value=@V.Empmas.TaxCode class="form-control" Name="TaxCode" MaxLength="10" Placeholder="Tax Table Code" />
                    </div>
                </div>
            </RadzenFieldset>

        </RadzenFieldset>
    </RadzenTemplateForm>

</div>

@inject IOEmpmasDataAccess _empmas

@code {
    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    async Task OnSubmit(OEmpmasModel model)
    {
        if (model == null) return;
        try
        {
            await _empmas._03_Government(V.SelectedEmpnumber, V.Empmas, V.pisdb, V.conn);

            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Successfully saved",
                Detail = "Record has been successfully saved.",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Unable to save",
                Detail = "Something went wrong while saving. Please try again.",
                Duration = 6000
            });
        }
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {

    }
}
