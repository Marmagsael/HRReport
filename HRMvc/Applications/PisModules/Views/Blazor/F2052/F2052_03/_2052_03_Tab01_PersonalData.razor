@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._00_MainPis
@using HRApiLibrary.Models._10_Pis


<div class="p-2">
    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>
        @* -- Title, Save below it on the left, then the fields in two columns; the box grows with the tab (no inner scroll) -- *@
        <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Personal Data" />

        @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
        {
            <div class="d-flex p-2 border-bottom">
                <button type="submit" class="card text-center h-40p mb-btn mb-btn-blue p-2 px-4">
                    <div class="d-flex gap-1 align-items-center justify-content-center">
                        <span class="fw-semibold"><small>Save</small></span>
                    </div>
                </button>
            </div>
        }

            <div class="d-flex flex-wrap column-gap-4 pt-2">
                <div class="d-flex flex-column" style="flex:1 1 400px; min-width:0;">
                    @* ----- EmpBirth (date) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Date of Birth</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenDatePicker @bind-Value=@V.Empmas.EmpBirth Change=@OnBirthChanged TValue="DateTime?" Name="DPEmpBirth" DateFormat="MMMM dd, yyyy" Style="width:100%" />
                            <RadzenRequiredValidator Component="DPEmpBirth" Text="Date of Birth is required" Style="color: red; display:block" />
                        </div>
                    </div>
                    @* ----- BirthPlace (varchar(75)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Birth Place</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.BirthPlace class="form-control" Name="BirthPlace" MaxLength="75" Style="width:100%" />
                            <RadzenRequiredValidator Component="BirthPlace" Text="Birth of Place is required" Style="color: red; display:block" />
                        </div>
                    </div>
                    @* ----- Sex_ (varchar(1)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Gender</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenDropDown TValue="string" @bind-Value=@V.Empmas.Sex_ Data=@V.OGenders TextProperty="Name" ValueProperty="Code" Style="width:100%;" Name="ddSex" />
                            <RadzenRequiredValidator Component="ddSex" Text="Gender is required" Style="color: red; display:block" />
                        </div>
                    </div>
                    @* ----- CivStat_ (varchar(1)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Civil Status</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenDropDown TValue="string" @bind-Value=@V.Empmas.CivStat_ Data=@V.OCivStats TextProperty="Name" ValueProperty="Code" Style="width:100%;" Name="ddCivStat" />
                            <RadzenRequiredValidator Component="ddCivStat" Text="Civil Status is required" Style="color: red; display:block" />
                        </div>
                    </div>
                    @* ----- Citizen (varchar(15)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Citizenship</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Citizen Name="Citizenship" MaxLength="15" class="form-control" Style="width:100%" />
                            <RadzenRequiredValidator Component="Citizenship" Text="Citizenship is required" Style="color: red; display:block" />
                        </div>
                    </div>
                    @* ----- Religion (varchar(35)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Religion</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox MaxLength="35" @bind-Value=@V.Empmas.Religion class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Height (feet + inches) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Height</div>
                        <div style="flex:1; max-width:420px;">
                            <div class="d-flex align-items-center gap-1">
                                <RadzenNumeric Placeholder="0" Step="1" @bind-Value=@V.Empmas.HeightFt TextAlign="TextAlign.Right" Max="99" Style="width:60px" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                                <span class="small">Feet</span>
                                <RadzenNumeric Placeholder="0" Step="1" @bind-Value=@V.Empmas.HeightInches TextAlign="TextAlign.Right" Style="width:60px" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                                <span class="small">Inches</span>
                            </div>
                        </div>
                    </div>
                    @* ----- Weight (double(6,2)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Weight</div>
                        <div style="flex:1; max-width:420px;">
                            <div class="d-flex align-items-center gap-1">
                                <RadzenNumeric TValue="double?" @bind-Value="V.Empmas.Weight" Min="0" Max="9999" Style="width:100px" Format="#,##0.00" Placeholder="0" TextAlign="Radzen.TextAlign.End" />
                                <span class="small">lbs</span>
                            </div>
                        </div>
                    </div>
                    @* ----- Age ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Age</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value="V.Empmas.Age" Disabled class="form-control" Style="width:60px" />
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-column" style="flex:1 1 400px; min-width:0;">
                    @* ----- Hair (varchar(5)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Hair Color</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox MaxLength="5" @bind-Value=@V.Empmas.Hair class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Eyes (varchar(5)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Eyes Color</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Eyes MaxLength="5" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Complexion (varchar(10)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Complexion</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Complexion MaxLength="10" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Marks (varchar(60)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Marks</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Marks MaxLength="60" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- BloodType (varchar(10)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Blood Type</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.BloodType MaxLength="10" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Spouse (varchar(25)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Spouse Name</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Spouse MaxLength="25" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- Occupation (varchar(75)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">Spouse Occupation</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenTextBox @bind-Value=@V.Empmas.Occupation MaxLength="75" class="form-control" Style="width:100%" />
                        </div>
                    </div>
                    @* ----- NoChildren (double(2,0)) ----------*@
                    <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
                        <div class="small" style="width:160px; flex-shrink:0;">No of Children</div>
                        <div style="flex:1; max-width:420px;">
                            <RadzenNumeric Placeholder="0" Step="1" Max="99" @bind-Value=@V.Empmas.NoChildren Style="width:60px" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                        </div>
                    </div>
                </div>
            </div>
    </RadzenTemplateForm>

</div>


@inject IOEmpmasDataAccess _empmas
@inject I_10_EmpmasDataAccess _pisEmpmas

@code {

    
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();


    [CascadingParameter]
    public V2052 V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }

    async Task OnSubmit(OEmpmasModel model)
    {
        if (model == null) return;

        V.Action = "ComputeEmployeesAge";
        await ChildAction.InvokeAsync();


        try
        {
            V.Empmas.Height =  CombineHeight();

            var res = await _empmas._03_PersonalData(V.SelectedEmpnumber, V.Empmas, Uc.OpisDb, Uc.Conn);

            await SavePisEmpmasPI();

            V.Empmas.Height = res.Height;
            V.Action = "GetGenderAndCivilStatus_SplitHeight";
            NotificationRef.Show("Record has been successfully saved.", ThemeConstants.Notification.ThemeColor.Success);

            await ChildAction.InvokeAsync();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }


    }

    // -- Same data to the new PIS : Empmas (link by EmpNumber) + EmpmasPI; insert when missing, otherwise update --
    async Task SavePisEmpmasPI()
    {
        var schema  = Uc.SchemaUserPis;
        var empno   = V.SelectedEmpnumber;

        var empmas = await _pisEmpmas._02EmpmasInternalByEmpNumber(empno, schema, Uc.Conn);
        if (empmas == null)
        {
            await _pisEmpmas._01EmpmasInternal(new EmpmasInternalModel
            {
                EmpNumber   = empno,
                EmpLastNm   = V.Empmas.EmpLastNm,
                EmpFirstNm  = V.Empmas.EmpFirstNm,
                EmpMidNm    = V.Empmas.EmpMidNm,
                Suffix      = V.Empmas.Suffix ?? "",
                EmpAlias    = V.Empmas.EmpAlias,
            }, schema, Uc.Conn);
            empmas = await _pisEmpmas._02EmpmasInternalByEmpNumber(empno, schema, Uc.Conn);
        }
        if (empmas?.Id == null) throw new InvalidOperationException($"PIS Empmas for {empno} could not be created.");

        var pi = new EmpmasPIModel
        {
            Id          = empmas.Id,
            EmpBirth    = V.Empmas.EmpBirth ?? default,
            BirthPlace  = V.Empmas.BirthPlace,
            Sex_        = V.Empmas.Sex_,
            CivStat_    = V.Empmas.CivStat_,
            Citizen     = V.Empmas.Citizen,
            Religion    = V.Empmas.Religion,
            Height      = V.Empmas.HeightFt,
            HeightInch  = (int?)V.Empmas.HeightInches,
            Weight      = V.Empmas.Weight,
            Hair        = V.Empmas.Hair,
            Eyes        = V.Empmas.Eyes,
            Complexion  = V.Empmas.Complexion,
            Marks       = V.Empmas.Marks,
            BloodType   = V.Empmas.BloodType,
            Spouse      = V.Empmas.Spouse,
            Occupation  = V.Empmas.Occupation,
            NoChildren  = (int?)V.Empmas.NoChildren,
        };

        if (await _pisEmpmas._02EmpmasPI(empmas.Id, schema, Uc.Conn) == null)
            await _pisEmpmas._01EmpmasPI(empmas.Id, pi, schema, Uc.Conn);
        else
            await _pisEmpmas._03EmpmasPI(empmas.Id, pi, schema, Uc.Conn);
    }

    // -- Age follows Date of Birth (computed by the parent, same as on Save) --
    async Task OnBirthChanged(DateTime? value)
    {
        V.Action = "ComputeEmployeesAge";
        await ChildAction.InvokeAsync();
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {

    }

    private double CombineHeight()
    {
        if (V.Empmas.HeightFt == null || V.Empmas.HeightInches == null)
            return 0.00;

        return V.Empmas.HeightFt.Value + (V.Empmas.HeightInches.Value / 100.0);
    }

}