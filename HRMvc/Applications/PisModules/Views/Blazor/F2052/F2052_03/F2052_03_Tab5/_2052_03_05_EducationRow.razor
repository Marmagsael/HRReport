<RadzenRow Gap="0.5rem" AlignItems="AlignItems.Start" Style="padding: 8px 0; border-bottom: 1px solid #f0f0f0;">
    <RadzenColumn Size="12" SizeMD="2" class="fw-bold small op-80">@Label</RadzenColumn>
    <RadzenColumn Size="12" SizeMD="10">
        <RadzenRow RowGap="0.5rem">

            <RadzenColumn Size="12">
                <RadzenFormField AllowFloatingLabel="false" Text="School Name" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-md-none">
                    <RadzenTextBox @bind-Value="Rec.School" Style="width:100%;" MaxLength="30" />
                </RadzenFormField>
                <RadzenFormField AllowFloatingLabel="false" Text="School Name" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-none d-md-block">
                    <RadzenTextBox @bind-Value="Rec.School" Style="width:100%;" MaxLength="30" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenFormField AllowFloatingLabel="false" Text="Course" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-md-none">
                    <RadzenTextBox @bind-Value="Rec.Course" Style="width:100%;" MaxLength="75" />
                </RadzenFormField>
                <RadzenFormField AllowFloatingLabel="false" Text="Course" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-none d-md-block">
                    <RadzenTextBox @bind-Value="Rec.Course" Style="width:100%;" MaxLength="75" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field">
                    <RadzenTextBox @bind-Value="@Rec.From_" Style="width:100%;" MaxLength="10" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field">
                    <RadzenTextBox @bind-Value="@Rec.To_" Style="width:100%;" MaxLength="10" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenFormField AllowFloatingLabel="false" Text="Remarks" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-md-none">
                    <RadzenDropDown TValue="string"
                                    @bind-Value="Rec.Level"
                                    Data="@RemarksOptions"
                                    Style="width:100%;" />
                </RadzenFormField>
                <RadzenFormField AllowFloatingLabel="false" Text="Remarks" Variant="Variant.Outlined" Style="width:100%; display:block;" class="custom-form-field d-none d-md-block">
                    <RadzenDropDown TValue="string"
                                    @bind-Value="Rec.Level"
                                    Data="@RemarksOptions"
                                    Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>

        </RadzenRow>
    </RadzenColumn>
</RadzenRow>
@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public OEducateModel Rec { get; set; } = new();



    List<string> RemarksOptions = new()
    {
        "Graduate",
        "1st year",
        "2nd year",
        "3rd year",
        "4th year",
        "5th year",
        "6th year"
    };
}

<style>
    .custom-educ .rz-form-field-content{
        width:100% !important;
    }
</style>