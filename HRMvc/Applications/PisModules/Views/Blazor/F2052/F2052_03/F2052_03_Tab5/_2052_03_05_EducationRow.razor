<RadzenRow Gap="0.5rem" AlignItems="AlignItems.Start" Style="padding: 8px 0; border-bottom: 1px solid #f0f0f0;">
    <RadzenColumn Size="12" SizeMD="2" class="fw-bold">@Label</RadzenColumn>

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenFormField AllowFloatingLabel="false" Text="School Name" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field d-md-none">
            <RadzenTextBox @bind-Value="Rec.School" class="form-control" MaxLength="30" />
        </RadzenFormField>
        <RadzenTextBox @bind-Value="Rec.School" class="form-control d-none d-md-block" MaxLength="30" Placeholder="School Name" />
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="1">
        <RadzenFormField AllowFloatingLabel="false" Text="From" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field d-md-none">
            <RadzenTextBox @bind-Value="Rec.From_" class="form-control" MaxLength="10" />
        </RadzenFormField>
        <RadzenTextBox @bind-Value="Rec.From_" class="form-control d-none d-md-block" MaxLength="10" Placeholder="From" />
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="1">
        <RadzenFormField AllowFloatingLabel="false" Text="To" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field d-md-none">
            <RadzenTextBox @bind-Value="Rec.To_" class="form-control" MaxLength="10" />
        </RadzenFormField>
        <RadzenTextBox @bind-Value="Rec.To_" class="form-control d-none d-md-block" MaxLength="10" Placeholder="To" />
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenFormField AllowFloatingLabel="false" Text="Course" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field d-md-none">
            <RadzenTextBox @bind-Value="Rec.Course" class="form-control" MaxLength="75" />
        </RadzenFormField>
        <RadzenTextBox @bind-Value="Rec.Course" class="form-control d-none d-md-block" MaxLength="75" Placeholder="Course" />
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="2">
        <RadzenDropDown TValue="string"
                        @bind-Value="Rec.Level"
                        Data="@RemarksOptions"
                        class="w-100" />
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public OEducateModel Rec { get; set; } = new(); 



    List<string> RemarksOptions = new()
    {
        "Graduate",
        "1st year",
        "2nd year",
        "3rd year",
        "4th year",
        "5th year",
        "6th year"
    };
}