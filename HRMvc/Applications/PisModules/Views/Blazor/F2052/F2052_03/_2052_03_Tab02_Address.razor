@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisModules.Vars.NonExclusive
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_03.F2052_03_Tab2




@* -- Sub tabs : Detailed first (PIS EmpmasAddress, also updates the old PIS address), then Address (old PIS) -- *@
<div class="d-flex gap-1 px-2 pt-2">
    <div class="card text-center h-40p mb-btn mb-btn-gray px-4 @(subTab == 2 ? "mb-btn-active" : "")" @onclick="(() => subTab = 2)">
        <div class="d-flex gap-1 align-items-center justify-content-center h-100">
            <span class="fw-semibold"><small>Detailed</small></span>
        </div>
    </div>
    <div class="card text-center h-40p mb-btn mb-btn-gray px-4 @(subTab == 1 ? "mb-btn-active" : "")" @onclick="(() => subTab = 1)">
        <div class="d-flex gap-1 align-items-center justify-content-center h-100">
            <span class="fw-semibold"><small>Address</small></span>
        </div>
    </div>
</div>

@if (subTab == 2)
{
    <_2052_03_Tab02b_DetailedAddress ChildAction="ChildAction" />
}
else
{
    @* -- Read only : what Detailed holds (Country, Province, City / Municipality, joined Full Address, Telephone);
          the old PIS values only while the employee has no detailed address yet -- *@
    <div class="p-2">
        <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Address" />

        @if (!HasDetailed)
        {
            <div class="small text-muted p-2">No detailed address yet : showing the old PIS address. Use the Detailed tab to update it.</div>
        }

        <div class="d-flex flex-column gap-3 pt-2">
            <div class="d-flex flex-column">
                <div class="fw-semibold p-1">Present Address</div>
                @Show("Country",               PresCountry)
                @Show("Province",              HasDetailed ? A.PresAddProv : null)
                @Show("City / Municipality",   HasDetailed ? A.PresAddCity : V.MlaList?.FirstOrDefault(m => m?.Code == V.Empmas.MlaCode_)?.Name)
                @Show("Address",               HasDetailed ? _2052_03_Tab02b_DetailedAddress.Join(_2052_03_Tab02b_DetailedAddress.PresentParts(A)) : V.Empmas.Addr1)
                @Show("Telephone No.",         HasDetailed ? A.PresAddTelNo : V.Empmas.Tel1)
            </div>

            <div class="d-flex flex-column border-top pt-2">
                <div class="fw-semibold p-1">Provincial Address</div>
                @Show("Country",               ProvCountry)
                @Show("Province",              HasDetailed ? A.ProvAddProv : V.ProList?.FirstOrDefault(p => p?.Code == V.Empmas.ProCode_)?.Name)
                @Show("City / Municipality",   HasDetailed ? A.ProvAddCity : null)
                @Show("Address",               HasDetailed ? _2052_03_Tab02b_DetailedAddress.Join(_2052_03_Tab02b_DetailedAddress.ProvincialParts(A)) : V.Empmas.Addr2)
                @Show("Telephone No.",         HasDetailed ? A.ProvAddTelNo : V.Empmas.Tel2)
            </div>
        </div>
    </div>
}

@inject I_10_EmpmasDataAccess _pisEmpmas

@code {

    int subTab = 2;   // -- Detailed opens first --

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2052 V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback    ChildAction     { get; set; }

    EmpmasAddressModel A => V.Empmasaddress;

    // -- A saved detailed address exists in PIS --
    bool HasDetailed => A.Id != null;

    string? PresCountry => HasDetailed ? A.PresAddCountry : V.Countrys?.FirstOrDefault(c => c?.Code == V.Empmas.CountryCode)?.Name;
    string? ProvCountry => HasDetailed ? A.ProvAddCountry : V.Countrys?.FirstOrDefault(c => c?.Code == V.Empmas.CountryCode)?.Name;

    protected override async Task OnParametersSetAsync()
    {
        var empno = V.SelectedEmpnumber;
        if (string.IsNullOrWhiteSpace(empno) || V.EmpmasaddressFor == empno) return;

        var empmas  = await _pisEmpmas._02EmpmasInternalByEmpNumber(empno, Uc.SchemaUserPis, Uc.Conn);
        var address = empmas?.Id == null ? null : await _pisEmpmas._02EmpmasAddress(empmas.Id, Uc.SchemaUserPis, Uc.Conn);
        V.Empmasaddress     = address ?? new();
        V.EmpmasaddressFor  = empno;
    }

    RenderFragment Show(string label, string? value) => __builder =>
    {
        <div class="d-flex align-items-center gap-2 p-1" style="min-height:36px;">
            <div class="small" style="width:160px; flex-shrink:0;">@label</div>
            <div class="fw-semibold" style="flex:1; max-width:520px;">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div>
        </div>
    };
}






