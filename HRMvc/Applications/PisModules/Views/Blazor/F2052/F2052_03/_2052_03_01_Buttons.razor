@code {

    string active1 = "mb-btn-active";
    string active2 = "";
    string active3 = "";
    string active4 = "";
    string active5 = "";
    string active6 = "";
    string active7 = "";
    string active8 = "";
    string active9 = "";
    string active10 = "";
    string active11 = "";
    string active12 = "";

    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    async void SetActive(int no)
    {
        active1 = "";
        active2 = "";
        active3 = "";
        active4 = "";
        active5 = "";
        active6 = "";
        active7 = "";
        active8 = "";
        active9 = "";
        active10 = "";
        active11 = "";
        active12 = "";

        V.TabNo = no;

        switch (no)
        {
            case 1: active1 = "mb-btn-active"; break;
            case 2: active2 = "mb-btn-active"; break;
            case 3: active3 = "mb-btn-active"; break;
            case 4: active4 = "mb-btn-active"; break;
            case 5: active5 = "mb-btn-active"; break;
            case 6: active6 = "mb-btn-active"; break;
            case 7: active7 = "mb-btn-active"; break;
            case 8: active8 = "mb-btn-active"; break;
            case 9: active9 = "mb-btn-active"; break;
            case 10: active10 = "mb-btn-active"; break;
            case 11: active11 = "mb-btn-active"; break;
            case 12: active12 = "mb-btn-active"; break;
            default: break;
        }

        await ChildAction.InvokeAsync();
    }
}