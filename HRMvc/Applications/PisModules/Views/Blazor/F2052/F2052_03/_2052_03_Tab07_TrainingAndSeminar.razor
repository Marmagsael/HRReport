@using HRApiLibrary.DataAccess._10_Pis.Interface

@inject NotificationService _NotificationService
@inject DialogService _DialogService

<div class="p-2">
    <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Training and Seminar" />
    <div class="h-10p"></div>
    @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
    {
        <div class="p-2 bordered mb-2 w-100">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Text="New Entry" Click="@InsertRow" Disabled="@(editMode || isLoading)" />
        </div>
    }

    <div class="custom-grid mt-2">
        <RadzenDataGrid Data="@V.Trainings"
                        TItem="OTrainModel"
                        @ref="V.TrainingGrid"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        ColumnWidth="200px"
                        IsLoading="isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="OTrainModel"
                                      Context="OTrainModel"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="100%">
                    <HeaderTemplate>
                        <RadzenRow Gap="0" Style="padding-inline-end:1rem;">
                            <RadzenColumn Size="5" class="custom-grid-sm">Details</RadzenColumn>
                            <RadzenColumn Size="6" class="custom-grid-md">Program Name</RadzenColumn>
                            <RadzenColumn Size="6" class="custom-grid-md">Institution</RadzenColumn>
                        </RadzenRow>
                    </HeaderTemplate>

                    <Template Context="rec">
                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            @*-- Program Name --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Program" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Program" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- School --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="School" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.School" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Trainor --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Trainor" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Trainor" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Taken --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Taken / Coverage" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Taken" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Type --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Type" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDropDown TValue="string"
                                                        Data="@typeOptions"
                                                        @bind-Value="rec.Type"
                                                        Placeholder="Select Type" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow>
                                @*-- Program / Taken / Type --*@
                                <RadzenColumn Size="6">
                                    <div class="fw-bold">@rec.Program</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="6">
                                                Taken  / Coverage: <span class="text-muted text-decoration-underline">@rec.Taken</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6">
                                                Type: <span class="text-muted text-decoration-underline">@rec.Type</span>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                @*-- School / Trainor --*@
                                <RadzenColumn Size="6">
                                    <div>@rec.School</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                Trainor: <span class="text-muted text-decoration-underline">@rec.Trainor</span>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </Template>

                    <EditTemplate Context="rec">
                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            @*-- Program Name --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Program" Component="ProgramSm" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Program" Change="@(args => rec.Program = args.ToString().Trim())" class="w-100" Name="ProgramSm" MaxLength="60" />
                                        <RadzenRequiredValidator Component="ProgramSm" Text="Program Name is required" Popup="true" Style="position: absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- School --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="School" Component="SchoolSm" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.School" Change="@(args => rec.School = args.ToString().Trim())" class="w-100" Name="SchoolSm" MaxLength="50" />
                                        <RadzenRequiredValidator Component="SchoolSm" Text="School is required" Popup="true" Style="position: absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Trainor --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Trainor" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Trainor" class="w-100" MaxLength="30" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Taken --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Taken  / Coverage" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Taken" class="w-100" MaxLength="20" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Type --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Type" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDropDown TValue="string"
                                                        Data="@typeOptions"
                                                        @bind-Value="rec.Type"
                                                        Placeholder="Select Type" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow Gap=".3rem">
                                @*-- Program Name / Taken / Type --*@
                                <RadzenColumn Size="6">
                                    <RadzenTextBox @bind-Value="rec.Program" Change="@(args => rec.Program = args.ToString().Trim())" class="w-100" Name="ProgramLg" MaxLength="60" Style="display:block" />
                                    <RadzenRequiredValidator Component="ProgramLg" Text="Program Name is required" Popup="true" Style="position: absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="6">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Taken  / Coverage" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Taken" MaxLength="20" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Type" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenDropDown TValue="string"
                                                                    Data="@typeOptions"
                                                                    @bind-Value="rec.Type"
                                                                    Placeholder="Select Type" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                @*-- School / Trainor --*@
                                <RadzenColumn Size="6">
                                    <RadzenTextBox @bind-Value="rec.School" Change="@(args => rec.School = args.ToString().Trim())" class="w-100" Name="SchoolLg" MaxLength="50" Style="display:block" />
                                    <RadzenRequiredValidator Component="SchoolLg" Text="School is required" Popup="true" Style="position: absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Trainor" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Trainor" MaxLength="30" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* Actions Column *@
                <RadzenDataGridColumn TItem="OTrainModel" Context="OTrainModel" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Title="Actions" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="120px">
                    <Template Context="rec">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditRow(rec))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                    <EditTemplate Context="rec">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@((args) => SaveRow(rec))"></RadzenButton>
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@((args) => CancelEdit(rec))" Size="ButtonSize.Small" class="my-1 ms-1"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(rec))" class="my-1 ms-1"></RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@inject IOTrainDataAccess _empmas


@code {

    string? empnumber = string.Empty;

    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    List<OTrainModel?>? trainingToInsert = new();
    List<OTrainModel?>? trainingToUpdate = new();
    string? errorMsg = string.Empty;
    bool isLoading = true;
    bool editMode = false;

    private List<string> typeOptions = new List<string> { "Internal", "External" };
    OTrainModel? recBackup;

    protected override async Task OnParametersSetAsync()
    {
        if (empnumber != V.SelectedEmpnumber)
        {
            empnumber = V.SelectedEmpnumber;

            await Task.Delay(250);

            V.Trainings = await _empmas._02(V.SelectedEmpnumber, V.pisdb!, V.conn!) ?? new();
        }
        isLoading = false;
        StateHasChanged();
    }

    //-- InsertRow ----------------
    private async Task InsertRow()
    {
        errorMsg = string.Empty;
        Reset();

        var rec = new OTrainModel();
        rec.EmpNumber = V.SelectedEmpnumber;

        trainingToInsert!.Add(rec);
        await V.TrainingGrid!.InsertRow(rec);
        editMode = true;
    }

    //-- Reset ----------------
    private void Reset()
    {
        trainingToInsert!.Clear();
        trainingToUpdate!.Clear();
    }

    //-- Reset ----------------
    private void Reset(OTrainModel rec)
    {
        trainingToInsert!.Remove(rec);
        trainingToUpdate!.Remove(rec);
    }

    //-- Edit Row ----------------
    private async Task EditRow(OTrainModel rec)
    {
        editMode = true;

        if (V.TrainingGrid != null)
        {
            Reset();
            trainingToUpdate?.Add(rec);

            recBackup = new OTrainModel
            {
                EmpNumber = rec.EmpNumber,
                Program = rec.Program,
                School = rec.School,
                Trainor = rec.Trainor,
                Taken = rec.Taken,
                Type = rec.Type
            };

            await V.TrainingGrid.EditRow(rec);
        }
    }

    //-- Delete Row ----------------
    private async Task DeleteRow(OTrainModel rec)
    {
        if (V.Trainings == null) return;
        if (V.TrainingGrid == null) return;
        if (rec == null) return;

        Reset(rec);

        if (V.Trainings.Contains(rec))
        {
            var option = await _DialogService.Confirm(
                $"Delete {rec.Program}  record?", "Confirm Delete",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

            if (option == true)
            {
                V.Trainings.Remove(rec);

                try
                {
                    await _empmas._04(V.SelectedEmpnumber, V.pisdb!, V.conn!);

                    foreach (var item in V.Trainings)
                    {
                        if (item != null)
                            await _empmas._01(item, V.pisdb!, V.conn!);
                    }

                    ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Successfully deleted a record.",
                        Detail = "Record has been deleted from the list.",
                        Duration = 4000
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);
                    ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Unable to delete",
                        Detail = "Something went wrong while deleting. Please try again.",
                        Duration = 6000
                    });
                    return;
                }
            }
        }
        else
        {
            V.TrainingGrid.CancelEditRow(rec);
        }

        await V.TrainingGrid.Reload();
        editMode = false;
        errorMsg = string.Empty;
    }

    //-- Cancel Edit ----------------
    private async Task CancelEdit(OTrainModel rec)
    {
        errorMsg = string.Empty;
        if (V.TrainingGrid == null) return;

        bool isNew = trainingToInsert!.Contains(rec);

        Reset(rec);
        editMode = false;

        if (isNew)
        {
            V.Trainings?.Remove(rec);
        }
        else if (recBackup != null)
        {
            rec.EmpNumber = recBackup.EmpNumber;
            rec.Program = recBackup.Program;
            rec.School = recBackup.School;
            rec.Trainor = recBackup.Trainor;
            rec.Taken = recBackup.Taken;
            rec.Type = recBackup.Type;
        }

        V.TrainingGrid.CancelEditRow(rec);
        recBackup = null;

        await V.TrainingGrid.Reload();
    }

    //-- Save Row ----------------
    private async Task SaveRow(OTrainModel rec)
    {
        if (V.TrainingGrid == null) return;
        if (rec == null) return;

        if (!SafeToSave(rec))
        {
            await V.TrainingGrid.UpdateRow(rec);
            return;
        }

        try
        {
            V.Trainings ??= new();

            if (!V.Trainings.Contains(rec))
                V.Trainings.Add(rec);

            await V.TrainingGrid.UpdateRow(rec);

            await _empmas._04(V.SelectedEmpnumber, V.pisdb!, V.conn!);

            foreach (var item in V.Trainings!)
            {
                if (item != null)
                    await _empmas._01(item, V.pisdb!, V.conn!);
            }

            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Successfully saved",
                Detail = "Record has been successfully saved.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Unable to save",
                Detail = "Something went wrong while saving. Please try again.",
                Duration = 6000
            });
            return;
        }

        recBackup = null;
        editMode = false;
        errorMsg = string.Empty;
    }

    //-- Safe to Save ----------------
    private bool SafeToSave(OTrainModel rec)
    {
        if (string.IsNullOrWhiteSpace(rec.Program)) return false;
        if (string.IsNullOrWhiteSpace(rec.School)) return false;
        return true;
    }

    private void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }
}
