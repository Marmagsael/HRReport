@using HRApiLibrary.DataAccess._00_Main.Interface

@* ----- Addr1 (varchar(150))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2 small">Address </div>
    <div class="w-80">
        <RadzenTextArea Placeholder="Complete Address"  @bind-Value=@V.Empmas.Addr1 Rows="3" Columns="30" MaxLength="150" Style="width: 100%"/>
    </div>
</div>
@* ----- City/Municipality (varchar(45))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2 small">City/Municipality </div>
    <div class="w-40">
        <RadzenDropDown TValue="string" @bind-Value=@V.Empmas.MlaCode_ Data=@V.MlaList TextProperty="Name" ValueProperty="Code" class="form-control" Name="ddProvinces" Style="max-width:400px" />
    </div>
</div>
@* ----- Tel1 (varchar(15))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2 small">Telephone No. </div>
    <div class="w-40">
        <RadzenTextBox  class="form-control" @bind-Value=@V.Empmas.Tel1 MaxLength="15" Style="max-width:400px" />
    </div>
</div>

@inject I_00CityDataAccess _city;

@code {
    int? empmasId = 0;
    [Parameter]
    public V2052 V { get; set; } = new();
    [Parameter]
    public V2052_03 V03 { get; set; } = new();
    [Parameter]
    public EventCallback ChildAction { get; set; }

}