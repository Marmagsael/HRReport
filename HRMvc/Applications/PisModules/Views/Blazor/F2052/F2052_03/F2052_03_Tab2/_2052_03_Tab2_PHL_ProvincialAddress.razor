@using HRApiLibrary.DataAccess._00_Main.Interface


@* ----- Addr2 (varchar(150))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2">Address </div>
    <div class="w-80">
        <RadzenTextArea Placeholder="Complete Address" class="form-control" @bind-Value=@V.Empmas.Addr2 Rows="3" Columns="30" MaxLength="150"  />
    </div>
</div>
@* ----- City/Municipality (varchar(45))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2">City/Municipality </div>
    <div class="w-40">
        <RadzenDropDown TValue="string" @bind-Value=@V.Empmas.ProCode_ Data=@V.ProList TextProperty="Name" ValueProperty="Code" class="form-control" Name="ddProvinces" Style="max-width:400px" />
    </div>
</div>
@* ----- Tel2 (varchar(15))----------*@
<div class="w-100 d-flex p-1">
    <div class="w-20 p-2">Telephone No. </div>
    <div class="w-20">
        <RadzenTextBox Placeholder="Telephone No." class="form-control" @bind-Value=@V.Empmas.Tel2 MaxLength="15" Style="max-width:400px" />
    </div>
</div>


@inject I_00CityDataAccess _city;

@code {
    int? empmasId = 0;
    [Parameter]
    public V2052 V { get; set; } = new();
    [Parameter]
    public V2052_03 V03 { get; set; } = new();
    [Parameter]
    public EventCallback ChildAction { get; set; }

}