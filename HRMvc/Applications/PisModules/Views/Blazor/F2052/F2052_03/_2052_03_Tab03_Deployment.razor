@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._90_Utils
@using HRApiLibrary.Models._10_Pis
@using Radzen;

@inject NotificationService _NotificationService;
@inject DialogService       _DialogService; 


<div class="p-2">
    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>

        <div class="position-sticky sticky-top bg-white pt-1" style="top:0; z-index:1000;">
            <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Deployment" />

            <div class="h-10p"></div>
            @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
            {
                <div class="p-2 bordered mb-2 w-100">
                    <button type="submit" class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 px-4 ">
                        <div class="d-flex gap-1 align-items-center justify-content-center">
                            <span class="fw-semibold"><small>Save</small></span>
                        </div>
                    </button>
                </div>
            }
        </div>

        <div class="h-10p"></div>
        @* ============== Employment Details ============== *@
        <RadzenFieldset Text="Employment Details">
            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Position</div>
                <div class="w-80">
                    <RadzenDropDown TValue="string" @bind-Value=@V.Empmas!.Position_ Data=@V.OPositions
                                    TextProperty="Name" ValueProperty="Code"
                                    Style="width: 100%;  max-width: 400px;"
                                    />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Status</div>
                <div class="w-80">
                    <RadzenDropDown TValue="string" @bind-Value=@V.Empmas!.EmpStat_ Data=@V.OEmpstats
                                    TextProperty="Name" ValueProperty="Code" Disabled
                                    Style="width: 100%;  max-width: 400px;" />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Date Hired </div>
                <div class="w-80">
                    <RadzenDatePicker @bind-Value=@V.Empmas.DateHired DateFormat="MMM dd, yyyy" Style="width:50%" />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Date of Regularization </div>
                <div class="w-80">
                    <RadzenDatePicker @bind-Value=@V.Empmas.RegRef Name="DPDRegularization" DateFormat="MMM dd, yyyy" Style="width:50%" />
                </div>
            </div>
        </RadzenFieldset>



        <div class="disabled-div-50">
            @* ============== Group Asdsignment ============== *@
            <div class="h-10p"></div>
            <RadzenFieldset Text="Group Assignment" class="bg-lightgray">
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Division</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Divid Data=@V.Rdivisions
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Department</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Depid Data=@V.Rdepartments
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Section</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Secid Data=@V.Rsections
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Leave Group</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Leavegrpid Data=@V.Leavegrps
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Payroll Group</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Payrollgrpid Data=@V.Payrollgprs
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>





            </RadzenFieldset>


            @* ============== Employment References ============== *@
            <div class="h-10p"></div>
            <RadzenFieldset Text="Employment References" class="bg-lightgray">
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Employment Type </div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?"
                                        @bind-Value=@V.Deprec!.Employmenttypeid
                                        Data=@V.Employmenttypes
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Style="width: 100%; max-width: 400px;" />
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Trainee    </div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker @bind-Value="@V.Deprec!.Dtraineestart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker @bind-Value="@V.Deprec!.Dtraineeend" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Contractual   </div>
                    <div class="w-80">
                        <div class="mt-1">
                            <RadzenRow RowGap="0">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dcontractualstart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dcontractualend" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </div>
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Probationary    </div>
                    <div class="w-80">
                        <div class="mt-1">
                            <RadzenRow RowGap="0">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dprobationarystart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dprobationaryend" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </div>
                    </div>
                </div>



                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Regularization    </div>
                    <div class="w-80">
                        <div class="mt-1">
                            <RadzenRow RowGap="0">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dregularizationstart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                        <RadzenDatePicker @bind-Value="@V.Deprec!.Dregularizationend" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </div>
                    </div>
                </div>



                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Permanent    </div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker @bind-Value="@V.Deprec!.Dpermanentstart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker @bind-Value="@V.Deprec!.Dpermanentstart" DateFormat="MMM dd, yyyy" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>

            </RadzenFieldset>

        </div>
   
       
    </RadzenTemplateForm>
</div>

@inject IOEmpmasDataAccess _empmas

@code {

    int? empmasId = 0 ; 

    List<RdivisionModel?>? divisions = new();
    List<EmploymenttypeModel?>? employmenttypes = new();


    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    async Task OnSubmit(OEmpmasModel model)
    {
        if (model == null) return;

        try
        {
            var res = await _empmas._03_Deployment(V.SelectedEmpnumber, model, V.pisdb, V.conn);

            V.Empmas.PositionName = V.OPositions
                .FirstOrDefault(p => p.Code == V.Empmas.Position_)?.Name ?? string.Empty;

            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Successfully saved",
                Detail = "Record has been successfully saved.",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Unable to save",
                Detail = "Something went wrong while saving. Please try again.",
                Duration = 6000
            });
            return; 
        }

        await ChildAction.InvokeAsync();
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
    }

}
