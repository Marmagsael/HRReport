@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._90_Utils
@using HRApiLibrary.Models._10_Pis
@using Radzen;

@inject NotificationService _NotificationService;
@inject DialogService       _DialogService; 


<div class="p-2">
    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>

        <div class="position-sticky sticky-top bg-white pt-1" style="top:0; z-index:9;">
            <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Deployment" />

            <div class="h-10p"></div>
            @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
            {
                <div class="p-2 bordered mb-2 w-100">
                    <button type="submit" class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 px-4 ">
                        <div class="d-flex gap-1 align-items-center justify-content-center">
                            <span class="fw-semibold"><small>Save</small></span>
                        </div>
                    </button>
                </div>
            }
        </div>

        <div class="h-10p"></div>
        @* ============== Employment Details ============== *@
        <RadzenFieldset Text="Employment Details">
            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Position</div>
                <div class="w-80">
                    <RadzenDropDown TValue="string" @bind-Value=@V.Empmas!.Position_ Data=@V.OPositions
                                    TextProperty="Name" ValueProperty="Code"
                                    Style="width: 100%;  max-width: 400px;"
                                    />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Date Hired </div>
                <div class="w-80">
                    <RadzenDatePicker @bind-Value=@V.Empmas.DateHired DateFormat="MMMM dd, yyyy" Style="width:50%" />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Date of Regularization </div>
                <div class="w-80">
                    <RadzenDatePicker @bind-Value=@V.Empmas.RegRef Name="DPDRegularization" DateFormat="MMMM dd, yyyy" Style="width:50%" />
                </div>
            </div>

            <div class="w-100 d-flex p-1">
                <div class="w-30 p-2 small">Date Separated </div>
                <div class="w-80">
                    <RadzenDatePicker @bind-Value=@V.Empmas.Separate  DateFormat="MMMM dd, yyyy" Style="width:50%" Disabled />
                </div>
            </div>
        </RadzenFieldset>



        <div>
            @* ============== Group Assignment ============== *@
            <div class="h-10p"></div>
            <RadzenFieldset Text="Group Assignment">
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Division</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Divid Data=@V.Rdivisions
                                        TextProperty="Name" ValueProperty="Id" AllowClear="true" Placeholder="Select division"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Department</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Depid Data=@V.Rdepartments
                                        TextProperty="Name" ValueProperty="Id" AllowClear="true" Placeholder="Select department"
                                        Change="@(_ => OnDepartmentChanged())"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Section</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Secid Data=@SectionsOfDepartment
                                        TextProperty="Name" ValueProperty="Id" AllowClear="true" Placeholder="Select section"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>

                <div class="disabled-div-50">
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Leave Group</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Leavegrpid Data=@V.Leavegrps
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>


                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Payroll Group</div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?" @bind-Value=@V.Deprec!.Payrollgrpid Data=@V.Payrollgprs
                                        TextProperty="Name" ValueProperty="Id"
                                        Style="width: 100%;  max-width: 400px;" />
                    </div>
                </div>




                </div>
            </RadzenFieldset>


            @* ============== Employment References ============== *@
            <div class="h-10p"></div>
            <RadzenFieldset Text="Employment References">
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Employment Type </div>
                    <div class="w-80">
                        <RadzenDropDown TValue="int?"
                                        @bind-Value=@V.Deprec!.Employmenttypeid
                                        Data=@V.Employmenttypes
                                        TextProperty="Name"
                                        ValueProperty="Id" AllowClear="true" Placeholder="Select employment type"
                                        Style="width: 100%; max-width: 400px;" />
                    </div>
                </div>


                @* -- Only the dates of the selected employment type can be edited; the others stay as history -- *@
                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Trainee</div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DTraineeStart" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "trainee")" AllowClear="true" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DTraineeEnd" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "trainee")" AllowClear="true" Min="@dates.DTraineeStart" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Contractual</div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DContractualStart" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "contractual")" AllowClear="true" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DContractualEnd" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "contractual")" AllowClear="true" Min="@dates.DContractualStart" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Probationary</div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DProbationaryStart" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "probationary")" AllowClear="true" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@dates.DProbationaryEnd" DateFormat="MMM dd, yyyy" Style="width:100%"
                                                      Disabled="@(Stage != "probationary")" AllowClear="true" Min="@dates.DProbationaryStart" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>

                <div class="w-100 d-flex p-1">
                    <div class="w-30 p-2 small">Regularization</div>
                    <div class="mt-1 w-80">
                        <RadzenRow RowGap="0">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date Start" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" Value="@RegularizationStart" DateFormat="MMM dd, yyyy" Style="width:100%" Disabled />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField AllowFloatingLabel="false" Text="Date End" Variant="Variant.Outlined" class="custom-form-field">
                                    <RadzenDatePicker TValue="DateTime?" Value="@RegularizationEnd" DateFormat="MMM dd, yyyy" Style="width:100%" Disabled />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </div>
            </RadzenFieldset>

        </div>
   
       
    </RadzenTemplateForm>
</div>

@inject IOEmpmasDataAccess          _empmas
@inject IODeprecDataAccess          _odeprec
@inject IDeprecDataAccess           _deprec
@inject I_10_EmpmasDataAccess       _pisEmpmas
@inject IRdivisionDataAccess        _rdivision
@inject IRdepartmentDataAccess      _rdepartment
@inject IRsectionDataAccess         _rsection
@inject IEmploymenttypeDataAccess   _employmenttype

@code {

    
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    int? empmasId = 0 ; 

    List<RdivisionModel?>? divisions = new();
    List<EmploymenttypeModel?>? employmenttypes = new();


    [CascadingParameter]
    public V2052 V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    async Task OnSubmit(OEmpmasModel model)
    {
        if (model == null) return;

        if (DateError() is string dateError)
        {
            NotificationRef.Show(dateError, ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        try
        {
            var res = await _empmas._03_Deployment(V.SelectedEmpnumber, model, Uc.OpisDb, Uc.Conn);
            await SaveDeprecAsync(model);

            V.Empmas.PositionName = V.OPositions.FirstOrDefault(p => p.Code == V.Empmas.Position_)?.Name ?? string.Empty;

            NotificationRef.Show("Record has been successfully saved.", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        await ChildAction.InvokeAsync();
    }

    // -- Lists from the company PIS (once), the employee's group from the old PIS deprec (on each employee) --
    bool    listsLoaded;
    string? loadedEmpNumber;

    // -- Employment period dates (nullable, from the old PIS deprec) --
    ODeprecModel dates = new();

    // -- Selected employment type by name : trainee / contractual / probationary / regular --
    string Stage => (V.Employmenttypes ?? new()).FirstOrDefault(t => t?.Id == V.Deprec?.Employmenttypeid)?.Name?.Trim().ToLower() switch
    {
        "trainee"       => "trainee",
        "contractual"   => "contractual",
        "probationary"  => "probationary",
        "regular"       => "regular",
        _               => "",
    };

    static DateTime? D(DateTime? d) => d is DateTime x && x.Year > 1900 ? x : null;

    // -- Regularization period is not typed : it starts on the Date of Regularization and ends on the Date Separated (resigned) --
    DateTime? RegularizationStart => D(V.Empmas?.RegRef);
    DateTime? RegularizationEnd   => D(V.Empmas?.Separate);

    string? DateError()
    {
        foreach (var (name, start, end) in new[]
        {
            ("Trainee",        dates.DTraineeStart,        dates.DTraineeEnd),
            ("Contractual",    dates.DContractualStart,    dates.DContractualEnd),
            ("Probationary",   dates.DProbationaryStart,   dates.DProbationaryEnd),
            ("Regularization", RegularizationStart, RegularizationEnd),
        })
            if (start != null && end != null && end < start) return $"{name} : Date End is earlier than Date Start.";
        return null;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (!listsLoaded && !string.IsNullOrWhiteSpace(Uc.SchemaUserPis))
            {
                V.Rdivisions        = await _rdivision._02(Uc.SchemaUserPis, Uc.Conn)       ?? new();
                V.Rdepartments      = await _rdepartment._02(Uc.SchemaUserPis, Uc.Conn)     ?? new();
                V.Rsections         = await _rsection._02(Uc.SchemaUserPis, Uc.Conn)        ?? new();
                V.Employmenttypes   = await _employmenttype._02(Uc.SchemaUserPis, Uc.Conn)  ?? new();
                listsLoaded = true;
            }

            var emp = V.Empmas?.EmpNumber?.Trim();
            if (emp == loadedEmpNumber) return;
            loadedEmpNumber = emp;

            V.Deprec = new();
            dates    = new();
            if (string.IsNullOrEmpty(emp)) return;

            var od = await _odeprec._02ByEmpnumber(emp, Uc.OpisDb, Uc.Conn);
            if (od == null) return;
            V.Deprec.Divid              = Nz(od.DivId);
            V.Deprec.Depid              = Nz(od.DepId);
            V.Deprec.Secid              = Nz(od.SecId);
            V.Deprec.Employmenttypeid   = Nz(od.EmploymentTypeId);
            V.Deprec.Leavegrpid         = Nz(od.LeavegrpId);
            V.Deprec.Payrollgrpid       = Nz(od.PayrollgrpId);
            dates = new ODeprecModel
            {
                DTraineeStart           = D(od.DTraineeStart),          DTraineeEnd         = D(od.DTraineeEnd),
                DContractualStart       = D(od.DContractualStart),      DContractualEnd     = D(od.DContractualEnd),
                DProbationaryStart      = D(od.DProbationaryStart),     DProbationaryEnd    = D(od.DProbationaryEnd),
                DRegularizationStart    = D(od.DRegularizationStart),   DRegularizationEnd  = D(od.DRegularizationEnd),
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    // -- 0 in deprec means none : the dropdown shows its placeholder --
    static int? Nz(int? id) => id is null or 0 ? null : id;

    IEnumerable<RsectionModel?> SectionsOfDepartment =>
        V.Deprec?.Depid is int dep && dep > 0
            ? (V.Rsections ?? new()).Where(s => s?.Departmentid == dep)
            : (V.Rsections ?? new());

    void OnDepartmentChanged()
    {
        if (V.Deprec?.Secid is int sec && !SectionsOfDepartment.Any(s => s?.Id == sec)) V.Deprec.Secid = null;
    }

    // -- Old PIS deprec first (source of truth), then the same values in the company PIS DepRec --
    async Task SaveDeprecAsync(OEmpmasModel model)
    {
        var emp = V.Empmas?.EmpNumber?.Trim();
        if (string.IsNullOrEmpty(emp) || V.Deprec == null) return;

        var od = await _odeprec._01Deployment(new ODeprecModel
        {
            EmpNumber           = emp,
            DivId               = V.Deprec.Divid,
            DepId               = V.Deprec.Depid,
            SecId               = V.Deprec.Secid,
            EmploymentTypeId    = V.Deprec.Employmenttypeid,
            DTraineeStart       = dates.DTraineeStart,          DTraineeEnd         = dates.DTraineeEnd,
            DContractualStart   = dates.DContractualStart,      DContractualEnd     = dates.DContractualEnd,
            DProbationaryStart  = dates.DProbationaryStart,     DProbationaryEnd    = dates.DProbationaryEnd,
            DRegularizationStart = RegularizationStart,         DRegularizationEnd  = RegularizationEnd,
        }, model.Position_, model.EmpStat_, Uc.OpisDb, Uc.Conn);

        if (string.IsNullOrWhiteSpace(Uc.SchemaUserPis)) return;
        var pis = await _pisEmpmas._02EmpmasInternalByEmpNumber(emp, Uc.SchemaUserPis, Uc.Conn);
        if (pis == null)
        {
            await _pisEmpmas._01EmpmasInternal(new EmpmasInternalModel
            {
                EmpNumber   = emp,
                EmpLastNm   = V.Empmas!.EmpLastNm,
                EmpFirstNm  = V.Empmas.EmpFirstNm,
                EmpMidNm    = V.Empmas.EmpMidNm,
                Suffix      = V.Empmas.Suffix ?? "",
                EmpAlias    = V.Empmas.EmpAlias,
            }, Uc.SchemaUserPis, Uc.Conn);
            pis = await _pisEmpmas._02EmpmasInternalByEmpNumber(emp, Uc.SchemaUserPis, Uc.Conn);
        }
        if (pis?.Id == null) return;

        if (od != null) await _deprec._01Deployment(pis.Id, od, Uc.SchemaUserPis, Uc.Conn);
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
    }

}
