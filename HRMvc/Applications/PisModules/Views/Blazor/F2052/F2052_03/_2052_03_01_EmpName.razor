@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._90_Utils.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._90_Utils
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using HRApiLibrary.DataAccess._10_Pis.OPis;
@using HRApiLibrary.DataAccess._10_Pis



@inject I_00MainDA _main
@inject IEmpmovementDataAccess _empMovement
@inject IMsdsDataAccess _msds
@inject IOEmpmasDataAccess _oempmas
@inject IEmpmasInternalDataAccess _empmas
@inject IEmpmaspicDataAccess _emppic
@inject IGoogleDriveDataAccess _googledrive


<div class="w-100 p-3 bg-lightgray">

     @if (V.Empmas?.EmpLastNm?.Length > 0)
    {
        <div class="mb-3 d-flex align-items-center gap-4">
            <button class="btn btn-link p-0 d-flex align-items-center"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#empmasFormContent"
                    aria-expanded="true"
                    aria-controls="empmasFormContent"
                    style="color: #0066cc; text-decoration: none; cursor: pointer;">
                <i class="fa-solid fa-chevron-down" style="font-size: .85rem; transition: transform 0.3s ease;"></i>
            </button>

            <div class="d-flex gap-4" style="flex: 1;">
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.EmpLastNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Last name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.EmpFirstNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">First name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.EmpMidNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Mid. name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.Suffix &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Suffix</div>
                </div>
            </div>
        </div>
    }

    <div class="collapse show" id="empmasFormContent">

        <div class="d-flex gap-5">

            @* --- Employee Picture --- *@
            <div class="d-flex align-items-center justify-content-center"
                 style="width:180px;">

                <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center overflow-hidden"
                     style="height:160px; width:160px;">

                    @if (!string.IsNullOrWhiteSpace(V.ImagePreview))
                    {
                        <img src="@V.ImagePreview"
                             class="img-fluid w-100 h-100"
                             style="object-fit:cover;"
                             alt="Employee image" />
                    }
                    else
                    {
                        <img src="images/employee.png"
                             class="img-fluid"
                             height="90"
                             width="90"
                             alt="Employee image" />
                    }

                </div>

            </div>

            @* --- Fields --- *@
            <div class="flex-grow-1 mt-3">


                @* --- System Id *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-fingerprint text-center field-icon txt-fcolor1" style="width:16px;"></i> System ID
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas.UserId</div>
                </div>

                @* --- Email Address *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-envelope text-center field-icon txt-fcolor1" style="width:16px;"></i> Email
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas!.Email</div>
                </div>

                @* --- Emp Number *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-hashtag text-center field-icon txt-fcolor1" style="width:16px;"></i> Emp. no.
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas!.EmpNumber</div>
                </div>

                @* --- Position *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-briefcase text-center field-icon txt-fcolor1" style="width:16px;"></i> Position
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas?.PositionName</div>
                </div>

                @* --- Status *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-circle-info text-center field-icon txt-fcolor1" style="width:16px;"></i> Status
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas?.EmpStatus</div>
                </div>



                @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
                {
                    <div class="d-flex align-items-center">

                        <div style="width:130px;">&nbsp;</div>

                        <div class="flex-grow-1 d-flex gap-3">

                            <span class="msds-link small" role="button" @onclick="EditEmpmas">Edit</span>

                            @if (string.IsNullOrWhiteSpace(V.ImagePreview))
                            {
                                @* --- Image Selection --- *@
                                <label class="msds-link small mb-0"
                                       style="cursor:pointer;">

                                    Upload image

                                    <InputFile OnChange="@OnImageSelected"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="d-none" />

                                </label>
                            }
                           

                            @* --- Remove Image --- *@
                            @if (!string.IsNullOrWhiteSpace(V.ImagePreview))
                            {

                                <span class="text-danger small link-underline-danger"
                                      role="button"
                                      style="cursor:pointer;"
                                      @onclick="_04DeleteEmployeeImage">

                                    Remove image

                                </span>
                            }

                        </div>

                    </div>
                }

                @* --- Error Message --- *@
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="text-danger small mt-2">
                        @ErrorMessage
                    </div>
                }

            </div>

        </div>

    </div>

</div>



@code {

    bool popup = true;

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2052 V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }



    List<UsersModel?>? users = new();

    string? errorEmail = "";


    // Validation message
    private string? ErrorMessage;

    // Image size limits
    private const long MaxFileSize = 2 * 1024 * 1024; // 2 MB
    // private const long MinFileSize = 1024;            1 KB

    // Allowed image extensions
    private readonly List<string> AllowedExtensions = new()
    {
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
    };





    async void EditEmpmas()
    {
        V.EmpmasToEdit      = V.EmpmasToEditMapper(V.Empmas!, V.EmpmasToEdit!);
        V.IsNewEntry        = false;
        V.ShowDataEntry     = true;
        V.ModalCaption      = "Edit Employee Info";
        V.Action            = "ShowDataEntry";


        await ChildAction.InvokeAsync();
    }


    private async Task OnImageSelected(InputFileChangeEventArgs args)
    {

        V.ImagePreview  = null;
        V.ImageBytes    = null;
        V.ImageFileName = null;

        if (V.EmpmasId == 0)
        {
            NotificationRef.Show("To proceed with image uploading, please edit the employee information and click Save.", ThemeConstants.Notification.ThemeColor.Info);
            return;
        }

        var file = args.File;

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!AllowedExtensions.Contains(extension))
        {
            NotificationRef.Show("Only JPG, JPEG, PNG, and WEBP images are allowed.", ThemeConstants.Notification.ThemeColor.Warning);
            return;
        }

       

        if (file.Size > MaxFileSize)
        {
            NotificationRef.Show("Image must not exceed 2 MB.", ThemeConstants.Notification.ThemeColor.Warning);
            return;
        }

        try
        {
            using var memoryStream = new MemoryStream();

            await file.OpenReadStream(MaxFileSize).CopyToAsync(memoryStream);

            V.ImageBytes        = memoryStream.ToArray();
            V.ImageFileName     = Path.GetFileName(file.Name);

            var contentType     = extension switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png" => "image/png",
                ".webp" => "image/webp",
                _ => "application/octet-stream"
            };

            V.ImagePreview = $"data:{contentType};base64,{Convert.ToBase64String(V.ImageBytes)}";


            if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
            {
                await _03UploadImage(contentType);
            }
        }
        catch (Exception ex)
        {
            V.ImageBytes        = null;
            V.ImagePreview      = null;
            V.ImageFileName     = null;

            NotificationRef.Show("Unable to process image.", ThemeConstants.Notification.ThemeColor.Warning);
        }
    }

    private async Task _03UploadImage(string contentType)
    {


        if (string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
        {
            return;
        }


        if (V.ImageBytes == null || string.IsNullOrWhiteSpace(V.ImageFileName))
            return;

        try
        {
            V.IsLoading = true;
            await ChildAction.InvokeAsync();

            var fileId = await _googledrive._03UploadEmployeeImage(V.Empmas.EmpNumber, V.ImageBytes, V.ImageFileName, contentType);

            if (!string.IsNullOrWhiteSpace(fileId))
            {
                var empmasPicDtls = new EmpmaspicModel()
                {
                    EmpmasId        = V.EmpmasId,         
                    PicName         = V.ImageFileName?.Length > 45 ? V.ImageFileName.Substring(0, 45) : V.ImageFileName,
                    PicAddress      = fileId,               
                    Category        = "Profile",
                    Validity        = null,
                    Mode            = 0,                  
                    Created         = DateTime.Now,
                    UploadedBy      = Uc.OempNumber
                };


                if(V.EmpmasPic.Id == 0)
                {
                    //Insert
                    V.EmpmasPic =  await _emppic._01(empmasPicDtls, Uc.SchemaUserPis, Uc.Conn);
                }
                else
                {
                    //Update
                    V.EmpmasPic = await _emppic._03(V.EmpmasPic.Id, empmasPicDtls, Uc.SchemaUserPis, Uc.Conn);
                }

                NotificationRef.Show("Image uploaded successfully.", ThemeConstants.Notification.ThemeColor.Success);

            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Image upload failed.", ThemeConstants.Notification.ThemeColor.Error);


            V.ImageBytes = null;
            V.ImagePreview = null;
            V.ImageFileName = null;
        }
        finally
        {
            V.Action = "EndLoading";
            await ChildAction.InvokeAsync();
        }
    }




    private async Task _04DeleteEmployeeImage()
    {

        @if (string.IsNullOrWhiteSpace(V.ImagePreview)) return;
        try

        {
             V.IsLoading = true;
             await ChildAction.InvokeAsync();


            await _googledrive._04DeleteEmployeeImage(V.EmpmasPic.PicAddress);
            await _emppic._04(V.EmpmasPic.Id, Uc.SchemaUserPis, Uc.Conn);

            // Clear image preview
            V.ImagePreview      = null;
            V.ImageBytes        = null;
            V.ImageFileName     = null;
            V.EmpmasPic         = new();

            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef.Show("Unable to delete image.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
             V.Action = "EndLoading";
             await ChildAction.InvokeAsync();
        }

    }
}

