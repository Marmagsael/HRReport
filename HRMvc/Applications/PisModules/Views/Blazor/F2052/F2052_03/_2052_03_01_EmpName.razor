@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._90_Utils.Interface
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Models._90_Utils



<RadzenNotification />
<div class="w-100 p-3 bg-lightgray ">

    @* --- Employee Name ---------------- *@
    @if (V.Empmas?.EmpLastNm?.Length > 0)
    {
        <div class="mb-3">
            <div class="d-flex gap-4">
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90 ">@V.Empmas.EmpLastNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Last name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.EmpFirstNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">First name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.EmpMidNm &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Mid. name</div>
                </div>
                <div>
                    <div class="fw-bold border-bottom pb-1 fs-5 op-90">@V.Empmas.Suffix &nbsp;</div>
                    <div class="text-uppercase text-muted fw-medium mt-1" style="font-size:.7rem; letter-spacing:.03em;">Suffix</div>
                </div>
            </div>
        </div>
    }

    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>
        <div class="d-flex gap-5">
            @* --- Picture ------------- *@
            <div class="d-flex align-items-center justify-content-center" style="width:180px;">
                <div class="rounded-3 border bg-light d-flex align-items-center justify-content-center overflow-hidden"
                     style="height:160px; width:160px;">
                    <img class="img-fluid" alt="Employee image" src="images/employee.png" height="90" width="90">
                </div>
            </div>
            @* --- Fields ------------- *@
            <div class="flex-grow-1 mt-3">
                @* --- System Id *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-fingerprint text-center field-icon" style="width:16px;"></i> System ID
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas.UserId</div>
                </div>

                @* --- Email Address *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-envelope text-center field-icon" style="width:16px;"></i> Email
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas!.Email</div>
                </div>

                @* --- Emp Number *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-hashtag text-center field-icon" style="width:16px;"></i> Emp. no.
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas!.EmpNumber</div>
                </div>

                @* --- Position *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-briefcase text-center field-icon" style="width:16px;"></i> Position
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas?.PositionName</div>
                </div>

                @* --- Status *@
                <div class="d-flex align-items-center mb-2">
                    <div class="text-uppercase text-muted fw-medium d-flex align-items-center gap-2" style="width:130px; font-size:.8rem; letter-spacing:.03em; white-space:nowrap;">
                        <i class="fa-solid fa-circle-info text-center field-icon" style="width:16px;"></i> Status
                    </div>
                    <div class="flex-grow-1 small border-bottom pb-1" style="min-height:22px;">@V.Empmas?.EmpStatus</div>
                </div>

                @* --- Edit / Upload *@
                @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
                {
                    <div class="d-flex align-items-center">
                        <div style="width:130px;">&nbsp;</div>
                        <div class="flex-grow-1 d-flex gap-3">
                            <span class="msds-link small" role="button" @onclick="EditEmpmas">Edit</span>
                            <span class="msds-link small" role="button">Upload image</span>
                        </div>
                    </div>
                }

            </div>
        </div>
    </RadzenTemplateForm>
</div>
@inject NotificationService NotificationService
@inject I_00MainDA _main;
@inject IEmpmovementDataAccess _empMovement;
@inject IMsdsDataAccess _msds;

@code {

    bool popup = true;

    [Parameter]
    public V2052 V { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }

    List<UsersModel?>? users = new();
    string? errorEmail = "";



    async void EditEmpmas()
    {
        errorEmail = string.Empty;
        V.Action = "EditEmpmas";
        V.EmpmasToEdit = V.EmpmasToEditMapper(V.Empmas!, V.EmpmasToEdit!);
        V.SelectedEmpnumber = V.EmpmasToEdit.EmpNumber;
        V.IsNewEntry = false;
        V.IsEmailValid = true;
        V.IsEmpNoValid = true;
        V.ShowDataEntry = true;
        await ChildAction.InvokeAsync();
    }

    async void MakeALink()
    {
        errorEmail = string.Empty;
        if (V.Empmas == null) return;
        if (V.Empmas.Email == null) return;

        string email = V.Empmas.Email?.Trim() ?? string.Empty;
        // userid = V.Empmas.Id;
        users = await _main._02UsersByEmailLst(email);
        if (users == null) errorEmail = "Email is unused.";
        else if (users.Count == 0) errorEmail = "Email is unused.";
        StateHasChanged();

        await ChildAction.InvokeAsync();

    }

    void Log(string eventName, string value)
    {
        //console.Log($"{eventName}: {value}");
    }

    void OnSubmit(OEmpmasModel model)
    {
        //Log("Submit", JsonSerializer.Serialize(model, new JsonSerializerOptions() { WriteIndented = true }));
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        //Log("InvalidSubmit", JsonSerializer.Serialize(args, new JsonSerializerOptions() { WriteIndented = true }));
    }

    async void SendRequest(UsersModel? user)
    {
        if (user == null) return;

        Uc_accessreqModel? uca = new()
        {
            EmpmasId = user.Id,
            Requestedbyid = V.userid,
            Ucrequestingid = V.defcoid
        };

        var res = await _main._01Uc_Access(uca, "Main", V.conn!);


        if (res.FirstOrDefault()?.EmpmasId > 0)
        {

            var empMovement = new EmpmovementModel()
            {
                Date = DateTime.Now,
                Created = DateTime.Now,
                Dtls = "Send Invite",
                // EmpmasId = V.Empmas?.Id ?? 0,
                Mode = "Invite",
                Refno = res.FirstOrDefault()?.Id.ToString(),
                Userid = V.userid
            };

            var resEmpMovement = await _empMovement._01(empMovement, V.pisdb!, V.conn!);

            V.EmpmovementList?.Add(resEmpMovement);
        }

        // =====================================
        // Send notification via email =========
        var email = new EmailModel
        {
            Type = "Profile Request",
            Subject = "Verify and Link Your Profile",
            CompanyName = res.FirstOrDefault()?.CompanyName,
            SenderName = res.FirstOrDefault()?.RequestorFirstName,
            SenderEmail = res.FirstOrDefault()?.RequestorEmail,
            RecipientName = res.FirstOrDefault()?.EmpmasFirstName,
            RecipientEmail = res.FirstOrDefault()?.EmpmasEmail,
        };

        await _msds.SendEmail(email);


        //users = new();
        V.Action = "SendRequest";
        ShowNotification(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Success",
            Detail = $"Successfully sent a request to {user.AFullName}.",
            Duration = 4000
        });

        await ChildAction.InvokeAsync();
    }

    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
}


<style>
    .field-icon {
        color: rgb(0,128,192);
        opacity: 0.7;
    }
</style>