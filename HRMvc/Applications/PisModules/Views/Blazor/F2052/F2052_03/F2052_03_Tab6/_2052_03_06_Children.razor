@using HRApiLibrary.DataAccess._10_Pis.Interface

@inject NotificationService _NotificationService
@inject DialogService _DialogService

<RadzenFieldset Text="Children">
    @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
    {
        <div class="p-2 bordered mb-2 w-100">
            <RadzenButton ButtonStyle="ButtonStyle.Success"
                          Icon="add_circle_outline"
                          Text="New Entry"
                          Click="@InsertRow"
                          Disabled="@(editMode || isLoading)" />
        </div>
    }

    <div class="custom-grid mt-2">
        <RadzenDataGrid Data="@V.Children"
                        TItem="OChildrenModel"
                        @ref="V.ChildrenGrid"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        ColumnWidth="200px"
                        IsLoading="isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="OChildrenModel"
                                      Context="OChildrenModel"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="100%">
                    <HeaderTemplate>
                        <RadzenRow Gap="0" Style="padding-inline-end:1rem;">
                            <RadzenColumn Size="8" class="custom-grid-md">Name</RadzenColumn>
                            <RadzenColumn Size="4" class="custom-grid-md">Birthday</RadzenColumn>
                        </RadzenRow>
                    </HeaderTemplate>

                    <Template Context="rec">
                        @* ======= Small Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Name" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Name" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Birthday" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDatePicker TValue="DateTime?" @bind-Value="rec.BDay" Disabled="true" DateFormat="MMM dd, yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow>
                                <RadzenColumn Size="8">@rec.Name</RadzenColumn>
                                <RadzenColumn Size="4">@rec.BDay?.ToString("MMM dd, yyyy")</RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </Template>

                    <EditTemplate Context="rec">
                        @* ======= Small Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Name" Component="ChildNameSm" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Name" class="w-100" Name="ChildNameSm" MaxLength="60" />
                                        <RadzenRequiredValidator Component="ChildNameSm" Text="Name is required" Popup="true" Style="position:absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Birthday" Component="ChildBDaySm" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDatePicker TValue="DateTime?" @bind-Value="rec.BDay" Name="ChildBDaySm" DateFormat="MMM dd, yyyy" />
                                        <RadzenRequiredValidator Component="ChildBDaySm" Text="Birthday is required" Popup="true" Style="position:absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow Gap=".3rem">
                                <RadzenColumn Size="8">
                                    <RadzenTextBox @bind-Value="rec.Name" Name="ChildNameLg" class="w-100" MaxLength="60" Style="display:block" />
                                    <RadzenRequiredValidator Component="ChildNameLg" Text="Name is required" Popup="true" Style="position:absolute;" />
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenDatePicker TValue="DateTime?" @bind-Value="rec.BDay" Name="ChildBDayLg" DateFormat="MMM dd, yyyy" class="w-100" Style="display:block" />
                                    <RadzenRequiredValidator Component="ChildBDayLg" Text="Birthday is required" Popup="true" Style="position:absolute;" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* Actions Column *@
                <RadzenDataGridColumn TItem="OChildrenModel"
                                      Context="OChildrenModel"
                                      Filterable="false"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center"
                                      Title="Actions"
                                      Frozen="true"
                                      FrozenPosition="FrozenColumnPosition.Right"
                                      Width="120px">
                    <Template Context="rec">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditRow(rec))" @onclick:stopPropagation="true" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" @onclick:stopPropagation="true" />
                    </Template>
                    <EditTemplate Context="rec">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => SaveRow(rec))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => CancelEdit(rec))" class="my-1 ms-1" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</RadzenFieldset>

@inject IOChildrenDataAccess _empmas

@code {

    string? empnumber = string.Empty;

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    List<OChildrenModel?>? ChildrenToInsert = new();
    List<OChildrenModel?>? ChildrenToUpdate = new();
    string? errorMsg = string.Empty;
    bool isLoading = true;
    bool editMode = false;

    OChildrenModel? recBackup;

    protected override async Task OnParametersSetAsync()
    {
        if (empnumber != V.SelectedEmpnumber)
        {
            empnumber = V.SelectedEmpnumber;
            await Task.Delay(250);
            V.Children = await _empmas._02(V.SelectedEmpnumber, V.pisdb!, V.conn!) ?? new();
        }
        isLoading = false;
        StateHasChanged();
    }

    //-- InsertRow ----------------
    private async Task InsertRow()
    {
        errorMsg = string.Empty;
        Reset();

        var rec = new OChildrenModel();
        rec.EmpNumber = V.SelectedEmpnumber;

        ChildrenToInsert!.Add(rec);
        await V.ChildrenGrid!.InsertRow(rec);
        editMode = true;
    }

    //-- Reset ----------------
    private void Reset()
    {
        ChildrenToInsert!.Clear();
        ChildrenToUpdate!.Clear();
    }

    //-- Reset ----------------
    private void Reset(OChildrenModel rec)
    {
        ChildrenToInsert!.Remove(rec);
        ChildrenToUpdate!.Remove(rec);
    }

    //-- Edit Row ----------------
    private async Task EditRow(OChildrenModel rec)
    {
        editMode = true;

        if (V.ChildrenGrid != null)
        {
            Reset();
            ChildrenToUpdate?.Add(rec);

            recBackup = new OChildrenModel
            {
                EmpNumber = rec.EmpNumber,
                Name = rec.Name,
                BDay = rec.BDay
            };

            await V.ChildrenGrid.EditRow(rec);
        }
    }

    //-- Delete Row ----------------
    private async Task DeleteRow(OChildrenModel rec)
    {
        if (V.Children == null) return;
        if (V.ChildrenGrid == null) return;
        if (rec == null) return;

        Reset(rec);

        if (V.Children.Contains(rec))
        {
            var option = await _DialogService.Confirm(
                $"Delete {rec.Name}'s record?", "Confirm Delete",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

            if (option == true)
            {
                V.Children.Remove(rec);

                try
                {
                    await _empmas._04(V.SelectedEmpnumber, V.pisdb!, V.conn!);

                    foreach (var item in V.Children)
                    {
                        if (item != null)
                            await _empmas._01(item, V.pisdb!, V.conn!);
                    }

                    ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Successfully deleted a record.",
                        Detail = "Record has been deleted from the list.",
                        Duration = 4000
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);
                    ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Unable to delete",
                        Detail = "Something went wrong while deleting. Please try again.",
                        Duration = 6000
                    });
                    return;
                }
            }
        }
        else
        {
            V.ChildrenGrid.CancelEditRow(rec);
        }

        await V.ChildrenGrid.Reload();
        editMode = false;
        errorMsg = string.Empty;
    }

    //-- Cancel Edit ----------------
    private async Task CancelEdit(OChildrenModel rec)
    {
        errorMsg = string.Empty;
        if (V.ChildrenGrid == null) return;

        bool isNew = ChildrenToInsert!.Contains(rec);

        Reset(rec);
        editMode = false;

        if (isNew)
        {
            V.Children?.Remove(rec);
        }
        else if (recBackup != null)
        {
            rec.EmpNumber = recBackup.EmpNumber;
            rec.Name = recBackup.Name;
            rec.BDay = recBackup.BDay;
        }

        V.ChildrenGrid.CancelEditRow(rec);
        recBackup = null;

        await V.ChildrenGrid.Reload();
    }

    //-- Save Row ----------------
    private async Task SaveRow(OChildrenModel rec)
    {
        if (V.ChildrenGrid == null) return;
        if (rec == null) return;

        if (!SafeToSave(rec))
        {
            await V.ChildrenGrid.UpdateRow(rec);
            return;
        }

        try
        {
            V.Children ??= new();
            if (!V.Children.Contains(rec))
                V.Children.Add(rec);

            await V.ChildrenGrid.UpdateRow(rec);

            await _empmas._04(V.SelectedEmpnumber, V.pisdb!, V.conn!);

            foreach (var item in V.Children!)
            {
                if (item != null)
                    await _empmas._01(item, V.pisdb!, V.conn!);
            }

            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Successfully saved",
                Detail = "Record has been successfully saved.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Unable to save",
                Detail = "Something went wrong while saving. Please try again.",
                Duration = 6000
            });
            return;
        }

        recBackup = null;
        editMode = false;
        errorMsg = string.Empty;
    }

    //-- Safe to Save ----------------
    private bool SafeToSave(OChildrenModel rec)
    {
        if (string.IsNullOrWhiteSpace(rec.Name)) return false;
        if (rec?.BDay == null) return false;
        return true;
    }

    private void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }
}