@using HRApiLibrary.DataAccess._10_Pis.Interface
@inject NotificationService _NotificationService
@inject DialogService _DialogService
@inject IOEmployDataAccess _empmas

<div class="p-2">
    <div class="position-sticky sticky-top bg-white pt-1" style="top:0; z-index:1000;">

        <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Employment History" />
            <div class="h-10p"></div>
            @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
            {
                <div class="p-2 bordered mb-2 w-100">
                    <button type="button"
                            class="card p-1 mb-cbtn mb-cbtn-blue d-flex w-100p"
                            @onclick="InsertRow"
                            disabled="@(editMode || isLoading)">
                        <div class="d-flex align-items-center justify-content-center">
                            <span class="p-0">Save</span>
                        </div>
                    </button>
                </div>
            }

     </div>
    <div class="custom-grid mt-2">
        <RadzenDataGrid Data="@V.Employments"
                        TItem="OEmployModel"
                        @ref="V.EmploymentGrid"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        ColumnWidth="200px"
                        IsLoading="isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="OEmployModel"
                                      Context="OEmployModel"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="100%">
                    <HeaderTemplate>
                        <RadzenRow Gap="0" Style="padding-inline-end:1rem;">
                            <RadzenColumn Size="5" class="custom-grid-sm">Details</RadzenColumn>
                            <RadzenColumn Size="5" class="custom-grid-md">Company Name</RadzenColumn>
                            <RadzenColumn Size="4" class="custom-grid-md">Position</RadzenColumn>
                            <RadzenColumn Size="3" class="custom-grid-md">Salary</RadzenColumn>
                        </RadzenRow>
                    </HeaderTemplate>

                    <Template Context="rec">
                        @* ======= Small Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Company Name" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Comp" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Address" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Addr1" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Tel No." /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Tel" Disabled="true" MaxLength="15" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Position" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Posi" Disabled="true" class="fw-bold" MaxLength="75" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="From" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.From_" Disabled="true" MaxLength="10" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="To" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.To_" Disabled="true" MaxLength="10" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Salary" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.Sal" Format="#,##0.00" Disabled="true" Max="99999999.99m" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Remarks" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Rem1" Disabled="true" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow>
                                <RadzenColumn Size="5">
                                    <div>@rec.Comp</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                Address: <span class="text-muted text-decoration-underline" style="word-break:break-word;white-space:normal;">@rec.Addr1</span>
                                            </RadzenColumn>
                                            @if (!string.IsNullOrWhiteSpace(rec.Tel))
                                            {
                                                <RadzenColumn Size="12">
                                                    Tel No.: <span class="text-muted text-decoration-underline">@rec.Tel</span>
                                                </RadzenColumn>
                                            }
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <div class="fw-bold">@rec.Posi</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                From: <span class="text-muted text-decoration-underline">@rec.From_</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12">
                                                To: <span class="text-muted text-decoration-underline">@rec.To_</span>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="3">
                                    <div>@rec.Sal.ToString("N")</div>
                                    @if (!string.IsNullOrWhiteSpace(rec.Rem1))
                                    {
                                        <div class="mt-1">
                                            Remarks: <span class="text-muted text-decoration-underline" style="word-break:break-word;white-space:normal;">@rec.Rem1</span>
                                        </div>
                                    }
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </Template>

                    <EditTemplate Context="rec">
                        @* ======= Small Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-sm">

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Company Name" Component="CompNameSm" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Comp" Change="@(args => rec.Comp = args.ToString().Trim())" class="w-100" Name="CompNameSm" MaxLength="60" />
                                        <RadzenRequiredValidator Component="CompNameSm" Text="Company Name is required" Popup="true" Style="position:absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Address" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Addr1" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Tel No." /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Tel" MaxLength="15" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Position" Component="PosSm" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Posi" Change="@(args => rec.Posi = args.ToString().Trim())" class="w-100" Name="PosSm" MaxLength="75" />
                                        <RadzenRequiredValidator Component="PosSm" Text="Position is required" Popup="true" Style="position:absolute;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="From" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.From_" MaxLength="10" Name="FromSm" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="To" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.To_" MaxLength="10" Name="ToSm" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Salary" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.Sal" Max="99999999.99m" Format="#,##0.00" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4"><RadzenLabel Text="Remarks" /></RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.Rem1" MaxLength="60" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>

                        @* ======= Large Screen ========= *@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow Gap=".3rem">
                                <RadzenColumn Size="5">
                                    <RadzenTextBox @bind-Value="rec.Comp" Change="@(args => rec.Comp = args.ToString().Trim())" class="w-100" Name="CompNameLg" MaxLength="60" Style="display:block" />
                                    <RadzenRequiredValidator Component="CompNameLg" Text="Company Name is required" Popup="true" Style="position:absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Address" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Addr1" class="w-100" MaxLength="60" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12">
                                                <RadzenFormField AllowFloatingLabel="false" Text="Tel No." Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenTextBox @bind-Value="rec.Tel" class="w-100" MaxLength="15" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="4">
                                    <RadzenTextBox @bind-Value="rec.Posi" Change="@(args => rec.Posi = args.ToString().Trim())" class="w-100" Name="PosLg" MaxLength="75" Style="display:block; width:100%" />
                                    <RadzenRequiredValidator Component="PosLg" Text="Position is required" Popup="true" Style="position:absolute;" />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="12" SizeMD="6">
                                                <RadzenFormField AllowFloatingLabel="false" Text="From" Variant="Variant.Outlined"  class="custom-form-field" >
                                                    <RadzenTextBox @bind-Value="rec.From_" class="w-100" MaxLength="10" Name="FromLg" Style="display:block" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="6">
                                                <RadzenFormField AllowFloatingLabel="false" Text="To" Variant="Variant.Outlined"  class="custom-form-field" >
                                                    <RadzenTextBox @bind-Value="rec.To_" class="w-100" MaxLength="10" Name="ToLg" Style="display:block; width:100%" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="3">
                                    <RadzenNumeric @bind-Value="rec.Sal" Format="#,##0.00" class="w-100" Max="99999999.99m" />
                                    <div class="mt-1">
                                        <RadzenFormField AllowFloatingLabel="false" Text="Remarks" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                            <RadzenTextBox @bind-Value="rec.Rem1" class="w-100" MaxLength="60" />
                                        </RadzenFormField>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* Actions Column *@
                <RadzenDataGridColumn TItem="OEmployModel"
                                      Context="OEmployModel"
                                      Filterable="false"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center"
                                      Title="Actions"
                                      Frozen="true"
                                      FrozenPosition="FrozenColumnPosition.Right"
                                      Width="120px">
                    <Template Context="rec">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditRow(rec))" @onclick:stopPropagation="true" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" @onclick:stopPropagation="true" />
                    </Template>
                    <EditTemplate Context="rec">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => SaveRow(rec))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => CancelEdit(rec))" class="my-1 ms-1" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {

    string? empnumber = string.Empty;

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    List<OEmployModel?>? employmentsToInsert = new();
    List<OEmployModel?>? employmentsToUpdate = new();
    string? errorMsg = string.Empty;
    bool isLoading = true;
    bool editMode = false;


    OEmployModel? recBackup;


    protected override async Task OnParametersSetAsync()
    {
        if (empnumber != V.SelectedEmpnumber)
        {
            empnumber = V.SelectedEmpnumber;
            await Task.Delay(250);
            V.Employments = await _empmas._02(V.SelectedEmpnumber, V.pisdb!, V.conn!) ?? new();
        }
        isLoading = false;
        StateHasChanged();
    }

    //-- InsertRow ----------------
    private async Task InsertRow()
    {
        errorMsg = string.Empty;
        Reset();

        var rec = new OEmployModel();
        rec.EmpNumber = V.SelectedEmpnumber;
        employmentsToInsert!.Add(rec);
        await V.EmploymentGrid!.InsertRow(rec);
        editMode = true;
    }

    //-- Reset ----------------
    private void Reset()
    {
        employmentsToInsert!.Clear();
        employmentsToUpdate!.Clear();
    }

    //-- Reset ----------------
    private void Reset(OEmployModel rec)
    {
        employmentsToInsert!.Remove(rec);
        employmentsToUpdate!.Remove(rec);
    }

    //-- Edit Row ----------------
        private async Task EditRow(OEmployModel  rec)
    {
        editMode = true;

        if (V.EmploymentGrid != null)
        {
            Reset();
            employmentsToUpdate?.Add(rec);

            recBackup = new OEmployModel
            {
                EmpNumber = rec.EmpNumber,
                Comp    = rec.Comp,
                Addr1   = rec.Addr1,
                Addr2   = rec.Addr2,
                Tel     = rec.Tel,
                Posi    = rec.Posi,
                From_   = rec.From_,
                To_     = rec.To_,
                Sal     = rec.Sal,
                Rem1    = rec.Rem1
            };

            await V.EmploymentGrid.EditRow(rec);
        }
    }

    //-- Delete Row ----------------
    private async Task DeleteRow(OEmployModel rec)
    {
        if (V.Employments == null) return;
        if (V.EmploymentGrid == null) return;

        Reset(rec);

        if (V.Employments.Contains(rec))
        {
            if (rec != null)
            {
                var option = await _DialogService.Confirm("Delete " + rec.Comp + " employment record?", "Confirm Delete",
                    new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
                if (option == true)
                {
                    await _empmas._04(rec.EmpNumber, rec.Comp, rec.Posi, V.pisdb!, V.conn!);
                    V.Employments.Remove(rec);
                    ShowSuccess("Successfully deleted", "Record has been successfully deleted.", 4000);
                }
            }
        }
        else
        {
            V.EmploymentGrid.CancelEditRow(rec);
        }
        await V.EmploymentGrid.Reload();
        editMode = false;
        errorMsg = string.Empty;
    }


    //-- Cancel Edit ----------------
    private async Task CancelEdit(OEmployModel rec)
    {
        errorMsg = string.Empty;
        if (V.EmploymentGrid == null) return;

        bool isNew = employmentsToInsert!.Contains(rec);

        Reset(rec);
        editMode = false;

        if (isNew)
        {
            V.Employments?.Remove(rec);
        }
        else if (recBackup != null)
        {
            rec.EmpNumber = recBackup.EmpNumber;
            rec.Comp    = recBackup.Comp;
            rec.Posi    = recBackup.Posi;
            rec.From_   = recBackup.From_;
            rec.To_     = recBackup.To_;
            rec.Rem1    = recBackup.Rem1;
            rec.Addr1   = recBackup.Addr1;
        }

        V.EmploymentGrid.CancelEditRow(rec);
        recBackup = null;

        await V.EmploymentGrid.Reload();
    }

    //-- Save Row ----------------
    private async Task SaveRow(OEmployModel rec)
    {
        if (V.EmploymentGrid == null || rec == null) return;
        if (!SafeToSave(rec))
        {
            await V.EmploymentGrid.UpdateRow(rec);
            return;
        }
        try
        {
            bool isNew = employmentsToInsert!.Contains(rec);
            var res = await _empmas._02CheckExisting(rec.EmpNumber, rec.Comp, rec.Posi,  V.pisdb!, V.conn!);
            bool exists = res != null && res.Count > 0;

            if (exists)
            {
                bool isSameAsOriginal = !isNew && recBackup != null
                    && recBackup.Posi == rec.Comp
                    && recBackup.Posi == rec.Posi;

                if (!isSameAsOriginal)
                {
                    ShowError("Duplicate entry", "A record with the same company and position already exists.", 5000);
                    return;
                }
            }

            if (isNew)
            {
                await _empmas._01(rec, V.pisdb!, V.conn!);
                V.Employments!.Add(rec);
            }
            else
            {
                await _empmas._03(recBackup.EmpNumber, recBackup.Comp, recBackup.Posi, rec, V.pisdb!, V.conn!);
            }

            await V.EmploymentGrid.UpdateRow(rec);      
            ShowSuccess("Successfully saved", "Record has been successfully saved.", 4000);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to save", "Something went wrong while saving. Please try again.", 6000);
            return;
        }

        recBackup = null;
        editMode = false;
        errorMsg = string.Empty;
    }



    //-- Safe to Save ----------------
    private bool SafeToSave(OEmployModel rec)
    {
        if (string.IsNullOrWhiteSpace(rec.Comp)) return false;
        if (string.IsNullOrWhiteSpace(rec.Posi)) return false;
        return true;
    }

    void ShowSuccess(string summary, string detail, int duration = 5000) =>
      _NotificationService.Notify(new NotificationMessage
      {
          Severity = NotificationSeverity.Success,
          Summary = summary,
          Detail = detail,
          Duration = duration
      });

    void ShowError(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });
}

