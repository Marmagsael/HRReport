@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis


<div class="p-2">
    <RadzenTemplateForm TItem="OEmpmasModel" Data=@V.Empmas Submit=@OnSubmit InvalidSubmit=@OnInvalidSubmit>
        <div class="position-sticky sticky-top bg-white pt-1" style="top:0; z-index:9;">
            <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Security" />

            <div class="h-10p"></div>

            @if (!string.IsNullOrWhiteSpace(V.Empmas.EmpNumber))
            {
                <div class="p-2 bordered mb-2 w-100">

                    <button type="submit" class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 px-4 ">
                        <div class="d-flex gap-1 align-items-center justify-content-center">
                            <span class="fw-semibold"><small>Save</small></span>
                        </div>
                    </button>
                </div>
            }
        </div>




        <div class="h-10p"></div>
        <RadzenFieldset Text="******">
            @* ----- Sec License (varchar(15))----------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Security License </div>
                <div class="w-80">
                    <RadzenTextBox @bind-Value=@V.Empmas.SecLicense class="form-control" Name="SecurityLicense" MaxLength="15" Style="width:100%" />
                    <RadzenRequiredValidator Component="SecurityLicense" Text="SecurityLicense is required" Style="color: red; display:block" />
                </div>
            </div>

            @* ----- Expiration -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Expiration </div>
                <div class="w-30">
                    <RadzenDatePicker @bind-Value=@V.Empmas.Licexpire Name="Licexpire" DateFormat="MMMM dd, yyyy" Style="width:100%" />
                    <RadzenRequiredValidator Component="Licexpire" Text="License Expiration is required" Style="color: red; display:block" />
                </div>
            </div>

            @* ----- Badge No -----------------------*@
             <div class="w-100 d-flex p-1">
                <div class="w-20 small">Badge No. </div>
                <div class="w-30">
                    <RadzenTextBox @bind-Value=@V.Empmas.BadgeNo class="form-control" Name="BadgeNo" MaxLength="10" Style="width:100%" />
                    <RadzenRequiredValidator Component="BadgeNo" Text="Badge No. is required" Style="color: red; display:block" />
                </div>
            </div>


            @* ----- OP No -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">OP No. </div>
                <div class="w-30">
                    <RadzenTextBox @bind-Value=@V.SecLicense.Opno class="form-control" Name="OpNo" MaxLength="25" Style="width:100%" />
                </div>
            </div>


            @* ----- SBR No -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">SBR No. </div>
                <div class="w-30">
                    <RadzenTextBox @bind-Value=@V.SecLicense.Sbrno class="form-control" Name="SbrNo" MaxLength="25" Style="width:100%" />
                </div>
            </div>
           
        </RadzenFieldset>



    <div class="h-10p"></div>
       <RadzenFieldset Text="LICENSE VERIFICATION">

            @* ----- Last Edited   -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Last Edited  </div>
                <div class="w-30">
                    <RadzenDatePicker @bind-Value=@V.SecLicense.DateModified  Style="width:100%"  Disabled />
                </div>
            </div>

          


            @* ----- By  -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">By</div>
                <div class="w-50">
                    <RadzenTextBox Value="@(string.IsNullOrWhiteSpace(V.SecLicense.UserName)
                                           ? V.SecLicense.User
                                           : V.SecLicense.UserName)"
                                   Style="width:100%"
                                   Disabled/>
                </div>
            </div>


            @* ----- Show Logs button  -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">&nbsp;</div>
                <div class="w-30">
                    <button type="button" class="card  flex-fill text-center h-40p mb-btn mb-btn-gray p-2 px-4 " @onclick="() => ShowLicenseVerifLogs()">
                        <div class="d-flex gap-1 align-items-center justify-content-center">
                            <span class="fw-semibold"><small>Show Logs</small></span>
                        </div>
                    </button>
                </div>
            </div>


           

            <hr/>

            @* ----- Validation Status -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Validation Status </div>
                <div class="w-30">
                    <RadzenDropDown TValue="string"
                                    @bind-Value="V.SecLicense.ValStatus"
                                    Data="@V.LicverStatuses"
                                    TextProperty="LicverStatus"
                                    ValueProperty="LicverStatus"
                                    class="w-100" />
                </div>
            </div>

            @* ----- Date Validated -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Date Validated </div>
                <div class="w-30">
                    <RadzenDatePicker @bind-Value=@V.SecLicense.Validated Style="width:100%" DateFormat="MMMM/dd/yyyy" ShowTime="false" />
                </div>
            </div>


            @* ----- Date ReValidated -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Date Re-validated </div>
                <div class="w-30">
                    <RadzenDatePicker @bind-Value=@V.SecLicense.Revalidated Style="width:100%" DateFormat="MMMM/dd/yyyy" ShowTime="false" />
                </div>
            </div>

            @* ----- Lic Date Issued -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Lic Date Issued</div>
                <div class="w-30">
                    <RadzenDatePicker @bind-Value=@V.SecLicense.LicDateIssued Style="width:100%" DateFormat="MMMM/dd/yyyy" ShowTime="false" />
                </div>
            </div>

        </RadzenFieldset>


        <div class="h-10p"></div>
       <RadzenFieldset Text="******">


            @* ----- Guard No Years -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Guard # of Yrs </div>
                <div class="w-30">
                    <RadzenTextBox @bind-Value=@V.Empmas.GuardNoYrs class="form-control" Name="GuardNoYrs" MaxLength="5" Style="width:100%" />
                    <RadzenRequiredValidator Component="GuardNoYrs" Text="Guard no of years is required" Style="color: red; display:block" />
                </div>
            </div>

            @* ----- Military No Years -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Military # of Yrs </div>
                <div class="w-30">
                    <RadzenTextBox @bind-Value=@V.Empmas.MilitaryNoYr class="form-control" Name="MilitaryNoYr" MaxLength="5" Style="width:100%" />
                    <RadzenRequiredValidator Component="MilitaryNoYr" Text="Military no of years is required" Style="color: red; display:block" />
                </div>
            </div>

            @* ----- Remarks -----------------------*@
            <div class="w-100 d-flex p-1">
                <div class="w-20 small">Remarks </div>
                <div class="w-80">
                    <RadzenTextBox @bind-Value=@V.Empmas.Remarks class="form-control"  MaxLength="150" Style="width:100%" />
                </div>
            </div>

        </RadzenFieldset>
    </RadzenTemplateForm>

</div>


@inject IOEmpmasDataAccess _empmas
@inject IOSeclicDataAccess _seclic
@inject IOSecliclogsDataAccess _secliclogs
@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();


    [CascadingParameter]
    public V2052 V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    async Task OnSubmit(OEmpmasModel model)
    {
        if (model == null) return;


        try
        {
            // Update  security records in empmas table ------
            var res = await _empmas._03_Security(V.SelectedEmpnumber, V.Empmas, Uc.OpisDb!, Uc.Conn!);


            V.SecLicense.Empnumber      = V.Empmas.EmpNumber;
            V.SecLicense.User           = Uc.UserName;
            V.SecLicense.DateModified   = DateTime.Now;




            // Insert or update  security records in seclic table ------
            var resLic      = await _seclic._01(V.SecLicense, Uc.OpisDb!, Uc.Conn!);

            if(!string.IsNullOrWhiteSpace(resLic.Empnumber)){

                V.SecLicense = resLic;

                var log = new OSecliclogsModel()
                {
                    EmpNumber      = resLic.Empnumber,
                    Sbrno          = resLic.Sbrno,
                    Opno           = resLic.Opno,
                    Validated      = resLic.Validated,
                    Vfee           = resLic.Vfee,
                    Revalidated    = resLic.Revalidated,
                    ValStatus      = resLic.ValStatus,
                    User           = resLic.User,
                    DateModified   = resLic.DateModified,
                    LicDateIssued  = resLic.LicDateIssued
                };


                // Insert  security logs records in secliclogs table ------
                var resLogs  = await _secliclogs._01(log, Uc.OpisDb!, Uc.Conn!);

            }

            NotificationRef.Show("Record has been successfully saved.", ThemeConstants.Notification.ThemeColor.Success);


        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);

        }


    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {

    }

    private async void ShowLicenseVerifLogs()
    {
        V.Action = "ShowLicVerificationLogsModal";
        await ChildAction.InvokeAsync();
    }


   

}