@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._00GeneralComponents.FormComponents
@using Telerik.SvgIcons
@using HRMvc.Applications.PisModules.Vars;

<div class="vh-max vh60">

        <TelerikCard Width="100%" Class="h-100">

            <CardHeader>
                <div class="d-flex  justify-content-between  align-items-center">
                    <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                       @onclick="ApplyStatus">
                        Apply Status
                    </button>
                </div>

            </CardHeader>

            <CardBody Class="p-0">

                <TelerikGrid @ref="@EmployeeStatusGridRef"
                                TItem="OEmpstatModel"
                                Data="@V.OEmpstats"
                                Height="400px"
                                Pageable="true"
                                Sortable="true"
                                FilterMode="@GridFilterMode.FilterMenu"
                                Resizable="true"
                                Reorderable="true"
                                Navigable="true"
                                SelectionMode="@GridSelectionMode.Multiple"
                                SelectedItems="@V.SelectedStatus"
                                SelectedItemsChanged="@OnCheckBoxClick"
                                OnRowClick="@OnRowClick"
                                @bind-PageSize="@PageSize">

                    <GridSettings>
                        <GridPagerSettings PageSizes="@PageSizes" />
                    </GridSettings>

                    <GridColumns>

                        <GridCheckboxColumn Width="50px"
                                            Resizable="false"
                                            SelectAll="true"
                                            SelectAllMode="@GridSelectAllMode.All" />

                    <GridColumn Field="@nameof(OEmpstatModel.Name)"
                                    Title="Status" />

                    </GridColumns>

                </TelerikGrid>

            </CardBody>

        </TelerikCard>
</div>



@inject IOEmpmas_visible_statusDataAccess _selectedEmpstat

@code {

    [CascadingParameter]
    public V2052 V { get; set; } = new();

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    private TelerikGrid<OEmpstatModel>? EmployeeStatusGridRef;

    private bool IsRowClickSelection { get; set; }


    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };






    private async Task OnCheckBoxClick(IEnumerable<OEmpstatModel?> selectedItems)
    {
        if (IsRowClickSelection)
        {
            IsRowClickSelection = false;
            return;
        }

        V.SelectedStatus = selectedItems?.ToList() ?? [];
    }


    private async Task OnRowClick(GridRowClickEventArgs args)
    {
        var status = (OEmpstatModel)args.Item;

        var selectedStatus = V.SelectedStatus.ToList(); // currently selected statuses
        var alreadySelected = selectedStatus.Any(x => x.Code == status.Code); // check whether the clicked row is already selected


        IsRowClickSelection = true;

        if (alreadySelected)
        {
            selectedStatus.RemoveAll(x => x.Code == status.Code); // deselect and remove from the list
        }
        else
        {
            selectedStatus.Add(status); // select and add from the list
        }

        V.SelectedStatus = selectedStatus;
        args.ShouldRender = true;

    }


    private async Task ApplyStatus()
    {
        var newSelections       = V.SelectedStatus.ToList();
        var previousSelections  = V.PreviousSelectedStatus;

        var toInsert = newSelections.Where(newStatus => !previousSelections.Any(oldStatus => oldStatus.Code == newStatus.Code)).ToList();
        var toRemove = previousSelections.Where(oldStatus => !newSelections.Any(newStatus => newStatus.Code == oldStatus.Code)).ToList();


        if (!toInsert.Any() && !toRemove.Any())
        {
            NotificationRef.Show("No changes to apply.", ThemeConstants.Notification.ThemeColor.Info);
            return;
        }


        var insertSuccess = true;
        var removeSuccess = true;


        if (toInsert.Any())
        {
            insertSuccess = await InsertStatus(toInsert);
        }

        if (toRemove.Any())
        {
            removeSuccess = await RemoveStatus(toRemove);
        }


        if (insertSuccess && removeSuccess)
        {
            V.PreviousSelectedStatus    = newSelections.ToList();
            V.SelectedStatus            = newSelections;

            NotificationRef.Show("Status has been updated.", ThemeConstants.Notification.ThemeColor.Success);
        }

        V.SearchValue   = string.Empty;
        V.Action        = "ReLoadEmployeeList";

        await ChildAction.InvokeAsync();
    }


    private async Task<bool> InsertStatus(List<OEmpstatModel?> data)
    {

        try
        {
            foreach (var s in data)
            {
                var status = new OEmpmas_visible_statusModel
                {
                    Empstat_ = s.Code
                };

                await _selectedEmpstat._01(status, Uc.OpisDb, Uc.Conn);
            }


            return true;
        }
        catch (Exception ex)
        {
           NotificationRef.Show("Unable to update status. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return false;
        }
    }


    private async Task<bool> RemoveStatus(List<OEmpstatModel?> data)
    {

        try
        {
            foreach (var s in data)
            {
                {
                    var status = new OEmpmas_visible_statusModel
                    {
                        Empstat_ = s.Code
                    };

                    await _selectedEmpstat._04(status, Uc.OpisDb, Uc.Conn);
                }
            }


            return true;
        }
        catch (Exception ex)
        {
            NotificationRef.Show("Unable to update status. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return false;
        }
    }


}
