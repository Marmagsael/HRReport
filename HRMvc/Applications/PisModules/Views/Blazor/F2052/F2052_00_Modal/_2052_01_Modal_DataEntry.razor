@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis


@inject NotificationService _NotificationService;
@inject DialogService _DialogService;
@inject IOEmpmasDataAccess _empmas

<div class="msds-modal">
    <div class="msds-modal-content" style="max-width: 980px;">
        <div class="modal-content  bg-opacity-75">

            <div class="modal-header  bg-opacity-75">
                <h1 class="modal-title fs-5">
                    @(V.IsNewEntry == true ? "Add New Employee" : "Update Employee")
                </h1>
                <button type="button" class="btn-close" @onclick="@(() => ShowHideModal(false))" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errormsg))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => errormsg = string.Empty)">
                        @errormsg
                    </RadzenAlert>
                }
                <_2052_01_DataEntry V="@V" ChildAction="ChildActionCatcher" />
            </div>

        </div>
    </div>
</div>


@code {

    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    string errormsg = string.Empty;

    async Task ShowHideModal(bool action)
    {

        if(action == false)
        {
            V.ShowDataEntry = false;
            V.IsNewEntry    = false;
            V.EmpmasToEdit  = new OEmpmasModel();
            await ChildAction.InvokeAsync();
        }

    }

    async Task ChildActionCatcher()
    {
        if (V == null) return;

        if (V.Action == "SaveEmpmas") await SaveUpdate();
        if (V.Action == "HideDataEntry") await ShowHideModal(false);
        if (V.Action == "SelectEmpmas") await SelectEmpmas();

        V.Action = "";
        V.ActionRef = string.Empty;
    }

    async Task SelectEmpmas()
    {
        await ChildAction.InvokeAsync();
    }

    async Task SaveUpdate()
    {
        if (await ValidateEmail() == false) return;


        try
        {
            if (V.IsNewEntry == true)
            {
                var res = await _empmas._01(V.EmpmasToEdit, V.pisdb, V.conn);
                V.Empmas = res;

                ShowNotification(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Succesfully saved",
                    Detail = "Record has been succefully saved.",
                    Duration = 5000
                });
            }
            else
            {
                var res = await _empmas._03_EmployeeName(V.SelectedEmpnumber, V.EmpmasToEdit, V.pisdb, V.conn);

                V.Empmas.EmpLastNm  = res.EmpLastNm;
                V.Empmas.EmpFirstNm = res.EmpFirstNm;
                V.Empmas.EmpMidNm   = res.EmpMidNm;
                V.Empmas.EmpAlias   = res.EmpAlias;
                V.Empmas.Suffix     = res.Suffix;
                V.Empmas.Email      = res.Email;

                ShowNotification(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Succesfully updated",
                    Detail = "Record has been succefully updated.",
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Unable to save",
                Detail = "Something went wrong while saving. Please try again.",
                Duration = 6000
            });
            return;
        }


        V.ShowDataEntry = false;
        await ChildAction.InvokeAsync();
    }

    async Task<bool?> ValidateEmail()
    {
        V.Action = "ValidateEmail";
        await ChildAction.InvokeAsync();
        return V.IsEmailValid; 
    }


   

   

    private void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }
}