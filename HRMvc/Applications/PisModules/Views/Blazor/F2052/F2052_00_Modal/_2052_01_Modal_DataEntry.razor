@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis

@inject NotificationService _NotificationService
@inject DialogService _DialogService
@inject I_00UsersAccess _user
@inject IOEmpmasDataAccess _oempmas
@inject I_10_EmpmasDataAccess _empmas

<div class="msds-modal">
    <div class="msds-modal-content" style="max-width: 980px;">
        <div class="modal-content bg-opacity-75">

            <div class="modal-header bg-opacity-75">
                <h1 class="modal-title fs-5">
                    @(V.IsNewEntry == true ? "Add New Employee" : "Update Employee")
                </h1>
                <button type="button" class="btn-close"
                        @onclick="@(() => ShowHideModal(false))"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <_2052_01_DataEntry V="@V" ChildAction="ChildActionCatcher" />
            </div>

        </div>
    </div>
</div>

@code {

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    private int? userId = 0;
    private int? empmasId = 0;
    private bool isSaving = false;
    private string oldEmail = string.Empty;

    async Task ChildActionCatcher()
    {
        if (V == null) return;

        var action = V.Action;
        V.Action = "";
        V.ActionRef = string.Empty;

        if (action == "CheckIfEmpNoExists") await CheckIfEmpNoExistsOnSecpis();
        if (action == "CheckIfEmailExists") await CheckIfEmailExists();
        if (action == "LinkEmployee") await CheckIfEmailExistOnUxCx();
        if (action == "SaveEmpmas") await SaveEmpmas();
        if (action == "HideDataEntry") await ShowHideModal(false);
    }

    async Task ShowHideModal(bool show)
    {
        if (show) return;

        V.ShowDataEntry = false;
        V.IsNewEntry    = false;
        V.IsEmpNoValid  = true;
        V.IsEmailValid  = true;
        V.IsSafeToSave  = false;
        V.EmpmasToEdit  = new OEmpmasModel();
        await ChildAction.InvokeAsync();
    }


    async Task SaveEmpmas()
    {
        if (await CheckIfEmpNoExistsOnSecpis() == false) return;
        await CheckIfEmailExists();
        await CheckIfEmailExistOnUxCx();
        if (V.IsSafeToSave == true)
        {
            if(empmasId == 0)
            {

            }
            else
            {

            } 
        }

        if(V.IsNewEntry == true)
        {
            await _oempmas._01  
        }
        else
        {
            
        }

    }

    async Task<bool> CheckIfEmpNoExistsOnSecpis()
    {
        if (string.IsNullOrWhiteSpace(V.EmpmasToEdit.EmpNumber))
        {
            V.IsEmpNoValid = false;
            ShowError("Employee number required", "Please enter an employee number.");
            return false;
        }

        if (V.IsNewEntry == false)
        {
            V.IsEmpNoValid = true;
            return true;
        }

        try
        {
            var res = await _oempmas._02EmpnumberOwnedByOthers(V.EmpmasToEdit.EmpNumber, V.pisdb, V.conn);
            bool isExist = res != null && res.Any();
            V.IsEmpNoValid = !isExist;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to validate employee number", "Something went wrong while checking the employee number. Please try again.");
            V.IsEmpNoValid = false;
        }

        return V.IsEmpNoValid ?? false;
    }

    bool IsEmailChanged()
    {
        var newEmail = V.EmpmasToEdit.Email?.Trim().ToLower() ?? string.Empty;
        var originalEmail = V.Empmas?.Email?.Trim().ToLower() ?? string.Empty;
        return V.IsNewEntry == true || originalEmail != newEmail;
    }

    async Task CheckIfEmailExists()
    {
        if (await CheckIfEmailExistsOnSecpis() == false) return;
        if (await CheckIfEmailExistOnMain() == false) return;
    }

    async Task<bool> CheckIfEmailExistsOnSecpis()
    {
        if (string.IsNullOrWhiteSpace(V.EmpmasToEdit.Email))
        {
            V.IsEmailValid = true;
            return true;
        }

        // Only re-check against other records if the email actually changed or this is a new entry
        if (!IsEmailChanged())
        {
            V.IsEmailValid = true;
            return true;
        }

        var newEmail = V.EmpmasToEdit.Email.Trim().ToLower();

        try
        {
            var res = await _oempmas._02EmailOwnedByOthers(V.Empmas?.EmpNumber, newEmail, V.pisdb, V.conn);
            bool isExist = res != null && res.Any();
            V.IsEmailValid = !isExist;

            if (isExist)
            {
                V.EmailDuplicateMessage = $"Email {V.EmpmasToEdit.Email} already exists.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to validate email", "Something went wrong while checking the email. Please try again.");
            V.IsEmailValid = false;
        }

        return V.IsEmailValid ?? false;
    }

    async Task<bool> CheckIfEmailExistOnMain()
    {
        string notRegisteredMessage = "This email has not been registered as a system user yet. You may proceed by removing the email and link the account later.";
        try
        {
            V.MatchedEmployees.Clear();
            V.EmailDuplicateMessage = string.Empty;

            var res = await _user._02ByEmailWithMainPisEmpmas(V.EmpmasToEdit.Email, V.maindb, "MainPis", V.conn);
            V.MatchedEmployees = res.Where(e => e != null && !string.IsNullOrEmpty(e.AFullName)).ToList();

            if (V.MatchedEmployees == null || !V.MatchedEmployees.Any())
            {
                V.IsEmailValid = false;
                V.EmailDuplicateMessage = notRegisteredMessage;
                return false;
            }

            V.IsEmailValid = true;
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            V.IsEmailValid = null;
            ShowError("Unable to save", "Something went wrong while checking the account. Please try again.");
            return false;
        }
    }

    async Task CheckIfEmailExistOnUxCx()
    {
        V.IsSafeToSave = false;

        try
        {
            var res = await _empmas._02EmpmasAddress_ByEmail(V.EmailToLink, V.newpisdb, V.conn);
            empmasId = res != null ? res.Id : 0;
            V.IsSafeToSave = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to validate email", "Something went wrong while checking the email. Please try again.");
            return ;
        }
    }




    void ShowSuccess(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowInfo(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowError(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });
}