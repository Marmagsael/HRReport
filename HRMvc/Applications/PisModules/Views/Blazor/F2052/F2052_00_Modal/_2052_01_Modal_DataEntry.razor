@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis
@using System.Text.RegularExpressions;

@inject NotificationService _NotificationService
@inject DialogService _DialogService
@inject I_00MainPisAccess _mainpis
@inject IOEmpmasDataAccess _oempmas
@inject I_10_EmpmasDataAccess _empmas


<div class="msds-modal">
    <div class="msds-modal-content" style="max-width: 980px;">
        <div class="modal-content bg-opacity-75">

            <div class="modal-header bg-opacity-75">
                <h1 class="modal-title fs-5">
                    @(V.IsNewEntry == true ? "Add New Employee" : "Update Employee")
                </h1>
                <button type="button" class="btn-close"
                        @onclick="@(() => ShowHideModal(false))"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <_2052_01_DataEntry V="@V" ChildAction="ChildActionCatcher" />
            </div>

        </div>
    </div>
</div>

@code {

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    private int? empmasId = 0;
    private bool isSaving = false;

    async Task ChildActionCatcher()
    {
        if (V == null) return;

        if (V.Action == "HideDataEntry") await ShowHideModal(false);
        if (V.Action == "CheckEmpnoAndEmailOnSecpis") await CheckEmpnoAndEmailOnSecpis();
        if (V.Action == "SaveEmpmas") await SaveEmpmas();

        V.Action = "";
    }


    async Task SaveEmpmas()
    {
        await CheckEmpnoAndEmailOnSecpis();
        if (V.IsEmpNoValid == false || V.IsEmailValid == false) return;

        // await DomainApplication_Update201();
        await SaveEmpmasToSecpis();
        await ChildAction.InvokeAsync();
    }

    async Task SaveEmpmasToSecpis()
    {


        try
        {
            var res = new OEmpmasModel();
            if(V.IsNewEntry == true)
            {
                V.EmpmasToEdit.EmpStat_ = "_"; // set status to newly hired

                res = await _oempmas._01(V.EmpmasToEdit, V.pisdb, V.conn);
                if(res != null)
                {
                    V.EmpmasList.Insert(0, res);
                    V.ShowDataEntry = false;
                    V.Action = "SelectEmpmas";
                    V.SelectedEmpnumber = res.EmpNumber;
                }

            }
            else
            {
                res = await _oempmas._03_EmployeeName(V.SelectedEmpnumber, V.EmpmasToEdit, V.pisdb, V.conn);
                UpdateRecordOnEmpmas(res);
                UpdateRecordOnEmpmasList(res);
            }


            if (res != null && !string.IsNullOrWhiteSpace(res.EmpNumber))
            {
                ShowSuccess("Successfully Saved", "Record has been successfully saved.");
            }
            else
            {
                ShowError("Unable to Save Entry", "Something went wrong. Please try again.");
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            ShowError("Unable to save entry", "Something went wrong. Please try again.");
        }

        await ChildAction.InvokeAsync();
    }


    async Task DomainApplication_Update201(int action)
    {
      

    }


    async Task CheckEmpnoAndEmailOnSecpis()
    {
        V.IsEmpNoValid = true;
        V.IsEmailValid = true;
        V.EmailDuplicateMessage = string.Empty;
        V.EmailRegisteredMessage = string.Empty;

        try
        {


            var res                 = await _oempmas._02EmpnumberAndEmailOwnedByOthers(V.EmpmasToEdit.EmpNumber, V.EmpmasToEdit.Email, V.pisdb, V.conn);
            var empNumberMatch      = res.FirstOrDefault(e => e.EmpNumber == V.EmpmasToEdit.EmpNumber);
            var emailMatch          = res.FirstOrDefault(e => e.Email == V.EmpmasToEdit.Email);
            bool emailHasChanged    = !string.IsNullOrWhiteSpace(V.Empmas.Email) && (V.Empmas.Email != V.EmpmasToEdit.Email);

            if (V.IsNewEntry == true)
            {
                V.IsEmpNoValid = empNumberMatch == null;
                V.IsEmailValid = emailMatch     == null;
            }
            else if (emailHasChanged)
            {
                V.IsEmpNoValid = true; // set to true since the empno textbox during update is disabled
                if (emailMatch != null && emailMatch.EmpNumber != V.EmpmasToEdit.EmpNumber)
                {
                    V.IsEmailValid = false;
                }
            }


            bool emailIsEmpty = string.IsNullOrWhiteSpace(V.EmpmasToEdit.Email);

            if (emailIsEmpty) return;
            if (!CheckIfEMailIsValid(V.EmpmasToEdit.Email)) return;


            if (V.IsEmailValid == false)
            {
                V.EmailDuplicateMessage = $"Email is already associated with {emailMatch.Fullname}.";
            }
            else
            {
                await CheckIfEmailIsOnMain();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to verify empnumber and email", "Something went wrong. Please try again.");
        }
    }


    async Task CheckIfEmailIsOnMain()
    {
        try
        {
            var res = await _mainpis._02ByEmailWithMainPisEmpmas(V.EmpmasToEdit.Email, V.maindb, "MainPis", V.conn);
            if (!res.Any() && !string.IsNullOrWhiteSpace(res.FirstOrDefault().FullName)) 
            {
                V.EmailRegisteredMessage = "This email is available to use but is not yet registered.";
            }
            else
            {
                var user = res.FirstOrDefault();
                V.EmailRegisteredMessage = $"This email is registered to {user?.FullName} in login portal.";
            }
           
            

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to verify email", "Something went wrong. Please try again.");
        }
    }

    void UpdateRecordOnEmpmas(OEmpmasModel source)
    {

        V.EmpmasToEdit.EmpFirstNm   = source.EmpFirstNm;
        V.EmpmasToEdit.EmpLastNm    = source.EmpLastNm;
        V.EmpmasToEdit.EmpMidNm     = source.EmpMidNm;
        V.EmpmasToEdit.Suffix       = source.Suffix;
        V.EmpmasToEdit.EmpAlias     = source.EmpAlias;
        V.EmpmasToEdit.Email        = source.Email;
    }

    void UpdateRecordOnEmpmasList(OEmpmasModel source)
    {
        var rec = V.EmpmasList.FirstOrDefault(e => e.EmpNumber == V.SelectedEmpnumber);

        rec.EmpFirstNm  = source.EmpFirstNm;
        rec.EmpLastNm   = source.EmpLastNm;
        rec.EmpMidNm    = source.EmpMidNm;
        rec.Suffix      = source.Suffix;
        rec.EmpAlias    = source.EmpAlias;
        rec.Email       = source.Email;
    }

    async Task ShowHideModal(bool show)
    {
        if (show) return;

        V.IsNewEntry        = false;
        V.EmpmasToEdit      = new OEmpmasModel();

        V.IsEmpNoValid          = true;
        V.IsEmailValid          = true;
        V.EmailDuplicateMessage = string.Empty;
        V.EmailRegisteredMessage = string.Empty;

        V.ShowDataEntry     = false;
        
       

        await ChildAction.InvokeAsync();
    }


    bool CheckIfEMailIsValid(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        string pattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, pattern);
    }

    void ShowSuccess(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowInfo(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowError(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowWarning(string summary, string detail, int duration = 5000) =>
    _NotificationService.Notify(new NotificationMessage
    {
        Severity = NotificationSeverity.Warning,
        Summary = summary,
        Detail = detail,
        Duration = duration
    });
}
