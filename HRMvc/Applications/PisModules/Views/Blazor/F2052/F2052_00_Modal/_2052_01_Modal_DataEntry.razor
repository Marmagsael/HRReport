@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis

@inject NotificationService _NotificationService
@inject DialogService _DialogService
@inject I_00UsersAccess _user
@inject IOEmpmasDataAccess _oempmas
@inject I_10_EmpmasDataAccess _empmas

<div class="msds-modal">
    <div class="msds-modal-content" style="max-width: 980px;">
        <div class="modal-content bg-opacity-75">

            <div class="modal-header bg-opacity-75">
                <h1 class="modal-title fs-5">
                    @(V.IsNewEntry == true ? "Add New Employee" : "Update Employee")
                </h1>
                <button type="button" class="btn-close"
                        @onclick="@(() => ShowHideModal(false))"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <_2052_01_DataEntry V="@V" ChildAction="ChildActionCatcher" />
            </div>

        </div>
    </div>
</div>

@code {

    [Parameter] public V2052 V { get; set; } = new();
    [Parameter] public EventCallback ChildAction { get; set; }

    private int? empmasId = 0;
    private bool isSaving = false;
    private string oldEmail = string.Empty;

    async Task ChildActionCatcher()
    {
        if (V == null) return;

        if (V.Action == "ValidateEmpNoAndEmailOnLostFocus") await ValidateEmpNoAndEmailOnLostFocus();
        if (V.Action == "SaveEmpmas")       await SaveEmpmas();
        if (V.Action == "LinkEmployee")     await LinkEmployee();
        if (V.Action == "HideDataEntry")    await ShowHideModal(false);


        V.Action = "";

    }


    async Task SaveEmpmas()
    {
        if (await CheckIfEmpNoAndEmailExists() == false) return;
        if (V.IsEmailValid == true && await CheckIfEmailIsRegistered() == false) return;

    }

    async Task ValidateEmpNoAndEmailOnLostFocus()
    {
        await CheckIfEmpNoAndEmailExists();

        if (V.IsEmailValid == true)
        {
            await CheckIfEmailIsRegistered();
        }

    }
    async Task<bool> CheckIfEmpNoAndEmailExists()
    {
        try
        {
            var res = await _oempmas._02EmpnumberAndEmailOwnedByOthers( V.EmpmasToEdit.EmpNumber, V.EmpmasToEdit.Email, V.pisdb, V.conn);

            if (res == null || !res.Any()) return true;

            bool hasEmail       = !string.IsNullOrWhiteSpace(V.EmpmasToEdit.Email);
            bool isNewEntry     = V.IsNewEntry == true;
            bool emailChanged   = hasEmail && (isNewEntry || !string.Equals(  V.EmpmasToEdit.Email?.Trim(), V.Empmas?.Email?.Trim(), StringComparison.OrdinalIgnoreCase));

            var empNoMatch      = isNewEntry  ? res.FirstOrDefault(r => string.Equals(r?.EmpNumber?.Trim(),   V.EmpmasToEdit.EmpNumber?.Trim(), StringComparison.OrdinalIgnoreCase))  : null;
            var emailMatch      = emailChanged  ? res.FirstOrDefault(r => string.Equals(r?.Email?.Trim(),  V.EmpmasToEdit.Email?.Trim(), StringComparison.OrdinalIgnoreCase))  : null;

            if (empNoMatch != null)
            {
                V.IsEmpNoValid = false;
            }

            if (emailMatch != null)
            {
                V.IsEmailValid = false;
                V.EmailDuplicateMessage = $"Email is already assigned to {emailMatch.Fullname}.";
            }

            return empNoMatch == null && emailMatch == null;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to verify empnumber and email", "Something went wrong. Please try again.");
            return false;
        }
    }

    async Task<bool> CheckIfEmailIsRegistered()
    {
        if (string.IsNullOrWhiteSpace(V.EmpmasToEdit.Email))
        {
            return true; 
        }

        try
        {
            var res = await _user._02ByEmailWithMainPisEmpmas( V.EmpmasToEdit.Email, V.maindb, "MainPis", V.conn);

            var matched = res?.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u?.AFullName));

            if (matched == null)
            {
                V.IsEmailValid = false;
                V.EmailDuplicateMessage = "This email has not been registered as a system user yet. You may proceed by removing the email and link the account later.";
                return false;
            }

            V.IsEmailValid = true;
            V.MatchedEmployees = res;
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to verify email", "Something went wrong while checking the account. Please try again.");
            return false;
        }
    }


    async Task LinkEmployee()
    {
        try
        {
            var res = await _empmas._02ByEmail(V.EmpmasToEdit.Email, V.newpisdb, V.conn);
            if(res.Id != null || res.Id != 0)
            {
                if((res.SystemId != 0 || res.SystemId != null ) && res.EmpNumber != V.EmpmasToEdit.EmpNumber)
                {
                    V.IsEmailValid = false;
                    V.EmailDuplicateMessage = $"This email is link to {res.Fulll}. You may proceed by removing the email and link the account later.";
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowError("Unable to verify email", "Something went wrong while checking the account. Please try again.");
        }
    }

    async Task ShowHideModal(bool show)
    {
        if (show) return;

        V.ShowDataEntry     = false;
        V.IsNewEntry        = false;
        V.IsEmpNoValid      = true;
        V.IsEmailValid      = true;
        V.IsSafeToSave      = false;
        V.EmailDuplicateMessage = string.Empty;
        V.MatchedEmployees.Clear();
        V.EmpmasToEdit = new OEmpmasModel();
        await ChildAction.InvokeAsync();
    }


    void ShowSuccess(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowInfo(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });

    void ShowError(string summary, string detail, int duration = 5000) =>
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = summary,
            Detail = detail,
            Duration = duration
        });
}