@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis


@inject NotificationService _NotificationService;
@inject DialogService _DialogService;

<div class="msds-modal">
    <div class="msds-modal-content" style="max-width: 980px;">
        <div class="modal-content  bg-opacity-75">


            <div class="modal-header  bg-opacity-75">
                <h1 class="modal-title fs-5">Add New Employee</h1>
                <button type="button" class="btn-close" @onclick="@(() => ShowHideModal(false))" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errormsg))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => errormsg = string.Empty)">
                        @errormsg
                    </RadzenAlert>
                }
                <_2052_01_DataEntry V="@V" ChildAction="ChildActionCatcher" />

            </div>

        </div>
    </div>
</div>


@inject IOEmpmasDataAccess _empmas


@code {


    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    string errormsg = string.Empty;
    async void ShowHideModal(bool action)
    {

        if (action == false)
        {
            V.Empmas = V.EmpmasToEditMapper(V.EmpmasToEdit!, V.Empmas!);
            V.ShowDataEntry = false;

        }
        await ChildAction.InvokeAsync();
    }


    void ChildActionCatcher()
    {
        if (V == null) return;
        if (V.Action == "SaveEmpmas") SaveUpdate();
        if (V.Action == "HideDataEntry") ShowHideModal(false);

        V.Action = "";
        V.ActionRef = string.Empty;
    }

    async void SaveUpdate()
    {
        errormsg = string.Empty;

        OEmpmasModel empmas = PisempmasToEmpmas(V.Empmas);
        if (V.IsNewEntry == true)
        {
            var validEmpnumber = await IsValidEmpnumber(empmas);
            if (!validEmpnumber) return;
        }


        var validEmail = await IsValidEmail(empmas);
        if (!validEmail) return;


        if(V.IsNewEntry == true)
        {
            Console.WriteLine($" email {empmas.Email}");
            var res                 = await _empmas._01(empmas, V.pisdb!, V.conn!);
            V.SelectedEmpnumber     = res!.EmpNumber;

            V.EmpmasList!.Insert(0,res);

            StateHasChanged();

        } else
        {
            var newEmpmas   = await _empmas._03(empmas.EmpNumber, empmas, V.pisdb!, V.conn!);
            ReflectUpdateToEmpmasList(newEmpmas!);
        }

        V.ShowDataEntry = false;
        await ChildAction.InvokeAsync();

    }

    OEmpmasModel PisempmasToEmpmas(OEmpmasModel pe)
    {
        OEmpmasModel e = new()
        {
            // Id          = pe.Id,
            SystemId    = pe.SystemId,
            EmpNumber   = pe.EmpNumber,
            EmpLastNm   = pe.EmpLastNm,
            EmpFirstNm  = pe.EmpFirstNm,
            EmpMidNm    = pe.EmpMidNm,
            EmpAlias    = pe.EmpAlias,
            Email       = pe.Email,
            Suffix      = pe.Suffix
        };
        return e;
    }

    async Task<bool> IsValidEmpnumber(OEmpmasModel empmas)
    {
        if (empmas.EmpNumber == null) return true;
        if (empmas.EmpNumber.Length < 1) return true;

        var res = await _empmas._02Empmas_EmpnumberOwnedByOthers(empmas.EmpNumber, V.pisdb!, V.conn!);

        if (res == null) return true;
        if (res.Count > 0)
        {
            errormsg = "Employee number already in used.";
            StateHasChanged();
            return false;
        }
        return true;
    }
    async Task<bool> IsValidEmail(OEmpmasModel empmas)
    {

        if (V.Empmas?.Email == null) return true;
        if (V.Empmas.Email.Length < 1) return true;

        List<OEmpmasModel?>? res = new List<OEmpmasModel?>();

        if (V.IsNewEntry == true)
        {
            res = await _empmas._02EmpmasAddress_ByEmailNotTheOwner(string.Empty, V.Empmas.Email, V.pisdb!, V.conn!);
        }
        else
        {
            res = await _empmas._02EmpmasAddress_ByEmailNotTheOwner(empmas.EmpNumber, V.Empmas.Email, V.pisdb!, V.conn!);
        }


        if (res == null) return true;

        if (res.Count > 0)
        {
            errormsg = "Email already in used.";
            StateHasChanged();
            return false;
        }
        return true;
    }


    void ReflectUpdateToEmpmasList(OEmpmasModel source)
    {
        var e = V.EmpmasList?.Find(e => e?.EmpNumber == source.EmpNumber);
        var s = source;
        if (e == null) return;

        // e.Id          = s.Id;
        e.SystemId      = s.SystemId;
        e.EmpNumber     = s.EmpNumber;
        e.EmpLastNm     = s.EmpLastNm;
        e.EmpFirstNm    = s.EmpFirstNm;
        e.EmpMidNm      = s.EmpMidNm;
        e.Suffix        = s.Suffix;
        e.EmpAlias      = s.EmpAlias;

    }

}
