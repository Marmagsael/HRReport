@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_03



<div class="w-100" style="border:1px solid lightgray; margin-left:5px; margin-top:5px; display:flex; flex-direction:column; height:calc(100vh - 140px);">

    @* --- New Entry Button *@
    <div class="w-100 p-2" style="border-bottom:1px solid #d9dde2; flex-shrink:0;">
        @* <button type="submit" class="card p-1 mb-cbtn mb-cbtn-blue d-flex w-100p" @onclick="NewEntry">
            <div class="d-flex align-items-center justify-content-center">
                <span class="p-0">New Entry</span>
            </div>
        </button> *@

        <button class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 " @onclick="NewEntry">
            <div class="d-flex gap-1 align-items-center justify-content-center">
                <span class="fw-semibold"><small>New Entry</small></span>
            </div>
        </button>
    </div>

    @* --- Empmas Info *@
    <div style="background-color:#f5f6f7; border-bottom:1px solid #d9dde2; flex-shrink:0;">
        <_2052_03_EmpmasInfo V="@V" ChildAction="ChildAction" />
    </div>

    @* --- Tabs *@
    <div style="flex-shrink:0;">
        <_2052_03_01_Buttons V="@V" ChildAction="ChildAction" />
    </div>

    @* --- Tab Content *@
    <div class="hide-scroll" style="flex:1; overflow-y:auto; overflow-x:hidden;">
        @if (V.TabNo == 1)
        {
            <_2052_03_Tab01_PersonalData V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 2)
        {
            <_2052_03_Tab02_Address V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 3)
        {
            <_2052_03_Tab03_Deployment V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 4)
        {
            <_2052_03_Tab04_Employment V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 5)
        {
            <_2052_03_Tab05_Education V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 6)
        {
            <_2052_03_Tab06_Family V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 7)
        {
            <_2052_03_Tab07_TrainingAndSeminar V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 8)
        {
            <_2052_03_Tab08_CharacterReference V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 9)
        {
            <_2052_03_Tab09_Insurance V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 10)
        {
            <_2052_03_Tab10_Compliance V="@V" ChildAction="ChildAction" />
        }
        @if (V.TabNo == 11)
        {
            <_2052_03_Tab11_Government V="@V" ChildAction="ChildAction" />
        }
    </div>
</div>
@inject IOEmpmasDataAccess _empmas

@code {

    [Parameter]
    public V2052 V { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }

    async Task NewEntry()
    {
        V.Action            = "New Entry";
        V.EmpmasToEdit      = new OEmpmasModel();
        V.IsNewEntry        = true;
        V.IsEmpNoValid      = true;
        V.SelectedEmpnumber = string.Empty;


        await GetLastEmpNumber();

        V.ShowDataEntry = true;
        await ChildAction.InvokeAsync();
    }

    async Task GetLastEmpNumber()
    {
        if (V.IsNewEntry == true)
        {
            var maxEmpNo = await _empmas._02MaxEmpnumber(V.pisdb, V.conn);
            if (!string.IsNullOrWhiteSpace(maxEmpNo.EmpNumber)) V.LastEmpNumber = maxEmpNo.EmpNumber;
        }

    }



}
