@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_03




<div class="w-100 h-100" style="border:1px solid lightgray; margin-left: 5px; margin-top: 5px; ">
    @* --- Buttons ------------------ *@
    <div class="w-100 p-2" style="border-bottom:1px solid gray; ">
        <btn class="btn btn-secondary" @onclick="NewEntry">New Entry</btn>
    </div>

    @*--- Empmas--------------*@
    <div>
        <_2052_03_EmpmasInfo V="@V" ChildAction="ChildAction" />
    </div>
    <div class="mx-1" style="background-color: rgb(25, 97, 25); padding: 5px 3px 0 3px">
        <_2052_03_01_Buttons V="@V" ChildAction="ChildAction" />
    </div>
    <div>
        @if(V.TabNo==1)  {<_2052_03_Tab01_PersonalData       V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==2)  {<_2052_03_Tab02_Address            V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==3)  {<_2052_03_Tab03_Deployment         V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==4)  {<_2052_03_Tab04_Employment         V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==5)  {<_2052_03_Tab05_Education          V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==6)  {<_2052_03_Tab06_Family             V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==7)  {<_2052_03_Tab07_TrainingAndSeminar V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==8)  {<_2052_03_Tab08_CharacterReference V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==9)  {<_2052_03_Tab09_Insurance          V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==10) {<_2052_03_Tab10_Compliance         V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==11) {<_2052_03_Tab11_Government         V="@V" ChildAction="ChildAction"   />}
        @if(V.TabNo==12) {<_2052_03_Tab12_Security           V="@V" ChildAction="ChildAction"   />}
        
    </div>



</div>

@inject IOEmpmasDataAccess _empmas

@code {

    [Parameter]
    public V2052 V { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }

    async Task NewEntry()
    {
        V.Action           = "New Entry";
        V.ShowDataEntry    = true;
        V.EmpmasToEdit     = new OEmpmasModel();
        V.IsNewEntry       = true;
        await GetLastEmpNumber();
        await ChildAction.InvokeAsync();
    }

    async Task GetLastEmpNumber()
    {
        if (V.IsNewEntry == true)
        {
            var maxEmpNo = await _empmas._02MaxEmpnumber(V.pisdb, V.conn);
            if (!string.IsNullOrWhiteSpace(maxEmpNo.EmpNumber)) V.LastEmpNumber = maxEmpNo.EmpNumber;
        }

    }



}
