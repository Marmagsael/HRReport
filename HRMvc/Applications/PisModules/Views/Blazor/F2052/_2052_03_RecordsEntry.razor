@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_03



<div class="w-100" style="border:1px solid lightgray; margin-left:5px; margin-top:5px; display:flex; flex-direction:column; height:calc(100vh - 140px);">

    <div class="w-100 p-2" style="border-bottom:1px solid #d9dde2; flex-shrink:0;">

        <div class="d-flex justify-content-between">
            <div class="d-flex gap-1">
                @* --- New Entry Button *@
                <button type="button" class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 px-4 " @onclick="NewEntry">
                    <div class="d-flex gap-1 align-items-center justify-content-center">
                        <span class="fw-semibold"><small>Add Employee</small></span>
                    </div>
                </button>

                @* --- Generate Report Button *@
                <button type="button" class="card  flex-fill text-center h-40p mb-btn mb-btn-gray p-2 px-4 " @onclick="GenerateReport">
                    <div class="d-flex gap-1 align-items-center justify-content-center">
                        <span class="fw-semibold"><small>Print</small></span>
                    </div>
                </button>
            </div>

            @* --- Open Status Settings Button *@
            <div>
                <button class="btn btn-secondary " title="Status Settings" @onclick="OpenStatusSettingsModal">
                    <i class="fa-solid fa-gear"></i>
                </button>
            </div>

          

        </div>
       


    </div>

    @* --- Empmas Info *@
    <div style="background-color:#f5f6f7; border-bottom:1px solid #d9dde2; flex-shrink:0;">
        <_2052_03_01_EmpName ChildAction="ChildAction" />
    </div>

    @* --- Tabs *@
    <div style="flex-shrink:0;">
        <_2052_03_01_Buttons  ChildAction="ChildAction" />
    </div>

    @* --- Tab Content *@
    <div class="hide-scroll" style="flex:1; overflow-y:auto; overflow-x:hidden;">
        @if (V.TabNo == 1)
        {
            <_2052_03_Tab01_PersonalData  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 2)
        {
            <_2052_03_Tab02_Address  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 3)
        {
            <_2052_03_Tab03_Deployment  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 4)
        {
            <_2052_03_Tab04_Employment  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 5)
        {
            <_2052_03_Tab05_Education  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 6)
        {
            <_2052_03_Tab06_Family  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 7)
        {
            <_2052_03_Tab07_TrainingAndSeminar  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 8)
        {
            <_2052_03_Tab08_CharacterReference  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 9)
        {
            <_2052_03_Tab09_Insurance  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 10)
        {
            <_2052_03_Tab10_Compliance  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 11)
        {
            <_2052_03_Tab11_Government  ChildAction="ChildAction" />
        }
        @if (V.TabNo == 12)
        {
            <_2052_03_Tab12_Security ChildAction="ChildAction" />
        }
    </div>
</div>

@inject IOEmpmasDataAccess _empmas


@code
{

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2052 V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }


    async Task NewEntry()
    {
        V.SelectedEmpnumber = string.Empty;
        V.EmpmasToEdit      = new OEmpmasModel();

        V.ModalCaption      = "Add New Employee";
        V.Action            = "New Entry";
        V.IsNewEntry        = true;
        V.ShowDataEntry     = true;


        await GetLastEmpNumber();

        await ChildAction.InvokeAsync();
    }

    async Task GetLastEmpNumber()
    {
        V.LastEmpNumber = string.Empty;

        try
        {
            var maxEmpNo = await _empmas._02MaxEmpnumber(Uc.OpisDb, Uc.Conn);
            if (!string.IsNullOrWhiteSpace(maxEmpNo.EmpNumber))
            {
                V.LastEmpNumber = maxEmpNo.EmpNumber ?? "0";
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to get the last used employee number.", ThemeConstants.Notification.ThemeColor.Warning);
        }
        

    }






    async Task OpenStatusSettingsModal()
    {
        V.PreviousSelectedStatus    = V.SelectedStatus.ToList();
        V.ModalCaption              = "Employee Status Settings";
        V.ShowStatusModal           = true;


        await ChildAction.InvokeAsync();
    }


    private async Task GenerateReport()
    {
        if (string.IsNullOrWhiteSpace(V.SelectedEmpnumber)) return;

        V.IsLoading = true;

        Rv.MCaption = "Personal Data Sheet";
        Rv.RelativePath = "";
        Rv.ReportData = [];

        // Parents
        var mother = V.Parents.LastOrDefault(p => p.Code == "M");
        var father = V.Parents.LastOrDefault(p => p.Code == "F");

        // Educations
        var elementary      = V.Educations.LastOrDefault(p => p.Code == "E");
        var highschool      = V.Educations.LastOrDefault(p => p.Code == "H");
        var vocational      = V.Educations.LastOrDefault(p => p.Code == "V");
        var college         = V.Educations.LastOrDefault(p => p.Code == "C");
        var postgraduate    = V.Educations.LastOrDefault(p => p.Code == "P");

        // Report details
        V.RepDtls = new List<dynamic>
        {
            new
            {
                Empmas          = V.Empmas,
                EmpAddress      = V.Empmasaddress,
                Familys         = V.Familys,

                Parents = new
                {
                    Mother = mother,
                    Father = father
                },

                Children            = V.Children,
                EmergencyContacts   = V.EmergencyContacts,
                Employments         = V.Employments,

                Educations  = new
                {
                    Elementary      = elementary,
                    HighSchool      = highschool,
                    Vocational      = vocational,
                    College         = college,
                    Postgraduate    = postgraduate
                },

                Trainings           = V.Trainings,
                CharRefs            = V.CharRefs,
                InsuranceAccident   = V.InsuranceAccident
            }
        };

        // Assign report data
        Rv.ReportData = V.RepDtls;

        // Report settings
        Rv.ReportParams["ReportTitle"] = "Personal Data Sheet";
        Rv.RelativePath = "Reports/_01Pis/K_2052_201.trdp";
        Rv.SelectedFormat = "PDF";

        V.Action = "GenerateReport";

        await ChildAction.InvokeAsync();
    }
}

