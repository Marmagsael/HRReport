@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis
<div>
    @if (!disableAction)
    {
        <div class="d-flex mt-1" style="border: 1px solid #d9dde2; border-radius: 4px; overflow:hidden; margin-bottom: 10px;">
            <div class="@class1 flex-fill text-center" onclick="@(() => ChangeClass(1))">A-J</div>
            <div class="@class2 flex-fill text-center" onclick="@(() => ChangeClass(2))">K-N</div>
            <div class="@class3 flex-fill text-center" onclick="@(() => ChangeClass(3))">O-T</div>
            <div class="@class4 flex-fill text-center" onclick="@(() => ChangeClass(4))">U-Z</div>
            <div class="@class5 flex-fill text-center" onclick="@(() => ChangeClass(5))">Search</div>
        </div>
    }
    else
    {
        <div class="d-flex mt-1" style="border: 1px solid #d9dde2; border-radius: 4px; overflow:hidden; margin-bottom: 10px;">
            <div class="c-222-disabled flex-fill text-center">A-J</div>
            <div class="c-222-disabled flex-fill text-center">K-N</div>
            <div class="c-222-disabled flex-fill text-center">O-T</div>
            <div class="c-222-disabled flex-fill text-center">U-Z</div>
            <div class="c-222-disabled flex-fill text-center">Search</div>
        </div>
    }
    @if (showSearch)
    {
        <div class="d-flex gap-2" style="margin-bottom: 10px;">
            <div style="width: 70%;">
                <input type="text" @oninput="@(() => StateHasChanged())" @bind-value="skey" placeholder="Lastname" class="form-control">
            </div>
            <div style="width: 30%;">
                <button onclick="@(() => SearchEmployee(skey))"  type="submit" class="card  flex-fill text-center h-40p mb-btn mb-btn-blue p-2 px-4 ">
                    <div class="d-flex gap-1 align-items-center justify-content-center">
                        <span class="fw-semibold"><small>Search</small></span>
                    </div>
                </button>
            </div>


                
        </div>
        @if (showRequiredLength)
        {
            <div class="text-danger w-100 p-1" style="font-size:small; border: 1px solid red; border-radius: 3px;">
                Input not less than 3 character to proceed.
            </div>
        }
    }
    <div class="p-2 bg-lightgray" style="border:1px;">
        <h6 class="mb-0">Name</h6>
    </div>
    <div style="border:1px solid #d9dde2; height:calc(100vh - 260px); overflow-y:auto; overflow-x:hidden;">
        @if (V.EmpmasList?.Count > 0)
        {
            <table class="table table-sm table-hover">
                <tbody>
                    @foreach (var e in V.EmpmasList!)
                    {
                        if (e!.EmpNumber == V.SelectedEmpnumber)
                        {
                            <tr class="fw-bold txt-fcolor" style="cursor:pointer; background-color:#eaf1fb; color:rgb(0,128,192) ;">
                                <td>@e?.EmpLastNm, @e?.EmpFirstNm @e?.EmpMidNm - [@e?.EmpNumber]</td>
                            </tr>
                        }
                        else
                        {
                            <tr style="cursor:pointer;">
                                <td onclick="@(() => SelectEmpmas(e))">
                                    @e?.EmpLastNm, @e?.EmpFirstNm @e?.EmpMidNm - [@e?.EmpNumber]
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="w-100 text-center" style="background-color:#eef0f2; color:#6c757d; border: 1px solid #d9dde2; padding:8px 0;">
                Record is empty.
            </div>
        }
    </div>
    <div class="bg-lightgray" style="color:#2c2f33; padding: 5px 10px; font-size: small; border:1px solid #d9dde2; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
        Employee Listing
    </div>
</div>
@inject IOEmpmasDataAccess _empmas
@inject DA2052 _da;
@inject I_00MainDA _main;
@inject IEmpmovementDataAccess _empMovement;


@code {
    string skey = "";

    string class1 = "c-222-selected";
    string class2 = "c-222-active";
    string class3 = "c-222-active";
    string class4 = "c-222-active";
    string class5 = "c-222-active";

    int selectedId = 0;

    bool showSearch = false;
    bool disableAction = false;
    bool showRequiredLength = false;

    DA2052? da;

    [Parameter]
    public V2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    async void ChangeClass(int classNo)
    {

        V.EmpmasList = new();
        disableAction = true;
        showRequiredLength = false;

        class1 = "c-222-active";
        class2 = "c-222-active";
        class3 = "c-222-active";
        class4 = "c-222-active";
        class5 = "c-222-active";
        showSearch = false;

        switch (classNo)
        {
            case 1:
                class1 = "c-222-selected";
                V.EmpmasList = await _empmas._02By1stLetterRange("A", "J", V.pisdb!, V.conn!);
                break;


            case 2:
                class2 = "c-222-selected";
                V.EmpmasList = await _empmas._02By1stLetterRange("K", "N", V.pisdb!, V.conn!);
                break;

            case 3:
                class3 = "c-222-selected";
                V.EmpmasList = await _empmas._02By1stLetterRange("O", "T", V.pisdb!, V.conn!);
                break;

            case 4:
                class4 = "c-222-selected";
                V.EmpmasList = await _empmas._02By1stLetterRange("U", "Z", V.pisdb!, V.conn!);
                break;

            default:
                break;
        }

        if (classNo == 5)
        {
            showSearch = true;
            class5 = "c-222-selected";
        }

        disableAction = false;

        StateHasChanged();
        await ChildAction.InvokeAsync();

    }

    async void SelectEmpmas(OEmpmasModel e)
    {
        V.SelectedEmpnumber = e.EmpNumber;
        V.Action = "SelectEmpmas";
        await ChildAction.InvokeAsync();
    }



    async void SearchEmployee(string sval)
    {
        V.EmpmasList = new();

        if (sval.Length < 4)
        {
            showRequiredLength = true;
            return;
        }

        showRequiredLength = false;


        V.EmpmasList = await _empmas._02SearchName(sval, V.pisdb!, V.conn!);
        await ChildAction.InvokeAsync();
    }

}




<style>
    .c-222-selected {
        color: white;
        padding: 8px 5px;
        background-color: rgb(0,128,192);
        cursor: pointer;
        border-right: 1px solid #d9dde2;
    }

    .c-222-active {
        cursor: pointer;
        color: #2c2f33;
        padding: 8px 5px;
        background-color: #ffffff;
        border-right: 1px solid #d9dde2;
    }

        .c-222-active:hover {
            color: rgb(0,128,192);
            background-color: #eaf1fb;
        }

    .c-222-disabled {
        color: #ffffff;
        padding: 8px 5px;
        background-color: #b9c4cf;
        border-right: 1px solid #d9dde2;
    }

        .c-222-selected:last-child,
        .c-222-active:last-child,
        .c-222-disabled:last-child {
            border-right: none;
        }
</style>
