@using HRApiLibrary.Modules._2306O
@using HRApiLibrary.Modules._2310O
@using HRApiLibrary.Modules._12005O
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.DataAccess._10_Pis
@using HRMvc.Applications._00GeneralComponents

@inject IDA_2310O _da
@inject IDA_2306O _emp
@inject IDA_12005O _sched
@inject IAttpunches1DataAccess _attPunches
@inject HRMvc.StartupConfig.ClientTerminalService _terminal

<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <_00BT_FullW HdrCaption="OB Entry">

        <Details>

            <div class="p-0">
                <div class="card-header d-flex gap-2">
                    <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="1" @onclick="NewEntry">New</button>
                    <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="2" @onclick="SaveOb">Save</button>
                    @if (IsExisting)
                    {
                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" @onclick="AskDelete">Delete</button>
                    }

                    <div class="vr"></div>

                    <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" @onclick="OpenSearchEmployee">Search Employee</button>
                    <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" @onclick="OpenSearchTransaction">Search Transaction</button>
                </div>
            </div>

            <div class="px-2 ps-md-3 pt-3">

                <div class="card py-2 px-3 mb-2">
                    @* --- Control Number --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-180p">Control Number</label>
                        <div class="col-12 col-md-7 col-lg-3">
                            <TelerikTextBox Value="@ControlNumber" Placeholder="New" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" ReadOnly Enabled="false" />
                        </div>
                    </div>

                    @* -- Date Filed --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-180p">Date Filed</label>
                        <div class="col-12 col-md-7 col-lg-3">
                            <TelerikDatePicker Value="@ObDate" ValueChanged="@((DateTime v) => DateFiledChanged(v))" ValueExpression="@(() => ObDate)"
                                               Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" />
                        </div>
                    </div>
                </div>

                <div class="card p-0 mb-2">
                    <div class="card-header txt-fcolor">Employee Details</div>
                    <div class="py-2 px-3">

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Employee Number</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikTextBox Value="@EmpNumber" ValueChanged="@((string v) => EmpNumberChanged(v))" ValueExpression="@(() => EmpNumber)"
                                                MaxLength="5"
                                                Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="3">
                                    <TextBoxSuffixTemplate>
                                        <TelerikFontIcon Icon="@FontIcon.Search" Size="@ThemeConstants.FontIcon.Size.Small" />
                                    </TextBoxSuffixTemplate>
                                </TelerikTextBox>
                                @if (!string.IsNullOrEmpty(EmpError)) { <div class="txt-red small">@EmpError</div> }
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Employee Name</label>
                            <div class="col-12 col-md-7 col-lg-5">
                                <TelerikTextBox Value="@EmpName" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" ReadOnly Enabled="false" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Status</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikTextBox Value="@EmpStatus" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" ReadOnly Enabled="false" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Current Deployment</label>
                            <div class="col-12 col-md-7 col-lg-5">
                                <TelerikTextBox Value="@EmpClient" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" ReadOnly Enabled="false" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card p-0 mb-2">
                    <div class="card-header txt-fcolor">OB Details</div>
                    <div class="py-2 px-3">

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Destination</label>
                            <div class="col-12 col-md-7 col-lg-5">
                                <TelerikTextBox @bind-Value="@Destination" MaxLength="150" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="4" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Purpose</label>
                            <div class="col-12 col-md-7 col-lg-5">
                                <TelerikTextArea @bind-Value="@Purpose" MaxLength="250" Width="100%" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="5" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Contact Person</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikTextBox @bind-Value="@ContactPerson" MaxLength="100" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="6" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Tel. No.</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikTextBox @bind-Value="@TelNo" MaxLength="45" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="7" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">From</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikDatePicker Value="@ObStart" ValueChanged="@((DateTime v) => StartChanged(v))" ValueExpression="@(() => ObStart)"
                                                   Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="8" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">To</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikDatePicker Value="@ObEnd" ValueChanged="@((DateTime v) => EndChanged(v))" ValueExpression="@(() => ObEnd)"
                                                   Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="9" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Number of Days</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikNumericTextBox @bind-Value="@NoDays" Format="N2" Decimals="2" Min="0.5m" Max="@RangeDays" Step="0.5m" Class="text-end"
                                                       Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="10" />
                            </div>
                            <div class="ms-md-2 small text-muted align-self-center">Counted from the dates; change it for a half day.</div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Number of Days With Pay</label>
                            <div class="col-12 col-md-7 col-lg-3">
                                <TelerikNumericTextBox @bind-Value="@DaysWithPay" Format="N2" Decimals="2" Min="0m" Max="@NoDays" Step="0.5m" Class="text-end"
                                                       Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="11" />
                            </div>
                            <div class="ms-md-2 small text-muted align-self-center">Without pay : @((NoDays - DaysWithPay).ToString("N2")) day(s)</div>
                        </div>

                        <div class="d-flex flex-column flex-md-row mb-2">
                            <label class="fw-normal w-180p">Remarks</label>
                            <div class="col-12 col-md-7 col-lg-5">
                                <TelerikTextArea @bind-Value="@Remarks" MaxLength="250" Width="100%" Rounded="@ThemeConstants.TextBox.Rounded.Large" FillMode="@ThemeConstants.TextBox.FillMode.Solid" TabIndex="12" />
                            </div>
                        </div>
                    </div>
                </div>

                @* ---------------- OB History of the employee ---------------- *@
                <div class="card p-0 mb-2">
                    <div class="card-header txt-fcolor">OB History @(string.IsNullOrEmpty(EmpName) ? "" : "- " + EmpName)</div>
                    <div class="py-2 px-3">
                        <TelerikGrid Data="@History" Sortable="true" Pageable="true" PageSize="8" Height="360px"
                                     OnRowDoubleClick="@((GridRowClickEventArgs a) => PickTransaction((M2310_Transaction)a.Item))">
                            <GridColumns>
                                <GridColumn Field="@nameof(M2310_Transaction.ObNumber)" Title="Control No." Width="110px" />
                                <GridColumn Field="@nameof(M2310_Transaction.ObDate)" Title="Date Filed" DisplayFormat="{0:MMM dd, yyyy}" Width="120px" />
                                <GridColumn Field="@nameof(M2310_Transaction.Destination)" Title="Destination" />
                                <GridColumn Field="@nameof(M2310_Transaction.ObStart)" Title="From" DisplayFormat="{0:MMM dd, yyyy}" Width="120px" />
                                <GridColumn Field="@nameof(M2310_Transaction.ObEnd)" Title="To" DisplayFormat="{0:MMM dd, yyyy}" Width="120px" />
                                <GridColumn Field="@nameof(M2310_Transaction.NoDays)" Title="Days" Width="80px" TextAlign="ColumnTextAlign.Right" DisplayFormat="{0:N2}" />
                                <GridColumn Field="@nameof(M2310_Transaction.DaysWithPay)" Title="With Pay" Width="90px" TextAlign="ColumnTextAlign.Right" DisplayFormat="{0:N2}" />
                            </GridColumns>
                            <NoDataTemplate>
                                <div class="p-3 text-muted">@(string.IsNullOrEmpty(EmpName) ? "Choose an employee to see the OB history." : "No OB filed yet.")</div>
                            </NoDataTemplate>
                        </TelerikGrid>
                        <div class="small text-muted mt-1">Double-click an OB to open it.</div>
                    </div>
                </div>

            </div>

        </Details>

    </_00BT_FullW>

    @* ---------------- Search Employee ---------------- *@
    <TelerikWindow Modal="true" @bind-Visible="@ShowSearchEmployee" Width="780px">
        <WindowActions><WindowAction Name="Close" /></WindowActions>
        <WindowTitle>Search Employee</WindowTitle>
        <WindowContent>
            <div class="p-2">
                <div class="d-flex gap-2 mb-2">
                    <TelerikTextBox @bind-Value="@EmpKeyword" Placeholder="Employee no. or name" Width="320px" />
                    <TelerikButton OnClick="@SearchEmployees" ThemeColor="primary">Search</TelerikButton>
                </div>
                <TelerikGrid Data="@EmpResults" Height="360px" OnRowDoubleClick="@((GridRowClickEventArgs a) => PickEmployee((M2306_EmpInfo)a.Item))">
                    <GridColumns>
                        <GridColumn Field="@nameof(M2306_EmpInfo.EmpNumber)" Title="Emp. No." Width="100px" />
                        <GridColumn Field="@nameof(M2306_EmpInfo.EmpName)" Title="Name" />
                        <GridColumn Field="@nameof(M2306_EmpInfo.Status)" Title="Status" Width="150px" />
                        <GridCommandColumn Width="90px" Title="">
                            <GridCommandButton Command="Select" OnClick="@((GridCommandEventArgs a) => PickEmployee((M2306_EmpInfo)a.Item))">Select</GridCommandButton>
                        </GridCommandColumn>
                    </GridColumns>
                    <NoDataTemplate><div class="p-3 text-muted">Type a number or a name, then click Search.</div></NoDataTemplate>
                </TelerikGrid>
            </div>
        </WindowContent>
    </TelerikWindow>

    @* ---------------- Search Transaction ---------------- *@
    <TelerikWindow Modal="true" @bind-Visible="@ShowSearchTransaction" Width="1000px">
        <WindowActions><WindowAction Name="Close" /></WindowActions>
        <WindowTitle>Search Transaction</WindowTitle>
        <WindowContent>
            <div class="p-2">
                <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                    <div>
                        <label class="form-label fw-bold mb-0">From</label><br />
                        <TelerikDatePicker @bind-Value="@ListFrom" Width="150px" />
                    </div>
                    <div>
                        <label class="form-label fw-bold mb-0">To</label><br />
                        <TelerikDatePicker @bind-Value="@ListTo" Width="150px" />
                    </div>
                    <div>
                        <label class="form-label fw-bold mb-0">Employee</label><br />
                        <TelerikTextBox @bind-Value="@ListKeyword" Placeholder="No. or name" Width="200px" />
                    </div>
                    <TelerikButton OnClick="@LoadTransactions" ThemeColor="primary">Search</TelerikButton>
                </div>
                <TelerikGrid Data="@Transactions" Sortable="true" Pageable="true" PageSize="12" Height="420px"
                             OnRowDoubleClick="@((GridRowClickEventArgs a) => PickTransaction((M2310_Transaction)a.Item))">
                    <GridColumns>
                        <GridColumn Field="@nameof(M2310_Transaction.ObNumber)" Title="Control No." Width="110px" />
                        <GridColumn Field="@nameof(M2310_Transaction.ObDate)" Title="Date Filed" DisplayFormat="{0:MMM dd, yyyy}" Width="120px" />
                        <GridColumn Field="@nameof(M2310_Transaction.EmpNumber)" Title="Emp. No." Width="90px" />
                        <GridColumn Field="@nameof(M2310_Transaction.EmpName)" Title="Name" />
                        <GridColumn Field="@nameof(M2310_Transaction.Destination)" Title="Destination" Width="170px" />
                        <GridColumn Field="@nameof(M2310_Transaction.ObStart)" Title="From" DisplayFormat="{0:MMM dd, yyyy}" Width="110px" />
                        <GridColumn Field="@nameof(M2310_Transaction.ObEnd)" Title="To" DisplayFormat="{0:MMM dd, yyyy}" Width="110px" />
                        <GridColumn Field="@nameof(M2310_Transaction.NoDays)" Title="Days" Width="70px" TextAlign="ColumnTextAlign.Right" DisplayFormat="{0:N2}" />
                        <GridCommandColumn Width="90px" Title="">
                            <GridCommandButton Command="Select" OnClick="@((GridCommandEventArgs a) => PickTransaction((M2310_Transaction)a.Item))">Open</GridCommandButton>
                        </GridCommandColumn>
                    </GridColumns>
                    <NoDataTemplate><div class="p-3 text-muted">No OB transactions found.</div></NoDataTemplate>
                </TelerikGrid>
            </div>
        </WindowContent>
    </TelerikWindow>

    @* ---------------- Delete ---------------- *@
    <TelerikWindow Modal="true" @bind-Visible="@ShowDelete" Width="420px">
        <WindowActions><WindowAction Name="Close" /></WindowActions>
        <WindowTitle>Delete OB</WindowTitle>
        <WindowContent>
            <div class="p-2">
                <p>Delete OB <b>@ControlNumber</b> of <b>@EmpName</b>?</p>
                <div class="d-flex gap-2">
                    <TelerikButton OnClick="@DoDelete" ThemeColor="primary">Delete</TelerikButton>
                    <TelerikButton OnClick="@(() => ShowDelete = false)">Cancel</TelerikButton>
                </div>
            </div>
        </WindowContent>
    </TelerikWindow>

</TelerikRootComponent>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private TelerikNotification NotificationRef = default!;
    private bool IsLoading;

    // -- The form (the OB is saved in the old PIS : ob1, and in the new PIS as an approved application) --
    private string  ControlNumber = "";
    private bool    IsExisting;
    private DateTime ObDate  = DateTime.Today;
    private string? EmpNumber;
    private string  EmpName = "", EmpStatus = "", EmpClient = "", EmpError = "";
    private string? Destination, Purpose, ContactPerson, TelNo, Remarks;
    private DateTime ObStart = DateTime.Today;
    private DateTime ObEnd   = DateTime.Today;
    private decimal NoDays   = 1;
    private decimal RangeDays => (decimal)((ObEnd.Date - ObStart.Date).TotalDays + 1);
    private decimal DaysWithPay = 1;

    // -- the OB as it was when opened (an edit replaces its record in the PIS) --
    private string? OrigEmpNumber;
    private DateTime OrigStart, OrigEnd;

    // -- Search Employee --
    private bool ShowSearchEmployee;
    private string EmpKeyword = "";
    private List<M2306_EmpInfo> EmpResults = [];

    // -- Search Transaction --
    private bool ShowSearchTransaction;
    private DateTime ListFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime ListTo   = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private string ListKeyword = "";
    private List<M2310_Transaction> Transactions = [];

    private bool ShowDelete;

    // -- OB history of the chosen employee --
    private List<M2310_Transaction> History = [];

    private string Pis  => Uc?.SchemaUserPis ?? "";
    private string OPis => Uc?.OpisDb ?? "";
    private string Conn => Uc?.Conn ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        IsLoading = true;
        try
        {
            ControlNumber = "";
        }
        catch (Exception ex)
        {
            NotificationRef?.Show($"Unable to load : {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
        IsLoading = false;
    }

    // ---------------- Form ----------------
    private async Task NewEntry()
    {
        IsExisting = false;
        ObDate = DateTime.Today;
        EmpNumber = null; EmpName = EmpStatus = EmpClient = EmpError = "";
        History = []; OrigEmpNumber = null;
        Destination = Purpose = ContactPerson = TelNo = Remarks = null;
        ObStart = ObEnd = DateTime.Today; NoDays = 1; DaysWithPay = 1;
        ControlNumber = "";
    }

    private async Task DateFiledChanged(DateTime v)
    {
        ObDate = v.Date;
        if (!IsExisting) ControlNumber = "";
    }

    // -- No. of days is counted from the dates (both days included); it can be changed afterwards, e.g. for a half day --
    private void StartChanged(DateTime v)
    {
        ObStart = v.Date;
        if (ObEnd < ObStart) ObEnd = ObStart;
        CountDays();
    }

    private void EndChanged(DateTime v)
    {
        ObEnd = v.Date;
        if (ObEnd < ObStart) ObStart = ObEnd;
        CountDays();
    }

    private void CountDays()
    {
        NoDays = (decimal)((ObEnd.Date - ObStart.Date).TotalDays + 1);
        DaysWithPay = NoDays;
    }

    private async Task EmpNumberChanged(string v)
    {
        EmpNumber = v;
        await FillEmployee(v);
    }

    private async Task FillEmployee(string? number)
    {
        EmpError = ""; EmpName = EmpStatus = EmpClient = "";
        History = [];
        if (string.IsNullOrWhiteSpace(number)) return;

        try
        {
            var e = await _emp._02Employee(number.Trim(), OPis, Conn);
            if (e == null) { EmpError = "Employee number not found."; return; }
            EmpName = e.EmpName ?? ""; EmpStatus = e.Status ?? ""; EmpClient = e.Client ?? "";
            await LoadHistory();
        }
        catch (Exception ex)
        {
            EmpError = ex.Message;
        }
    }

    private async Task LoadHistory()
    {
        History = [];
        if (string.IsNullOrWhiteSpace(EmpNumber) || EmpName == "") return;
        try { History = (await _da._02History(EmpNumber.Trim(), OPis, Conn)) ?? []; }
        catch (Exception ex) { NotificationRef.Show($"Unable to load the OB history : {ex.Message}", ThemeConstants.Notification.ThemeColor.Error); }
    }

    // ---------------- Search Employee ----------------
    private void OpenSearchEmployee()
    {
        EmpResults = [];
        ShowSearchEmployee = true;
    }

    private async Task SearchEmployees()
    {
        try { EmpResults = (await _emp._02EmployeeSearch(EmpKeyword, OPis, Conn)) ?? []; }
        catch (Exception ex) { NotificationRef.Show($"Unable to search : {ex.Message}", ThemeConstants.Notification.ThemeColor.Error); }
    }

    private async Task PickEmployee(M2306_EmpInfo e)
    {
        EmpNumber = e.EmpNumber;
        ShowSearchEmployee = false;
        await FillEmployee(EmpNumber);
    }

    // ---------------- Search Transaction ----------------
    private async Task OpenSearchTransaction()
    {
        ShowSearchTransaction = true;
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        try
        {
            var all = (await _da._02Transactions(ListFrom, ListTo, OPis, Conn)) ?? [];
            var k = (ListKeyword ?? "").Trim();
            Transactions = k == "" ? all : all.Where(t => (t.EmpNumber ?? "").Contains(k, StringComparison.OrdinalIgnoreCase)
                                                       || (t.EmpName ?? "").Contains(k, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            Transactions = [];
            NotificationRef.Show($"Unable to load the OB transactions : {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task PickTransaction(M2310_Transaction t)
    {
        ShowSearchTransaction = false;
        IsExisting    = true;
        ControlNumber = t.ObNumber ?? "";
        ObDate        = t.ObDate ?? DateTime.Today;
        EmpNumber     = t.EmpNumber;
        Destination   = t.Destination; Purpose = t.Purpose; ContactPerson = t.ContactPerson; TelNo = t.TelNo; Remarks = t.Remarks;
        ObStart       = t.ObStart ?? DateTime.Today;
        ObEnd         = t.ObEnd ?? ObStart;
        NoDays        = (decimal)(t.NoDays ?? 1);
        DaysWithPay   = (decimal)(t.DaysWithPay ?? 0);
        OrigEmpNumber = t.EmpNumber?.Trim(); OrigStart = ObStart; OrigEnd = ObEnd;
        await FillEmployee(EmpNumber);
    }

    // ---------------- Save / Delete (old PIS : ob1, and the new PIS) ----------------
    private async Task SaveOb()
    {
        if (string.IsNullOrWhiteSpace(EmpNumber) || !string.IsNullOrEmpty(EmpError) || EmpName == "") { NotificationRef.Show("Choose an employee.", ThemeConstants.Notification.ThemeColor.Warning); return; }
        if (string.IsNullOrWhiteSpace(Destination)) { NotificationRef.Show("Enter the destination.", ThemeConstants.Notification.ThemeColor.Warning); return; }
        if (ObEnd < ObStart) { NotificationRef.Show("The end date must not be earlier than the start date.", ThemeConstants.Notification.ThemeColor.Warning); return; }
        if (NoDays > RangeDays) { NotificationRef.Show($"Number of days cannot be more than the days in the date range ({RangeDays:N2}).", ThemeConstants.Notification.ThemeColor.Warning); return; }
        if (NoDays <= 0) { NotificationRef.Show("Number of days must be more than zero.", ThemeConstants.Notification.ThemeColor.Warning); return; }
        if (DaysWithPay < 0 || DaysWithPay > NoDays) { NotificationRef.Show("Number of days with pay must be from 0 up to the number of days.", ThemeConstants.Notification.ThemeColor.Warning); return; }

        IsLoading = true;
        try
        {
            var emp = EmpNumber.Trim();
            if (await _da._02Overlapping(emp, ObStart, ObEnd, IsExisting ? ControlNumber : null, OPis, Conn) > 0)
            {
                NotificationRef.Show("The employee already has an OB on these dates.", ThemeConstants.Notification.ThemeColor.Warning);
                IsLoading = false;
                return;
            }

            var s = new M2310_Save
            {
                ObDate = ObDate, EmpNumber = emp, ObStart = ObStart, ObEnd = ObEnd, NoDays = (double)NoDays, DaysWithPay = (double)DaysWithPay,
                Destination = Destination?.Trim(), Purpose = Purpose?.Trim(), ContactPerson = ContactPerson?.Trim(), TelNo = TelNo?.Trim(), Remarks = Remarks?.Trim()
            };
            var wasExisting = IsExisting;

            if (IsExisting)
                await _da._03Update(ControlNumber, s, Uc.OempNumber, OPis, Conn);
            else
            {
                ControlNumber = await _da._01Save(s, Uc.OempNumber, OPis, Conn);
                IsExisting = true;
            }

            var pisNote = await SavePis(emp, s, wasExisting);

            OrigEmpNumber = emp; OrigStart = ObStart; OrigEnd = ObEnd;
            await LoadHistory();
            NotificationRef.Show($"OB {ControlNumber} saved." + pisNote, ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex)
        {
            NotificationRef.Show($"Failed to save: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
        IsLoading = false;
    }

    // -- The OB in the new PIS : an approved application (it shows in the portal of the employee) and the OB punches (OB0 / OB1 / OB2).
    //    An edit replaces the old record : the old application is cancelled, a new one is made. --
    private async Task<string> SavePis(string emp, M2310_Save s, bool wasExisting)
    {
        var pe = await _emp._02PisEmp(emp, Pis, Conn);
        if (pe == null) return " (Not recorded in the PIS : the employee has no PIS record.)";

        if (wasExisting && !string.IsNullOrEmpty(OrigEmpNumber))
        {
            var oldPe = await _emp._02PisEmp(OrigEmpNumber, Pis, Conn);
            if (oldPe != null)
                await _da._03CancelPis(oldPe.EmpmasId, oldPe.SystemId, OrigStart, OrigEnd, Uc.EmpmasId ?? 0, Pis, Conn);
        }

        var days = await BuildPisDays(emp, pe.SystemId);
        await _da._01SavePis(new M2310_PisSave
        {
            Yr = ObStart.Year, EmpmasId = pe.EmpmasId, DateApplied = ObDate, ObStart = ObStart, ObEnd = ObEnd,
            Destination = s.Destination, Purpose = s.Purpose, ContactPerson = s.ContactPerson, TelNo = s.TelNo, Remarks = s.Remarks,
            DaysCnt = s.NoDays, DaysWithPay = s.DaysWithPay, Days = days
        }, Uc.EmpmasId ?? 0, Pis, Conn);

        // -- only an employee with a user account has attendance --
        if (pe.SystemId > 0)
        {
            var pay = days.Where(d => d.IsPayable == 1)
                          .Select(d => (d.Date, (int?)d.ObDurationId, AttPunchStatus.OB(d.ObDurationId))).ToList();
            if (pay.Count > 0)
            {
                var t = await _terminal.GetAsync();
                await _attPunches._01Approved(pe.SystemId, pay, Uc.UserId, t.TimeZoneId, t.IpAddress, t.MacAddress, Pis, Conn);
            }
        }
        return "";
    }

    // -- A row per day of the OB : the duty type from the schedule of the person (rest days are not with pay).
    //    The days with pay are given to the working days from the first one; a half is a first-half day. --
    private async Task<List<M2310_PisDay>> BuildPisDays(string emp, int systemId)
    {
        var weekly = systemId > 0 ? ((await _sched._02Templates([systemId], Pis, Conn)) ?? []) : [];
        var deflt  = (await _sched._02DefaultSchedule(Pis, Conn)) ?? [];
        var adv    = (await _sched._02Advances([emp], ObStart, ObEnd, Pis, Conn)) ?? [];

        var list = new List<M2310_PisDay>();
        var left = (double)DaysWithPay;
        for (var d = ObStart.Date; d <= ObEnd.Date; d = d.AddDays(1))
        {
            var dayNo = (int)d.DayOfWeek + 1;      // 1 = Sunday
            var duty  = adv.FirstOrDefault(a => a.EmpNumber?.Trim() == emp && a.Date.Date == d)?.DutyType
                        ?? weekly.FirstOrDefault(w => w.DayNo == dayNo)?.DutyType
                        ?? deflt.FirstOrDefault(w => w.DayNo == dayNo)?.DutyType
                        ?? "R";
            duty = string.IsNullOrWhiteSpace(duty) ? "R" : duty.Trim();

            var day = new M2310_PisDay { Date = d, DutyType = duty, IsPayable = 0, ObDurationId = 1 };
            if (duty != "RD" && left > 0.0001)
            {
                day.IsPayable = 1;
                if (left >= 1) { day.ObDurationId = 1; left -= 1; }
                else           { day.ObDurationId = 2; left = 0; }
            }
            list.Add(day);
        }
        return list;
    }

    private void AskDelete() => ShowDelete = true;

    private async Task DoDelete()
    {
        ShowDelete = false;
        if (!IsExisting) return;

        try
        {
            var no = ControlNumber;
            await _da._04Delete(no, OPis, Conn);

            // -- the PIS record of that OB is cancelled too --
            if (!string.IsNullOrEmpty(OrigEmpNumber))
            {
                var pe = await _emp._02PisEmp(OrigEmpNumber, Pis, Conn);
                if (pe != null)
                    await _da._03CancelPis(pe.EmpmasId, pe.SystemId, OrigStart, OrigEnd, Uc.EmpmasId ?? 0, Pis, Conn);
            }

            await NewEntry();
            NotificationRef.Show($"OB {no} deleted.", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex)
        {
            NotificationRef.Show($"Failed to delete: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
    }
