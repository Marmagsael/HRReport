@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOEmpstatDataAccess _empstat;


<TelerikGrid TItem="OEmpstatModel"
             Data="V.EmpStats"
             @ref="EmpStatGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OEmpstatModel()))">
                Add Employee Status
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Code --- *@
        <GridColumn Field="@nameof(OEmpstatModel.Code)"
                    Title="Code"
                    Width="80px" />

        @* --- Name --- *@
        <GridColumn Field="@nameof(OEmpstatModel.Name)"
                    Title="Description"
                    Width="150px" />


        @* --- Is Resigned --- *@
        <GridColumn Field="@nameof(OEmpstatModel.IsResigned)"
                    Title="Is Resigned"
                    Width="100px">

            <FilterMenuTemplate Context="filterContext">
                <TelerikDropDownList Data="@V.YesNoOptions"
                                     TextField="@nameof(V2062Model.YesNoOption.Text)"
                                     ValueField="@nameof(V2062Model.YesNoOption.Value)"
                                     Value="@SelectedIsResignedFilter"
                                     ValueChanged="@((string val) => OnIsResignedChanged(val, filterContext))"
                                     DefaultText="Select...">
                </TelerikDropDownList>
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var isResigned = ((OEmpstatModel)item).IsResigned;
                }
                <div class="d-flex justify-content-center">
                    @if (!string.IsNullOrEmpty(isResigned))
                    {
                        <span class="badge @(isResigned == "1" ? "bg-success" : "bg-secondary")">
                            @(isResigned == "1" ? "Yes" : "No")
                        </span>
                    }
                </div>
            </Template>
        </GridColumn>


        @* --- Is On Leave --- *@
        <GridColumn Field="@nameof(OEmpstatModel.IsOnLeaved)"
                    Title="Is On Leave"
                    Width="100px">

            <FilterMenuTemplate Context="filterContext">
                <TelerikDropDownList Data="@V.YesNoOptions"
                                     TextField="@nameof(V2062Model.YesNoOption.Text)"
                                     ValueField="@nameof(V2062Model.YesNoOption.Value)"
                                     Value="@SelectedIsOnLeavedFilter"
                                     ValueChanged="@((string val) => OnIsLeaveChanged(val, filterContext))"
                                     DefaultText="Select...">
                </TelerikDropDownList>
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var isOnLeave = ((OEmpstatModel)item).IsOnLeaved;
                }
                <div class="d-flex justify-content-center">
                    @if (!string.IsNullOrEmpty(isOnLeave))
                    {
                        <span class="badge @(isOnLeave == "1" ? "bg-success" : "bg-secondary")">
                            @(isOnLeave == "1" ? "Yes" : "No")
                        </span>
                    }
                </div>
            </Template>
        </GridColumn>



        @* --- Is On Floating --- *@
        <GridColumn Field="@nameof(OEmpstatModel.IsFloating )"
                    Title="Is On Floating"
                    Width="100px">
            <FilterMenuTemplate Context="filterContext">
                <TelerikDropDownList Data="@V.YesNoOptions"
                                     TextField="@nameof(V2062Model.YesNoOption.Text)"
                                     ValueField="@nameof(V2062Model.YesNoOption.Value)"
                                     Value="@SelectedIsFloatingFilter"
                                     ValueChanged="@((string val) => OnIsFloatingChanged(val, filterContext))"
                                     DefaultText="Select...">
                </TelerikDropDownList>
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var isFloating = ((OEmpstatModel)item).IsFloating;
                }
                <div class="d-flex justify-content-center">
                    @if (!string.IsNullOrEmpty(isFloating))
                    {
                        <span class="badge @(isFloating == "1" ? "bg-success" : "bg-secondary")">
                            @(isFloating == "1" ? "Yes" : "No")
                        </span>
                    }
                </div>
            </Template>
        </GridColumn>


        @* --- Is Suspened --- *@
        <GridColumn Field="@nameof(OEmpstatModel.IsSuspended)"
                    Title="Is Suspended"
                    Width="100px">
            <FilterMenuTemplate Context="filterContext">
                <TelerikDropDownList Data="@V.YesNoOptions"
                                     TextField="@nameof(V2062Model.YesNoOption.Text)"
                                     ValueField="@nameof(V2062Model.YesNoOption.Value)"
                                     Value="@SelectedIsSuspendedFilter"
                                     ValueChanged="@((string val) => OnIsSuspendedChanged(val, filterContext))"
                                     DefaultText="Select...">
                </TelerikDropDownList>
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var isSuspended = ((OEmpstatModel)item).IsSuspended;
                }
                <div class="d-flex justify-content-center">
                    @if (!string.IsNullOrEmpty(isSuspended))
                    {
                        <span class="badge @(isSuspended == "1" ? "bg-success" : "bg-secondary")">
                            @(isSuspended == "1" ? "Yes" : "No")
                        </span>
                    }
                </div>
            </Template>
        </GridColumn>



        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="100px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (OEmpstatModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No emlpoyee status records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {
    [CascadingParameter]
    public V2062Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<OEmpstatModel> EmpStatGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
    private async Task OpenEntryModal(OEmpstatModel rec)
    {
        V.CodeErrorMsg = string.Empty;
        V.DescriptionErrorMsg = string.Empty;


        V.EmpStat = new OEmpstatModel();
        V.EmpStatOriginalState = null;


        V.ModalCaption = "Add Employe Status ";

        if (!string.IsNullOrWhiteSpace(rec.Code))
        {
            V.ModalCaption = "Edit Employe Status";
            V.EmpStat = MapRecord(rec);
            V.EmpStatOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }


    private async Task _04Delete(OEmpstatModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.Name}' record?", "Confirm Employe Status Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _empstat._04(rec.Code, V.OPisdb, V.Conn);

            if (res != null)
            {
                NotificationRef?.Show("Unable to delete employee status.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }


            V.EmpStats.Remove(rec);
            RebindGrid();
            NotificationRef?.Show("Employee status deleted succesfully.", ThemeConstants.Notification.ThemeColor.Success);


        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to delete  employee status.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private OEmpstatModel MapRecord(OEmpstatModel rec)
    {
        return new OEmpstatModel
        {
            Code = rec.Code,
            Name = rec.Name,
            IsResigned = rec.IsResigned,
            IsOnLeaved = rec.IsOnLeaved,
            IsFloating = rec.IsFloating,
            IsSuspended = rec.IsSuspended,
            IsInPayroll = rec.IsInPayroll,
            InLicVer = rec.InLicVer,
            InOe = rec.InOe,
            IsDeviation = rec.IsDeviation,


        };
    }

    private async Task GenerateReport()
    {
        if (!V.EmpStats.Any()) { return; }


        V.RepDtls = V.EmpStats;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Employee Status Listing";
        Rv.RelativePath = "Reports/_01Pis/J_2062_ES.trdp";
        Rv.SelectedFormat = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }

    public void RebindGrid()
    {
        EmpStatGridRef.Rebind();
    }

    // Custom Filter ----------------------------------------------------------------

    private string? SelectedIsResignedFilter;
    private string? SelectedIsOnLeavedFilter;
    private string? SelectedIsFloatingFilter;
    private string? SelectedIsSuspendedFilter;


    private void OnIsResignedChanged(string value, FilterMenuTemplateContext filterContext)
    {
        SelectedIsResignedFilter = value;

        filterContext.FilterDescriptor.FilterDescriptors.Clear();

        if (!string.IsNullOrEmpty(value))
        {
            filterContext.FilterDescriptor.FilterDescriptors.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OEmpstatModel.IsResigned),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = value
            });
        }
    }



    private void OnIsLeaveChanged(string value, FilterMenuTemplateContext filterContext)
    {
        SelectedIsOnLeavedFilter = value;

        filterContext.FilterDescriptor.FilterDescriptors.Clear();

        if (!string.IsNullOrEmpty(value))
        {
            filterContext.FilterDescriptor.FilterDescriptors.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OEmpstatModel.IsOnLeaved),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = value
            });
        }
    }

    private void OnIsFloatingChanged(string value, FilterMenuTemplateContext filterContext)
    {
        SelectedIsFloatingFilter = value;

        filterContext.FilterDescriptor.FilterDescriptors.Clear();

        if (!string.IsNullOrEmpty(value))
        {
            filterContext.FilterDescriptor.FilterDescriptors.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OEmpstatModel.IsFloating),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = value
            });
        }
    }

    private void OnIsSuspendedChanged(string value, FilterMenuTemplateContext filterContext)
    {
        SelectedIsSuspendedFilter = value;

        filterContext.FilterDescriptor.FilterDescriptors.Clear();

        if (!string.IsNullOrEmpty(value))
        {
            filterContext.FilterDescriptor.FilterDescriptors.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OEmpstatModel.IsSuspended),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = value
            });
        }
    }

}


