<div style="max-height:60vh">

    <EditForm Model="@V.EmpStat"
              OnValidSubmit="@SaveRecord"
              class="h-100 d-flex flex-column">

               @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="4">
                Save
            </button>

        </div>

         <div class="px-2 ps-md-3 pt-3">
            
             
             @* --- Code Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Code
                </label>

                <div class="col-12 col-md-4">

                    <TelerikTextBox @bind-Value="@V.EmpStat.Code"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="1">
                    </TelerikTextBox>

                </div>

            </div>


            @* --- Description --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Description
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.EmpStat.Name"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2">
                    </TelerikTextBox>

                </div>

            </div>


            @* --- Is Resigned --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Is Resigned
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.EmpStat.IsResigned"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="2">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>

            @* --- Is On Leave --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Is On Leave
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.EmpStat.IsOnLeaved"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="2">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>


            @* --- Is On Floating --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Is On Floating
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.EmpStat.IsFloating"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="2">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>


            @* --- Is On Suspended --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Is On Suspended
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.EmpStat.IsSuspended"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="2">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>
         </div>

    </EditForm>
</div>

@code{
    [CascadingParameter]
    public V2062Model V { get; set; } = new();

    
    private void SaveRecord()
    {
        
    }
}