@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRMvc.Applications.PisModules.Vars.NonExclusive
@using HRMvc.Applications.PisModules.Views.Blazor.NonExclusive.NEF2052


<RadzenDialog />
<RadzenNotification />
@using HRMvc.Applications.PisModules.Views.Blazor.NonExclusive.NEF2052.NEF2052_00_Modal

<HRMvc.Applications._02HR.Views.BlazorPages._00Library._02PageHdr pageTitle="Employee Entry" />

@if (v.ShowDataEntry)
{
     <NE_2052_01_Modal_DataEntry V="@v" ChildAction="ChildAction" /> 
}


<div style="z-index:2">
    <div class="d-flex">
        <div style="width:25%; min-height:90vh; background-color:azure">
            <NE_2052_02_EmpList V="@v" ChildAction="ChildAction" />
        </div>

        <div style="width:75%; min-height:90vh; background-color:aliceblue">
            <NE_2052_03_RecordsEntry V="@v" ChildAction="ChildAction" />

        </div>
    </div>
</div>






@inject I_10_EmpmasDataAccess _empmas;
@inject IRdivisionDataAccess _rdivision;
@inject IRdepartmentDataAccess _rdepartment;
@inject IRsectionDataAccess _rsection;

@inject IEmploymenttypeDataAccess _employmentType;
@inject ILeavegrpDataAccess _leavegrp;
@inject IPayrollgrpDataAccess _payrollgrp;
@inject IPositionDataAccess _position;
@inject IRempstatDataAccess _rempstat;
@inject IRcivstatDataAccess _rcivstat;
@inject I_00CountryDataAccess _country;

@code {



    NEV2052 v { get; set; } = new();

    [Parameter]
    public UserClaimsModel? Uc { get; set; } = new();


    protected override async void OnParametersSet()
    {
        if (Uc == null) return;
        v.pisdb = Uc.SchemaUserPis;
        v.paydb = Uc.SchemaUserPay;
        v.conn = Uc.Conn;
        v.userid = Uc.UserId;
        v.defcoid = int.Parse(Uc.DefCompanyId ?? "0");

        if (v.conn == null) return;
        if (v.pisdb == null) return;
        if (v.paydb == null) return;


        v.EmpmasList = await _empmas._02By1stLetterRange("A", "J", v.pisdb, v.conn);
        v.Rdivisions = await _rdivision._02(v.pisdb, v.conn);
        v.Rdepartments = await _rdepartment._02(v.pisdb, v.conn);
        v.Rsections = await _rsection._02(v.pisdb, v.conn);
        v.Employmenttypes = await _employmentType._02(v.pisdb, v.conn);
        v.Leavegrps = await _leavegrp._02(v.pisdb, v.conn);
        v.Payrollgprs = await _payrollgrp._02(v.paydb, v.conn);
        v.Rempstats = await _rempstat._02(v.pisdb, v.conn);
        v.Positions = await _position._02(v.pisdb, v.conn);
        v.RCivStats = await _rcivstat._02(v.pisdb, v.conn);
        v.Countrys = await _country._02("Main", v.conn);
        //v.PrintProperties(Uc);

        StateHasChanged();

    }


    void ChildAction()
    {
        if (v == null) return;
        if (v.Action == "SearchEmployee") SearchEmployee();

        v.Action = "";
        v.ActionRef = string.Empty;
    }



    void SearchEmployee()
    {
        StateHasChanged();
    }
}
