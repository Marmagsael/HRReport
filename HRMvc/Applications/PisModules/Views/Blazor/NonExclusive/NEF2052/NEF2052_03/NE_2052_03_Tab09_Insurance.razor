@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRMvc.Applications.PisModules.Vars.NonExclusive
@using HRMvc.Applications._02HR._02Library

@inject NotificationService _NotificationService;
@inject DialogService _DialogService;


<div class="p-2">
    <HRMvc.Applications._02HR.Views.BlazorPages._00Library._02ColumnHdr pageTitle="Insurance" />
    <div class="h-10p"></div>
    @if (V.Empmas?.Id > 0)
    {
        <div class="p-2 bordered mb-2 w-100">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Text="New Entry" Click="@InsertRow" Disabled="@(editMode || isLoading)" />
        </div>
    }


    <div class="custom-grid mt-2">
        <RadzenDataGrid Data="@V.Insurances"
                        TItem="EmpmasInsuranceModel"
                        @ref="V.InsuranceGrid"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PageSizeOptions=@(new int[]{5, 10, 20, 30})
                        ColumnWidth="200px"
                        IsLoading="isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="EmpmasInsuranceModel"
                                      Context="EmpmasInsuranceModel"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="100%">
                    <HeaderTemplate>
                        <RadzenRow Gap="0" Style="padding-inline-end:1rem;">
                            <RadzenColumn Size="5" class="custom-grid-sm">Details</RadzenColumn>
                            <RadzenColumn Size="6" class="custom-grid-md">Insurance</RadzenColumn>
                            <RadzenColumn Size="6" class="custom-grid-md">Policy No</RadzenColumn>
                        </RadzenRow>
                    </HeaderTemplate>


                    <Template Context="rec">

                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            @*-- Name --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Insurance" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.INSURANCE" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Institution --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Policy No." />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.PolicyNo" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Trainor --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Face Value" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.FaceValue" Disabled="true" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Premium --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Premium" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.Premium" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Expire --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Exoiration Date" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDatePicker @bind-Value="rec.InsExpire" ShowButton="false" Disabled="true" DateFormat="MM dd yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>


                          
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow>
                                @*--  ProgramName / Start/ End / Hrs  --*@
                                <RadzenColumn Size="6">
                                    <div class="fw-bold">@rec.INSURANCE</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">

                                            <RadzenColumn Size="6">
                                                Face Value: <span class="text-muted text-decoration-underline "> @rec.FaceValue</span>
                                            </RadzenColumn>

                                            <RadzenColumn Size="6">
                                                Premium: <span class="text-muted text-decoration-underline "> @rec.Premium</span>
                                            </RadzenColumn>

                                            

                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                @*-- Policy No. / Trainer --*@
                                <RadzenColumn Size="6">
                                    <div>@rec.PolicyNo</div>
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="6">
                                                Expiration Date <span class="text-muted text-decoration-underline"> @rec.InsExpire.ToString("MM dd, yyyyy")</span>
                                            </RadzenColumn>

                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>


                               


                            </RadzenRow>
                        </RadzenStack>
                    </Template>

                    <EditTemplate Context="rec">
                        @* ======= Small Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-sm">
                            @*-- Insurannce Type --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Insurance Type" Component="InsuranceSm" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.INSURANCE" Change="@(args => rec.INSURANCE = args.ToString().Trim())" class="w-100" Name="InsuranceSm" MaxLength="60" />
                                        <RadzenRequiredValidator Component="InsuranceSm" Text="Insurance Type is required" Popup="true" Style="position: absolute; " />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Policy No. --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Policy No." />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenTextBox @bind-Value="rec.PolicyNo" Change="@(args => rec.PolicyNo = args.ToString().Trim())" class="w-100" Name="PolicySm" MaxLength="50" />
                                        <RadzenRequiredValidator Component="PolicySm" Text="Policy No. is required" Popup="true" Style="position: absolute; " />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Face Value --*@
                            <RadzenRow AlignItems="AlignItems.Center" class="row">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Face Value" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.FaceValue" class="w-100" MaxLength="30" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            @*-- Premium --*@
                            <RadzenRow AlignItems="AlignItems.Center" class="row">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Premium" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenNumeric @bind-Value="rec.Premium" class="w-100" MaxLength="30" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>


                            @*-- Expiration Date --*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel Text="Expiration Date" />
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenFormField Variant="Variant.Text" class="w-100">
                                        <RadzenDatePicker @bind-Value="rec.InsExpire" class="w-100" DateFormat="MM dd yyyy" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                         
                        </RadzenStack>

                        @* ======= Large Screen =========*@
                        <RadzenStack Gap="0" class="custom-grid-md">
                            <RadzenRow Gap=".3rem">

                                @*--  Program Name / Gender  --*@
                                <RadzenColumn Size="6">
                                    <RadzenTextBox @bind-Value="rec.INSURANCE" Change="@(args => rec.INSURANCE = args.ToString().Trim())" class="w-100" Name="InsuranceLg" MaxLength="60" Style=" display: block" />
                                    <RadzenRequiredValidator Component="InsuranceLg" Text="Insurance Type is required" Popup="true" Style="position: absolute; " />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="6">
                                                <RadzenFormField AllowFloatingLabel="false" Text="FaceValue" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenNumeric @bind-Value="rec.FaceValue" />
                                                </RadzenFormField>
                                                <RadzenFormField AllowFloatingLabel="false" Text="Premium" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenNumeric @bind-Value="rec.Premium"  />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>

                                @*-- Institution / Trainer --*@
                                <RadzenColumn Size="6">
                                    <RadzenTextBox @bind-Value="rec.PolicyNo" Change="@(args => rec.PolicyNo = args.ToString().Trim())" class="w-100" Name="SchoolLg" MaxLength="50" Style=" display: block" />
                                    <RadzenRequiredValidator Component="SchoolLg" Text="Policy No. is required" Popup="true" Style="position: absolute; " />
                                    <div class="mt-1">
                                        <RadzenRow RowGap="0">
                                            <RadzenColumn Size="6">
                                                <RadzenFormField Text="Expiration Date" Variant="Variant.Outlined" Style="width:100%" class="custom-form-field">
                                                    <RadzenDatePicker @bind-Value="rec.InsExpire" DateFormat="MM dd yyyy" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </EditTemplate>

                </RadzenDataGridColumn>

                @* Actions Column *@
                <RadzenDataGridColumn TItem="EmpmasInsuranceModel" Context="EmpmasInsuranceModel" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Title="Actions" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="120px">
                    <Template Context="rec">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditRow(rec))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" Click="@(args => DeleteRow(rec))" class="my-1 ms-1" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                    <EditTemplate Context="rec">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@((args) => SaveRow(rec))"></RadzenButton>
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@((args) => CancelEdit(rec))" Size="ButtonSize.Small" class="my-1 ms-1"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(rec))" class="my-1 ms-1"></RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </div>



</div>




@inject I_10_EmpmasDataAccess _empmas;


@code {

    int? empmasId = 0;

    [Parameter]
    public NEV2052 V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    List<EmpmasInsuranceModel?>? insuranceToInsert = new();
    List<EmpmasInsuranceModel?>? insuranceToUpdate = new();
    string? errorMsg = string.Empty;
    bool isLoading = true;
    bool editMode = false;
    private int screenWidth;




    protected override async void OnParametersSet()
    {
        if (empmasId != V.SelectedId)
        {
            empmasId = V.SelectedId;

            await Task.Delay(250);

            V.Insurances = await _empmas._02EmpmasInsuranceList(empmasId, V.pisdb!, V.conn!);
        }
        isLoading = false;
        StateHasChanged();


    }

    //-- InsertRow ----------------
    private async Task InsertRow()
    {
        errorMsg = string.Empty;
        Reset();

        var rec = new EmpmasInsuranceModel();
        insuranceToInsert!.Add(rec);
        await V.InsuranceGrid!.InsertRow(rec);
        editMode = true;
    }
    //-- Reset ----------------
    private void Reset()
    {
        insuranceToInsert!.Clear();
        insuranceToUpdate!.Clear();
    }

    //-- Reset ----------------
    private void Reset(EmpmasInsuranceModel rec)
    {
        insuranceToInsert!.Remove(rec);
        insuranceToUpdate!.Remove(rec);
    }

    //-- Edit Row ----------------
    private async Task EditRow(EmpmasInsuranceModel rec)
    {
        editMode = true;

        if (V.InsuranceGrid != null)
        {
            Reset();
            insuranceToUpdate?.Add(rec);
            await V.InsuranceGrid.EditRow(rec);
        }
    }
    //-- Delete Row ----------------
    private async Task DeleteRow(EmpmasInsuranceModel rec)
    {
        if (V.Insurances == null) return;
        if (V.InsuranceGrid == null) return;

        Reset(rec);

        if (V.Insurances.Contains(rec))
        {
            if (rec != null)
            {
                var option = await _DialogService.Confirm("Delete " + rec.INSURANCE + "  record?", "Confirm Delete",
                    new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
                if (option == true)
                {
                    await _empmas._04EmpmasInsurance(rec!.Id, V.pisdb!, V.conn!);
                    V.Insurances.Remove(rec);
                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Successfully deleted a record.", Detail = "Record has been deleted from the list.", Duration = 4000 });
                }
            }
        }
        else
        {
            V.InsuranceGrid.CancelEditRow(rec);
        }
        await V.InsuranceGrid.Reload();
        editMode = false;
        errorMsg = string.Empty;
    }


    //-- Cancel Edit ----------------
    private async void CancelEdit(EmpmasInsuranceModel rec)
    {
        errorMsg = string.Empty;
        if (V.InsuranceGrid == null) return;

        Reset(rec);
        editMode = false;

        V.InsuranceGrid.CancelEditRow(rec);
        if (rec.Id < 1) return;

        int? id = rec.Id;
        // var res = await _mainPis._02EmpmasEmployment(rec.Id, mydb!, conn!);
        // if (res == null) return;
        // Remap_Flds(rec, res);
        await V.InsuranceGrid.Reload();
    }
    //-- Remap ----------------
    private void Remap_Flds(EmpmasInsuranceModel destination, EmpmasInsuranceModel source)
    {

    }
    //-- Save Row ----------------
    private async Task SaveRow(EmpmasInsuranceModel rec)
    {
        if (V.InsuranceGrid == null) return;


        if (!SafeToSave(rec))
        {
            await V.InsuranceGrid.UpdateRow(rec);
            return;
        }



        if (rec.Id == 0)
        {
            rec.EmpmasId = empmasId;
            var res = await _empmas._01EmpmasInsurance(rec, V.pisdb!, V.conn!);
            if (res != null)
            {
                rec.Id = res.Id;
                V.Insurances!.Add(rec);
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Successfully added a record.", Detail = "Record has been added to the list.", Duration = 4000 });
            }
        }
        else
        {
            await _empmas._03EmpmasInsurance(rec.Id, rec, V.pisdb!, V.conn!);
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Successfully updated a record.", Detail = "Record has been updated from the list.", Duration = 4000 });
        }
        await V.InsuranceGrid.UpdateRow(rec);
        editMode = false;
        errorMsg = string.Empty;
    }
    // -- Safe to Save ----------------
    private bool SafeToSave(EmpmasInsuranceModel rec)
    {
        if (rec.INSURANCE?.Length == 0 || rec.INSURANCE == null)
        {
            return false;
        }

        if (rec.PolicyNo?.Length == 0 || rec.PolicyNo == null)
        {
            return false;
        }
        return true;
    }

    private void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }




}




