@using HRApiLibrary.DataAccess._10_Pis.OPis


@*--- USER FORM MODAL ---*@
@if (V.ShowUserForm == true)
{
    <_00Modal ModuleCaption="@UserFormCaption" ChildAction="() => V.ShowUserForm = false" ModalWidth="65vh">

        <Content>
            <_2002_UserForm   />
        </Content>

    </_00Modal>
}



@*--- USER ACCESS MODAL ---*@
@if (V.ShowUserAccess == true)
{
    <_00Modal ModuleCaption="@UserFormCaption" ChildAction="() => V.ShowUserAccess = false" >

        <Content>
            <_2002_UserAccessV1 @ref="UserAccessModuleRef" />
        </Content>

    </_00Modal>
}


<TelerikGrid Data="@V.Users"
             TItem="OPisUsrModel"
             Sortable="true"
             Navigable="true"
             SelectionMode="GridSelectionMode.Single"
             FilterMode="GridFilterMode.FilterMenu"
             Pageable="true"
             @bind-PageSize="@PageSize"
             @ref="@UserGridRef"
             Height="100%">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>


    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>
        <button class="card p-2 text-center h-35p mb-btn mb-btn-blue" 
                        @onclick="@(() => OpenFormModal(new OPisUsrModel()))">
            Create User
        </button>
    </GridToolBarTemplate>

    <GridColumns>

        @* --- LOGIN NAME --- *@
        <GridColumn Field="@nameof(OPisUsrModel.LogName)"
                    Title="Login Name"
                    Width="150px" />

        @* --- USER NAME --- *@
        <GridColumn Field="@nameof(OPisUsrModel.UserName)"
                    Title="User Name"
                    Width="200px" />

        @* --- STATUS  --- *@
        <GridColumn Field="@nameof(OPisUsrModel.StatusName)"
                    Title="Status"
                    Width="140px">

            <Template Context="item" >
                @{
                    var user = (OPisUsrModel)item;
                }

                  <div class="d-flex justify-content-center">
                    @if (user.Status == "A")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Disabled</span>
                    }
                </div>
            </Template>

        </GridColumn>


        <GridCommandColumn Title="Action"
                           Width="180px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var usr = (OPisUsrModel)item;
                }

                <div class="d-flex justify-content-center gap-2">
                    @* ---  EDIT BUTTON --- *@
                    <button class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="@(() => OpenFormModal(usr))">
                        Edit
                    </button>

                    @* ---  ACCESS BUTTON --- *@
                    <button class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="@(() => OpenAccessModal(usr))">
                        Access
                    </button>

                    <TelerikDropDownButton Icon="@FontIcon.MoreVertical"
                                           Class="card p-2 text-center h-35p mb-btn mb-btn-blue">

                        <DropDownButtonItems>
                            @* ---  ENABLE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => EnableUser(usr))">
                                Enable
                            </DropDownButtonItem>

                            @* ---  DISBALE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => DisableUser(usr))">
                                Disable
                            </DropDownButtonItem>

                            @* ---  DELETE BUTTON --- *@
                            <DropDownButtonItem OnClick="@(() => DeleteUser(usr))">
                                Delete
                            </DropDownButtonItem>

                        </DropDownButtonItems>

                    </TelerikDropDownButton>

                </div>
            </Template>

        </GridCommandColumn>


    </GridColumns>


    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No users found.
        </div>
    </NoDataTemplate>
</TelerikGrid>
@inject IOPisUsrDataAccess _usr


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();


    [CascadingParameter]
    public V2002Model V { get; set; } = new();


    [CascadingParameter]
    public TelerikNotification NotificationRef { get; set; } 

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;
    private List<int?> PageSizes = new() { 25, 50, 75, 100, null };

    private TelerikGrid<OPisUsrModel> UserGridRef;
    private  _2002_UserAccessV1 UserAccessModuleRef;

    private string UserFormCaption = "Add User";




    protected override async Task OnInitializedAsync()
    {
        if (Uc?.Conn == null || Uc.OpisDb == null || Uc.SchemaMain == null || Uc.SchemaMainPis == null)
        {
            V.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        V.OPisdb = Uc.OpisDb; V.Maindb = Uc.SchemaMain; V.Mainpisdb = Uc.SchemaMainPis; V.Module = "pis"; V.Conn = Uc.Conn;

        await LoadUsers();
        await SetInitialFilter();
        V.UcLoaded = true;
    }

    private async Task LoadUsers()
    {
        try
        {
            var res = await _usr._02(V.OPisdb, V.Conn);
            if (res.Any()) { V.Users = res; }
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable To Load Users", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task SetInitialFilter()
    {
        var state = UserGridRef.GetState();

        state.FilterDescriptors = new List<IFilterDescriptor>
        {
            new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OPisUsrModel.StatusName),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = "Active"
            }
        };

        await UserGridRef.SetStateAsync(state);
    }






    private void OpenFormModal(OPisUsrModel usr)
    {
        V.User = new OPisUsrModel();
        UserFormCaption = "Add User";

        if (!string.IsNullOrWhiteSpace(usr.LogName))
        {
            V.User = usr;
            UserFormCaption = "Edit User";

        }

        V.ShowUserForm = true;


    }

    private async Task OpenAccessModal(OPisUsrModel usr)
    {
        V.User = new OPisUsrModel();

        V.User = usr;
        UserFormCaption = "Select User Access";

        if (UserAccessModuleRef != null)
        {
            await UserAccessModuleRef.ResetTab();
        }
        V.ShowUserAccess = true;


    }

    private void EnableUser(OPisUsrModel usr)
    {

    }

    private void DisableUser(OPisUsrModel usr)
    {

    }

    private void DeleteUser(OPisUsrModel usr)
    {

    }
}
