    static OEmpmasModel MapEmpmas(OEmpmasModel source)
    {
        var clone = new OEmpmasModel();

        clone.EmpmasId = source.EmpmasId;
        clone.EmpNumber = source.EmpNumber;
        clone.UserId = source.UserId;
        clone.EmpLastNm = source.EmpLastNm;
        clone.EmpFirstNm = source.EmpFirstNm;
        clone.EmpMidNm = source.EmpMidNm;
        clone.EmpAlias = source.EmpAlias;
        clone.Suffix = source.Suffix;
        clone.Email = source.Email;
        clone.Height = source.Height;
        clone.HeightInches = source.HeightInches;

        return clone;
    }

    private void SplitHeight()
    {
        var height = v.Empmas.Height;

        if (height == null)
        {
            v.Empmas.HeightFt = 0;
            v.Empmas.HeightInches = 0;
            return;
        }

        int feet = (int)height.Value;
        int inches = (int)Math.Round((height.Value - feet) * 100);

        v.Empmas.HeightFt = feet;
        v.Empmas.HeightInches = inches;


    }

    private void GetAddressArea()
    {
        v.Empmas.ManilaArea = string.Empty;
        v.Empmas.ProvincialArea = string.Empty;

        if (!string.IsNullOrWhiteSpace(v.Empmas.MlaCode_))
        {
            v.Empmas.ManilaArea = v.MlaList?.FirstOrDefault(m => m.Code == v.Empmas.MlaCode_)?.Name ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(v.Empmas.ProCode_))
        {
            v.Empmas.ProvincialArea = v.ProList?.FirstOrDefault(m => m.Code == v.Empmas.ProCode_)?.Name ?? string.Empty;
        }
    }

    private void GetGenderAndCivilStatus()
    {
        v.Empmas.Gender = string.Empty;
        v.Empmas.CivilStatus = string.Empty;

        if (!string.IsNullOrWhiteSpace(v.Empmas.Sex_))
        {
            v.Empmas.Gender = v.OGenders?.FirstOrDefault(m => m.Code == v.Empmas.Sex_)?.Name ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(v.Empmas.CivStat_))
        {
            v.Empmas.CivilStatus = v.OCivStats?.FirstOrDefault(m => m.Code == v.Empmas.CivStat_)?.Name ?? string.Empty;
        }
    }

    private void ComputeParentsAge()
    {

        foreach (var c in v.Parents)
        {
            if (c.DoB == null)
            {
                c.Age = 0;
                continue;
            }

            c.Age = ComputeAge(c.DoB);
        }


    }

    private void ComputeEmployeesAge()
    {
        var age = ComputeAge(v.Empmas.EmpBirth);
        v.Empmas.Age = age.ToString();
    }




    private double ComputeAge(DateTime? date)
    {
        if (date == null || date == DateTime.MinValue)
            return 0;

        DateTime today = DateTime.Today;
        DateTime birthDate = date!.Value;

        int age = today.Year - birthDate.Year;

        if (today < birthDate.AddYears(age))
        {
            age--;
        }

        return age;
    }
}


