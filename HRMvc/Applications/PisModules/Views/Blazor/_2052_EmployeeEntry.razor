    protected override async Task OnInitializedAsync()
    {

        if (Uc.Conn == null || Uc.OpisDb == null || Uc.OpayDb == null)
        {
            NotificationRef.Show("Something went wrong while loading the employee page. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        v.IsLoading = true;

        try
        {
            // Load Employee Status ---------
            await LoadSelectedStatus();
            await LoadEmployeeStatus();


            await LoadEmployeeList();
            await LoadDropdownValues();


            // Report DATA ---------
            _00InitializeReport();
            await _02LoadCompanyInfo();
        }
        finally
        {
            v.IsLoading = false;
        }


    }

    private async Task ChildAction()
    {
        if (v == null) return;

        if (v.Action == "ReLoadEmployeeList")           await LoadEmployeeList();
        if (v.Action == "SelectEmpmas")                 await SelectEmpmas();

        if (v.Action == "ShowLicVerificationLogsModal") await LoadSecurityLicenseVerificationLogs();

        if (v.Action == "SplitHeight")              SplitHeight();
        if (v.Action == "ComputeEmployeesAge")      ComputeEmployeesAge();
        if (v.Action == "ComputeParentsAge")        ComputeParentsAge();

        if (v.Action == "GetGenderAndCivilStatus_SplitHeight")
        {
            SplitHeight();
            GetGenderAndCivilStatus();
        }

        if (v.Action == "GetAddressArea")            GetAddressArea();
        if (v.Action == "GetGenderAndCivilStatus")   GetGenderAndCivilStatus();

        if (v.Action == "GenerateReport")       await GenerateReport();
        if (v.Action == "ShowDataEntry")        await ShowDataEntry();

        v.Action = "";
    }



    private async Task LoadEmployeeList()
    {

        v.EmpmasList = [];

        if (!v.SelectedStatus.Any())
        {
            NotificationRef.Show("Please select at least one status to load the employee list.", ThemeConstants.Notification.ThemeColor.Info);
            return;
        }

        v.IsLoading = true;

        try
        {
            var statuses = new List<string>();
            foreach (var s in v.SelectedStatus)
            {
                statuses.Add(s.Code);
            }

            var res = await _empmas._02By1stLetterRangeByStatus("A", "J", statuses, Uc.OpisDb, Uc.Conn);
            v.EmpmasList = res;

            var employeeExistInList = v.EmpmasList.Any(e => e.EmpNumber == v.SelectedEmpnumber);

            if (!employeeExistInList)
            {
                v.SelectedEmpnumber = string.Empty;
                v.Empmas            = new();
                v.Employments       = [];
                v.Educations        = [];
                v.Parents           = [];
                v.Children          = [];
                v.EmergencyContacts = [];
                v.Familys           = [];
                v.Trainings         = [];
                v.CharRefs          = [];
                v.InsuranceAccident = new();
                v.SecLicense        = new();
                v.SecLicenseLogs    = [];
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employee list. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }

    }

    private async Task SelectEmpmas()
    {
        if (string.IsNullOrWhiteSpace(v.SelectedEmpnumber)) return;

        v.IsLoading = true;

        v.Empmas            = new();
        v.Employments       = [];
        v.Educations        = [];
        v.Parents           = [];
        v.Children          = [];
        v.EmergencyContacts = [];
        v.Familys           = [];
        v.Trainings         = [];
        v.CharRefs          = [];
        v.InsuranceAccident = new();
        v.SecLicense        = new();
        v.PrevSecLicense = new();
        v.SecLicenseLogs    = [];


        try
        {
            var res = await _empmas._02(v.SelectedEmpnumber, Uc.OpisDb, Uc.SchemaMain, Uc.SchemaUserPis, Uc.Conn);
            if (res.Any())
            {
                v.Empmas = res.FirstOrDefault();
                v.EmpmasToEdit  = MapEmpmas(res.FirstOrDefault());

                await LoadEmployments();
                await LoadEducations();
                await LoadParents();
                await LoadChildren();
                await LoadEmergencyContacts();
                await LoadRelatives();
                await LoadTrainings();
                await LoadCharRefs();
                await LoadInsuranceAccident();
                await LoadSecLicense();

                SplitHeight();
                GetAddressArea();
                GetGenderAndCivilStatus();
                ComputeParentsAge();
                ComputeEmployeesAge();
            }



        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong while loading the employee records. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            await Task.Delay(1000);
            v.IsLoading = false;
        }



    }



    // REPORT DATA --------------------------------------------------------------------
    private void _00InitializeReport()
    {
        rv.MCaption = "";
        rv.RefreshToken = 20520000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }

    private async Task GenerateReport()
    {
        rv.ShowModal = true;

