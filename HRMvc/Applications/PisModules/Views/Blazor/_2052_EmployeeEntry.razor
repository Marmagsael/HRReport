    static OEmpmasModel MapEmpmas(OEmpmasModel source)
    {
        var clone = new OEmpmasModel();

        clone.EmpmasId      = source.EmpmasId;
        clone.EmpNumber     = source.EmpNumber;
        clone.UserId        = source.UserId;
        clone.EmpLastNm     = source.EmpLastNm;
        clone.EmpFirstNm    = source.EmpFirstNm;
        clone.EmpMidNm      = source.EmpMidNm;
        clone.EmpAlias      = source.EmpAlias;
        clone.Suffix        = source.Suffix;
        clone.Email         = source.Email;
        clone.Height        = source.Height;
        clone.HeightInches  = source.HeightInches;

        return clone;
    }

    private void SplitHeight(double? height)
    {
        if (height.HasValue)
        {
            double h = height.Value;
            double feet = Math.Truncate(h);
            double inchesPart = Math.Round((h - feet) * 100, MidpointRounding.AwayFromZero);

            v.EmpmasToEdit.Height = feet;
            v.EmpmasToEdit.HeightInches = inchesPart;
        }
        else
        {
            v.EmpmasToEdit.Height = null;
            v.EmpmasToEdit.HeightInches = null;
        }
    }

   
