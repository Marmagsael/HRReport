@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRMvc.Applications.PisModules.Views.Blazor.F2052
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_00_Modal


<TelerikRootComponent>
    <div class="position-relative">
        <TelerikNotification @ref="@NotificationRef" HorizontalPosition="@NotificationHorizontalPosition.Right" VerticalPosition="@NotificationVerticalPosition.Top" AnimationType="@AnimationType.SlideLeft" />

        <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

        <CascadingValue Value="@Uc">
            <CascadingValue Value="@v">
                <CascadingValue Value="@rv">
                    <CascadingValue Value="@NotificationRef">
                        <_00BT_FullW HdrCaption="Employee Entry">
                            <Details>


                                @*--- REPORT ---*@
                                 <_02BTRep Rv="rv" ChildAction="ChildAction" />

                                @if (v.ShowDataEntry)
                                {
                                    <_2052_01_Modal_DataEntry ChildAction="ChildAction" />
                                } 

                                @*--- EMPLOYESS STATUS MODAL ---*@
                                 @if (v.ShowStatusModal == true)
                                {
                                    <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowStatusModal = false" ModalWidth="50%">

                                        <Content>
                                            <_2052_02_Modal_StatusSettings ChildAction="ChildAction" />
                                        </Content>

                                    </_00Modal>
                                } 

                                <div class="p-2 flex-grow-1 overflow-hidden">
                                    <div class="d-flex gap-2 w-100 h-100">
                                        <div class="pe-1  h-100 overflow-hidden" style="width:28%; min-width:0;">
                                            <_2052_02_EmpList ChildAction="ChildAction" />
                                        </div>
                                         <div class="ps-1 pe-2 hide-scroll  w-85 h-100" style=" min-width:0; overflow-y:auto; overflow-x:hidden;">
                                            <_2052_03_RecordsEntry ChildAction="ChildAction" />
                                        </div> 
                                    </div>
                                </div>

                            </Details>
                        </_00BT_FullW>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
  
</TelerikRootComponent>




@inject IOEmpmasDataAccess _empmas
@inject IOCivstatDataAccess _ocivstat
@inject IOGenderDataAccess _ogender
@inject I_00CountryDataAccess _ocountry
@inject IOMlacodeDataAccess _omla
@inject IOPositionDataAccess _oposition
@inject IOEmpstatDataAccess _oempstat
@inject IOEmpmas_visible_statusDataAccess _oselectedEmpstat
@inject IOProcodeDataAccess _opro
@inject IOPisReportDataAccess _pisRep;

@inject IOEmployDataAccess _employemt
@inject IOEducateDataAccess _education
@inject IOParentDataAccess _parent
@inject IOChildrenDataAccess _children
@inject IOEmergencDataAccess _emergency;
@inject IOFamilyDataAccess _family
@inject IOTrainDataAccess _training
@inject IOReferDataAccess _charref
@inject IOInsuranceaccidentDataAccess _insuranceacc

@code {

    V2052 v { get; set; } = new();

    [Parameter]
    public UserClaimsModel? Uc { get; set; } = new();

    V00_RepVars rv = new();

    private TelerikNotification? NotificationRef;


    protected override async Task OnInitializedAsync()
    {

        if (Uc.Conn == null || Uc.OpisDb == null || Uc.OpayDb == null)
        {
            NotificationRef.Show("Something went wrong while loading the employee page. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }


        if(v.UcLoaded == true ) return;


        v.UcLoaded      = true; //to prevent double calling of this function

        v.maindb        = Uc.SchemaMain;
        v.pisdb         = Uc.OpisDb;
        v.newpisdb      = Uc.SchemaUserPis;
        v.paydb         = Uc.OpayDb;
        v.conn          = Uc.Conn;
        v.userid        = Uc.UserId;
        v.defcoid       = int.Parse(Uc.DefCompanyId ?? "0");

        v.IsLoading = true;

        try
        {
            // Load Status ---------
            await LoadSelectedStatus();
            await LoadEmployeeStatus();


            await LoadEmployeeList();
            await LoadDropdownValues();


            // Report ---------
            _00InitializeReport();
            await _02LoadCompanyInfo();
        }
        finally  
        {
            v.IsLoading = false;
        }




    }



    private async Task LoadSelectedStatus()
    {
        try
        {
            v.OEmpstatVisibleStatus = await _oselectedEmpstat._02s(v.pisdb, v.conn) ?? new();
        }

        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load selected statuses. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }



    private async Task LoadEmployeeStatus()
    {
        try
        {
            var empstats = await _oempstat._02s(v.pisdb, v.conn) ?? new();
            v.OEmpstats = empstats.Where(e => !string.IsNullOrWhiteSpace(e.Name)).ToList();
            if (v.OEmpstatVisibleStatus.Any())
            {
                v.SelectedStatus = v.OEmpstats.Where(e => v.OEmpstatVisibleStatus.Any(a => (e.Code).Trim() == (a.Empstat_).Trim() )).ToList();
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employee statuses. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
            return;

        }
    }

    private async Task LoadEmployeeList()
    {

        v.EmpmasList = [];

        if (!v.SelectedStatus.Any())
        {
            NotificationRef.Show("Please select at least one status to load the employee list.", ThemeConstants.Notification.ThemeColor.Info);
            return;
        }

        v.IsLoading = true;

        try
        {
            var statuses = new List<string>();
            foreach (var s in v.SelectedStatus)
            {
                statuses.Add(s.Code);
            }

            var res = await _empmas._02By1stLetterRangeByStatus("A", "J", statuses, v.pisdb, v.conn);
            if (res.Any())
            {
                v.EmpmasList = res;
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employee list. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }

    }

    private async Task LoadDropdownValues()
    {
        await LoadCivilStatuses();
        await LoadGenders();
        await LoadCountries();
        await LoadMlaCodes();
        await LoadProCodes();
        await LoadPositions();
    }

    private async Task LoadCivilStatuses()
    {
        try
        {
            v.OCivStats = await _ocivstat._02(v.pisdb, v.conn) ?? new();
        }
        catch (Exception ex)
