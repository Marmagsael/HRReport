@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRMvc.Applications.PisModules.Views.Blazor.F2052
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_00_Modal


<TelerikRootComponent>
    <div class="position-relative">

        @*--- TELERIK NOTIFICATION ---*@
        <TelerikNotification @ref="@NotificationRef" 
            HorizontalPosition="@NotificationHorizontalPosition.Right" 
            VerticalPosition="@NotificationVerticalPosition.Top" 
            AnimationType="@AnimationType.SlideLeft" />

        @*--- TELERIK LOADER ---*@
        <TelerikLoaderContainer 
            Visible="@v.IsLoading" 
            LoaderType="@LoaderType.ConvergingSpinner" />

        @*--- PARAMETERS ---*@
        <CascadingValue Value="@Uc">
            <CascadingValue Value="@v">
                <CascadingValue Value="@rv">
                    <CascadingValue Value="@NotificationRef">
                        <_00BT_FullW HdrCaption="Employee Entry">
                            <Details>

                                @*--- REPORT ---*@
                                 <_02BTRep Rv="rv" ChildAction="ChildAction" />


                                @*--- EMPLOYEE STATUS SETTINGS MODAL ---*@
                                @if (v.ShowStatusModal == true)
                                {
                                    <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowStatusModal = false" ModalWidth="50%">
                                        <Content>
                                            <_2052_02_Modal_StatusSettings ChildAction="ChildAction" />
                                        </Content>
                                    </_00Modal>
                                }



                                @*--- SECURITY LICENSE VERIFICATION LOGS ---*@
                                @if (v.ShowLicenseVerficationLogsModal)
                                {
                                    <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowLicenseVerficationLogsModal = false" ModalWidth="50%">
                                        <Content>
                                            <_2052_02_Modal_LicenseVerificationLogs ChildAction="ChildAction" />
                                        </Content>
                                    </_00Modal>
                                }


                                @*--- EMPLOYEE DATA ENTRY MODAL ---*@
                                @if (v.ShowDataEntry)
                                {
                                    <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowDataEntry = false" ModalWidth="50%">
                                        <Content>
                                            <_2052_01_Modal_DataEntry ChildAction="ChildAction" @ref="DataEntryRef" />
                                        </Content>
                                    </_00Modal>
                                }

                                @*--- EMPLOYEE LIST AND EMPLOYEE RECORDS ---*@
                                <div class="p-2 flex-grow-1 overflow-hidden">
                                    <div class="d-flex gap-2 w-100 h-100">
                                        <div class="pe-1  h-100 overflow-hidden" style="width:28%; min-width:0;">
                                             <_2052_02_EmpList ChildAction="ChildAction" /> 
                                        </div>

                                        <div class="ps-1 pe-2 hide-scroll  w-85 h-100" style=" min-width:0; overflow-y:auto; overflow-x:hidden;">
                                            <_2052_03_RecordsEntry ChildAction="ChildAction" />
                                        </div>
                                    </div>
                                </div>

                            </Details>
                        </_00BT_FullW>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>

</TelerikRootComponent>


