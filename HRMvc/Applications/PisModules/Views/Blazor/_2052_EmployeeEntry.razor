@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRMvc.Applications.PisModules.Views.Blazor.F2052
@using HRMvc.Applications.PisModules.Views.Blazor.F2052.F2052_00_Modal


<TelerikRootComponent>
    <TelerikNotification @ref="@NotificationRef" HorizontalPosition="@NotificationHorizontalPosition.Right" VerticalPosition="@NotificationVerticalPosition.Top" AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

     <CascadingValue Value="@Uc">
        <CascadingValue Value="@v">
            <CascadingValue Value="@rv">
                <CascadingValue Value="@NotificationRef">
                      <_00BT_FullW HdrCaption="Employee Entry">
                           <Details>


                            @*--- REPORT ---*@
                            <_02BTRep Rv="rv" ChildAction="ChildAction" />

                                @if (v.ShowDataEntry)
                                {
                                    <_2052_01_Modal_DataEntry  ChildAction="ChildAction" />
                                }

                                @*--- EMPLOYESS STATUS MODAL ---*@
                                @if (v.ShowStatusModal == true)
                                {
                                    <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowStatusModal = false" ModalWidth="50%">

                                        <Content>
                                            <_2052_02_Modal_StatusSettings ChildAction="ChildAction"  />
                                        </Content>

                                    </_00Modal>
                                }

                                <div class="p-2 flex-grow-1 overflow-hidden">
                                    <div class="d-flex gap-2 w-100 h-100">
                                        <div class="pe-1  h-100 overflow-hidden" style="width:28%; min-width:0;">
                                            <_2052_02_EmpList  ChildAction="ChildAction" />
                                        </div>
                                        <div class="ps-1 pe-2 hide-scroll  w-85 h-100" style=" min-width:0; overflow-y:auto; overflow-x:hidden;">
                                            <_2052_03_RecordsEntry  ChildAction="ChildAction" />
                                        </div>
                                    </div>
                                </div>

                        </Details>
                    </_00BT_FullW>

                </CascadingValue>
            </CascadingValue>
            </CascadingValue>
         </CascadingValue>
</TelerikRootComponent>




@inject IOEmpmasDataAccess _empmas
@inject IOCivstatDataAccess _ocivstat
@inject IOGenderDataAccess _ogender
@inject I_00CountryDataAccess _ocountry
@inject IOMlacodeDataAccess _omla
@inject IOPositionDataAccess _oposition
@inject IOEmpstatDataAccess _oempstat
@inject IOEmpmas_visible_statusDataAccess _oselectedEmpstat
@inject IOProcodeDataAccess _opro
@inject IOPisReportDataAccess _pisRep;

@code {

    V2052 v { get; set; } = new();

    [Parameter]
    public UserClaimsModel? Uc { get; set; } = new();

    V00_RepVars rv = new();

    private TelerikNotification? NotificationRef;


    protected override async Task OnInitializedAsync()
    {
        if (Uc == null) return;

        v.maindb        = Uc.SchemaMain;
        v.pisdb         = Uc.OpisDb;
        v.newpisdb      = Uc.SchemaUserPis;
        v.paydb         = Uc.OpayDb;
        v.conn          = Uc.Conn;
        v.userid        = Uc.UserId;
        v.defcoid       = int.Parse(Uc.DefCompanyId ?? "0");

        if (v.conn == null || v.pisdb == null || v.paydb == null) return;

        v.IsLoading = true;

        try
        {
            await LoadSelectedStatus();
            await LoadEmployeeStatus();
            await LoadEmployeeList();
            await LoadDropdownValues();


            // Report ---------
            _00InitializeReport();
            await _02LoadCompanyInfo();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong while loading the employee page. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }


        v.IsLoading = false;

    }

     private void _00InitializeReport()
    {
        rv.MCaption = "";
        rv.RefreshToken = 20520000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }





    private async Task LoadSelectedStatus()
    {
        try
        {
            v.OEmpstatVisibleStatus = await _oselectedEmpstat._02s(v.pisdb, v.conn) ?? new();
        }

        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load selected statues. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadEmployeeStatus()
    {
        try
        {
            var empstats = await _oempstat._02s(v.pisdb, v.conn) ?? new();
            v.OEmpstats = empstats.Where(e => !string.IsNullOrWhiteSpace(e.Name)).ToList();
            if (v.OEmpstatVisibleStatus.Any())
            {
                v.SelectedStatus = v.OEmpstats.Where(e => v.OEmpstatVisibleStatus.Any(a => e.Code == a.Empstat_)).ToList();
            }


        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employee statues. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadEmployeeList()
    {

        v.EmpmasList = [];
        try
        {
            var statuses = new List<string>();
            foreach (var s in v.SelectedStatus)
            {
                statuses.Add(s.Code);
            }

            var res = await _empmas._02By1stLetterRangeByStatus("A", "J", statuses, v.pisdb, v.conn);
            if (res.Any())
            {
                v.EmpmasList = res;
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employee list. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    
    private async Task LoadDropdownValues()
    {
        await LoadCivilStatuses();
        await LoadGenders();
        await LoadCountries();
        await LoadMlaCodes();
        await LoadProCodes();
        await LoadPositions();
    }


    private async Task LoadCivilStatuses()
    {
        try
        {
            v.OCivStats = await _ocivstat._02(v.pisdb, v.conn) ?? new();
        }
        catch (Exception ex)
        {
            
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load civil status. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private async Task LoadGenders()
    {
        try
        {
            v.OGenders = await _ogender._02(v.pisdb, v.conn) ?? new();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load gender. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private async Task LoadCountries()
    {
        try
        {
            v.Countrys = await _ocountry._02(v.maindb, v.conn) ?? new();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load countries. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private async Task LoadMlaCodes()
    {
        try
        {
            v.MlaList = await _omla._02(v.pisdb, v.conn) ?? new();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load Metro Manila codes. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadProCodes()
    {
        try
        {
            v.ProList = await _opro._02(v.pisdb, v.conn) ?? new();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load Provincial codes. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadPositions()
    {
        try
        {
            var positions = await _oposition._02(v.pisdb, v.conn) ?? new();
            v.OPositions = positions.Where(p => !string.IsNullOrWhiteSpace(p.Code) && !string.IsNullOrWhiteSpace(p.Name)).ToList();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load positions. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }




    private async Task ChildAction()
    {
        if (v == null) return;

        v.ActionRef = string.Empty;

        if (v.Action == "SelectEmpmas") await SelectEmpmas();
        if (v.Action == "SplitHeight") SplitHeight(v.EmpmasToEdit.Height);
        if (v.Action == "ReLoadEmployeeList") await LoadEmployeeList();

        v.Action = "";
    }

    private async Task SelectEmpmas()
    {
        if (string.IsNullOrWhiteSpace(v.SelectedEmpnumber)) return;

        try
        {
            var res = await _empmas._02(v.SelectedEmpnumber, v.pisdb, v.maindb, v.newpisdb, v.conn);
            var emp = res?.FirstOrDefault();

            if (emp != null)
            {
                v.IsNewEntry    = false;
                v.Empmas        = emp;
                v.EmpmasToEdit  = MapEmpmas(emp);

                SplitHeight(v.EmpmasToEdit.Height);
            }
            else
            {
                v.IsNewEntry = true;
                v.Empmas = new OEmpmasModel();

                v.EmpmasToEdit = new OEmpmasModel();

                SplitHeight(null);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong while loading the employee records. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

   
    static OEmpmasModel MapEmpmas(OEmpmasModel source)
    {
        var clone = new OEmpmasModel();

        clone.EmpmasId      = source.EmpmasId;
        clone.EmpNumber     = source.EmpNumber;
        clone.UserId        = source.UserId;
        clone.EmpLastNm     = source.EmpLastNm;
        clone.EmpFirstNm    = source.EmpFirstNm;
        clone.EmpMidNm      = source.EmpMidNm;
        clone.EmpAlias      = source.EmpAlias;
        clone.Suffix        = source.Suffix;
        clone.Email         = source.Email;
        clone.Height        = source.Height;
        clone.HeightInches  = source.HeightInches;

        return clone;
    }

    private void SplitHeight(double? height)
    {
        if (height.HasValue)
        {
            double h = height.Value;
            double feet = Math.Truncate(h);
            double inchesPart = Math.Round((h - feet) * 100, MidpointRounding.AwayFromZero);

            v.EmpmasToEdit.Height = feet;
            v.EmpmasToEdit.HeightInches = inchesPart;
        }
        else
        {
            v.EmpmasToEdit.Height = null;
            v.EmpmasToEdit.HeightInches = null;
        }
    }

   
}








