    }

    private async Task LoadPositions()
    {
        try
        {
            var positions = await _oposition._02(v.pisdb, v.conn) ?? new();
            v.OPositions = positions.Where(p => !string.IsNullOrWhiteSpace(p.Code) && !string.IsNullOrWhiteSpace(p.Name)).ToList();
        }
        catch (Exception ex)
        {

            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load positions. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);

        }
    }

    private void _00InitializeReport()
    {
        rv.MCaption = "";
        rv.RefreshToken = 20520000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }





    private async Task ChildAction()
    {
        if (v == null) return;

        v.ActionRef = string.Empty;

        if (v.Action == "SelectEmpmas") await SelectEmpmas();
        if (v.Action == "SplitHeight") SplitHeight(v.EmpmasToEdit.Height);
        if (v.Action == "GetAddressArea") GetAddressArea();
        if (v.Action == "GetGenderAndCivilStatus") GetGenderAndCivilStatus();
        if (v.Action == "ReLoadEmployeeList") await LoadEmployeeList();
        if (v.Action == "GenerateReport") await GenerateReport();

        v.Action = "";
    }

    private async Task GenerateReport()
    {
        rv.ShowModal = true;
        await Task.Delay(1000);
        v.IsLoading = false;
    }


    private async Task SelectEmpmas()
    {


        if (string.IsNullOrWhiteSpace(v.SelectedEmpnumber)) return;

        v.IsLoading = true;

        v.Employments = [];
        v.Educations = [];
        v.Parents = [];
        v.Children = [];
        v.EmergencyContacts = [];
        v.Familys = [];
        v.Trainings = [];
        v.CharRefs = [];
        v.InsuranceAccident = new();



        try
        {
            var res = await _empmas._02(v.SelectedEmpnumber, v.pisdb, v.maindb, v.newpisdb, v.conn);

            var emp = res?.FirstOrDefault();

            if (emp != null)
            {
                v.IsNewEntry    = false;
                v.Empmas        = emp;
                v.EmpmasToEdit  = MapEmpmas(emp);
                SplitHeight(v.EmpmasToEdit.Height);
                GetAddressArea();
                GetGenderAndCivilStatus();

                await LoadEmployments();
                await LoadEducations();
                await LoadParents();
                await LoadChildren();
                await LoadEmergencyContacts();
                await LoadRelatives();
                await LoadTrainings();
                await LoadCharRefs();
                await LoadInsuranceAccident();

            }
            else
            {
                v.IsNewEntry = true;
                v.Empmas = new OEmpmasModel();
                v.EmpmasToEdit = new OEmpmasModel();

                SplitHeight(null);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Something went wrong while loading the employee records. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }

        await Task.Delay(1000);
        v.IsLoading = false;

    }


    private void GetAddressArea()
    {
        v.Empmas.ManilaArea = string.Empty;
        v.Empmas.ProvincialArea = string.Empty;

        if (!string.IsNullOrWhiteSpace(v.Empmas.MlaCode_))
        {
            v.Empmas.ManilaArea = v.MlaList?.FirstOrDefault(m => m.Code == v.Empmas.MlaCode_)?.Name ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(v.Empmas.ProCode_))
        {
            v.Empmas.ProvincialArea = v.ProList? .FirstOrDefault(m => m.Code == v.Empmas.ProCode_)?.Name ?? string.Empty;
        }
    }

    private void GetGenderAndCivilStatus()
    {
        v.Empmas.Gender = string.Empty;
        v.Empmas.CivilStatus = string.Empty;

        if (!string.IsNullOrWhiteSpace(v.Empmas.Sex_))
        {
            v.Empmas.Gender = v.OGenders? .FirstOrDefault(m => m.Code == v.Empmas.Sex_)?.Name ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(v.Empmas.CivStat_))
        {
            v.Empmas.CivilStatus = v.OCivStats? .FirstOrDefault(m => m.Code == v.Empmas.CivStat_)?.Name ?? string.Empty;
        }
    }

    private  async Task LoadEmployments()
    {
        try
        {
           v.Employments = await _employemt._02(v.SelectedEmpnumber, v.pisdb!, v.conn!) ?? new();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load employments. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadEducations()
    {
        try
        {
            var res = await _education._02(v.SelectedEmpnumber, v.pisdb, v.conn) ?? new();

            var codes = new[] { "E", "H", "C", "V", "P" };
            foreach (var code in codes)
            {
                if (!res.Any(e => e?.Code == code)) res.Add(new OEducateModel { Code = code, EmpNumber = v.SelectedEmpnumber });
            }

           v.Educations = res;

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to load education records. Please refresh or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }
   
