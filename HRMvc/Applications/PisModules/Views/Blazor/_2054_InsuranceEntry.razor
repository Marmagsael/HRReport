@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2054



<TelerikRootComponent>


    @if (v.ShowUserList == true)
{
    <_00Modal ModuleCaption="Select User" ChildAction="() => v.ShowUserList = false">

        <Content>
              <_2054_InsuranceUserList  />
        </Content>

    </_00Modal>
}



    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <CascadingValue Value="@Uc">
        <CascadingValue Value="@v">
            <CascadingValue Value="@NotificationRef">

                <_00BT_FullW HdrCaption="Insurance Entry">

                    <Details>

                        <EditForm Model="@v.Empmas"
                                  OnSubmit="@SaveInsurance"
                                  class="h-100 d-flex flex-column">

                            @* --- Action Buttons --- *@
                            <div class="p-0">

                                <div class="card-header d-flex justify-content-between align-items-center w-100">

                                    <button type="submit"
                                            class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue "
                                            tabindex="1">
                                        Save
                                    </button>

                                    <div class="d-flex gap-2">

                                        <button type="button"
                                                class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                                                tabindex="2"
                                                @onclick="@( () => OpenSearcchModal())">
                                            Insurance Assignment
                                        </button>

                                        <button type="button"
                                                class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray "
                                                tabindex="3">
                                            Print
                                        </button>

                                    </div>

                                </div>

                            </div>


                            <div class="px-2 ps-md-3 pt-3">

                                @* --- Emp Number --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Emp No.
                                    </label>

                                    <div class="col-12 col-md-4 col-lg-3">

                                        <TelerikTextBox @bind-Value="@v.Empmas.EmpNumber"
                                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                        TabIndex="4"
                                                        Placeholder="Enter emp no. to load record" />

                                    </div>

                                </div>


                                @* --- Emp Name --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Name
                                    </label>

                                    <div class="col-12 col-md-7 col-lg-5">

                                        <TelerikTextBox @bind-Value="@v.Empmas.Fullname"
                                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                        ReadOnly
                                                        TabIndex="5"
                                                        Enabled="false" />

                                    </div>

                                </div>


                                @* --- Insurance --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Insurance
                                    </label>

                                    <div class="col-12 col-md-7 col-lg-5">

                                        <TelerikTextBox @bind-Value="@v.Empmas.Insurance"
                                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                        TabIndex="6" />

                                    </div>

                                </div>


                                @* --- Policy Number --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Policy Number
                                    </label>

                                    <div class="col-12 col-md-7 col-lg-5 col-lg-3">

                                        <TelerikTextBox @bind-Value="@v.Empmas.PolicyNo"
                                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                        TabIndex="7" />

                                    </div>

                                </div>


                                @* --- Face Value --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Face Value
                                    </label>

                                    <div class="col-12 col-md-4 col-lg-3">

                                        <TelerikNumericTextBox @bind-Value="@v.Empmas.FaceValue"
                                                               Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                               FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                               TabIndex="8" />

                                    </div>

                                </div>


                                @* --- Premium --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Premium
                                    </label>

                                    <div class="col-12 col-md-4 col-lg-3">

                                        <TelerikNumericTextBox @bind-Value="@v.Empmas.Premium"
                                                               Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                               FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                               TabIndex="9" />

                                    </div>

                                </div>


                                @* --- Expire Date --- *@
                                <div class="d-flex flex-column flex-md-row mb-2">

                                    <label class="fw-normal w-180p">
                                        Expire Date
                                    </label>

                                    <div class="col-12 col-md-4 col-lg-3">

                                        <TelerikDateInput @bind-Value="@v.Empmas.InsExpire"
                                                          Format="dd MMMM yyyy"
                                                          Width="100%">
                                        </TelerikDateInput>


                                    </div>

                                </div>

                            </div>

                        </EditForm>
                    </Details>

                </_00BT_FullW>

            </CascadingValue>
        </CascadingValue>
    </CascadingValue>

</TelerikRootComponent>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2054Model v = new();
    private TelerikNotification? NotificationRef;

    private void SaveInsurance()
    {

    }

    private void OpenSearcchModal()
    {
        v.Empmass = [];
        v.ShowUserList = true;
    }
}

