@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2054
@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.OPis;

@inject IOInsuranceDataAccess _insurance
@inject IOCoinfoDataAccess _coinfo
@inject IRCoInfoDataAccess _rcoinfo
@inject HRMvc.StartupConfig.CompanyLogoService _logo


@* Cascading values must wrap TelerikRootComponent: TelerikWindow content is rendered
   inside the root component, so cascades declared inside it never reach the modals. *@
<CascadingValue Value="@v">
    <CascadingValue Value="@Uc">
        <CascadingValue Value="@NotificationRef">
            <TelerikRootComponent>

                <TelerikNotification @ref="@NotificationRef"
                                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                                     VerticalPosition="@NotificationVerticalPosition.Top"
                                     AnimationType="@AnimationType.SlideLeft" />



                <_00BT_FullW HdrCaption="Insurance Entry">

                    <Details>
                        @*--- REPORT ---*@
                        <_02BTRep Rv="rv" ChildAction="ChildAction" />



                        <div class="p-2 flex-grow-1 overflow-hidden position-relative">

                            @*--- TELERIK LOADER (centered on the form, not the screen) ---*@
                            <TelerikLoaderContainer Visible="@v.IsLoading"
                                                    LoaderType="@LoaderType.ConvergingSpinner" />

                            @*--- ENTRY FORM MODAL ---*@
                            <TelerikWindow Modal="true" @bind-Visible="@v.ShowInsuranceEntryModal" Width="500px" Height="560px">
                                <WindowTitle>@v.ModalCaption</WindowTitle>
                                <WindowContent>
                                    <_2054_InsuranceEntryModal ChildAction="ChildAction" />
                                </WindowContent>
                                <WindowActions>
                                    <WindowAction Name="Close" />
                                </WindowActions>
                            </TelerikWindow>


                            @*--- INSURANCE ASSIGNMENT MODAL ---*@
                            <TelerikWindow Modal="true" @bind-Visible="@v.ShowInsuranceAssignmentModal" Width="90vw" Height="560px">
                                <WindowTitle>@v.ModalCaption</WindowTitle>
                                <WindowContent>
                                    <_2054_InsuranceAssignmentModal ChildAction="ChildAction" />
                                </WindowContent>
                                <WindowActions>
                                    <WindowAction Name="Close" />
                                </WindowActions>
                            </TelerikWindow>


                            @*---  Grid ---*@
                            <_2054_InsuranceList ChildAction="ChildAction" @ref="InsuranceGridRef" />

                        </div>
                    </Details>

                </_00BT_FullW>

            </TelerikRootComponent>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2054Model v = new();
    V00_RepVars rv = new();
    private TelerikNotification? NotificationRef;


    private _2054_InsuranceList InsuranceGridRef;


    // Data is loaded in OnAfterRenderAsync (not OnInitializedAsync) because OnAfterRenderAsync
    // does not run during prerendering. The prerendered HTML is sent right away with the loader
    // visible (v.IsLoading defaults to true), and the data is fetched only once, after the
    // interactive circuit connects. NotificationRef is also available by then.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await LoadPageData();
        StateHasChanged();
    }


    private async Task LoadPageData()
    {
        v.IsLoading = true;

        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            v.UcLoaded = false;
            v.IsLoading = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        v.UcLoaded = true;


        await _02LoadInsurances();

        // Report ---------
        InitializeReport();
        await _02LoadCompanyInfo();
        v.IsLoading = false;
    }


    private async Task _02LoadInsurances()
    {

        try
        {
            var res = await _insurance._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Insurances = res;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to load insurances", ThemeConstants.Notification.ThemeColor.Error);
        }

    }


    private void InitializeReport()
    {
        rv.MCaption = "Insurance Listing";
        rv.RefreshToken = 20550000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private byte[]? CompanyLogo;


    private async Task _02LoadCompanyInfo()
    {
        try
        {
            var o = await _coinfo._02(Uc.OpisDb, Uc.Conn);
            var r = await _rcoinfo._02(Uc.SchemaUserPis, Uc.Conn);

            rv.ReportParams["CoName"] = Pick(o?.CoName, r?.CoName) ?? "";
            rv.ReportParams["CoAddress"] = Pick(o?.CoAdd,
                                                JoinAddress(o?.Add1, o?.Add2),
                                                JoinAddress(r?.Add1, r?.Add2)) ?? "";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to load company information.", ThemeConstants.Notification.ThemeColor.Error);
        }

        try
        {
            CompanyLogo = (await _logo.GetAsync(Uc))?.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }


    // First value that is not empty (same helper as Company Information)
    private static string? Pick(params string?[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim();

    private static string? JoinAddress(string? add1, string? add2)
        => string.Join(" ", new[] { add1, add2 }.Where(a => !string.IsNullOrWhiteSpace(a)).Select(a => a!.Trim()));



    public async Task ChildAction()
    {
        var action = v.Action;
        v.Action = string.Empty;

        if (action == "RefreshInsuranceGrid") if (InsuranceGridRef != null) InsuranceGridRef.RebindGrid();
        if (action == "LoadInsurances") await _02LoadInsurances();

        // Print buttons (Insurance list toolbar / Insurance Assignment modal)
        if (action == "PrintInsuranceList")       await PrintInsuranceList();
        if (action == "PrintInsuranceAssignment") await PrintInsuranceAssignment();
    }


    // Insurance Listing report: all insurances grouped by type
    private async Task PrintInsuranceList()
    {
        var rows = (v.Insurances ?? new())
            .Where(i => i != null)
            .Select(i => new R2054ILModel
            {
                InsuranceType = i!.InsuranceType,
                InsuranceName = i.Name,
                PolicyNo      = i.PolicyNo,
                FaceValue     = i.FaceValue,
                Premiums      = i.Premiums,
                InsExpire     = i.InsExpire
            })
            .ToList();

        if (!rows.Any())
        {
            NotificationRef?.Show("No insurance records available for printing.", ThemeConstants.Notification.ThemeColor.Warning);
            return;
        }

        try
        {
            v.IsLoading = true;
            foreach (var r in rows) r.Logo = CompanyLogo;

            ShowReport("Reports/_01Pis/J_2054_IL.trdp", "Insurance Listing", rows);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to generate the insurance listing report.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
    }


    // Insurance Assignment report: type -> insurance -> assigned employees
    private async Task PrintInsuranceAssignment()
    {
        try
        {
            v.IsLoading = true;

            var res = await _insurance._02AssignmentReport(Uc.OpisDb, Uc.Conn) ?? new();

            var rows = res
                .Where(r => r != null)
                .Select(r => new R2054IAModel
                {
                    InsuranceType = r!.InsuranceType,
                    InsuranceName = r.InsuranceName,
                    PolicyNo      = r.PolicyNo,
                    FaceValue     = r.FaceValue,
                    Premiums      = r.Premiums,
                    InsExpire     = r.InsExpire,
                    EmpNumber     = r.EmpNumber,
                    EmpName       = r.EmpName,
                    ClName        = r.ClName,
                    EmpStatus     = r.EmpStatus
                })
                .ToList();

            if (!rows.Any())
            {
                NotificationRef?.Show("No employees are assigned to any insurance yet.", ThemeConstants.Notification.ThemeColor.Warning);
                return;
            }

            foreach (var r in rows) r.Logo = CompanyLogo;
            v.ShowInsuranceAssignmentModal = false;

            ShowReport("Reports/_01Pis/J_2054_IA.trdp", "Insurance Assignment", rows);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to generate the insurance assignment report.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
    }


    private void ShowReport(string relativePath, string title, IEnumerable<object> rows)
    {
        rv.RelativePath               = relativePath;
        rv.ReportData                 = rows;
        rv.MCaption                   = title;
        rv.ReportParams["ReportTitle"] = title;
        rv.ReportParams["RunDate"]     = DateTime.Now;
        rv.SelectedFormat             = "PDF";
        rv.RefreshToken               = (rv.RefreshToken ?? 0) + 1;   // both reports share the viewer, so force a refresh
        rv.ShowModal                  = true;
    }

}

