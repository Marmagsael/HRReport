@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2054



<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

        <CascadingValue Value="@v">
            <CascadingValue Value="@NotificationRef">

                <_00BT_FullW HdrCaption="Insurance Entry">

                    <Details>



                        @if (v.ShowInsuranceEntryModal == true)
                        {
                        <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowInsuranceEntryModal = false" ModalWidth="70vh">

                                <Content>
                                    <_2054_InsuranceEntryModal />
                                </Content>

                            </_00Modal>
                        }


                        @if (v.ShowInsuranceAssignmentModal == true)
                        {
                            <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowInsuranceAssignmentModal = false">

                                <Content>
                                    <_2054_InsuranceAssignmentModal />
                                </Content>

                            </_00Modal>
                        }




                        @*---  Grid ---*@
                       <_2054_InsuranceList ChildAction="ChildAction"/>
                    </Details>

                </_00BT_FullW>

            </CascadingValue>
        </CascadingValue>

</TelerikRootComponent>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2054Model v = new();
    private TelerikNotification? NotificationRef;


    private void ChildAction()
    {
        
    }

}

