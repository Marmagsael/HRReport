@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOCivstatDataAccess _civs;
@inject IOPisReportDataAccess _pisRep;


<div style="max-height:60vh">

    <EditForm Model="@V.CivilStatus"
              OnValidSubmit="@SaveRecord"
              class="h-100 d-flex flex-column">

               @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="3">
                Save
            </button>

        </div>

         <div class="px-2 ps-md-3 pt-3">
            
             
             @* --- Code Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Code
                </label>

                <div class="col-12 col-md-4">

                    <TelerikTextBox @bind-Value="@V.CivilStatus.Code"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="1"
                                    MaxLength="1" 
                                    Class="@(string.IsNullOrWhiteSpace(V.CodeErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.CodeErrorMsg))
                    {
                        <div class="txt-red small">@V.CodeErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Description --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Description
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.CivilStatus.Name"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2" 
                                    MaxLength="10"
                                    Class="@(string.IsNullOrWhiteSpace(V.DescriptionErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.DescriptionErrorMsg))
                    {
                        <div class="txt-red small">@V.DescriptionErrorMsg</div>
                    }

                </div>

            </div>


       
         </div>

    </EditForm>
</div>

@code{
    [CascadingParameter]
    public V2063Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }



    private async Task SaveRecord()
    {
        ResetErrorMessage();
        if (!IsFormValid()) return;

        var code = V.CivilStatus.Code.Trim().ToUpper();
        var name = V.CivilStatus.Name.Trim().ToUpper();


        var origcode = V.CivsvOriginalState?.Code?.Trim().ToUpper();
        var origname = V.CivsvOriginalState?.Name?.Trim().ToUpper();



        try
        {
            // Validate if code and name already exist
            var existingRecord = await _civs._02ByCodeorName(code, name, V.OPisdb, V.Conn);

            if (existingRecord != null && existingRecord.Any())
            {


                bool codeExists = existingRecord.Any(c => c.Code.Trim().ToUpper() == code && c.Code.Trim().ToUpper() != origcode);
                bool nameExists = existingRecord.Any(n => n.Name.Trim().ToUpper() == name && n.Name.Trim().ToUpper() != origname);

                var exist = false;

                if (codeExists)
                {
                    V.CodeErrorMsg = "Code already exists.";
                    exist = true;
                }

                if (nameExists)
                {
                    V.DescriptionErrorMsg = "Description already exists.";
                    exist = true;
                }
                if (exist) return;


            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to validate duplicate civils status.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
     


        if (V.CivsvOriginalState == null)
        {
            await _01InsertRecord();
        }
        else
        {
            await _03UpdateRecord();
        }
    }

    private async Task _01InsertRecord()
    {
        try
        {
            var res = await _civs._01(V.CivilStatus, V.OPisdb, V.Conn);

            if (res != null)
            {
                NotificationRef.Show("Unable to save civil status.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.CivilStatuses.Insert(0, res);
            V.CivilStatus = new OCivstatModel();

            V.Action = "RefreshGrid";
            NotificationRef.Show("Civil status saved successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef.Show("Unable to save civil status.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }



    private async Task _03UpdateRecord()
    {
        try
        {
            var res = await _civs._03(V.CivsvOriginalState.Code, V.CivilStatus, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to update civil status.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }


            V.CivsvOriginalState = new OCivstatModel
            {
                Code = res.Code,
                Name = res.Name,
            };


            V.Action = "LoadCivilStatuses";
            NotificationRef.Show("Civil status updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to update civil status.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }




    private bool IsFormValid()
    {
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(V.CivilStatus.Code))
        {
            V.CodeErrorMsg = "Code is required.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.CivilStatus.Name))
        {
            V.DescriptionErrorMsg = "Description is required.";
            isValid = false;
        }

        return isValid;
    }


    private void ResetErrorMessage()
    {
        V.CodeErrorMsg = string.Empty;
        V.DescriptionErrorMsg = string.Empty;
    }
}