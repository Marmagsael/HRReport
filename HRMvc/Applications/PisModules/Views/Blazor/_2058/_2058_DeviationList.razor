@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IODevdataDataAccess _deviation


<TelerikGrid TItem="ODevdataModel"
             Data="V.Deviations"
             @ref="DeviationTypeGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new ODevdataModel()))">
                Add Deviation
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Dev_No --- *@
        <GridColumn Field="@nameof(ODevdataModel.Dev_No)"
                    Title="Dev. No."
                    Width="80px" />

        @* --- Dev_Name --- *@
        <GridColumn Field="@nameof(ODevdataModel.Dev_Name)"
                    Title="Description"
                    Width="200px" />



      

        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="100px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (ODevdataModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray" 
                            @onclick="(() => Delete(rec))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No deviation type records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {
    [CascadingParameter]
    public V2058Model V { get; set; } = new();

    [CascadingParameter]
    V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<ODevdataModel> DeviationTypeGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task OpenEntryModal(ODevdataModel rec)
    {
        V.DevNoErrorMsg = string.Empty;
        V.DevNameErrorMsg = string.Empty;


        V.Deviation = new ODevdataModel();
        V.DeviationOriginalState = null;


        V.ModalCaption = "Add Deviation Type";

        if (!string.IsNullOrWhiteSpace(rec.Dev_No))
        {
            V.ModalCaption = "Edit Deviation Type";
            V.Deviation = MapRecord(rec);
            V.DeviationOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task Delete(ODevdataModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.Dev_Name}' record?", "Confirm Deviation Type Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _deviation._04(rec.Dev_No, V.OPisdb, V.Conn);

            if (res == null)
            {
                V.Deviations.Remove(rec);
                RebindGrid();
                NotificationRef?.Show("Deviation type has been deleted", ThemeConstants.Notification.ThemeColor.Success);

            }
            else
            {
                NotificationRef?.Show("Unable to delete deviation type", ThemeConstants.Notification.ThemeColor.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to delete deviation type", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private ODevdataModel MapRecord(ODevdataModel rec)
    {
        return new ODevdataModel
        {
            Dev_No = rec.Dev_No,
            Dev_Name = rec.Dev_Name,
        };
    }

    private async Task GenerateReport()
    {
        if (!V.Deviations.Any()) { return; }


        V.RepDtls = V.Deviations!;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Position Listing";
        Rv.RelativePath = "Reports/_01Pis/J_2058_DTE.trdp";
        Rv.SelectedFormat = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }

    public void RebindGrid()
    {
        DeviationTypeGridRef.Rebind();
    }
  
}

