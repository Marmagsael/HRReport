@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2053;
@using HRApiLibrary.DataAccess._10_Pis.OPis;
@using HRApiLibrary.DataAccess._20_Pay.Interface;

@inject IOClientDataAccess _client;
@inject IClientstatusDataAccess _clientstatus;
@inject IOAreaDataAccess _area;
@inject IORegionsDataAccess _regions;
@inject IOPisReportDataAccess _pisRep;
@inject ISettingsDataAccess _settings;


<TelerikRootComponent>
    <div class="overflow-hidden position-relative">
        <TelerikNotification @ref="@NotificationRef" HorizontalPosition="@NotificationHorizontalPosition.Right" VerticalPosition="@NotificationVerticalPosition.Top" AnimationType="@AnimationType.SlideLeft" />


        <CascadingValue Value="@Uc">
            <CascadingValue Value="@v">
                <CascadingValue Value="@rv">
                    <CascadingValue Value="@NotificationRef">
                        <_00BT_FullW HdrCaption="Deployment Entry">
                            <Details>


                                 @*--- REPORT ---*@
                                    <_02BTRep Rv="rv" ChildAction="ChildAction" />



                                <div class="p-2 flex-grow-1 overflow-hidden position-relative">

                                    @*--- TELERIK LOADER (centered on the form, not the screen) ---*@
                                    <TelerikLoaderContainer Visible="@v.IsGridLoading"
                                                            LoaderType="@LoaderType.ConvergingSpinner" />

                                    <TelerikLoaderContainer Visible="@v.IsReportLoading" 
                                                            LoaderType="@LoaderType.ConvergingSpinner" />



                                    @*--- ENTRY FORM MODAL ---*@
                                    @if (v.ShowEntryModal == true)
                                    {
                                        <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowEntryModal = false">

                                            <Content>
                                                <_2053_DeploymentEntryModal ChildAction="ChildAction" />
                                            </Content>

                                        </_00Modal>
                                    }

                                    @*--- DOLE REPORT MODAL ---*@
                                    @if (v.ShowDOLEReportModal == true)
                                    {

                                        <_2053_DeploymentDOLEReportModal ChildAction="ChildAction" />

                                    }

                                    @if (v.ShowDOLEReportModal == false)
                                    {
                                        @*--- GRID ---*@
                                        <_2053_DeploymentList ChildAction="ChildAction" @ref="DeploymentGridRef" />
                                    }
                                </div>

                            </Details>
                        </_00BT_FullW>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
</TelerikRootComponent>




@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    private V2053Model v = new();

    V00_RepVars rv = new();

    private TelerikNotification? NotificationRef;


    private _2053_DeploymentList DeploymentGridRef;

    protected override async Task OnInitializedAsync()
    {
        v.IsGridLoading = true;

        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        v.UcLoaded  = true;


        await _02LoadClients();
        await _02LoadClientStatus();
        await _02LoadAreas();
        await _02LoadRegions();


        // Report ---------
        _00InitializeReport();
        await _02LoadCompanyInfo();

        v.IsGridLoading = false;
    }


    private async Task ChildAction()
    {
        if (v.Action == "GenerateDeploymentList") await GenerateDeploymentList();
        if (v.Action == "GenerateDOLEDeploymentReport") await GenerateDOLEDeploymentReport();
        if (v.Action == "RefreshDeploymentGrid") if (DeploymentGridRef != null) DeploymentGridRef.RebindGrid();
        if (v.Action == "CloseEntryModalAndRefreshGrid") CloseEntryModal();
        v.Action = string.Empty;
    }



    private async Task _02LoadClients()
    {
        try
        {

            var res = await _client._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Clients = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for mother client drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task _02LoadClientStatus()
    {
        try
        {
            var res = await _clientstatus._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.ClientStatus = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for status drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private async Task _02LoadAreas()
    {
        try
        {
            var res = await _area._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Areas = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for status drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task _02LoadRegions()
    {
        try
        {
            var res = await _regions._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Regions = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for regions drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private void _00InitializeReport()
    {
        rv.MCaption = "";
        rv.RefreshToken = 20530000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        // var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        var res = await _settings._02(1, Uc.SchemaUserPay!, Uc.Conn!);

        rv.ReportParams["CoName"] = res.CoFullName ?? "";
        rv.ReportParams["CoAddress"] = res.CoAddress ?? "";
    }


    private async Task GenerateDeploymentList()
    {

        if (!v.RepDtls.Any()) { return; }
        v.IsReportLoading = true;


        rv.MCaption = "Deployment Listing";
        rv.RelativePath = "";
        rv.ReportData = [];
        rv.ReportData = v.RepDtls;

        rv.ReportParams["ReportTitle"] = "Deployment Listing";
        rv.RelativePath = "Reports/_01Pis/J_2053_DE.trdp";
        rv.SelectedFormat = "PDF";

        await Task.Delay(2000);
        rv.ShowModal = true;
        v.IsReportLoading = false;

    }


    private async Task GenerateDOLEDeploymentReport()
    {
        v.RepDtls = new List<OClientModel>();

        if (!v.SelectedDeployments.Any())
        {
            NotificationRef.Show(
                "Select a record to export to Excel.",
                ThemeConstants.Notification.ThemeColor.Warning
            );
            return;
        }

        v.IsReportLoading = true;

        try
        {
            v.RepDtls = v.SelectedDeployments.ToList();

            rv.MCaption = "Personnel Reporting";
            rv.RelativePath = "Reports/_01Pis/J_2053_DE_DOLE.trdp";
            rv.ReportData = v.RepDtls;

            rv.ReportParams["ReportTitle"] = "Personnel Reporting";
            rv.SelectedFormat = "XLSX";

            rv.ShowReport = true;

            await Task.Delay(2000);

            rv.ShowReport = false;

            NotificationRef.Show( "The Excel file has been generated successfully. Please check your browser's downloads.", ThemeConstants.Notification.ThemeColor.Success );

            v.SelectedDeployments = new List<OClientModel>();
        }
        catch (Exception ex)
        {
            NotificationRef.Show( $"Excel export failed: {ex.Message}", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsReportLoading = false;
        }
    }

    private void OpenEntryModal()
    {
        v.ShowEntryModal = true;
    }

    private void CloseEntryModal()
    {
        v.ShowEntryModal = false;
        if (DeploymentGridRef != null) DeploymentGridRef.RebindGrid();
    }


}
