@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2053;
@using HRApiLibrary.DataAccess._10_Pis.OPis;
@using HRApiLibrary.DataAccess._20_Pay.Interface;

@inject IOClientDataAccess _client;
@inject IClientstatusDataAccess _clientstatus;
@inject IOAreaDataAccess _area;
@inject IORegionsDataAccess _regions;
@inject IOPisReportDataAccess _pisRep;

<TelerikRootComponent>
    <TelerikNotification @ref="@NotificationRef" HorizontalPosition="@NotificationHorizontalPosition.Right" VerticalPosition="@NotificationVerticalPosition.Top" AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <CascadingValue Value="@Uc">
        <CascadingValue Value="@v">
            <CascadingValue Value="@rv">
                <CascadingValue Value="@NotificationRef">
                    <_00BT_FullW HdrCaption="Deployment Entry">
                        <Details>

                            @*--- REPORT ---*@
                            <_02BTRep Rv="rv" ChildAction="ChildAction" />


                            @*--- ENTRY FORM MODAL ---*@
                            @if (v.ShowEntryModal == true)
                            {
                                <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowEntryModal = false">

                                    <Content>
                                        <_2053_DeploymentEntryModal ChildAction="ChildAction" />
                                    </Content>

                                </_00Modal>
                            }

                            @*--- DOLE REPORT MODAL ---*@
                            @if (v.ShowDOLEReportModal == true)
                            {
                               
                                <_2053_DeploymentDOLEReportModal ChildAction="ChildAction" />
                                 
                            }

                            @if (v.ShowDOLEReportModal == false)
                            {
                                @*--- GRID ---*@
                                <_2053_DeploymentList ChildAction="ChildAction" @ref="DeploymentGridRef" />
                            }

                         
                        </Details>
                    </_00BT_FullW>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</TelerikRootComponent>




@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    private V2053Model v = new();

    V00_RepVars rv = new();

    private TelerikNotification? NotificationRef;


    private _2053_DeploymentList DeploymentGridRef;

    protected override async Task OnInitializedAsync()
    {

        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        v.UcLoaded  = true;
        v.IsLoading = true;

        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            NotificationRef.Show("Something went wrong.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        await _02LoadClients();
        await _02LoadClientStatus();
        await _02LoadAreas();
        await _02LoadRegions();


        // Report ---------
        _00InitializeReport();
        await _02LoadCompanyInfo();

        v.IsLoading = false;
    }


    private async Task ChildAction()
    {
        if (v.Action == "RefreshDeploymentGrid") if (DeploymentGridRef != null) DeploymentGridRef.RebindGrid();
        v.Action = string.Empty;
    }



    private async Task _02LoadClients()
    {
        try
        {

            var res = await _client._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Clients = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for mother client drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task _02LoadClientStatus()
    {
        try
        {
            var res = await _clientstatus._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.ClientStatus = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for status drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }


    private async Task _02LoadAreas()
    {
        try
        {
            var res = await _area._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Areas = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for status drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task _02LoadRegions()
    {
        try
        {
            var res = await _regions._02(Uc.OpisDb, Uc.Conn);
            if (res.Any())
            {
                v.Regions = res;
            }
        }
        catch (Exception)
        {
            NotificationRef.Show("Unable to load options for regions drop down.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }



    private void _00InitializeReport()
    {
        rv.MCaption = "";
        rv.RefreshToken = 20530000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }


  

    private void OpenEntryModal()
    {
        v.ShowEntryModal = true;
    }


}
