@using HRApiLibrary.DataAccess._10_Pis.OPis;

<TelerikGrid TItem="OPositionModel"
             Data="V.Positions"
             @ref="@PositionGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OPositionModel()))">
                Add Position
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Code --- *@
        <GridColumn Field="@nameof(OPositionModel.Code)"
                    Title="Code"
                    Width="80px" />

        @* --- Name --- *@
        <GridColumn Field="@nameof(OPositionModel.Name)"
                    Title="Description"
                    Width="200px" />

        @* --- Is Guard --- *@
        <GridColumn Field="@nameof(OPositionModel.Isguard)"
                    Title="Is Guard"
                    Width="80px">

            <FilterMenuTemplate Context="filterContext">
                <TelerikDropDownList Data="@V.GuardOptions"
                                     TextField="@nameof(V2055Model.GuardOption.Text)"
                                     ValueField="@nameof(V2055Model.GuardOption.Value)"
                                     Value="@SelectedIsGuardFilter"
                                     ValueChanged="@((string val) => OnGuardFilterChanged(val, filterContext))"
                                     DefaultText="Select...">
                </TelerikDropDownList>
            </FilterMenuTemplate>

            <Template Context="item">
                @{
                    var isGuard = ((OPositionModel)item).Isguard;
                }
                <div class="d-flex justify-content-center">
                    @if (!string.IsNullOrEmpty(isGuard))
                    {
                        <span class="badge @(isGuard == "1" ? "bg-success" : "bg-secondary")">
                            @(isGuard == "1" ? "Yes" : "No")
                        </span>
                    }
                </div>
            </Template>
        </GridColumn>

        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="100px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (OPositionModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => _04Delete(rec))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>
    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No position records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@inject IOPositionDataAccess _position;
@code {
    [CascadingParameter]
    public V2055Model V { get; set; } = new();

    [CascadingParameter]
    V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<OPositionModel> PositionGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task OpenEntryModal(OPositionModel rec)
    {
        V.CodeErrorMsg          = string.Empty;
        V.DescriptionErrorMsg   = string.Empty;


        V.Position = new OPositionModel();
        V.PositionOriginalState = null;


        V.ModalCaption = "Add Position";

        if (!string.IsNullOrWhiteSpace(rec.Code))
        {
            V.ModalCaption = "Edit Position";
            V.Position = MapRecord(rec);
            V.PositionOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task _04Delete(OPositionModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.Name}' record?", "Confirm Position Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _position._04(rec.Code, V.OPisdb, V.Conn);

            if (res != null)
            {
                NotificationRef?.Show("Unable to delete this position.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.Positions.Remove(rec);
            RebindGrid();
            NotificationRef?.Show("Position deleted successfully.", ThemeConstants.Notification.ThemeColor.Success);


        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to delete position.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private OPositionModel MapRecord(OPositionModel rec)
    {
        return new OPositionModel
        {
            Code = rec.Code,
            Name = rec.Name,
            Isguard = rec.Isguard,
            Sort = rec.Sort
        };
    }

    private async Task GenerateReport()
    {
        if (!V.Positions.Any()) { return; }


        V.RepDtls = V.Positions;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Position Listing";
        Rv.RelativePath     = "Reports/_01Pis/J_2055_PE.trdp";
        Rv.SelectedFormat   = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }

    // Custom Filter ----------------------------------------------------------------

    private string? SelectedIsGuardFilter;


    private void OnGuardFilterChanged(string value, FilterMenuTemplateContext filterContext)
    {
        SelectedIsGuardFilter = value;

        filterContext.FilterDescriptor.FilterDescriptors.Clear();

        if (!string.IsNullOrEmpty(value))
        {
            filterContext.FilterDescriptor.FilterDescriptors.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(OPositionModel.Isguard),
                Operator = Telerik.DataSource.FilterOperator.IsEqualTo,
                Value = value
            });
        }
    }

    public void RebindGrid()
    {
        PositionGridRef.Rebind();
    }
  
}

