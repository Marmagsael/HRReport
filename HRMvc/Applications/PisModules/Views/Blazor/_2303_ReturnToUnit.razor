@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Modules._2303O
@using HRApiLibrary.Modules._2308O
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@using HRMvc.Applications._00GeneralComponents

@inject IDA_2308O _da
@inject IDA_2303O _rtu
@inject IJSRuntime _js
@inject HRMvc.StartupConfig.CompanyLogoService _logo

<style>
    .ao-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:8px 12px; border:1px solid #c5ccd6; border-radius:6px; background:#fff; margin-bottom:8px; }
    .ao-card { padding:12px 16px; border:1px solid #c5ccd6; border-radius:6px; background:#fff; margin-bottom:8px; }
    .ao-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; flex-wrap:wrap; }
    .ao-row > label { width:150px; font-weight:600; }
    .ao-note { color:#6c757d; font-size:12px; }
</style>

<TelerikRootComponent>
<TelerikNotification @ref="@NotificationRef" HorizontalPosition="NotificationHorizontalPosition.Center" VerticalPosition="NotificationVerticalPosition.Top" />
<TelerikLoaderContainer Visible="@busy" Text="Please wait..." LoaderType="@LoaderType.ConvergingSpinner" />

<_00BT_FullW HdrCaption="Return To Unit">
    <Details>
        <div class="p-2">
            <div class="ao-bar">
                <TelerikButton OnClick="@New" Icon="@SvgIcon.FileAdd" Enabled="@(!busy)">New</TelerikButton>
                <TelerikButton OnClick="@Save" ThemeColor="primary" Icon="@SvgIcon.Save" Enabled="@(editing && !busy)">Save</TelerikButton>
                <TelerikButton OnClick="@Print" Icon="@SvgIcon.FilePdf" Enabled="@(!editing && number != "")">Print</TelerikButton>
                <span class="mx-2">|</span>
                <TelerikButton OnClick="@OpenFind" Icon="@SvgIcon.Search" Enabled="@editing">Search Employee</TelerikButton>
                <TelerikButton OnClick="@OpenTrans" Icon="@SvgIcon.Search">Search Transaction</TelerikButton>
            </div>

            <div class="ao-card">
                <div class="ao-row">
                    <label>Control Number</label>
                    <TelerikTextBox Value="@number" Enabled="false" Width="160px" />
                    <label class="ms-4" style="width:110px;">Date Prepared</label>
                    <TelerikDatePicker @bind-Value="prepDate" Format="MM/dd/yyyy" Width="150px" Enabled="@editing" />
                    <span class="ao-note">mm/dd/yyyy</span>
                </div>
            </div>

            <div class="ao-card">
                <div class="ao-row">
                    <label>Employee No.</label>
                    <TelerikTextBox Value="@empNumber" ValueChanged="@((string v) => OnEmpChanged(v))" MaxLength="5" Width="120px" Enabled="@editing" />
                    <TelerikTextBox Value="@empName" Enabled="false" Width="320px" />
                </div>
                <div class="ao-row">
                    <label>Client Name</label>
                    <TelerikTextBox Value="@clientLine" Enabled="false" Width="620px" />
                </div>
                <div class="ao-row">
                    <label>Date Assigned</label>
                    <TelerikDatePicker Value="@assDate" Format="MM/dd/yyyy" Width="150px" Enabled="false" />
                </div>
            </div>

            <div class="ao-card">
                <div class="ao-row">
                    <label>To Officially Recall</label>
                    <span class="ao-note">Report On</span>
                </div>
                <div class="ao-row">
                    <label>Date</label>
                    <TelerikDatePicker @bind-Value="reportOn" Format="MM/dd/yyyy" Width="150px" Enabled="@editing" />
                    <span class="ao-note">mm/dd/yyyy</span>
                    <TelerikCheckBox @bind-Value="useTime" Enabled="@editing" /> <span>Time</span>
                    <TelerikNumericTextBox @bind-Value="hh" Min="0" Max="12" Decimals="0" Format="00" Width="70px" Enabled="@(editing && useTime)" />
                    <span>:</span>
                    <TelerikNumericTextBox @bind-Value="mm" Min="0" Max="59" Decimals="0" Format="00" Width="70px" Enabled="@(editing && useTime)" />
                    <TelerikDropDownList Data="@ampm" @bind-Value="ap" Width="80px" Enabled="@(editing && useTime)" />
                </div>
                <div class="ao-row">
                    <label>Reason / Instruction</label>
                    <TelerikTextBox @bind-Value="note" Width="620px" Enabled="@editing" />
                </div>
            </div>

            <div class="d-flex gap-3 flex-wrap">
                <div class="ao-card" style="width:380px;">
                    <div class="mb-2"><TelerikCheckBox @bind-Value="show1" /> <span class="fw-bold">Prepared by</span></div>
                    <TelerikDropDownList Data="@signs1" Value="@signId1" ValueChanged="@((int v) => { signId1 = v; })" TextField="StaffNm" ValueField="StaffId" Width="100%" Class="mb-2" />
                    <TelerikTextBox @key="signId1" Value="@Pos(signs1, signId1)" Enabled="false" Width="100%" Class="mb-2" />
                    <TelerikButton OnClick="@(() => OpenSign(1))" Icon="@SvgIcon.UserOutline" Class="w-100">Signatory Manager</TelerikButton>
                </div>
                <div class="ao-card" style="width:380px;">
                    <div class="mb-2"><TelerikCheckBox @bind-Value="show2" /> <span class="fw-bold">Approved by</span></div>
                    <TelerikDropDownList Data="@signs2" Value="@signId2" ValueChanged="@((int v) => { signId2 = v; })" TextField="StaffNm" ValueField="StaffId" Width="100%" Class="mb-2" />
                    <TelerikTextBox @key="signId2" Value="@Pos(signs2, signId2)" Enabled="false" Width="100%" Class="mb-2" />
                    <TelerikButton OnClick="@(() => OpenSign(2))" Icon="@SvgIcon.UserOutline" Class="w-100">Signatory Manager</TelerikButton>
                </div>
            </div>
        </div>
    </Details>
</_00BT_FullW>

<TelerikWindow Modal="true" @bind-Visible="@showFind" Width="640px" Height="520px">
    <WindowTitle>Search Employee</WindowTitle>
    <WindowContent>
        <div class="ao-row">
            <TelerikTextBox @bind-Value="findText" Width="320px" Placeholder="Emp. no. or name" />
            <TelerikButton OnClick="@DoFind" ThemeColor="primary" Icon="@SvgIcon.Search">Search</TelerikButton>
        </div>
        <TelerikGrid Data="@found" Height="360px" Size="@ThemeConstants.Grid.Size.Small" OnRowDoubleClick="@PickEmp">
            <GridColumns>
                <GridColumn Field="@nameof(M2308_Employee.EmpNumber)" Title="Emp. No." Width="90px" />
                <GridColumn Field="@nameof(M2308_Employee.FullName)" Title="Name" />
                <GridColumn Field="@nameof(M2308_Employee.StatName)" Title="Status" Width="130px" />
            </GridColumns>
            <NoDataTemplate><div class="p-3 text-muted">Double-click an employee to select.</div></NoDataTemplate>
        </TelerikGrid>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showTrans" Width="420px" Height="200px">
    <WindowTitle>Search Transaction</WindowTitle>
    <WindowContent>
        <div class="ao-row">
            <label style="width:140px;">Control Number</label>
            <TelerikTextBox @bind-Value="findNumber" Width="140px" />
        </div>
        <TelerikButton OnClick="@DoTrans" ThemeColor="primary" Icon="@SvgIcon.Search">Open</TelerikButton>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showSign" Width="620px" Height="560px">
    <WindowTitle>Signatory Manager - @(sgWhich == 2 ? "Approved by" : "Prepared by")</WindowTitle>
    <WindowContent>
        <TelerikGrid Data="@(sgWhich == 2 ? signs2 : signs1)" Height="250px" Size="@ThemeConstants.Grid.Size.Small" SelectionMode="GridSelectionMode.Single" SelectedItems="@signSel" SelectedItemsChanged="@((IEnumerable<M2308_Signatory> l) => PickSign(l))">
            <GridColumns>
                <GridColumn Field="@nameof(M2308_Signatory.StaffNm)" Title="Name" />
                <GridColumn Field="@nameof(M2308_Signatory.StaffPos)" Title="Position" />
                <GridColumn Field="@nameof(M2308_Signatory.Defa)" Title="Default" Width="80px" TextAlign="ColumnTextAlign.Center"><Template>@(((M2308_Signatory)context).Defa == 1 ? "Yes" : "")</Template></GridColumn>
            </GridColumns>
        </TelerikGrid>
        <div class="ao-row mt-3"><label style="width:90px;">Name</label><TelerikTextBox @bind-Value="sgNm" DebounceDelay="150" MaxLength="60" Width="360px" /></div>
        <div class="ao-row"><label style="width:90px;">Position</label><TelerikTextBox @bind-Value="sgPos" DebounceDelay="150" MaxLength="60" Width="360px" /></div>
        <div class="ao-row"><label style="width:90px;"></label><TelerikCheckBox @bind-Value="sgDef" /> <span>Default signatory</span></div>
        <div class="ao-bar">
            <TelerikButton OnClick="@NewSign" Icon="@SvgIcon.FileAdd">New</TelerikButton>
            <TelerikButton OnClick="@SaveSign" ThemeColor="primary" Icon="@SvgIcon.Save">Save</TelerikButton>
            <TelerikButton OnClick="@DeleteSign" Icon="@SvgIcon.Trash" Enabled="@(sgId > 0)">Delete</TelerikButton>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikWindow Modal="true" @bind-Visible="@showPdf" Width="90vw" Height="92vh">
    <WindowTitle>Return To Unit</WindowTitle>
    <WindowContent>
        @if (pdfBase64 != null)
        {
            <iframe src="data:application/pdf;base64,@pdfBase64" style="width:100%;height:100%;border:none;"></iframe>
        }
    </WindowContent>
    <WindowActions><WindowAction Name="Close" /></WindowActions>
</TelerikWindow>

<TelerikDialog Visible="@showAsk" Title="Personnel Information System" ShowCloseButton="false" Width="420px">
    <DialogContent><p class="mb-0">@askMsg</p></DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="primary" OnClick="@(() => AskAnswer(true))">Yes</TelerikButton>
        <TelerikButton OnClick="@(() => AskAnswer(false))">No</TelerikButton>
    </DialogButtons>
</TelerikDialog>
</TelerikRootComponent>

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    TelerikNotification? NotificationRef;
    string Opis => Uc?.OpisDb ?? "";
    string Conn => Uc?.Conn ?? "";

    List<M2308_Signatory> signs1 = new(), signs2 = new();
    List<M2308_Employee> found = new();
    readonly List<string> ampm = new() { "AM", "PM" };

    string number = "", empNumber = "", empName = "", clientLine = "", clNumber = "", note = "", movMode = "", statCode = "";
    string findText = "", findNumber = "", ap = "AM";
    DateTime? prepDate = DateTime.Today, reportOn, assDate;
    int hh, mm, signId1, signId2;
    bool useTime, show1 = true, show2 = true;
    bool busy, editing, showFind, showTrans, showPdf, showSign;
    string? pdfBase64;

    int sgWhich, sgId;
    string sgNm = "", sgPos = "";
    bool sgDef;
    IEnumerable<M2308_Signatory> signSel = new List<M2308_Signatory>();

    TaskCompletionSource<bool>? askTcs;
    bool showAsk;
    string askMsg = "";
    Task<bool> Ask(string msg)
    {
        askMsg = msg; showAsk = true; askTcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return askTcs.Task;
    }
    void AskAnswer(bool yes) { showAsk = false; askTcs?.TrySetResult(yes); }

    static string Pos(List<M2308_Signatory> l, int id) => l.FirstOrDefault(s => s.StaffId == id)?.StaffPos ?? "";
    static int DefaultId(List<M2308_Signatory> l) => (l.FirstOrDefault(s => s.Defa == 1) ?? l.FirstOrDefault())?.StaffId ?? 0;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Opis)) return;
        try
        {
            signs1 = await _rtu._02Signatories(1, Opis, Conn);
            signs2 = await _rtu._02Signatories(2, Opis, Conn);
            signId1 = DefaultId(signs1);
            signId2 = DefaultId(signs2);
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 load: " + ex); Warn("Unable to load the lists."); }
    }

    void Warn(string msg) => NotificationRef?.Show(msg, ThemeConstants.Notification.ThemeColor.Warning);
    void Ok(string msg) => NotificationRef?.Show(msg, ThemeConstants.Notification.ThemeColor.Success);

    void ClearEmployee()
    {
        empNumber = ""; empName = ""; clientLine = ""; clNumber = ""; assDate = null; movMode = ""; statCode = "";
    }

    void New()
    {
        number = ""; ClearEmployee();
        prepDate = DateTime.Today; reportOn = null; note = "";
        useTime = false; hh = 0; mm = 0; ap = "AM";
        editing = true;
    }

    async Task OnEmpChanged(string? v = null)
    {
        if (v != null) empNumber = v;
        var n = (empNumber ?? "").Trim();
        if (n == "") { ClearEmployee(); return; }
        if (v != null && n.Length < 5) { empName = ""; clientLine = ""; assDate = null; return; }
        try
        {
            var e = await _da._02Employee(n, Opis, Conn);
            if (e == null) { ClearEmployee(); Warn("Employee not found."); return; }
            await ApplyEmployee(e);
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 emp: " + ex); Warn("Unable to load the employee."); }
    }

    async Task ApplyEmployee(M2308_Employee e)
    {
        empNumber = e.EmpNumber; empName = e.FullName; statCode = e.StatCode; movMode = e.MovMode; clNumber = "";
        clientLine = ""; assDate = null;
        if (e.StatCode == "A")
        {
            var c = await _rtu._02Client(e.ClNumber, Opis, Conn);
            if (c != null) { clNumber = c.ClNumber; clientLine = $"[{c.ClNumber}] {c.ClName} - {c.AreaCode}"; }
            assDate = e.MovDate;
        }
    }

    string TimeCode()
    {
        int h24 = ap == "AM" ? hh : hh + 12;
        return h24.ToString("00") + mm.ToString("00");
    }

    async Task Save()
    {
        if (!editing) return;
        await OnEmpChanged();
        if (string.IsNullOrWhiteSpace(empName)) { Warn("Invalid Employee"); return; }
        if (statCode == "" && movMode == "T") { Warn("Employee has pending RTU"); return; }
        if (clientLine == "") { Warn("Employee is not active, RTU should only be applied to active employees."); return; }
        if (prepDate == null) { Warn("Date is empty"); return; }
        if (useTime && (hh < 1 || hh > 12 || mm < 0 || mm > 59)) { Warn("Invalid time"); return; }
        if (reportOn == null) { Warn("Report on date is empty"); return; }
        if (prepDate > reportOn) { Warn("Date Prepared must not be greater than Report on date"); return; }

        busy = true; StateHasChanged();
        try
        {
            number = await _rtu._01Save(new M2303_Save
            {
                EmpNumber = empNumber.Trim(), ClNumber = clNumber, PrepDate = prepDate.Value, ReportOn = reportOn.Value,
                Time = TimeCode(), Note = note
            }, Opis, Conn);
            editing = false;
            Ok("New transaction saved successfully.");
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 save: " + ex); Warn("Unable to save the transaction."); }
        finally { busy = false; }
        if (number != "" && await Ask("New transaction saved successfully. Print this record?")) await Print();
    }

    void OpenFind() { found = new(); findText = ""; showFind = true; }

    async Task DoFind()
    {
        try { found = await _rtu._02SearchEmployees(findText, Opis, Conn); }
        catch (Exception ex) { Console.Error.WriteLine("2303 find: " + ex); Warn("Unable to search."); }
    }

    async Task PickEmp(GridRowClickEventArgs a)
    {
        if (a.Item is not M2308_Employee e) return;
        empNumber = e.EmpNumber;
        showFind = false;
        await OnEmpChanged();
    }

    void OpenTrans() { findNumber = ""; showTrans = true; }

    async Task DoTrans()
    {
        if (string.IsNullOrWhiteSpace(findNumber)) return;
        try
        {
            var o = await _rtu._02Order(findNumber, Opis, Conn);
            if (o == null) { Warn("CONTROL NO does not exist in the database"); return; }
            var e = await _da._02Employee(o.EmpNumber, Opis, Conn);
            number = o.Number; prepDate = o.PrepDate; reportOn = o.ReportOn; note = o.Reason.Trim();
            useTime = false; hh = 0; mm = 0; ap = "AM";
            if (o.Time.Length >= 4 && int.TryParse(o.Time[..2], out var h24) && int.TryParse(o.Time[2..4], out var m))
            {
                ap = h24 > 12 ? "PM" : "AM"; hh = h24 > 12 ? h24 - 12 : h24; mm = m;
                useTime = o.Time != "0000";
            }
            if (e != null)
            {
                empNumber = e.EmpNumber; empName = e.FullName; statCode = e.StatCode; movMode = e.MovMode;
                var c = await _rtu._02Client(o.ClNumber, Opis, Conn);
                clNumber = c?.ClNumber ?? ""; clientLine = c == null ? "" : $"[{c.ClNumber}] {c.ClName} - {c.AreaCode}";
                assDate = e.StatCode == "A" ? e.MovDate : null;
            }
            editing = false;
            showTrans = false;
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 trans: " + ex); Warn("Unable to open the transaction."); }
    }

    void OpenSign(int which) { sgWhich = which; NewSign(); showSign = true; }
    void NewSign() { sgId = 0; sgNm = ""; sgPos = ""; sgDef = false; signSel = new List<M2308_Signatory>(); }
    void PickSign(IEnumerable<M2308_Signatory> l)
    {
        signSel = l;
        var x = l.FirstOrDefault();
        if (x == null) return;
        sgId = x.StaffId; sgNm = x.StaffNm; sgPos = x.StaffPos; sgDef = x.Defa == 1;
    }

    async Task ReloadSigns()
    {
        if (sgWhich == 2)
        {
            var keep = signId2; signs2 = await _rtu._02Signatories(2, Opis, Conn);
            signId2 = signs2.Any(s => s.StaffId == keep) ? keep : DefaultId(signs2);
        }
        else
        {
            var keep = signId1; signs1 = await _rtu._02Signatories(1, Opis, Conn);
            signId1 = signs1.Any(s => s.StaffId == keep) ? keep : DefaultId(signs1);
        }
    }

    async Task SaveSign()
    {
        if (string.IsNullOrWhiteSpace(sgNm) || string.IsNullOrWhiteSpace(sgPos)) { Warn("Name and position are required."); return; }
        try
        {
            await _rtu._01Signatory(sgWhich, new M2308_Signatory { StaffId = sgId, StaffNm = sgNm.Trim(), StaffPos = sgPos.Trim(), Defa = sgDef ? 1 : 0 }, Opis, Conn);
            await ReloadSigns();
            NewSign();
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 sign: " + ex); Warn("Unable to save the signatory."); }
    }

    async Task DeleteSign()
    {
        if (sgId <= 0 || !await Ask("Are you sure you want to delete this record?")) return;
        try { await _rtu._04Signatory(sgWhich, sgId, Opis, Conn); await ReloadSigns(); NewSign(); }
        catch (Exception ex) { Console.Error.WriteLine("2303 sign: " + ex); Warn("Unable to delete the signatory."); }
    }

    async Task Print()
    {
        if (number == "") return;
        try
        {
            var co = await _da._02Company(Opis, Conn);
            var s1 = signs1.FirstOrDefault(x => x.StaffId == signId1);
            var s2 = signs2.FirstOrDefault(x => x.StaffId == signId2);
            var logo = (await _logo.GetAsync(Uc!))?.Data;
            var bytes = RtuPdf.Build(new RtuData
            {
                CompName = co.Name, CompAdd = co.Address, Client = clientLine, ControlNo = number,
                PrepDate = prepDate?.ToString("MM/dd/yyyy") ?? "", AssDate = assDate?.ToString("MM/dd/yyyy") ?? "",
                EmpNo = empNumber, EmpName = empName, ReportOnD = reportOn?.ToString("MM/dd/yyyy") ?? "",
                ReportOnT = hh.ToString("00") + " : " + mm.ToString("00") + " " + ap, ShowTime = useTime,
                Reason = (note ?? "").Trim(), Staff1 = s1?.StaffNm ?? "", Pos1 = s1?.StaffPos ?? "", Staff2 = s2?.StaffNm ?? "", Pos2 = s2?.StaffPos ?? "",
                Show1 = show1, Show2 = show2, Logo = logo
            });
            pdfBase64 = Convert.ToBase64String(bytes);
            showPdf = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("2303 pdf: " + ex); Warn("Unable to create the PDF."); }
    }
}
