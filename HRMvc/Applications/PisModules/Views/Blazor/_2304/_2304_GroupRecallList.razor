@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOAreaDataAccess _ac
@inject IOPisReportDataAccess _pisRep;


<TelerikGrid TItem="OClientModel"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="100%">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>



    <GridColumns>

        @* --- EMP. NO. --- *@
        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                    Title="Emp. No."
                    Width="80px" />

        @* --- EMP. NAME --- *@
        <GridColumn Field="@nameof(OClientModel.ClName)"
                    Title="Name"
                    Width="300px" />

        @* --- STATUS --- *@
        <GridColumn Field="@nameof(OClientModel.Status)"
                    Title="Status"
                    Width="80px"
                    HeaderClass="text-center" />

    </GridColumns>


    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {


    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };


}


