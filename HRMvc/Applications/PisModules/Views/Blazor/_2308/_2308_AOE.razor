<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="1" @onclick="OpenSearchEmployeeModal">
          New
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="6">
            Save
        </button>
        
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gary" type="button" tabindex="6">
            Search Employee
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gary" type="button" tabindex="6">
            Search Transaction
        </button>


    </div>
</div>

<div class="px-2 ps-md-3 pt-3">

    <div class="card py-2  px-3 mb-2">
        @* --- Control Number --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Duty Detail Order No.</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                TabIndex="2"
                                ReadOnly
                                Enabled="false">
                  
                </TelerikTextBox>
            </div>
        </div>


       
      
        @* -- Date Filed --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Date</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid" />
            </div>
        </div>
    </div>





    <div class="card py-2  px-3 mb-2">
        @* -- Employe Number --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Employee No.</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpNumber"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid">

                    <TextBoxSuffixTemplate>
                        <TelerikFontIcon Icon="@FontIcon.Search" Size="@ThemeConstants.FontIcon.Size.Small" />
                    </TextBoxSuffixTemplate>
                </TelerikTextBox>


            </div>
        </div>


        @* --- Employee Name --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Employee Name</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>

        @* -- Employe Number --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Status</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpNumber"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid">

                    <TextBoxSuffixTemplate>
                        <TelerikFontIcon Icon="@FontIcon.Search" Size="@ThemeConstants.FontIcon.Size.Small" />
                    </TextBoxSuffixTemplate>
                </TelerikTextBox>


            </div>
        </div>


        @* -- Lic. No. --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p ">Lic. #</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.SecLicense"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>


       


        @* -- Exp On. --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p ">Exp. on</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   ReadOnly
                                   Enabled="false" />
            </div>
        </div>


        @* -- Reason / Instruction --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Designation</label>

            <div class="col-12 col-md-7 col-lg-5">
                 <TelerikDropDownList Data="@V.OClients"
                                         TextField="ClNumber"
                                         ValueField="ClName"
                                         Filterable="true"
                                         @bind-Value="V.OEmpmas.Client_"
                                         TabIndex="3"
                                         Width="100%">

                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                </TelerikDropDownList>
            </div>
        </div>


       
        @*--    Place of Duty --*@
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p text-primary">Place of Duty</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikDropDownList Data="@V.OClients"
                                         TextField="ClNumber"
                                         ValueField="ClName"
                                         Filterable="true"
                                         @bind-Value="V.OEmpmas.Client_"
                                         TabIndex="3"
                                         Width="100%">

                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>

                    </TelerikDropDownList>
                    <div class="d-flex flex-column mt-2 gap-1">
                        <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                         Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                         FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                         MaxLength="150"
                                         Width="100%"
                                         TabIndex="4" 
                                         Enabled ="false"
                                         ReadOnly/>
                    </div>
                </div>

            </div>
        </div>


        @* -- Exp On. --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Duty Date</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   ReadOnly
                                   Enabled="false" />
            </div>
        </div>


        @* -- Reason / Instruction --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">Note</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                 Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                 FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                 MaxLength="150"
                                 Width="100%"
                                 TabIndex="4" />
            </div>
        </div>


        @* -- Reason / Instruction --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p text-primary">FA's Issued</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextArea @bind-Value="@V.OEmpmas.Addr1"
                                 Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                 FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                 MaxLength="150"
                                 Width="100%"
                                 TabIndex="4" />
            </div>
        </div>

    </div>



    <div class="card py-2 px-3 mb-2">
        <div class="row">
        

            @*-- Approved By --*@
            <div class="col-12 col-md-6">
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p text-primary">Approved By</label>

                    <div class="col-12 col-md-7 col-lg-6">
                        <TelerikDropDownList Data="@V.Approvers"
                                             TextField="Staff_Nm"
                                             ValueField="Staff_Id"
                                             Filterable="true"
                                             Value="V.Approver.Staff_Id"
                                             ValueChanged="@((int? value) => ChangeApprover(value))"
                                             TabIndex="3"
                                             Width="100%">

                            <DropDownListSettings>
                                <DropDownListPopupSettings Height="auto" />
                            </DropDownListSettings>

                        </TelerikDropDownList>
                        <div class="d-flex flex-column mt-2 gap-1">
                            <div class="card p-2 px-3 text-center h-35p border border-1">
                                @V.Approver.Staff_Pos
                            </div>

                            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
                                Signatory Manager
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2304Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private async Task OpenSearchEmployeeModal()
    {
        // V.ModalCaption = "Search Employee";
        // V.ShowSearchEmployeeModal = true;
        // await ChildAction.InvokeAsync();
    }

    private void  ChangePreparer(int? val)
    {
        V.Preparer.Staff_Id = val;
        V.Preparer.Staff_Pos = V.Preparers?.Where(p => p.Defa == 1).Select(p => p.Staff_Pos).FirstOrDefault();
    }

    private void ChangeApprover(int? val)
    {
        V.Approver.Staff_Id = val;
        V.Approver.Staff_Pos = V.Approvers?.Where(p => p.Defa == 1).Select(p => p.Staff_Pos).FirstOrDefault();
    }
}
