@using HRMvc.Applications._00GeneralComponents

<div class="card-header">
    Government Records
</div>

<div class="card-body">

    <div class="d-flex mt-2">
        @* ----- SSS Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">SSS Number :</div>
            <_01FormattedCharInput 
                Format="####-###-####"
                Value=""
                Disabled="true" />

        </div>


        @* ----- TIN Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">Tin Number :</div>
            <_01FormattedCharInput Format="###-###-###-###"
                                   Value=""
                                   Disabled="true" />

        </div>
    </div>


    <div class="d-flex mt-2">
        @* ----- Philhealth Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">Philhealth Number :</div>
            <_01FormattedCharInput Format="####-####-####"
                                   Value=""
                                   Disabled="true" />

        </div>


        @* ----- PAGIBIG Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">PagIBIG Number :</div>
            <_01FormattedCharInput Format="####-###-####"
                                   Value=""
                                   Disabled="true" />
        </div>
    </div>






    <div class="d-flex">
        @* ----- Acct Number ----------*@
        <div class="w-50">
            <div class="field d-flex w-320p mt-2">
                <div class="label">Account No. :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Tax Code ----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Tax Code :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <div class="w-50">
            @* ----- Security License No.----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Security License No. :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Driver'sLicense No.----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Driver's License No. :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>






    <div class="d-flex">
        <div class="w-50">
            @* ----- Security License Expiration Date----------*@
            <div class="field d-flex w-520p mt-2">
                <div class="label">Security License Expiration Date :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Driver's License Expiration Date.----------*@
            <div class="field d-flex w-520p mt-2">
                <div class="label">Driver's License Expiration Date :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>
        <div class="d-flex gap-1">
            <div class="w-20">
                @* ----- Life Insurance----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Life Insurance :</div>
                    <div class="line"></div>
                </div>
            </div>

            <div class="w-20">
                @* ----- Policy No..----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Policy No. :</div>
                    <div class="line"></div>
                </div>
            </div>
            <div class="w-20">
                @* ----- Face Value----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Face Value :</div>
                    <div class="line"></div>
                </div>
            </div>

            <div class="w-20">
                @* ----- Premium----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Premium :</div>
                    <div class="line"></div>
                </div>
            </div>

            <div class="w-20">
                @* ----- Expiration----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Expiration :</div>
                    <div class="line"></div>
                </div>
            </div>
        </div>
    

</div>

@code {
    DateTime date = new();
}
