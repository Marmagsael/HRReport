<div class="card-header">
   Profile
</div>

<div class="card-body">

    <div class="d-flex">
        <div class="w-70">
            <div class="d-flex gap-2">
                <div class="field d-flex w-20">
                    <div class="label">Emp. No.</div>
                    <div class="line"></div>
                </div>
                <div class="field d-flex w-20">
                    <div class="label">Employee Status</div>
                    <div class="line"></div>
                </div>
            </div>

    @* ----- Name ----------*@
    <div class="d-flex align-items-start mt-2">
        <div class="label">Name :</div>

        <div class="fields">
            <div class="field">
                <div class="line"></div>
                <div class="sub-label">LAST</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">FIRST</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">MIDDLE NAME</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">MAIDEN</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">NICKNAME</div>
            </div>
        </div>
    </div>

    @* ----- Present Address ----------*@
    <div class="field d-flex mt-2">
        <div class="label">Present Address :</div>
        <div class="line"></div>
    </div>

    <div class="d-flex align-items-center gap-3 w-100 mt-2">

        <div class="field w-320p d-flex align-items-center">
            <div class="label">City Municipality :</div>
            <div class="line"></div>
        </div>

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Province :</div>
            <div class="line"></div>
        </div>

    </div>
        <div class="d-flex align-items-center gap-3 w-100 mt-2">

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Telephone :</div>
            <div class="line"></div>
        </div>

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Cellphone :</div>
            <div class="line"></div>
        </div>
    </div>


        @* ----- Provincial Address ----------*@
    <div class="field d-flex mt-2">
        <div class="label">Provincial Address :</div>
        <div class="line"></div>
    </div>

    <div class="d-flex align-items-center gap-3 w-100 mt-2">

        <div class="field w-320p d-flex align-items-center">
            <div class="label">City Municipality :</div>
            <div class="line"></div>
        </div>

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Province :</div>
            <div class="line"></div>
        </div>

    </div>
        <div class="d-flex align-items-center gap-3 w-100 mt-2">

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Telephone :</div>
            <div class="line"></div>
        </div>

        <div class="field w-320p d-flex align-items-center">
            <div class="label">Cellphone :</div>
            <div class="line"></div>
        </div>
    </div>
</div>  
        <div class="w-30">
            
        </div> 
    </div>

</div>

@code {
    DateTime date = new();
}

