@using HRMvc.Applications._00GeneralComponents

<div class="card-header">
    Profile
</div>

<div class="card-body">
    <div class="d-flex gap-3">
        @*-----------------------------------*@
        @*---------- Employee Details -------*@
        <div class="w-80">

            @* ----- Employee No.----------*@
            <div class="d-flex gap-5">
                <div>
                    <div class="field d-flex w-220p">
                        <div class="label">Emp. No. :</div>
                        <div class="line"></div>
                    </div>
                </div>

                @* ----- Employee Status.----------*@
                <div class="">
                    <div class="field d-flex w-250p">
                        <div class="label">Emp. Status :</div>
                        <div class="line"></div>
                    </div>
                </div>
            </div>

            <div>


                @* ----- Name ----------*@
                <div class="d-flex align-items-start mt-3">
                    <div class="label">Name :</div>

                    <div class="fields">
                        <div class="field">
                            <div class="line"></div>
                            <div class="sub-label">LAST</div>
                        </div>

                        <div class="field">
                            <div class="line"></div>
                            <div class="sub-label">FIRST</div>
                        </div>

                        <div class="field">
                            <div class="line"></div>
                            <div class="sub-label">MIDDLE NAME</div>
                        </div>

                        <div class="field">
                            <div class="line"></div>
                            <div class="sub-label">MAIDEN</div>
                        </div>

                        <div class="field">
                            <div class="line"></div>
                            <div class="sub-label">NICKNAME</div>
                        </div>
                    </div>
                </div>


                @*---------------------------------*@
                @* ----- Present Address ----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Present Address :</div>
                    <div class="line"></div>
                </div>


                @* ----- Present Addr City/ Municipality and Province ----------*@
                <div class="d-flex align-items-center gap-3 w-100 mt-2">
                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">City Municipality :</div>
                        <div class="line"></div>
                    </div>

                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Province :</div>
                        <div class="line"></div>
                    </div>
                </div>



                @* ----- Present Addr Telephone and  Mobile ----------*@
                <div class="d-flex align-items-center gap-3 w-100 mt-2">
                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Telephone :</div>
                        <div class="line"></div>
                    </div>

                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Cellphone :</div>
                        <div class="line"></div>

                    </div>
                </div>

                @*------------------------------------*@
                @* ----- Provincial Address ----------*@
                <div class="field d-flex mt-2">
                    <div class="label">Provincial Address :</div>
                    <div class="line"></div>
                </div>


                @* ----- Provincial Addr City/ Municipality and Province ----------*@
                <div class="d-flex align-items-center gap-3 w-100 mt-2">
                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">City Municipality :</div>
                        <div class="line"></div>
                    </div>

                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Province :</div>
                        <div class="line"></div>
                    </div>

                </div>

                @* ----- Provincial Addr  Telephone and  Mobile ----------*@
                <div class="d-flex align-items-center gap-3 w-100 mt-2">
                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Telephone :</div>
                        <div class="line"></div>
                    </div>

                    <div class="field w-320p d-flex align-items-center">
                        <div class="label">Cellphone :</div>
                        <div class="line"></div>
                    </div>
                </div>

            </div>
        </div>



        @* ----- Employee Image ----------*@
        <div class="w-20">
            <div class="border h-200p">


            </div>
        </div>


    </div>

</div>

@code {
    DateTime date = new();
}

