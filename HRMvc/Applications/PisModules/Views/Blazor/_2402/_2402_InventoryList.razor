<div class="p-0">
    <div class="card-header d-flex gap-2">

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6" @onclick="NewEntry">
            New
        </button>


        <div class="vr"></div>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Print
        </button>

        <div class="vr"></div>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Type Mgr
        </button>

         <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Model Mgr
        </button>

         <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Make Mgr
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Caliber Mgr
        </button>
    </div>
</div>



<div class="py-2 px-3">

    <div class="card p-2 mb-2">
        @* --- Type --- *@
        <div class="d-flex flex-column flex-md-row">
            <label class="fw-normal w-180p">Type</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDropDownList Data="@V.OEmpStatuses"
                                     TextField="Code"
                                     ValueField="Name"
                                     @bind-Value="@V.OEmpStatus.Code"
                                     DefaultText="Select an item..."
                                     Filterable="true"
                                     TabIndex="1">
                    <DropDownListSettings>
                        <DropDownListPopupSettings Height="auto" />
                    </DropDownListSettings>
                </TelerikDropDownList>
            </div>
        </div>

    </div>
   



    <TelerikGrid TItem="OClientModel"
                 SelectionMode="@GridSelectionMode.Single"
                 Navigable="true"
                 Pageable="true"
                 @bind-PageSize="@PageSize"
                 Sortable="true"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Height="cal(100vh - 90)">

        <GridSettings>
            <GridPagerSettings PageSizes="@PageSizes" />
        </GridSettings>



        <GridColumns>

            @* --- CODE. --- *@
            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                        Title="Code"
                        Width="80px" />



            @* --- DESCRIPTION --- *@
            <GridColumn Field="@nameof(OClientModel.Status)"
                        Title="Description"
                        Width="300px"
                        HeaderClass="text-center" />

            @* --- MODEL --- *@
            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                        Title="Model"
                        Width="80px" />


            @* --- MAKE --- *@
            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                        Title="Make"
                        Width="80px" />


            @* --- CALIBER --- *@
            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                        Title="Caliber"
                        Width="80px" />

        </GridColumns>


        <NoDataTemplate>
            <div class="text-center text-secondary p-4">
                No records found.
            </div>
        </NoDataTemplate>

    </TelerikGrid>

</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2402Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        Console.WriteLine("New");
        V.ShowEntryModal = true;
        StateHasChanged();
        await ChildAction.InvokeAsync();
    }

}

