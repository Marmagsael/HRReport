<div class="p-0">
    <div class="card-header d-flex gap-3">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="5" @onclick="OpenSearchEmployeeModal">
           Search Employee
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="5">
           Retrieve Transaction
        </button>
    </div>
</div>

<div class="px-2 ps-md-3 pt-3">

    <div class="card py-2  px-3 mb-2">
        @* --- Control No. --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Control No.</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpNumber"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid" />
            </div>
        </div>


        @* --- Client Name --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Client Name</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                ReadOnly
                                Enabled="false" />
            </div>
        </div>

        @* ---  Date Assigned --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Date Assigned</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.Licexpire"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   ReadOnly
                                   Enabled="false" />
            </div>
        </div>


        @* --- Date Prepated --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Date Prepared</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDatePicker @bind-Value="@V.OEmpmas.Licexpire"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   />
            </div>
        </div>


       

    </div>


    <div class="card py-2  px-3 mb-2">
        @* -- Employee No. --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Employee No.</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpStat_"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                 />


            </div>
        </div>

        @* -- Employee Name  --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Employee Name</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextBox @bind-Value="@V.OEmpmas.EmpStat_"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid" 
                                ReadOnly
                                Enabled=false/>


            </div>
        </div>


        @* --- Report On Date --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Report On Date</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikDateTimePicker @bind-Value="@V.OEmpmas.Licexpire"
                                   Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                   FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                   Format="MM/dd/yyyy "
                                   />
            </div>
        </div>


        @* --- Reason / Instruction --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Reason or Instruction</label>

            <div class="col-12 col-md-7 col-lg-5">
                <TelerikTextArea @bind-Value="@V.OEmpmas.Fullname"
                                       Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                       FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                        />
            </div>
        </div>
    </div>

    

   

    <div class="card py-2  px-3 mb-2">
      
        @* --- Prepared  By --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Prepared By</label>

            <div class="d-flex flex-column flex-md-row gap-1 col-12 col-md-7 col-lg-5 ">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                 Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                 FillMode="@ThemeConstants.TextBox.FillMode.Solid" />

                <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="5">
                    Signatory Manager
                </button>
            </div>
        </div>

        @* --- Position --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Position</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid" />
            </div>
        </div>

        <hr/>


        @* --- Approved  By --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Approved By</label>

            <div class="d-flex flex-column flex-md-row gap-1 col-12 col-md-7 col-lg-5 ">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid" />

                <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="5">
                    Signatory Manager
                </button>
            </div>
        </div>

        @* --- Position --- *@
        <div class="d-flex flex-column flex-md-row mb-2">
            <label class="fw-normal w-180p">Position</label>

            <div class="col-12 col-md-7 col-lg-3">
                <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                FillMode="@ThemeConstants.TextBox.FillMode.Solid" />
            </div>
        </div>
    </div>



   


</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2303Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }


    private async Task OpenSearchEmployeeModal()
    {
        V.ShowSearchEmployeeModal = true;
        V.SearchEmployeeModalCaption = "Search Employee";
        await ChildAction.InvokeAsync();
    }
}
