@using Blazorise
@using HRApiLibrary.Models._00_Main
@using HRMvc.Applications.PisModules.Views.Blazor._2003


<div class="card">
    <div class="card-header">Time-Off Management</div>
    <div class="card-body p-0">
        <div class="mb-tabs bordered-bottom-darkgreen ">
            <div @onclick="@(() => TabClick(1))" class="mb-tab mb-a-blue @(tab == 1 ? " active " : "")">Leave Type</div>
            <div @onclick="@(() => TabClick(2))" class="mb-tab mb-a-blue @(tab == 2 ? " active " : "") ">Leave Group</div>
            <div @onclick="@(() => TabClick(3))" class="mb-tab mb-a-blue @(tab == 3 ? " active " : "") ">Leave Group Assignment</div>
            <div @onclick="@(() => TabClick(4))" class="mb-tab mb-a-blue @(tab == 4 ? " active " : "") ">Leave Credit</div>
        </div>
    </div>
</div>


@switch (tab) 
{
    case 1 : { <_2003_LvType            Uc="@Uc" /> break;  }
    case 2 : { <_2003_LvGrp             Uc="@Uc" /> break;  }
    case 3 : { <_2003_LvGrpAssignment   Uc="@Uc" /> break;  }
    case 4 : { <_2003_LvCredit          Uc="@Uc" /> break;  }

    default: { break; }
}

@code {
        [Parameter]public UserClaimsModel   Uc  {get; set;} = new();

        int? tab = 1; 

        void TabClick(int? no) {
                tab = no; 
        }    

}