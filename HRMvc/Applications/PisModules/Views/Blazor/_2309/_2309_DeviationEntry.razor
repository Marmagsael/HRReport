<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="1">
            New
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="6">
            Save
        </button>

    </div>
</div>




<div class="card p-0 mb-2">

    <div class="card-header txt-fcolor">
        RTU
    </div>

    <div class="py-2  px-3">

            @* --- Control Number --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Control Number</label>

                <div class="col-12 col-md-7 col-lg-3">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2">

                    </TelerikTextBox>
                </div>
            </div>



            @* -- Date Prepared --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Date Prepared</label>

                <div class="col-12 col-md-7 col-lg-3">
                    <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                       Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                       FillMode="@ThemeConstants.TextBox.FillMode.Solid" 
                                       ReadOnly
                                       Enabled=false/>
                </div>
            </div>



            @* -- Emp. No. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Employee No.</label>

                <div class="col-12 col-md-7 col-lg-3">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    ReadOnly
                                    Enabled="false">
                    </TelerikTextBox>
                </div>
            </div>


            @* --- Employee Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Employee Name</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.Fullname"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    ReadOnly
                                    Enabled="false" />
                </div>
            </div>


            @* -- Client --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p ">Client</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                     Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                     FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                     MaxLength="150"
                                     Width="100%"
                                     TabIndex="4" />
                </div>
            </div>



            @* -- Reason/Instruction --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p ">Reason / Instruction</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                     Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                     FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                     MaxLength="150"
                                     Width="100%"
                                     TabIndex="4" />
                </div>
            </div>
        
        </div>

</div>



<div class="d-flex flex-column flex-md-row align-items-stretch gap-2">

    @* Violation *@
    <div class="col-12 col-md-6 d-flex">
        <div class="card p-0 mb-2 flex-grow-1">

            <div class="card-header txt-fcolor">
                Violation
            </div>

            <div class="py-2 px-3">

                @* --- Type --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">Type</label>

                    <div class="col-12 col-md-7 col-lg-5">
                        <TelerikDropDownList Data="@V.OEmpStatuses"
                                             TextField="Code"
                                             ValueField="Name"
                                             @bind-Value="@V.OEmpStatus.Code"
                                             DefaultText="Select an item..."
                                             Filterable="true"
                                             TabIndex="1">
                            <DropDownListSettings>
                                <DropDownListPopupSettings Height="auto" />
                            </DropDownListSettings>
                        </TelerikDropDownList>
                    </div>
                </div>

                @* --- Date Committed --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">Date Committed</label>

                    <div class="col-12 col-md-7 col-lg-3">
                        <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                           Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                           FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                           ReadOnly
                                           Enabled="false" />
                    </div>
                </div>

                @* --- Times Committed --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">No. of Times Committed</label>

                    <div class="col-12 col-md-7 col-lg-3">
                        <TelerikNumericTextBox @bind-Value="@V.OEmpmas.NoChildren" />
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Penalty *@
    <div class="col-12 col-md-6 d-flex">
        <div class="card p-0 mb-2 flex-grow-1">

            <div class="card-header txt-fcolor">
                Penalty
            </div>

            <div class="py-2 px-3">

                @* --- Type --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">Type</label>

                    <div class="col-12 col-md-7 col-lg-5">
                        <TelerikDropDownList Data="@V.OEmpStatuses"
                                             TextField="Code"
                                             ValueField="Name"
                                             @bind-Value="@V.OEmpStatus.Code"
                                             DefaultText="Select an item..."
                                             Filterable="true"
                                             TabIndex="1">
                            <DropDownListSettings>
                                <DropDownListPopupSettings Height="auto" />
                            </DropDownListSettings>
                        </TelerikDropDownList>
                    </div>
                </div>

                @* --- Start Date --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">Start Date</label>

                    <div class="col-12 col-md-7 col-lg-3">
                        <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                           Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                           FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                           ReadOnly
                                           Enabled="false" />
                    </div>
                </div>

                @* --- End Date --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">End Date</label>

                    <div class="col-12 col-md-7 col-lg-3">
                        <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                           Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                           FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                           ReadOnly
                                           Enabled="false" />
                    </div>
                </div>

                @* --- No. of Days --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">No. of Days</label>

                    <div class="col-12 col-md-7 col-lg-3">
                        <TelerikNumericTextBox @bind-Value="@V.OEmpmas.NoChildren" />
                    </div>
                </div>

                @* --- Status --- *@
                <div class="d-flex flex-column flex-md-row mb-2">
                    <label class="fw-normal w-180p">Set Employee Status to</label>

                    <div class="col-12 col-md-7 col-lg-5">
                        <TelerikDropDownList Data="@V.OEmpStatuses"
                                             TextField="Code"
                                             ValueField="Name"
                                             @bind-Value="@V.OEmpStatus.Code"
                                             DefaultText="Select an item..."
                                             Filterable="true"
                                             TabIndex="1">
                            <DropDownListSettings>
                                <DropDownListPopupSettings Height="auto" />
                            </DropDownListSettings>
                        </TelerikDropDownList>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2302Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



}
