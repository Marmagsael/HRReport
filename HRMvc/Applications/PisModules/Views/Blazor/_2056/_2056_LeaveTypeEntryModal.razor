@using HRApiLibrary.DataAccess._10_Pis.OPis;

@inject IOLevtblDataAccess _leavetype

<div style="max-height:60vh">

    <EditForm Model="@V.LeaveType"
              OnValidSubmit="@SaveRecord"
              class="h-100 d-flex flex-column">

               @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="3">
                Save
            </button>

        </div>

         <div class="px-2 ps-md-3 pt-3">
            
             
             @* --- LvCode Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Code
                </label>

                <div class="col-12 col-md-4">

                    <TelerikTextBox @bind-Value="@V.LeaveType.LvCode"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="1"
                                    MaxLength="2"
                                    Class="@(string.IsNullOrWhiteSpace(V.CodeErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.CodeErrorMsg))
                    {
                        <div class="txt-red small">@V.CodeErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Description --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Description
                </label>

                <div class="col-12 col-md-8">
                    <TelerikTextBox @bind-Value="@V.LeaveType.LvName"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    MaxLength="20"
                                    Class="@(string.IsNullOrWhiteSpace(V.DescriptionErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.DescriptionErrorMsg))
                    {
                        <div class="txt-red small">@V.DescriptionErrorMsg</div>
                    }

                </div>

            </div>


         </div>

    </EditForm>
</div>

@code{
    [CascadingParameter]
    public V2056Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }



    private async Task SaveRecord()
    {
        ResetErrorMessage();
        if (!IsFormValid()) return;


        // Validate if code and name already exist
        var existingRecord = await _leavetype._02ByLvCodeOrByLvName(V.LeaveType.LvCode.Trim().ToUpper(), V.LeaveType.LvName.Trim().ToUpper(), V.OPisdb, V.Conn);

        if (existingRecord != null && existingRecord.Any())
        {

            var code = V.LeaveType.LvCode.Trim().ToUpper();
            var name = V.LeaveType.LvName.Trim().ToUpper();

            var origcode = V.LeaveTypeOriginalState?.LvCode?.Trim().ToUpper();
            var origname = V.LeaveTypeOriginalState?.LvName?.Trim().ToUpper();



            bool codeExists = existingRecord.Any(c => c.LvCode.Trim().ToUpper() == code && c.LvCode.Trim().ToUpper() != origcode);
            bool nameExists = existingRecord.Any(n => n.LvName.Trim().ToUpper() == name && n.LvName.Trim().ToUpper() != origname);

            var exist = false;

            if (codeExists)
            {
                V.CodeErrorMsg = "Code already exists.";
                exist = true;
            }

            if (nameExists)
            {
                V.DescriptionErrorMsg = "Leave type already exists";
                exist = true;
            }
            if (exist) return;


        }


        if (V.LeaveTypeOriginalState == null)
        {
            await _01InsertRecord();
        }
        else
        {
            await _03UpdateRecord();
        }
    }

    private async Task _01InsertRecord()
    {

        // To prevent null values for new entry
        V.LeaveType.EarnCode        = string.Empty;
        V.LeaveType.No_Indicate     = "0";



        try
        {
            var res = await _leavetype._01(V.LeaveType, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to insert leave type.", ThemeConstants.Notification.ThemeColor.Error);
                return;                
            }


            V.LeaveTypes.Insert(0, res);
            V.LeaveType = new OLevtblModel();

            V.Action = "RefreshGrid";
            NotificationRef.Show("Leave type inserted successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to insert leave type.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }



    private async Task _03UpdateRecord()
    {
        try
        {
            var res = await _leavetype._03(V.LeaveTypeOriginalState.LvCode, V.LeaveType, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to update leave type.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.LeaveTypeOriginalState = new OLevtblModel
            {
                LvCode = res.LvCode,
                LvName = res.LvName,
            };


            V.Action = "LoadLeaveTypes";
            NotificationRef.Show("Leave type updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to update leave type.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }




    private bool IsFormValid()
    {
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(V.LeaveType.LvCode))
        {
            V.CodeErrorMsg = "Leave type code is required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.LeaveType.LvName))
        {
            V.DescriptionErrorMsg = "Leave type description is required";
            isValid = false;
        }

        return isValid;
    }


    private void ResetErrorMessage()
    {
        V.CodeErrorMsg = string.Empty;
        V.DescriptionErrorMsg = string.Empty;
    }
}