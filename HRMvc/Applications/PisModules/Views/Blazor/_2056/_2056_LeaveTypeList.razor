@using HRApiLibrary.DataAccess._10_Pis.OPis;

@inject IOLevtblDataAccess _leavetype

<TelerikGrid TItem="OLevtblModel"
             Data="V.LeaveTypes"
             @ref="@LeaveTypeGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OLevtblModel()))">
                Add Leave Type
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Code --- *@
        <GridColumn Field="@nameof(OLevtblModel.LvCode)"
                    Title="Code"
                    Width="50px" />

        @* --- Name --- *@
        <GridColumn Field="@nameof(OLevtblModel.LvName)"
                    Title="Description"
                    Width="300px" />


        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="80px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (OLevtblModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => _04Delete(rec))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No leave type records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {
    [CascadingParameter]
    public V2056Model V { get; set; } = new();

    [CascadingParameter]
    V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }


    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<OLevtblModel> LeaveTypeGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task OpenEntryModal(OLevtblModel rec)
    {
        V.CodeErrorMsg = string.Empty;
        V.DescriptionErrorMsg = string.Empty;


        V.LeaveType = new OLevtblModel();
        V.LeaveTypeOriginalState = null;



        V.ModalCaption = "Add Leave Type";

        if (!string.IsNullOrWhiteSpace(rec.LvCode))
        {
            V.ModalCaption = "Edit Leave Type";
            V.LeaveType = MapRecord(rec);
            V.LeaveTypeOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task _04Delete(OLevtblModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.LvName}' record?", "Confirm Leave Type Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _leavetype._04(rec.LvCode, V.OPisdb, V.Conn);

            if (res != null)
            {
                NotificationRef?.Show("Unable to delete this leave type.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.LeaveTypes.Remove(rec);
            RebindGrid();
            NotificationRef?.Show("Leave deleted successfully.", ThemeConstants.Notification.ThemeColor.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to delete leave type", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private OLevtblModel MapRecord(OLevtblModel rec)
    {
        return new OLevtblModel
        {
            LvCode = rec.LvCode,
            LvName = rec.LvName,
        };
    }

    private async Task GenerateReport()
    {
        if (!V.LeaveTypes.Any()) { return; }


        V.RepDtls = V.LeaveTypes;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Leave Listing";
        Rv.RelativePath = "Reports/_01Pis/J_2056_LTE.trdp";
        Rv.SelectedFormat = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }


    public void RebindGrid()
    {
        LeaveTypeGridRef.Rebind();
    }

  
}

