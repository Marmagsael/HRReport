@using HRApiLibrary.DataAccess._10_Pis.OPis;
@using HRApiLibrary.DataAccess._20_Pay.Interface

@inject ISettingsDataAccess _settings;
@inject IOInsuranceDataAccess _insurance

<TelerikGrid TItem="OInsuranceModel"
             Data="@V.Insurances"
             @ref="@InsuranceGridRef"
             Navigable="true"
             Sortable="true"
             SelectionMode="@GridSelectionMode.Single"
             FilterMode="@GridFilterMode.FilterMenu"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OInsuranceModel()))">
                Add Insurance
            </button>

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => OpenInsuranceAssignmentModal())">
                Insurance Assignment
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

       
        @* --- INSURANCE TYPE --- *@
        <GridColumn Field="@nameof(OInsuranceModel.InsuranceType)"
                    Title="Insurance Type"
                    Width="150px" />

        @* --- INSURANCE NAME --- *@
        <GridColumn Field="@nameof(OInsuranceModel.Name)"
                    Title="Name"
                    Width="150px" />


        @* --- POLICY NO. --- *@
        <GridColumn Field="@nameof(OInsuranceModel.PolicyNo)"
                    Title="Policy No."
                    Width="150px" />

        @* --- FACE VALUE --- *@
        <GridColumn Field="@nameof(OInsuranceModel.FaceValue)"
                    Title="Face Value"
                    Width="120px"
                    DisplayFormat="{0:N2}" />

        @* --- PREMIUMS --- *@
        <GridColumn Field="@nameof(OInsuranceModel.Premiums)"
                    Title="Premiums"
                    Width="120px"
                    DisplayFormat="{0:N2}" />

        @* --- INSURANCE EXPIRY --- *@
        <GridColumn Field="@nameof(OInsuranceModel.InsExpire)"
                    Title="Insurance Expiry"
                    Width="130px"
                    DisplayFormat="{0:MM/dd/yyyy}" />

        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="100px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var insurance = (OInsuranceModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(insurance))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => _04Delete(insurance))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No insurance records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>


@* @inject IOInsuranceDataAccess _insurance *@
@code {
    [CascadingParameter]
    public V2054Model V { get; set; } = new();

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }

    
    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }


    [Parameter]
    public EventCallback ChildAction { get; set; }

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };


    private TelerikGrid<OInsuranceModel> InsuranceGridRef;

    private async Task OpenEntryModal(OInsuranceModel rec)
    {
        V.TypeErrorMsg = string.Empty;
        V.InsuranceDescErrorMsg = string.Empty;
        V.PolicyNoErrorMsg = string.Empty;
        V.PremiumErrorMsg = string.Empty;
        V.FaceValueErrorMsg = string.Empty;


        V.Insurance = new OInsuranceModel();
        V.InsuranceOriginalState = null;


        V.ModalCaption = "Add Insurance";

        if (rec.Id > 0 )
        {
            V.ModalCaption          = "Edit Insurance";
            V.Insurance = MapRecord(rec);
            V.InsuranceOriginalState = MapRecord(rec);
        }

        V.ShowInsuranceEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private OInsuranceModel MapRecord(OInsuranceModel rec)
    {
        return new OInsuranceModel
        {
            Id = rec.Id,
            Name = rec.Name,
            PolicyNo = rec.PolicyNo,
            InsuranceType = rec.InsuranceType,
            FaceValue = rec.FaceValue,
            Premiums = rec.Premiums,
            InsExpire = rec.InsExpire
        };
    }

    private async Task OpenInsuranceAssignmentModal()
    {
        V.ModalCaption = "Insurance Assignment";
        V.ShowInsuranceAssignmentModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task _04Delete(OInsuranceModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.Name}' record?", "Confirm Insurance Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _insurance._04(rec.Id, Uc.OpisDb, Uc.Conn);

            if (res != null)
            {
                NotificationRef?.Show("Unable to delete this insurance.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.Insurances.Remove(rec);
            RebindGrid();
            NotificationRef?.Show("Insurance deleted successfully.", ThemeConstants.Notification.ThemeColor.Success);


        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to delete insurance.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    public void RebindGrid()
    {
        InsuranceGridRef.Rebind();
    }
}

