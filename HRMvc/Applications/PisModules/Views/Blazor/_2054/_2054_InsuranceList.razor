    <TelerikGrid TItem="OEmpmasModel"
                 SelectionMode="@GridSelectionMode.Single"
                 Navigable="true"
                 Pageable="true"
                 @bind-PageSize="@PageSize"
                 Sortable="true"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Height="100%">

        <GridSettings>
            <GridPagerSettings PageSizes="@PageSizes" />
        </GridSettings>


        <GridColumns>

            @* --- EMPLOYEE NO. --- *@
            <GridColumn Field="@nameof(OEmpmasModel.EmpNumber)"
                        Title="Code"
                        Width="80px" />

            @* --- NAME --- *@
            <GridColumn Field="@nameof(OEmpmasModel.Fullname)"
                        Title="Name"
                        Width="200px" />


            @* --- Status --- *@
            <GridColumn Field="@nameof(OEmpmasModel.EmpStatus)"
                        Title="Status"
                        Width="80px" />


            @* --- Acttions --- *@
            <GridCommandColumn Title="Action"
                               Width="80px"
                               HeaderClass="text-center">

                <Template Context="item">

                    @{
                        var client = (OClientModel)item;
                    }

                    <div class="d-flex justify-content-center gap-2">
                        @* ---  EDIT BUTTON --- *@
                        <button class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                               >
                            Edit
                        </button>

                       
                    </div>
                </Template>
            </GridCommandColumn>


        </GridColumns>


        <NoDataTemplate>
            <div class="text-center text-secondary p-4">
                No clients found.
            </div>
        </NoDataTemplate>

    </TelerikGrid>


@code {
    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
