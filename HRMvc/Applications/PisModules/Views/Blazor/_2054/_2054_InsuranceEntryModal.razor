<div style="max-height:60vh">

    <EditForm Model="@V.Insurance"
              OnValidSubmit="@SaveInsurance"
              class="h-100 d-flex flex-column">

        @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="5">
                Save
            </button>

        </div>


        <div class="px-2 ps-md-3 pt-3">



            @* --- Insurance Type --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Insurance Type
                </label>

                <div class="col-12 col-md-5">

                    <TelerikDropDownList Data="@V.InsuranceTypes"
                                         @bind-Value="@V.Insurance.InsuranceType"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="1"
                                         Class="@(string.IsNullOrWhiteSpace(V.TypeErrorMsg) ? "" : "k-invalid")">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                    @if (!string.IsNullOrWhiteSpace(V.TypeErrorMsg))
                    {
                        <div class="txt-red small">@V.TypeErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Insurance Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Insurance
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.Insurance.Name"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    MaxLength="45" 
                                    Class="@(string.IsNullOrWhiteSpace(V.InsuranceDescErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.InsuranceDescErrorMsg))
                    {
                        <div class="txt-red small">@V.InsuranceDescErrorMsg</div>
                    }

                </div>

            </div>


         


            @* --- Policy No. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Policy No.
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.Insurance.PolicyNo"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="3"
                                    MaxLength="25" 
                                    Class="@(string.IsNullOrWhiteSpace(V.PolicyNoErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.PolicyNoErrorMsg))
                    {
                        <div class="txt-red small">@V.PolicyNoErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Face Value --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Face Value
                </label>

                <div class="col-12 col-md-5">

                    <TelerikNumericTextBox @bind-Value="@V.Insurance.FaceValue"
                                           Rounded="@ThemeConstants.NumericTextBox.Rounded.Large"
                                           FillMode="@ThemeConstants.NumericTextBox.FillMode.Solid"
                                           TabIndex="4"
                                           Min="0"
                                           Max="9999999999.99"
                                           Decimals="2"
                                           Format="N2" 
                                           Class="@(string.IsNullOrWhiteSpace(V.FaceValueErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.FaceValueErrorMsg))
                    {
                        <div class="txt-red small">@V.FaceValueErrorMsg</div>
                    }

                

                </div>

            </div>


            @* --- Premiums --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Premiums
                </label>

                <div class="col-12 col-md-5">

                    <TelerikNumericTextBox @bind-Value="@V.Insurance.Premiums"
                                           Rounded="@ThemeConstants.NumericTextBox.Rounded.Large"
                                           FillMode="@ThemeConstants.NumericTextBox.FillMode.Solid"
                                           TabIndex="5"
                                           Min="0"
                                           Max="9999999999.99"
                                           Decimals="2"
                                           Format="N2"
                                           Class="@(string.IsNullOrWhiteSpace(V.PremiumErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.PremiumErrorMsg))
                    {
                        <div class="txt-red small">@V.PremiumErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Insurance Expiration --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Date Expire
                </label>

                <div class="col-12 col-md-5">

                    <TelerikDatePicker @bind-Value="@V.Insurance.InsExpire"
                                       Rounded="@ThemeConstants.DatePicker.Rounded.Large"
                                       FillMode="@ThemeConstants.DatePicker.FillMode.Solid"
                                       TabIndex="6"/>

                </div>

            </div>

        </div>

    </EditForm>

</div>


@using HRApiLibrary.DataAccess._10_Pis.OPis;
@inject IOInsuranceDataAccess _insurance

@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2054Model V { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    [Parameter]
    public EventCallback ChildAction { get; set; }


    private async Task SaveInsurance()
    {
        ResetErrorMessage();
        if (!IsFormValid()) return;

        var insType = V.Insurance.InsuranceType?.Trim().ToUpper();
        var insName = V.Insurance.Name?.Trim().ToUpper();
        var insPolicy = V.Insurance.PolicyNo?.Trim().ToUpper();

        var origType = V.InsuranceOriginalState?.InsuranceType?.Trim().ToUpper();
        var origName = V.InsuranceOriginalState?.Name?.Trim().ToUpper();
        var origPolicy = V.InsuranceOriginalState?.PolicyNo?.Trim().ToUpper();

        // Validate if insurance type and policy number already exist
        var existingRecord = await _insurance._02ByTypeAndByPolicyNo(insType, insPolicy, Uc.OpisDb, Uc.Conn);

        if (existingRecord != null && existingRecord.Any())
        {
            bool policyExists = existingRecord.Any(c => c.InsuranceType?.Trim().ToUpper() == insType 
                    &&  c.PolicyNo?.Trim().ToUpper() == insPolicy && (V.InsuranceOriginalState == null || c.Id != V.InsuranceOriginalState.Id));

            if (policyExists)
            {
                V.PolicyNoErrorMsg = "Policy number already exists for this insurance type.";
                return;
            }
        }

        if (V.Insurance.Id == 0)
        {
            await _01InsertRecord();
        }
        else
        {
            await _03UpdateRecord();
        }
    }


    private async Task _01InsertRecord()
    {
        try
        {
            var res = await _insurance._01(V.Insurance, Uc.OpisDb, Uc.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to insert insurance.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.Insurances.Insert(0, res);
            V.Insurance = new OInsuranceModel();

            V.Action = "RefreshInsuranceGrid";
            NotificationRef.Show("Insurance inserted successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to insert insurance.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }


    private async Task _03UpdateRecord()
    {


        try
        {
            var res = await _insurance._03(V.Insurance.Id, V.Insurance, Uc.OpisDb, Uc.Conn);

            if (res == null)
            {

                NotificationRef.Show("Unable to update insurance.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.InsuranceOriginalState = new OInsuranceModel
            {
                Id = res.Id,
                Name = res.Name,
                PolicyNo = res.PolicyNo,
                InsuranceType = res.InsuranceType,
                FaceValue = res.FaceValue,
                Premiums = res.Premiums,
                InsExpire = res.InsExpire
            };


            V.Action = "LoadInsurances";
            NotificationRef.Show("Insurance updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to update insurance.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }




    private bool IsFormValid()
    {
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(V.Insurance.InsuranceType))
        {
            V.TypeErrorMsg = "Insurance Type is required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.Insurance.Name))
        {
            V.InsuranceDescErrorMsg = "Insurance Name is required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.Insurance.PolicyNo))
        {
            V.PolicyNoErrorMsg = "Policy No. is required";
            isValid = false;
        }

        if (V.Insurance.FaceValue <= 0)
        {
            V.FaceValueErrorMsg = "Face value is required";
            isValid = false;
        }


        if (V.Insurance.Premiums <= 0)
        {
            V.PremiumErrorMsg = "Premiums value is required";
            isValid = false;
        }

        return isValid;
    }

    private void ResetErrorMessage()
    {
        V.TypeErrorMsg = string.Empty;
        V.InsuranceDescErrorMsg = string.Empty;
        V.PolicyNoErrorMsg = string.Empty;
        V.FaceValueErrorMsg = string.Empty;
        V.PremiumErrorMsg = string.Empty;
    }
}
