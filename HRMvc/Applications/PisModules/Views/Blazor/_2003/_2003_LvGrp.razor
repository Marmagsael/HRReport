@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications.PisModules.Views.Blazor._2003._2003_LvGrp_Items

<div class="card ">
    <div class="card-body">

        @if (!v.ShowDE)
        {
            <div class="w-100  p-2 border mt-1 mb-1">
                <button @onclick="() => v.ShowDE = true" class="btn btn-primary btn-sm"> Add New </button>
            </div>
        }

        <div class=" small d-flex border-bottom card-header fw-bold">
            <div class="@wLvGrp "> Leave Group </div>
            <div class="@wAction "> Actions </div>
            <div class="@wApprover "> 1st Approver </div>
            <div class="@wApprover "> Final Approver </div>
        </div>

        <_2003_LvGrp_Approver Uc="@Uc" V="@v" />

        @foreach (LeavegrpModel lg in v.Leavegrps)
        {
            <div class="d-flex p2-1 ">
                <div class="d-flex  gap-1 @EditableCss(lg.IsEditable) ">
                    <div class=" @wLvGrp mt-1"> 
                        <RadzenTextBox Placeholder="Lv Code" class="w-100" MaxLength="45" @bind-Value=@lg.Name />
                    </div>
                    
                </div>


                <div class="@wAction mt-1 d-flex gap-1 ">
                    @if (!lg.IsEditable)
                    {
                        <button @onclick="@(_ => lg.IsEditable = true)" class="btn p-1 txt w-50p mb-a-blue h-30p  ">Edit</button>
                        <button @onclick="() => Delete(lg)"             class="btn p-1 txt w-60p mb-a-red h-30p ">Delete</button>
                    }
                    else
                    {
                        <button @onclick="() => Update(lg)" class="btn p-1 txt w-50p mb-a-green h-30p  ">Save</button>
                        <button @onclick="() => CancelEdit(lg)" class="btn p-1 txt w-60p mb-a-red h-30p ">X</button>
                    }
                </div>

                <div class=" mt-1 d-flex gap-1 disabled-div-50  ">
                    <div class="@wApprover  ">
                        <RadzenTextBox Placeholder="First Approver" class="w-100" MaxLength="45"
                                       @bind-Value=lg.Approver1Name />
                    </div>
                    <div class="@wApprover  ">
                        <RadzenTextBox Placeholder="Final Approver" class="w-100" MaxLength="45"
                                       @bind-Value=lg.FinalApproverName />
                    </div>
                </div>
                <div class=" d-flex gap-1 p-1 ">
                    <div class=" h-112p" style="margin-top: 2px;">
                        <button @onclick="() => ShowApproverModal(lg)" class="btn txt w-50p ht-39p mb-a-green  bordered  ">...</button>
                    </div>
                    
                </div>
            </div>
        }
    </div>
</div>




@inject ILeavegrpDataAccess             _lvgrp;
@inject ILeavegrpapproverDataAccess     _lvgrpapprover;

@code {
    [Parameter] public UserClaimsModel Uc {get; set; } = new(); 
    V2003_LvGrpModel      v = new(); 
    string wLvGrp => "w-250p";
    string wAction => "w-120p";
    string wApprover => "w-200p";

    void Update(LeavegrpModel lg) { lg.IsEditable = true;  }

    void CancelEdit(LeavegrpModel lg) {
        lg.IsEditable = false; 
    }
    void Delete(LeavegrpModel lg) {
        v.Leavegrps.Remove(lg);
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDatas();
    }

    async Task LoadDatas()
    {
        var res = await _lvgrp._02(Uc.SchemaUserPis, Uc.Conn);
        if (res.Count > 0) v.Leavegrps = res!;

        var resApprovers = await _lvgrpapprover._02s(Uc.SchemaUserPis, Uc.Conn);
        if (resApprovers.Count > 0) v.Leavegrpapprovers = resApprovers; 
    }

    void ShowApproverModal(LeavegrpModel lg) {
        v.Leavegrp = lg;
        v.ShowApproverEntry = true;
    }

    string EditableCss(bool IsEditable) => IsEditable   ? " " : " disabled-div-50 ";
    string DECss(bool ShowDE)           => ShowDE       ? " disabled-div-50 " : " ";

}