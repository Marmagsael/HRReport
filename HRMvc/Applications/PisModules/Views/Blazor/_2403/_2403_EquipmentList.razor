<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                type="button" tabindex="6" @onclick="NewEntry">
            New
        </button>
    </div>


    <div class="p-2">
        <div class="card p-0 mb-2">
            <div class="card-header txt-fcolor">
                SEARCH OPTION
            </div>

            <div class="py-2 px-3 d-flex flex-column flex-md-row gap-2">
                <div class="col-12 col-md-4">

                    @* --- Type --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Type</label>

                        <div class="col-12 col-md-7 ">
                            <TelerikDropDownList Data="@V.OEmpStatuses"
                                                 TextField="Code"
                                                 ValueField="Name"
                                                 @bind-Value="@V.OEmpStatus.Code"
                                                 DefaultText="Select an item..."
                                                 Filterable="true"
                                                 TabIndex="1">
                                <DropDownListSettings>
                                    <DropDownListPopupSettings Height="auto" />
                                </DropDownListSettings>
                            </TelerikDropDownList>
                        </div>
                    </div>

                    @* --- Make --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Make</label>

                        <div class="col-12 col-md-7">
                            <TelerikDropDownList Data="@V.OEmpStatuses"
                                                 TextField="Code"
                                                 ValueField="Name"
                                                 @bind-Value="@V.OEmpStatus.Code"
                                                 DefaultText="Select an item..."
                                                 Filterable="true"
                                                 TabIndex="1">
                                <DropDownListSettings>
                                    <DropDownListPopupSettings Height="auto" />
                                </DropDownListSettings>
                            </TelerikDropDownList>
                        </div>
                    </div>

                    @* --- Model --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Model</label>

                        <div class="col-12 col-md-7 ">
                            <TelerikDropDownList Data="@V.OEmpStatuses"
                                                 TextField="Code"
                                                 ValueField="Name"
                                                 @bind-Value="@V.OEmpStatus.Code"
                                                 DefaultText="Select an item..."
                                                 Filterable="true"
                                                 TabIndex="1">
                                <DropDownListSettings>
                                    <DropDownListPopupSettings Height="auto" />
                                </DropDownListSettings>
                            </TelerikDropDownList>
                        </div>
                    </div>

                    @* --- Caliber --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Caliber</label>

                        <div class="col-12 col-md-7">
                            <TelerikDropDownList Data="@V.OEmpStatuses"
                                                 TextField="Code"
                                                 ValueField="Name"
                                                 @bind-Value="@V.OEmpStatus.Code"
                                                 DefaultText="Select an item..."
                                                 Filterable="true"
                                                 TabIndex="1">
                                <DropDownListSettings>
                                    <DropDownListPopupSettings Height="auto" />
                                </DropDownListSettings>
                            </TelerikDropDownList>
                        </div>
                    </div>

                </div>
           
                <div class="col-12 col-md-8">
                    @* --- SERIAL NUMBER --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Serial No.</label>

                        <div class="col-12 col-md-4">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2"
>
                            </TelerikTextBox>
                        </div>
                    </div>

                    @* --- DESCRIPTION --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Description</label>

                        <div class="col-12 col-md-7">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2"
>
                            </TelerikTextBox>
                        </div>
                    </div>

                    @* --- LICENSE NUMBER --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Lic. No.</label>

                        <div class="col-12 col-md-4">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2"
>
                            </TelerikTextBox>
                        </div>
                    </div>

                    @* --- TMP LICENSE NUMBER --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Tmp. Lic. No.</label>

                        <div class="col-12 col-md-4">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2"
>
                            </TelerikTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <TelerikGrid TItem="OClientModel"
                     SelectionMode="@GridSelectionMode.Single"
                     Navigable="true"
                     Pageable="true"
                     @bind-PageSize="@PageSize"
                     Sortable="true"
                     FilterMode="@GridFilterMode.FilterMenu"
                     Height="calc(100vh - 45vh)">

            <GridSettings>
                <GridPagerSettings PageSizes="@PageSizes" />
            </GridSettings>

            <GridColumns>
                @* --- MODEL --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Model"
                            Width="80px" />

                @* --- MAKE --- *@
                <GridColumn Field="@nameof(OClientModel.Status)"
                            Title="Make"
                            Width="80px"
                            HeaderClass="text-center" />

                @* --- CALIBER --- *@
                <GridColumn Field="@nameof(OClientModel.Status)"
                            Title="Caliber"
                            Width="80px"
                            HeaderClass="text-center" />

                @* --- DESCRIPTION --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Description"
                            Width="200px" />

                @* --- SERIAL --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Serial No."
                            Width="80px" />

                @* --- STATUS --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Status"
                            Width="80px" />

                @* --- DEPLOYMENT --- *@
                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                            Title="Deployment"
                            Width="80px" />
            </GridColumns>

            <NoDataTemplate>
                <div class="text-center text-secondary p-4">
                    No records found.
                </div>
            </NoDataTemplate>

        </TelerikGrid>
    </div>
   



</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2403Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        V.ModalCaption = "Inventory Entry";
        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

}

