<div class="p-0">
    <div class="card-header d-flex gap-2">

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="6">
            Save
        </button>

    </div>
</div>




<div class="card py-2  px-3 mb-2">



    @* --- Type --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Type</label>

        <div class="col-12 col-md-6">
            <TelerikDropDownList Data="@V.OEmpStatuses"
                                 TextField="Code"
                                 ValueField="Name"
                                 @bind-Value="@V.OEmpStatus.Code"
                                 DefaultText="Select an item..."
                                 Filterable="true"
                                 TabIndex="1">
                <DropDownListSettings>
                    <DropDownListPopupSettings Height="auto" />
                </DropDownListSettings>
            </TelerikDropDownList>
        </div>
    </div>



    @* --- EQUIPMENT CODE  --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Equip Code</label>

        <div class="col-12 col-md-6">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2"
                            ReadOnly
                            Enabled="false">
            </TelerikTextBox>
        </div>
    </div>


    @* -- DESCRIPTION --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Description </label>

        <div class="col-12 col-md-8">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2"
                          >
            </TelerikTextBox>
        </div>
    </div>


    @* --- MODEL --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Model</label>

        <div class="col-12 col-md-6">
            <TelerikDropDownList Data="@V.OEmpStatuses"
                                 TextField="Code"
                                 ValueField="Name"
                                 @bind-Value="@V.OEmpStatus.Code"
                                 DefaultText="Select an item..."
                                 Filterable="true"
                                 TabIndex="1">
                <DropDownListSettings>
                    <DropDownListPopupSettings Height="auto" />
                </DropDownListSettings>
            </TelerikDropDownList>
        </div>
    </div>

    @* --- CALIBER --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Caliber</label>

        <div class="col-12 col-md-6">
            <TelerikDropDownList Data="@V.OEmpStatuses"
                                 TextField="Code"
                                 ValueField="Name"
                                 @bind-Value="@V.OEmpStatus.Code"
                                 DefaultText="Select an item..."
                                 Filterable="true"
                                 TabIndex="1">
                <DropDownListSettings>
                    <DropDownListPopupSettings Height="auto" />
                </DropDownListSettings>
            </TelerikDropDownList>
        </div>
    </div>

    @* --- Make --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Make</label>

        <div class="col-12 col-md-6">
            <TelerikDropDownList Data="@V.OEmpStatuses"
                                 TextField="Code"
                                 ValueField="Name"
                                 @bind-Value="@V.OEmpStatus.Code"
                                 DefaultText="Select an item..."
                                 Filterable="true"
                                 TabIndex="1">
                <DropDownListSettings>
                    <DropDownListPopupSettings Height="auto" />
                </DropDownListSettings>
            </TelerikDropDownList>
        </div>
    </div>



    @* -- OTHER DESCRIPTION CAPTION 1 --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Other Desc. Caption 1</label>

        <div class="col-12 col-md-8">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2">
            </TelerikTextBox>
        </div>
    </div>


    @* -- OTHER DESCRIPTION Value 2 --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Other Desc. Value 1</label>

        <div class="col-12 col-md-8">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2">
            </TelerikTextBox>
        </div>
    </div>

    @* -- OTHER DESCRIPTION Caption 1 --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Other Desc. Caption 2</label>

        <div class="col-12 col-md-8">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2">
            </TelerikTextBox>
        </div>
    </div>


    @* -- OTHER DESCRIPTION Value 2 --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p">Other Desc. Value 2</label>

        <div class="col-12 col-md-8">
            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                            TabIndex="2">
            </TelerikTextBox>
        </div>
    </div>


    @* -- Remarks --- *@
    <div class="d-flex flex-column flex-md-row mb-2">
        <label class="fw-normal w-180p ">Remarks</label>

        <div class="col-12 col-md-8">
            <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                             Rounded="@ThemeConstants.TextBox.Rounded.Large"
                             FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                             MaxLength="150"
                             Width="100%"
                             TabIndex="4" />
        </div>
    </div>

</div>




@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2403Model V { get; set; } = new();

    [Parameter] public EventCallback ChildAction { get; set; }



}
