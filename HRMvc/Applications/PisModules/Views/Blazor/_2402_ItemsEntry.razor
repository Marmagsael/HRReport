@using HRMvc.Applications.PisModules.Vars
@using HRMvc.Applications.PisModules.Views.Blazor._2402

<TelerikRootComponent>
    <div class="position-relative">

        @*--- TELERIK NOTIFICATION ---*@
        <TelerikNotification @ref="@NotificationRef"
                             HorizontalPosition="@NotificationHorizontalPosition.Right"
                             VerticalPosition="@NotificationVerticalPosition.Top"
                             AnimationType="@AnimationType.SlideLeft" />

        @*--- TELERIK LOADER ---*@
        <TelerikLoaderContainer Visible="@v.IsLoading"
                                LoaderType="@LoaderType.ConvergingSpinner" />

        @*--- PARAMETERS ---*@
        <CascadingValue Value="@Uc">
            <CascadingValue Value="@rv">
                <CascadingValue Value="@NotificationRef">
                    <_00BT_FullW HdrCaption="Items Entry">
                        <Details>

                            @*--- REPORT ---*@
                            <_02BTRep Rv="rv" ChildAction="ChildAction" />

                            <div>@v.ShowEntryModal</div>


                            @if (v.ShowEntryModal == true)
                            {
                                <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowEntryModal = false" ModalWidth="70vh">
                                    <Content>
                                        <_2402_InventoryEntry ChildAction="ChildAction" />
                                    </Content>
                                </_00Modal>
                            }


                            <_2402_InventoryList ChildAction="ChildAction" />


                        </Details>
                    </_00BT_FullW>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>

</TelerikRootComponent>

@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    V2402Model  v   = new();
    V00_RepVars rv  = new();

    private TelerikNotification? NotificationRef;


    protected override async Task OnInitializedAsync()
    {
        v.IsLoading = false;
    }



    private async Task ChildAction()
    {
        if (v == null) return;

        Console.WriteLine($"Main {v.ShowEntryModal}");
        v.Action = "";
    }
}
