@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOPenaltyDataAccess _penalty;
@inject IOPisReportDataAccess _pisRep;


<div style="max-height:60vh">

    <EditForm Model="@V.Penalty"
              OnValidSubmit="@SaveRecord"
              class="h-100 d-flex flex-column">

               @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="6">
                Save
            </button>

        </div>

         <div class="px-2 ps-md-3 pt-3">
            
             
             @* --- Penalty_No Desc_ --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Code
                </label>

                <div class="col-12 col-md-4">

                    <TelerikTextBox @bind-Value="@V.Penalty.Penalty_No"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="1"
                                    MaxLength="2" 
                                    Class="@(string.IsNullOrWhiteSpace(V.PenaltyNoErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.PenaltyNoErrorMsg))
                    {
                        <div class="txt-red small">@V.PenaltyNoErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Description --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Description
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.Penalty.Desc_"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    MaxLength="20" 
                                    Class="@(string.IsNullOrWhiteSpace(V.DescriptionErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.DescriptionErrorMsg))
                    {
                        <div class="txt-red small">@V.DescriptionErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Reset Reg Ref --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Reg Ref (Rst)
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.Penalty.ResetRegRef"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="3">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>



            @* --- Is Terminated --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                   Is Terminated
                </label>

                <div class="col-12 col-md-4">

                    <TelerikDropDownList Data="@V.YesNoOptions"
                                         @bind-Value="@V.Penalty.IsTerminated"
                                         Rounded="@ThemeConstants.DropDownList.Rounded.Large"
                                         FillMode="@ThemeConstants.DropDownList.FillMode.Solid"
                                         TabIndex="4">


                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="auto" />
                        </DropDownListSettings>
                    </TelerikDropDownList>

                </div>

            </div>


            @* --- Days --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                   Days
                </label>

                <div class="col-12 col-md-4">

                    <TelerikNumericTextBox @bind-Value="@V.Penalty.Days"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="5">
                    </TelerikNumericTextBox>

                </div>

            </div>

         </div>

    </EditForm>
</div>

@code{
    [CascadingParameter]
    public V2057Model V { get; set; } = new();


    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }



    private async Task SaveRecord()
    {
        ResetErrorMessage();
        if (!IsFormValid()) return;



        // ---------- Check Duplicate ---------------------------
        List<OPenaltyModel?>? existingRecord = null;

        var penaltyNo   = V.Penalty.Penalty_No.Trim().ToUpper();
        var desc        = V.Penalty.Desc_.Trim().ToUpper();


        var origpenaltyNo   = V.PenaltyvOriginalState?.Penalty_No?.Trim().ToUpper();
        var origdesc        = V.PenaltyvOriginalState?.Desc_?.Trim().ToUpper();

        try
        {
            existingRecord = await _penalty._02ByPenaltyNoByDescNo(penaltyNo, desc, V.OPisdb, V.Conn);
        }
        catch (Exception ex)
        {
            NotificationRef.Show("Unable to validate penalty type.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        if (existingRecord?.Any() == true)
        {

            // confirm if duplicate code && decription is allowed -- 
            bool recordExists = V.PenaltyvOriginalState == null ? true : existingRecord.Any(c => c.Penalty_No.Trim().ToUpper() != origpenaltyNo || c.Desc_.Trim().ToUpper() != origdesc);

            if (recordExists)
            {
                V.PenaltyNoErrorMsg = "Code already exists.";
                V.DescriptionErrorMsg = "Description already exists";
                return;
            }
        }

        // --------------------------------------------------------------





        if (V.PenaltyvOriginalState == null)
        {
            await InsertRecord();
        }
        else
        {
            await UpdateRecord();
        }
    }


    private async Task InsertRecord()
    {
        try
        {
            var res = await _penalty._01(V.Penalty, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to save penalty type.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.Penalties.Insert(0, res);
            V.Penalty = new OPenaltyModel();

            V.Action = "RefreshGrid";
            NotificationRef.Show("Penalty type inserted successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to save penalty type.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }



    private async Task UpdateRecord()
    {
        try
        {
            var res = await _penalty._03FromPenaltyEntryModule(V.PenaltyvOriginalState.Penalty_No, V.PenaltyvOriginalState.Desc_, V.Penalty, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to update penalty type.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.PenaltyvOriginalState = new OPenaltyModel
            {
                Penalty_No = res.Penalty_No,
                Desc_ = res.Desc_,
            };


            V.Action = "LoadPenaltyTypes";
            NotificationRef.Show("Penalty type  updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to update penalty type.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }




    private bool IsFormValid()
    {
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(V.Penalty.Penalty_No))
        {
            V.PenaltyNoErrorMsg = "Code is required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.Penalty.Desc_))
        {
            V.DescriptionErrorMsg = "Description is required";
            isValid = false;
        }

        return isValid;
    }


    private void ResetErrorMessage()
    {
        V.PenaltyNoErrorMsg = string.Empty;
        V.DescriptionErrorMsg = string.Empty;
    }
}