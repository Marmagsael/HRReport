@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOProcodeDataAccess _prov
@inject IOPisReportDataAccess _pisRep;


<TelerikGrid TItem="OProcodeModel"
             Data="V.ProvincialCodes"
             @ref="ProvGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OProcodeModel()))">
                Add Provincial Code
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" 
            @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Code --- *@
        <GridColumn Field="@nameof(OProcodeModel.Code)"
                    Title="Code"
                    Width="80px" />

        @* --- Name --- *@
        <GridColumn Field="@nameof(OProcodeModel.Name)"
                    Title="Description"
                    Width="200px" />



        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="80px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (OProcodeModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => Delete(rec))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No provinial code records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {
    [CascadingParameter]
    public V2060Model V { get; set; } = new();


    [CascadingParameter]
    V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<OProcodeModel> ProvGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task OpenEntryModal(OProcodeModel rec)
    {
        V.CodeErrorMsg = string.Empty;
        V.LocationErrorMsg = string.Empty;


        V.ProvincialCode = new OProcodeModel();
        V.ProvOriginalState = null;


        V.ModalCaption = "Add Provincial Code";

        if (!string.IsNullOrWhiteSpace(rec.Code))
        {
            V.ModalCaption = "Edit Provincial Code";
            V.ProvincialCode = MapRecord(rec);
            V.ProvOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task Delete(OProcodeModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.Name}' record?", "Confirm Provincial Code Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _prov._04(rec.Code, V.OPisdb, V.Conn);

            if (res == null)
            {
                V.ProvincialCodes.Remove(rec);
                RebindGrid();
                NotificationRef?.Show("Provincial code has been deleted", ThemeConstants.Notification.ThemeColor.Success);

            }
            else
            {
                NotificationRef?.Show("Unable to delete provincial code", ThemeConstants.Notification.ThemeColor.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to delete provincial code ", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private OProcodeModel MapRecord(OProcodeModel rec)
    {
        return new OProcodeModel
        {
            Code = rec.Code,
            Name = rec.Name,
        };
    }

    private async Task GenerateReport()
    {
        if (!V.ProvincialCodes.Any()) { return; }


        V.RepDtls = V.ProvincialCodes!;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Provincial Code Listing";
        Rv.RelativePath = "Reports/_01Pis/J_2060_PC.trdp";
        Rv.SelectedFormat = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }

    public void RebindGrid()
    {
        ProvGridRef.Rebind();
    }

}


