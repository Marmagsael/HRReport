@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOProcodeDataAccess _prov
@inject IOPisReportDataAccess _pisRep;


<div style="max-height:60vh">

    <EditForm Model="@V.ProvincialCode"
              OnValidSubmit="@SaveRecord"
              class="h-100 d-flex flex-column">

               @* --- Save Button --- *@
        <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    type="submit"
                    tabindex="3">
                Save
            </button>

        </div>

         <div class="px-2 ps-md-3 pt-3">
            
             
             @* --- Code Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Code
                </label>

                <div class="col-12 col-md-4">

                    <TelerikTextBox @bind-Value="@V.ProvincialCode.Code"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="1" 
                                    MaxLength="5"
                                    Class="@(string.IsNullOrWhiteSpace(V.CodeErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.CodeErrorMsg))
                    {
                        <div class="txt-red small">@V.CodeErrorMsg</div>
                    }

                </div>

            </div>


            @* --- Location --- *@
            <div class="d-flex flex-column flex-md-row mb-2">

                <label class="fw-normal w-180p">
                    Location
                </label>

                <div class="col-12 col-md-8">

                    <TelerikTextBox @bind-Value="@V.ProvincialCode.Name"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    MaxLength="30" 
                                    Class="@(string.IsNullOrWhiteSpace(V.LocationErrorMsg) ? "" : "k-invalid")" />

                    @if (!string.IsNullOrWhiteSpace(V.LocationErrorMsg))
                    {
                        <div class="txt-red small">@V.LocationErrorMsg</div>
                    }

                </div>

            </div>

         </div>

    </EditForm>
</div>

@code{
    [CascadingParameter]
    public V2060Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }



    private async Task SaveRecord()
    {
        ResetErrorMessage();
        if (!IsFormValid()) return;

        var code = V.ProvincialCode.Code.Trim().ToUpper();
        var name = V.ProvincialCode.Name.Trim().ToUpper();


        var origcode = V.ProvOriginalState?.Code?.Trim().ToUpper();
        var origname = V.ProvOriginalState?.Name?.Trim().ToUpper();


        // Validate if code and name already exist
        var existingRecord = await _prov._02ByCodeOrByName(code, name, V.OPisdb, V.Conn);

        if (existingRecord != null && existingRecord.Any())
        {


            bool codeExists = existingRecord.Any(c => c.Code.Trim().ToUpper() == code && c.Code.Trim().ToUpper() != origcode);
            bool nameExists = existingRecord.Any(n => n.Name.Trim().ToUpper() == name && n.Name.Trim().ToUpper() != origname);

            var exist = false;

            if (codeExists)
            {
                V.CodeErrorMsg = "Code already exists.";
                exist = true;
            }

            if (nameExists)
            {
                V.LocationErrorMsg = "Location already exists.";
                exist = true;
            }
            if (exist) return;


        }


        if (V.ProvOriginalState == null)
        {
            await _01InsertRecord();
        }
        else
        {
            await _03UpdateRecord();
        }
    }

    private async Task _01InsertRecord()
    {
        try
        {
            var res = await _prov._01(V.ProvincialCode, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to save provincial code.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }


            V.ProvincialCodes.Insert(0, res);
            V.ProvincialCode = new OProcodeModel();

            V.Action = "RefreshGrid";
            NotificationRef.Show("Proincial code saved successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationRef.Show("Unable to save provincial code.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }



    private async Task _03UpdateRecord()
    {
        try
        {
            var res = await _prov._03(V.ProvOriginalState.Code, V.ProvincialCode, V.OPisdb, V.Conn);

            if (res == null)
            {
                NotificationRef.Show("Unable to update provincial code.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            V.ProvOriginalState = new OProcodeModel
            {
                Code = res.Code,
                Name = res.Name,
            };


            V.Action = "LoadAreaCodes";
            NotificationRef.Show("Provncial code updated successfully.", ThemeConstants.Notification.ThemeColor.Success);
            await ChildAction.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef.Show("Unable to update provncial code.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }




    private bool IsFormValid()
    {
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(V.ProvincialCode.Code))
        {
            V.CodeErrorMsg = "Code is required";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(V.ProvincialCode.Name))
        {
            V.LocationErrorMsg = "Location is required";
            isValid = false;
        }

        return isValid;
    }


    private void ResetErrorMessage()
    {
        V.CodeErrorMsg = string.Empty;
        V.LocationErrorMsg = string.Empty;
    }
}