@using Telerik.SvgIcons
@using HRMvc.Applications._00GeneralComponents.FormComponents

<TelerikRootComponent>

    @* ============================================================
       NOTIFICATION
       ============================================================ *@

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <CascadingValue Value="@NotificationRef">

        <TelerikCard Height="100%">

            @* ========================================================
               PAGE HEADER
               ======================================================== *@

            <CardHeader>

                <h2 class="k-m-0 k-font-weight-bold k-font-size-md">
                    Employee Status Management
                </h2>

            </CardHeader>




            <CardBody>

                <TelerikCard Class="bg-light-grey  mb-3">
                    <CardBody >
                        

                        <TelerikButtonGroup>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                           Icon="SvgIcon.Search">
                                

                            </TelerikButton>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                                Change Status

                            </TelerikButton>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
                                Save

                            </TelerikButton>
                        </TelerikButtonGroup>

                        
                    </CardBody>
                </TelerikCard>
               
  

                @* ====================================================
                   FORM
                   ==================================================== *@

                <TelerikForm Model="@Empmas"
                             ValidationMessageType="@FormValidationMessageType.Tooltip"
                >

                    <FormValidation>
                        <DataAnnotationsValidator />
                    </FormValidation>


                    <FormItems>

                        @* ==================================================
                           EMPLOYEE INFORMATION
                           ================================================== *@

                        <FormGroup Columns="1"
                                   Class="p-4  cform-group-bdr">


                             @* EMPLOYEE NUMBER *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.EmpNumber)"
                                            Label="Emp. No."
                                            Id="empno"
                                            Class="form-quarter">

                                <TelerikTextBox @bind-Value="@Empmas.EmpNumber"
                                                Id="empno"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.EmpNumber)" />

                            </CFormFieldItem>

                            @* EMPLOYEE NAME *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.Fullname)"
                                            Label="Name"
                                            Id="fullname"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Fullname"
                                                Id="fullname"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Fullname)" />

                            </CFormFieldItem>

                            @* SECURITY LICENSE *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.SecLicense)"
                                            Label="Lic. #"
                                            Id="sec-license"
                                            Class="form-quarter">

                                <TelerikMaskedTextBox @bind-Value="@Empmas.SecLicense"
                                                      Mask="LLL-00000000"
                                                      Id="sec-license"
                                                      Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.SecLicense)" />

                            </CFormFieldItem>

                            @*  LICENSE EXPIRATION*@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.Licexpire)"
                                            Label="Exp. on"
                                            Id="license-expiry"
                                            Class="form-quarter">

                                <TelerikDatePicker @bind-Value="@Empmas.Licexpire"
                                                   Format="MM/dd/yyyy"
                                                   Placeholder="MM / DD / YYYY"
                                                   Id="license-expiry"
                                                   Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Licexpire)" />

                            </CFormFieldItem>

                            @* CLIENT *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.Client)"
                                            Label="Client"
                                            Id="client"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Client"
                                                Placeholder="Enter client name"
                                                Id="client"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Client)" />

                            </CFormFieldItem>

                        </FormGroup>


                        @* ==================================================
                           RESIGNATION DETAILS
                           ================================================== *@

                        <FormGroup  Columns="1"
                                   Class="p-4 cform-group-bdr mt-3">

                            @* DATE RESIGNED *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.DateHired)"
                                            Label="Date Resigned"
                                            Id="date-resigned"
                                            Class="form-quarter">

                                <TelerikDatePicker @bind-Value="@Empmas.DateHired"
                                                   Format="MM/dd/yyyy"
                                                   Placeholder="MM / DD / YYYY"
                                                   Id="date-resigned"
                                                   Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.DateHired)" />

                            </CFormFieldItem>

                            @* REASON *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Reason"
                                            Id="reason"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Reason"
                                                Placeholder="Enter reason"
                                                Id="reason"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFormFieldItem>

                        </FormGroup>


                        @* ==================================================
                           STATUS DETAILS
                           ================================================== *@

                        <FormGroup Columns="1"
                                   Class="p-4 cform-group-bdr mt-3">

                            @* CURRENT STATUS *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.EmpStatus)"
                                            Label="Current Status"
                                            Id="date-resigned"
                                            Class="form-quarter">

                                <TelerikTextBox @bind-Value="@Empmas.EmpStatus"
                                                   Placeholder="Current Status"
                                                   Id="date-resigned"
                                                   Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.EmpStatus)" />

                            </CFormFieldItem>

                            @* NEW STATUS *@
                            <CFormFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Change Status"
                                            Id="reason"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Reason"
                                                Placeholder="New Status"
                                                Id="reason"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFormFieldItem>

                        </FormGroup>


                        @* ==================================================
                           STATUS REMARKS
                           ================================================== *@

                        <FormGroup Columns="1"
                                   Class="p-4 cform-group-bdr mt-3">

                            <CFormFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Remarks"
                                            Id="remarks"
                                            Class="form-half">

                                <TelerikTextArea @bind-Value="@Empmas.Reason"
                                                 Placeholder="Enter status remarks here..."
                                                 Rows="4"
                                                 MaxLength="500"
                                                 Id="remarks"
                                                 Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFormFieldItem>

                        </FormGroup>

                    </FormItems>


                    @* ====================================================
                       FORM ACTIONS
                       ==================================================== *@

                    <FormButtons>

                        <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Icon="@SvgIcon.Save"
                                       class="d-none">

                            Save

                        </TelerikButton> 

                    </FormButtons>

                </TelerikForm>

            </CardBody>

        </TelerikCard>

    </CascadingValue>

</TelerikRootComponent>


@code {

    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private TelerikNotification? NotificationRef { get; set; }

    private OEmpmasModel Empmas { get; set; } = new();


    private async Task SaveAsync()
    {
        // Save Empmas here.

        await Task.CompletedTask;
    }

}


<style>
   
    .cform-group-bdr legend{
        display:none;
    }

    .cform-group-bdr {
        border: 1px solid !important;
        border-color: var(--kendo-color-border) !important;
        border-radius: var(--kendo-border-radius-sm)
    }

    .bg-light-grey {
        background: #f9fafb;
    }

    .cform-group-bdr .k-form-field:first-of-type {
        margin-block-start: 0 !important;
    }

</style>