@using Telerik.SvgIcons
@using HRMvc.Applications._00GeneralComponents.FormComponents

<TelerikRootComponent>

    @* ============================================================
       NOTIFICATION
       ============================================================ *@

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <CascadingValue Value="@NotificationRef">

        <TelerikCard Height="100%">

            @* ========================================================
               PAGE HEADER
               ======================================================== *@

            <CardHeader>

                <h2 class="k-m-0 k-font-weight-bold k-font-size-md">
                    Employee Status Management
                </h2>

            </CardHeader>




            <CardBody>

                <TelerikCard Class="bg-light-grey  mb-3">
                    <CardBody>


                        <TelerikButtonGroup>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                           Icon="SvgIcon.Search">


                            </TelerikButton>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                                Change Status

                            </TelerikButton>
                            <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
                                Save

                            </TelerikButton>
                        </TelerikButtonGroup>


                    </CardBody>
                </TelerikCard>



                @* ====================================================
                   FORM
                   ==================================================== *@

                <TelerikForm Model="@Empmas"
                             ValidationMessageType="@FormValidationMessageType.Tooltip">

                    <FormValidation>
                        <DataAnnotationsValidator />
                    </FormValidation>


                    <FormItems>

                        @* ==================================================
                           EMPLOYEE INFORMATION
                           ================================================== *@

                        <FormGroup Columns="1"
                                   Class="p-4 cform-group-bdr cform-section cform-section-employee"
                                   LabelText="Employee Information">


                            @* EMPLOYEE NUMBER *@
                            <CFieldItem Field="@nameof(OEmpmasModel.EmpNumber)"
                                            Label="Emp. No."
                                            Id="empno"
                                            Class="form-quarter">

                                <TelerikTextBox @bind-Value="@Empmas.EmpNumber"
                                                Id="empno"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.EmpNumber)" />

                            </CFieldItem>

                            @* EMPLOYEE NAME *@
                            <CFieldItem Field="@nameof(OEmpmasModel.Fullname)"
                                            Label="Name"
                                            Id="fullname"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Fullname"
                                                Id="fullname"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Fullname)" />

                            </CFieldItem>

                            @* SECURITY LICENSE *@
                            <CFieldItem Field="@nameof(OEmpmasModel.SecLicense)"
                                            Label="Lic. #"
                                            Id="sec-license"
                                            Class="form-quarter">

                                <TelerikMaskedTextBox @bind-Value="@Empmas.SecLicense"
                                                      Mask="LLL-00000000"
                                                      Id="sec-license"
                                                      Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.SecLicense)" />

                            </CFieldItem>

                            @*  LICENSE EXPIRATION*@
                            <CFieldItem Field="@nameof(OEmpmasModel.Licexpire)"
                                            Label="Exp. on"
                                            Id="license-expiry"
                                            Class="form-quarter">

                                <TelerikDatePicker @bind-Value="@Empmas.Licexpire"
                                                   Format="MM/dd/yyyy"
                                                   Placeholder="MM / DD / YYYY"
                                                   Id="license-expiry"
                                                   Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Licexpire)" />

                            </CFieldItem>

                            @* CLIENT *@
                            <CFieldItem Field="@nameof(OEmpmasModel.Client)"
                                            Label="Client"
                                            Id="client"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Client"
                                                Placeholder="Enter client name"
                                                Id="client"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Client)" />

                            </CFieldItem>

                        </FormGroup>


                        @* ==================================================
                           RESIGNATION DETAILS
                           ================================================== *@

                        <FormGroup Columns="1"
                                   LabelText="Resignation Details"
                                   Class="p-4 cform-group-bdr cform-section cform-section-resignation mt-3">

                            @* DATE RESIGNED *@
                            <CFieldItem Field="@nameof(OEmpmasModel.DateHired)"
                                            Label="Date Resigned"
                                            Id="date-resigned"
                                            Class="form-quarter">

                                <TelerikDatePicker @bind-Value="@Empmas.DateHired"
                                                   Format="MM/dd/yyyy"
                                                   Placeholder="MM / DD / YYYY"
                                                   Id="date-resigned"
                                                   Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.DateHired)" />

                            </CFieldItem>

                            @* REASON *@
                            <CFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Reason"
                                            Id="reason"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Reason"
                                                Placeholder="Enter reason"
                                                Id="reason"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFieldItem>

                        </FormGroup>


                        @* ==================================================
                           STATUS DETAILS
                           ================================================== *@

                        <FormGroup Columns="1"
                                   LabelText="Status Change"
                                   Class="p-4 cform-group-bdr cform-section cform-section-status mt-3">

                            @* CURRENT STATUS *@
                            <CFieldItem Field="@nameof(OEmpmasModel.EmpStatus)"
                                            Label="Current Status"
                                            Id="date-resigned"
                                            Class="form-quarter">

                                <TelerikTextBox @bind-Value="@Empmas.EmpStatus"
                                                Placeholder="Current Status"
                                                Id="date-resigned"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.EmpStatus)" />

                            </CFieldItem>

                            @* NEW STATUS *@
                            <CFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Change Status"
                                            Id="reason"
                                            Class="form-half">

                                <TelerikTextBox @bind-Value="@Empmas.Reason"
                                                Placeholder="New Status"
                                                Id="reason"
                                                Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFieldItem>

                        </FormGroup>


                        @* ==================================================
                           STATUS REMARKS
                           ================================================== *@

                        <FormGroup Columns="1"
                                   LabelText="Remarks"
                                   Class="p-4 cform-group-bdr cform-section cform-section-remarks mt-3">

                            <CFieldItem Field="@nameof(OEmpmasModel.Reason)"
                                            Label="Remarks"
                                            Id="remarks"
                                            Class="form-half">

                                <TelerikTextArea @bind-Value="@Empmas.Reason"
                                                 Placeholder="Enter status remarks here..."
                                                 Rows="4"
                                                 MaxLength="500"
                                                 Id="remarks"
                                                 Width="100%" />

                                <TelerikValidationMessage For="@(() => Empmas.Reason)" />

                            </CFieldItem>

                        </FormGroup>

                    </FormItems>


                    @* ====================================================
                       FORM ACTIONS
                       ==================================================== *@

                    <FormButtons>

                        <TelerikButton ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Icon="@SvgIcon.Save"
                                       class="d-none">

                            Save

                        </TelerikButton>

                    </FormButtons>

                </TelerikForm>

            </CardBody>

        </TelerikCard>

    </CascadingValue>

</TelerikRootComponent>


@code {

    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private TelerikNotification? NotificationRef { get; set; }

    private OEmpmasModel Empmas { get; set; } = new();


    private async Task SaveAsync()
    {
        // Save Empmas here.

        await Task.CompletedTask;
    }

}


<style>

    .cform-group-bdr {
        border: 1px solid !important;
        border-color: var(--kendo-color-border) !important;
        border-radius: var(--kendo-border-radius-sm)
    }

    .bg-light-grey {
        background: #f9fafb;
    }

    .cform-group-bdr .k-form-field:first-of-type {
        margin-block-start: 0 !important;
    }


    /* ==========================================================
           SECTION HEADINGS
           FormGroup's native "Title" renders as the fieldset legend.
           We restyle that legend (instead of hiding it) and prepend
           an icon using a masked inline SVG, so no external icon
           font dependency is needed.
           ========================================================== */

    .cform-section legend {
        display: flex !important;
        align-items: center;
        gap: 8px;
        width: 100%;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1c2430;
        padding: 0 0 12px;
        margin: 0 0 16px;
        border-bottom: 1px solid var(--kendo-color-border);
    }

        .cform-section legend::before {
            content: "";
            display: inline-block;
            width: 17px;
            height: 17px;
            flex: 0 0 auto;
            background-color: #2f5d8a;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-position: center;
            mask-position: center;
            -webkit-mask-size: contain;
            mask-size: contain;
        }

    /* Employee Information — user icon */
    .cform-section-employee legend::before {
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>");
        mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>");
    }

    /* Resignation Details — log-out icon */
    .cform-section-resignation legend::before {
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'/><polyline points='16 17 21 12 16 7'/><line x1='21' y1='12' x2='9' y2='12'/></svg>");
        mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'/><polyline points='16 17 21 12 16 7'/><line x1='21' y1='12' x2='9' y2='12'/></svg>");
    }

    /* Status Change — refresh icon */
    .cform-section-status legend::before {
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 4 23 10 17 10'/><polyline points='1 20 1 14 7 14'/><path d='M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15'/></svg>");
        mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 4 23 10 17 10'/><polyline points='1 20 1 14 7 14'/><path d='M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15'/></svg>");
    }

    /* Remarks — note/file-text icon */
    .cform-section-remarks legend::before {
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/></svg>");
        mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/></svg>");
    }

</style>
