@using HRMvc.Applications._00GeneralComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2057
@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOPenaltyDataAccess _penalty;
@inject IOPisReportDataAccess _pisRep;

<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <CascadingValue Value="@v">
        <CascadingValue Value="@rv">
            <CascadingValue Value="@NotificationRef">

                <_00BT_FullW HdrCaption="Penalty Type Entry">

                    <Details>


                        @*--- REPORT ---*@
                        <_02BTRep Rv="rv" ChildAction="ChildAction" />


                        @*--- ENTRY ---*@
                        @if (v.ShowEntryModal == true)
                        {
                            <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowEntryModal = false" ModalWidth="70vh">
                                <Content>
                                    <_2057_PenaltyTypeEntryModal ChildAction="ChildAction" />
                                </Content>
                            </_00Modal>
                        }



                        @*---  GRID ---*@
                        <_2057_PenaltyTypeList ChildAction="ChildAction" @ref="PenaltyTypeGridRef" />
                    </Details>

                </_00BT_FullW>

            </CascadingValue>
        </CascadingValue>
    </CascadingValue>

</TelerikRootComponent>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2057Model v = new();

    V00_RepVars rv = new();

    private TelerikNotification NotificationRef;

    private _2057_PenaltyTypeList PenaltyTypeGridRef;


    protected override async Task OnInitializedAsync()
    {
        v.IsLoading = true;

        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
        v.UcLoaded = true;

        v.OPisdb = Uc.OpisDb;
        v.Conn = Uc.Conn;

        await _02LoadPenaltyTypes();

        // Report ---------
        InitializeReport();
        await _02LoadCompanyInfo();
        v.IsLoading = false;

    }




    private async Task _02LoadPenaltyTypes()
    {
        try
        {
            var res = await _penalty._02(v.OPisdb, v.Conn);
            if (res != null && res.Any())
            {
                v.Penalties = res!;

            }
        }
        catch (Exception ex)
        {
            NotificationRef?.Show("Unable to load penalty type records.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }


    private void InitializeReport()
    {
        rv.MCaption = "Penalty Type Listing";
        rv.RefreshToken = 20570000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }



    public async Task ChildAction()
    {
        if (v.Action == "RefreshGrid") if (PenaltyTypeGridRef != null) PenaltyTypeGridRef.RebindGrid();
        if (v.Action == "LoadPenaltyTypes") await _02LoadPenaltyTypes();

        v.Action = string.Empty;
    }
}