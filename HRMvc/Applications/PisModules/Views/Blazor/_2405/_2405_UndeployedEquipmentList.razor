<div class="p-0">

    <div class="p-2">
        <div class="card p-0">
            <div class="card-header txt-fcolor">
                UNDEPLOYED EQUIPMENT
            </div>
            <TelerikGrid TItem="OClientModel"
                         SelectionMode="@GridSelectionMode.Single"
                         Navigable="true"
                         Pageable="true"
                         @bind-PageSize="@PageSize"
                         Sortable="true"
                         FilterMode="@GridFilterMode.FilterMenu"
                         Height="calc(100vh - 70vh)">

                <GridSettings>
                    <div class="d-flex p-2 gap-2">
                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                                type="button" tabindex="6">
                            Undeploy Selected Equipment
                        </button>

                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                                type="button" tabindex="6">
                            Delete
                        </button>
                    </div>

                </GridSettings>

                <GridColumns>
                    <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                Title="Model"
                                Width="80px" />

                    <GridColumn Field="@nameof(OClientModel.Status)"
                                Title="Make"
                                Width="80px"
                                HeaderClass="text-center" />

                    <GridColumn Field="@nameof(OClientModel.Status)"
                                Title="Caliber"
                                Width="80px"
                                HeaderClass="text-center" />

                    <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                Title="Description"
                                Width="200px" />

                    <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                Title="Qty."
                                Width="80px" />

                    <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                Title="Status"
                                Width="80px" />

                    <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                Title="Deployment"
                                Width="80px" />
                </GridColumns>

                <NoDataTemplate>
                    <div class="text-center text-secondary p-4">
                        No records found.
                    </div>
                </NoDataTemplate>

            </TelerikGrid>
        </div>
    </div>






</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2404Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        V.ModalCaption = "Inventory Entry";
        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

}

