@using HRMvc.Applications._00GeneralComponents
@using HRMvc.Applications.PisModules.Views.Blazor._2061
@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOMlacodeDataAccess _mla
@inject IOPisReportDataAccess _pisRep;


<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <CascadingValue Value="@v">
        <CascadingValue Value="@rv">
            <CascadingValue Value="@NotificationRef">

                <_00BT_FullW HdrCaption="Metro Manila Code Entry">

                    <Details>


                        @*--- REPORT ---*@
                        <_02BTRep Rv="rv" ChildAction="ChildAction" />


                        @*--- ENTRY ---*@
                        @if (v.ShowEntryModal == true)
                        {
                            <_00Modal ModuleCaption="@v.ModalCaption" ChildAction="() => v.ShowEntryModal = false" ModalWidth="70vh">
                                <Content>
                                    <_2061_MlaCodeEntryModal ChildAction="ChildAction" />
                                </Content>
                            </_00Modal>
                        }


                        @*---  GRID ---*@
                        <_2061_MlaCodeList ChildAction="ChildAction" @ref="MlaGridRef" />
                    </Details>

                </_00BT_FullW>

            </CascadingValue>
        </CascadingValue>
    </CascadingValue>

</TelerikRootComponent>


@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2061Model v = new();

    V00_RepVars rv = new();

    private TelerikNotification NotificationRef;

    private _2061_MlaCodeList MlaGridRef;


    protected override async Task OnInitializedAsync()
    {
        v.IsLoading = true;

        if (Uc?.Conn == null || Uc.OpisDb == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
        v.UcLoaded = true;

        v.OPisdb = Uc.OpisDb;
        v.Conn = Uc.Conn;

        await _02LoadMetroManilaCodes();

        // Report ---------
        InitializeReport();
        await _02LoadCompanyInfo();
        v.IsLoading = false;

    }




    private async Task _02LoadMetroManilaCodes()
    {
        try
        {
            var res = await _mla._02(Uc.OpisDb, Uc.Conn);
            if (res != null && res.Any())
            {
                v.MlaCodes = res!;

            }
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable to load metro manila code.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }
    }


    private void InitializeReport()
    {
        rv.MCaption = "Metro Manila Code Listing";
        rv.RefreshToken = 20610000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }



    public async Task ChildAction()
    {
        if (v.Action == "RefreshMlaGrid") if (MlaGridRef != null) MlaGridRef.RebindGrid();
        if (v.Action == "LoadMla") await _02LoadMetroManilaCodes();

        v.Action = string.Empty;
    }
}
