@using HRApiLibrary.Models._10_Pis.OPis
@using HRApiLibrary.DataAccess._10_Pis.OPis

@inject IOAreaDataAccess _ac
@inject IOPisReportDataAccess _pisRep;


<TelerikGrid TItem="OAreaModel"
             Data="V.Areas"
             @ref="AreaGridRef"
             SelectionMode="@GridSelectionMode.Single"
             Navigable="true"
             Pageable="true"
             @bind-PageSize="@PageSize"
             Sortable="true"
             FilterMode="@GridFilterMode.FilterMenu"
             Height="calc(100vh - 90px)">

    <GridSettings>
        <GridPagerSettings PageSizes="@PageSizes" />
    </GridSettings>

    @* --- CREATE USER BUTTON --- *@
    <GridToolBarTemplate>

        <div class="d-flex justify-content-between align-items-center w-100">
            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                    @onclick="@(() => OpenEntryModal(new OAreaModel()))">
                Add Area Code
            </button>


            <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                    @onclick="@(() => GenerateReport())">
                Print Listing
            </button>
        </div>

    </GridToolBarTemplate>


    <GridColumns>

        @* --- Code --- *@
        <GridColumn Field="@nameof(OAreaModel.AreaCode)"
                    Title="Code"
                    Width="80px" />

        @* --- Name --- *@
        <GridColumn Field="@nameof(OAreaModel.AreaName)"
                    Title="Location"
                    Width="300px" />



        @* --- ACTIONS --- *@
        <GridCommandColumn Title="Action"
                           Width="80px"
                           HeaderClass="text-center">

            <Template Context="item">

                @{
                    var rec = (OAreaModel)item;
                }

                <div class="d-flex justify-content-center gap-2">

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => OpenEntryModal(rec))">
                        Edit
                    </button>

                    <button type="button"
                            class="card p-2 text-center h-35p mb-btn mb-btn-gray"
                            @onclick="(() => _04Delete(rec))">
                        Delete
                    </button>

                </div>

            </Template>

        </GridCommandColumn>

    </GridColumns>

    <NoDataTemplate>
        <div class="text-center text-secondary p-4">
            No area code records found.
        </div>
    </NoDataTemplate>

</TelerikGrid>

@code {
    [CascadingParameter]
    public V2059Model V { get; set; } = new();


    [CascadingParameter]
    V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; }

    [CascadingParameter]
    public DialogFactory? DialogsRef { get; set; }


    private TelerikGrid<OAreaModel> AreaGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task OpenEntryModal(OAreaModel rec)
    {
        V.CodeErrorMsg = string.Empty;
        V.LocationErrorMsg = string.Empty;


        V.Area = new OAreaModel();
        V.AreaOriginalState = null;


        V.ModalCaption = "Add Area Code";

        if (!string.IsNullOrWhiteSpace(rec.AreaCode))
        {
            V.ModalCaption = "Edit Area Code";
            V.Area = MapRecord(rec);
            V.AreaOriginalState = MapRecord(rec);
        }

        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

    private async Task _04Delete(OAreaModel rec)
    {
        var confirmed = await DialogsRef?.ConfirmAsync($"Are you sure you want to delete '{rec.AreaName}' record?", "Confirm Area Code Deletion");
        if (!confirmed) return;


        try
        {

            //Add Validation --------------------------------

            var res = await _ac._04(rec.AreaCode, V.OPisdb, V.Conn);

            if (res == null)
            {
                V.Areas.Remove(rec);
                RebindGrid();
                NotificationRef?.Show("Area code deleted successfully.", ThemeConstants.Notification.ThemeColor.Success);

            }
            else
            {
                NotificationRef?.Show("Unable to delete area code.", ThemeConstants.Notification.ThemeColor.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to delete area code.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }






    private OAreaModel MapRecord(OAreaModel rec)
    {
        return new OAreaModel
        {
            AreaCode = rec.AreaCode,
            AreaName = rec.AreaName,
        };
    }

    private async Task GenerateReport()
    {
        if (!V.Areas.Any()) { return; }


        V.RepDtls = V.Areas!;

        Rv.RelativePath = "";
        Rv.ReportData = [];
        Rv.ReportData = V.RepDtls;

        Rv.ReportParams["ReportTitle"] = "Area Code Listing";
        Rv.RelativePath = "Reports/_01Pis/J_2059_AC.trdp";
        Rv.SelectedFormat = "PDF";

        Rv.ShowModal = true;

        await ChildAction.InvokeAsync();
    }

    public void RebindGrid()
    {
        AreaGridRef.Rebind();
    }

}


