@page "/1100/11010"
@layout HRMvc.Components.Layout.AMSLayout
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using HRApiLibrary.Models._00_Main
@using HRMvc.Applications.AMS.Blazor
@using HRMvc.Applications.PayrollTransaction.Vars

<div>
    @if (uc != null)
    {
        <_11010HolidaySettings @rendermode="InteractiveServer" Uc="uc" />
    }
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    UserClaimsModel? uc;

    protected override void OnInitialized()
    {
        if (HttpContext != null) uc = PayClaimsHelper.UserToClaims(HttpContext.User);
    }
}
