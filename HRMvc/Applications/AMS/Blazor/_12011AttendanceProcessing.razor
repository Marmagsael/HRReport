    private async Task OnPushConfirm()
    {
        _pushConfirmOpen = false;
        if (Uc is null) return;
        _busy = true;
        try
        {
            var byEmp = new Dictionary<string, Dictionary<string, double>>();
            var rateIds = await _pushDa._02RateIds(_selectedEmps.Select(x => x.EmpNumber).ToList(), Uc.OpisDb!, Uc.Conn!);
            foreach (var e in _selectedEmps)
            {
                bool monthly = rateIds.TryGetValue(e.EmpNumber.Trim(), out var rid) && rid is 1 or 3;
                byEmp[e.EmpNumber.Trim()] = BuildManhour(_dailyByEmp.TryGetValue(e.SystemId, out var r) ? r : [], monthly);
            }

            var (updated, skipped) = await _pushDa._03Push(_pushTrn, byEmp, Uc.OpayDb!, Uc.Conn!);
            Notify($"{updated} employee(s) pushed to {_pushTrn}." + (skipped.Count > 0 ? $" Not in the transaction: {string.Join(", ", skipped)}." : string.Empty),
                   skipped.Count > 0 ? "warning" : "success");
        }
        catch (Exception ex) { Notify($"Push failed: {ex.Message}", "error"); }
        _busy = false;
    }

    private static Dictionary<string, double> BuildManhour(List<AttDailyRow> rows, bool monthly)
    {
        var m = new Dictionary<string, double>();
        void Add(string col, double v) { if (v != 0 && col != "") m[col] = (m.TryGetValue(col, out var c) ? c : 0) + v; }

        foreach (var x in rows)
        {
            bool onHoliday = x.Holiday is "LH" or "SH" or "DH";
            Add("absent", (monthly ? x.AbsentHrs : 0) + (onHoliday ? 0 : x.Tardiness / 60.0 + x.Undertime / 60.0));

            if (x.Kind is "OB" or "LV") { Add("daywrk", x.Credit); continue; }
            if (x.Kind == "AB") continue;

            Add("daywrk", x.Credit);

            foreach (var g in x.Segs)
            {
                // [hours column, OT column, ND column, ND OT column] of the day type of this part of the duty
                string[] c = (g.Holiday, g.IsRd) switch
                {
                    ("LH", false) => ["lh", "lhot", "ndlh", "ndlhot"],
                    ("LH", true)  => ["rdlh", "rdlhot", "ndrdlh", "ndrdlhot"],
                    ("SH", false) => ["sh", "shot", "ndsh", "ndshot"],
                    ("SH", true)  => ["rdsh", "rdshot", "ndrdsh", "ndrdshot"],
                    ("DH", false) => ["dh", "dhot", "nddh", "nddhot"],
                    ("DH", true)  => ["rddh", "rddhot", "ndrddh", "ndrddhot"],
                    (_, true)     => ["rd", "rdot", "ndrd", "ndrdot"],
                    _             => ["", "rot", "nd", "ndot"]
                };
                Add(c[0], g.Hours);
                Add(c[1], g.OtHrs);
                Add(c[2], g.Nd);
                Add(c[3], g.NdOt);
            }
        }
        return m;
    }

