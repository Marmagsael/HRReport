@using HRMvc.StartupConfig.Library
﻿@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Modules._11003O
@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._11_AMS
@using HRApiLibrary.DataAccess._20_Pay
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay
@using HRApiLibrary.Models._20_Pay.OPay
@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using Telerik.Blazor.Components
@using ClosedXML.Excel
@using HRMvc.Applications.PayrollReport.Class
@using Microsoft.JSInterop
@using Telerik.SvgIcons

<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="NotificationHorizontalPosition.Center"
                         VerticalPosition="NotificationVerticalPosition.Top" />

    <TelerikDialog @bind-Visible="@_pushConfirmOpen" Title="Push to Payroll Entry" Width="460px">
        <DialogContent>
            <p>Push the manhours of <b>@_pushCount</b> selected employee(s) to payroll transaction <b>@_pushTrn</b> (@_start.ToString("MM/dd/yyyy") - @_end.ToString("MM/dd/yyyy"))?</p>
            <p class="mb-0">The attendance manhour columns of those employees in the transaction will be replaced.</p>
        </DialogContent>
        <DialogButtons>
            <TelerikButton OnClick="OnPushConfirm" ThemeColor="primary">Yes, Push</TelerikButton>
            <TelerikButton OnClick="@(() => _pushConfirmOpen = false)">Cancel</TelerikButton>
        </DialogButtons>
    </TelerikDialog>

    <style>
        .att-page { --att-ink:#1f2a37; --att-mute:#6b7785; --att-line:#e3e8ef; --att-soft:#f6f8fb; --att-accent:#3b5bdb; }
        .att-filter { display:flex; gap:14px; align-items:flex-end; flex-wrap:wrap; padding:12px 14px; background:var(--att-soft); border:1px solid var(--att-line); border-radius:10px; }
        .att-lbl { font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--att-mute); margin-bottom:3px; }
        .att-strip { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:12px 0 4px; }
        .att-chip { display:inline-flex; align-items:baseline; gap:6px; padding:4px 12px; border-radius:999px; background:#fff; border:1px solid var(--att-line); font-size:12.5px; line-height:1.3; color:var(--att-ink); }
        .att-chip b { font-size:10.5px; line-height:1.3; letter-spacing:.05em; text-transform:uppercase; color:#0b6e99; font-weight:700; }
        .att-chip.code { background:#eef2ff; border-color:#c7d2fe; color:#2f3fa8; font-weight:700; }
        .att-chip.ok { background:#e8f7ee; border-color:#bde5cb; color:#1b6b3a; }
        .att-chip.bad { background:#fdecec; border-color:#f4c3c3; color:#a12727; }
        .att-chip.lock { background:#f6e9ec; border-color:#e5c2ca; color:#7a1f35; }
        .att-card { border:1px solid var(--att-line); border-radius:10px; overflow:hidden; background:#fff; }
        .att-card .k-grid { border:0; }
        .att-card .k-grid-header th { background:var(--att-soft); font-weight:700; color:var(--att-ink); }
        .att-card .k-grid-toolbar { background:#fff; border-bottom:1px solid var(--att-line); font-size:14px; }
        .att-emp-grid .k-grid-content tr, .att-emp-grid .k-grid-content td { cursor:pointer; }
        .att-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin:16px 0 8px; padding-top:12px; border-top:1px dashed var(--att-line); }
        .att-kpis { margin-left:auto; display:flex; gap:10px; flex-wrap:wrap; }
        .att-kpi { min-width:96px; padding:6px 14px; border:1px solid var(--att-line); border-radius:10px; background:#fff; text-align:right; }
        .att-kpi small { display:block; font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--att-mute); font-weight:700; }
        .att-kpi span { font-size:18px; font-weight:700; color:var(--att-accent); line-height:1.2; }
        .att-legend { display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:11.5px; padding:8px 4px 0; }
        .att-legend .lg { display:inline-flex; align-items:center; gap:5px; padding:2px 10px 2px 4px; border:1px solid var(--att-line); border-radius:999px; background:#fff; }
        .att-legend span.sw { display:inline-block; width:14px; height:14px; border:1px solid #b7c0cc; border-radius:50%; }
        .att-r-RD  td, .att-sw-RD  { background:#dee2e6 !important; color:#212529; }
        .att-r-RN  td, .att-sw-RN  { background:#cfd4f7 !important; color:#212529; }
        .att-r-OB  td, .att-sw-OB  { background:#c9ecf5 !important; color:#212529; }
        .att-r-LV  td, .att-sw-LV  { background:#f8d0e0 !important; color:#212529; }
        .att-r-LH  td, .att-sw-LH  { background:#c8f0d2 !important; color:#212529; }
        .att-r-SH  td, .att-sw-SH  { background:#fff3b0 !important; color:#212529; }
        .att-r-AB  td, .att-sw-AB  { background:#f5b7b1 !important; color:#212529; }
        .att-r-DH  td, .att-sw-DH  { background:#ffd3a8 !important; color:#212529; }
        .att-sum th.att-h-R { background:#EDF2F9 !important; color:#2b3a4a; }
        .att-sum thead tr:first-child th.att-h-R { border-bottom:3px solid #6C8EBF; font-weight:700; letter-spacing:.3px; text-align:center; }
        .att-sum thead tr:nth-child(2) th.att-h-R { background:#F5F8FC !important; color:#4a5a6a; font-weight:600; }
        .att-sum td:nth-child(n+3):nth-child(-n+7) { background:#FAFBFE; }
        .att-sum th.att-h-LH { background:#EBF4EE !important; color:#2b3a4a; }
        .att-sum thead tr:first-child th.att-h-LH { border-bottom:3px solid #6AA584; font-weight:700; letter-spacing:.3px; text-align:center; }
        .att-sum thead tr:nth-child(2) th.att-h-LH { background:#F4F9F6 !important; color:#4a5a6a; font-weight:600; }
        .att-sum td:nth-child(n+8):nth-child(-n+12) { background:#F9FCFA; }
        .att-sum th.att-h-SH { background:#F8F5E8 !important; color:#2b3a4a; }
        .att-sum thead tr:first-child th.att-h-SH { border-bottom:3px solid #C2A85A; font-weight:700; letter-spacing:.3px; text-align:center; }
        .att-sum thead tr:nth-child(2) th.att-h-SH { background:#FCFAF3 !important; color:#4a5a6a; font-weight:600; }
        .att-sum td:nth-child(n+13):nth-child(-n+17) { background:#FEFDFA; }
        .att-sum th.att-h-DH { background:#F8EEE6 !important; color:#2b3a4a; }
        .att-sum thead tr:first-child th.att-h-DH { border-bottom:3px solid #C98A5E; font-weight:700; letter-spacing:.3px; text-align:center; }
        .att-sum thead tr:nth-child(2) th.att-h-DH { background:#FCF6F1 !important; color:#4a5a6a; font-weight:600; }
        .att-sum td:nth-child(n+18):nth-child(-n+22) { background:#FEFBF8; }
    </style>

    <div class="card w-100 p-1 att-page">
        <BodyHdr pageTitle="Attendance Processing" />
        <div class="card-body p-1 w-100">

            <div class="att-filter mt-1">
                <div>
                    <div class="att-lbl">PAYROLL GROUP</div>
                    <TelerikDropDownList Data="@_payrollGrps"
                                         Value="@_payrollGrpId"
                                         ValueChanged="@((int? val) => OnPayrollGrpChanged(val))"
                                         TextField="Name" ValueField="Id" Width="300px" DefaultText="Select payroll group">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="300px" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div>
                    <div class="att-lbl">YEAR</div>
                    <TelerikDropDownList Data="@_years" Value="@_year" ValueChanged="@((string v) => OnPeriodChanged(() => _year = v))" Width="90px" />
                </div>
                <div>
                    <div class="att-lbl">MONTH</div>
                    <TelerikDropDownList Data="@_months" Value="@_month" ValueChanged="@((string v) => OnPeriodChanged(() => _month = v))" Width="75px" />
                </div>
                <div>
                    <div class="att-lbl">PERIOD</div>
                    <TelerikDropDownList Data="@_periods" TextField="@nameof(OPayPeriod.PdNumber)" ValueField="@nameof(OPayPeriod.PdNumber)"
                                         Value="@_period" ValueChanged="@((string v) => OnPeriodChanged(() => _period = v))" Width="75px" />
                </div>
                <div>
                    <div class="att-lbl">ATTENDANCE START</div>
                    <TelerikDatePicker Value="@_start" ValueChanged="@((DateTime v) => { _start = v; ResetResults(); })" Format="MMM dd, yyyy" Width="150px" />
                </div>
                <div>
                    <div class="att-lbl">ATTENDANCE END</div>
                    <TelerikDatePicker Value="@_end" ValueChanged="@((DateTime v) => { _end = v; ResetResults(); })" Format="MMM dd, yyyy" Width="150px" />
                </div>
                <TelerikButton OnClick="OnLoad" ThemeColor="primary" Icon="@SvgIcon.ArrowRotateCw" Enabled="@(!_busy && _payrollGrpId is not null)">@(_busy ? "Loading..." : "Load")</TelerikButton>
                <TelerikButton OnClick="ExportExcel" FillMode="outline" Icon="@SvgIcon.FileExcel" Enabled="@(SummaryView.Count > 0)">Excel</TelerikButton>
                <TelerikButton OnClick="ExportPdf" FillMode="outline" Icon="@SvgIcon.FilePdf" Enabled="@(SummaryView.Count > 0)">PDF</TelerikButton>
            </div>

            <div class="att-strip">
                <span class="att-chip code"><b>TRN</b>@(string.IsNullOrEmpty(PayrollCode) ? "-" : PayrollCode)</span>
                <span class="att-chip"><b>Group</b>@(_payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId) is { } g ? $"{g.Code} - {g.Name}" : "-")</span>
                <span class="att-chip"><b>Att. Coverage</b>@_start.ToString("MMM dd") - @_end.ToString("MMM dd, yyyy")</span>
                @if (!string.IsNullOrEmpty(PayrollCode))
                {
                    <span class="att-chip @(_trnStatus is null ? "bad" : _trnStatus == "Lock" ? "lock" : "ok")"><b>Payroll Status</b>@(_trnStatus ?? "No open transaction")</span>
                }
            </div>

            <div class="d-flex gap-3 mt-2">

                <div class="att-card" style="width:360px; flex:none;">
                    <TelerikGrid Data="@_emps"
                                 Class="att-emp-grid"
                                 Height="320px"
                                 Size="sm"
                                 SelectionMode="GridSelectionMode.Multiple"
                                 @bind-SelectedItems="@_selectedEmps"
                                 OnRowClick="@OnEmpRowClick">
                        <GridToolBarTemplate>
                            <span class="fw-bold">Employee List</span><span class="ms-auto small text-muted">@_selectedEmps.Count() of @_emps.Count selected</span>
                        </GridToolBarTemplate>
                        <GridColumns>
                            <GridCheckboxColumn Width="40px" SelectAll="true" />
                            <GridColumn Field="@nameof(AttEmpRow.EmpNumber)" Title="Emp. No." Width="80px" />
                            <GridColumn Field="@nameof(AttEmpRow.EmpName)"   Title="Name" />
                        </GridColumns>
                    </TelerikGrid>
                </div>

                <div class="flex-grow-1" style="min-width:0;">
                    <div class="att-card">
                    <TelerikGrid Data="@_daily"
                                 OnRowRender="@OnDailyRowRender"
                                 Height="320px"
                                 Size="sm"
                                 Pageable="false">
                        <GridToolBarTemplate>
                            <span class="fw-bold">@(_current is null ? "<<Employee Name>>" : _current.EmpName)</span>
                        </GridToolBarTemplate>
                        <GridColumns>
                            <GridColumn Field="@nameof(AttDailyRow.Date)"      Title="Date"       DisplayFormat="{0:MM/dd/yyyy}" Width="100px"><FooterTemplate><b>Total</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.Day)"       Title="Day"        Width="60px" />
                            <GridColumn Field="@nameof(AttDailyRow.DayType)"   Title="Day Type"   Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.Holiday)"   Title="Holiday"    Width="70px" />
                            <GridColumn Field="@nameof(AttDailyRow.Remarks)"   Title="Remarks"    Width="110px" />
                            <GridColumn Field="@nameof(AttDailyRow.TimeIn)"    Title="Time In"    Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.TimeOut)"   Title="Time Out"   Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.LateHrs)"   Title="Late"           TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttDailyRow)context).LateHrs, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.LateHrs), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.UnderHrs)"  Title="Under Time"     TextAlign="ColumnTextAlign.Right" Width="85px"><Template>@Z(((AttDailyRow)context).UnderHrs, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.UnderHrs), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.AbsDays)"   Title="Absent (Days)"  TextAlign="ColumnTextAlign.Right" Width="100px"><Template>@Z(((AttDailyRow)context).AbsDays, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.AbsDays), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.TotTardHrs)" Title="Tot Tardiness" TextAlign="ColumnTextAlign.Right" Width="100px"><Template>@Z(((AttDailyRow)context).TotTardHrs, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.TotTardHrs), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.Overtime)"  Title="Overtime"   TextAlign="ColumnTextAlign.Right" Width="90px"><Template>@Z(((AttDailyRow)context).Overtime, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.Overtime), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.ND)"        Title="ND"         TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttDailyRow)context).ND, "#,##0.00")</Template><FooterTemplate><b>@Z(_daily.Sum(x => x.ND), "#,##0.00")</b></FooterTemplate></GridColumn>
                            <GridColumn Field="@nameof(AttDailyRow.DutyStart)" Title="Duty Start" Width="90px" />
                            <GridColumn Field="@nameof(AttDailyRow.DutyEnd)"   Title="Duty End"   Width="90px" />
                        </GridColumns>
                    </TelerikGrid>
                    </div>
                    <div class="att-legend">
                        <b>Legend</b>
                        <span class="lg"><span class="sw" style="background:#fff"></span>R - Regular Day</span>
                        <span class="lg"><span class="sw att-sw-RD"></span>RD - Rest Day</span>
                        <span class="lg"><span class="sw att-sw-RN"></span>RN - Regular Working Day</span>
                        <span class="lg"><span class="sw att-sw-OB"></span>OB - Official Business (paid)</span>
                        <span class="lg"><span class="sw att-sw-LV"></span>LV - Paid Leave</span>
                        <span class="lg"><span class="sw att-sw-AB"></span>AB - Absent</span>
                        <span class="lg"><span class="sw att-sw-LH"></span>LH - Legal Holiday</span>
                        <span class="lg"><span class="sw att-sw-SH"></span>SH - Special Holiday</span>
                        <span class="lg"><span class="sw att-sw-DH"></span>DH - Double Holiday</span>
                    </div>
                </div>
            </div>

            <div class="att-actions">
                <TelerikButton OnClick="OnPushClick" ThemeColor="primary" Icon="@SvgIcon.Upload" Enabled="@(!_busy && _dailyByEmp.Count > 0)">Push to Payroll Entry</TelerikButton>
                <div class="att-kpis">
                    <div class="att-kpi"><small>Employees</small><span>@SummaryView.Count</span></div>
                    <div class="att-kpi"><small>Tardiness (hrs)</small><span>@(SummaryView.Sum(r => r.RegTard + r.LegTard + r.SpTard + r.DbTard).ToString("#,##0.00"))</span></div>
                    <div class="att-kpi"><small>OT (hrs)</small><span>@(SummaryView.Sum(r => r.RegOT + r.LegOT + r.SpOT + r.DbOT).ToString("#,##0.00"))</span></div>
                    <div class="att-kpi"><small>ND (hrs)</small><span>@(SummaryView.Sum(r => r.RegND + r.LegND + r.SpND + r.DbND).ToString("#,##0.00"))</span></div>
                </div>
            </div>

            <div class="att-card">
                <TelerikGrid Data="@SummaryView" Class="att-sum"
                             Height="320px"
                             Size="sm"
                             Pageable="false">
                    <GridColumns>
                        <GridColumn Field="@nameof(AttSummaryRow.EmpNumber)" Title="Emp#" Width="80px" />
                        <GridColumn Field="@nameof(AttSummaryRow.EmpName)"   Title="Name" Width="200px" />
                        <GridColumn Title="Regular Day" HeaderClass="att-h-R">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.RegDays)"  Title="Days" HeaderClass="att-h-R"      TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).RegDays, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.RegRD)"    Title="RD" HeaderClass="att-h-R"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).RegRD, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.RegTard)"  Title="Tardiness" HeaderClass="att-h-R" TextAlign="ColumnTextAlign.Right" Width="90px"><Template>@Z(((AttSummaryRow)context).RegTard, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.RegOT)"    Title="OT" HeaderClass="att-h-R"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).RegOT, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.RegND)"    Title="ND" HeaderClass="att-h-R"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).RegND, "#,##0.00")</Template></GridColumn>
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Legal Holiday" HeaderClass="att-h-LH">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.LegDays)"  Title="Days" HeaderClass="att-h-LH"      TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).LegDays, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.LegRD)"    Title="RD" HeaderClass="att-h-LH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).LegRD, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.LegTard)"  Title="Tardiness" HeaderClass="att-h-LH" TextAlign="ColumnTextAlign.Right" Width="90px"><Template>@Z(((AttSummaryRow)context).LegTard, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.LegOT)"    Title="OT" HeaderClass="att-h-LH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).LegOT, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.LegND)"    Title="ND" HeaderClass="att-h-LH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).LegND, "#,##0.00")</Template></GridColumn>
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Special Holiday" HeaderClass="att-h-SH">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.SpDays)"   Title="Days" HeaderClass="att-h-SH"      TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).SpDays, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.SpRD)"     Title="RD" HeaderClass="att-h-SH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).SpRD, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.SpTard)"  Title="Tardiness" HeaderClass="att-h-SH" TextAlign="ColumnTextAlign.Right" Width="90px"><Template>@Z(((AttSummaryRow)context).SpTard, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.SpOT)"     Title="OT" HeaderClass="att-h-SH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).SpOT, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.SpND)"    Title="ND" HeaderClass="att-h-SH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).SpND, "#,##0.00")</Template></GridColumn>
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Double Holiday" HeaderClass="att-h-DH">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.DbDays)"   Title="Days" HeaderClass="att-h-DH"      TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).DbDays, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.DbRD)"     Title="RD" HeaderClass="att-h-DH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).DbRD, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.DbTard)"  Title="Tardiness" HeaderClass="att-h-DH" TextAlign="ColumnTextAlign.Right" Width="90px"><Template>@Z(((AttSummaryRow)context).DbTard, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.DbOT)"     Title="OT" HeaderClass="att-h-DH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).DbOT, "#,##0.00")</Template></GridColumn>
                                <GridColumn Field="@nameof(AttSummaryRow.DbND)"    Title="ND" HeaderClass="att-h-DH"        TextAlign="ColumnTextAlign.Right" Width="70px"><Template>@Z(((AttSummaryRow)context).DbND, "#,##0.00")</Template></GridColumn>
                            </Columns>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>

        </div>
    </div>

    <TelerikWindow Modal="true" @bind-Visible="@_showPdf" Width="90vw" Height="92vh">
        <WindowTitle>Attendance Processing</WindowTitle>
        <WindowContent>
            @if (_pdfBase64 != null)
            {
                <iframe src="data:application/pdf;base64,@_pdfBase64" style="width:100%;height:100%;border:none;"></iframe>
            }
        </WindowContent>
        <WindowActions><WindowAction Name="Close" /></WindowActions>
    </TelerikWindow>

</TelerikRootComponent>

@inject IDA_11003O          _daO
@inject IAttpunches1DataAccess _punchDa
@inject IOHolidayDataAccess    _holidayDa
@inject IOtreqdtlDataAccess    _otDtlDa
@inject ISettingsDataAccess    _settingsDa
@inject IAms_otsettingsDataAccess _otSetDa
@inject IAtttemplateDataAccess _tplDa
@inject HRMvc.StartupConfig.Library.AttendanceProcessor _proc
@inject IOManhourPushDataAccess _pushDa
@inject IOPayrollDataAccess _payroll
@inject IJSRuntime _js

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    private TelerikNotification NotificationRef { get; set; } = new();

    private DateTime _start = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _end   = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private bool     _busy;
    private List<string>      _years   = Enumerable.Range(DateTime.Now.Year - 2, 4).Select(y => y.ToString()).ToList();
    private List<string>      _months  = Enumerable.Range(1, 12).Select(m => m.ToString("00")).ToList();
    private List<OPayPeriod>  _periods = Enumerable.Range(1, 5).Select(i => new OPayPeriod { PdNumber = i.ToString("00"), PdName = $"{i} period" }).ToList();
    private string            _year    = DateTime.Now.Year.ToString();
    private string            _month   = DateTime.Now.Month.ToString("00");
    private string            _period  = DateTime.Now.Day > 15 ? "02" : "01";
    private string?           _trnStatus;
    private string PayrollCode
    {
        get
        {
            var gid = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId)?.Id;
            return gid is null || _year.Length < 4 ? string.Empty : $"{_year[2..]}{_month}{_period}-{gid:D5}";
        }
    }
