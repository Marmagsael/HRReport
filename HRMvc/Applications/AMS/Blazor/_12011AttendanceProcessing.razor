    protected override async Task OnParametersSetAsync()
    {
        if (Uc is null || _payrollGrps.Count > 0) return;
        try
        {
            _payrollGrps = await _daO._02Payrollgrps(Uc.OpayDb!, Uc.Conn!) ?? [];
            var fromDb = await _payroll._02Periods(Uc.OpayDb!, Uc.Conn!);
            if (fromDb.Count > 0) _periods = fromDb;
            SetDefaultDates();
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
    }

    private async Task OnPayrollGrpChanged(int? val)
    {
        _payrollGrpId  = val;
        _dailyByEmp    = [];
        _daily         = [];
        _summary       = [];
        _current       = null;
        _selectedEmps  = [];
        _emps          = [];
        await RefreshTrn();
        if (Uc is null || val is null) return;
        try
        {
            var list = await _daO._02Deprec_ByFieldId("PayrollgrpId", val, Uc.SchemaUserPis!, Uc.OpisDb!, Uc.Conn!) ?? [];
            _emps = list.Select(x => new AttEmpRow { SystemId = x.EmpmasId, EmpNumber = x.EmpNumber ?? string.Empty, EmpName = x.EmpName ?? string.Empty }).ToList();
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
    }

    private async Task OnLoad()
    {
        if (Uc is null) return;
        if (_payrollGrpId is null) { Notify("Please select a Payroll Group.", "warning"); return; }
        if (_end < _start) { Notify("End date must not be earlier than Start date.", "warning"); return; }

        _busy = true;
        try
        {
            var res = await _proc.Process(Uc, _payrollGrpId.Value, _emps, _start, _end);
            if (res.NdMissing) Notify("ND not computed: ND Start/End not found in Pay Settings.", "warning");
            _dailyByEmp = res.DailyByEmp;
            _summary    = res.Summary;

            _selectedEmps = _emps.ToList();
            ShowCurrent(_current ?? _emps.FirstOrDefault());
            Notify($"{_emps.Count} employee(s) loaded.", "success");
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
        _busy = false;
    }

    static string Z(double v, string fmt) => v == 0 ? string.Empty : v.ToString(fmt);

    string ReportFile(string ext) => $"AttendanceProcessing_{PayrollCode}_{_start:yyyyMMdd}_{_end:yyyyMMdd}.{ext}".Replace("-", "_");

    List<string> ReportSubtitles()
    {
        var grp = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId);
        return new List<string>
        {
            "For the period covering " + _start.ToString("MMM dd, yyyy") + " - " + _end.ToString("MMM dd, yyyy"),
            "Payroll Group : " + (grp is null ? "" : $"{grp.Code} - {grp.Name}") + (string.IsNullOrEmpty(PayrollCode) ? "" : "     Payroll Code : " + PayrollCode)
        };
    }

    static readonly string[] GroupNames = ["Regular Day", "Legal Holiday", "Special Holiday", "Double Holiday"];
    static readonly string[] GroupColors  = ["#EDF2F9", "#EBF4EE", "#F8F5E8", "#F8EEE6"];
    static readonly string[] GroupSubs    = ["#F5F8FC", "#F4F9F6", "#FCFAF3", "#FCF6F1"];
    static readonly string[] GroupTints   = ["#FAFBFE", "#F9FCFA", "#FEFDFA", "#FEFBF8"];
    static readonly string[] GroupAccents = ["#6C8EBF", "#6AA584", "#C2A85A", "#C98A5E"];

    static double[] GroupValues(AttSummaryRow r) =>
    [
        r.RegDays, r.RegRD, r.RegTard, r.RegOT, r.RegND,
        r.LegDays, r.LegRD, r.LegTard, r.LegOT, r.LegND,
        r.SpDays,  r.SpRD,  r.SpTard,  r.SpOT,  r.SpND,
        r.DbDays,  r.DbRD,  r.DbTard,  r.DbOT,  r.DbND
    ];

    static readonly string[] MetricNames = ["Days", "RD", "Tardiness", "OT", "ND"];
    static string Metric(int i, double v) => Z(v, i % 5 is 0 or 1 ? "#,##0.00" : "#,##0.00");

    async Task ExportExcel()
    {
        var sum = SummaryView;
        if (sum.Count == 0) return;
        try
        {
            using var wb = new XLWorkbook();
            var ws = wb.AddWorksheet("Summary");
            var subs = ReportSubtitles();
            ws.Cell(1, 1).Value = "Attendance Processing"; ws.Cell(1, 1).Style.Font.FontSize = 14; ws.Cell(1, 1).Style.Font.Bold = true;
            ws.Cell(2, 1).Value = subs[0];
            ws.Cell(3, 1).Value = subs[1];

            ws.Cell(5, 1).Value = "Emp#"; ws.Cell(5, 2).Value = "Name";
            for (int g = 0; g < 4; g++)
            {
                ws.Cell(5, 3 + g * 5).Value = GroupNames[g];
                ws.Range(5, 3 + g * 5, 5, 7 + g * 5).Merge().Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                for (int m = 0; m < 5; m++) ws.Cell(6, 3 + g * 5 + m).Value = MetricNames[m];
            }
            ws.Range(5, 1, 6, 22).Style.Font.Bold = true;
            ws.Range(5, 1, 6, 2).Style.Fill.BackgroundColor = XLColor.FromHtml("#F4F6F9");
            for (int g = 0; g < 4; g++)
            {
                var band = ws.Range(5, 3 + g * 5, 5, 7 + g * 5);
                band.Style.Fill.BackgroundColor = XLColor.FromHtml(GroupColors[g]);
                band.Style.Font.FontColor = XLColor.FromHtml("#2B3A4A");
                band.Style.Border.BottomBorder = XLBorderStyleValues.Medium;
                band.Style.Border.BottomBorderColor = XLColor.FromHtml(GroupAccents[g]);
                var sub = ws.Range(6, 3 + g * 5, 6, 7 + g * 5);
                sub.Style.Fill.BackgroundColor = XLColor.FromHtml(GroupSubs[g]);
                sub.Style.Font.FontColor = XLColor.FromHtml("#4A5A6A");
            }

            int n = 6;
            foreach (var r in sum)
            {
                n++;
                ws.Cell(n, 1).SetValue(r.EmpNumber); ws.Cell(n, 2).Value = r.EmpName.Trim();
                var v = GroupValues(r);
                for (int i = 0; i < v.Length; i++)
                    if (v[i] != 0) ws.Cell(n, 3 + i).Value = v[i];
            }
            ws.Range(7, 3, n, 22).Style.NumberFormat.Format = "#,##0.00"; ws.Range(7, 3, n, 22).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;
            if (n >= 7) for (int g = 0; g < 4; g++) ws.Range(7, 3 + g * 5, n, 7 + g * 5).Style.Fill.BackgroundColor = XLColor.FromHtml(GroupTints[g]);
            ws.Columns(1, 22).AdjustToContents(5, Math.Max(n, 6));

            var wd = wb.AddWorksheet("Daily");
            string[] hd = ["Emp#", "Name", "Date", "Day", "Day Type", "Holiday", "Remarks", "Time In", "Time Out", "Late", "Under Time", "Absent (Days)", "Tot Tardiness", "Overtime", "ND"];
            for (int i = 0; i < hd.Length; i++) wd.Cell(1, i + 1).Value = hd[i];
            wd.Row(1).Style.Font.Bold = true;
            wd.Row(1).Style.Fill.BackgroundColor = XLColor.FromHtml("#F4F6F9");
            int d = 1;
            foreach (var e in _selectedEmps)
                foreach (var x in _dailyByEmp.TryGetValue(e.SystemId, out var rowsOf) ? rowsOf : [])
                {
                    d++;
                    wd.Cell(d, 1).SetValue(e.EmpNumber); wd.Cell(d, 2).Value = e.EmpName.Trim();
                    wd.Cell(d, 3).Value = x.Date.ToString("MM/dd/yyyy"); wd.Cell(d, 4).Value = x.Day; wd.Cell(d, 5).Value = x.DayType;
                    wd.Cell(d, 6).Value = x.Holiday; wd.Cell(d, 7).Value = x.Remarks; wd.Cell(d, 8).Value = x.TimeIn; wd.Cell(d, 9).Value = x.TimeOut;
                    if (x.LateHrs != 0)     wd.Cell(d, 10).Value = x.LateHrs;
                    if (x.UnderHrs != 0)    wd.Cell(d, 11).Value = x.UnderHrs;
                    if (x.AbsDays != 0)     wd.Cell(d, 12).Value = x.AbsDays;
                    if (x.TotTardHrs != 0)  wd.Cell(d, 13).Value = x.TotTardHrs;
                    if (x.Overtime != 0)    wd.Cell(d, 14).Value = x.Overtime;
                    if (x.ND != 0)          wd.Cell(d, 15).Value = x.ND;
                }
            wd.Range(2, 10, Math.Max(d, 2), 15).Style.NumberFormat.Format = "#,##0.00"; wd.Range(2, 10, Math.Max(d, 2), 15).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right; wd.Range(1, 10, 1, 15).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;
            wd.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            await _js.InvokeVoidAsync("downloadFile", ReportFile("xlsx"), Convert.ToBase64String(ms.ToArray()));
        }
        catch (Exception ex) { Console.Error.WriteLine("12011 excel: " + ex); Notify("Unable to create the Excel file.", "error"); }
    }

    async Task ExportPdf()
    {
        var sum = SummaryView;
        if (sum.Count == 0) return;
        try
        {
            var cols = new List<PdfCol> { new() { Title = "Emp#", Width = 0.6 }, new() { Title = "Name", Width = 1.7 } };
            for (int g = 0; g < 4; g++)
                for (int m = 0; m < 5; m++)
                    cols.Add(new PdfCol { Title = MetricNames[m], Width = m == 2 ? 0.6 : 0.5, Right = true });
            var bands = new List<(string Title, int Span)> { ("", 2) };
            foreach (var gn in GroupNames) bands.Add((gn, 5));
            for (int g = 0; g < 4; g++) for (int m = 0; m < 5; m++) cols[2 + g * 5 + m].Color = GroupSubs[g];

            var list = new List<(string[] Cells, int Kind)>();
            foreach (var r in sum)
            {
                var cells = new List<string> { r.EmpNumber, r.EmpName.Trim() };
                var v = GroupValues(r);
                for (int i = 0; i < v.Length; i++) cells.Add(Metric(i, v[i]));
                list.Add((cells.ToArray(), 0));
            }
            var tot = new List<string> { "", "TOTAL" };
            for (int i = 0; i < 20; i++) tot.Add(Metric(i, sum.Sum(r => GroupValues(r)[i])));
            list.Add((tot.ToArray(), 1));
            var subs = ReportSubtitles();
            subs.Add("Tardiness (late + undertime + absent), OT and ND in hours.");
            var bytes = TablePdf.Build("Attendance Processing", subs, cols, list, landscape: true, paper: System.Drawing.Printing.PaperKind.Legal, bands: bands, bandColors: ["#F4F6F9", .. GroupColors]);
            _pdfBase64 = Convert.ToBase64String(bytes);
            _showPdf = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("12011 pdf: " + ex); Notify("Unable to create the PDF.", "error"); }
    }

    private async Task OnPushClick()
    {
        if (Uc is null || _payrollGrpId is null) return;
        var grp = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId);
        var sel = _selectedEmps.ToList();
        if (sel.Count == 0) { Notify("Please select at least one employee.", "warning"); return; }

        try
        {
            await RefreshTrn(false);
            if (_trnStatus is null or "Lock")
            {
                Notify($"No open payroll transaction for payroll group {grp?.Name}, payroll period {_start:MMM dd} - {_end:MMM dd, yyyy} (code {PayrollCode}).", "warning");
                return;
            }
            _pushTrn         = PayrollCode;
            _pushCount       = sel.Count;
            _pushConfirmOpen = true;
        }
        catch (Exception ex) { Notify($"Push failed: {ex.Message}", "error"); }
    }

    private async Task OnPushConfirm()
    {
        _pushConfirmOpen = false;
        if (Uc is null) return;
        _busy = true;
        try
        {
            var byEmp = new Dictionary<string, Dictionary<string, double>>();
            var rateIds = await _pushDa._02RateIds(_selectedEmps.Select(x => x.EmpNumber).ToList(), Uc.OpisDb!, Uc.Conn!);
            foreach (var e in _selectedEmps)
            {
                bool monthly = rateIds.TryGetValue(e.EmpNumber.Trim(), out var rid) && rid is 1 or 3;
                byEmp[e.EmpNumber.Trim()] = BuildManhour(_dailyByEmp.TryGetValue(e.SystemId, out var r) ? r : [], monthly);
            }

            var (updated, skipped) = await _pushDa._03Push(_pushTrn, byEmp, Uc.OpayDb!, Uc.Conn!);
            Notify($"{updated} employee(s) pushed to {_pushTrn}." + (skipped.Count > 0 ? $" Not in the transaction: {string.Join(", ", skipped)}." : string.Empty),
                   skipped.Count > 0 ? "warning" : "success");
        }
        catch (Exception ex) { Notify($"Push failed: {ex.Message}", "error"); }
        _busy = false;
    }

    private static Dictionary<string, double> BuildManhour(List<AttDailyRow> rows, bool monthly)
    {
        var m = new Dictionary<string, double>();
        void Add(string col, double v) { if (v != 0 && col != "") m[col] = (m.TryGetValue(col, out var c) ? c : 0) + v; }

        foreach (var x in rows)
        {
            bool onHoliday = x.Holiday is "LH" or "SH" or "DH";
            Add("absent", (monthly ? x.AbsentHrs : 0) + (onHoliday ? 0 : x.Tardiness / 60.0 + x.Undertime / 60.0));

            if (x.Kind is "OB" or "LV") { Add("daywrk", x.Credit); continue; }
            if (x.Kind == "AB") continue;

            Add("daywrk", x.Credit);

            foreach (var g in x.Segs)
            {
                // [hours column, OT column, ND column, ND OT column] of the day type of this part of the duty
                string[] c = (g.Holiday, g.IsRd) switch
                {
                    ("LH", false) => ["lh", "lhot", "ndlh", "ndlhot"],
                    ("LH", true)  => ["rdlh", "rdlhot", "ndrdlh", "ndrdlhot"],
                    ("SH", false) => ["sh", "shot", "ndsh", "ndshot"],
                    ("SH", true)  => ["rdsh", "rdshot", "ndrdsh", "ndrdshot"],
                    ("DH", false) => ["dh", "dhot", "nddh", "nddhot"],
                    ("DH", true)  => ["rddh", "rddhot", "ndrddh", "ndrddhot"],
                    (_, true)     => ["rd", "rdot", "ndrd", "ndrdot"],
                    _             => ["", "rot", "nd", "ndot"]
                };
                Add(c[0], g.Hours);
                Add(c[1], g.OtHrs);
                Add(c[2], g.Nd);
                Add(c[3], g.NdOt);
            }
        }
        return m;
    }

    private void OnDailyRowRender(GridRowRenderEventArgs args)
    {
        if (args.Item is not AttDailyRow r) return;
        var key = r.Kind != string.Empty ? r.Kind : r.Holiday != string.Empty ? r.Holiday : r.DayType;
        if (key is "RD" or "RN" or "LH" or "SH" or "DH" or "OB" or "LV" or "AB") args.Class = $"att-r-{key}";
    }

    private void SetDefaultDates()
    {
        if (!int.TryParse(_year, out var y) || !int.TryParse(_month, out var m)) return;
        switch (_period)
        {
            case "01": _start = new DateTime(y, m, 1);  _end = new DateTime(y, m, 15); break;
            case "02": _start = new DateTime(y, m, 16); _end = new DateTime(y, m, DateTime.DaysInMonth(y, m)); break;
        }
    }

    private async Task OnPeriodChanged(Action set)
    {
        set();
        SetDefaultDates();
        ResetResults();
        await RefreshTrn();
    }

    private async Task RefreshTrn(bool setDates = true)
    {
        _trnStatus = null;
        var code = PayrollCode;
        if (Uc is null || string.IsNullOrEmpty(code)) return;
        try
        {
            var info = await _pushDa._02TrnInfo(code, Uc.OpayDb!, Uc.Conn!);
            if (info is null) return;
            _trnStatus = info.Status;
            if (setDates) { _start = info.AttStart; _end = info.AttEnd; }
        }
        catch (Exception ex) { Notify($"Unable to check the payroll transaction: {ex.Message}", "error"); }
    }

    private void ResetResults()
    {
        _dailyByEmp = [];
        _daily      = [];
        _summary    = [];
    }

    private void OnEmpRowClick(GridRowClickEventArgs args) => ShowCurrent(args.Item as AttEmpRow);

    private void ShowCurrent(AttEmpRow? e)
    {
        _current = e;
        _daily   = e is not null && _dailyByEmp.TryGetValue(e.SystemId, out var r) ? r : [];
    }

    private void Notify(string text, string theme) =>
        NotificationRef.Show(new NotificationModel { Text = text, ThemeColor = theme, CloseAfter = 4000 });

