@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Models._10_Pis
@using HRApiLibrary.Modules._11003O
@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._11_AMS
@using HRApiLibrary.DataAccess._20_Pay
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.DataAccess._20_Pay.OPay
@using HRApiLibrary.Models._20_Pay
@using HRApiLibrary.Models._20_Pay.OPay
@using HRMvc.Applications._00GeneralComponents.BodyComponents
@using Telerik.Blazor.Components
@using ClosedXML.Excel
@using HRMvc.Applications.PayrollReport.Class
@using Microsoft.JSInterop

<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="NotificationHorizontalPosition.Center"
                         VerticalPosition="NotificationVerticalPosition.Top" />

    <TelerikDialog @bind-Visible="@_pushConfirmOpen" Title="Push to Payroll Entry" Width="460px">
        <DialogContent>
            <p>Push the manhours of <b>@_pushCount</b> selected employee(s) to payroll transaction <b>@_pushTrn</b> (@_start.ToString("MM/dd/yyyy") - @_end.ToString("MM/dd/yyyy"))?</p>
            <p class="mb-0">The attendance manhour columns of those employees in the transaction will be replaced.</p>
        </DialogContent>
        <DialogButtons>
            <TelerikButton OnClick="OnPushConfirm" ThemeColor="primary">Yes, Push</TelerikButton>
            <TelerikButton OnClick="@(() => _pushConfirmOpen = false)">Cancel</TelerikButton>
        </DialogButtons>
    </TelerikDialog>

    <style>
        .att-emp-grid .k-grid-content tr,
        .att-emp-grid .k-grid-content td { cursor: pointer; }
        .att-legend { display:flex; gap:12px; align-items:center; flex-wrap:wrap; font-size:12px; padding:2px 0; }
        .att-legend span.sw { display:inline-block; width:14px; height:14px; border:1px solid #999; margin-right:4px; vertical-align:middle; }
        .att-r-RD  td, .att-sw-RD  { background:#dee2e6 !important; color:#212529; }
        .att-r-RN  td, .att-sw-RN  { background:#cfd4f7 !important; color:#212529; }
        .att-r-OB  td, .att-sw-OB  { background:#c9ecf5 !important; color:#212529; }
        .att-r-LV  td, .att-sw-LV  { background:#f8d0e0 !important; color:#212529; }
        .att-r-LH  td, .att-sw-LH  { background:#c8f0d2 !important; color:#212529; }
        .att-r-SH  td, .att-sw-SH  { background:#fff3b0 !important; color:#212529; }
        .att-r-AB  td, .att-sw-AB  { background:#f5b7b1 !important; color:#212529; }
        .att-r-DH  td, .att-sw-DH  { background:#ffd3a8 !important; color:#212529; }
    </style>

    <div class="card w-100 p-1">
        <BodyHdr pageTitle="Attendance Processing" />
        <div class="card-body p-1 w-100">

            <div class="d-flex gap-2 align-items-end flex-wrap bordered-bottom py-1">
                <div>
                    <div class="small fw-bold">PAYROLL GROUP</div>
                    <TelerikDropDownList Data="@_payrollGrps"
                                         Value="@_payrollGrpId"
                                         ValueChanged="@((int? val) => OnPayrollGrpChanged(val))"
                                         TextField="Name" ValueField="Id" Width="300px" DefaultText="Select payroll group">
                        <DropDownListSettings>
                            <DropDownListPopupSettings Height="300px" />
                        </DropDownListSettings>
                    </TelerikDropDownList>
                </div>
                <div>
                    <div class="small fw-bold">YEAR</div>
                    <TelerikDropDownList Data="@_years" Value="@_year" ValueChanged="@((string v) => OnPeriodChanged(() => _year = v))" Width="90px" />
                </div>
                <div>
                    <div class="small fw-bold">MONTH</div>
                    <TelerikDropDownList Data="@_months" Value="@_month" ValueChanged="@((string v) => OnPeriodChanged(() => _month = v))" Width="75px" />
                </div>
                <div>
                    <div class="small fw-bold">PERIOD</div>
                    <TelerikDropDownList Data="@_periods" TextField="@nameof(OPayPeriod.PdNumber)" ValueField="@nameof(OPayPeriod.PdNumber)"
                                         Value="@_period" ValueChanged="@((string v) => OnPeriodChanged(() => _period = v))" Width="75px" />
                </div>
                <div>
                    <div class="small fw-bold">ATTENDANCE START</div>
                    <TelerikDatePicker Value="@_start" ValueChanged="@((DateTime v) => { _start = v; ResetResults(); })" Format="MMM dd, yyyy" Width="150px" />
                </div>
                <div>
                    <div class="small fw-bold">ATTENDANCE END</div>
                    <TelerikDatePicker Value="@_end" ValueChanged="@((DateTime v) => { _end = v; ResetResults(); })" Format="MMM dd, yyyy" Width="150px" />
                </div>
                <TelerikButton OnClick="OnLoad" ThemeColor="primary" Enabled="@(!_busy && _payrollGrpId is not null)">@(_busy ? "Loading..." : "Load")</TelerikButton>
                <TelerikButton OnClick="OnPushClick" Enabled="@(!_busy && _dailyByEmp.Count > 0)">Push to Payroll Entry</TelerikButton>
                <TelerikButton OnClick="ExportExcel" FillMode="outline" Enabled="@(SummaryView.Count > 0)">Excel</TelerikButton>
                <TelerikButton OnClick="ExportPdf" FillMode="outline" Enabled="@(SummaryView.Count > 0)">PDF</TelerikButton>
            </div>

            <div class="w-100 p-2 bg-white bordered-bottom">
                <div class="d-flex flex-wrap align-items-baseline row-gap-2">
                    <div class="d-flex align-items-baseline gap-2 pe-4">
                        <span class="fw-bold small">PAYROLL CODE :</span>
                        <span>@PayrollCode</span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 px-4 border-start">
                        <span class="fw-bold small">PAYROLL GROUP :</span>
                        <span>@(_payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId) is { } g ? $"{g.Code} - {g.Name}" : "")</span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 px-4 border-start">
                        <span class="fw-bold small">PAYROLL PERIOD :</span>
                        <span>@_start.ToString("MMM dd") - @_end.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 px-4 border-start">
                        <span class="fw-bold small">STATUS :</span>
                        <span class="@(_trnStatus is null && !string.IsNullOrEmpty(PayrollCode) ? "text-danger" : _trnStatus == "Lock" ? "txt-maroon fw-bold" : "")">@(_trnStatus ?? (string.IsNullOrEmpty(PayrollCode) ? "" : "No open transaction"))</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-2">

                <div style="width:360px; flex:none;">
                    <TelerikGrid Data="@_emps"
                                 Class="att-emp-grid"
                                 Height="320px"
                                 Size="sm"
                                 SelectionMode="GridSelectionMode.Multiple"
                                 @bind-SelectedItems="@_selectedEmps"
                                 OnRowClick="@OnEmpRowClick">
                        <GridToolBarTemplate>
                            <span class="fw-bold">Employee List</span>
                        </GridToolBarTemplate>
                        <GridColumns>
                            <GridCheckboxColumn Width="40px" SelectAll="true" />
                            <GridColumn Field="@nameof(AttEmpRow.EmpNumber)" Title="Emp. No." Width="80px" />
                            <GridColumn Field="@nameof(AttEmpRow.EmpName)"   Title="Name" />
                        </GridColumns>
                    </TelerikGrid>
                </div>

                <div class="flex-grow-1">
                    <TelerikGrid Data="@_daily"
                                 OnRowRender="@OnDailyRowRender"
                                 Height="320px"
                                 Size="sm"
                                 Pageable="false">
                        <GridToolBarTemplate>
                            <span class="fw-bold">@(_current is null ? "<<Employee Name>>" : _current.EmpName)</span>
                        </GridToolBarTemplate>
                        <GridColumns>
                            <GridColumn Field="@nameof(AttDailyRow.Date)"      Title="Date"       DisplayFormat="{0:MM/dd/yyyy}" Width="100px" />
                            <GridColumn Field="@nameof(AttDailyRow.Day)"       Title="Day"        Width="60px" />
                            <GridColumn Field="@nameof(AttDailyRow.DayType)"   Title="Day Type"   Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.Holiday)"   Title="Holiday"    Width="70px" />
                            <GridColumn Field="@nameof(AttDailyRow.Remarks)"   Title="Remarks"    Width="110px" />
                            <GridColumn Field="@nameof(AttDailyRow.TimeIn)"    Title="Time In"    Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.TimeOut)"   Title="Time Out"   Width="80px" />
                            <GridColumn Field="@nameof(AttDailyRow.Tardiness)" Title="Tardiness"  DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                            <GridColumn Field="@nameof(AttDailyRow.Undertime)" Title="Undertime"  DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                            <GridColumn Field="@nameof(AttDailyRow.Overtime)"  Title="Overtime"   DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                            <GridColumn Field="@nameof(AttDailyRow.ND)"        Title="ND"         DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                            <GridColumn Field="@nameof(AttDailyRow.DutyStart)" Title="Duty Start" Width="90px" />
                            <GridColumn Field="@nameof(AttDailyRow.DutyEnd)"   Title="Duty End"   Width="90px" />
                        </GridColumns>
                    </TelerikGrid>
                    <div class="att-legend">
                        <b>Legend:</b>
                        <span><span class="sw" style="background:#fff"></span>R - Regular Day</span>
                        <span><span class="sw att-sw-RD"></span>RD - Rest Day</span>
                        <span><span class="sw att-sw-RN"></span>RN - Regular Night</span>
                        <span><span class="sw att-sw-OB"></span>OB - Official Business (paid)</span>
                        <span><span class="sw att-sw-LV"></span>LV - Paid Leave</span>
                        <span><span class="sw att-sw-AB"></span>AB - Absent</span>
                        <span><span class="sw att-sw-LH"></span>LH - Legal Holiday</span>
                        <span><span class="sw att-sw-SH"></span>SH - Special Holiday</span>
                        <span><span class="sw att-sw-DH"></span>DH - Double Holiday</span>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <TelerikGrid Data="@SummaryView"
                             Height="320px"
                             Size="sm"
                             Pageable="false">
                    <GridColumns>
                        <GridColumn Field="@nameof(AttSummaryRow.EmpNumber)" Title="Emp#" Width="80px" />
                        <GridColumn Field="@nameof(AttSummaryRow.EmpName)"   Title="Name" Width="200px" />
                        <GridColumn Title="Regular Day" HeaderClass="bg-primary-subtle">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.RegDays)"  Title="Days"      DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.RegRD)"    Title="RD"        DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.RegTard)"  Title="Tardiness" DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                                <GridColumn Field="@nameof(AttSummaryRow.RegOT)"    Title="OT"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.RegND)"    Title="ND"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Legal Holiday" HeaderClass="bg-success-subtle">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.LegDays)"  Title="Days"      DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.LegRD)"    Title="RD"        DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.LegTard)"  Title="Tardiness" DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                                <GridColumn Field="@nameof(AttSummaryRow.LegOT)"    Title="OT"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.LegND)"    Title="ND"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Special Holiday" HeaderClass="bg-warning-subtle">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.SpDays)"   Title="Days"      DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.SpRD)"     Title="RD"        DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.SpTard)"   Title="Tardiness" DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                                <GridColumn Field="@nameof(AttSummaryRow.SpOT)"     Title="OT"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.SpND)"    Title="ND"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                            </Columns>
                        </GridColumn>
                        <GridColumn Title="Double Holiday" HeaderClass="bg-danger-subtle">
                            <Columns>
                                <GridColumn Field="@nameof(AttSummaryRow.DbDays)"   Title="Days"      DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.DbRD)"     Title="RD"        DisplayFormat="{0:0.##;-0.##;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.DbTard)"   Title="Tardiness" DisplayFormat="{0:#,##0;-#,##0;}" TextAlign="ColumnTextAlign.Right" Width="90px" />
                                <GridColumn Field="@nameof(AttSummaryRow.DbOT)"     Title="OT"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                                <GridColumn Field="@nameof(AttSummaryRow.DbND)"    Title="ND"        DisplayFormat="{0:#,##0.00;-#,##0.00;}" TextAlign="ColumnTextAlign.Right" Width="70px" />
                            </Columns>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>

        </div>
    </div>

    <TelerikWindow Modal="true" @bind-Visible="@_showPdf" Width="90vw" Height="92vh">
        <WindowTitle>Attendance Processing</WindowTitle>
        <WindowContent>
            @if (_pdfBase64 != null)
            {
                <iframe src="data:application/pdf;base64,@_pdfBase64" style="width:100%;height:100%;border:none;"></iframe>
            }
        </WindowContent>
        <WindowActions><WindowAction Name="Close" /></WindowActions>
    </TelerikWindow>

</TelerikRootComponent>

@inject IDA_11003O          _daO
@inject IAttpunches1DataAccess _punchDa
@inject IOHolidayDataAccess    _holidayDa
@inject IOtreqdtlDataAccess    _otDtlDa
@inject ISettingsDataAccess    _settingsDa
@inject IAms_otsettingsDataAccess _otSetDa
@inject IAtttemplateDataAccess _tplDa
@inject IOManhourPushDataAccess _pushDa
@inject IOPayrollDataAccess _payroll
@inject IJSRuntime _js

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }

    private TelerikNotification NotificationRef { get; set; } = new();

    private DateTime _start = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _end   = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private bool     _busy;
    private List<string>      _years   = Enumerable.Range(DateTime.Now.Year - 2, 4).Select(y => y.ToString()).ToList();
    private List<string>      _months  = Enumerable.Range(1, 12).Select(m => m.ToString("00")).ToList();
    private List<OPayPeriod>  _periods = Enumerable.Range(1, 5).Select(i => new OPayPeriod { PdNumber = i.ToString("00"), PdName = $"{i} period" }).ToList();
    private string            _year    = DateTime.Now.Year.ToString();
    private string            _month   = DateTime.Now.Month.ToString("00");
    private string            _period  = DateTime.Now.Day > 15 ? "02" : "01";
    private string?           _trnStatus;
    private string PayrollCode
    {
        get
        {
            var cl = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId)?.Clnumber?.Trim();
            return string.IsNullOrEmpty(cl) || _year.Length < 4 ? string.Empty : $"{_year[2..]}{_month}{_period}-{cl}";
        }
    }
    private bool     _pushConfirmOpen;
    private string   _pushTrn = string.Empty;
    private int      _pushCount;

    private List<M11003_Payrollgrp> _payrollGrps = [];
    private int?                 _payrollGrpId;
    private List<AttEmpRow>      _emps         = [];
    private IEnumerable<AttEmpRow> _selectedEmps = [];
    private AttEmpRow?           _current;
    private List<AttDailyRow>    _daily        = [];
    private bool    _showPdf;
    private string? _pdfBase64;
    private List<AttSummaryRow>  _summary      = [];
    private List<AttSummaryRow>  SummaryView   => _summary.Where(x => _selectedEmps.Any(e => e.EmpNumber == x.EmpNumber)).ToList();
    private Dictionary<int, List<AttDailyRow>> _dailyByEmp = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Uc is null || _payrollGrps.Count > 0) return;
        try
        {
            _payrollGrps = await _daO._02Payrollgrps(Uc.OpayDb!, Uc.Conn!) ?? [];
            var fromDb = await _payroll._02Periods(Uc.OpayDb!, Uc.Conn!);
            if (fromDb.Count > 0) _periods = fromDb;
            SetDefaultDates();
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
    }

    private async Task OnPayrollGrpChanged(int? val)
    {
        _payrollGrpId  = val;
        _dailyByEmp    = [];
        _daily         = [];
        _summary       = [];
        _current       = null;
        _selectedEmps  = [];
        _emps          = [];
        await RefreshTrn();
        if (Uc is null || val is null) return;
        try
        {
            var list = await _daO._02Deprec_ByFieldId("PayrollgrpId", val, Uc.SchemaUserPis!, Uc.OpisDb!, Uc.Conn!) ?? [];
            _emps = list.Select(x => new AttEmpRow { SystemId = x.EmpmasId, EmpNumber = x.EmpNumber ?? string.Empty, EmpName = x.EmpName ?? string.Empty }).ToList();
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
    }

    private async Task OnLoad()
    {
        if (Uc is null) return;
        if (_payrollGrpId is null) { Notify("Please select a Payroll Group.", "warning"); return; }
        if (_end < _start) { Notify("End date must not be earlier than Start date.", "warning"); return; }

        _busy = true;
        try
        {
            _dailyByEmp = [];
            _summary    = [];
            var dstart  = DateOnly.FromDateTime(_start);
            var dend    = DateOnly.FromDateTime(_end);
            var holidays = await LoadHolidays();
            var pay      = await _settingsDa._02(1, Uc.SchemaUserPay, Uc.Conn);
            var nd       = pay is null || pay.NdStart is null || pay.NdEnd is null ? ((int, int)?)null : (pay.NdStart.Value, pay.NdEnd.Value);
            if (nd is null) Notify("ND not computed: ND Start/End not found in Pay Settings.", "warning");
            var otSettings = (await _otSetDa._02sByPayrollgrpid(_payrollGrpId!.Value, Uc.SchemaUserPis!, Uc.OpisDb!, Uc.Conn!) ?? [])
                                .Where(x => x is not null)
                                .GroupBy(x => x!.Empnumber.Trim())
                                .ToDictionary(g => g.Key, g => g.First()!.NeedsotfilingBool);

            var ids       = _emps.Where(x => x.SystemId > 0).Select(x => x.SystemId).Distinct().ToList();
            var allPunch  = (await _punchDa._02ByIdsByRange(ids, dstart, dend, Uc.SchemaUserPis, Uc.Conn) ?? [])
                                .Where(p => p is not null).GroupBy(p => p!.EmpmasId ?? 0).ToDictionary(g => g.Key, g => g.ToList());

            var needIds   = _emps.Where(x => x.SystemId > 0 && otSettings.TryGetValue(x.EmpNumber.Trim(), out var nn) && nn).Select(x => x.SystemId).Distinct().ToList();
            var allFiled  = (await _otDtlDa._02ApprovedByEmpmasIds_RangeByPunchIn(needIds, _start, _end, Uc.SchemaUserPis, Uc.Conn) ?? [])
                                .Where(o => o is not null).GroupBy(o => o!.EmpmasId).ToDictionary(g => g.Key, g => g.ToList());

            var tpls       = (await _tplDa._02ByEmpmasIds(ids, Uc.SchemaUserPis, Uc.Conn) ?? []).Where(t => t is not null).ToDictionary(t => t!.EmpmasId ?? 0, t => t!);
            var defaultTpl = await _tplDa._02NoSchedule(0, Uc.SchemaUserPis, Uc.Conn);

            foreach (var e in _emps)
            {
                var rows = new List<AttDailyRow>();
                var empTpl = e.SystemId > 0 && tpls.TryGetValue(e.SystemId, out var et) ? et : defaultTpl;
                Func<DateTime, bool> isRdDay = d => empTpl is not null && DutyOf(empTpl, d) == "RD";
                if (e.SystemId > 0 && allPunch.TryGetValue(e.SystemId, out var punches))
                {
                    bool needsOt = otSettings.TryGetValue(e.EmpNumber.Trim(), out var n) && n;
                    var filed = new Dictionary<DateTime, double>();
                    if (needsOt && allFiled.TryGetValue(e.SystemId, out var ots))
                        filed = ots.GroupBy(o => o!.PunchIn.Date).ToDictionary(g => g.Key, g => g.Sum(o => o!.TotHrs));
                    rows = punches.Select(p => ToDaily(p!, holidays, needsOt, filed, nd, isRdDay)).ToList();
                }
                if (e.SystemId > 0)
                {
                    var tpl = tpls.TryGetValue(e.SystemId, out var t) ? t : defaultTpl;
                    if (tpl is not null)
                    {
                        var seen = rows.Select(r => r.Date).ToHashSet();
                        var last = _end.Date < DateTime.Today ? _end.Date : DateTime.Today;
                        for (var d = _start.Date; d <= last; d = d.AddDays(1))
                        {
                            if (seen.Contains(d) || holidays.ContainsKey(d) || DutyOf(tpl, d) != "R") continue;
                            rows.Add(new AttDailyRow
                            {
                                Date = d, Day = d.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture), DayType = "R", Kind = "AB",
                                Remarks = "Absent", AbsentHrs = OPayrollConstants.HoursPerDay
                            });
                        }
                        rows = rows.OrderBy(r => r.Date).ToList();
                    }
                }
                _dailyByEmp[e.SystemId] = rows;
                _summary.Add(ToSummary(e, rows));
            }

            _selectedEmps = _emps.ToList();
            ShowCurrent(_current ?? _emps.FirstOrDefault());
            Notify($"{_emps.Count} employee(s) loaded.", "success");
        }
        catch (Exception ex) { Notify($"Load failed: {ex.Message}", "error"); }
        _busy = false;
    }

    static string Z(double v, string fmt) => v == 0 ? string.Empty : v.ToString(fmt);

    string ReportFile(string ext) => $"AttendanceProcessing_{PayrollCode}_{_start:yyyyMMdd}_{_end:yyyyMMdd}.{ext}".Replace("-", "_");

    List<string> ReportSubtitles()
    {
        var grp = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId);
        return new List<string>
        {
            "For the period covering " + _start.ToString("MMM dd, yyyy") + " - " + _end.ToString("MMM dd, yyyy"),
            "Payroll Group : " + (grp is null ? "" : $"{grp.Code} - {grp.Name}") + (string.IsNullOrEmpty(PayrollCode) ? "" : "     Payroll Code : " + PayrollCode)
        };
    }

    static readonly string[] GroupNames = ["Regular Day", "Legal Holiday", "Special Holiday", "Double Holiday"];

    static double[] GroupValues(AttSummaryRow r) =>
    [
        r.RegDays, r.RegRD, r.RegTard, r.RegOT, r.RegND,
        r.LegDays, r.LegRD, r.LegTard, r.LegOT, r.LegND,
        r.SpDays,  r.SpRD,  r.SpTard,  r.SpOT,  r.SpND,
        r.DbDays,  r.DbRD,  r.DbTard,  r.DbOT,  r.DbND
    ];

    static readonly string[] MetricNames = ["Days", "RD", "Tard", "OT", "ND"];
    static string Metric(int i, double v) => Z(v, i % 5 is 0 or 1 ? "0.##" : i % 5 == 2 ? "#,##0" : "#,##0.00");

