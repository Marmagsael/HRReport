            ws.Range(7, 3, n, 22).Style.NumberFormat.Format = "#,##0.##";
            ws.Columns().AdjustToContents();

            var wd = wb.AddWorksheet("Daily");
            string[] hd = ["Emp#", "Name", "Date", "Day", "Day Type", "Holiday", "Remarks", "Time In", "Time Out", "Tardiness", "Undertime", "Overtime", "ND"];
            for (int i = 0; i < hd.Length; i++) wd.Cell(1, i + 1).Value = hd[i];
            wd.Row(1).Style.Font.Bold = true;
            wd.Row(1).Style.Fill.BackgroundColor = XLColor.FromHtml("#F4F6F9");
            int d = 1;
            foreach (var e in _selectedEmps)
                foreach (var x in _dailyByEmp.TryGetValue(e.SystemId, out var rowsOf) ? rowsOf : [])
                {
                    d++;
                    wd.Cell(d, 1).SetValue(e.EmpNumber); wd.Cell(d, 2).Value = e.EmpName.Trim();
                    wd.Cell(d, 3).Value = x.Date.ToString("MM/dd/yyyy"); wd.Cell(d, 4).Value = x.Day; wd.Cell(d, 5).Value = x.DayType;
                    wd.Cell(d, 6).Value = x.Holiday; wd.Cell(d, 7).Value = x.Remarks; wd.Cell(d, 8).Value = x.TimeIn; wd.Cell(d, 9).Value = x.TimeOut;
                    if (x.Tardiness != 0) wd.Cell(d, 10).Value = x.Tardiness;
                    if (x.Undertime != 0) wd.Cell(d, 11).Value = x.Undertime;
                    if (x.Overtime != 0)  wd.Cell(d, 12).Value = x.Overtime;
                    if (x.ND != 0)        wd.Cell(d, 13).Value = x.ND;
                }
            wd.Range(2, 10, Math.Max(d, 2), 13).Style.NumberFormat.Format = "#,##0.##";
            wd.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            await _js.InvokeVoidAsync("downloadFile", ReportFile("xlsx"), Convert.ToBase64String(ms.ToArray()));
        }
        catch (Exception ex) { Console.Error.WriteLine("12011 excel: " + ex); Notify("Unable to create the Excel file.", "error"); }
    }

    async Task ExportPdf()
    {
        var sum = SummaryView;
        if (sum.Count == 0) return;
        try
        {
            var cols = new List<PdfCol> { new() { Title = "Emp#", Width = 0.6 }, new() { Title = "Name", Width = 1.7 } };
            string[] mt = ["Days", "RD", "Tardiness", "OT", "ND"];
            for (int g = 0; g < 4; g++)
                for (int m = 0; m < 5; m++)
                    cols.Add(new PdfCol { Title = mt[m], Width = m == 2 ? 0.6 : 0.5, Right = true });
            var bands = new List<(string Title, int Span)> { ("", 2) };
            foreach (var gn in GroupNames) bands.Add((gn, 5));

            var list = new List<(string[] Cells, int Kind)>();
            foreach (var r in sum)
            {
                var cells = new List<string> { r.EmpNumber, r.EmpName.Trim() };
                var v = GroupValues(r);
                for (int i = 0; i < v.Length; i++) cells.Add(Metric(i, v[i]));
                list.Add((cells.ToArray(), 0));
            }
            var tot = new List<string> { "", "TOTAL" };
            for (int i = 0; i < 20; i++) tot.Add(Metric(i, sum.Sum(r => GroupValues(r)[i])));
            list.Add((tot.ToArray(), 1));
            var subs = ReportSubtitles();
            subs.Add("Tardiness in minutes; OT and ND in hours.");
            var bytes = TablePdf.Build("Attendance Processing", subs, cols, list, landscape: true, paper: System.Drawing.Printing.PaperKind.Legal, bands: bands);
            _pdfBase64 = Convert.ToBase64String(bytes);
            _showPdf = true;
        }
        catch (Exception ex) { Console.Error.WriteLine("12011 pdf: " + ex); Notify("Unable to create the PDF.", "error"); }
    }

    private async Task OnPushClick()
    {
        if (Uc is null || _payrollGrpId is null) return;
        var grp = _payrollGrps.FirstOrDefault(x => x.Id == _payrollGrpId);
        var sel = _selectedEmps.ToList();
        if (sel.Count == 0) { Notify("Please select at least one employee.", "warning"); return; }

        try
        {
            await RefreshTrn(false);
            if (_trnStatus is null or "Lock")
            {
                Notify($"No open payroll transaction for payroll group {grp?.Name}, payroll period {_start:MMM dd} - {_end:MMM dd, yyyy} (code {PayrollCode}).", "warning");
                return;
            }
            _pushTrn         = PayrollCode;
            _pushCount       = sel.Count;
            _pushConfirmOpen = true;
        }
        catch (Exception ex) { Notify($"Push failed: {ex.Message}", "error"); }
    }

    private async Task OnPushConfirm()
    {
        _pushConfirmOpen = false;
        if (Uc is null) return;
        _busy = true;
        try
        {
            var byEmp = new Dictionary<string, Dictionary<string, double>>();
            foreach (var e in _selectedEmps)
                byEmp[e.EmpNumber.Trim()] = BuildManhour(_dailyByEmp.TryGetValue(e.SystemId, out var r) ? r : []);

            var (updated, skipped) = await _pushDa._03Push(_pushTrn, byEmp, Uc.OpayDb!, Uc.Conn!);
            Notify($"{updated} employee(s) pushed to {_pushTrn}." + (skipped.Count > 0 ? $" Not in the transaction: {string.Join(", ", skipped)}." : string.Empty),
                   skipped.Count > 0 ? "warning" : "success");
        }
        catch (Exception ex) { Notify($"Push failed: {ex.Message}", "error"); }
        _busy = false;
    }

    private static Dictionary<string, double> BuildManhour(List<AttDailyRow> rows)
    {
        var m = new Dictionary<string, double>();
        void Add(string col, double v) { if (v != 0 && col != "") m[col] = (m.TryGetValue(col, out var c) ? c : 0) + v; }

        foreach (var x in rows)
        {
            Add("absent", x.AbsentHrs + x.Tardiness / 60.0 + x.Undertime / 60.0);

            if (x.Kind is "OB" or "LV") { Add("daywrk", x.Credit); continue; }
            if (x.Kind == "AB") continue;

            Add("daywrk", x.Credit);

            foreach (var g in x.Segs)
            {
                // [hours column, OT column, ND column, ND OT column] of the day type of this part of the duty
                string[] c = (g.Holiday, g.IsRd) switch
                {
                    ("LH", false) => ["lh", "lhot", "ndlh", "ndlhot"],
                    ("LH", true)  => ["rdlh", "rdlhot", "ndrdlh", "ndrdlhot"],
                    ("SH", false) => ["sh", "shot", "ndsh", "ndshot"],
                    ("SH", true)  => ["rdsh", "rdshot", "ndrdsh", "ndrdshot"],
                    ("DH", false) => ["dh", "dhot", "", ""],
                    ("DH", true)  => ["rddh", "rddhot", "", ""],
                    (_, true)     => ["rd", "rdot", "ndrd", "ndrdot"],
                    _             => ["", "rot", "nd", "ndot"]
                };
                Add(c[0], g.Hours);
                Add(c[1], g.OtHrs);
                Add(c[2], g.Nd);
                Add(c[3], g.NdOt);
            }
        }
        return m;
    }

