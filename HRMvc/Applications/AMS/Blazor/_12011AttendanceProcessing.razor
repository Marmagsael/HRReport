    {
        if (!int.TryParse(_year, out var y) || !int.TryParse(_month, out var m)) return;
        switch (_period)
        {
            case "01": _start = new DateTime(y, m, 1);  _end = new DateTime(y, m, 15); break;
            case "02": _start = new DateTime(y, m, 16); _end = new DateTime(y, m, DateTime.DaysInMonth(y, m)); break;
        }
    }

