@using HRApiLibrary.Models._00_Main
@using HRApiLibrary.Modules._2306O
@using HRApiLibrary.Modules._12008O
@using HRMvc.Applications._00GeneralComponents
@using System.Text.Json

@implements IAsyncDisposable
@inject IDA_12008O _da
@inject IDA_2306O _emp
@inject IJSRuntime JS

<TelerikRootComponent>

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <TelerikLoaderContainer Visible="@IsCapturing" Text="Capturing..." LoaderType="@LoaderType.ConvergingSpinner" />

    <_00BT_FullW HdrCaption="Enrollment">
        <Details>
            <div class="p-2 d-flex flex-wrap gap-3">

                <div style="width:500px;flex:0 0 500px">
                    <div class="fw-bold mb-1">1. Choose the employee</div>
                    <div class="d-flex gap-2 mb-2">
                        <TelerikTextBox @bind-Value="@Keyword" Placeholder="Employee no. or name" Width="250px" />
                        <TelerikButton OnClick="@Search" ThemeColor="primary">Search</TelerikButton>
                    </div>
                    <TelerikGrid Data="@Results" Height="180px" OnRowClick="@((GridRowClickEventArgs a) => Pick((M2306_EmpInfo)a.Item))">
                        <GridColumns>
                            <GridColumn Field="@nameof(M2306_EmpInfo.EmpNumber)" Title="Emp. No." Width="90px" />
                            <GridColumn Field="@nameof(M2306_EmpInfo.EmpName)" Title="Name" />
                        </GridColumns>
                        <NoDataTemplate><div class="p-2 text-muted">Type a number or a name, then Search. Click a row to choose.</div></NoDataTemplate>
                    </TelerikGrid>

                    <div class="fw-bold mt-3 mb-1">2. Capture the face</div>
                    <div class="mb-2">
                        @if (Selected == null) { <span class="text-muted">No employee chosen.</span> }
                        else { <span><b>@Selected.EmpName</b> (@Selected.EmpNumber) &nbsp; Samples: <b>@SampleCount</b></span> }
                    </div>

                    <style>
                        .en-stage { position:relative; width:480px; height:360px; background:#0b1220; border-radius:16px; overflow:hidden; box-shadow:0 12px 28px -10px rgba(11,18,32,.5); }
                        .en-stage video { width:100%; height:100%; object-fit:cover; transform:scaleX(-1); display:block; }
                        .en-guide { position:absolute; left:50%; top:46%; width:42%; height:68%; transform:translate(-50%,-50%); border-radius:50%;
                                    border:3px dashed rgba(255,255,255,.7); pointer-events:none; box-shadow:0 0 0 9999px rgba(11,18,32,.38); transition:border-color .25s; }
                        .en-guide.ok { border-style:solid; border-color:#34d399; }
                        .en-hint { position:absolute; left:0; right:0; bottom:10px; text-align:center; color:#fff; font-size:.85rem; text-shadow:0 1px 3px rgba(0,0,0,.7); pointer-events:none; }
                    </style>
                    <div class="en-stage">
                        <video id="enrollCam" autoplay muted playsinline></video>
                        <div id="enrollGuide" class="en-guide"></div>
                        <div class="en-hint">Fit your face inside the circle. It turns green when it is right.</div>
                    </div>
                    @if (!string.IsNullOrEmpty(CameraMsg)) { <div class="txt-red small mt-1">@CameraMsg</div> }

                    <div class="d-flex gap-2 mt-2">
                        <TelerikButton OnClick="@Capture" ThemeColor="primary" Enabled="@(Selected != null && PisEmpmasId > 0 && !IsCapturing)">Capture Image</TelerikButton>
                        <TelerikButton OnClick="@AskDelete" Enabled="@(SampleCount > 0)">Delete Face Data</TelerikButton>
                    </div>
                    @if (!string.IsNullOrEmpty(Msg)) { <div class="mt-2 @(MsgOk ? "text-success" : "txt-red")">@Msg</div> }
                    <div class="small text-muted mt-2">Take 3 to 5 samples: look straight, then slightly left and right. Good light, no mask or cap.</div>
                </div>

                <div style="flex:1;min-width:360px;max-width:100%">
                    <div class="fw-bold mb-1">Enrolled employees</div>
                    <TelerikGrid Data="@Enrolled" Sortable="true" Pageable="true" PageSize="15" Height="520px">
                        <GridColumns>
                            <GridColumn Field="@nameof(M12008_Enrolled.EmpNumber)" Title="Emp. No." Width="100px" Sortable="false" />
                            <GridColumn Field="@nameof(M12008_Enrolled.EmpName)" Title="Name" />
                            <GridColumn Field="@nameof(M12008_Enrolled.Samples)" Title="Samples" Width="90px" TextAlign="ColumnTextAlign.Right" />
                            <GridColumn Field="@nameof(M12008_Enrolled.EnrolledAt)" Title="Enrolled" DisplayFormat="{0:MMM dd, yyyy}" Width="120px" />
                        </GridColumns>
                        <NoDataTemplate><div class="p-3 text-muted">No face enrolled yet.</div></NoDataTemplate>
                    </TelerikGrid>
                </div>
            </div>

            <TelerikWindow Modal="true" @bind-Visible="@ShowDelete" Width="420px">
                <WindowActions><WindowAction Name="Close" /></WindowActions>
                <WindowTitle>Delete Face Data</WindowTitle>
                <WindowContent>
                    <div class="p-2">
                        <p>Delete the face data of <b>@Selected?.EmpName</b>?</p>
                        <div class="d-flex gap-2">
                            <TelerikButton OnClick="@DoDelete" ThemeColor="primary">Delete</TelerikButton>
                            <TelerikButton OnClick="@(() => ShowDelete = false)">Cancel</TelerikButton>
                        </div>
                    </div>
                </WindowContent>
            </TelerikWindow>
        </Details>
    </_00BT_FullW>

</TelerikRootComponent>

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    TelerikNotification? NotificationRef;
    string? Keyword, CameraMsg, Msg;
    bool MsgOk, ShowDelete, IsCapturing;
    List<M2306_EmpInfo> Results = new();
    List<M12008_Enrolled> Enrolled = new();
    M2306_EmpInfo? Selected;
    int PisEmpmasId, SampleCount;

    protected override async Task OnInitializedAsync() => await LoadEnrolled();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) CameraMsg = await JS.InvokeAsync<string>("FacePunch.init", "enrollCam");
        if (firstRender && string.IsNullOrEmpty(CameraMsg)) await JS.InvokeVoidAsync("FacePunch.guide", "enrollCam", "enrollGuide");
        if (firstRender && !string.IsNullOrEmpty(CameraMsg)) StateHasChanged();
    }

    async Task LoadEnrolled()
    {
        try { Enrolled = await _da._02Enrolled(Uc.SchemaUserPis!, Uc.OpisDb!, Uc.Conn!); } catch { Enrolled = new(); }
    }

    async Task Search() => Results = await _emp._02EmployeeSearch(Keyword ?? "", Uc.OpisDb!, Uc.Conn!);

    async Task Pick(M2306_EmpInfo e)
    {
        Selected = e; Msg = null;
        var pe = await _emp._02PisEmp(e.EmpNumber!, Uc.SchemaUserPis!, Uc.Conn!);
        PisEmpmasId = pe?.EmpmasId ?? 0;
        if (PisEmpmasId == 0) { Msg = "This employee has no record in the new PIS yet. Open the employee in Employee Entry and save it."; MsgOk = false; SampleCount = 0; return; }
        SampleCount = await _da._02Samples(PisEmpmasId, Uc.SchemaUserPis!, Uc.Conn!);
    }

    async Task Capture()
    {
        Msg = null;
        IsCapturing = true;
        StateHasChanged();
        try
        {
            var json = await JS.InvokeAsync<string>("FacePunch.capture", "enrollCam", "enrollGuide");
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (!root.GetProperty("ok").GetBoolean()) { Msg = root.GetProperty("msg").GetString(); MsgOk = false; return; }

            var descText = root.GetProperty("descriptor").GetRawText();
            var desc = System.Text.Json.JsonSerializer.Deserialize<double[]>(descText)!;

            var others = (await _da._02Templates(Uc.SchemaUserPis!, Uc.Conn!)).Where(t => t.EmpmasId != PisEmpmasId);
            int lookId = 0; double lookD = 9;
            foreach (var t in others)
            {
                var o = System.Text.Json.JsonSerializer.Deserialize<double[]>(t.Descriptor ?? "[]");
                if (o is not { Length: 128 }) continue;
                double s = 0;
                for (int i = 0; i < 128; i++) { var d = desc[i] - o[i]; s += d * d; }
                s = Math.Sqrt(s);
                if (s < lookD) { lookD = s; lookId = t.EmpmasId; }
            }
            if (lookId > 0 && lookD < 0.5)
            {
                var who = await _da._02EmpName(lookId, Uc.SchemaUserPis!, Uc.OpisDb!, Uc.Conn!);
                Msg = $"Not saved. This face looks too much like {who}. Face the light and try again, or check that the right person is in front of the camera.";
                MsgOk = false; return;
            }

            await _da._01Sample(PisEmpmasId, descText, Uc.UserId ?? 0, Uc.SchemaUserPis!, Uc.Conn!);
            SampleCount++;
            Msg = SampleCount < 3 ? $"Sample {SampleCount} saved. Take at least {3 - SampleCount} more." : $"Sample {SampleCount} saved."; MsgOk = true;
            await LoadEnrolled();
        }
        catch (Exception ex)
        {
            Msg = "Unable to capture: " + ex.Message; MsgOk = false;
        }
        finally
        {
            IsCapturing = false;
        }
    }

    void AskDelete() => ShowDelete = true;

    async Task DoDelete()
    {
        await _da._04Delete(PisEmpmasId, Uc.SchemaUserPis!, Uc.Conn!);
        ShowDelete = false; SampleCount = 0;
        Msg = "Face data deleted."; MsgOk = true;
        await LoadEnrolled();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("FacePunch.stop"); } catch { }
    }
}
