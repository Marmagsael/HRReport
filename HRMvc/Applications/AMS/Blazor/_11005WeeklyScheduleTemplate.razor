@code {

    [Parameter] public UserClaimsModel? Uc { get; set; }

    // ── Refs & State ────────────────────────────────────────────────
    private TelerikNotification NotificationRef { get; set; } = new();
    private V11005Model         V               { get; set; } = new();
    private V11002Model         Vars            { get; set; } = new();

    // ── Lifecycle ───────────────────────────────────────────────────
    protected async override Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Uc is null) return;
        try
        {
            V.Hdrs = (await _hdr._02s(Uc.SchemaUserPis!, Uc.Conn!) ?? [])
                     .Where(x => x is not null)
                     .Cast<AttschedweeklyhdrModel>()
                     .ToList();
        }
        catch (Exception ex)
        {
            Notify("error", $"Load failed: {ex.Message}");
        }
    }

    private async Task OnHdrSelected(IEnumerable<AttschedweeklyhdrModel> items)
    {
        V.SelectedHdrs = items;
        V.SelectedHdr  = items.FirstOrDefault();

        if (V.SelectedHdr is null) return;

        try
        {
            var res = await _dtl._02h(V.SelectedHdr.Id, Uc!.SchemaUserPis!, Uc.Conn!);
            V.Dtl = res ?? new AttschedweeklydtlModel { AttschedweeklyhdrId = V.SelectedHdr.Id };
        }
        catch (Exception ex)
        {
            Notify("error", $"Load detail failed: {ex.Message}");
        }
    }

    // ── Header Modal ─────────────────────────────────────────────────
    private void OpenAddHdrModal()
    {
        V.Hdr             = new AttschedweeklyhdrModel();
        V.IsEditMode      = false;
        V.HdrModalTitle   = "Add Schedule";
        V.IsHdrModalVisible = true;
    }

    private void OpenEditHdrModal(AttschedweeklyhdrModel item)
    {
        V.Hdr = new AttschedweeklyhdrModel
        {
            Id          = item.Id,
            Code        = item.Code,
            Description = item.Description
        };
        V.IsEditMode        = true;
        V.HdrModalTitle     = "Edit Schedule";
        V.IsHdrModalVisible = true;
    }

    private void OpenDeleteHdrModal(AttschedweeklyhdrModel item)
    {
        V.Hdr                = item;
        V.IsDeleteModalVisible = true;
    }

    private void CloseHdrModal()    => V.IsHdrModalVisible    = false;
    private void CloseDeleteModal() => V.IsDeleteModalVisible = false;

    // ── Header CRUD ──────────────────────────────────────────────────
    private async Task SaveHdr()
    {
        if (Uc is null) return;
        V.IsBusy = true;

        try
        {
            if (V.IsEditMode)
            {
                var res = await _hdr._03(V.Hdr.Id, V.Hdr, Uc.SchemaUserPis!, Uc.Conn!);
                if (res is not null)
                {
                    var idx = V.Hdrs.FindIndex(x => x.Id == res.Id);
                    if (idx >= 0) V.Hdrs[idx] = res;
                    V.Hdrs = [..V.Hdrs];
                    Notify("success", "Schedule updated.");
                }
            }
            else
            {
                var res = await _hdr._01(V.Hdr, Uc.SchemaUserPis!, Uc.Conn!);
                if (res is not null)
                {
                    V.Hdrs = [..V.Hdrs, res];
                    Notify("success", "Schedule added.");
                }
            }

            CloseHdrModal();
        }
        catch (Exception ex)
        {
            Notify("error", $"Save failed: {ex.Message}");
        }
        finally
        {
            V.IsBusy = false;
        }
    }

    private async Task DeleteHdr()
    {
        if (Uc is null) return;
        V.IsBusy = true;

        try
        {
            await _dtl._04h(V.Hdr.Id, Uc.SchemaUserPis!, Uc.Conn!);
            await _hdr._04(V.Hdr.Id, Uc.SchemaUserPis!, Uc.Conn!);

            V.Hdrs = V.Hdrs.Where(x => x.Id != V.Hdr.Id).ToList();

            if (V.SelectedHdr?.Id == V.Hdr.Id)
            {
                V.SelectedHdr  = null;
                V.SelectedHdrs = [];
                V.Dtl          = new();
            }

            Notify("success", "Schedule deleted.");
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            Notify("error", $"Delete failed: {ex.Message}");
        }
        finally
        {
            V.IsBusy = false;
        }
    }

    // ── Detail Save ──────────────────────────────────────────────────
    private async Task SaveDetail()
    {
        if (Uc is null || V.SelectedHdr is null) return;
        V.IsBusy = true;

        try
        {
            V.Dtl.AttschedweeklyhdrId = V.SelectedHdr.Id;

            AttschedweeklydtlModel? res;

            if (V.Dtl.Id == 0)
                res = await _dtl._01(V.Dtl, Uc.SchemaUserPis!, Uc.Conn!);
            else
                res = await _dtl._03(V.Dtl.Id, V.Dtl, Uc.SchemaUserPis!, Uc.Conn!);

            if (res is not null)
            {
                V.Dtl = res;
                Notify("success", "Schedule saved.");
            }
        }
        catch (Exception ex)
        {
            Notify("error", $"Save failed: {ex.Message}");
        }
        finally
        {
            V.IsBusy = false;
        }
    }

    // ── Notification ─────────────────────────────────────────────────
    private void Notify(string type, string message)
    {
        NotificationRef.Show(new NotificationModel
        {
            Text       = message,
            ThemeColor = type,
            CloseAfter = 4000
        });
    }
