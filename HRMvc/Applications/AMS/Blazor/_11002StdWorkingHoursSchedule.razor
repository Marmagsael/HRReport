@code {

    [Parameter] public UserClaimsModel? Uc { get; set; }

    TelerikNotification      NotificationRef { get; set; } = new();
    V11002Model              V               { get; set; } = new();
    AttscheddefaultModel     defSched        { get; set; } = new();

    protected async override Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        defSched = new();

        var res = await _defsched._02(Uc!.SchemaUserPis, Uc.Conn);
        if (res != null) defSched = res;

        defSched.D1_out = VamsHelper.ComputeOut(defSched.D1_in, defSched.D1_hrslength);
        defSched.D2_out = VamsHelper.ComputeOut(defSched.D2_in, defSched.D2_hrslength);
        defSched.D3_out = VamsHelper.ComputeOut(defSched.D3_in, defSched.D3_hrslength);
        defSched.D4_out = VamsHelper.ComputeOut(defSched.D4_in, defSched.D4_hrslength);
        defSched.D5_out = VamsHelper.ComputeOut(defSched.D5_in, defSched.D5_hrslength);
        defSched.D6_out = VamsHelper.ComputeOut(defSched.D6_in, defSched.D6_hrslength);
        defSched.D7_out = VamsHelper.ComputeOut(defSched.D7_in, defSched.D7_hrslength);
    }

    private async Task UpdateChanges()
    {
        var res = await _defsched._03(defSched, Uc!.SchemaUserPis, Uc.Conn);

        if (res != null)
        {
            defSched        = res;
            defSched.D1_out = VamsHelper.ComputeOut(defSched.D1_in, defSched.D1_hrslength);
            defSched.D2_out = VamsHelper.ComputeOut(defSched.D2_in, defSched.D2_hrslength);
            defSched.D3_out = VamsHelper.ComputeOut(defSched.D3_in, defSched.D3_hrslength);
            defSched.D4_out = VamsHelper.ComputeOut(defSched.D4_in, defSched.D4_hrslength);
            defSched.D5_out = VamsHelper.ComputeOut(defSched.D5_in, defSched.D5_hrslength);
            defSched.D6_out = VamsHelper.ComputeOut(defSched.D6_in, defSched.D6_hrslength);
            defSched.D7_out = VamsHelper.ComputeOut(defSched.D7_in, defSched.D7_hrslength);

            NotificationRef.Show(new NotificationModel
            {
                Text       = "Schedule saved successfully.",
                ThemeColor = ThemeConstants.Notification.ThemeColor.Success,
                CloseAfter = 3000
            });
        }
        else
        {
            NotificationRef.Show(new NotificationModel
            {
                Text       = "Failed to save. Please try again.",
                ThemeColor = ThemeConstants.Notification.ThemeColor.Error,
                CloseAfter = 3000
            });
        }
    }
}
