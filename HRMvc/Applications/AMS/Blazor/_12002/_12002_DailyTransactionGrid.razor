@using HRApiLibrary.Models._11_AMS
@using HRMvc.Applications.AMS.Vars
@using Telerik.Blazor.Components

<TelerikGrid Data="@v!.DailyPunches"
             Height="300px"
             Pageable="true"
             PageSize="20">
    <GridColumns>
        <GridColumn Width="40px">
            <HeaderTemplate>Mrk</HeaderTemplate>
            <Template>
                @{
                    var row = (BioDailyPunchesModel)context;
                }
                <input type="checkbox" @bind="row.IsSelected" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(BioDailyPunchesModel.EmpName)"     Title="Name"         Width="160px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.Date)"        Title="Date"         Width="100px" DisplayFormat="{0:MM/dd/yyyy}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.DutyType)"    Title="Duty Type"    Width="90px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.DayType)"     Title="Day Type"     Width="90px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.InSchedule)"  Title="IN Schedule"  Width="100px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.OutSchedule)" Title="Out Schedule" Width="110px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.PunchIn)"     Title="Punch IN"     Width="140px" DisplayFormat="{0:MM/dd/yyyy HH:mm}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.PunchOut)"    Title="Punch Out"    Width="140px" DisplayFormat="{0:MM/dd/yyyy HH:mm}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.DayWork)"     Title="Day Work"     Width="90px"  DisplayFormat="{0:N2}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.Overtime)"    Title="Overtime"     Width="90px"  DisplayFormat="{0:N2}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.DutyStatus)"  Title="Duty Status"  Width="100px" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.ND)"          Title="ND"           Width="70px"  DisplayFormat="{0:N2}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.Late)"        Title="Late"         Width="70px"  DisplayFormat="{0:N2}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.Undertime)"   Title="Undertime"    Width="90px"  DisplayFormat="{0:N2}" />
        <GridColumn Field="@nameof(BioDailyPunchesModel.Absent)"      Title="Absent"       Width="80px"  DisplayFormat="{0:N2}" />
    </GridColumns>
</TelerikGrid>

@code {
    [CascadingParameter] public V12002Model?  v             { get; set; }
    [CascadingParameter] public Func<Task>?   NotifyChanged { get; set; }
}
