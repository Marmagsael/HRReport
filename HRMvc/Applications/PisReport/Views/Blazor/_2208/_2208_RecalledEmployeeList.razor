@using HRMvc.Applications.PisReport.Vars

<div class="p-0">
    <div class="card-header d-flex gap-2 mb-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                type="button" tabindex="6">
            Print
        </button>
    </div>



    <div class="p-2">

        <div class="card p-0 mb-2">
            <div class="card-header txt-fcolor">
                ENTER COVERAGE DATE
            </div>

            <div class="py-2 px-3 d-flex flex-column flex-md-row gap-2">
                <div class="col-12 col-md-4">

                    @* --- START --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Start</label>

                        <div class="col-12 col-md-7 ">
                            <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                               Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                               FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                               ReadOnly
                                               Enabled=false />
                        </div>
                    </div>

                    @* --- END --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">End</label>

                        <div class="col-12 col-md-7">
                            <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                               Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                               FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                               ReadOnly
                                               Enabled=false />
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch grid-container">

        
                <div class="h-100 ">
                    <TelerikGrid TItem="OClientModel"
                                 SelectionMode="@GridSelectionMode.Single"
                                 Navigable="true"
                                 Pageable="true"
                                 @bind-PageSize="@PageSize"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Height="100%">

                        <GridSettings>
                            <GridPagerSettings PageSizes="@PageSizes" />
                        </GridSettings>

                        <GridColumns>
                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Emp. No."
                                        Width="80px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Name"
                                        Width="200px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="RTU No."
                                        Width="100px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Date"
                                        Width="80px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Reason"
                                        Width="200px" />
                        </GridColumns>

                        <NoDataTemplate>
                            <div class="text-center text-secondary p-4">
                                No records found.
                            </div>
                        </NoDataTemplate>

                    </TelerikGrid>
                </div>

        </div>
    </div>
</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        V.ModalCaption = "Inventory Entry";
        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

}

