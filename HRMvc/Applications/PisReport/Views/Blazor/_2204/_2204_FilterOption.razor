@using HRMvc.Applications.PisReport.Vars

<div class="p-0">
    <div class="card-header d-flex gap-2 mb-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue"
                type="button" tabindex="6">
            Print
        </button>
    </div>



    <div class="p-2">

        <div class="card p-0 mb-2">
            <div class="card-header txt-fcolor">
               Details
            </div>

            <div class="py-2 px-3">
                <div class=" d-flex flex-column">

                    @* --- TO --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">To</label>

                        <div class="col-12 col-md-7">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2">
                            </TelerikTextBox>
                        </div>
                    </div>


                    @* --- SUBJECT --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-100p">Subject</label>

                        <div class="col-12 col-md-7">
                            <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2">
                            </TelerikTextBox>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row gap-2">

                        @* --- DATE --- *@
                        <div class="col-12 col-md-4">
                            <div class="d-flex flex-column flex-md-row mb-2">
                                <label class=" fw-normal w-100p">
                                    Date
                                </label>
                                <div class="col-12 col-md-7">
                                    <TelerikDatePicker @bind-Value="@V.OEmpmas.MovPrepDate"
                                                       Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                       FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                       ReadOnly="true"
                                                       Enabled="false" />
                                </div>
                            </div>
                        </div>

                        @* --- FOR THE MONTH OF --- *@
                        <div class="col-12 col-md-4">
                            <div class="d-flex flex-column flex-md-row mb-2">
                                <label class=" fw-normal w-200p">
                                    For the Month of
                                </label>
                                <div class="col-12 col-md-7">
                                    <TelerikDropDownList Data="@V.OEmployees"
                                                         TextField="Empmas"
                                                         ValueField="Empnumber"
                                                         @bind-Value="@V.OEmpmas.EmpNumber"
                                                         DefaultText="Select an item..."
                                                         Filterable="true"
                                                         Width="100%"
                                                         TabIndex="4">
                                        <DropDownListSettings>
                                            <DropDownListPopupSettings Height="auto" />
                                        </DropDownListSettings>
                                    </TelerikDropDownList>
                                </div>
                            </div>
                        </div>

                        @* --- YEAR --- *@
                        <div class="col-12 col-md-4 ms-2">
                            <div class="d-flex flex-column flex-md-row mb-2">
                                <label class=" fw-normal w-100p">
                                    Year
                                </label>
                                <div class="col-12 col-md-7">
                                    <TelerikDropDownList Data="@V.OEmployees"
                                                         TextField="Empmas"
                                                         ValueField="Empnumber"
                                                         @bind-Value="@V.OEmpmas.EmpNumber"
                                                         DefaultText="Select an item..."
                                                         Filterable="true"
                                                         Width="100%"
                                                         TabIndex="5">
                                        <DropDownListSettings>
                                            <DropDownListPopupSettings Height="auto" />
                                        </DropDownListSettings>
                                    </TelerikDropDownList>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            
            </div>
        </div>

    </div>
</div>
@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OSecliclogsModel> LicVerifGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
