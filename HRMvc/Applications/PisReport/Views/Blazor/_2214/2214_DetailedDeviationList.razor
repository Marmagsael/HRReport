@using HRMvc.Applications.PisReport.Vars

<div class="p-2">

    <div class="p-0 mb-2">
        <div class="card-header txt-fcolor border border-1">
            Deviation Record
        </div>

            <TelerikGrid TItem="R2202Model"
                         Data="V.RepDtls"
                         Navigable="true"
                         Pageable="true"
                         @bind-PageSize="@PageSize"
                         Sortable="true"
                         FilterMode="@GridFilterMode.FilterMenu"
                         Height="100%">

                <GridSettings>
                    <GridPagerSettings PageSizes="@PageSizes" />
                </GridSettings>



                <GridColumns>

                    @* --- Control No. --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Control No."
                                Width="80px" />

                    @* --- Date Prepared --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Date Prepared"
                                Width="80px" />


                    @* --- Client Name --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Client"
                                Width="200px" />


                    @* --- Client Name --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Violation"
                                Width="100px" />


                    @* --- Date Cpmmitted --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Date Committed"
                                Width="80px" />


                    @* --- Penalty --- *@
                    <GridColumn Field="@nameof(R2202Model.ClName)"
                                Title="Penalty"
                                Width="100px" />

                </GridColumns>

                <NoDataTemplate>
                    <div class="text-center text-secondary p-4">
                        No records found.
                    </div>
                </NoDataTemplate>

            </TelerikGrid>
        </div>

    </div>

@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2202Model V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OSecliclogsModel> LicVerifGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
