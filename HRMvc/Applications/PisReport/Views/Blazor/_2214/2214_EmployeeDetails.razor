@using HRMvc.Applications.PisReport.Vars
    
<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="1">
            Search
        </button>

        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="6">
            Print
        </button>

    </div>
</div>



<div class="p-2">
    <div class="card p-0 mb-2">


        <div class="card-header txt-fcolor">
            Current Employee Details
        </div>

        <div class="py-2 px-3">
            @* --- Employee No. --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Emp. No.</label>

                <div class="col-12 col-md-7 col-lg-3">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2">

                    </TelerikTextBox>
                </div>
            </div>


            @* --- Employee Name --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Name</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    ReadOnly
                                    Enabled=false>

                    </TelerikTextBox>
                </div>
            </div>

            @* --- Status --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Status</label>

                <div class="col-12 col-md-7 col-lg-3">
                    <TelerikTextBox @bind-Value="@V.OEmpmas.ControlNumber"
                                    Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                    FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                    TabIndex="2"
                                    ReadOnly
                                    Enabled=false>

                    </TelerikTextBox>
                </div>
            </div>


            @* --- Client --- *@
            <div class="d-flex flex-column flex-md-row mb-2">
                <label class="fw-normal w-180p">Client</label>

                <div class="col-12 col-md-7 col-lg-5">
                    <TelerikTextArea @bind-Value="@V.OEmpmas.Reason"
                                     Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                     FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                     MaxLength="150"
                                     Width="100%"
                                     TabIndex="4"
                                     ReadOnly
                                     Enabled=false />
                </div>
            </div>

        </div>


    </div>

</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



}
