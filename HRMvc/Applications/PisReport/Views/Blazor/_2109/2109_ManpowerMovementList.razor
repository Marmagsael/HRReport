@using HRMvc.Applications.PisReport.Vars

<div class="p-2">
    <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch grid-container">

        <!-- Left column -->
        <div class="col-12 col-md-4 d-flex flex-column">
            <div class="flex-grow-1 grid-wrapper">
                <TelerikGrid TItem="OClientModel"
                                SelectionMode="@GridSelectionMode.Single"
                                Navigable="true"
                                Sortable="true"
                                FilterMode="@GridFilterMode.FilterMenu"
                                Height="100%">

                    <GridSettings>
                        <GridPagerSettings PageSizes="@PageSizes" />
                    </GridSettings>

                    <GridColumns>
                        <GridCheckboxColumn SelectAll="false" Width="10px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Status"
                                    Width="80px" />
                    </GridColumns>

                    <NoDataTemplate>
                        <div class="text-center text-secondary p-4">
                            No records found.
                        </div>
                    </NoDataTemplate>
                </TelerikGrid>
            </div>

        </div>

        <!-- Right column -->
        <div class="col-12 col-md-8 d-flex flex-column">
            <div class="h-100 grid-wrapper">
                <TelerikGrid TItem="OClientModel"
                             SelectionMode="@GridSelectionMode.Single"
                             Navigable="true"
                             Pageable="true"
                             @bind-PageSize="@PageSize"
                             Sortable="true"
                             FilterMode="@GridFilterMode.FilterMenu"
                             Height="100%">

                    <GridSettings>
                        <GridPagerSettings PageSizes="@PageSizes" />
                    </GridSettings>

                    <GridColumns>
                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="#"
                                    Width="50px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Last Name"
                                    Width="80px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="First Name"
                                    Width="80px" />


                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Mid Name"
                                    Width="80px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="OP No."
                                    Width="80px" />


                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="SBR No."
                                    Width="80px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Expiry Date"
                                    Width="80px" />
                    </GridColumns>

                    <NoDataTemplate>
                        <div class="text-center text-secondary p-4">
                            No records found.
                        </div>
                    </NoDataTemplate>

                </TelerikGrid>
            </div>
        </div>

    </div>


</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OSecliclogsModel> LicVerifGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
