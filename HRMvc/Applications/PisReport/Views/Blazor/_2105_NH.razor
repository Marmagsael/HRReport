@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2105


@inject NotificationService _NotificationService;

<RadzenNotification />


<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        @if ((v ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_2105_Report Rv="rv" V="@v" ChildAction="ChildActionCatcher" />
        }


        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2">
                    @*--- Period ------------------------------------------------*@
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>

        @*--- Client List ------------------------------------------------*@
        <div class="w-100"> <_00TStatusList Empstats="@rv.Empstats" ChildAction="ChildActionCatcher" /> </div>
    </Details>
</_00BT_FullW>



@inject IOPisReportDataAccess _pisRep;
@inject IOEmpstatDataAccess _empstat;

@code {
    [Parameter] public UserClaimsModel  Uc   { get; set; }  = new();
                        V00_RepVars     rv                  = new();
                  List<V2105Model>      v                   = [];

    List<string?>? statuses => rv.Empstats.Where(e => e.IsSelectedB).Select(e => e.Code).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        rv.Empstats = [];
        rv.RefreshToken = 21050000;
        rv.MCaption     = "Newly Hired For The Month";

        @* --- Employee Status  ------------------------------------------- *@
        List<OEmpstatModel?>? empstats = await _empstat._02s(Uc.OpisDb!, Uc.Conn!) ?? [];
        if (empstats.Any()) rv.Empstats = empstats!;
        rv.Empstats?.Where(e => e != null).ToList().ForEach(e => e.IsSelectedB = (e.Code == "_"));

        @* --- Report Details -------------------------------------------- *@
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        rv.ReportParams = [];

        rv.ReportParams["CoName"]       = "-";
        rv.ReportParams["CoAddress"]    = "-";

        if (res.Count > 0)
        {
            var r = res.FirstOrDefault();
            rv.ReportParams["CoName"]       = r.CoName ?? "";
            rv.ReportParams["CoAddress"]    = r.CoAdd ?? "";
        }

        rv.ReportParams["ReportTitle"]  = "Newly Hired Employees";
        rv.ReportParams["RunDate"]      = DateTime.Now;
    }


    void ChildActionCatcher() { }

    async Task FetchData()
    {
        v = [];
        rv.ShowReport = false;
        rv.ShowModal = false;

        if (!(statuses ?? []).Any())
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Warning",
                Detail = $"Please select at least one employee status to proceed.",
                Duration = 4000
            });
            return;
        }

        try
        {
            rv.Isloaded = true;
            string fld  = "datehired";
            int mo      = Convert.ToInt32(rv.Month);

            var res = await _pisRep._02Empmas_ByMonth_And_Year(fld, statuses, mo, rv.Year, Uc.OpisDb!, Uc.Conn!);
            if (res.Any())
            {
                foreach (var r in res)
                {
                    V2105Model rec = new()
                    {
                        EmpNumber = r.EmpNumber,
                        EmpName = r.EmpName,
                        DateHired = r.DateHired,
                        PositionName = r.PositionName,
                        SecLicense = r.SecLicense,
                        LicExpire = r.Licexpire,
                        ClName = r.ClName,
                    };
                    v.Add(rec);
                }
            }
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!(v ?? []).Any())
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Info",
                Detail = $"No data found for this period.",
                Duration = 4000
            });
            return;
        }

        if (!rv.Isloaded) rv.ShowModal = true;
    }



    void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }
}