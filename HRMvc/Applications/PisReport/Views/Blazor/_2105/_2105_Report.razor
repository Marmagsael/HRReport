@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using System.Globalization
@inject NotificationService _NotificationService;

<RadzenNotification />


<_02BTModal MCaption="@Rv.MCaption" ShowModal="Rv.ShowModal" ChildAction="CloseReportModal">
    <Details>

        @if (Rv.ShowReport)
        {
            <IframeReportRenderer DataSource="@Rv.ReportData"
                                  ReportRelativePath="@Rv.RelativePath"
                                  OutputFormat="@Rv.SelectedFormat"
                                  Parameters="@Rv.ReportParams"
                                  AutoGenerate="@(Rv.ReportData?.Any() == true)"
                                  RefreshToken="@Rv.RefreshToken" />
        }
        else
        {


            <div class="">
                <div class="sticky-top bg-white ">
                    <div class=" border-bottom">
                        <div class="p-0">
                            <div class="card-header">
                                <div class="d-flex gap-2">
                                    <_01ReportFormat Rv="@Rv" ChildAction="ValueChanged" />
                                    @*--- Fetch Button ------------------------------------------------*@
                                    <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 p-2 border-bottom fw-bold  bg-lightgray ">
                        <div class="w-75p ">    No</div>
                        <div class="w-150p">    Emp. No.</div>
                        <div class="w-250p">    Emp. Name</div>
                        <div class="w-150p">    Date Hired</div>
                        <div class="w-200p">    Position</div>
                        <div class="w-200p">    License No.</div>
                        <div class="w-150p">    Exp. Date</div>
                        <div class="w-250p">    Deployment</div>
                    </div>
                </div>

                @{
                    int ctr = 0; int row = 0; string stat = string.Empty;
                }
                @foreach (var v in V)
                {
                    ctr++;
                    row++;

                    <div class="d-flex gap-2 border-bottom px-2 py-1 @(row % 2 == 0 ? "bg-light" : "") " ">
                        <div class="w-75p ">    @ctr</div>
                        <div class="w-150p">    @v.EmpNumber</div>
                        <div class="w-250p">    @v.EmpName</div>
                        <div class="w-150p">    @v.DateHired?.ToString("MM/dd/yyyy")</div>
                        <div class="w-200p">    @v.PositionName</div>
                        <div class="w-200p">    @v.SecLicense</div>
                        <div class="w-150p">    @v.LicExpire?.ToString("MM/dd/yyyy")</div>
                        <div class="w-250p">    @v.ClName</div>
                    </div>

                }
            </div>

        }

    </Details>
</_02BTModal>





@inject IOCoinfoDataAccess          _coinfo;



@code {
    [Parameter] public V00_RepVars              Rv  { get; set; } = new();
    [Parameter] public List<V2105Model>         V   { get; set; } = new();
    [Parameter] public EventCallback<object>    ChildAction { get; set; }

    private async Task CreateReport()
    {
        Rv.RelativePath = "";
        Rv.ReportData = V;

        int monthNumber = Convert.ToInt32(Rv.Month);
        string monthName = new DateTime(1, monthNumber, 1) .ToString("MMMM", CultureInfo.InvariantCulture);

        Rv.ReportParams["MonthYearCoverage"] =$"For the Month of {monthName} {Rv.Year}";

        Rv.RelativePath = Rv.SelectedFormat == "XLSX"
            ? "Reports/_02HR/K_2105_NH.trdp"
            : "Reports/_02HR/K_2105_NH.trdp";

        Rv.ShowReport = true;

        if (Rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(2000);
            Rv.ShowReport = false;
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"The Excel file is ready. Please check the download in your browser.",
                Duration = 4000
            });
        }
    }

    private async Task CloseReportModal(bool ans)
    {
        if (Rv.ShowReport) Rv.ShowReport = ans;
        else Rv.ShowModal = ans;

        await ChildAction.InvokeAsync(ans);
    }

    private async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFormat);
    }


    void ShowNotification(NotificationMessage message)
    {
        _NotificationService.Notify(message);
    }
}