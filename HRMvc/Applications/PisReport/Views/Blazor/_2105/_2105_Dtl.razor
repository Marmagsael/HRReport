@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using System.Globalization
@inject NotificationService _NotificationService;


<div class="card mx-3 my-2 d-flex flex-column" style="height:81vh;">
    <!-- HEADER -->
    <div class="sticky-header bg-white ">
        <div class="d-flex gap-2 p-2 border-bottom fw-bold  bg-lightgray ">
            <div class="w-60p text-end pe-2">    No.</div>
            <div class="w-150p">    Emp. No.</div>
            <div class="w-250p">    Emp. Name
                &nbsp; <_01SortByField ColName="EmpName" Rv="@Rv" ChildAction="SortBy" />
            </div>
            <div class="w-150p">    Date Hired
                &nbsp; <_01SortByField ColName="DateHired" Rv="@Rv" ChildAction="SortBy" />
            </div>
            <div class="w-200p">    Position</div>
            <div class="w-250p">    Curr. Deployment</div>
            <div class="w-150p">    Curr. Status</div>

        </div>
    </div>

    <!-- BODY -->
    <div class="flex-grow-1 overflow-auto">
    @{
        int ctr = 0; int row = 0; string stat = string.Empty;
    }
   
    @if(V.RepDtls.Count() > 0)
    {
        @foreach (var v in V.RepDtls)
        {
            ctr++;
            row++;

            <div class="d-flex gap-2 border-bottom px-2 py-1 @(row % 2 == 0 ? "bg-light" : "") " >
                <div class="w-60p text-end pe-2">    @ctr.</div>
                <div class="w-150p">    @v.EmpNumber</div>
                <div class="w-250p">    @v.EmpName</div>
                <div class="w-150p">    @v.DateHired?.ToString("MM/dd/yyyy")</div>
                <div class="w-200p">    @v.PositionName</div>
                <div class="w-250p">    @v.ClName</div>
                <div class="w-150p">
                    @if (v.EmpStatus.Trim() == "Active") {<RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" />}
                    else @v.EmpStatus
                </div>

            </div>

        }
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center w-100 h-100" style="min-height: 30vh;">
            <div class="text-muted text-center">
                No data to display.
            </div>
        </div>
    }

    </div>
</div>


@code {
    [Parameter] public V2105Model               V   { get; set; } = new();
    [Parameter] public V00_RepVars              Rv  { get; set; } = new();
    [Parameter] public EventCallback<object>    ChildAction { get; set; } = new();

    private async Task SortBy()
    {
        if (!V.RepDtls.Any()) { return; }
        V.Action = "SortBy";
        await ChildAction.InvokeAsync(V);
    }
}