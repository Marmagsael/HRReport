@inject ISettingsDataAccess _settings;

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V00_RepVars rv = new();

    protected override async Task OnInitializedAsync()
    {
        InitialiazeReport();
        await LoadInitialData();
    }


    private void InitialiazeReport()
    {
        rv.RefreshToken = 22020000;
        rv.MCaption = "Application Form";
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "Personal Data Sheet",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task LoadInitialData()
    {
        await  LoadCompanyInfo();
    }

    private async Task LoadCompanyInfo()
    {
        var res = await _settings._02(1, Uc.SchemaUserPay, Uc.Conn);
       
        if(res == null) return;
        rv.ReportParams["CoName"] = res.CoFullName ?? "";
        rv.ReportParams["CoAddress"] = res.CoAddress ?? "";
    }
}


