@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using System.Globalization

@inject NotificationService _NotificationService;

<RadzenNotification />


<_02BTModal MCaption="@Rv.MCaption" ShowModal="Rv.ShowModal" ChildAction="CloseReportModal">
    <Details>

        @if (Rv.ShowReport)
        {
            <IframeReportRenderer DataSource="@Rv.ReportData"
                                  ReportRelativePath="@Rv.RelativePath"
                                  OutputFormat="@Rv.SelectedFormat"
                                  Parameters="@Rv.ReportParams"
                                  AutoGenerate="@(Rv.ReportData?.Any() == true)"
                                  RefreshToken="@Rv.RefreshToken" />
        }
        else
        {


            <div class="card m-2">
                <div class="sticky-top bg-white ">
                    <div class=" border-bottom">
                        <div class="p-0">
                            <div class="card-header">
                                <div class="d-flex gap-2">
                                    <_01ReportFormat Rv="@Rv" ChildAction="ValueChanged" />
                                    @*--- Fetch Button ------------------------------------------------*@
                                    <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 py-2 border-bottom fw-bold  bg-lightgray ">
                        <div class="w-60p text-end pe-2">     No.</div>
                        <div class="w-100p">    Emp. No.</div>
                        <div class="w-250p">    Emp. Name  &nbsp; <_01SortByField ColName="EmpName" Rv="@Rv" ChildAction="SortBy" /></div>
                        <div class="w-250p">    Insurance Company</div>
                        <div class="w-150p">    Policy No.</div>
                        <div class="w-120p text-end pe-2">    Face Value </div>
                        <div class="w-100p  text-end pe-2">    Premium</div>
                        <div class="w-120p text-center">    Exp. Date  &nbsp; <_01SortByField ColName="InsExpire" Rv="@Rv" ChildAction="SortBy" /></div>
                        <div class="w-120p text-center">    Date of Birth</div>
                        <div class="w-120p text-center">    Date Hired</div>
                        <div class="w-150p"> Curr. Status</div>
                    </div>
                </div>


                @if ((V.RepDtls ?? []).Any())
                {
                    int? ctr = 0;  string? stat = string.Empty;

                    @foreach (var v in V.RepDtls)
                    {
                        ctr++;
                        bool isEvenRow = ctr % 2 == 0;

                        <div class="d-flex gap-2 border-bottom py-1 @(isEvenRow ? "bg-light" : "")">
                            <div class="w-60p text-end pe-2">@ctr.</div>
                            <div class="w-100p">@v.EmpNumber</div>
                            <div class="w-250p">@v.EmpName</div>
                            <div class="w-250p">@v.Insurance</div>
                            <div class="w-150p">@v.PolicyNo</div>
                            <div class="w-120p text-end pe-2">@v.FaceValue?.ToString("N2")</div>
                            <div class="w-100p text-end pe-2">@v.Premium?.ToString("N2")</div>
                            <div class="w-120p text-center @(GetCssClass(v.InsExpire))">@FormatDate(v.InsExpire)</div>
                            <div class="w-120p text-center">@FormatDate(v.EmpBirth)</div>
                            <div class="w-120p text-center">@FormatDate(v.DateHired)</div>
                            <div class="w-150p">
                                @if (v.EmpStatus?.Trim() == "Active")
                                {
                                    <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" />
                                }
                                else
                                {
                                    @v.EmpStatus
                                }
                            </div>
                        </div>
                    }
                }


            </div>

        }

    </Details>
</_02BTModal>

@inject IOCoinfoDataAccess _coinfo;
@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public V2110Model  V  { get; set; } = new();
    [Parameter] public EventCallback<object> ChildAction { get; set; }

    private static readonly DateTime PlaceholderDate = new DateTime(1902, 1, 1);
    private string? FormatDate(DateTime? date)  => date.HasValue && date.Value > PlaceholderDate ? date.Value.ToString("MM/dd/yyyy") : "";

    private string? GetCssClass(DateTime? date)
    {
        if (!date.HasValue || date.Value == PlaceholderDate) return "";
        if (DateTime.Today > date.Value)return "text-danger"; //  Expired
        if (DateTime.Today >= date.Value.AddMonths(-1) && DateTime.Today <= date.Value) return "text-primary"; //  Expiring within 1 month

        return "";
    }

    private async Task SortBy()
    {
        if (!V.RepDtls.Any()) { return; }
        V.Action = "SortBy";
        await ChildAction.InvokeAsync(V);
    }

    private async Task CreateReport()
    {
        Rv.RelativePath = "";
        Rv.ReportData = V.RepDtls;

        int? monthNumber = Convert.ToInt32(Rv.Month);
        string? monthName = new DateTime(1, monthNumber??0, 1).ToString("MMMM", CultureInfo.InvariantCulture);

        Rv.RelativePath = "Reports/_02HR/K_2110_IP.trdp";

        Rv.ShowReport = true;

        if (Rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(1000);
            Rv.ShowReport = false;
            Notify(NotificationSeverity.Success, "Success", "The Excel file is ready. Please check the download in your browser.");
        }
    }


    private async Task CloseReportModal(bool ans)
    {
        if (Rv.ShowReport) Rv.ShowReport = ans;
        else Rv.ShowModal = ans;

        await ChildAction.InvokeAsync(ans);
    }

    private async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFormat);
    }


    void Notify(NotificationSeverity severity, string? summary, string? detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }


}