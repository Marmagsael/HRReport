
<div class="bg-lightgray ms-1 p-2 pb-0 bordered-bottom bordered-left  bordered-right mt-1">
    <div class="d-flex p-0 fw-bold ">
        <div class=" w-35p text-center bordered-right ">
            <div class="w-25p h-35p card p-1 mb-cbtn" @onclick="@(() => Mark(true))">
                <i class="fa-solid fa-check-double"></i>
            </div>
        </div>
        <div class="p-2 flex-fill">Status </div>
        <div class=" w-25p h-35p card p-1 mb-cbtn text-danger " @onclick="@(() => Mark(false))">
            <i class="fa-solid fa-xmark"></i>
        </div>
    </div>
</div>

<div class="vh-max vh65 ms-1 p-2 bordered-bottom bordered-left  bordered-right ">
    @{
        int ctr = 0;
    }
    @foreach (var c in Empstats)
    {
        ctr++;
        <div class="d-flex p-0 @(ctr % 2 == 0 ? " bg-lightgray " : "")">
            <div @onclick="@(() => c.IsSelectedB = !c.IsSelectedB)" class="p-2 w-35p text-center bordered-right " style="cursor:pointer;">
                @if (c.IsSelected == 1)
                {
                    <i class="fa-solid fa-check"></i>
                }
                else
                {

                    <i class="fa-regular fa-square"></i>
                }
            </div>
            <div class="p-2 flex-fill">
                @c.Name
            </div>
        </div>
    }
</div>



@code {
    [Parameter] public List<OEmpstatModel> Empstats { get; set; } = [];
    [Parameter] public EventCallback ChildAction { get; set; }

    async Task Mark(bool val)
    {
        foreach (var c in Empstats) { c.IsSelectedB = val; }
        await ChildAction.InvokeAsync();
    }

}