@using HRMvc.Applications.PisReport.Vars
<div class="">
    @* --- Header ---------------------- *@
    <div class=" d-flex p-2 border-bottom fw-bold ">
        <div class="w-75p">No</div>
        <div class="w-150p">Emp. No.</div>
        <div class="w-250p">Emp. Name</div>
        <div class="w-150p">Date Hired</div>
        <div class="w-150p">Reg Date</div>
        <div class="w-200p">Status</div>
        <div class="w-250p">Current Deployment</div>
    </div>
    @* --- Details ---------------------- *@
    <div class="vh-max vh75">
        @{
            int? row = 0; int? ctr = 1;
            if (V.RepDtls.Count() > 0)
            {
                foreach (var v in V.RepDtls)
                {
                    <div class=" d-flex p-2 border-bottom @(row % 2 == 0 ? "bg-light" : "") ">
                        <div class="w-75p">     @ctr</div>
                        <div class="w-150p">    @v.EmpNumber</div>
                        <div class="w-250p">    @v.EmpName</div>
                        <div class="w-150p">    @v.DateHired?.ToString("MM/dd/yyyy")</div>
                        <div class="w-200p">    @v.regref?.ToString("MM/dd/yyyy")</div>
                        <div class="w-200p">
                            @if (v.StatusName.Trim() == "Active")
                            {
                                <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" />
                            }
                            else @v.StatusName
            
                        </div>
                        <div class="w-250p">    @v.ClName</div>
                    </div>
                    row++; ctr++;
                }
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center w-100 h-100 pt-5 ">
                    No records to display.
                </div>
            }
        }
    </div>
</div>
@code {
    [Parameter] public V2107Model V { get; set; } = new();
}