@using HRMvc.Applications.PisReport.Vars
<div>
    @* --- Header ---------------------- *@
    <div class=" d-flex p-2 border-bottom fw-bold ">
        <div class="w-100p">No</div>
        <div class="w-100p">Emp. No.</div>
        <div class="w-250p">Emp. Name</div>
        <div class="w-250p">Deployment</div>
    </div>
    
    @* --- Details ---------------------- *@
    @{int ctr = 1; }
    @foreach(var v in R2103s) {
        <div class=" d-flex p-2 border-bottom">
            <div class="w-100p"> @ctr </div>
            <div class="w-100p">@v.EmpNumber </div>
            <div class="w-250p">@v.EmpName </div>
            <div class="w-350p">@v.ClName </div>
        </div>
        ctr++; 
    }


</div>


@code {

    [Parameter] public List<R2103Model> R2103s { get; set; } = []; 

}