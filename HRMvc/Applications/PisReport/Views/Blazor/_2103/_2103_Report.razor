@using HRMvc.Applications.PisReport.Vars



<_02BTModal MCaption="Data Report" ShowModal="Rv.ShowModal" ChildAction="CloseReportModal">
    <Details>
        <div class="p-2 border-bottom "> 
            <div class="mb-cbtn mb-cbtn-blue w-150p card p-1 "> 
                Show Report 
            </div>
        </div>

        <div class="d-flex gap-2">
            <div class=" w-100p">No</div>
            <div class=" w-100p">Emp. No.</div>
            <div class=" w-100p">Name</div>
            <div class=" w-100p">Deployment</div>
        </div>

        @{int ctr = 0; }
        @foreach(var rec in V2103.Empmass){
            ctr++; 
            <div class="d-flex gap-2">
                <div class=" w-100p">@ctr</div>
                <div class=" w-100p">@rec.EmpNumber </div>
                <div class=" w-100p">@rec.EmpName   </div>
                <div class=" w-100p">@rec.ClName    </div>
            </div>
            
        } 



    </Details>
</_02BTModal>









@code {
    [Parameter] public V00_RepVars          Rv              { get; set; } = new(); 
    [Parameter] public V2103Model           V2103           { get; set; } = new(); 
    [Parameter] public EventCallback<bool>  ChildAction     { get; set; } 
    
    
    async Task CloseReportModal(bool ans) {
        Rv.ShowModal = ans; 
        await ChildAction.InvokeAsync(ans); 

    }
}