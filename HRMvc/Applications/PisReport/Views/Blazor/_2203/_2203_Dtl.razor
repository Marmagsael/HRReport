@using HRMvc.Applications.PisReport.Vars

<div class="p-3 w-100 overflow-auto _2203">
    <div class="d-flex gap bordered-bottom p-2 fw-bold table-row flex-nowrap">
        <div class="col-ctr     pe-2 "> No. </div>
        <div class="col-empno   pe-2 ">Emp. No.</div>
        <div class="col-empname pe-2 ">Emp. Name</div>
        <div class="col-date    pe-2  text-center">Brgy</div>
        <div class="col-date    pe-2  text-center">Court</div>
        <div class="col-date    pe-2  text-center">Drug</div>
        <div class="col-date    pe-2  text-center">NBI</div>
        <div class="col-date    pe-2  text-center">Neuro</div>
        <div class="col-date    pe-2  text-center">PNP</div>
        <div class="col-date    pe-2  text-center">Police</div>
        <div class="col-date    pe-2  text-center">Medical</div>
    </div>


    @{ int row = 0; }
    @{int ctr = 1; }
    @foreach(var v in V2203){

        <div class="d-flex gap px-2 py-1 table-row flex-nowrap @(row % 2 == 0 ? "bg-light" : "") ">
            <div class="col-ctr     pe-2 "> @ctr </div>
            <div class="col-empno   pe-2 ">@v.EmpNumber</div>
            <div class="col-empname pe-2 ">@v.EmpName</div>
            <div class="col-date    pe-2 ">@(v.Exp_Brgy?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Court?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Drug?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Nbi?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Neuro?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Pnp?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.Exp_Police?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="col-date    pe-2 ">@(v.ExpMed?.ToString("MM/dd/yyyy") ?? "")</div>
        </div>

        row++; ctr++; 
    }

</div>





@code {
    [Parameter] public List<V2203Model> V2203{ get; set; } = []; 
}

<style>
    ._2203 .table-row   {min-width: 1400px;}
    ._2203 .col-ctr     { min-width: 70px; }
    ._2203 .col-empno   { min-width: 100px; }
    ._2203 .col-empname { min-width: 300px; }
    ._2203 .col-date    { min-width: 115px; }

    
</style>
