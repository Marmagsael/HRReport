@using HRMvc.Applications.PisReport.Vars

<div class="p-3 w-100 overflow-auto">
    <div class="d-flex gap bordered-bottom p-2 fw-bold">
        <div class="w-100p pe-2 text-nowrap">No.</div>
        <div class="w-175p pe-2 text-nowrap">Emp. No</div>
        <div class="w-775p pe-2 text-nowrap">Emp. Name</div>
        <div class="w-375p pe-2 text-nowrap">BRGY</div>
        <div class="w-375p pe-2 text-nowrap">Court</div>
        <div class="w-375p pe-2 text-nowrap">Drug Test</div>
        <div class="w-375p pe-2 text-nowrap">NBI</div>
        <div class="w-375p pe-2 text-nowrap">Neuro Test</div>
        <div class="w-375p pe-2 text-nowrap">PNP</div>
        <div class="w-375p pe-2 text-nowrap">Police</div>
        <div class="w-375p pe-2 text-nowrap">Medical</div>
    </div>


    @{ int row = 0; }
    @{int ctr = 1; }
    @foreach(var v in V2203){

        <div class="d-flex gap px-2 py-1 @(row % 2 == 0 ? "bg-light" : "")">
            <div class="w-100p pe-2 text-nowrap"> @ctr </div>
            <div class="w-175p pe-2 text-nowrap">@v.EmpNumber</div>
            <div class="w-775p pe-2 text-nowrap">@v.EmpName</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Brgy?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Court?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Drug?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Nbi?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Neuro?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Pnp?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.Exp_Police?.ToString("MM/dd/yyyy") ?? "")</div>
            <div class="w-375p pe-2 text-nowrap">@(v.ExpMed?.ToString("MM/dd/yyyy") ?? "")</div>
        </div>

        row++; ctr++; 
    }

</div>





@code {
    [Parameter] public List<V2203Model> V2203{ get; set; } = []; 

   
    


    

}