@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using System.Globalization
@inject NotificationService _NotificationService;

<RadzenNotification />


<_02BTModal MCaption="@Rv.MCaption" ShowModal="Rv.ShowModal" ChildAction="CloseReportModal">
    <Details>

        @if (Rv.ShowReport)
        {
            <IframeReportRenderer DataSource="@Rv.ReportData"
                                  ReportRelativePath="@Rv.RelativePath"
                                  OutputFormat="@Rv.SelectedFormat"
                                  Parameters="@Rv.ReportParams"
                                  AutoGenerate="@(Rv.ReportData?.Any() == true)"
                                  RefreshToken="@Rv.RefreshToken" />
        }
        else
        {
            <div class="card m-2">
                <div class="sticky-top bg-white ">
                    <div class=" border-bottom">
                        <div class="p-0">
                            <div class="card-header">
                                <div class="d-flex gap-2">
                                    <_01ReportFormat Rv="@Rv" ChildAction="ValueChanged" />
                                    @*--- Fetch Button ------------------------------------------------*@
                                    <button class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="CreateReport"> Show Report</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 py-2 border-bottom fw-bold  bg-lightgray ">
                        <div class="w-75p text-end pe-2">     No.</div>
                        <div class="w-100p">    Emp. No.</div>
                        <div class="w-250p">    Emp. Name</div>
                        <div class="w-100p text-center">    Brgy</div>
                        <div class="w-100p text-center">    Court</div>
                        <div class="w-100p text-center">    Drug</div>
                        <div class="w-100p text-center">    NBI</div>
                        <div class="w-100p text-center">    Neuro</div>
                        <div class="w-100p text-center">    Police</div>
                        <div class="w-100p text-center">    Medical</div>
                        @* <div class="w-100p text-center">    HEPA</div> *@
                        
                    </div>
                </div>

                @{
                    int ctr = 0; int row = 0; string stat = string.Empty;
                }
                @foreach (var v in V.RepDtls)
                {
                    ctr++;
                    row++;

                    if ( stat != v.ClName.Trim())
                    {
                        stat = v?.ClName ?? "";
                        <div class="w-100 fw-bold border-bottom px-4 py-2 mt-2">@v.ClName</div>
                    }

                    <div class="d-flex gap-2 border-bottom py-1 " >
                        <div class="w-75p text-end pe-2">     @ctr.</div>
                        <div class="w-100p">    @v.EmpNumber</div>
                        <div class="w-250p">    @v.EmpName</div>
                        <div class="w-100p text-center  @(v.Exp_Brgy.HasValue && DateTime.Today >= v.Exp_Brgy.Value.AddMonths(-1) ? "text-danger" : "")">       @(v.Exp_Brgy.HasValue && v.Exp_Brgy.Value != new DateTime(1900, 1, 1) ? v.Exp_Brgy.Value.ToString("MM/dd/yyyy") : "")</div>
                        <div class="w-100p text-center  @(v.Exp_Court.HasValue && DateTime.Today >= v.Exp_Court.Value.AddMonths(-1) ? "text-danger" : "")">     @(v.Exp_Court.HasValue && v.Exp_Court.Value != new DateTime(1900, 1, 1) ? v.Exp_Court.Value.ToString("MM/dd/yyyy") : "")</div>
                        <div class="w-100p text-center  @(v.Exp_Drug.HasValue && DateTime.Today >= v.Exp_Drug.Value.AddMonths(-1) ? "text-danger" : "")">       @(v.Exp_Drug.HasValue && v.Exp_Drug.Value != new DateTime(1900, 1, 1) ? v.Exp_Drug.Value.ToString("MM/dd/yyyy") : "") </div>
                        <div class="w-100p text-center  @(v.Exp_Nbi.HasValue && DateTime.Today >= v.Exp_Nbi.Value.AddMonths(-1) ? "text-danger" : "")">         @(v.Exp_Nbi.HasValue && v.Exp_Nbi.Value != new DateTime(1900, 1, 1) ? v.Exp_Nbi.Value.ToString("MM/dd/yyyy") : "") </div>
                        <div class="w-100p text-center  @(v.Exp_Neuro.HasValue && DateTime.Today >= v.Exp_Neuro.Value.AddMonths(-1) ? "text-danger" : "")">     @(v.Exp_Neuro.HasValue && v.Exp_Neuro.Value != new DateTime(1900, 1, 1) ? v.Exp_Neuro.Value.ToString("MM/dd/yyyy") : "")</div>
                        <div class="w-100p text-center  @(v.Exp_Police.HasValue && DateTime.Today >= v.Exp_Police.Value.AddMonths(-1) ? "text-danger" : "")">   @(v.Exp_Police.HasValue && v.Exp_Police.Value != new DateTime(1900, 1, 1) ? v.Exp_Police.Value.ToString("MM/dd/yyyy") : "")</div>
                        <div class="w-100p text-center  @(v.ExpMed.HasValue && DateTime.Today >= v.ExpMed.Value.AddMonths(-1) ? "text-danger" : "")">           @(v.ExpMed.HasValue && v.ExpMed.Value != new DateTime(1900, 1, 1) ? v.ExpMed.Value.ToString("MM/dd/yyyy") : "")</div>
                        @* <div class="w-100p text-center">    @(v.ExpMed?.ToString("MM/dd/yyyy") ?? "")</div> *@
                    </div>

                }
            </div>

        }

    </Details>
</_02BTModal>


@code {
    [Parameter] public V00_RepVars              Rv  { get; set; } = new();
    [Parameter] public V2203Model               V   { get; set; } = new();
    [Parameter] public EventCallback<object>    ChildAction { get; set; }

    private async Task CreateReport()
    {
        Rv.RelativePath = "";
        Rv.ReportData = V.RepDtls;
        Rv.RelativePath = "Reports/_02HR/K_2203_EC.trdp";

        int monthNumber     = Convert.ToInt32(Rv.Month);
        string monthName    = new DateTime(1, monthNumber, 1).ToString("MMMM", CultureInfo.InvariantCulture);

        Rv.ReportParams["MonthYearCoverage"] = $"For the Month of {monthName} {Rv.Year}";
        Rv.ShowReport = true;

        if (Rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(1000);
            Rv.ShowReport = false;
            Notify(NotificationSeverity.Success, "Success", "The Excel file is ready. Please check the download in your browser.");
        }
    }


    private async Task CloseReportModal(bool ans)
    {
        if (Rv.ShowReport) Rv.ShowReport = ans;
        else Rv.ShowModal = ans;

        await ChildAction.InvokeAsync(ans);
    }

    private async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFormat);
    }


    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }

    
}