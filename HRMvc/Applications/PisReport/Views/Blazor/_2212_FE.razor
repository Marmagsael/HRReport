@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2212
@using System.Globalization

@inject NotificationService _NotificationService
@inject IOPisReportDataAccess _pisRep
@inject IOEmpstatDataAccess _empstat

<RadzenNotification />

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>

        <_00Loader Rv="@rv" />
        @*--- Report ------------------------------------------------*@
        <_02BTRep Rv="rv" ChildAction="ChildActionCatcher" />

        @*----------------------------------------------------------------------*@
        @*--- Filter and Button ------------------------------------------------*@
        <div class="p-0">
            <div class="card-header d-flex gap-3">
                <div class="d-flex flex-row gap-2 card p-2">
                    @*--- Date Range -------------------------------------------*@
                    <div class="text-muted p-2 pe-4 border-end"> <small>Date Range</small> </div>
                    <_01MMDDYYYY Rv="rv" ChildAction="ChildActionCatcher" />

                    @*--- Fetch Data -------------------------------------------*@
                    <div class="p-2 card mb-cbtn mb-cbtn-gray" @onclick="FetchData">
                        Fetch Data
                    </div>

                </div>

                <div class="d-flex flex-row gap-2 card p-2 ">
                    @*--- Export Format -----------------------------------------*@
                    <div class="text-muted p-2 pe-4 border-end"> <small>Export Format </small> </div>
                    <div class="d-flex w-150p ">
                        <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                    </div>

                    @*--- Show Report -------------------------------------------*@
                    <button class="p-2 card mb-cbtn mb-cbtn-gray  
                            @(!(v.RepDtls?.Any() ?? false) ? "pe-none cursor-not-allowed opacity-50" : "")"
                            disabled="@(!(v.RepDtls?.Any() ?? false))"
                            @onclick="CreateReport">
                        Show Report
                    </button>
                </div>

            </div>
        </div>

        @*--- Grid -------------------------------------------------------------*@
        <div class="w-100">
            <_2212_Dtl V="@v" Rv="@rv" ChildAction="SortBy" />
        </div>


    </Details>
</_00BT_FullW>

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    V00_RepVars rv = new();
    V2212Model v = new();


    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection()) return;

        rv = new()
        {
            MCaption = "Floating Employees",
            RefreshToken = 22120000,

            ReportParams = new()
            {
                ["CoName"] = "-",
                ["CoAddress"] = "-",
                ["ReportTitle"] = "Floating Employees",
                ["RunDate"] = DateTime.Now
            }
        };

        rv.DataFilters = new List<V00_RepVars.DataFilterModel>
        {
            new(){ Code = 1, Name = "Current Deployment" }
        };

        await LoadCompanyInfo();     
    }


    async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);

        if (res?.Any() == true)
        {
            var r = res.First();
            rv.ReportParams["CoName"] = r.CoName ?? "";
            rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
        }
    }

    void ChildActionCatcher()
    {
        if (v.Action == "SortBy") SortBy();
    } 

    async Task FetchData()
    {
        ResetVars();
        if (!HasConnection()) return;
        if(!ValidateFilters()) return;

        try
        {
            rv.Isloaded = true;
            var res = await _pisRep._02Empmas_ByMovDate(rv.DStart, rv.DEnd, Uc.OpisDb!, Uc.Conn!);

            if (res?.Any() == true)
            {
                v.RepDtls = res.Select(r => new R2102Model
                {
                    EmpNumber   = r.EmpNumber,
                    EmpName     = r.EmpName,
                    EmpLastNm   = r.EmpLastNm,
                    EmpFirstNm  = r.EmpFirstNm,
                    MovDate     = r.MovDate,
                    ClName      = r.ClName,
                    Remarks     = r.Remarks,
                }).ToList();


            }
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh the page or contact your system administrator."); ;
            Console.WriteLine(ex.Message);
            return;
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!v.RepDtls.Any())
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period.");
            return;
        }


    }

    private void SortBy()
    {
        if (!v.RepDtls.Any()) { return; }

        if (rv.SortFld == "EmpName")
        {
            var sorted = v.RepDtls.OrderBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm);
            v.RepDtls = rv.SortOdr == "asc" ? sorted.ToList() : sorted.Reverse().ToList();
        }

        if (rv.SortFld == "MovDate")
        {
            var sorted = v.RepDtls.OrderBy(x => x.MovDate);
            v.RepDtls = rv.SortOdr == "asc" ? sorted.ToList() : sorted.Reverse().ToList();
        }
    }

    private void ResetVars()
    {
        v.RepDtls = [];
        rv.ShowModal = false;
        rv.ShowReport = false;

        if (rv.ReportFormats != null && rv.ReportFormats.Any()) rv.SelectedFormat = "PDF";
    }

    private bool ValidateFilters()
    {
        if (rv.DStart == null)
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please enter a date start to proceed.");
            return false;
        }

        if (rv.DEnd == null)
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please enter a date end to proceed.");
            return false;
        }

        return true;
    }


    private async Task CreateReport()
    {
        if (!v.RepDtls.Any()) { return; }

        rv.RelativePath = "";
        rv.ReportData   = [];
        rv.ReportData   = v.RepDtls;

        rv.RelativePath = "Reports/_02HR/K_2212_FE.trdp";

        int monthNumber     = Convert.ToInt32(rv.Month);
        string monthName    = new DateTime(1, monthNumber, 1).ToString("MMMM", CultureInfo.InvariantCulture);

        string dstart       = rv.DStart?.ToString("d, MMMM yyyy") ?? "-";
        string dend         = rv.DEnd?.ToString("d, MMMM yyyy") ?? "-";

        rv.ReportParams["DateRange"] = $"For the month covering {dstart} - {dend}";
        rv.ShowModal = true;

        if (rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(1000);
            rv.ShowReport = false;  
            Notify(NotificationSeverity.Success, "Success", "The Excel file is ready. Please check the download in your browser.");
        }
    }





    bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) ||string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error,"Failed to connect to server","Please refresh the page or contact your system administrator.");
            return false;
        }
        return true;
    }

    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }
}