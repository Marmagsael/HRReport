@inject IOClientDataAccess      _client; 
@inject IOPisReportDataAccess   _pisRep; 

@code {

    [Parameter] public UserClaimsModel  Uc      {get; set; } = new(); 
    [Parameter] public V00_RepVars      rv      {get; set; } = new(); 

    List<V2212Model> v = [];
    private async Task FetchData(){
        v = [];
        var status = "B";
        var StartDate = new DateTime(2025,02,19).ToString("yyyy-MM-dd");
        var EndDate = new DateTime(2026,02,19).ToString("yyyy-MM-dd");
        var res = await _pisRep._02Empmas_By_Status_And_DateRange(status,StartDate,EndDate,Uc.OpisDb!,Uc.Conn!);
        if(res.Count > 0){
        foreach(var r in res) {
     
     V2212Model rec  = new() {
         EmpNumber   = r?.EmpNumber??"", 
         EmpName     = r?.EmpName??"",
         ClName     = r?.ClName??"", 
         MovDate     = r?.MovDate,
         Remarks     = r?.Remarks??""
     };
     v.Add(rec);  
 }
        }
    }
}