@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2102
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.DataAccess._20_Pay.Interface

@inject HRMvc.StartupConfig.CompanyLogoService _logo
@inject IOPisReportDataAccess _pisRep
@inject IOCoinfoDataAccess _coinfo


<style>
    .ao-note { color:#6c757d; font-size:12px; }
</style>

<TelerikRootComponent>
    <div class="position-relative">
        <TelerikNotification @ref="@NotificationRef" HorizontalPosition="@NotificationHorizontalPosition.Right" VerticalPosition="@NotificationVerticalPosition.Top" AnimationType="@AnimationType.SlideLeft" />
        <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

        <CascadingValue Value="@Uc">
            <CascadingValue Value="@v">
                <CascadingValue Value="@rv">
                    <CascadingValue Value="@NotificationRef">
                        <_00BT_FullW HdrCaption="Employee Masterlist">
                            <Details>
                                <_02BTRep Rv="rv" ChildAction="ChildAction" />

                                <div class="p-0">
                                    <div class="card-header d-flex gap-2">
                                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="button" tabindex="1" @onclick="ShowFilterModal">Filter List</button>
                                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray" type="button" tabindex="2" @onclick="GenerateReport">Print</button>
                                    </div>



                                    <_2102_EmployeeMasterList ChildAction="ChildAction" />



                                    <TelerikWindow Modal="true" @bind-Visible="@showStatus" Width="420px" Height="560px">
                                        <WindowTitle>Employee Status Settings</WindowTitle>
                                        <WindowContent>
                                            <div class="ao-note mb-2">Check the statuses of the employees you want to display in the list.</div>
                                            <TelerikGrid Data="@v.OEmpStatuses" Height="420px" Size="@ThemeConstants.Grid.Size.Small">
                                                <GridColumns>
                                                    <GridColumn Field="@nameof(OEmpstatModel.IsMarked)" Title="" Width="50px">
                                                        <Template>
                                                            @{
                                                                var s = (OEmpstatModel)context;
                                                            }
                                                            <TelerikCheckBox Value="@s.IsMarked" ValueChanged="@((bool value) => ToggleStatus(s, value))" />
                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field="@nameof(OEmpstatModel.Name)" Title="Employee Status" />
                                                </GridColumns>
                                            </TelerikGrid>
                                        </WindowContent>
                                        <WindowActions>
                                            <WindowAction Name="Close" />
                                        </WindowActions>
                                    </TelerikWindow>
                                
                                </div>
                            </Details>
                        </_00BT_FullW>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
</TelerikRootComponent>

@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V2102Model v = new();
    private V00_RepVars rv = new();
    private TelerikNotification? NotificationRef;
    private bool showStatus = false;

    // INITIALIZATION
    protected override async Task OnInitializedAsync()
    {
        v.IsLoading = true;
        try
        {
            if (Uc?.Conn == null || Uc.OpisDb == null)
            {
                NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
                return;
            }

            await LoadEmployeeStatuses();

            foreach (var s in v.OEmpStatuses)
            {
                if (s.Code == "A")
                {
                    s.IsMarked = true;
                }
            }

            await _02LoadMasterEmployeeList();
            InitializeReport();
            await _02LoadCompanyInfo();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to initialize Employee Masterlist.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
    }

    // CHILD ACTION
    private Task ChildAction()
    {
        v.Action = "";
        return Task.CompletedTask;
    }

    private async Task _02LoadMasterEmployeeList()
    {
        try
        {
            List<string> statuses = v.OEmpStatuses.Where(s => s.IsMarked && !string.IsNullOrEmpty(s.Name)).Select(s => s.Code!).ToList();

            var result = await _pisRep._02EmpmasByStatusByClient(statuses, Uc.OpisDb, Uc.Conn);
            v.OEmpmass = result ?? [];

            v.RepDtls = v.OEmpmass.Select(x => new R2102Model
            {
                EmpNumber = x.EmpNumber,
                EmpName = x.EmpName,
                ClName = x.ClName,
                EmpStatus = x.EmpStatus
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to load employee master list. Please try again or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task LoadEmployeeStatuses()
    {
        try
        {
            var result = await _pisRep._02Empstats(Uc.OpisDb, Uc.Conn);
            v.OEmpStatuses = result ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            v.OEmpStatuses = [];
            NotificationRef?.Show("Unable to load employee status. Please try again or contact your system administrator.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task ToggleStatus(OEmpstatModel s, bool status)
    {
        bool previousStatus = s.IsMarked;
        try
        {
            s.IsMarked = status;
            await _02LoadMasterEmployeeList();
        }
        catch (Exception ex)
        {
            s.IsMarked = previousStatus;
            Console.WriteLine(ex);
        }
    }

    private Task ShowFilterModal()
    {
        showStatus = true;
        return Task.CompletedTask;
    }

    private async Task GenerateReport()
    {
        if (v.RepDtls == null || !v.RepDtls.Any())
        {
            NotificationRef?.Show("No employee records available for printing.", ThemeConstants.Notification.ThemeColor.Warning);
            return;   // not "return Task.CompletedTask;"
        }

        try
        {
            v.IsLoading = true;

            var logo = (await _logo.GetAsync(Uc!))?.Data;

            var first = v.RepDtls.FirstOrDefault();
            if (first != null) first.Logo = logo;

            rv.RelativePath = "Reports/_01Pis/J_2102_EML1.trdp";
            rv.ReportData = v.RepDtls;
            rv.ReportParams["ReportTitle"] = "Employee Master List";
            rv.SelectedFormat = "PDF";
            rv.ShowModal = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to generate employee masterlist report.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
        // no return needed at the end
    }

    private void InitializeReport()
    {
        rv.MCaption = "Employee Master List";
        rv.RefreshToken = 21020000;
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task _02LoadCompanyInfo()
    {
        try
        {
           
            var res = await _coinfo._02(Uc.OpisDb, Uc.Conn);
            Console.WriteLine($"report {res.CoName} {res.CoAdd}");
            if (res == null) return;

            rv.ReportParams["CoName"] = res.CoName ?? "";
            rv.ReportParams["CoAddress"] = res.CoAdd ?? "";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationRef?.Show("Unable to load company information.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }
}
