@using HRMvc.Applications.PisReport.Vars



    <div class="p-2">
            <div class="h-100 grid-wrapper">
        <TelerikGrid TItem="R2102Model"
                                 Data="@V.RepDtls"
                                 SelectionMode="@GridSelectionMode.Single"
                                 Navigable="true"
                                 Pageable="true"
                                 @bind-PageSize="@PageSize"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Height="100%"
                                 Groupable="true">

                        <GridSettings>
                            <GridPagerSettings PageSizes="@PageSizes" />
                        </GridSettings>

                        <GridColumns>
                            <GridColumn Field="@nameof(R2102Model.EmpNumber)"
                                        Title="Emp. No."
                                        Width="80px" />

                            <GridColumn Field="@nameof(R2102Model.EmpName)"
                                        Title="Name"
                                        Width="200px" />

                            <GridColumn Field="@nameof(R2102Model.EmpStatus)"
                                        Title="Status"
                                        Width="80px" />

                            <GridColumn Field="@nameof(R2102Model.ClName)"
                                        Title="Client"
                                        Width="80px" />
                        </GridColumns>

                        <NoDataTemplate>
                            <div class="text-center text-secondary p-4">
                                No records found.
                            </div>
                        </NoDataTemplate>

                    </TelerikGrid>
                </div>
    </div>






@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

   

}

