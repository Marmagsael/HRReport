@using HRMvc.Applications.PisReport.Vars

<div class="p-0">
    <div class="card-header d-flex gap-2">
        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-gray"
                type="button" tabindex="6">
            Print
        </button>
    </div>


    <div class="p-2">
        <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch grid-container">

            <!-- Left column -->
            <div class="col-12 col-md-4 d-flex flex-column">
                <div class="card p-0 h-100 d-flex flex-column">

                    <div class="card-header txt-fcolor">
                        FILTER OPTION
                    </div>

                    <div class="flex-grow-1 grid-wrapper">
                        <TelerikGrid TItem="OClientModel"
                                     SelectionMode="@GridSelectionMode.Single"
                                     Navigable="true"
                                     Sortable="true"
                                     FilterMode="@GridFilterMode.FilterMenu"
                                     Height="100%">

                            <GridSettings>
                                <GridPagerSettings PageSizes="@PageSizes" />
                            </GridSettings>

                            <GridColumns>
                                <GridCheckboxColumn SelectAll="false" Width="10px" />

                                <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                            Title="Status"
                                            Width="80px" />
                            </GridColumns>

                            <NoDataTemplate>
                                <div class="text-center text-secondary p-4">
                                    No records found.
                                </div>
                            </NoDataTemplate>
                        </TelerikGrid>
                    </div>

                </div>
            </div>

            <!-- Right column -->
            <div class="col-12 col-md-8 d-flex flex-column">
                <div class="h-100 grid-wrapper">
                    <TelerikGrid TItem="OClientModel"
                                 SelectionMode="@GridSelectionMode.Single"
                                 Navigable="true"
                                 Pageable="true"
                                 @bind-PageSize="@PageSize"
                                 Sortable="true"
                                 FilterMode="@GridFilterMode.FilterMenu"
                                 Height="100%"
                                 Groupable="true">

                        <GridSettings>
                            <GridPagerSettings PageSizes="@PageSizes" />
                        </GridSettings>

                        <GridColumns>
                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Emp. No."
                                        Width="80px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Name"
                                        Width="200px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Status"
                                        Width="80px" />

                            <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                        Title="Client"
                                        Width="80px" />
                        </GridColumns>

                        <NoDataTemplate>
                            <div class="text-center text-secondary p-4">
                                No records found.
                            </div>
                        </NoDataTemplate>

                    </TelerikGrid>
                </div>
            </div>

        </div>


    </div>




</div>


@code {

    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();


    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [CascadingParameter]
    public TelerikNotification? NotificationRef { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }



    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };

    private async Task NewEntry()
    {
        V.ModalCaption = "Inventory Entry";
        V.ShowEntryModal = true;
        await ChildAction.InvokeAsync();
    }

}

