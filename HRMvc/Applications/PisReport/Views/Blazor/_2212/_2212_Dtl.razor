@using HRMvc.Applications.PisReport.Vars
<div class="">
    @* --- Header ---------------------- *@
    <div class=" d-flex p-2 border-bottom fw-bold ">
        <div class="w-100p">   No</div>
        <div class="w-150p">    Emp. No.</div>
        <div class="w-250p">    Emp. Name</div>
        <div class="w-150p">    Date</div>
        <div class="w-350p">    Deployment</div>
        <div class="w-350p">    Reason</div>
    </div>
    
    @* --- Details ---------------------- *@
    <div class="vh-max vh75">
        @{

            int row = 0; int ctr = 1;
            if(V.Count() > 0)
            {
                foreach (var v in V)
                {
                    <div class=" d-flex p-2 border-bottom @(row % 2 == 0 ? "bg-light" : "") ">
                        <div class="w-100p">        @ctr </div>
                        <div class="w-150p">        @v.EmpNumber </div>
                        <div class="w-250p">        @v.EmpName </div>
                        <div class="w-150p">        @(v.MovDate?.ToString("MM/dd/yyyy") ?? "") </div>
                        <div class="w-350p">        @v.ClName </div>
                        <div class="w-350p">        @v.Remarks </div>
                    </div>
                    row++; ctr++;
                }
            }
            else
            {

                <div class="d-flex justify-content-center align-items-center w-100 h-100 pt-5 ">
                    No records to display.
                </div>
                
            }
           
        }
    </div>
  


</div>


@code {
    [Parameter] public List<V2212Model> V {get; set;}=[];
  

}