@using HRMvc.Applications.PisReport.Vars

<div class="p-2">
    <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch grid-container">

        <div class="col-12 col-md-8 d-flex flex-column">
            <div class="h-100">
                <TelerikGrid TItem="OClientModel"
                             SelectionMode="@GridSelectionMode.Single"
                             Navigable="true"
                             Pageable="true"
                             @bind-PageSize="@PageSize"
                             Sortable="true"
                             FilterMode="@GridFilterMode.FilterMenu"
                             Height="100%">

                    <GridSettings>
                        <GridPagerSettings PageSizes="@PageSizes" />
                    </GridSettings>

                    <GridColumns>
                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Date"
                                    Width="50px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Dev No"
                                    Width="80px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Client Name"
                                    Width="100px" />


                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Emp No"
                                    Width="80px" />

                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Employee Name"
                                    Width="100px" />


                        <GridColumn Field="@nameof(OClientModel.ClNumber)"
                                    Title="Remarks"
                                    Width="100px" />

                    </GridColumns>

                    <NoDataTemplate>
                        <div class="text-center text-secondary p-4">
                            No records found.
                        </div>
                    </NoDataTemplate>

                </TelerikGrid>
            </div>
        </div>

    </div>
</div>


@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OSecliclogsModel> LicVerifGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
