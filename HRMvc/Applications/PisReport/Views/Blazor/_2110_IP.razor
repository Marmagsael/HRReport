
<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        <div class="p-0">
            <div class="card-header">
                <div class="d-flex">

                    <div class="card">
                        <RadzenRadioButtonList @bind-Value="@selectedValue">
                            <Items>
                                <RadzenRadioButtonListItem Text="Filter by Exppiration Date" Value="1" />
                                <RadzenRadioButtonListItem Text="Without Insurance" Value="2" />
                                <RadzenRadioButtonListItem Text="With Insurance" Value="3" />
                            </Items>
                        </RadzenRadioButtonList>
                    </div>

                    <div class="card">
                        <RadzenDatePicker @bind-Value="@rv.DStart"
                                          DateFormat="MM/dd/yyyy" />

                        <RadzenDatePicker @bind-Value="@rv.DEnd"
                                          DateFormat="MM/dd/yyyy" />
                    </div>

                    @*--- Buttons ------------------------------------------------*@
                    @* <span @onclick="FetchData">
                        <div class="p-2 ms-2 card mb-cbtn mb-cbtn-gray">
                            Fetch Data
                        </div>
                    </span>


                    @if (v.Count > 0)
                    {
                        <span @onclick="CreateReport"> <div class="p-2 ms-1 card mb-cbtn mb-cbtn-blue"> Create Report </div> </span>
                    } *@

                </div>
            </div>
        </div>

        @*--- Grid ------------------------------------------------*@
        <div>
            @* <_2105_Dtl V="@v" /> *@
        </div>

    </Details>
</_00BT_FullW>

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V00_RepVars rv { get; set; } = new();
    string selectedValue = "1";


}
