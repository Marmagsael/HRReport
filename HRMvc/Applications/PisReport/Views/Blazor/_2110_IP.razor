@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2110
@using System.Globalization

@inject NotificationService _NotificationService
<RadzenNotification />

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        @if ((v ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_2110_Report Rv="rv" V="@v" ChildAction="ChildActionCatcher" /> 
        }

        @*--- Filter and Button ------------------------------------------------*@
        <div class="p-0">
            <div class="card-header d-flex gap-3">
                <div class="d-flex gap-2 card p-2">
                    <div class="text-muted p-2 pe-4 border-bottom"> <small>Filter By</small> </div>
                    <_01ReportFilter Rv="@rv" ChildAction="ChildActionCatcher" />
                </div>

                <div class="d-flex gap-2 card p-2">
                    <div class="text-muted p-2 pe-4 border-bottom"> <small>Date Covered</small> </div>
                    @*--- Period ------------------------------------------------*@
                    <_01MMDDYYYY Rv="rv" ClassParams="@periodClass" ChildAction="ChildActionCatcher" />
                    @*--- Fetch Button ------------------------------------------------*@
                    <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                </div>
            </div>
        </div>


        @*--- Client List ------------------------------------------------*@
        <div class="w-100"> <_00TStatusList Empstats="@rv.Empstats" ClassParams="@statusClass" ChildAction="ChildActionCatcher" /> </div>

    </Details>
</_00BT_FullW>




@inject IOPisReportDataAccess _pisRep;
@inject IOEmpstatDataAccess _empstat;
@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V00_RepVars rv { get; set; } = new();
    List<V2110Model> v = [];


    List<string?>? statuses => rv.Empstats.Where(c => c.IsSelectedB).Select(c => c.Code).ToList() ?? [];
    public Dictionary<string, object> periodClass  = new()
    {
        ["FlexDirection"] = "flex-column",
    };

    public Dictionary<string, object> statusClass  = new()
    {
        ["VH"] = "vh60",
    };

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error, "Failed to connect to server", "Please refresh the page or contact your system administrator."); ;
            return;
        }

        rv = new()
        {
            RefreshToken = 21100000,
            MCaption = "Insurance Policy",
            ReportParams = new()
            {
                ["CoName"] = "-",
                ["CoAddress"] = "-",
                ["ReportTitle"] = "Insurance Report",
                ["RunDate"] = DateTime.Now
            }
        };

        rv.DataFilters = new List<V00_RepVars.DataFilterModel>
        {
            new(){Code = 1, Name="Expiration Date"},
            new(){Code = 2, Name="Without Insurance"},
            new(){Code = 3, Name="With Insurance"}
        };


        await LoadCompanyInfo();
        await LoadEmployeeStatus();
    }

    async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);

        if (res?.Any() == true)
        {
            var r = res.First();
            rv.ReportParams["CoName"] = r.CoName ?? "";
            rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
        }
    }

    async Task LoadEmployeeStatus()
    {
        rv.Empstats = [];
        var res = await _empstat._02s(Uc.OpisDb!, Uc.Conn!);
        if (res?.Any() == true) { rv.Empstats = res; }
    }

    async Task FetchData()
    {
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error, "Failed to connect to server", "Please refresh the page or contact your system administrator.");
            return;
        }

        v = [];
        rv.ReportData = [];
        rv.ShowModal = false;

        if (!(statuses ?? []).Any())
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select at least one employee status to proceed..");
            return;
        }

        try
        {
            rv.Isloaded = true;

            var res = await _pisRep._02Empmas_ByInsurance_And_Status(rv.SelectedFilter, statuses, rv.DStart, rv.DEnd, Uc.OpisDb!, Uc.Conn!);

            if (res?.Any() == true)
            {
                v = res.Select(r => new V2110Model
                {
                    EmpNumber   = r.EmpNumber,    
                    EmpName     = r.EmpName,      
                    EmpLastNm   = r.EmpLastNm,
                    EmpFirstNm  = r.EmpFirstNm,
                    EmpMidNm    = r.EmpMidNm,
                    Insurance   = r.Insurance,    
                    PolicyNo    = r.PolicyNo,     
                    EmpStatus   = r.EmpStatus,    
                    FaceValue   = r.FaceValue,    
                    Premium     = r.Premium,      
                    InsExpire   = r.InsExpire,  
                    EmpBirth    = r.EmpBirth,   
                    DateHired   = r.DateHired  

                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh the page or contact your system administrator.");
            Console.WriteLine(ex);
            return;
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!v.Any())
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period.");
            return;
        }

        rv.ReportData = v;
        rv.ShowModal = true;
    }


    void ChildActionCatcher() { }

    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }
    bool HasConnection()
    {
        if (Uc == null) return false;
        if (string.IsNullOrWhiteSpace(Uc.OpisDb)) return false;
        if (string.IsNullOrWhiteSpace(Uc.Conn)) return false;
        return true;
    }
}
