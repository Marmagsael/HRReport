@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2110

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>

        @if (v.Any())
        {
            <_2110_Report Rv="rv" V="@v" ChildAction="ChildActionCatcher" />
        }

        <div class="p-0">
            <div class="card-header">
                <div class="d-flex gap-2">
                    <_01ReportFilter    Rv="@rv" ChildAction="ChildActionCatcher" />
                    <_01MMDDYYYY        Rv="@rv" ChildAction="ChildActionCatcher"/>


                    <div class="card p-3 w-255p">
                        <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher"/>
                        @*--- Fetch Button ------------------------------------------------*@
                        <div class="mt-3 p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
                    </div>  
                </div>
            </div>
        </div>

        @*--- Status List ------------------------------------------------*@
        <div class="w-50 "> <_2110_StatusList Empstats="@rv.Empstats" ChildAction="ChildActionCatcher" />  </div>

    </Details>
</_00BT_FullW>

@inject IOPisReportDataAccess _pisRep;
@inject IOEmpstatDataAccess _empstat;

@code {
    [Parameter] public UserClaimsModel  Uc   { get; set; } = new();
    V00_RepVars                         rv   = new();
    List<V2110Model>                    v    = [];



    protected override async Task OnInitializedAsync()
    {
        rv.Empstats = [];

        List<OEmpstatModel?>? empstats = await _empstat._02s(Uc.OpisDb!, Uc.Conn!) ?? [];
        if (empstats.Any()) rv.Empstats = empstats!;
        

        rv.DataFilters = new List<V00_RepVars.DataFilterModel>
        {
            new(){Code = 1, Name="Filter by Expression Date"},
            new(){Code = 2, Name="Without Insurance"},
            new(){Code = 3, Name="With Insurance"}
        };

        @* --- Report Details -------------------------------------------- *@
        // rv.RelativePath = "Reports/_02HR/K_2105_NH.trdp";
        rv.RefreshToken = 2110000;
        rv.MCaption     = "Insurance Report";


        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        rv.ReportParams = [];

        rv.ReportParams["CoName"] = "-";
        rv.ReportParams["CoAddress"] = "-";

        if (res.Count > 0)
        {
            var r = res.FirstOrDefault();
            rv.ReportParams["CoName"]       = r.CoName ?? "";
            rv.ReportParams["CoAddress"]    = r.CoAdd ?? "";
        }

        rv.ReportParams["ReportTitle"]  = "Insurance Report";
        rv.ReportParams["RunDate"]      = DateTime.Now;


    }

    async Task FetchData()
    {
        rv.ShowReport = false;
        v = [];
        List<string?> statuses = [];

        statuses = rv.Empstats.Where(s => s.IsSelectedB).Select(c => c.Code).ToList() ?? [];
        if (statuses.Any())
        {
            var res = await _pisRep._02Empmas_ByInsurance_And_Status(rv.SelectedFilter, statuses!, rv.DStart, rv.DEnd, Uc.OpisDb!, Uc.Conn!);

            if (res.Any())
            {
                foreach (var r in res)
                {
                    V2110Model rec = new()
                    {
                         EmpNumber  = r.EmpNumber  , 
                         EmpName    = r.EmpName    , 
                         Insurance  = r.Insurance  , 
                         PolicyNo   = r.PolicyNo   , 
                         EmpStatus  = r.EmpStatus  , 
                         FaceValue  = r.FaceValue  , 
                         Premium    = r.Premium    , 
                         InsExpire  = r.InsExpire  ,
                         EmpBirth   = r.EmpBirth   ,
                         DateHired  = r.DateHired  ,
                    };
                    v.Add(rec);
                    
                }
                v = v.OrderBy(e => e.EmpStatus)
                                .ThenBy(e => e.EmpName)
                                .ToList();
                rv.ShowModal = true;

            }
        }
    }




 

    void ChildActionCatcher()
    {
        
    }
}
