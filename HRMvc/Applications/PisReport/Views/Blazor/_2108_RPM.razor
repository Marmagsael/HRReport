@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2108
@using System.Globalization

@inject NotificationService _NotificationService
@inject IOPisReportDataAccess _pisRep
@inject IOEmpstatDataAccess _empstat

<RadzenNotification />

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>

        <_00Loader Rv="@rv" />

        @if ((v.RepDtls ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_02BTRep Rv="rv" ChildAction="ChildActionCatcher" />
        }
       

        @*--- Filter and Button ------------------------------------------------*@
        <div class="p-0">
            <div class="card-header d-flex gap-3">
                <div class="d-flex flex-row gap-2 card p-2">
                    <div class="text-muted p-2 pe-4 border-end"> <small>Date Covered</small> </div>
                    <_01YYMM Rv="rv" ChildAction="ChildActionCatcher" />
                    <div class="p-2 card mb-cbtn mb-cbtn-gray" @onclick="FetchData">
                        Fetch Data
                    </div>

                </div>

                <div class="d-flex flex-row gap-2 card p-2 ">
                    <div class="text-muted p-2 pe-4 border-end"> <small>Export Format </small> </div>
                    <div class="d-flex w-150p ">
                        <_01ReportFormat Rv="@rv" ChildAction="ChildActionCatcher" />
                    </div>
                    <button class="p-2 card mb-cbtn mb-cbtn-gray @(!(v.RepDtls ?? []).Any() ? "pe-none cursor-not-allowed opacity-50" : "")"
                            disabled="@(!(v.RepDtls ?? []).Any())"
                            @onclick="CreateReport">
                        Show Report
                    </button>
                </div>

            </div>
        </div>

       

        @*--- Grid -----------------------------------------------------------*@
        <div class="w-100">
            <_2108_Dtl Rv="@rv" V="@v" ChildAction="ChildActionCatcher" />
        </div>

    </Details>
</_00BT_FullW>

@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();

    V00_RepVars rv  = new();
    V2108Model  v   = new();


    protected override async Task OnInitializedAsync()
    {

        if (!HasConnection()) return;

        InitializeReport();
        await LoadInitialData();
    }

    //===================================
    // Initial Data =====================
    private void InitializeReport()
    {
        rv.RefreshToken = 21080000;
        rv.MCaption = "Resigned Personnel for the Month";
        rv.ReportParams = new()
        {
            ["CoName"] = "-",
            ["CoAddress"] = "-",
            ["ReportTitle"] = "List of Resigned Employees",
            ["RunDate"] = DateTime.Now
        };
    }

    private async Task LoadInitialData()
    {
        await LoadCompanyInfo();
    }

    private async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);
        if (!(res ?? []).Any()) return;

        var r = res!.First();
        rv.ReportParams["CoName"] = r.CoName ?? "";
        rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
    }




    //===================================
    // Core Functions ====================
    private void ChildActionCatcher()
    {
        if (v.Action == "SortBy") SortBy();
        v.Action = string.Empty;
    }


    async Task FetchData()
    {
        ResetVars();
        if (!HasConnection() || !ValidateFilters()) return;

        try
        {
            rv.Isloaded = true;
            var res = await _pisRep._02Empmas_ByDateResigned(Convert.ToInt32(rv.Month), rv.Year, Uc.OpisDb!, Uc.Conn!);

            if (res?.Any() == true)
            {
                v.RepDtls = res.Select(r => new R2108Model
                {
                    EmpNumber       = r.EmpNumber,
                    EmpName         = r.EmpName,
                    PositionName    = r.PositionName,
                    DateHired       = r.DateHired,
                    Separate        = r.Separate,
                    Remarks         = r.Reason,
                    EmpLastNm       = r.Reason,
                    EmpFirstNm      = r.EmpFirstNm
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh the page or contact your system administrator.");
            Console.WriteLine(ex);
            return;
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!v.RepDtls.Any())
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this period.");
            return;
        }

    }

    private bool ValidateFilters()
    {

        // if (!(clients ?? []).Any())
        // {
        //     Notify(NotificationSeverity.Warning, "Warning", "Please select at least one employee status.");
        //     return false;
        // }
        return true;
    }

    private void SortBy()
    {
        if (!(v.RepDtls ?? []).Any()) return;
        IOrderedEnumerable<R2108Model> sorted;

        if (rv.SortFld == "EmpName")
        {
            sorted = rv.SortOdr == "asc" ? v.RepDtls!.OrderBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm)
                                        : v.RepDtls!.OrderByDescending(x => x.EmpLastNm).ThenByDescending(x => x.EmpFirstNm);
        }

        else if (rv.SortFld == "DateHired")
        {
            sorted = rv.SortOdr == "asc" ? v.RepDtls!.OrderBy(x => x.DateHired).ThenBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm)
                                        : v.RepDtls!.OrderByDescending(x => x.DateHired).ThenBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm);
        }
        else  
        {
            sorted = rv.SortOdr == "asc" ? v.RepDtls!.OrderBy(x => x.Separate).ThenBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm)
                                        : v.RepDtls!.OrderByDescending(x => x.Separate).ThenBy(x => x.EmpLastNm).ThenBy(x => x.EmpFirstNm);
        }

        v.RepDtls = sorted.ToList();
    }

    private async Task CreateReport()
    {

        if (!(v.RepDtls ?? []).Any()) { return; }

        rv.RelativePath = "";
        rv.ReportData = [];
        rv.ReportData = v.RepDtls!;

        int monthNumber = Convert.ToInt32(rv.Month);
        string monthName = new DateTime(1, monthNumber, 1).ToString("MMMM", CultureInfo.InvariantCulture);

        rv.ReportParams["MonthYearCoverage"] = $"For the Month of {monthName} {rv.Year}";
        rv.RelativePath = "Reports/_02HR/K_2108_RPM.trdp";

        rv.ShowModal = true;

        if (rv.SelectedFormat == "XLSX")
        {
            await Task.Delay(1000);
            rv.ShowModal = false;
            Notify(NotificationSeverity.Success, "Success", "The Excel file is ready. Please check the download in your browser.");
        }
    }

    //=====================================
    // Helper Functions ===================
    private void ResetVars()
    {
        v.RepDtls = new();
        rv.ShowModal = false;
        rv.ShowReport = false;
        v.IsGroupByClient = false;


        if (rv.ReportFormats?.Any() == true) rv.SelectedFormat = "PDF";
    }

    bool HasConnection()
    {
        if (Uc == null || string.IsNullOrWhiteSpace(Uc.OpisDb) || string.IsNullOrWhiteSpace(Uc.Conn))
        {
            Notify(NotificationSeverity.Error, "Failed to connect to server", "Please refresh the page or contact your system administrator.");
            return false;
        }

        return true;
    }

    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }

}

