@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2104
@using System.Globalization

@inject NotificationService _NotificationService
<RadzenNotification />

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader --------------------------------------------------------------*@
        <_00Loader Rv="@rv" />

        @if ((v ?? []).Any())
        {
            @*--- Report ------------------------------------------------------------*@
             <_2104_Report Rv="rv" V="@v" ChildAction="ChildActionCatcher" />  
        }

         @*--- Fetch Button --------------------------------------------------------*@
        <div class="p-0">
            <div class="card-header d-flex gap-3">
                @*--- Fetch Button --------------------------------------------------*@
                <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
            </div>
        </div>


        @*--- Client and Status List ------------------------------------------------*@
        <div class="w-100 d-flex">
            <div class="w-50"> <_00TClientList Clients="@rv.Clients" ChildAction="ChildActionCatcher" /> </div>
            <div class="w-50"> <_00TStatusList Empstats="@rv.Empstats" ChildAction="ChildActionCatcher" /> </div>
        </div>
    </Details>
</_00BT_FullW>




@inject IOPisReportDataAccess   _pisRep;
@inject IOEmpstatDataAccess     _empstat;
@inject IOClientDataAccess      _client;


@code {
    [Parameter] public  UserClaimsModel Uc { get; set; } = new();
    V00_RepVars                         rv { get; set; } = new();
    List<V2104Model>                    v = [];

    // Gets the latest selected employee statuses/clients every time it is called
    List<string?>? statuses => rv.Empstats.Where(c => c.IsSelectedB).Select(c => c.Code).ToList() ?? [];
    List<string?>? clients => rv.Clients.Where(c => c.IsSelectedB).Select(c => c.ClNumber).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        // 1. Check if the system/server connection is available
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error,"Failed to connect to server", "Please refresh the page or contact your system administrator.");
            return;
        }

        // Initialize report variables and default values
        rv = new()
        {
            MCaption = "Employee Age",
            RefreshToken = 21040000,
            ReportParams = new()
            {
                ["CoName"]      = "-",                
                ["CoAddress"]   = "-",                
                ["ReportTitle"] = "Employee Age Report", 
                ["RunDate"]     = DateTime.Now        
            }
        };

        rv.DataFilters = new List<V00_RepVars.DataFilterModel>
        {
            new(){ Code = 1, Name = "Current Deployment" }
        };

        await LoadCompanyInfo();     // Get company name and address
        await LoadEmployeeStatus();  // Get list of employee statuses
        await LoadClients();         // Get list of clients
    }

    async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);

        if (res?.Any() == true)
        {
            var r = res.First();
            rv.ReportParams["CoName"]       = r.CoName ?? "";
            rv.ReportParams["CoAddress"]    = r.CoAdd ?? "";
        }
    }

    async Task LoadEmployeeStatus()
    {
        rv.Empstats = [];

        var res = await _empstat._02s(Uc.OpisDb!, Uc.Conn!);

        if (res?.Any() == true)
        {
            rv.Empstats = res;

            rv.Empstats.ForEach(x =>
            {
                // If employee status does not belong to the isresigned category, mark it check by default
                if (x.IsResigned == "0")
                {
                    x.IsSelectedB = true;
                }
            });
        }
    }

    async Task LoadClients()
    {
        rv.Clients = [];
        var res = await _client._02ByStatuss("Active", Uc.OpisDb!, Uc.Conn!); // Only get active clients
        if (res?.Any() == true) { rv.Clients = res!; }
    }

    async Task FetchData()
    {
        // 1. Reset all data 
        v               = [];
        rv.ShowModal    = false;
        rv.ShowReport   = false;

        // Set default report format to PDF if formats exist to prevent excel from automatic download
        if (rv.ReportFormats != null && rv.ReportFormats.Any()) rv.SelectedFormat = "PDF";

        // 2. Check if the system/server connection is available
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error,"Failed to connect to server","Please refresh the page or contact your system administrator.");
            return;
        }

        // 3. Make sure at least one client is selected
        if (!(clients ?? []).Any())
        {
            Notify(NotificationSeverity.Warning,"Warning","Please select at least one deployment to proceed.");
            return;
        }

        // 4. Make sure at least one employee status is selected
        if (!(statuses ?? []).Any())
        {
            Notify(NotificationSeverity.Warning, "Warning","Please select at least one employee status to proceed.");
            return;
        }

        try
        {
            // 5. Show loading indicator while fetching data
            rv.Isloaded = true;

            // get data based on selected filters
            var res = await _pisRep._02ByClNumbersByStatus(clients, statuses, Uc.OpisDb!, Uc.Conn!);

            // Check if data exists
            if (res?.Any() == true)
            {
                foreach (var r in res)
                {
                    // Map result to local model
                    var employee = new V2104Model
                    {
                        EmpNumber   = r.EmpNumber,
                        EmpBirth    = r.EmpBirth,
                        EmpName     = r.EmpName,
                        EmpStatus   = r.EmpStatus,
                        Client_     = r.Client_,
                        ClName      = r.ClName,
                        EmpFirstNm  = r.EmpFirstNm,
                        EmpLastNm   = r.EmpLastNm
                    };

                    // Compute age if birthdate exists
                    if (employee.EmpBirth != null)
                    {
                        var age = CalculateAge(employee.EmpBirth.Value);

                        var years = age.Years;
                        var months = age.Months;

                      
                        employee.FullAge = $"{years} yrs {months} mos"; // use to display the complete age
                        employee.Age = years + (months / 12.0); // use to sort age
                    }
                    else
                    {
                        // Default values if no birthdate
                        employee.FullAge    = null;
                        employee.Age        = 0;
                    }

                    v.Add(employee);
                }
            }
        }
        catch (Exception ex)
        {
            // 6. Handle errors during processing 
            // This prevents the app from crashing and shows a friendly message to the user
            Notify(NotificationSeverity.Error,"Failed to load data","Please refresh the page or contact your system administrator.");

            Console.WriteLine(ex);
            return;
        }
        finally
        {
            // 7. Hide loading indicator regardless of success or failure
            rv.Isloaded = false;
        }

        // 8. If no data found, notify user
        if (!v.Any())
        {
            Notify(NotificationSeverity.Info,"Info","No data found for this period.");
            return;
        }
        rv.ShowModal     = true;
    }


    private (int Years, int Months) CalculateAge(DateTime birthDate)
    {
        var today = DateTime.Today;

        int years = today.Year - birthDate.Year;
        int months = today.Month - birthDate.Month;

        if (today.Day < birthDate.Day)
            months--;

        if (months < 0)
        {
            years--;
            months += 12;
        }

        return (years, months);
    }

    void ChildActionCatcher() { }


    bool HasConnection()
    {
        if (Uc == null) return false;
        if (string.IsNullOrWhiteSpace(Uc.OpisDb)) return false;
        if (string.IsNullOrWhiteSpace(Uc.Conn)) return false;
        return true;
    }

    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }
    
}
