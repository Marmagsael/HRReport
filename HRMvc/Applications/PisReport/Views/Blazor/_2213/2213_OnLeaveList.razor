@using HRMvc.Applications.PisReport.Vars

<div class="p-2">

    <div class="p-0 mb-2">
        <div class="card-header txt-fcolor border border-1">
           On-Leave Employee
        </div>

        <TelerikGrid TItem="OClientModel"
                     Navigable="true"
                     Pageable="true"
                     @bind-PageSize="@PageSize"
                     Sortable="true"
                     FilterMode="@GridFilterMode.FilterMenu"
                     Height="100%">

            <GridSettings>
                <GridPagerSettings PageSizes="@PageSizes" />
            </GridSettings>



            <GridColumns>

                @* --- Emp No. --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Emp No."
                            Width="80px" />


                @* --- Emp Name --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Emp Name"
                            Width="100px" />

                @* --- Control No. --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Control No."
                            Width="80px" />

             

                @* --- Date Filed --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Date Filed"
                            Width="80px" />


                @* --- Leave Type  --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Leave Type"
                            Width="80px" />

                @* --- Date Start  --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Date Start"
                            Width="80px" />

                @* --- Date End  --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="Date Start"
                            Width="80px" />

                @* --- No. Of Days --- *@
                <GridColumn Field="@nameof(OClientModel.ClName)"
                            Title="No. of Days"
                            Width="80px" />
            </GridColumns>

            <NoDataTemplate>
                <div class="text-center text-secondary p-4">
                    No records found.
                </div>
            </NoDataTemplate>

        </TelerikGrid>
    </div>

</div>

@code {
    [CascadingParameter]
    public UserClaimsModel Uc { get; set; } = new();

    [CascadingParameter]
    public V2102Model V { get; set; } = new();

    [CascadingParameter]
    public V00_RepVars Rv { get; set; } = new();

    [Parameter]
    public EventCallback ChildAction { get; set; }

    private TelerikGrid<OSecliclogsModel> LicVerifGridRef;

    private int PageSize { get; set; } = 25;

    private List<int?> PageSizes = new()
    {
        25,
        50,
        75,
        100,
        null
    };
}
