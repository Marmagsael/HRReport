@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2203
@using System.Globalization

@inject NotificationService _NotificationService
<RadzenNotification />

<_00BT_FullW HdrCaption="@rv.MCaption" Rv="@rv">
    <Details>
        @*--- Looader ------------------------------------------------*@
        <_00Loader Rv="@rv" />

        @if ((v ?? []).Any())
        {
            @*--- Report ------------------------------------------------*@
            <_2203_Report Rv="rv" V="@v" ChildAction="ChildActionCatcher" /> 
        }

        @*--- Filter and Button ------------------------------------------------*@
        <div class="p-0">
            <div class="card-header d-flex gap-3">
                @*--- Fetch Button ------------------------------------------------*@
                <div class="p-2  card mb-cbtn mb-cbtn-gray" @onclick="FetchData"> Fetch Data</div>
            </div>
        </div>


        @*--- Client List ------------------------------------------------*@
        <div class="w-100"> <_00TClientList Clients="@rv.Clients" ChildAction="ChildActionCatcher" /> </div>

    </Details>
</_00BT_FullW>




@inject IOPisReportDataAccess _pisRep;
@inject IOClientDataAccess _client;
@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V00_RepVars rv { get; set; } = new();
    List<V2203Model> v = [];


    List<string?>? clients => rv.Clients.Where(c => c.IsSelectedB).Select(c => c.ClNumber).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error, "Failed to connect to server", "Please refresh the page or contact your system administrator."); ;
            return;
        }

        rv = new()
        {
            RefreshToken = 21070000,
            MCaption = "Employee Clearance",
            ReportParams = new()
            {
                ["CoName"] = "-",
                ["CoAddress"] = "-",
                ["ReportTitle"] = "Employee Clearance Report",
                ["RunDate"] = DateTime.Now
            }
        };

        await LoadCompanyInfo();
        await LoadClients();
    }

    async Task LoadCompanyInfo()
    {
        var res = await _pisRep._02CoInfo(Uc.OpisDb!, Uc.Conn!);

        if (res?.Any() == true)
        {
            var r = res.First();
            rv.ReportParams["CoName"] = r.CoName ?? "";
            rv.ReportParams["CoAddress"] = r.CoAdd ?? "";
        }
    }

    async Task LoadClients()
    {
        rv.Clients = [];
        var res = await _client._02ByStatuss("Active", Uc.OpisDb!, Uc.Conn!);
        if (res?.Any() == true) { rv.Clients = res!; }
    }

    async Task FetchData()
    {
        if (!HasConnection())
        {
            Notify(NotificationSeverity.Error, "Failed to connect to server", "Please refresh the page or contact your system administrator.");
            return;
        }

        v = [];
        rv.ReportData = [];
        rv.ShowModal = false;

        if (!(clients ?? []).Any())
        {
            Notify(NotificationSeverity.Warning, "Warning", "Please select at least one deployment to proceed..");
            return;
        }

        try
        {
            rv.Isloaded = true;

            var res = await _pisRep._02Empmas_EmployeeClerance(clients,  Uc.OpisDb!, Uc.Conn!);

            if (res?.Any() == true)
            {
                v = res.Select(r => new V2203Model
                {
                    EmpNumber   = r.EmpNumber,
                    EmpName     = r.EmpName,
                    ClName      = r.ClName,
                    Client_     = r.Client_,
                    Exp_Brgy    = r.Exp_Brgy,
                    Exp_Court   = r.Exp_Court,
                    Exp_Drug    = r.Exp_Drug,
                    Exp_Nbi     = r.Exp_Nbi,
                    Exp_Neuro   = r.Exp_Neuro,
                    Exp_Pnp     = r.Exp_Pnp,
                    Exp_Police  = r.Exp_Police,
                    ExpMed      = r.ExpMed,
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, "Failed to load data", "Please refresh the page or contact your system administrator.");
            Console.WriteLine(ex);
            return;
        }
        finally
        {
            rv.Isloaded = false;
        }

        if (!v.Any())
        {
            Notify(NotificationSeverity.Info, "Info", "No data found for this deployment.");
            return;
        }

        rv.ReportData = v;
        rv.ShowModal = true;
    }


    void ChildActionCatcher() { }

    void Notify(NotificationSeverity severity, string summary, string detail)
    {
        _NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }
    bool HasConnection()
    {
        if (Uc == null) return false;
        if (string.IsNullOrWhiteSpace(Uc.OpisDb)) return false;
        if (string.IsNullOrWhiteSpace(Uc.Conn)) return false;
        return true;
    }
}
