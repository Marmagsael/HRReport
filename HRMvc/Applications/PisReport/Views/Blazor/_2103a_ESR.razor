@using Blazorise
@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2103
@using HRMvc.Models.Report_PIS

<_00BT HdrCaption="Employee Status Report" >
    <Details>
        
        
        @if(v.RepDtls.Any()) { 
            <_02BTModal ShowModal="rv.ShowModal" ChildAction="ShowHideReport" MCaption="Report Preview"> 
                <Details>
                    <_2103_Report R2103="@v.RepDtls" />
                </Details>
            </_02BTModal>   }



        <div class="w-100 d-flex gap-2 p-2 bordered-bottom mt-2 ">
            <div @onclick="FetchData" class="mb-cbtn mb-cbtn-gray px-2 py-2 w-110p card ">
                Fetch Data 
            </div>

            <div class="mb-cbtn mb-cbtn-blue px-2 py-2 w-130p card @(v.RepDtls.Count>0?"": " disabled-div ") ">
                Create Report 
            </div>
        </div>

        @if(@v.Msg.Length > 0 ) {   <div class="w-100 text-danger border-bottom p-2"> @v.Msg  </div>  } 

        <div class="d-flex">
            <div class="w-50">
                <_2103_ClientList Clients="@rv.Clients" ChildAction="ChildActionCatcher" />
            </div>

            <div class="w-50">
                <_2103_StatusList Empstats="@empstats" ChildAction="ChildActionCatcher" />
            </div>
        </div> 

       
    </Details>
</_00BT>

@inject IOClientDataAccess      _client; 
@inject IOPisReportDataAccess   _pisRep; 
@inject IOEmpstatDataAccess     _empstat; 


@code {

    [Parameter] public UserClaimsModel Uc { get; set; } = new();  
    V00_RepVars         rv          = new V00_RepVars();  
    V2103Model          v           = new();
    List<OEmpstatModel> empstats    = [];

    protected override async Task OnParametersSetAsync()
    {
        if(rv.Isloaded) return; 
        rv.Clients  = []; 
        
        var res = await _client._02ByStatuss("Active", Uc.OpisDb!, Uc.Conn!); 
        if(res != null ) rv.Clients = res! ; 

        var res1 = await _empstat._02s(Uc.OpisDb!, Uc.Conn!); 
        empstats = res1!; 



        rv.Isloaded = true; 
    }

    protected override void OnInitialized()
    {
        rv.MCaption = "Employee Status Report";
        rv.RefreshToken = 21030000;
        rv.RelativePath = "Reports/_02HR/_2103_ESR.trdp";

    }

    private void ClientChanged(string clno) {
         rv.ClNumber    = clno;  
         v.RepDtls      =[]; 
    }

    async Task FetchData() {
        rv.ShowModal = false; 
        v.Msg = string.Empty;
        v.RepDtls=[]; 

        List<string> clNumbers = rv.Clients
                                    .Where(c => c.IsSelectedB && !string.IsNullOrWhiteSpace(c.ClNumber))
                                    .Select(c => c.ClNumber!)
                                    .ToList();
        List<string> statuses  = empstats
                                    .Where(e => e.IsSelectedB && !string.IsNullOrWhiteSpace(e.Code))
                                    .Select(e => e.Code!)
                                    .ToList();
        
         
        if (!clNumbers.Any())   { v.Msg = "Please select at least one payroll group to proceed."; return; }
        if (!statuses.Any())    { v.Msg = "Please select at least one status to proceed."; return; } 

        var res = await _pisRep._02ByClNumbersByStatus(clNumbers, statuses, Uc.OpisDb!,Uc.Conn!) ?? [];  
        if (!res.Any()) { v.Msg = "No records found for the selected payroll group and status."; return; } 
        
        rv.ShowModal = true;
        v.RepDtls = res.Select(r => new R2103Model 
            {
                EmpNumber  = r.EmpNumber    ?? "",
                EmpName    = r.EmpName      ?? "",
                ClName     = r.ClName       ?? "",
                StatusName = r.EmpStatus    ?? "",
                EmpStat    = r.EmpStat_     ?? ""
            }).ToList();

            

    }

    async Task ShowHideReport(bool ans) { rv.ShowModal = ans;  }
    

    void ChildActionCatcher() {

    }

}