<div class="card-header">
   Profile
</div>

<div class="card-body">


        <div class="field d-flex w-320p mt-2">
            <div class="label">Date Applied</div>
            <div class="line"></div>
        </div>

   

    @* ----- Name ----------*@
    <div class="d-flex align-items-start mt-2">
        <div class="label">Name :</div>

        <div class="fields">
            <div class="field">
                <div class="line"></div>
                <div class="sub-label">LAST</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">FIRST</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">MIDDLE NAME</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">MAIDEN</div>
            </div>

            <div class="field">
                <div class="line"></div>
                <div class="sub-label">NICKNAME</div>
            </div>
        </div>
    </div>

    @* ----- Address ----------*@
    <div class="field d-flex mt-2">
        <div class="label">Present Address :</div>
        <div class="line"></div>
    </div>



    <div class="d-flex align-items-center gap-3 w-100 mt-2">

        <div class="field w-320p d-flex align-items-center" style="max-width:320px">
            <div class="label">Years of Stay :</div>
            <div class="line"></div>
        </div>


        <div class="d-flex gap-1 flex-1 align-items-center">

            <div class="field d-flex align-items-center pe-5">
                <RadzenCheckBox Value="true" Disabled />
                <div class="label p-0 ps-2 w-0">Own</div>
            </div>

            <div class="field d-flex align-items-center pe-5">
                <RadzenCheckBox Value="true" Disabled />
                <div class="label p-0 ps-2 w-0">Rent</div>
            </div>

            <div class="field d-flex flex-1 align-items-center gap-2">
                <RadzenCheckBox Value="true" Disabled />
                <div class="label p-0 ps-2"> Others, please specify </div>
                <div class="line"></div>
            </div>

        </div>
    </div>



</div>

@code {
    DateTime date = new();
}

