<div class="card-header">
    Educational Background
</div>

<div class="card-body">

    <div class="border">
        <div class="d-flex gap-2 px-3 py-2 border-bottom fw-bold  bg-lightgray ">
            <div class="w-250p">     Type of School</div>
            <div class="w-250p">    Name of School  <div class="small fw-light">Acronym is not allowed</div></div>
            <div class="w-250p">    Location  <div class="small fw-light">Complete mailing address</div></div>
            <div class="w-250p">     No. of Yrs Completed  <div class="small fw-light">Pls write inclusive dates</div></div>
            <div class="w-250p">     Course/Major</div>
        </div>

        <div class="d-flex gap-2 px-3 py-2 border-bottom ">
            <div class="w-250p">     College</div>
        </div>
        <div class="d-flex gap-2 px-3 py-2 border-bottom ">
            <div class="w-250p">     Vocational or Trade School</div>
        </div>

        <div class="d-flex gap-2 px-3 py-2  ">
            <div class="w-250p">     High School</div>
        </div>

    </div>
   


</div>

@code {
    DateTime date = new();
}

