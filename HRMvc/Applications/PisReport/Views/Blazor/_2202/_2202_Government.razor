<div class="card-header">
    Government Records
</div>

<div class="card-body">

    <div class="d-flex mt-2">
        @* ----- SSS Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">SSS Number :</div>
            @{
                string test = "";
            }

            <div class="d-flex align-items-center">
                @for (int i = 0; i < 10; i++)
                {
                    if (i == 2 || i == 8)
                    {
                        <span>-</span>
                    }

                    <div class="char-box">
                        @(i<test.Length? test[i] : "")
                    </div>
                }
            </div>

        </div>


        @* ----- TIN Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">Tin Number :</div>
            <div class="d-flex align-items-center">
                @for (int i = 0; i < 10; i++)
                {
                    if (i == 2 || i == 8)
                    {
                        <span>-</span>
                    }

                    <div class="char-box">
                        @(i<test.Length? test[i] : "")
                    </div>
                }
            </div>

        </div>
    </div>


    <div class="d-flex mt-2">
        @* ----- Philhealth Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">Philhealth Number :</div>
            <div class="d-flex align-items-center">
                @for (int i = 0; i < 10; i++)
                {
                    if (i == 2 || i == 8)
                    {
                        <span>-</span>
                    }

                    <div class="char-box">
                        @(i<test.Length? test[i] : "")
                    </div>
                }
            </div>

        </div>


        @* ----- PAGIBIG Number ----------*@
        <div class="field d-flex w-50">
            <div class="label">PagIBIG Number :</div>
            <div class="d-flex align-items-center">
                @for (int i = 0; i < 10; i++)
                {
                    if (i == 2 || i == 8)
                    {
                        <span>-</span>
                    }

                    <div class="char-box">
                        @(i<test.Length? test[i] : "")
                    </div>
                }
            </div>

        </div>
    </div>


    <div class="d-flex">
        @* ----- Mobile Number ----------*@
        <div class="w-50">
            <div class="field d-flex w-320p mt-2">
                <div class="label">Mobile No. :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Position Applied For----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Position applied for :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <div class="w-50">
            @* ----- Security License No.----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Security License No. :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Driver'sLicense No.----------*@
            <div class="field d-flex w-420p mt-2">
                <div class="label">Driver's License No. :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <div class="w-50">
            @* ----- Security License Expiration Date----------*@
            <div class="field d-flex w-520p mt-2">
                <div class="label">Security License Expiration Date :</div>
                <div class="line"></div>
            </div>
        </div>

        <div class="w-50">
            @* ----- Driver's License Expiration Date.----------*@
            <div class="field d-flex w-520p mt-2">
                <div class="label">Driver's License Expiration Date :</div>
                <div class="line"></div>
            </div>
        </div>
    </div>

</div>

@code {
    DateTime date = new();
}
