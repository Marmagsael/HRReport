@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRMvc.Applications.PisReport.Vars
@using HRMvc.Applications.PisReport.Views.Blazor._2212
@using HRMvc.Applications.PisReport.Views.Blazor._2217

<_00BT HdrCaption="License Expiry" Rv="@rv">
    <Details>
        <div class="p-0"> 
            <div class="card-header">
                <div class="d-flex">


                    @*--- Date Range ------------------------------------------------*@
                   <_2212_DatePicker Rv = "@rv"/>
                    
                    @*--- Buttons ------------------------------------------------*@
                    <span @onclick="FetchData">
                        <div class="p-2 ms-2 card mb-cbtn mb-cbtn-gray">
                            Fetch Data
                        </div>
                    </span>
                    @if(v.Count > 0) 
                        { <span @onclick="CreateReport"> <div class="p-2 ms-1 card mb-cbtn mb-cbtn-blue"> Create Report </div> </span>}                   

                </div>
            </div>
        </div>

        @*--- Grid ------------------------------------------------*@
        <div>
            <_2217_Dtl V="@v"/>
        </div>
    
    </Details>
</_00BT>

@inject IOPisReportDataAccess _pisrep;

@code {
        [Parameter]public UserClaimsModel   Uc  {get; set;} = new();
        V00_RepVars                         rv  {get; set;} = new();
        List<V2217Model>                    v   {get; set;} = [];

    protected override void OnInitialized()
    {
        rv.DStart   = DateTime.Now;
        rv.DEnd     = DateTime.Now;

        rv.RelativePath = "Reports/_02HR/K_2217_LE.trdp";
        rv.RefreshToken = 2212000; 
        rv.MCaption     = "License Expiry";
    }

        async Task FetchData(){
        v = [];
        var status = new List<string> { "A","E","H","K","L","M","V","Y" };
        var res = await _pisrep._02Empmas_ByLicenseExpiry(rv.DStart,rv.DEnd,status,Uc.OpisDb!,Uc.Conn!);
                if(res.Any()){
            foreach(var f in res){
                V2217Model rec = new(){
                    EmpNumber   = f.EmpNumber,   
                    EmpName     = f.EmpName,
                    EmpStatus   = f.EmpStatus,     
                    LicExpire   = f.Licexpire,
                    SecLicense  = f.SecLicense,    
                    ClName      = f.ClName,     
                };
                v.Add(rec);
                     
        }
    }
        }

        async Task CreateReport()
    {


        rv.ReportData = v; 
		rv.ReportParams = []; 

		var res = await _pisrep._02CoInfo(Uc.OpisDb!, Uc.Conn!); 
		rv.ReportParams["CoName"]       = "-";
		rv.ReportParams["CoAddress"]    = "-";

		if (res.Count> 0) {
			var r = res.FirstOrDefault(); 
			rv.ReportParams["CoName"]       = r.CoName??"";
			rv.ReportParams["CoAddress"]    = r.CoAdd??"";
		}
        string dstart = rv.DStart?.ToString("d, MMMM yyyy") ?? "-";
        string dend = rv.DEnd?.ToString("d, MMMM yyyy") ?? "-";

        rv.ReportParams["DateRange"] = $"For the month covering {dstart} - {dend}";
		rv.ReportParams["RunDate"]      = DateTime.Now;
		rv.ReportParams["ReportTitle"]  = "Summary of Expired Licenses";
		
		
		rv.ShowModal = true;      
    }
}