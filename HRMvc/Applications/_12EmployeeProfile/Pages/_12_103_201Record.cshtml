@inject UserClaimsContextService ClaimsContext
@inject L12_103 L103


@{
    Layout = "~/Views/Shared/Main/_ReportLayout2.cshtml";
    var userClaims  = ClaimsContext.Build(User);
    var oEmpmas     = await L103._02Oempmass(userClaims);
    var oEducates   = await L103._02Oeducate(userClaims);
    var oEmergenc   = await L103._02OEmergenc(userClaims);
    var oFamily     = await L103._02OFamily(userClaims);
    var oGender     = await L103._02OGender(userClaims);
    var oCivstat    = await L103._02OCivstat(userClaims);
}

<div>

    @(await Html.RenderComponentAsync<_12_1032R>(RenderMode.ServerPrerendered, new { UserClaims = userClaims, 
                                                                                    Oempmass    = oEmpmas, 
                                                                                    oEducates   = oEducates,  
                                                                                    oFamilys    = oFamily,  
                                                                                    oEmergencs  = oEmergenc,    
                                                                                    Ogenders    = oGender, 
                                                                                    Ocivstats   = oCivstat
                                                                                     }))

</div>



