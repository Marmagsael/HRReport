@inject UserClaimsContextService ClaimsContext
@inject L12_103 L103


@{
    Layout = "~/Views/Shared/Main/_ReportLayout2.cshtml";
    var userClaims  = ClaimsContext.Build(User);
    // var OEmpmas     = await L103._02OEmpmass(userClaims);
    // var V12_103     = await L103.V12_103(userClaims);

}

<div>


    OpayDb = @userClaims.OpayDb  <br />
    OpisDb = @userClaims.OpisDb  <br />
    IsExclusiveCompany = : @userClaims.IsExclusiveCompany

    @if(userClaims.IsExclusiveCompany == "true")
    {
        @(await Html.RenderComponentAsync<_12_1032R>(RenderMode.ServerPrerendered, new { UserClaims = userClaims }))
    }
    else
    {
        <div class="alert alert-warning" role="alert"> This is not an exclusive company. </div>
    }

    @* @(await Html.RenderComponentAsync<_12_1032R>(RenderMode.ServerPrerendered, new { UserClaims = userClaims})) *@

</div>



