@inject UserClaimsContextService _claimsContext
@{
    Layout = "~/Views/Shared/_PISLayout.cshtml";
    var uc = _claimsContext.Build(User);
}


<div>

    @if(uc.IsExclusiveCompany == "false")
    {   @(await Html.RenderComponentAsync<_12_1032R>(RenderMode.ServerPrerendered, new { UserClaims = uc })) }
    else
    {   @(await Html.RenderComponentAsync<NE_12_1032R>(RenderMode.ServerPrerendered, new { UserClaims = uc })) }


</div>



