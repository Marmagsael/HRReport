@inject UserClaimsContextService ClaimsContext
@inject L12_102 L102 


@{
    Layout = "~/Views/Shared/Main/_ReportLayout2.cshtml";
    var userClaims  = ClaimsContext.Build(User);
    var oEmpmas = await L102._02Oempmass(userClaims); 
    var V12_102             = await L102.V12_102(userClaims);
}

<div>
    
    @(await Html.RenderComponentAsync<_12_102DB>(RenderMode.ServerPrerendered, 
        new { UserClaims = userClaims, Oempmass = oEmpmas, V12_102 = V12_102 }))

</div>







<script>
    window.startClock = function (elementId) {

        setInterval(function () {

            const now = new Date();

            const options = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            };

            const el = document.getElementById(elementId);
            if (el) {
                el.innerText = now.toLocaleString('en-US', options);
            }

        }, 1000);

    }
</script>