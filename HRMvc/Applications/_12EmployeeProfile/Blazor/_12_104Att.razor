@using HRApiLibrary.DataAccess._10_Pis.Attendance
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars
@using System.Globalization
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_104

<!-- SHOW ONLY ON MOBILE -->
<div class="d-lg-none">
    <button class="btn btn-primary w-100 mb-2"
            data-bs-toggle="modal"
            data-bs-target="#attendanceModal">
        View Attendance Details
    </button>
</div>

<_12_104_01Header/>

<!-- OVERVIEW -->
<_12_104_00AttendanceOverview V="@v" />

<div class="row g-3 p-2 w-100">

    <!--  CALENDAR -->
    <div class="col-12 col-lg-9">

        <div class="attendance-container">

            <_12_104_02MonthYearFilter V="@v" ChildAction="ChildAction" />

            <div class="calendar">
                <_12_104_04Weeks V="@v" />

                @for (int i = 0; i < v.Calendar.Count; i += 7)
                {
                    <div class="week-row">

                        @for (int j = i; j < i + 7 && j < v.Calendar.Count; j++)
                        {
                            var day = v.Calendar[j];

                            <div class="day-card @(day.Status) @(day.Date is null ? "empty" : "") @(day.IsToday ? "today" : "")"
                                 @onclick="() => SelectDay(day)">

                                @if (day.Date is not null)
                                {
                                    <_12_104_05Day D="day" />
                                    <_12_104_06Status D="day" />
                                    <div class="d-flex flex-column  justify-content-start gap-0">
                                        <_12_104_07Template D="day" />
                                        <_12_104_08Punches D="day" />
                                        <_12_104_09Tardiness D="day" />
                                        <_12_104_10UnderTime D="day" />
                                    </div>
                                    
                                }

                            </div>
                        }

                    </div>
                }
            </div>

        </div>

    </div>

    <!-- DETAILS -->
   <_12_104_11AttendanceDetails V="@v"/>

</div>


@inject IAttendanceDataAccess _att;

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; } = new();
    V12104Model v = new();

    protected override async Task OnInitializedAsync()
    {
        v.Months = Enumerable.Range(1, 12)
            .Select(m => new MonthItem
            {
                Value = m,
                Name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            }).ToList();

        v.Years = Enumerable.Range(2000, DateTime.Now.Year - 1999).ToList();

        await LoadDutyType();
        await LoadCalendar();
        if(v.Calendar.Any()) SelectDay(v.Calendar!.FirstOrDefault(d => d.Date == DateTime.Today) ?? new());
    }

    public async Task ChildAction()
    {
        if (v.Action == "GenerateCalendar") await LoadCalendar();

        v.Action = string.Empty;
    }

    private async Task LoadDutyType()
    {
        v.AttyDutyTypes = new();
        var res = await _att._02DutyTypes(Uc.SchemaUserPis!, Uc.Conn!);
        if (!res.Any()) return;
        v.AttyDutyTypes = res!;

    }


    private void SelectDay(DailyAttendance day)
    {
        v.DayDetail = new();
        v.DayDetail.Logs = new();
        v.DayDetail = v.Calendar? .FirstOrDefault(d => d.Date.HasValue && d.Date.Value.Date == day.Date) ?? new();
    }

    private async Task LoadCalendar()
    {
        v.Calendar = new();

        var firstDay = new DateTime(v.SelectedYear, v.SelectedMonth, 1);
        int daysInMonth = DateTime.DaysInMonth(v.SelectedYear, v.SelectedMonth);
        int startDay = (int)firstDay.DayOfWeek;

        var template = await _att._02TemplateByUserIdAndEffectivityDate(Uc.UserId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!);
        var attendance = await _att._02PunchesByEmpmasIdAndPunchInDate(Uc.UserId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!);


        for (int i = 0; i < startDay; i++) v.Calendar.Add(new DailyAttendance());

        for (int d = 1; d <= daysInMonth; d++)
        {
            var date = new DateTime(v.SelectedYear, v.SelectedMonth, d);
            v.Calendar.Add(LoadDays(date, template, attendance));
        }

        while (v.Calendar.Count % 7 != 0) v.Calendar.Add(new DailyAttendance());


        // Map Values for Stats Cards --------------------------------
        v.PresentCount      = v.Calendar.Count(c => c.Status.Contains("present"));
        v.LateCount         = v.Calendar.Count(c => c.Status.Contains("late"));
        v.UnderTimeCount    = v.Calendar.Count(c => c.Status.Contains("undertime"));
        v.AbsentCount       = v.Calendar.Count(c => c.Status.Contains("absent"));
        v.RestDayCount      = v.Calendar.Count(c => c.Status.Contains("rd"));
        v.DaysCount         = daysInMonth;

    }


    private DailyAttendance LoadDays(DateTime date, List<AtttemplatereqdtlModel?> template, List<Attpunches1Model?> attendance)
    {
        var dayTemplate     = GetTemplateForTheDay(date, template);
        var dayAttendance   = GetPunchesForTheDay(date, attendance);

        bool hasIn  = dayAttendance.PunchInDate != default;
        bool hasOut = dayAttendance.PunchOutDate != default;

        TimeSpan expTimeIn;
        TimeSpan expTimeOut;
        string dutyType         = string.Empty;
        string dutyTypeName     = string.Empty;
        TimeSpan ttlHrsWorked;
        TimeSpan workDuration;

        // Use actual punch data if available; otherwise use template values
        if (hasIn)
        {
            expTimeIn       = ConvertToTime(dayAttendance.PunchT);
            expTimeOut      = expTimeIn.Add(TimeSpan.FromHours(ConvertToHours(dayAttendance.SchedDuration)));
            dutyType        = dayAttendance.DutyTypeCode ?? string.Empty;
            dutyTypeName    = dayAttendance.DutyTypeName ?? string.Empty;
            ttlHrsWorked   = TimeSpan.FromMinutes(dayAttendance.TotalHrsWorked);
            workDuration    = ConvertToTime(dayAttendance.SchedDuration);
        }
        else
        {
            expTimeIn    = dayTemplate.ExpTimeIn;
            expTimeOut   = dayTemplate.ExpTimeOut;
            dutyType     = dayTemplate.DutyType;
            dutyTypeName = v.AttyDutyTypes?.Where(t => t.Code.Trim().ToLower() == dayTemplate.DutyType.Trim().ToLower()).FirstOrDefault().Name ?? "";
            workDuration = ConvertToTime((int)dayTemplate.DutyHrs);
            ttlHrsWorked = TimeSpan.Zero;
        }

        DateTime? actIn = hasIn ? dayAttendance.PunchInDate : (DateTime?)null;
        DateTime? actOut = hasOut ? dayAttendance.PunchOutDate : (DateTime?)null;

        var result = GetStatusLateUnderTimeHours( dayTemplate.AttendanceType,  dutyType, date,expTimeIn, actIn,  expTimeOut, actOut,   dayAttendance.SchedDuration, (int)dayAttendance.TotalHrsWorked );

        var status              = string.Join(", ", result.Select(x => x.Status));
        var lateduration        = result.FirstOrDefault(x => x.Status == "late").Time ?? "";
        var undertimeduration   = result.FirstOrDefault(x => x.Status == "undertime").Time ?? "";


        return new DailyAttendance
        {
            Date                    = date,
            ExpectedTimeIn          = expTimeIn,
            ExpectedTimeOut         = expTimeOut,
            TimeIn                  = actIn,
            TimeOut                 = actOut,
            IsToday                 = date.Date == DateTime.Today,
            DutyType                = dutyType,
            DutyTypeName            = dutyTypeName,
            AttendanceType          = dayTemplate.AttendanceType,
            Status                  = status,
            LateDuration            = lateduration,
            UnderTimeDuration       = undertimeduration,
            TotalHoursWorked        = Format(ttlHrsWorked),
            ExpectedTotalHours      = Format(workDuration),
            Logs                    = dayAttendance?.Logs ?? new List<Attpunches1Model>()
        };

    }

    private List<(string Status, string Time)> GetStatusLateUnderTimeHours(string atttype, string? dutyType, DateTime date, TimeSpan expIn, DateTime? actDateTimeIn, TimeSpan expOut, DateTime? actDateTimeOut, int expMinutes, int workedMinutes)
    {
        var duty = (dutyType ?? "").Trim().ToUpper();
        var currDate = DateTime.Today;
        var currTime = DateTime.Now.TimeOfDay;

        var attendanceType = atttype.Trim().Replace(" ", "").ToLower();


        var res = new List<(string Status, string Time)>();
        TimeSpan? actIn = actDateTimeIn?.TimeOfDay;
        TimeSpan? actOut = actDateTimeOut?.TimeOfDay;

        bool noLogs = !actIn.HasValue && !actOut.HasValue;

        if (duty == "RD")
        {
            res.Add(("rd", ""));
            return res;
        }

        if (duty != "R" || date.Date > currDate) return res;

        // ================= FIXED SCHEDULE =================
        if (attendanceType == "fixedattendance")
        {
            if (noLogs)
            {
                if (date.Date < currDate)
                {
                    res.Add(("absent", ""));
                    return res;
                }

                // BEFORE SHIFT START
                if (currTime <= expIn)
                {
                    return res; 
                }

                // DURING SHIFT 
                if (currTime > expIn && currTime <= expOut)
                {
                    res.Add(("present", ""));
                    res.Add(("late", Format(currTime - expIn)));
                    return res;
                }

                // AFTER SHIFT END 
                if (currTime > expOut)
                {
                    res.Add(("absent", ""));
                    return res;
                }
            }

            if (actIn.HasValue && actIn > expIn)
            {
                res.Add(("present", ""));
                res.Add(("late", Format(actIn.Value - expIn)));
            }

            Console.WriteLine($"{actDateTimeOut} || {actDateTimeIn}");

            if ((actDateTimeOut.Value.Date == actDateTimeIn.Value.Date) && actOut.HasValue && actOut < expOut)
            {
                res.Add(("present", ""));
                res.Add(("undertime", Format(expOut - actOut.Value)));
            }


            return res;
        }

        // ================= FLEXIBLE SCHEDULE =================
        if (atttype == "flexibleattendance")
        {
            if (noLogs)
            {
                if (date.Date < currDate)
                    res.Add(("absent", ""));

                return res;
            }

            if (workedMinutes < expMinutes)
            {
                var remaining = TimeSpan.FromMinutes(expMinutes - workedMinutes);
                res.Add(("present", ""));
                res.Add(("undertime", Format(remaining)));
            }

            return res;
        }

        return res;
    }


    public AttTempRes GetTemplateForTheDay(DateTime date, List<AtttemplatereqdtlModel?> template)
    {
        var d = template?.Where(t => t != null && date >= t.Effectivity && date < t.EffectivityEnd).OrderByDescending(t => t.Effectivity).FirstOrDefault();

        if (d == null) return new AttTempRes();

        int day = (int)date.DayOfWeek;

        var ins     = new[] { d.D7_In, d.D1_In, d.D2_In, d.D3_In, d.D4_In, d.D5_In, d.D6_In };
        var hrs     = new[] { d.D7_HrsLength, d.D1_HrsLength, d.D2_HrsLength, d.D3_HrsLength, d.D4_HrsLength, d.D5_HrsLength, d.D6_HrsLength };
        var types   = new[] { d.D7_DutyType, d.D1_DutyType, d.D2_DutyType, d.D3_DutyType, d.D4_DutyType, d.D5_DutyType, d.D6_DutyType };

        var start   = ConvertToTime(ins[day]);
        var hours   = hrs[day];

        return new AttTempRes
        {
            ExpTimeIn = start,
            ExpTimeOut = start.Add(TimeSpan.FromHours(hours)),
            DutyType = types[day] ?? "",
            DutyHrs = hours,
            AttendanceType = d.AttendanceType ?? ""
        };
    }


    public Attpunches1Model GetPunchesForTheDay(DateTime date, List<Attpunches1Model?> attendance)
    {
        var current = attendance .Where(a => a != null && a.PunchInDate.Date == date.Date) .OrderBy(a => a.PunchInDate).ToList();

        if (!current.Any()) return new Attpunches1Model();

        TimeSpan totalWorked = TimeSpan.Zero;

        foreach (var c in current)
        {
            if (c.PunchOutDate > c.PunchInDate) totalWorked += (c.PunchOutDate - c.PunchInDate);
        }

        var first = current.First();
        var last = current.Last();

        return new Attpunches1Model
        {
            Dayno           = first.Dayno,
            PunchInDate     = first.PunchInDate,
            SchedDuration   = first.SchedDuration,
            PunchT          = first.PunchT,
            PunchOutDate    = last.PunchOutDate,
            DutyTypeCode    = first.DutyTypeCode,
            DutyTypeName    = first.DutyTypeName,
            TotalHrsWorked = (int)totalWorked.TotalMinutes,
            Logs            = current!

        };
    }


   


    private TimeSpan ConvertToTime(int value)
    {
        return new TimeSpan(value / 100, value % 100, 0);
    }

    private double ConvertToHours(int value)
    {
        return (value / 100) + (value % 100 / 60.0);
    }

    private  string Format(TimeSpan time)
        {
            int m = (int)Math.Round(time.TotalMinutes);
            return $"{m / 60} hr {m % 60} min";
        }
}



