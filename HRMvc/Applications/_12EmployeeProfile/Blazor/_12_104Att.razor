@using System.Globalization
@using HRApiLibrary.DataAccess._10_Pis.Attendance
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_104
@using Radzen

<div>
    <_12_104_01Header />

    <div class="attendance-container">
        <_12_104_02MonthYearFilter V="@v" ChildAction="ChildAction" />

        <div class="calendar">
            <_12_104_04Weeks V="@v" />

            @for (int i = 0; i < v.Calendar.Count; i += 7)
            {
                <div class="week-row">

                    @for (int j = i; j < i + 7 && j < v.Calendar.Count; j++)
                    {
                        var day = v.Calendar[j];

                        <div class="day-card @(day.Status) @(day.Date is null ? "empty" : "") @(day.IsToday ? "today" : "")">

                            @if (day.Date is not null)
                            {
                                <_12_104_05Day D="day" />
                                <_12_104_06Status D="day" />

                                <div>
                                    <div class="d-flex gap-2">
                                        <_12_104_07Template D="day" />    <span class="time-separator">/</span>
                                        <_12_104_08Punches D="day" />
                                    </div>

                                    <_12_104_09Tardiness D="day" />
                                    <_12_104_10UnderTime D="day" />
                                </div>
                            }
                        </div>
                    }

                </div>
            }
        </div>
    </div>
</div>

@inject IAttpunches1DataAccess _attPunches1;
@inject IAtttemplateNDataAccess _attTemplate;
@inject IAttdutytypeNDataAccess _attDutyType;

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }
    V12104Model v = new();

    protected override async Task OnInitializedAsync()
    {
        v.Months = Enumerable.Range(1, 12)
            .Select(m => new MonthItem
            {
                Value = m,
                Name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            }).ToList();

        v.Years = Enumerable.Range(2000, DateTime.Now.Year - 1999).ToList();

        await GenerateCalendar();
    }

    private async Task GenerateCalendar()
    {
        v.Calendar = new();

        var firstDay    = new DateTime(v.SelectedYear, v.SelectedMonth, 1);
        int daysInMonth = DateTime.DaysInMonth(v.SelectedYear, v.SelectedMonth);
        int startDay    = (int)firstDay.DayOfWeek;

        var template     = await _attTemplate._02(Uc.UserId, Uc.SchemaUserPis!, Uc.Conn!) ?? new List<AtttemplateModel?>();
        var attendance   = await _attPunches1._02ByMonthAndYear(Uc.UserId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!) ?? new List<Attpunches1Model?>();


        for (int i = 0; i < startDay; i++) v.Calendar.Add(new DailyAttendance());

        for (int d = 1; d <= daysInMonth; d++)
        {
            var date = new DateTime(v.SelectedYear, v.SelectedMonth, d);
            v.Calendar.Add(GenerateDay(date, template, attendance));
        }

        while (v.Calendar.Count % 7 != 0) v.Calendar.Add(new DailyAttendance());
    }



    private DailyAttendance GenerateDay(DateTime date, List<AtttemplateModel?> template, List<Attpunches1Model?> attendance)
    {
        var schedule = GetScheduleForTheDay((int)date.DayOfWeek, template);


        var punchIn     = attendance?.FirstOrDefault(p => p.PunchInDate.Date == date.Date) ?? new();
        var punchOut    = attendance?.LastOrDefault(p => p.PunchInDate.Date == date.Date) ?? new();

        var dutyType    = string.IsNullOrWhiteSpace(punchIn?.DutyType) ? schedule.DutyType : punchIn.DutyType;
        TimeSpan expTimeIn = punchIn.PunchT != 0 ? ConvertToTime(punchIn.PunchT) : schedule.ExpTimeIn;
        TimeSpan expTimeOut = TimeSpan.Zero;

        if (punchIn.SchedDuration != 0)
        {
            expTimeOut = expTimeIn.Add(TimeSpan.FromHours(ConvertToHours(punchIn.SchedDuration)));
        }
        else
        {
            expTimeOut = schedule.ExpTimeOut;
        }

        var attRes = GetStatusAndLateUnderTimeHours(dutyType, date, expTimeIn, punchIn?.PunchInDate.TimeOfDay, expTimeOut, punchOut?.PunchOutDate.TimeOfDay);
        return new DailyAttendance
        {
            Date        = date,
            ExpTimeIn   = expTimeIn,
            ExpTimeOut  = expTimeOut,
            TimeIn      = punchIn?.PunchInDate.TimeOfDay,
            TimeOut     = punchOut?.PunchOutDate.TimeOfDay,
            IsToday     = date.Date == DateTime.Today,
            DutyType    = dutyType,
            Status      = attRes.Status,
            Late        = attRes.Late,
            UnderTime   = attRes.Undertime
        };
    }



    public async Task ChildAction()
    {
        if (v.Action == "GenerateCalendar") await GenerateCalendar();

        v.Action = string.Empty;
    }

    private AttTempRes GetScheduleForTheDay(int day, List<AtttemplateModel?> data)
    {
        var d = data?.FirstOrDefault();
        if (d == null) return new AttTempRes();

        var ins         = new[] { d.D7_in, d.D1_in, d.D2_in, d.D3_in, d.D4_in, d.D5_in, d.D6_in };
        var hrs         = new[] { d.D7_hrslength, d.D1_hrslength, d.D2_hrslength, d.D3_hrslength, d.D4_hrslength, d.D5_hrslength, d.D6_hrslength };
        var types       = new[] { d.D7_dutytype, d.D1_dutytype, d.D2_dutytype, d.D3_dutytype, d.D4_dutytype, d.D5_dutytype, d.D6_dutytype };

        var start = ConvertToTime(ins[day]);
        var hours = ConvertToHours(hrs[day]);

        return new AttTempRes
        {
            ExpTimeIn   = start,
            ExpTimeOut  = start.Add(TimeSpan.FromHours(hours)),
            DutyType    = types[day] ?? "",
            DutyHrs     = hours
        };
    }

    private (string Status, string Late, string Undertime) GetStatusAndLateUnderTimeHours( string? dutyType,DateTime date, TimeSpan? expIn,  TimeSpan? actIn, TimeSpan? expOut, TimeSpan? actOut)
    {
        var duty    = (dutyType ?? "").Trim().ToUpper();
        var today   = DateTime.Today;
        var now     = DateTime.Now.TimeOfDay;

        if (duty == "RD") return ("rd", "", "");
        if (duty != "R" || date.Date > today) return ("", "", "");

        var time = string.Empty;

        // Helper ----------------------------
        string FormatTime(TimeSpan ts)
        {
            int totalMinutes = (int)Math.Round(ts.TotalMinutes);
            int h = totalMinutes / 60;
            int m = totalMinutes % 60;
            return $"{h} hr {m} min";
        }

        bool noLogs = !actIn.HasValue && !actOut.HasValue;

        // ABSENT ------------------------------
        if (noLogs)
        {
            if (date.Date < today)
                return ("absent", "", "");

            if (expIn.HasValue && now > expIn.Value)
            {
                time = FormatTime(now - expIn.Value);
                return ("late", time, "");
            }

            return ("", "", "");
        }
         
        // LATE -----------------------------------
        if (expIn.HasValue && actIn.HasValue && actIn > expIn)
        {
            time = FormatTime(actIn.Value - expIn.Value);
            return ("late", time, "");
        }

        // UNDERTIME ------------------------------------------
        if (expOut.HasValue && (actOut != TimeSpan.Zero) && actOut < expOut)
        {
            
            time = FormatTime(expOut.Value - actOut.Value);
            return ("undertime", "", time);
        }

        return ("", "", "");
    }

    private TimeSpan ConvertToTime(int value)
    {
        return new TimeSpan(value / 100, value % 100, 0);
    }

    private double ConvertToHours(int value)
    {
        return (value / 100) + (value % 100 / 60.0);
    }


}




<style>
    .attendance-container {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
    }


    .calendar {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        width: 100%;
    }


    .week-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }

    .day-card {
        min-height: 140px;
        border: 1px solid #f1f5f9;
        background: #fff;
        padding: 6px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: 0.2s;
    }

        .day-card:hover {
            background: #f9fafb;
            cursor: pointer;
        }

        .day-card.empty {
            background: #fafafa;
        }

        .day-card.today {
            background: #eff6ff;
            border: 1px solid #3b82f6;
        }




    .block {
        padding: 2px 8px;
        font-size: 10px;
        line-height: 1;
    }


    .block-title {
        font-size: 9px;
        font-weight: 800;
        color: #6b7280;
    }

    .time-separator {
        font-size: 9px;
        font-weight: 800;
        color: #6b7280;
    }
</style>