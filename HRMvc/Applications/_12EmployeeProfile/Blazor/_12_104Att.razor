@using HRApiLibrary.DataAccess._10_Pis.Attendance
@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_104
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_104.AttCalendar
@using System.Globalization


<div>
    <_12_104_AttHeadder />

    <div class="d-flex flex-column gap-3 p-2">
        <_12_104_AttMonthOverview V="@v" />

        <div class="row g-3">
            <_12_104_AttCalendar V="@v" ChildAction="ChildAction"/>
            <_12_104_AttDayOverview V="@v" />
        </div>

    </div>
   
</div>



@inject IAttendanceDataAccess _att;
@inject ISettingsDataAccess _sett;

@code {

    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    V12104Model v = new();


    protected override async Task OnInitializedAsync()
    {
        GetMonths();
        GetYears();
        await LoadSettings();
        await LoadDutyTypes();
        await LoadCalendar();
        if (v.Calendar.Any()) SelectDay(DateTime.Today);
    }


    private void GetMonths()
    {
        v.Months = Enumerable.Range(1, 12)
            .Select(m => new MonthItem
            {
                Value = m,
                Name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            }).ToList();
    }

    private void GetYears()
    {
        v.Years = Enumerable.Range(2000, DateTime.Now.Year - 1999).ToList();
    }

    private async Task LoadSettings()
    {
        var res = await _sett._02(1, Uc.SchemaUserPay!, Uc.Conn!);
        if (res != null) v.Settings = res!;
    }

    private async Task LoadDutyTypes()
    {
        var res = await _att._02DutyTypes(Uc.SchemaUserPis!, Uc.Conn!);
        if (res.Any()) v.AttyDutyTypes = res!;
    }

    private void SelectDay(DateTime date)
    {
        v.DayDetail = v.Calendar.FirstOrDefault(d => d.Date == date);
    }

    public async Task ChildAction()
    {
        if (v.Action == "GenerateCalendar") await LoadCalendar();
        v.Action = string.Empty;
    }


    // ============================================================
    // CALENDAR LOADER
    // ============================================================

    private async Task LoadCalendar()
    {
        v.Calendar = new();
        if (Uc == null) return;

        int? userId     = Uc.UserId;
        var firstDay    = new DateTime(v.SelectedYear ?? 1, v.SelectedMonth ?? 1, 1);
        int daysInMonth = DateTime.DaysInMonth(v.SelectedYear ?? 1, v.SelectedMonth ?? 1);
        int startDay    = (int)firstDay.DayOfWeek;

        var template    = await _att._02TemplateByUserIdAndEffectivityDate(userId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!);
        var punches     = await _att._02PunchesByEmpmasIdAndPunchInDate(userId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!);
        var leaves      = await _att._02LeaveByEmpmasIdAndLeaveDuration(userId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn!);

        // Leading boxes before the actual day start
        for (int i = 0; i < startDay; i++)
            v.Calendar.Add(new AttDayDetail());

        for (int d = 1; d <= daysInMonth; d++)
            v.Calendar.Add(LoadDay(new DateTime(v.SelectedYear ?? 1, v.SelectedMonth ?? 1, d), punches, template, leaves));

        // Trailing boxes to fill the calendar
        while (v.Calendar.Count % 7 != 0)
            v.Calendar.Add(new AttDayDetail());

        ComputeSummary();
    }


    // ============================================================
    // SUMMARY COUNTER
    // ============================================================

    private void ComputeSummary()
    {
        decimal presentCount    = 0;
        decimal absentCount     = 0;
        decimal daysCount       = 0;
        int lateCount           = 0;
        int undertimeCount      = 0;

        var workingDays = v.Calendar.Where(c => c.Date != default && !(c.Status ?? "").Contains("RD")) .ToList();

        foreach (var day in workingDays)
        {
            var s = day.Status ?? "";

            bool hasLeave = !string.IsNullOrWhiteSpace(day.LeaveType);
            bool isHalfDay = s.Contains("1/2");

            // Whole-day leave: 
            bool isWholeDayLeave = hasLeave && !isHalfDay && !s.Contains("PRESENT") && !s.Contains("ABSENT");
            if (isWholeDayLeave) continue;

            // Half-day leave: 
            daysCount += isHalfDay && hasLeave ? 0.5m : 1m;

            if (s.Contains("1/2 PRESENT")) presentCount += 0.5m;
            else if (s.Contains("PRESENT")) presentCount += 1m;

            if (s.Contains("1/2 ABSENT")) absentCount += 0.5m;
            else if (s.Contains("ABSENT")) absentCount += 1m;

            if (s.Contains("LATE")) lateCount++;
            if (s.Contains("UNDERTIME")) undertimeCount++;
        }

        v.PresentCount      = presentCount;
        v.AbsentCount       = absentCount;
        v.LateCount         = lateCount;
        v.UnderTimeCount    = undertimeCount;
        v.RestDayCount      = v.Calendar.Count(c => (c.Status ?? "").Contains("RD"));
        v.DaysCount         = daysCount;
    }


    // ============================================================
    // DAY LOADER
    // ============================================================

    private AttDayDetail LoadDay(DateTime date, List<Attpunches1Model?> punches, List<AtttemplatereqdtlModel?> template, List<AttLeaveapplicationModel?> leave)
    {
        var resTemp         = LoadTemplate(date, template);
        var resPunches      = LoadPunches(date, punches);

        bool hasPunch = resPunches.ActualTimeIn.HasValue;


        TimeSpan? expTimeIn;
        TimeSpan? expTimeOut;
        string? dutyTypeCode;
        int? duration;
        TimeSpan? ttlWorkedHrs;
        List<Attpunches1Model?> logs;

        if (hasPunch)
        {
            expTimeIn       = resPunches.ExpTimeIn;
            expTimeOut      = resPunches.ExpTimeOut;
            dutyTypeCode    = resPunches.DutyTypeCode;
            duration        = resPunches.Duration;
            ttlWorkedHrs    = resPunches.TotalWorkedHrs;
            logs            = resPunches.Logs;
        }
        else
        {
            expTimeIn       = resTemp.ExpTimeIn;
            expTimeOut      = resTemp.ExpTimeOut;
            dutyTypeCode    = resTemp.DutyTypeCode;
            duration        = resTemp.Duration;
            ttlWorkedHrs    = TimeSpan.Zero;
            logs            = new();
        }

        var resLeave = LoadLeave(date, leave, dutyTypeCode);
        var resStatus = GetStatus(resTemp.AttendanceTypeId, dutyTypeCode, date, expTimeIn, expTimeOut, resPunches.ActualTimeIn, resPunches.ActualTimeOut, duration, resLeave, ttlWorkedHrs);

        string status               = string.Join(", ", resStatus.Select(x => x.Status));
        string lateDuration         = resStatus.FirstOrDefault(x => x.Status == "LATE").Time ?? "";
        string undertimeDuration    = resStatus.FirstOrDefault(x => x.Status == "UNDERTIME").Time ?? "";
        var leaveEntry              = resStatus.FirstOrDefault(x => x.lr != null && !string.IsNullOrWhiteSpace(x.lr.LeaveType));



        return new AttDayDetail
            {
                Date                = date,
                ExpTimeIn           = expTimeIn,
                ExpTimeOut          = expTimeOut,
                ActualTimeIn        = resPunches.ActualTimeIn,
                ActualTimeOut       = resPunches.ActualTimeOut,
                DutyTypeCode        = dutyTypeCode,
                DutyTypeName        = v.AttyDutyTypes.FirstOrDefault(d => d.Code == dutyTypeCode)?.Name ?? string.Empty,
                AttendanceType      = resTemp.AttendanceType,
                Status              = status,
                IsToday             = date.Date == DateTime.Today,
                ExpWorkingHrs       = FormatTime(ConvertToTime(duration)),
                TtlWorkedHrs        = FormatTime(resPunches.TotalWorkedHrs),
                LateDuration        = lateDuration,
                UnderTimeDuration   = undertimeDuration,
                Logs                = logs,
                LeaveType           = leaveEntry.lr?.LeaveType,   
                LeaveStart          = leaveEntry.lr?.LeaveStart,  
                LeaveEnd            = leaveEntry.lr?.LeaveEnd,    
                Reason              = leaveEntry.lr?.Reason,     
            };
    }

    // ============================================================
    // TEMPLATE LOADER
    // ============================================================

    private AttTemplate LoadTemplate(DateTime date, List<AtttemplatereqdtlModel?> template)
    {
        var t = template?.Where(t => date >= t.Effectivity && date < t.EffectivityEnd).OrderByDescending(t => t.Effectivity).FirstOrDefault();

        if (t == null) return new AttTemplate();

        int day = (int)date.DayOfWeek;

        var timeIns     = new[] { t.D1_In, t.D2_In, t.D3_In, t.D4_In, t.D5_In, t.D6_In, t.D7_In };
        var durations   = new[] { t.D1_HrsLength, t.D2_HrsLength, t.D3_HrsLength, t.D4_HrsLength, t.D5_HrsLength, t.D6_HrsLength, t.D7_HrsLength };
        var dutyTypes   = new[] { t.D1_DutyType, t.D2_DutyType, t.D3_DutyType, t.D4_DutyType, t.D5_DutyType, t.D6_DutyType, t.D7_DutyType };

        int? start = timeIns[day];
        int? hours = durations[day];

        return new AttTemplate
        {
            ExpTimeIn           = ConvertToTime(start),
            ExpTimeOut          = GetTimeOut(start, hours),
            DutyTypeCode        = dutyTypes[day] ?? string.Empty,
            AttendanceType      = t.AttendanceType ?? string.Empty,
            AttendanceTypeId    = t.AttendanceTypeId,
            Duration            = hours ?? 0
        };
    }


    // ============================================================
    // PUNCHES LOADER
    // ============================================================

    private AttPunches LoadPunches(DateTime date, List<Attpunches1Model?> punches)
    {
        var logs = punches.Where(p => p?.PunchInDate != null && p.PunchInDate.Value.Date == date.Date).OrderBy(p => p!.PunchInDate).ToList();

        if (logs.Count == 0) return new AttPunches();

        TimeSpan totalWorked = TimeSpan.Zero;
        foreach (var log in logs)
        {
            if (log?.PunchInDate != null && log.PunchOutDate != null && log.PunchOutDate > log.PunchInDate)
                totalWorked += log.PunchOutDate.Value - log.PunchInDate.Value;
        }

        var firstIn = logs.Min(p => p!.PunchInDate);
        var lastOut = logs.Max(p => p!.PunchOutDate);

        var first   = logs.First();
        var last    = logs.Last();

        var dutyType = v.AttyDutyTypes?.FirstOrDefault(d => d.Id == first.DutyTypeId) ?? new();

        return new AttPunches
        {
            ExpTimeIn       = ConvertToTime(first.PunchT),
            ExpTimeOut      = GetTimeOut(first.PunchT, first.SchedDuration),
            ActualTimeIn    = firstIn,
            ActualTimeOut   = lastOut,
            DutyTypeCode    = dutyType.Code ?? "",
            Duration        = first.SchedDuration,
            TotalWorkedHrs  = totalWorked,
            Logs            = logs
        };
    }


    // ============================================================
    // LEAVE LOADER
    // ============================================================

    private AttLeaveapplicationModel? LoadLeave(DateTime date, List<AttLeaveapplicationModel?> leave, string? dutyTypeCode)
    {
        var dType = NormalizeCode(dutyTypeCode);

        // Leave only applies to Regular and Regular Normal duty types
        if (dType != "R" && dType != "RN") return null;

        var res = leave?.FirstOrDefault(l => l != null && date.Date == l.Start.Date);
        if (res == null) return null;

        return new AttLeaveapplicationModel
        {
            LvStart         = res.LvStart,
            LvEnd           = res.LvEnd,
            Reason          = res.Reason,
            Start           = res.Start,
            End             = res.End,
            DutyType        = res.DutyType,
            LeaveName       = res.LeaveName,
            LeaveCode       = res.LeaveCode,
            TimeStart       = res.TimeStart,
            TimeDuration    = res.TimeDuration,
            CreditedHrs     = res.CreditedHrs,
            ExpLeaveStart   = ConvertToTime(res.TimeStart),
            ExpLeaveEnd     = GetTimeOut(res.TimeStart, res.TimeDuration)
        };
    }


    // ============================================================
    // GET STATUS/MARK
    // Flow: Leave -> Rest Day  → Regular Normal → Regular -> Attendance Type
    // ============================================================

    private List<(string Status, string Time, AttLeave lr)> GetStatus(    int? attType, string? dutyType, DateTime? date,TimeSpan? expTimeIn, TimeSpan? expTimeOut,   DateTime? actualDateTimeIn, DateTime? actualDateTimeOut,  int? expWorkDuration, AttLeaveapplicationModel? leave, TimeSpan? ttlWorkedHrs)
    {
        var result = new List<(string Status, string Time, AttLeave lr)>();

        if (date == null) return result;

        var aType = attType;
        var dType = NormalizeCode(dutyType);


        DateTime? actualIn  = actualDateTimeIn.HasValue ? StripSeconds(actualDateTimeIn.Value) : null;
        DateTime? actualOut = actualDateTimeOut.HasValue ? StripSeconds(actualDateTimeOut.Value) : null;

        DateTime shiftStart = StripSeconds(date.Value.Date + expTimeIn!.Value);
        DateTime shiftEnd   = expWorkDuration.HasValue ? StripSeconds(GetTimeOut(shiftStart, expWorkDuration)!.Value) : shiftStart;

        var (firstHalfEnd, secondHalfStart, halfDuration) = GetHalfBoundaries(shiftStart, shiftEnd);

        DateTime today  = DateTime.Today;
        DateTime now    = StripSeconds(DateTime.Now);

        bool hasApprovedLeave   = leave != null && !string.IsNullOrWhiteSpace(leave.LeaveCode);
        bool hasPunch           = actualIn.HasValue;

        foreach (var dty in v.AttyDutyTypes)
        {
            if (dType == dty.Code)
            {
                result.Add((dty.Code.ToUpper() ?? "", "", new()));
            }
        }


        // == 1. WITH LEAVE =======================================
        if (hasApprovedLeave)
        {
            result.AddRange(GetLeaveStatus(leave!, aType, dType, date.Value, shiftStart, shiftEnd, firstHalfEnd, secondHalfStart, actualIn, actualOut, halfDuration, expWorkDuration, ttlWorkedHrs, today, now));
            return result;
        }

        // == 2. REST DAY =========================================
        if (dType == "RD") return result;


        // == 3. REGULAR NORMAL ===================================
        if (dType == "RN")
        {
            result.AddRange(GetRegularNormalStatus(date.Value, actualIn, today));
            return result;
        }


        // == 4. REGULAR ==========================================
        if (dType == "R")
        {
            result.AddRange(GetRegularStatus(aType, date.Value, shiftStart, shiftEnd,  firstHalfEnd, secondHalfStart, actualIn, actualOut,  expWorkDuration, ttlWorkedHrs, today, now));
        }

        return result;
    }

    // ============================================================
    // LEAVE STATUS
    // Rule:
    //   Whole day leave (any type)          [LeaveCode] only
    //   Half day leave — RN                 [LeaveCode], PRESENT, no late/undertime/absent
    //   Half day leave — FIXED/FLEXIBLE     1/2 [LeaveCode]  ,full late/undertime/absent checks
    // ============================================================

    private List<(string Status, string Time, AttLeave lr)> GetLeaveStatus(AttLeaveapplicationModel leave, int? aType, string dType, DateTime date, DateTime shiftStart, DateTime shiftEnd, DateTime firstHalfEnd, DateTime secondHalfStart, DateTime? actualIn, DateTime? actualOut, TimeSpan halfDurationTs, int? expWorkDuration, TimeSpan? ttlWorkedHrs, DateTime today, DateTime now)
    {
        var result = new List<(string Status, string Time, AttLeave lr)>();

        DateTime leaveStart = StripSeconds(leave.Start.Date + leave.ExpLeaveStart!.Value);
        DateTime leaveEnd = StripSeconds(GetTimeOut(leaveStart, leave.TimeDuration)!.Value);

        var attLeave = new AttLeave
        {
            LeaveType = leave.LeaveName,
            LeaveStart = leaveStart,
            LeaveEnd = leaveEnd,
            Reason = leave.Reason
        };

        bool isWholeDay = expWorkDuration == leave.TimeDuration;



        // Whole-day leave  =============================
        if (isWholeDay)
        {
            result.Add((leave.LeaveCode ?? "", "", attLeave));
            return result;
        }



        // Regular Normal =============================
        if (dType == "RN")
        {
            result.Add((leave.LeaveCode ?? "", "", attLeave));
            if (date <= today)
            {
                if (actualIn.HasValue)
                {
                    result.Add(("PRESENT" ?? "", "", attLeave));
                }
            }

            return result;
        }


        // Half-day leave
        bool leaveIsMorning = leaveStart < firstHalfEnd && leaveEnd > shiftStart;
        bool leaveIsAfternoon = leaveStart < shiftEnd && leaveEnd > secondHalfStart;
        int halfDuration = ConvertToHHMM(halfDurationTs);


        result.Add(($"1/2 {leave.LeaveCode}", "", attLeave));

        bool isExempt = aType == 3; // Exempt Attendance

        // Exempt =============================
        if (isExempt)
        {
            if (date <= today)
            {
                if (actualIn.HasValue)
                {
                    result.Add(("PRESENT" ?? "", "", attLeave));
                }
            }

            return result;
        }

        // Regular ========================================
        if (date.Date < today)
            return GetHalfLeave_PastDate(result, aType, dType, leaveIsMorning, leaveIsAfternoon, actualIn, actualOut, shiftStart, shiftEnd, firstHalfEnd, secondHalfStart, halfDuration, ttlWorkedHrs);


        if (date.Date == today)
            return GetHalfLeave_Today(result, aType, dType, leaveIsMorning, leaveIsAfternoon, shiftStart, firstHalfEnd, secondHalfStart, halfDuration, ttlWorkedHrs, now);


        // Future date: show leave tag only, no presence yet
        return result;
    }


    // ==  Half Day Leave — Past Date =========================================
    private List<(string Status, string Time, AttLeave lr)> GetHalfLeave_PastDate(List<(string Status, string Time, AttLeave lr)> result,
        int? aType, string dType,
        bool leaveIsMorning, bool leaveIsAfternoon,
        DateTime? actualIn, DateTime? actualOut,
        DateTime shiftStart, DateTime shiftEnd,
        DateTime firstHalfEnd, DateTime secondHalfStart,
        int? halfDuration, TimeSpan? ttlWorkedHrs)
    {


        // Regular
        if (!actualIn.HasValue)
        {
            result.Add(("1/2 ABSENT", "", new()));
            return result;
        }

        bool isFlexible = aType == 2; //FLEXIBLE ATTENDANCE

        if (isFlexible)
        {
            // Flexible: undertime = half expected duration - total worked hours
            if (halfDuration.HasValue && ttlWorkedHrs.HasValue)
            {
                TimeSpan expected = ConvertToTime(halfDuration);
                TimeSpan worked = ttlWorkedHrs.Value;
                if (worked < expected)
                    result.Add(("UNDERTIME", FormatTime(expected - worked), new()));
            }
        }
        else
        {
            // Fixed: late and undertime based on shift boundaries
            if (leaveIsMorning)
            {
                // Working half = AFTERNOON
                if (actualIn.Value > secondHalfStart)
                    result.Add(("LATE", FormatTime(actualIn.Value - secondHalfStart), new()));

                if (actualOut.HasValue && actualOut.Value < shiftEnd)
                    result.Add(("UNDERTIME", FormatTime(shiftEnd - actualOut.Value), new()));
            }
            else if (leaveIsAfternoon)
            {
                // Working half = MORNING
                if (actualIn.Value > shiftStart)
                    result.Add(("LATE", FormatTime(actualIn.Value - shiftStart), new()));

                if (actualOut.HasValue && actualOut.Value < firstHalfEnd)
                    result.Add(("UNDERTIME", FormatTime(firstHalfEnd - actualOut.Value), new()));
            }
        }

        result.Add(("1/2 PRESENT", "", new()));
        return result;
    }


    // ── Half Day Leave — Today ───────────────────────────────────

    private List<(string Status, string Time, AttLeave lr)> GetHalfLeave_Today(
        List<(string Status, string Time, AttLeave lr)> result,
        int? aType, string dType,
        bool leaveIsMorning, bool leaveIsAfternoon,
        DateTime shiftStart, DateTime firstHalfEnd,
        DateTime secondHalfStart, int? halfDuration,
        TimeSpan? ttlWorkedHrs, DateTime now)
    {

        bool isFlexible = aType == 2; //FLEXIBLEATTENDANCE

        if (isFlexible)
        {
            // Flexible: check undertime only if punch already recorded
            if (ttlWorkedHrs.HasValue && halfDuration.HasValue)
            {
                TimeSpan expected = ConvertToTime(halfDuration);
                TimeSpan worked = ttlWorkedHrs.Value;
                if (worked < expected)
                    result.Add(("UNDERTIME", FormatTime(expected - worked), new()));

                result.Add(("1/2 PRESENT", "", new()));
            }
        }
        else
        {
            // Fixed: check late on the working half
            if (leaveIsMorning)
            {
                // Working half = AFTERNOON
                if (now > secondHalfStart)
                    result.Add(("LATE", FormatTime(now - secondHalfStart), new()));
                else
                    result.Add(("1/2 ABSENT", "", new()));
            }
            else if (leaveIsAfternoon)
            {
                // Shift hasn't started yet
                if (now < shiftStart) return result;

                if (now > shiftStart && now <= firstHalfEnd)
                    result.Add(("LATE", FormatTime(now - shiftStart), new()));
                else
                    result.Add(("1/2 ABSENT", "", new()));
            }
        }

        return result;
    }




    // ============================================================
    // REGULAR NORMAL STATUS (Duty Type = RN)
    // ============================================================
    // Not mandatory. No absent/late computation.
    // Punch in = Present. No half-day leave. Future = blank.

    private List<(string Status, string Time, AttLeave lr)> GetRegularNormalStatus(
        DateTime date, DateTime? actualIn, DateTime today)
    {
        var result = new List<(string Status, string Time, AttLeave lr)>();

        if (date.Date <= today && actualIn.HasValue)
            AddPresent(result);

        return result;
    }



    // ============================================================
    // REGULAR DAY STATUS (Duty Type = R)
    // ============================================================

    private List<(string Status, string Time, AttLeave lr)> GetRegularStatus( int? aType, DateTime date, DateTime shiftStart, DateTime shiftEnd,   DateTime firstHalfEnd, DateTime secondHalfStart, DateTime? actualIn, DateTime? actualOut,
        int? expWorkDuration, TimeSpan? ttlWorkedHrs,
        DateTime today, DateTime now)
    {
        return aType switch
        {
            1 => GetFixedStatus(date, shiftStart, shiftEnd, firstHalfEnd, secondHalfStart, actualIn, actualOut, today, now),
            2 => GetFlexibleStatus(date, actualIn, expWorkDuration, ttlWorkedHrs, today),
            _ => new()
        };
    }



    // == FIXED Attendance =========================================
    // Late      = punch in vs shift start (lunch break excluded if duty hours is not compressed (8hrs))
    // Undertime = punch out vs shift end
    // Absent    = no punch
    private List<(string Status, string Time, AttLeave lr)> GetFixedStatus( DateTime date, DateTime shiftStart, DateTime shiftEnd, DateTime firstHalfEnd, DateTime secondHalfStart, DateTime? actualIn, DateTime? actualOut,  DateTime today, DateTime now)
    {
        var result = new List<(string Status, string Time, AttLeave lr)>();
        bool hasPunch = actualIn.HasValue;

        // Past or Today 
        if (date.Date <= today)
        {
            if (hasPunch)
            {
                AddPresentWithComputationsOfLateAndUnderTime(result, actualIn!.Value, actualOut, shiftStart, shiftEnd);
                return result;
            }

            // Past date — no punch
            if (date.Date < today)
            {
                AddAbsent(result);
                return result;
            }

            // Today — no punch yet
            if (now < shiftStart) return result;
            if (now >= shiftEnd) { AddAbsent(result); return result; }

            // Shift started but no punch — running late
            result.Add(("LATE", FormatTime(ComputeLate(now, shiftStart)), new()));
            return result;
        }

        // Future date
        return result;
    }

    // == FLEXIBLE Attendance ======================================
    // Undertime = expected duration - total worked hours
    // No late; absent = no punch
    private List<(string Status, string Time, AttLeave lr)> GetFlexibleStatus(
        DateTime date, DateTime? actualIn,
        int? expWorkDuration, TimeSpan? ttlWorkedHrs,
        DateTime today)
    {
        var result = new List<(string Status, string Time, AttLeave lr)>();

        // Future date
        if (date.Date > today) return result;

        // Past or Today
        if (!actualIn.HasValue) { AddAbsent(result); return result; }

        if (expWorkDuration.HasValue && ttlWorkedHrs.HasValue)
        {
            TimeSpan expected = ConvertToTime(expWorkDuration);
            TimeSpan worked = ttlWorkedHrs.Value;
            if (worked < expected)
                result.Add(("UNDERTIME", FormatTime(ComputeUnderTime(expected, worked)) , new()));
        }

        AddPresent(result);
        return result;
    }



    // ============================================================
    // UTILITY HELPERS
    // ============================================================


    private void AddAbsent(List<(string Status, string Time, AttLeave lr)> result)
        => result.Add(("ABSENT", "", new()));

    private void AddPresent(List<(string Status, string Time, AttLeave lr)> result)
        => result.Add(("PRESENT", "", new()));

    private void AddPresentWithComputationsOfLateAndUnderTime( List<(string Status, string Time, AttLeave lr)> result, DateTime actualIn, DateTime? actualOut, DateTime shiftStart, DateTime shiftEnd)
    {
        if (actualIn > shiftStart)
            result.Add(("LATE", FormatTime(ComputeLate(actualIn, shiftStart)), new()));

        if (actualOut.HasValue && actualOut.Value < shiftEnd)
            result.Add(("UNDERTIME", FormatTime(shiftEnd - actualOut.Value), new()));

        AddPresent(result);
    }

    // Adjusts duration excluding lunch break for non-compressed work hours
    private TimeSpan AdjustForLunchBreak(TimeSpan duration)
    {
        if (v.Settings.Daytohours > 8)
        {
            if (duration.TotalHours > 5)
                return duration - new TimeSpan(1, 0, 0);

            if (duration.TotalHours > 4)
                return new TimeSpan(4, 0, 0);
        }
        return duration;
    }

    // Computes late duration excluding lunch break
    private TimeSpan ComputeLate(DateTime punchIn, DateTime shiftStart)
    {
        TimeSpan lateDuration = punchIn - shiftStart;
        return AdjustForLunchBreak(lateDuration);
    }

    // Computes Undertime duration excluding lunch break if duty hours is not compressed
    private TimeSpan ComputeUnderTime(TimeSpan expectedHrsWrked, TimeSpan actualHrsWrked)
    {
        TimeSpan underTimeDuration = expectedHrsWrked - actualHrsWrked;
        return AdjustForLunchBreak(underTimeDuration);
    }

    // Splits shift into first half, lunch break, and second half
    private (DateTime firstHalfEnd, DateTime secondHalfStart, TimeSpan halfDuration) GetHalfBoundaries(
        DateTime shiftStart, DateTime shiftEnd)
    {
        TimeSpan breakTime = TimeSpan.FromHours(1);
        TimeSpan halfDuration = TimeSpan.FromTicks((shiftEnd - shiftStart - breakTime).Ticks / 2);
        DateTime firstHalfEnd = StripSeconds(shiftStart + halfDuration);
        DateTime secondHalfStart = StripSeconds(firstHalfEnd + breakTime);
        return (firstHalfEnd, secondHalfStart, halfDuration);
    }

    // Converts HHMM int to TimeSpan (e.g. 800 → 8:00, 1330 → 13:30)
    public static TimeSpan ConvertToTime(int? hhmm)
    {
        if (hhmm is null or <= 0) return TimeSpan.Zero;
        return new TimeSpan(hhmm.Value / 100, hhmm.Value % 100, 0);
    }

    // Converts TimeSpan to HHMM int format (e.g. 08:30 → 830, 13:45 → 1345)
    public static int ConvertToHHMM(TimeSpan time)
    {
        return (time.Hours * 100) + time.Minutes;
    }

    // Computes shift end from start time + duration (both in HHMM)
    public TimeSpan GetTimeOut(int? timeIn, int? duration) =>
        ConvertToTime(timeIn) + ConvertToTime(duration);

    // Computes end DateTime from start DateTime + duration (HHMM)
    public DateTime? GetTimeOut(DateTime? date, int? duration) =>
        date.HasValue && duration.HasValue ? date.Value + ConvertToTime(duration) : null;

    // Formats a TimeSpan as "0 hr 0 min"
    public static string FormatTime(TimeSpan? duration)
    {
        if (duration is null) return string.Empty;
        int total = (int)Math.Floor(duration.Value.TotalMinutes);
        return $"{total / 60} hr {total % 60} min";
    }

    // Strips seconds from a TimeSpan
    public TimeSpan StripSeconds(TimeSpan? time) =>
        time.HasValue ? new TimeSpan(time.Value.Hours, time.Value.Minutes, 0) : TimeSpan.Zero;

    // Strips seconds from a DateTime
    public DateTime StripSeconds(DateTime dt) =>
        new DateTime(dt.Year, dt.Month, dt.Day, dt.Hour, dt.Minute, 0);

    // Normalizes duty/attendance type codes for safe comparison
    private static string NormalizeCode(string? code) =>
        code?.Trim().Replace(" ", "").ToUpper() ?? "";
}

