@using System.Globalization
@using HRApiLibrary.DataAccess._10_Pis.Attendance
@using HRApiLibrary.Models._10_Pis
@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars
@using Radzen

<div>

    <div class="card-header fw-bold">Attendance</div>

    <div class="p-2">
        <div class="attendance-container">

            <div class="d-flex justify-content-between">

                     <!-- FILTERS -->
                <div class="filter-bar d-flex gap-3">
                    <div class="filter-item">
                        <span>Month</span>
                        <RadzenDropDown Data="@v.Months"
                                        TextProperty="Name"
                                        ValueProperty="Value"
                                        @bind-Value="v.SelectedMonth"
                                        Change="@(_ => GenerateCalendar())"
                                        Style="width: 160px" />
                    </div>

                    <div class="filter-item">
                        <span>Year</span>
                        <RadzenDropDown Data="@v.Years"
                                        @bind-Value="v.SelectedYear"
                                        Change="@(_ => GenerateCalendar())"
                                        Style="width: 120px" />
                    </div>
                </div>


                <!-- LEGEND -->
                <div class="legend">
                    <div><span class="dot present"></span> Present</div>
                    <div><span class="dot late"></span> Late</div>
                    <div><span class="dot late"></span> UnderTime</div>
                    <div><span class="dot absent"></span> Absent</div>
                    <div><span class="dot rd"></span> Rest Day</div>
                </div>
            </div>
           

            <!-- CALENDAR -->
            <div class="calendar">

                <div class="weekdays">
                    @foreach (var w in v.Weeks)
                    {
                        <div>@w</div>
                    }
                </div>

                @for (int i = 0; i < v.Calendar.Count; i += 7)
                {
                    <div class="week-row">

                        @for (int j = i; j < i + 7 && j < v.Calendar.Count; j++)
                        {
                            var day = v.Calendar[j];

                            <div class="day-card
                                                        @(day.Date == null ? "empty" : "")
                                                        @(day.IsToday ? "today" : "")">

                                @if (day.Date != null)
                                {
                                    <div class="day-top">
                                        <div class="date-pill @day.Status">
                                            @day.Date?.Day
                                        </div>
                                    </div>

                                    <div class="mt-5">
                                        <div class="block expected rounded-bottom-0 rounded-top">
                                            <div class="block-title">SCHEDULE</div>
                                            <span class="time">  @day.ExpTimeIn?.ToString(@"hh\:mm") </span> -
                                            <span class="time"> @day.ExpTimeOut?.ToString(@"hh\:mm")</span>
                                        </div>

                                        <div class="block actual rounded-top-0 rounded-bottom d-flex flex-column gap-2">
                                            <div class="time"> <span class="d-inline-block w-100p" style="width:40px">IN</span>   @day.TimeIn?.ToString(@"hh\:mm")</div>
                                            <div class="time"> <span class="d-inline-block w-100p" style="width:40px">OUT</span>  @day.TimeOut?.ToString(@"hh\:mm")</div>
                                        </div>
                                    </div>

                                   
                                }

                            </div>
                        }

                    </div>
                }

            </div>

         

        </div>
    </div>

</div>

@inject IAttpunches1DataAccess _attPunches1;
@inject IAtttemplateNDataAccess _attTemplate;
@inject IAttdutytypeNDataAccess _attDutyType;

@code {
    [Parameter] public UserClaimsModel? Uc { get; set; }
    V12104Model v = new();

    protected override async Task OnInitializedAsync()
    {
        v.Months = Enumerable.Range(1, 12)
            .Select(m => new MonthItem
            {
                Value = m,
                Name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
            }).ToList();

        v.Years = Enumerable.Range(2000, DateTime.Now.Year - 1999).ToList();

        v.AttyDutyTypes = await _attDutyType._02(Uc.SchemaUserPis!, Uc.Conn!) ?? new List<AttdutytypeModel?>();
        await GenerateCalendar();
    }

    private async Task GenerateCalendar()
    {
        v.Calendar = new();

        var firstDay    = new DateTime(v.SelectedYear, v.SelectedMonth, 1);
        int daysInMonth = DateTime.DaysInMonth(v.SelectedYear, v.SelectedMonth);
        int startDay    = (int)firstDay.DayOfWeek;

        var template    = await _attTemplate._02(Uc.UserId, Uc.SchemaUserPis!, Uc.Conn!) ?? new List<AtttemplateModel?>();
        var attendance = await _attPunches1._02ByMonthAndYear(Uc.UserId, v.SelectedMonth, v.SelectedYear, Uc.SchemaUserPis!, Uc.Conn! );

        for (int i = 0; i < startDay; i++) v.Calendar.Add(new DailyAttendance());

        for (int d = 1; d <= daysInMonth; d++)
        {
            var date = new DateTime(v.SelectedYear, v.SelectedMonth, d);

            var schedule = GetScheduleForTheDay((int)date.DayOfWeek, template);
            var punchIn = attendance?.FirstOrDefault(p => p.PunchInDate.Date == date.Date);
            var punchOut = attendance?.LastOrDefault(p => p.PunchInDate.Date == date.Date);

            v.Calendar.Add(new DailyAttendance
                {
                    Date = date,
                    ExpTimeIn = schedule.ExpTimeIn,
                    ExpTimeOut = schedule.ExpTimeOut,
                    TimeIn = punchIn.PunchInDate.TimeOfDay,
                    TimeOut = punchOut.PunchOutDate.TimeOfDay,
                    IsToday = date.Date == DateTime.Today,
                Status = GetStatus(punchIn.DutyType, ConvertToTime(punchIn.PunchT), punchIn.PunchInDate.TimeOfDay, ConvertToTime(punchIn.SchedDuration), punchOut.PunchOutDate.TimeOfDay)
                });
        }

        while (v.Calendar.Count % 7 != 0) v.Calendar.Add(new DailyAttendance());
    }

    private TimeSpan ConvertToTime(int value)
    {
        int h = value / 100;
        int m = value % 100;
        return new TimeSpan(h, m, 0);
    }

    private double ConvertToHours(int value)
    {
        int h = value / 100;
        int m = value % 100;
        return h + (m / 60.0);
    }

    private class AttTempRes
    {
        public TimeSpan ExpTimeIn { get; set; }
        public TimeSpan ExpTimeOut { get; set; }
        public string DutyType { get; set; } = "";
    }

    private AttTempRes GetScheduleForTheDay(int day, List<AtttemplateModel?>? data)
    {
        if (data == null || !data.Any()) return new AttTempRes();

        var d = data.FirstOrDefault();
        if (d == null || day < 0 || day > 6) return new AttTempRes();

        var timeIns = new[]
        {
            d.D7_in, d.D1_in, d.D2_in, d.D3_in, d.D4_in, d.D5_in, d.D6_in
        };

        var dutyHrs = new[]
        {
            d.D7_hrslength, d.D1_hrslength, d.D2_hrslength, d.D3_hrslength, d.D4_hrslength, d.D5_hrslength, d.D6_hrslength
        };

        var dutyTypes = new[]
        {
            d.D7_dutytype, d.D1_dutytype, d.D2_dutytype, d.D3_dutytype, d.D4_dutytype, d.D5_dutytype, d.D6_dutytype
        };

        var start = ConvertToTime(timeIns[day]);
        var hours = ConvertToHours(dutyHrs[day]);
        var dutyType = dutyTypes[day];

        return new AttTempRes
        {
            ExpTimeIn = start,
            ExpTimeOut = start.Add(TimeSpan.FromHours(hours)),
            DutyType = dutyType ?? string.Empty
        };
    }

    private string GetStatus( string dutyType,   TimeSpan scheduledTime, TimeSpan actualTimeIn, TimeSpan scheduledDuration,  TimeSpan actualTimeOut)
    {

        return "Present";
    }
}

<style>
    /* MAIN WRAPPER - FIXED FULL WIDTH */
    .attendance-container {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
        gap: 16px;
        width:100%;
    }

    /* FILTERS */
    .filter-bar {
        display: flex;
        gap: 20px;
    }

    .filter-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #6b7280;
    }

    /* REMOVE CENTER CONSTRAINT */
    .calendar {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        width: 80%;
    }

    /* WEEK HEADER */
    .weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        text-align: center;
        padding: 10px 0;
        background: #f9fafb;
    }

    /* ROW */
    .week-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }

    /* DAY CELL - FIX SIZE */
    .day-card {
        min-height: 140px; /* IMPORTANT FIX (prevents squish) */
        border: 1px solid #f1f5f9;
        background: #fff;
        padding: 6px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: 0.2s;
    }

        .day-card:hover {
            background: #f9fafb;
            cursor: pointer;
        }

        .day-card.empty {
            background: #fafafa;
        }

        /* TODAY */
        .day-card.today {
            background: #eff6ff;
            border: 1px solid #3b82f6;
        }

    /* DATE */
    .day-top {
        position: absolute;
        top: 6px;
        left: 6px;
    }

    .date-pill {
        min-width: 26px;
        height: 22px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* CONTENT FIX */
    .block {
        /* margin-top: 28px; */
        padding: 6px 8px;
        font-size: 10px;
        line-height: 1.2;
    }

    /* MAKE TEXT CLEANER */
    .block-title {
        font-size: 9px;
        font-weight: 800;
        margin-bottom: 4px;
        color: #6b7280;
    }

    /* EXPECTED */
    .expected {
        /* background: #f1f5f9; */
    }

    /* ACTUAL */
    .actual {
        /* background: #ecfdf5; */
    }

    /* TIME TEXT */
    .time {
        font-size: 10px;
        color: #374151;
    }

    /* LEGEND */
    .legend {
        display: flex;
        gap: 16px;
        font-size: 12px;
        color: #6b7280;
        flex-wrap: wrap;
    }

        .legend .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }

    .present {
        background: #22c55e;
    }

    .late {
        background: #facc15;
    }

    .absent {
        background: #ef4444;
    }

    .rd {
        background: #9ca3af;
    }
</style>