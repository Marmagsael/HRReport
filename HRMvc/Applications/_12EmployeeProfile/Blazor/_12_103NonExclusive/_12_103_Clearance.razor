@using HRApiLibrary.Models._10_Pis.OPis

@{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Clearance" />
        @Row("NBI Expire", e.Exp_Nbi?.ToString("MM/dd/yyyy"))
        @Row("Police Expire", e.Exp_Police?.ToString("MM/dd/yyyy"))
        @Row("PNP Expire", e.Exp_Pnp?.ToString("MM/dd/yyyy"))
        @Row("Barangay Expire", e.Exp_Brgy?.ToString("MM/dd/yyyy"))
        @Row("Neuro Expire", e.Exp_Neuro?.ToString("MM/dd/yyyy"))
        @Row("Drug Test Expire", e.Exp_Drug?.ToString("MM/dd/yyyy"))
        @Row("Court Expire", e.Exp_Court?.ToString("MM/dd/yyyy"))
        @LastRow("Medical Expire", e.ExpMed?.ToString("MM/dd/yyyy"))
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

    RenderFragment Row(string label, string? value) =>
    @<div class="d-flex gap-2 border-bottom">
        <div class="p-2 ps-3 w-175p border-end">@label</div>
        <div class="p-2 px-3">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div>
    </div>;

    RenderFragment LastRow(string label, string? value) =>
    @<div class="d-flex gap-2">
        <div class="p-2 ps-3 w-175p border-end">@label</div>
        <div class="p-2 px-3">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div>
    </div>;
}