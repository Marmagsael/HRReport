@using HRMvc.Applications._12EmployeeProfile.Vars
@using HRMvc.Applications._00GeneralComponents.BodyComponents

<TelerikRootComponent>

    <TelerikLoaderContainer Visible="@v.IsLoading"
                            LoaderType="@LoaderType.ConvergingSpinner" />

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <div class="card r-container  h-100 d-flex flex-column" style="min-height:95.5vh;">

        @* --- Header --- *@
        <BodyHdr pageTitle="Password Management" />

        @* --- Form --- *@
        <EditForm Model="@v.User"
                    OnSubmit="@UpdatePassword"
                    class="h-100 d-flex flex-column">

            @* --- Change Password Button --- *@
            <div class="p-2 bordered-bottom d-flex bg-lightgray flex-shrink-0">

                <button class="card p-2 text-center h-35p mb-btn mb-btn-blue"
                        type="submit"
                        tabindex="5">
                    Change Password
                </button>

            </div>


            <div class="px-2 ps-md-3 pt-3  ">

                @* --- Current User --- *@
                <div class="d-flex flex-column flex-md-row mb-2">

                    <label class="fw-normal w-180p">
                        Current User
                    </label>

                    <div class="col-12 col-md-7 col-lg-5 ">

                        <TelerikTextBox @bind-Value="@v.User.LogName"
                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                        ReadOnly
                                        TabIndex="1"
                                        AutoComplete="off">

                            <TextBoxSuffixTemplate>
                                <TelerikFontIcon Icon="@FontIcon.User"
                                                    Size="@ThemeConstants.FontIcon.Size.Small" />
                            </TextBoxSuffixTemplate>

                        </TelerikTextBox>

                    </div>

                </div>


                @* --- Old Password --- *@
                <div class="d-flex flex-column flex-md-row mb-2">

                    <label class="fw-normal w-180p">
                        Old Password
                    </label>

                    <div class="col-12 col-md-7 col-lg-5 ">

                        <TelerikTextBox @bind-Value="@v.User.Password"
                                        Password="!v.ShowOldPassword"
                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                        TabIndex="2"
                                        AutoComplete="off"
                                        Class="@(string.IsNullOrWhiteSpace(v.OldPasswordErrorMsg) ? "" : "k-invalid")">

                            <TextBoxSuffixTemplate>
                                <TelerikFontIcon Icon="@(v.ShowOldPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                    Size="@ThemeConstants.FontIcon.Size.Small"
                                                    @onclick="() => v.ShowOldPassword = !v.ShowOldPassword" />
                            </TextBoxSuffixTemplate>

                        </TelerikTextBox>

                        @if (!string.IsNullOrWhiteSpace(v.OldPasswordErrorMsg))
                        {
                            <div class="txt-red small">
                                @v.OldPasswordErrorMsg
                            </div>
                        }

                    </div>

                </div>


                @* --- New Password --- *@
                <div class="d-flex flex-column flex-md-row mb-2">

                    <label class="fw-normal w-180p">
                        New Password
                    </label>

                    <div class="col-12 col-md-7 col-lg-5 ">

                        <TelerikTextBox @bind-Value="@v.User.NewPassword"
                                        Password="!v.ShowNewPassword"
                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                        TabIndex="3"
                                        AutoComplete="off"
                                        Class="@(string.IsNullOrWhiteSpace(v.NewPasswordErrorMsg) ? "" : "k-invalid")">

                            <TextBoxSuffixTemplate>
                                <TelerikFontIcon Icon="@(v.ShowNewPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                    Size="@ThemeConstants.FontIcon.Size.Small"
                                                    @onclick="() => v.ShowNewPassword = !v.ShowNewPassword" />
                            </TextBoxSuffixTemplate>

                        </TelerikTextBox>

                        @if (!string.IsNullOrWhiteSpace(v.NewPasswordErrorMsg))
                        {
                            <div class="txt-red small">
                                @v.NewPasswordErrorMsg
                            </div>
                        }

                    </div>

                </div>


                @* --- Verify Password --- *@
                <div class="d-flex flex-column flex-md-row">

                    <label class="fw-normal w-180p">
                        Verify Password
                    </label>

                    <div class="col-12 col-md-7 col-lg-5 ">

                        <TelerikTextBox @bind-Value="@v.User.VerifyPassword"
                                        Password="!v.ShowVerifyPassword"
                                        Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                        FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                        TabIndex="4"
                                        AutoComplete="off"
                                        Class="@(string.IsNullOrWhiteSpace(v.VerificationPasswordErrorMsg) ? "" : "k-invalid")">

                            <TextBoxSuffixTemplate>
                                <TelerikFontIcon Icon="@(v.ShowVerifyPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                    Size="@ThemeConstants.FontIcon.Size.Small"
                                                    @onclick="() => v.ShowVerifyPassword = !v.ShowVerifyPassword" />
                            </TextBoxSuffixTemplate>

                        </TelerikTextBox>

                        @if (!string.IsNullOrWhiteSpace(v.VerificationPasswordErrorMsg))
                        {
                            <div class="txt-red small">
                                @v.VerificationPasswordErrorMsg
                            </div>
                        }

                    </div>

                </div>

            </div>

        </EditForm>


    </div>

</TelerikRootComponent>
@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V12002Model v = new();

    private TelerikNotification? NotificationRef;


    private bool IsFormValid()
    {
        var isnull = false;

        if (string.IsNullOrWhiteSpace(v.User.Password))
        {
            v.OldPasswordErrorMsg = "Old password is required";
            isnull = true;
        }

        if (string.IsNullOrWhiteSpace(v.User.NewPassword))
        {
            v.NewPasswordErrorMsg = "New password is required";
            isnull = true;
        }

        if (string.IsNullOrWhiteSpace(v.User.VerifyPassword))
        {
            v.VerificationPasswordErrorMsg = "Verify password is required";
            isnull = true;
        }



        if (isnull) return false;

        if (v.User.NewPassword == v.User.Password)
        {
            v.NewPasswordErrorMsg = "New password must be different from old password";
            return false;
        }

        if (v.User.NewPassword.Length < 8)
        {
            v.NewPasswordErrorMsg = "New password should be at least 8 characters";
            return false;
        }

        if (v.User.NewPassword != v.User.VerifyPassword)
        {
            v.VerificationPasswordErrorMsg = "Passwords do not match";
            return false;
        }

        return true;
    }


    private async Task UpdatePassword()
    {
        if (!IsFormValid()) return;
    }
}