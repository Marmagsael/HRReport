@using HRApiLibrary.DataAccess._00_Main.Interface
@using HRMvc.Applications._12EmployeeProfile.Vars


<TelerikRootComponent>
    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <_00BT_FullW HdrCaption="Password">
        <Details>

            <EditForm Model="@v.User" OnSubmit="@UpdatePassword" class="h-100 d-flex flex-column">

                <div class="p-0">
                    <div class="card-header d-flex gap-3">
                        <button class="card p-2 px-3 text-center h-35p mb-btn mb-btn-blue" type="submit" tabindex="5">
                            Change Password
                        </button>
                    </div>
                </div>

                <div class="px-2 ps-md-3 pt-3">

                    @* --- Current User --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-180p">Current User</label>

                        <div class="col-12 col-md-7 col-lg-5">
                            <TelerikTextBox @bind-Value="@v.User.LoginName"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            ReadOnly
                                            Enabled="false"
                                            TabIndex="1">
                                <TextBoxSuffixTemplate>
                                    <TelerikFontIcon Icon="@FontIcon.User" Size="@ThemeConstants.FontIcon.Size.Small" />
                                </TextBoxSuffixTemplate>
                            </TelerikTextBox>
                        </div>
                    </div>

                    @* --- Old Password --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-180p">Old Password</label>

                        <div class="col-12 col-md-7 col-lg-5">
                            <TelerikTextBox @bind-Value="@v.User.Password"
                                            Password="!v.ShowOldPassword"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="2"
                                            AutoComplete="off"
                                            MaxLength="150"
                                            Class="@(string.IsNullOrWhiteSpace(v.OldPasswordErrorMsg) ? "" : "k-invalid")">

                                <TextBoxSuffixTemplate>
                                    <TelerikFontIcon Icon="@(v.ShowOldPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                     Size="@ThemeConstants.FontIcon.Size.Small"
                                                     @onclick="() => v.ShowOldPassword = !v.ShowOldPassword" />
                                </TextBoxSuffixTemplate>

                            </TelerikTextBox>

                            @if (!string.IsNullOrWhiteSpace(v.OldPasswordErrorMsg))
                            {
                                <div class="txt-red small">@v.OldPasswordErrorMsg</div>
                            }
                        </div>
                    </div>

                    @* --- New Password --- *@
                    <div class="d-flex flex-column flex-md-row mb-2">
                        <label class="fw-normal w-180p">New Password</label>

                        <div class="col-12 col-md-7 col-lg-5">
                            <TelerikTextBox @bind-Value="@v.User.NewPassword"
                                            Password="!v.ShowNewPassword"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="3"
                                            AutoComplete="off"
                                            MaxLength="150"
                                            Class="@(string.IsNullOrWhiteSpace(v.NewPasswordErrorMsg) ? "" : "k-invalid")">

                                <TextBoxSuffixTemplate>
                                    <TelerikFontIcon Icon="@(v.ShowNewPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                     Size="@ThemeConstants.FontIcon.Size.Small"
                                                     @onclick="() => v.ShowNewPassword = !v.ShowNewPassword" />
                                </TextBoxSuffixTemplate>

                            </TelerikTextBox>

                            @if (!string.IsNullOrWhiteSpace(v.NewPasswordErrorMsg))
                            {
                                <div class="txt-red small">@v.NewPasswordErrorMsg</div>
                            }
                        </div>
                    </div>

                    @* --- Verify Password --- *@
                    <div class="d-flex flex-column flex-md-row">
                        <label class="fw-normal w-180p">Verify Password</label>

                        <div class="col-12 col-md-7 col-lg-5">
                            <TelerikTextBox @bind-Value="@v.User.VerifyPassword"
                                            Password="!v.ShowVerifyPassword"
                                            Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                            FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                            TabIndex="4"
                                            MaxLength="150"
                                            AutoComplete="off"
                                            Class="@(string.IsNullOrWhiteSpace(v.VerificationPasswordErrorMsg) ? "" : "k-invalid")">

                                <TextBoxSuffixTemplate>
                                    <TelerikFontIcon Icon="@(v.ShowVerifyPassword? FontIcon.Eye: FontIcon.EyeSlash)"
                                                     Size="@ThemeConstants.FontIcon.Size.Small"
                                                     @onclick="() => v.ShowVerifyPassword = !v.ShowVerifyPassword" />
                                </TextBoxSuffixTemplate>

                            </TelerikTextBox>

                            @if (!string.IsNullOrWhiteSpace(v.VerificationPasswordErrorMsg))
                            {
                                <div class="txt-red small">@v.VerificationPasswordErrorMsg</div>
                            }
                        </div>
                    </div>

                </div>

            </EditForm>

        </Details>
    </_00BT_FullW>

</TelerikRootComponent>

@inject I_00UsersAccess _user;

@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    private V12002Model v = new();
    private TelerikNotification? NotificationRef;

    protected override async Task OnInitializedAsync()
    {
        if (Uc == null || Uc.UserId == 0)
            return;

        v.IsLoading = true;

        try
        {
            await LoadUser();
        }
        finally
        {
            v.IsLoading = false;
        }
    }

    private async Task LoadUser()
    {
        try
        {
            var res = await _user._02ById(Uc.UserId, Uc.SchemaMain, Uc.Conn);

            if (res != null && res.Id != 0)
            {
                v.User = res;
                v.User.Password         = string.Empty;
                v.User.NewPassword      = string.Empty;
                v.User.VerifyPassword   = string.Empty;
            }
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable to load current user information", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private async Task UpdatePassword()
    {
        ResetErrorMessage();

        if (!await IsOldPasswordMatch()) return;
        if (!IsFormValid()) return;

        try
        {
            var res = await _user._03ChangePassword(v.User.Id, v.User.NewPassword, Uc.SchemaMain, Uc.Conn);

            if (res != null)
            {
                NotificationRef?.Show("Password updated successfully.", ThemeConstants.Notification.ThemeColor.Success);

                v.User.Password         = string.Empty;
                v.User.NewPassword      = string.Empty;
                v.User.VerifyPassword   = string.Empty;
            }
            else
            {
                NotificationRef?.Show("Unable to update password.", ThemeConstants.Notification.ThemeColor.Error);
            }
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable to update password.", ThemeConstants.Notification.ThemeColor.Error);
        }
    }

    private bool IsFormValid()
    {

        var isInvalid = false;



        if (string.IsNullOrWhiteSpace(v.User.NewPassword))
        {
            v.NewPasswordErrorMsg = "New password is required";
            isInvalid = true;
        }

        if (string.IsNullOrWhiteSpace(v.User.VerifyPassword))
        {
            v.VerificationPasswordErrorMsg = "Verify password is required";
            isInvalid = true;
        }

        if (isInvalid)
            return false;

        if (v.User.NewPassword == v.User.Password)
        {
            v.NewPasswordErrorMsg = "New password must be different from old password";
            return false;
        }

        if (v.User.NewPassword.Length < 8)
        {
            v.NewPasswordErrorMsg = "New password should be at least 8 characters";
            return false;
        }

        if (v.User.NewPassword != v.User.VerifyPassword)
        {
            v.VerificationPasswordErrorMsg = "Passwords do not match";
            return false;
        }

        return true;
    }

    private async Task<bool> IsOldPasswordMatch()
    {
        v.OldPasswordErrorMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(v.User.Password))
        {
            v.OldPasswordErrorMsg = "Old password is required";
            return false;
        }

        try
        {
            var res = await _user._02LoginLoginName(v.User.LoginName, v.User.Password, Uc.SchemaMain, Uc.Conn);

            if (res == null)
            {
                v.OldPasswordErrorMsg = "Current Password does not match";
                return false;
            }

            return true;
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable to verify password.", ThemeConstants.Notification.ThemeColor.Error);
            return false;
        }
    }

    private void ResetErrorMessage()
    {
        v.OldPasswordErrorMsg           = string.Empty;
        v.NewPasswordErrorMsg           = string.Empty;
        v.VerificationPasswordErrorMsg  = string.Empty;
    }


}