@using HRMvc.Applications._00GeneralComponents.FormComponents
@using HRMvc.Applications._12EmployeeProfile.Vars

<TelerikRootComponent>
    <TelerikLoaderContainer Visible="@v.IsLoading" LoaderType="@LoaderType.ConvergingSpinner" />

    <TelerikNotification @ref="@NotificationRef"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top"
                         AnimationType="@AnimationType.SlideLeft" />

    <TelerikCard Height="calc(100vh - 100px)">
        <CardHeader Class="password-card-header">
            <div>
                <div class="k-font-size-lg k-font-weight-bold">
                    Change Password
                </div>
                <div class="k-text-secondary k-font-size-sm">
                    Update your password to keep your account secure.
                </div>
            </div>
        </CardHeader>

        <CardBody Class="p-3">
            <EditForm Model="@v.User" OnSubmit="@HandleSubmit">

                @* ==============================
                   ACTION
                   ============================== *@
                <CActionPanel>
                    <TelerikButton Icon="FontIcon.Lock"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   FillMode="@ThemeConstants.Button.FillMode.Solid"
                                   ButtonType="@Telerik.Blazor.ButtonType.Submit"
                                   TabIndex="5">
                        Change Password
                    </TelerikButton>
                </CActionPanel>

                <div class="row">
                    <div class="col-12 col-md-10 col-lg-8 col-xl-6 col-xxl-4  ">

                        <div class="ps-md-4">
                            @* ==============================
                           CURRENT USER
                           ============================== *@
                            <CFieldItem Label="Current User" Id="currentuser">
                                <TelerikTextBox @bind-Value="@v.User.UserName"
                                                Class="form-full"
                                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                ReadOnly
                                                TabIndex="1"
                                                AutoComplete="off">
                                    <TextBoxSuffixTemplate>
                                        <TelerikFontIcon Icon="@FontIcon.User" Size="@ThemeConstants.FontIcon.Size.Small" />
                                    </TextBoxSuffixTemplate>
                                </TelerikTextBox>
                            </CFieldItem>

                            @* ==============================
                           OLD PASSWORD
                           ============================== *@
                            <CFieldItem Label="Old Password" Id="oldpassword">
                                <TelerikTextBox @bind-Value="@v.User.Password"
                                                Class="@FieldClass(nameof(OPisUsrModel.Password))"
                                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                Password="@(!ShowOldPassword)"
                                                Placeholder="Enter current password"
                                                AutoComplete="current-password"
                                                MaxLength="60"
                                                TabIndex="2">
                                    <TextBoxSuffixTemplate>
                                        <TelerikFontIcon Icon="@(ShowOldPassword? FontIcon.EyeSlash: FontIcon.Eye)"
                                                         Size="@ThemeConstants.FontIcon.Size.Small"
                                                         @onclick="@ToggleOldPassword" />
                                    </TextBoxSuffixTemplate>
                                </TelerikTextBox>
                                <CFieldError Field="@nameof(OPisUsrModel.Password)" Errors="@FieldErrors" />
                            </CFieldItem>

                            @* ==============================
                           NEW PASSWORD
                           ============================== *@
                            <CFieldItem Label="New Password" Id="newpassword">
                                <TelerikTextBox @bind-Value="@v.User.NewPassword"
                                                Class="@FieldClass(nameof(OPisUsrModel.NewPassword))"
                                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                Password="@(!ShowNewPassword)"
                                                Placeholder="Enter new password"
                                                AutoComplete="new-password"
                                                MaxLength="60"
                                                TabIndex="3">
                                    <TextBoxSuffixTemplate>
                                        <TelerikFontIcon Icon="@(ShowNewPassword? FontIcon.EyeSlash: FontIcon.Eye)"
                                                         Size="@ThemeConstants.FontIcon.Size.Small"
                                                         @onclick="@ToggleNewPassword" />
                                    </TextBoxSuffixTemplate>
                                </TelerikTextBox>
                                <CFieldError Field="@nameof(OPisUsrModel.NewPassword)" Errors="@FieldErrors" />
                            </CFieldItem>

                            @* ==============================
                           VERIFY PASSWORD
                           ============================== *@
                            <CFieldItem Label="Verify Password" Id="verifypassword">
                                <TelerikTextBox @bind-Value="@v.User.VerifyPassword"
                                                Class="@FieldClass(nameof(OPisUsrModel.VerifyPassword))"
                                                Rounded="@ThemeConstants.TextBox.Rounded.Large"
                                                FillMode="@ThemeConstants.TextBox.FillMode.Solid"
                                                Password="@(!ShowVerifyPassword)"
                                                Placeholder="Re-enter new password"
                                                AutoComplete="new-password"
                                                MaxLength="60"
                                                TabIndex="4">
                                    <TextBoxSuffixTemplate>
                                        <TelerikFontIcon Icon="@(ShowVerifyPassword? FontIcon.EyeSlash: FontIcon.Eye)"
                                                         Size="@ThemeConstants.FontIcon.Size.Small"
                                                         @onclick="@ToggleVerifyPassword" />
                                    </TextBoxSuffixTemplate>
                                </TelerikTextBox>
                                <CFieldError Field="@nameof(OPisUsrModel.VerifyPassword)" Errors="@FieldErrors" />
                            </CFieldItem>

                            @* ==============================
                           PASSWORD REQUIREMENTS
                           ============================== *@
                        </div>
                       
                        <div class="mt-3">
                            <CBanner Title="Password requirements"
                                     Message="Use at least 8 characters with a mix of letters, numbers, and symbols." />
                        </div>

                    </div>
                </div>
            </EditForm>
        </CardBody>
    </TelerikCard>
</TelerikRootComponent>

@code {
    [Parameter]
    public UserClaimsModel Uc { get; set; } = new();

    [Parameter]
    public EventCallback OnCancelRequested { get; set; }

    private V12002Model v = new();
    private TelerikNotification? NotificationRef;
    private Dictionary<string, string> FieldErrors { get; set; } = new();

    // ==============================
    // FIELD LIMITS (matches secpis.usr schema)
    // ==============================

    private bool ShowOldPassword = false;
    private bool ShowNewPassword = false;
    private bool ShowVerifyPassword = false;

    private void ToggleOldPassword()
    {
        ShowOldPassword = !ShowOldPassword;
    }

    private void ToggleNewPassword()
    {
        ShowNewPassword = !ShowNewPassword;
    }

    private void ToggleVerifyPassword()
    {
        ShowVerifyPassword = !ShowVerifyPassword;
    }

    private bool IsFieldInvalid(string field)
    {
        return FieldErrors.ContainsKey(field);
    }

    private string FieldClass(string field)
    {
        return IsFieldInvalid(field) ? "cfield-invalid" : "form-full";
    }

    private async Task OnCancel()
    {
        v.User.Password = string.Empty;
        v.User.NewPassword = string.Empty;
        v.User.VerifyPassword = string.Empty;
        FieldErrors.Clear();

        if (OnCancelRequested.HasDelegate)
        {
            await OnCancelRequested.InvokeAsync();
        }
    }

    private bool TryValidate(OPisUsrModel usr)
    {
        FieldErrors = new Dictionary<string, string>();

        // Old password
        if (string.IsNullOrWhiteSpace(usr.Password))
        {
            FieldErrors[nameof(OPisUsrModel.Password)] = "Old password is required.";
        }

        // New password
        if (string.IsNullOrWhiteSpace(usr.NewPassword))
        {
            FieldErrors[nameof(OPisUsrModel.NewPassword)] = "New password is required.";
        }

        // Verify password
        if (string.IsNullOrWhiteSpace(usr.VerifyPassword))
        {
            FieldErrors[nameof(OPisUsrModel.VerifyPassword)] = "Verify password is required.";
        }

        // Stop here if required fields are missing
        if (FieldErrors.Count > 0)
        {
            return false;
        }

        // New password and verify password must match
        if (usr.NewPassword != usr.VerifyPassword)
        {
            FieldErrors[nameof(OPisUsrModel.VerifyPassword)] = "Passwords do not match.";
        }

        // New password must be different from old password
        if (usr.NewPassword == usr.Password)
        {
            FieldErrors[nameof(OPisUsrModel.NewPassword)] = "New password must be different from old password.";
        }

        return FieldErrors.Count == 0;
    }

    private async Task HandleSubmit()
    {
        if (!TryValidate(v.User))
        {
            NotificationRef?.Show("Please correct the errors before continuing.", ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        try
        {
            v.IsLoading = true;
            NotificationRef?.Show("Password changed successfully.", ThemeConstants.Notification.ThemeColor.Success);

            FieldErrors.Clear();

            // Clear password values
            v.User.Password = string.Empty;
            v.User.NewPassword = string.Empty;
            v.User.VerifyPassword = string.Empty;

            // Hide passwords again
            ShowOldPassword = false;
            ShowNewPassword = false;
            ShowVerifyPassword = false;
        }
        catch (Exception)
        {
            NotificationRef?.Show("Unable to change password. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            v.IsLoading = false;
        }
    }
}