@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@{ var e = V12_103.Addresses.FirstOrDefault() ?? new EmpmasAddressModel();}

    <div class="card w-100">
        <_12_102_Cardhdr caption="Address" />
        <div class="p-2">

            @* -- Present -- *@
            <div class="card mb-2">
                <div class="card-header">Present</div>
                <LabelValueRow Label="Street / House no."       Value="@e.PresAddStreet" />
                <LabelValueRow Label="Village / Subdivision"    Value="@e.PresAddVillage" />
                <LabelValueRow Label="Barangay"                 Value="@e.PresAddBrgy" />
                <LabelValueRow Label="City / Municipality"      Value="@e.PresAddCity" />
                <LabelValueRow Label="Province"                 Value="@e.PresAddProv" />
                <LabelValueRow Label="State"                    Value="@e.PresAddState" />
                <LabelValueRow Label="Country"                  Value="@e.PresAddCountry" />
                <LabelValueRow Label="ZIP code"                 Value="@e.PresAddZipCode" />
                <LabelValueRow Label="Full Address"             Value="@e.PresAdd" />
                <LabelValueRow Label="Telephone no."            Value="@e.PresAddTelNo" IsLast/>
            </div>

            @* -- Provincial -- *@
            <div class="card mb-2">
                <div class="card-header">Provincial</div>
                <LabelValueRow Label="Street / House no."       Value="@e.ProvAddStreet" />
                <LabelValueRow Label="Village / Subdivision"    Value="@e.ProvAddVillage" />
                <LabelValueRow Label="Barangay"                 Value="@e.ProvAddBrgy" />
                <LabelValueRow Label="City / Municipality"      Value="@e.ProvAddCity" />
                <LabelValueRow Label="Province"                 Value="@e.ProvAddProv" />
                <LabelValueRow Label="State"                    Value="@e.ProvAddState" />
                <LabelValueRow Label="Country"                  Value="@e.ProvAddCountry" />
                <LabelValueRow Label="ZIP code"                 Value="@e.ProvAddZipCode" />
                <LabelValueRow Label="Full Address"             Value="@e.ProvAdd" />
                <LabelValueRow Label="Telephone no."            Value="@e.ProvAddTelNo" IsLast />
            </div>

            @* -- Contact -- *@
            <div class="card">
                <div class="card-header">Contact</div>

                <LabelValueRow Label="Primary email"            Value="@e.EmailAdd" />
                <LabelValueRow Label="Secondary email"          Value="@e.EmailAdd1" />
                <LabelValueRow Label="Primary mobile"           Value="@e.CellNo" />
                <LabelValueRow Label="Secondary mobile"         Value="@e.CellNo1" />
            </div>

        </div>
    </div>


@* ── Helpers ── *@
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

}