<div class="card w-100">
    <_12_102_Cardhdr caption="Training / Seminars" />
    <div class="p-2">
        <div class="card p-0">
            <div class="overflow-auto">

                <div class="d-flex fw-bold border-bottom bg-light py-2 table-row flex-nowrap">
                    <div class="col-program    ps-3 border-end">Program</div>
                    <div class="col-venue      ps-3 border-end">Venue</div>
                    <div class="col-trainor    ps-3 border-end">Trainor</div>
                    <div class="col-date-taken ps-3 border-end">Date Taken</div>
                    <div class="col-date-taken ps-3 border-end">Date Start</div>
                    <div class="col-date-taken ps-3 border-end">Date End</div>
                    <div class="col-date-taken ps-3 border-end">Total Days</div>
                    <div class="col-date-taken ps-3 border-end">Total Hrs</div>
                </div>

                <div class="card-body p-0">
                  

                    @if (V12_103.Trainings.Any())
                    {
                        @foreach (var e in V12_103.Trainings)
                        {
                            <div class="d-flex border-bottom py-2 table-row flex-nowrap">
                                <div class="col-program    ps-3 border-end">@(string.IsNullOrWhiteSpace(e.ProgramName) ? "—" : e.ProgramName)</div>
                                <div class="col-venue      ps-3 border-end">@(string.IsNullOrWhiteSpace(e.School) ? "—" : e.School)</div>
                                <div class="col-trainor    ps-3 border-end">@(string.IsNullOrWhiteSpace(e.Trainor) ? "—" : e.Trainor)</div>
                                <div class="col-date-taken ps-3 border-end">@e.DateTaken</div>
                                <div class="col-date-taken ps-3 border-end">@(e.DateStart == default ? "—" : e.DateStart.ToString("MM/dd/yyyy"))</div>
                                <div class="col-date-taken ps-3 border-end">@(e.DateEnd == default ? "—" : e.DateEnd.ToString("MM/dd/yyyy"))</div>
                                <div class="col-date-taken ps-3 border-end">@(e.TotalDays == default ? "—" : e.TotalDays.ToString())</div>
                                <div class="col-date-taken ps-3 border-end">@(e.TotalHrs == default ? "—" : e.TotalHrs.ToString())</div>
                            </div>
                        }
                    }

                    else
                    {
                        <div class="d-flex align-items-center justify-content-center py-2 text-muted ">
                            No records to display.
                        </div>
                    }


                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}

<style>
    .table-row {
        min-width: 1480px;
    }

    .col-program {
        min-width: 260px;
    }

    .col-venue {
        min-width: 260px;
    }

    .col-trainor {
        min-width: 260px;
    }

    .col-date-taken {
        min-width: 150px;
    }
</style>