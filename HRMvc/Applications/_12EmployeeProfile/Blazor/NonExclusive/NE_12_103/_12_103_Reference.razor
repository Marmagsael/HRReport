@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption="Reference" />
    <div class="p-2">
        <div class="card p-0">
            <div class="overflow-auto">

                <div class="d-flex fw-bold border-bottom bg-light py-2">
                    <div class="px-3 border-end" style="width:250px">Name</div>
                    <div class="px-3 border-end" style="width:250px">Address</div>
                    <div class="px-3 border-end" style="width:180px">Telephone</div>
                    <div class="px-3 flex-grow-1">Occupation</div>
                </div>

                <div class="card-body p-0">
                   

                    @if (V12_103.CharRefs.Any())
                    {
                        @foreach (var r in V12_103.CharRefs)
                        {
                            <div class="d-flex border-bottom py-2">
                                <div class="px-3 border-end" style="width:250px">@(string.IsNullOrWhiteSpace(r.Name) ? "—" : r.Name)</div>
                                <div class="px-3 border-end" style="width:250px">@(string.IsNullOrWhiteSpace(r.Addr) ? "—" : r.Addr)</div>
                                <div class="px-3 border-end" style="width:180px">@(string.IsNullOrWhiteSpace(r.Tel) ? "—" : r.Tel)</div>
                                <div class="px-3 flex-grow-1">@(string.IsNullOrWhiteSpace(r.Position) ? "—" : r.Position)</div>
                            </div>
                        }
                    }

                    else
                    {
                        <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                            No records to display.
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}