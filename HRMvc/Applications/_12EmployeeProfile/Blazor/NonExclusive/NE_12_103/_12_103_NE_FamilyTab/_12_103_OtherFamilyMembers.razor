@using HRApiLibrary.Models._10_Pis.OPis


<div class="p-2 pt-0">
    <div class="card overflow-auto mb-3">
        <div class="card-header">Other Family Members</div>
        <div class="card-body p-0">

            <div class="d-flex fw-bold border-bottom bg-light py-2">
                <div class="px-3 border-end" style="width:210px">Relationship</div>
                <div class="px-3 border-end  flex-grow-1">Name</div>
                <div class="px-3 border-end text-center" style="width:150px">Date of Birth</div>
                <div class="px-3 " style="width:150px">Gender</div>
            </div>

            @if (V12_103.Relatives.Any())
            {
                @foreach (var f in V12_103?.Relatives)
                {
                    <div class="d-flex border-bottom py-2">
                        <div class="px-3 border-end" style="width:210px">@f.Relationship</div>
                        <div class="px-3 border-end  flex-grow-1">@(string.IsNullOrWhiteSpace(f.Name) ? "—" : f.Name)</div>
                        <div class="px-3 border-end text-center" style="width:150px">@f.Birth.ToString("MMMM dd,yyyy")</div>
                        <div class="px-3 " style="width:150px"> @V12_103.OGenders?.FirstOrDefault(g => g.Code == f.Sex)?.Name</div>
                    </div>
                }
            }
            
            else
            {
            <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                No records to display.
            </div>
            }
        </div>
    </div>
</div>
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
