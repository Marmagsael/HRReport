<div class="card w-100">
    <_12_102_Cardhdr caption="Employment Records" />
    <div class="p-2">
        <div class="card p-0">
            <div class="overflow-auto">

                <div class="d-flex fw-bold border-bottom bg-light py-2 table-row flex-nowrap">
                    <div class="col-company ps-3 border-end">Company</div>
                    <div class="col-address ps-3 border-end">Address </div>
                    <div class="col-telephone ps-3 border-end">Telephone</div>
                    <div class="col-position ps-3 border-end">Position</div>
                    <div class="col-year text-center border-end">Year</div>
                    <div class="col-salary ps-3 border-end">Salary</div>
                    <div class="col-remarks ps-3">Remarks </div>
                </div>

                <div class="card-body p-0">

                    @if (V12_103.Employments.Any())
                    {
                        @foreach (var e in V12_103.Employments)
                        {
                            <div class="d-flex border-bottom py-2 table-row flex-nowrap">
                                <div class="col-company ps-3 border-end">@(string.IsNullOrWhiteSpace(e.CompName) ? "—" : e.CompName)</div>
                                <div class="col-address ps-3 border-end">@(string.IsNullOrWhiteSpace(e.Address) ? "—" : e.Address)</div>
                                <div class="col-telephone ps-3 border-end">@(string.IsNullOrWhiteSpace(e.Tel) ? "—" : e.Tel)</div>
                                <div class="col-position ps-3 border-end">@(string.IsNullOrWhiteSpace(e.Pos) ? "—" : e.Pos)</div>
                                <div class="col-year text-center border-end">
                                    @(e.From_ == default ? "_" : e.From_.Year.ToString()) - @(e.To_ == default ? "_" : e.To_.Year.ToString())
                                </div>
                                <div class="col-salary ps-3 border-end">@(e.Sal == default ? "—" : e.Sal.ToString("N2"))</div>
                                <div class="col-remarks ps-3">@(string.IsNullOrWhiteSpace(e.Rem) ? "—" : e.Rem)</div>
                            </div>
                        }
                    }

                    else
                    {
                        <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                            No records to display.
                        </div>
                    }


                   
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}

<style>
    .table-row {
        min-width: 1480px;
    }

    .col-company {
        min-width: 260px;
    }

    .col-address {
        min-width: 260px;
    }

    .col-telephone {
        min-width: 180px;
    }

    .col-position {
        min-width: 220px;
    }

    .col-year {
        min-width: 160px;
    }

    .col-salary {
        min-width: 140px;
    }

    .col-remarks {
        min-width: 260px;
    }
</style>