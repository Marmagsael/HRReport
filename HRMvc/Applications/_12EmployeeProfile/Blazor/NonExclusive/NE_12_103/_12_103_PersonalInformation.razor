@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@{ var e = V12_103.PIs.FirstOrDefault() ?? new EmpmasPIModel();}

    <style>
        .pi-emph .lvr-label { color: #6c757d; font-size: .875rem; font-weight: 500; background-color: #f8f9fa; }
        .pi-emph .lvr-value { color: #212529; font-weight: 600; }
    </style>

    <div class="card w-100">
        <_12_102_Cardhdr caption="Personal Information" />
        @* -- Two columns, same order as 14/2052 Personal Data -- *@

        <div class="pi-emph d-flex flex-wrap p-0">
            <div style="flex:1 1 400px; min-width:0;">
                <LabelValueRow Label="Birth Date"       Value="@(e.EmpBirth == default ? null : e.EmpBirth.ToString("MMMM dd, yyyy"))" />
                <LabelValueRow Label="Birth Place"      Value="@e.BirthPlace" />
                <LabelValueRow Label="Gender"           Value="@(V12_103.OGenders?.FirstOrDefault(g => g.Code == e.Sex_)?.Name)" />
                <LabelValueRow Label="Civil Status"     Value="@(V12_103.OCivstats?.FirstOrDefault(g => g.Code == e.CivStat_)?.Name)" />
                <LabelValueRow Label="Citizenship"      Value="@e.Citizen" />
                <LabelValueRow Label="Religion"         Value="@e.Religion" />
                <LabelValueRow Label="Height"           Value="@(string.Join(" ", new[] { e.Height != null ? $"{e.Height} Feet" : null, e.HeightInch != null ? $"{e.HeightInch} Inches" : null }.Where(x => x != null)))" />
                <LabelValueRow Label="Weight"           Value="@(e.Weight != null ? $"{e.Weight:#,##0.00} lbs" : null)" />
                <LabelValueRow Label="Age"              Value="@e.Age?.ToString()" IsLast/>
            </div>
            <div class="border-start" style="flex:1 1 400px; min-width:0;">
                <LabelValueRow Label="Hair Color"       Value="@e.Hair" />
                <LabelValueRow Label="Eyes Color"       Value="@e.Eyes" />
                <LabelValueRow Label="Complexion"       Value="@e.Complexion" />
                <LabelValueRow Label="Marks"            Value="@e.Marks" />
                <LabelValueRow Label="Blood Type"       Value="@e.BloodType" />
                <LabelValueRow Label="Spouse Name"      Value="@e.Spouse" />
                <LabelValueRow Label="Spouse Occupation" Value="@e.Occupation" />
                <LabelValueRow Label="No of Children"   Value="@e.NoChildren?.ToString()" IsLast/>
            </div>
        </div>
    </div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

   
}