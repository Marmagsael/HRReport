@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor.NonExclusive.NE_12_103

<div class="card w-100">
    <_12_102_Cardhdr caption="Family" />

    <_12_103_Tabs TabChanged="TabChanged"></_12_103_Tabs>
    
    <div class="">
         @if (tab == 1)
        {
            <_12_103_General V12_103="V12_103" />
        }
        @if (tab == 2)
        {
            <_12_103_EmergencyContact V12_103="V12_103" />
        }
        @if(tab == 3)
        {
            <_12_103_OtherFamilyMembers V12_103="V12_103" />
        }
    </div>
   
  
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

    int? tab = 1;

    void TabChanged(int val)
    {
        tab = val;

    }
}
