<div class="card w-100">
    <_12_102_Cardhdr caption="Education Background" />
    <div class="p-2">
        <div class="card overflow-auto">
            <div class="card-body p-0">

                <div class="d-flex fw-bold border-bottom bg-light py-2">
                    <div class="px-3 border-end" style="width:150px">Level</div>
                    <div class="px-3 border-end flex-grow-1">School</div>
                    <div class="px-3 border-end text-center" style="width:120px">Year</div>
                    <div class="px-3" style="width:200px">Course</div>
                </div>

             

                @if (V12_103.Educates.Any())
                {
                    @foreach (var s in V12_103.Educates)
                    {
                        <div class="d-flex border-bottom py-2">
                            <div class="px-3 border-end" style="width:150px">@(string.IsNullOrWhiteSpace(s.LEVELNAME) ? "—" : s.LEVELNAME)</div>
                            <div class="px-3 border-end flex-grow-1">@(string.IsNullOrWhiteSpace(s.School) ? "—" : s.School)</div>
                            <div class="px-3 border-end text-center" style="width:120px">
                                @(s.FROM_ == default ? "_" : s.FROM_.Year.ToString()) - @(s.TO_ == default ? "_" : s.TO_.Year.ToString())
                            </div>
                            <div class="px-3" style="width:200px">@(string.IsNullOrWhiteSpace(s.COURSE) ? "—" : s.COURSE)</div>
                        </div>
                    }
                }

                else
                {
                    <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                        No records to display.
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}