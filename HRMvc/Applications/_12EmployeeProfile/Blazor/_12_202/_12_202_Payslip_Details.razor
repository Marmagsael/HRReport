<div class="p-3 ">
    <div class="d-flex gap-2 p-1">
        <div class="w-150p"> TRN </div> 
        <div>@(Oempmass?.FirstOrDefault()?.Sss ?? "") </div>
    </div>
    <div class="d-flex gap-2 p-1">
        <div class="w-150p"> SSS #</div> 
        <div> </div>
    </div>
    <div class="d-flex gap-2 p-1">
        <div class="w-150p">T.I.N.</div> 
        <div> </div>
    </div>

    <div class="card">
        <div class="card-header bg-lightgray d-flex ">
            <div class="w-50 bordered-right p-2">
                <div class="p-2"><h6>Earnings</h6></div>
                <div class="d-flex w-100 bordered-top pt-1">
                    <div class="w-50">Description</div>
                    <div class="w-20">Duration</div>
                    <div class="w-30">Amount</div>
                    
                </div>
            </div>

            <div class="w-50 p-2">
                <div class="p-2"><h6>Deductions</h6></div>
                <div class="d-flex w-100 bordered-top pt-1">
                    <div class="w-70">Description</div>
                    <div class="w-30">Amount</div>
                </div>
            </div>
            
        </div>

        @* --- Card Body -------------------- *@
        <div class="card-body p-2">
            
        </div>
        
        @* --- Card Footer -------------------- *@
        <div class="card-footer p-2 p-0 d-flex"> 
            <div class="w-25 text-center bordered-right p-1">
                <div>Total Hours</div>

            </div>
            <div class="w-25 text-center bordered-right p-1">
                <div>Gross Earnings</div>

            </div>
            <div class="w-25 text-center bordered-right p-1">
                <div>Total Deductions</div>

            </div>
            <div class="w-25 text-center p-1">
                <div>Net Pay</div>

            </div>
            
        </div>

    </div>
    

</div>

@code {
    [Parameter] public List<OempmasModel?>?     Oempmass    { get; set; } = [];

    private string payrollgrp = "";


}
