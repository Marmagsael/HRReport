@using Blazorise
<div class="d-flex gap-2 w-100 mt-3">
     <div class="card w-100 p-0 ">
          <div class="card-header d-flex gap-2 w-100 p-0 py-2 fw-bold text-center">
               <div class="w-225p p-2 bordered-right text-start">Charge To</div>
               <div class="w-100p p-2 bordered-right">Loan Date</div>
               <div class="w-100p p-2 bordered-right">Amount</div>
               <div class="w-115p p-2 bordered-right">Amort.</div>
               <div class="w-100p p-2 bordered-right">Balance</div>
               <div class="p-2 flex-fill">Payable Every</div>   
          </div>

          <div class="card-body p-0">
               @{ int i = 0; }
               @foreach(var l in Loans){
                    var rowClass = i++ % 2 == 0 ? "" : "bg-lightgray";

                    <div class="d-flex gap-2 w-100  @rowClass p-0">
                         <div class="w-225p p-2 bordered-right">@l.AcctName</div>
                         <div class="w-100p p-2 bordered-right">
                              @(l.Date?.ToString("MM/dd/yyyy") ?? "")
                         </div>
                         <div class="w-100p p-2 bordered-right text-end">@l.Amount?.ToString("N2")</div>
                         <div class="w-115p p-2 bordered-right text-end">@l.Amort?.ToString("N2")</div>
                         <div class="w-100p p-2 bordered-right text-end">@l.Balance?.ToString("N2")</div>
                         <div class="p-2 flex-fill text-center">
                              <span class="text-success">@(l.P1==1?"P1":" ")</span> 
                              <span class="text-primary">@(l.P2==1?"P2":" ") </span>
                              <span class="text-success">@(l.P3==1?"P3":" ")</span> 
                              <span class="text-primary">@(l.P4==1?"P4":" ") </span>
                              <span class="text-primary">@(l.P5==1?"P5":" ") </span>
                         </div>   
                    </div>
               }
          </div>
          

     </div>

</div>



@code {
     [Parameter] public UserClaimsModel?         UserClaims  { get; set; }
     [Parameter] public List<GLoansModel?>?      Loans  { get; set; }
    
}
