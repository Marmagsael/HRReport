@using Blazorise.Extensions
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._90_Utils
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_102._12_102_Child.Leave
@using Radzen
@using Radzen.Blazor

@* <div class="card-header"> Leave Request </div> *@

<div class="d-flex gap-1 p-1 border-bottom ">
    <div @onclick="New" class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
    <div @onclick="Save" class="p-1 mb-cbtn mb-cbtn-blue card w-75p @(CanSaveCss) "> Save  </div>
    <div @onclick="ShowSendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @(CanSendCss ) "> Send For Approval </div>
    <div @onclick="ShowCancel" class="p-1 mb-cbtn mb-cbtn-red card w-100p @(CanCancelCss)"> Cancel </div>
    <div @onclick="ShowMyRequest" class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
</div>

<_12_102_Lv_Modal ChildAction="ChildActionCatcher" Uc="@Uc" V="@v" />

@* <div>Count : @v.LeaveApplicationdtls.Count * @Uc.UserId </div> *@

<div class="card-body p-0 ">
    <table class="table table-small table-bordered">
        <tbody>
            <tr>
                <td class="w-150p p-2  ">
                    <div class="mt-1">
                        TRN # <spa class="txt-red">*</spa>
                    </div>
                </td>
                <td class="p-2 d-flex justify-content-between  ">
                    <div class="border-bottom w-100p text-center  p-1">
                        <h6 class=""> @v.LeaveApplication.Id </h6> 
                    </div>
                    <div class="w-175p d-flex p-1 ">
                        <div class=""> Status : </div>
                        <div class="ms-2 bordered-bottom w-75p text-center text-primary"> 
                            @(_02LvStatus(@v.LeaveApplication.Status)) 
                        </div>
                    </div>

                </td>
            </tr>


            @* --- Leave Type ------------------------------------------- *@
            <tr>
                <td class="w-150p p-1 ">
                    <div class="py-2"> Leave Type<spa class="txt-red">*</spa>  </div>
                    
                </td>
                <td class="p-1"> 
                     <RadzenDropDown Change="_02LeaveBalance"                   TValue="int"
                        Data="@v.LeaveTypes"
                        TextProperty="LeaveName"
                        ValueProperty="Id"
                        @bind-Value="v.LeaveApplication.LeaveTypeId"
                        Placeholder="Leave Type"
                        Style="width:250px" />
                        
                </td>
            </tr>
            
            @* --- Year Of Application ------------------------------------------- *@
            <tr>
                <td class="w-150p ">
                    <div class="p-1"> Credit Period<spa class="txt-red">*</spa>  </div>
                    
                </td>
                <td class="p-1"> 
                     <RadzenDropDown Change="_02LeaveBalance"                TValue="int"
                        Data="@v.LvYrs"
                        @bind-Value="v.LeaveApplication.Yr"
                        Placeholder="Leave Year"
                        Style="width:125px" />
                </td>
            </tr>
            
            @* --- Date Covered ----------------------------- *@
            <tr>
                <td class="align-middle">Date Covered<spa class="txt-red">*</spa></td>
                <td class="p-1">
                    <div class="w-100 ">
                        <div class="d-flex gap-2 ">
                            <div class="w-50p p-2 d-flex align-items-center">Start<spa class="txt-red">*</spa></div>
                            <div class="w-120p">
                                <RadzenDatePicker 
                                    @bind-Value="v.LeaveApplication.LvStart" 
                                    Change="Populatedtls"
                                    DateFormat="MM/dd/yyyy"
                                    AllowInput="false"
                                    class="mb-date-accent w-150p" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-1">
                            <div class="w-50p p-2 d-flex align-items-center">End<span class="txt-red">*</span></div>
                            <div class="w-150p ">
                                <RadzenDatePicker 
                                    @bind-Value="v.LeaveApplication.LvEnd" 
                                    Change="Populatedtls"
                                    DateFormat="MM/dd/yyyy"
                                    AllowInput="false"
                                    class="mb-date-accent w-150p" />
                            </div>
                        </div>
                    </div>
                </td>
            </tr>

            @* --- Address ------------------------------------ *@
            <tr>
                <td class="w-150p">Address<spa class="txt-red">*</spa> </td>
                <td class="p-1">
                    <RadzenTextArea @bind-Value="v.LeaveApplication.Address" MaxLength="150" Rows="2" Style="width:100%;" /> 
                </td>
            </tr>
            
            @* --- Telephone Number ------------------------------------ *@
            <tr>
                <td class="w-150p ">Contact # <spa class="txt-red">*</spa></td>
                <td class="p-1">
                    <RadzenTextBox 
                        @bind-Value="@v.LeaveApplication.TelNo"
                        MaxLength="45" 
                        Style="width:250px;" /> 
                        
                </td>
            </tr>
            
            @* --- Reason ------------------------------------ *@
            <tr>
                <td class="w-150p">Reason <spa class="txt-red">*</spa></td>
                <td class="p-1">
                    <RadzenTextArea @bind-Value="v.LeaveApplication.Reason" MaxLength="150" Rows="2" Style="width:100%;" /> 
                </td>
            </tr>

            <tr>
                <td>Approvers</td>
                <td class="p-0">
                    <div class="w-100 d-flex ">
                        @* --- First Approver *@
                        <div class="w-50 p-1">
                            <div>
                                <RadzenDropDown Data="@v.LvFirstApprovers" 
                                    TextProperty="ApproverName"
                                    ValueProperty="ApproverId" 
                                    @bind-Value="v.LeaveApplication.Approver1Id" 
                                    Placeholder="First Approver" 
                                    Style="width:100%"
                                    PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;" >
                                    
                                    <Template Context="item">
                                        <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                            @item.ApproverName
                                        </div>
                                    </Template>


                                </RadzenDropDown>
                            </div>
                            <div class="text-center">
                                Approver
                            </div>
                        </div>
                        
                        @* --- Second Approver *@
                        <div class="w-50 p-1">
                            <div>
                                <RadzenDropDown Data="@v.LvFinalApprovers" 
                                    TextProperty="ApproverName"
                                    ValueProperty="ApproverId" 
                                    @bind-Value="v.LeaveApplication.Approver2Id" 
                                    Placeholder="Final Approver" 
                                    Style="width:100%"
                                    PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;">
                                    
                                    <Template Context="item">
                                        <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                            @item.ApproverName
                                        </div>
                                    </Template>
                                    
                                </RadzenDropDown>
                            </div>
                            <div class="text-center">
                                Final Approver
                            </div>
                        </div>



                    </div>
                </td>
                
            </tr>



            @* --- Parameters ------------------------------------------- *@
            <tr>
                <td>Parameter</td>
                <td>
                   <div class="d-flex gap-2">
                        
                        @* --- Leave Balance --------- *@
                        <div class="text-primary">Leave Balance : </div>
                        <div class="text-center">
                            @lva.LvBalance.ToString("N2")
                        </div>
                        @* --- Available Credit --------- *@
                        <div class="text-primary">Days Count : </div>
                        <div class="text-center">
                            @lva.DaysCnt.ToString("N2")
                        </div>
                        @* --- Leave with Pay *@
                        <div class="text-primary">With Pay : </div>
                        <div class="text-center">
                            @lvWPay.ToString("N2") 
                        </div>


                   </div> 
                </td>
            </tr>

        </tbody>
    </table>
</div>

@* --- Leave Details ----------------------------------------- *@
<div>
    <div class="card-header">Leave Details</div>
    <div class="card-body p-0">

        <div class="w-100 d-flex gap-1 py-2 border-bottom">
            <div class="w-130p text-center ">Date</div>
            <div class="w-75p text-center text-primary ">
                Day
            </div>
            <div class="w-75p text-center">Duty Type</div>
            <div class="w-130p text-center">Time Start</div>
            <div class="w-130p text-center">Duration</div>
            <div class="w-100p text-center">Time End</div>
            <div class="w-100p text-center">Payable</div>
            <div class="w-100p text-center">Credited Hrs. </div>
        </div>

        @foreach(LeaveapplicationdtlModel ld in v.LeaveApplicationdtls){
            string dtype    = _02DutyType(@ld.Start?.ToString("ddd")); 
            string dTypeCss = dtype=="RD" ? " text-danger disabled-div-50 " : ""; 

            <div class="w-100 d-flex p-0 mt-1 gap-1 @dTypeCss ">
                <div class="w-130p text-center py-2 ">
                    @ld.Start?.ToString("MMM dd, yyyy").Trim() 
                </div>
                <div class="w-75p text-center  py-2 ">
                    @ld.Start?.ToString("ddd")
                </div>
                <div class="w-75p text-center py-2 ">
                    @dtype
                </div>
                <div class="w-130p">
                    <RadzenDropDown
                        Change="@(() => ComputeEnd(ld))"
                        Data="@v.Hrs"
                        TextProperty="Text"
                        ValueProperty="Value"
                        @bind-Value="@ld.TimeStart"
                        Placeholder="Select Time"
                        Style="width:125px" /> 
                </div>
                <div class="w-130p">
                    <RadzenDropDown
                        Change="@(() => ComputeEnd(ld))"
                        Data="@v.Durations"
                        TextProperty="Text"
                        ValueProperty="Value"
                        @bind-Value="@ld.TimeDuration"
                        Placeholder="Hr Duration"
                        Style="width:125px; align-items: center;" /> 
                </div>
                <div class="w-100p text-center py-2 ">
                    @ld.End?.ToString("hh:mm tt")
                </div>
                
                <div class="w-100p text-center py-2 ">
                    <input 
                        class="form-check-input" 
                        type="checkbox"
                        checked="@ld!.IsPayableB"
                        @onchange="@((ChangeEventArgs e) => MarkPayable(e, ld))" />
                </div>
                <div class="w-100p text-center @(ld?.IsPayableB??false ? "" : " disabled-div ") ">
                    <RadzenNumeric @bind-Value="ld.CreditedHrs"
                        TValue="decimal?"
                        Min="@(0m)"
                        Max="@(23.5m)"
                        Step="0.5"
                        Format="0.00"
                        Style="width:100px;"
                        TextAlign="TextAlign.Center"/>  
                </div>

            </div>    


        }

    </div>

    
    

</div>





@inject ILeavetypeDataAccess            _lvtype; 
@inject IAtttemplateDataAccess          _attTemplate; 
@inject ILeavegrpapproverDataAccess     _lvgrpApprover; 
@inject ILeaveapplicationDataAccess     _lvApplication; 

@code {
    [Parameter] public UserClaimsModel Uc { get; set; }
    V12_102Lv v = new();

    @* =================================================== *@
    void ChildActionCatcher() {

    }

    void New() { 
        @* Console.WriteLine($"Test");  *@

        v.LeaveApplication      = new(); 
        v.LeaveApplicationdtl   = new(); 
        v.LeaveApplicationdtls  = []; 

        Populatedtls(); 
        StateHasChanged(); 

    }

    async Task Save()
    { 
        @* ts.AttReqhdr.Status = "S"; 
        if(ts.AttReqhdr.Id > 0) {
            var res = await _attreqhdr._03(ts.AttReqhdr.Id, ts.AttReqhdr, Uc.SchemaUserPis, Uc.Conn); 
            ts.AttReqhdr = res; 
        } else {
            ts.AttReqhdr.UserId         = Uc.UserId; 
            ts.AttReqhdr.AttReqTypeId   = 3; 
            ts.AttReqhdr.EmpNumber      = Uc.OempNumber; 
            var res     = await _attreqhdr._01(ts.AttReqhdr, Uc.SchemaUserPis, Uc.Conn); 
            ts.AttReqhdr                = res; 
        }  
        await FetchApprover(); 

        await SaveDtl();  *@

    }

    async Task ShowSendForApproval() { 
        @* v.ShowSendForApproval   = true;  *@

        await _lvApplication._03(1,v.LeaveApplication,Uc.SchemaUserPis, Uc.Conn); 


    }

    void ShowCancel() {}
    void ShowMyRequest() { v.ShowMyReqquest = true; }


    bool IsCanSave => lva != null
               && lva.Status is "N" or "S"
               && (lva.LeaveTypeId) > 0
               && lva.LvEnd >= lva.LvStart
               && !string.IsNullOrWhiteSpace(lva.Address)
               && !string.IsNullOrWhiteSpace(lva.Reason)
               && !string.IsNullOrWhiteSpace(lva.TelNo);
    bool IsCanSend  =>  lva != null
                        && lva.Status is "S"
                        && (lva.LeaveTypeId) > 0
                        && lva.LvEnd >= lva.LvStart
                        && !string.IsNullOrWhiteSpace(lva.Address)
                        && !string.IsNullOrWhiteSpace(lva.Reason)
                        && !string.IsNullOrWhiteSpace(lva.TelNo); 
    bool IsCanCancel    => lva != null
                        && lva.Status is "S"; 

    string CanSaveCss =>    IsCanSave ? "" : " disabled-div ";
    string CanSendCss =>    IsCanSend ? "" : " disabled-div ";
    string CanCancelCss =>  IsCanCancel ? "" : " disabled-div ";

    @* =================================================== *@
    async Task _02LeaveBalance() {
        var res = await _lvApplication
                    ._02LvBalance(v.LeaveApplication.LeaveTypeId, 
                                  Uc.UserId, 
                                  v.LeaveApplication.Yr, Uc.SchemaUserPis, Uc.Conn); 
        v.LeaveApplication.LvBalance = res; 

    }


    void Populatedtls()
    {
        v.LeaveApplicationdtls = [];
        
        if (v.LeaveApplication.LvStart.Date > v.LeaveApplication.LvEnd.Date) return;

        var leaveApp = v.LeaveApplication;
        for (DateTime date = leaveApp.LvStart; date < leaveApp.LvEnd.AddDays(1); date = date.AddDays(1))
        {
            @* Console.WriteLine($"{date}"); *@
            string                      ddd     = date.ToString("ddd");
            LeaveapplicationdtlModel?   dtl     = _02LA(ddd);
            dtl.Start                           = date;
            if(dtl.DutyType=="RD") {dtl.TimeStart=0; dtl.TimeDuration=0;}
            else{
                int hr              = (dtl.TimeStart / 100)??0; 
                int min             = (dtl.TimeStart % 100)??0;  
                Double duration     = (dtl.TimeDuration / 100)??0; 

                DateTime dStart = date; 
                dtl.Start   = dStart.AddHours(hr).AddMinutes(min); 
                dtl.End     = dStart.AddHours(hr).AddMinutes(min).AddHours(duration);

            }
            v.LeaveApplicationdtls.Add(dtl);            
        }

        @* --- Days Count -------------------------------- *@
        if(lva.LvEnd.Date < lva.LvStart.Date) { v.LeaveApplication.DaysCnt = 0; }
        else { v.LeaveApplication.DaysCnt = (lva.LvEnd - lva.LvStart).TotalDays + 1;  }


    }

    void ComputeEnd(LeaveapplicationdtlModel ld) {
        if(ld==null) return; 
        if(ld.Start==null) return; 
        if(ld.TimeStart==null) return; 
        if(ld.TimeDuration==null) return; 

        int hr              = (ld.TimeStart / 100)??0; 
        int min             = (ld.TimeStart % 100)??0;  
        Double duration     = (ld.TimeDuration / 100)??0; 
        DateTime dstart     = ld.Start?.Date ?? DateTime.MinValue;
        DateTime dEnd       = dstart.AddHours(hr).AddSeconds(min).AddHours(duration); 

        ld.End = dEnd; 

        if(ld.IsPayableB) {
            decimal? cHrs = (decimal?)((decimal?)(ld.TimeDuration)/100); 


            if(ld.IsPayableB) { ld.CreditedHrs = (cHrs>=5 ? cHrs -1 : cHrs)??0 ; }
            else ld.CreditedHrs = 0; 
        }

    }
    
    protected override async Task OnParametersSetAsync()
    {
        
        if (Uc == null) return;
        await LoadDatas(); 
        await _02LeaveBalance();
        Populatedtls(); 
    }

    async Task LoadDatas() {
        
        if(!v.LeaveTypes.Any())  {
            var res  = await _lvtype._02(Uc.SchemaUserPis, Uc.Conn) ?? [];
            if (res != null && res.Any()) v.LeaveTypes = res!; 

            v.Hrs       = MsdsDataAccess._02Hours() ; 
            v.Durations  = MsdsDataAccess._02HourDurations(); 
            v.AttTemplate = await _attTemplate._02(Uc.UserId, Uc.SchemaUserPis, Uc.Conn); 

            v.LvYrs = []; 
            v.LvYrs.Add(DateTime.Now.Year); 
            v.LvYrs.Add(DateTime.Now.Year-1); 
        }

        List<LeavegrpapproverModel?>? resApprovers = await _lvgrpApprover._02ByEmpmasId(Uc.UserId, Uc.SchemaUserPis, Uc.Conn);
        var firstApprovers = (resApprovers.Where(a=> a.ApproverLevel==1).ToList()) ??[];
        v.LvFirstApprovers = firstApprovers!;
        v.LvFirstApprovers.Insert(0, new(){ApproverId=0, ApproverName="No Assigned Approver"});

        
        var finalApprovers = (resApprovers.Where(a=> a.ApproverLevel==2).ToList()) ??[];
        v.LvFinalApprovers = finalApprovers!; 
        v.LvFinalApprovers.Insert(0, new() { ApproverId = 0, ApproverName = "No Assigned Approver" });

    }

    private async Task MarkPayable(ChangeEventArgs e, LeaveapplicationdtlModel l)
    {
        var val = (bool)(e.Value??false); 
        l.IsPayableB = val;

        var cHrs = (decimal?)((decimal?)(l.TimeDuration)/100); 
        if(val) { l.CreditedHrs = (cHrs>=5 ? cHrs -1 : cHrs)??0 ; }
        else l.CreditedHrs = 0; 
        
    }

    string _02DutyType(string ddd) => ddd switch {
        "Mon" => v?.AttTemplate?.D2_dutytype??"",
        "Tue" => v?.AttTemplate?.D3_dutytype??"",
        "Wed" => v?.AttTemplate?.D4_dutytype??"",
        "Thu" => v?.AttTemplate?.D5_dutytype??"",
        "Fri" => v?.AttTemplate?.D6_dutytype??"",
        "Sat" => v?.AttTemplate?.D7_dutytype??"",
        "Sun" => v?.AttTemplate?.D1_dutytype??"",
        _ => "Unknown"
    };

    string DTypeCss(string ddd) => _02DutyType(ddd) == "RD" ? " text-danger " : "";
    AtttemplateModel        at    =>  v.AttTemplate; 
    LeaveapplicationModel   lva   => v.LeaveApplication; 
    double lvWPay => v.LeaveApplicationdtls 
                        .Where(l => l.IsPayableB)
                        .Sum(l => l.CreditedHrs < 8 ? .5 : 1 ); 

    LeaveapplicationdtlModel _02LA(string ddd) => ddd switch
    {
        "Mon" => new LeaveapplicationdtlModel { DutyType = at.D2_dutytype, TimeStart = at.D2_in, TimeDuration = at.D2_hrslength },
        "Tue" => new LeaveapplicationdtlModel { DutyType = at.D3_dutytype, TimeStart = at.D3_in, TimeDuration = at.D3_hrslength },
        "Wed" => new LeaveapplicationdtlModel { DutyType = at.D4_dutytype, TimeStart = at.D4_in, TimeDuration = at.D4_hrslength },
        "Thu" => new LeaveapplicationdtlModel { DutyType = at.D5_dutytype, TimeStart = at.D5_in, TimeDuration = at.D5_hrslength },
        "Fri" => new LeaveapplicationdtlModel { DutyType = at.D6_dutytype, TimeStart = at.D6_in, TimeDuration = at.D6_hrslength },
        "Sat" => new LeaveapplicationdtlModel { DutyType = at.D7_dutytype, TimeStart = at.D7_in, TimeDuration = at.D7_hrslength },
        "Sun" => new LeaveapplicationdtlModel { DutyType = at.D1_dutytype, TimeStart = at.D1_in, TimeDuration = at.D1_hrslength },
        _ => new LeaveapplicationdtlModel()
    };
    string _02LvStatus(string code) => code switch { "N" => "New", "Save" => "Save", "F" => "For Approval", "C" => "Cancelled", "A" => "Approved", _ => "Unknown" };

    
}
