@inject     IAtttemplatereqdtlDataAccess _dtl ;  



@code {
    [Parameter] public UserClaimsModel  Uc      { get; set; } = new(); 
    [Parameter] public V12_102CS        Cs      { get; set; } = new(); 
    

    AtttemplatereqhdrModel hdr => Cs.Atttemplatereqhdr;  
    AtttemplatereqdtlModel dtl => Cs.Atttemplatereqdtl; 
    int hdrId = 0; 
    


    string dutyTypeCss(string dt) => dt=="RD" ? " text-danger " : "" ;
    string outRes(string dutyType, int? pin, int? duration) => outSched(dutyType, pin, duration);

    string outSched(string dutyType, int? pin, int? duration)
    {
        if(dutyType==null)  return "-"; 
        if(pin==null)       return "-"; 

        int punchin      = pin ?? 0;
        double duration1 = (duration ?? 0) / 100.0;

        int hr  = punchin / 100;
        int min = punchin % 100;

        DateTime dt = new DateTime(2000, 1, 1, hr, min, 0);

        dt = dt.AddHours(duration1);

        return dt.ToString("h:mm tt");
    }
    
}