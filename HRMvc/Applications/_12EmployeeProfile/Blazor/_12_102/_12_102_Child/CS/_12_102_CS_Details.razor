@using FastReport.Utils
@using HRApiLibrary.DataAccess._10_Pis
<div class="bordered mt-4">
    <div class="d-flex p-1 fw-bold card-header small  ">
        <div class="w-120p ">Date Requested</div>
        <div class="w-120p ">Effectivity</div>
        <div class="w-220p ">Approver </div>
        <div class="w-120p ">Status</div>
        <div class="w-220p ">Remarks</div>
    </div>

    <div class="d-flex p-1 small cur-pointer text-start ">
        <div class="w-120p ">@hdr.DateRequested?.ToString("MMM dd, yyyy")</div>
        <div class="w-120p ">@hdr.Effectivity?.ToString("MMM dd, yyyy")</div>
        <div class="w-220p ">@hdr.ApproverName</div>
        <div class="w-120p ">@hdr.Status</div>
        <div class="w-220p ">@hdr.Remarks</div>
    </div>
</div>




