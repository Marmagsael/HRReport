@* --- Details ----------------------------------- *@
@if(OtReqdtls.Any()) {
    <div class="card ">

        <div class="card-header p-0 ">
            <div class="w-100 d-flex p-1 bg-secondary text-white small fw-bold ">
                <div class="w-250p"> Date and Time </div>
                <div class="w-100p text-center "> OT Applied </div>
                <div class="w-100p text-center "> Duty Type </div>
            </div>
        </div>

        <div class="card-body p-0 ">
            @foreach(var dtl in OtReqdtls) 
            {
                <div class="w-100 d-flex p-1 py-2" >
                    <div class="w-250p d-flex"> 
                        <span class="px-2">@dtl.PunchIn.ToString("MMM dd")</span>
                        <span class="px-2 text-secondary">@dtl.PunchIn.ToString("HH:ss tt")</span>

                    </div>
                    <div class="w-100p text-center "> @dtl.TotHrs.ToString("N2") </div>
                    <div class="w-100p text-center "> @dtl.DutyTypeId </div>
                    
                </div>
            }
        </div>
    </div>
}






@inject IOtreqdtlDataAccess _otreqdtl; 

@code {

    [Parameter] public  UserClaimsModel?        Uc  { get; set; } = new();
    [Parameter] public  V12_102OT               Ot  { get; set; } = new(); 
    [Parameter] public EventCallback<int>       Ca  { get; set; } = new();

    List<OtreqdtlModel> OtReqdtls = [];
    bool showLoadBtn = false;
    OtreqhdrModel otReqhdr = new();


    async Task FetchDtl(OtreqhdrModel hdr) {
        showLoadBtn = true;
        otReqhdr    = hdr;
        OtReqdtls   = [];
        var res = await _otreqdtl._02ByOtReqHdrId(hdr.Id??0, Uc.SchemaUserPis, Uc.Conn);
        if(res.Any()) { 
            OtReqdtls   = res!;
            Ot.OTReqdtls = res!;  }   
    }
    
    async Task LoadTransaction() {
        Ot.OTReqhdr= otReqhdr;
        Ot.OTReqdtls.ForEach(dtl => {
            Ot.AttPunches1s.ForEach(p => {
                if(p.PunchInDate == dtl.PunchIn) {
                    int? hr      = (int)dtl.TotHrs; 
                    int? min     = (int)((dtl.TotHrs - hr) * 60);
                    p.Hour      = hr??0;
                    p.Minute    = min??0;
                }
            });
        });

        await Ca.InvokeAsync(otReqhdr.Id??0);
    }


    OtreqhdrModel OtHdr => Ot.OTReqhdr;
    string? GetStatusText(string? status) => 
            status?.ToUpper() switch  { "N" => "New", "S" => "Save", "F" => "For Approval", "C" => "Cancelled", _   => "Unknown" };
    string? GetStatusTextCSS(string? status) => 
        status?.ToUpper() switch
        {
            "N" => " text-secondary",
            "S" => " text-info",
            "F" => " text-primary",
            "A" => " text-success",
            _   => " text-dark"
        };
}