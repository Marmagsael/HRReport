@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.Models._10_Pis
@using OfficeOpenXml.FormulaParsing.Excel.Functions.DateTime

<div class="card text-start ">
    <div class="card-header p-0 ">
        <div class=" px-1 py-2 w-100 d-flex border-bottom-darkgreen small fw-bold ">
            <div class="w-100p text-center "> TRN </div>
            <div class="w-100p"> Requested </div>
            <div class="w-100p"> Cov. Start </div>
            <div class="w-100p"> Cov. End </div>
            <div class="w-175p"> Approver </div>
            <div class="w-120p text-center "> Status </div>
            <div class="w-100p"> Remarks </div>
        </div>
    </div>
    
    <div class=" card-body p-0 ">
        @{ int? ctr = 1; }
        @foreach(var hdr in Ot.OTReqhdrs) 
        {
            ctr++; 
            string? rowCss = ctr % 2 == 1 ? "bg-light" : " ";
            <div class=" p-0" style="text-align: left !important;">

            
            <div @onclick="()=>FetchDtl(hdr)" class=" px-1 py-2 d-flex @rowCss cur-pointer mb-lbtn mb-lbtn-blue  "  > 
                <div class="w-100p text-center "> @hdr.Id </div>
                <div class="w-100p"> @hdr.DateRequested?.ToString("MMM dd") </div>
                <div class="w-100p"> @hdr.CovStart?.ToString("MMM dd") </div>
                <div class="w-100p"> @hdr.CovEnd?.ToString("MMM dd") </div>
                <div class="w-175p"> @hdr.ApproverName </div>
                <div class="w-120p @GetStatusTextCSS(hdr.Status)  text-center "> @GetStatusText(hdr.Status) </div>
                <div class="w-100p">  @hdr.Remarks </div>
            </div>
            </div>


        }
    </div>
</div>

