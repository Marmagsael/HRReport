<div class="d-flex gap-1 p-1 border-bottom ">
    <div @onclick="New" class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
    <div @onclick="Save" class="p-1 mb-cbtn mb-cbtn-blue card w-75p @(CanSave ? "" : "disabled-div") "> Save </div>
    <div @onclick="ShowSendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @(CanSend ? "" : " disabled-div ") "> Send For Approval </div>
    <div @onclick="ShowCancel" class="p-1 mb-cbtn mb-cbtn-red card w-100p @(CanCancel ? "" : " disabled-div ")"> Cancel </div>
    <div @onclick="ShowMyRequest" class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
</div>



@code {



    void New() {}

    void Save() {}        
    void ShowSendForApproval() {}    
    void ShowCancel() {}    
    void ShowMyRequest() {}    

    
    bool CanSave    => true; 
    bool CanSend    => true; 
    bool CanCancel  => true; 
    
}