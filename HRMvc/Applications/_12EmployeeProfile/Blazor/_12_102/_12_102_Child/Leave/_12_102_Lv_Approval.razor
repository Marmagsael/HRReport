<div class="card b-black ">
    <div class="card-header p-0 ">
        <div class="bordered-bottom py-2 small fw-bold text-white bg-black px-2  ">
            Leave Request
        </div>

        <div class="p-1 d-flex gap-2 small ">
            <button @onclick="MarkAll" class="btn text-primary w-80p bordered-bottom p-1 @markAllCss ">Mark All
            </button>
            <button @onclick="UnmarkAll" class="btn text-primary w-90p bordered-bottom p-1 @unmarkAllCss ">Unmark All
            </button>
            <div class="w-10p bordered-left">&nbsp; </div>
            <button class="btn text-successw  w-130p bordered-bottom p-1 @noSelectedCss ">Approve Selected </button>
            @* <button class="btn text-success w-130p bordered-bottom p-1 @noSelectedCss ">Partially Approve </button> *@
            
        </div>
    </div>

    <div class="card-body">
        
        <div class="d-flex gap-2 small fw-bold border-bottom  py-1">
            <div class="w-200p">Requestor</div>
            <div class="w-50p">TRN</div>
            <div class="w-100p">Date Applied</div>
            <div class="d-flex flex-grow-1 ">Reason</div>
            
        </div>

        @foreach (var r in V.LvApps)
        {
            <div class="d-flex gap-2 mt-1">
                <div class="w-200p py-1 d-flex gap-1">
                    <div>
                        <RadzenCheckBox @bind-Value=@r.IsSelected TValue="bool" />
                    </div>
                    <div>@r.RequestorName</div>
                </div>
                <div class="w-50p" py-1>@r.Id</div>
                <div class="w-100p py-1">@r.DateApplied.ToShortDateString()</div>
                <div class=" w-300p">
                     
                </div>
                <div class="">
                    <button @onclick="() => ShowDtl(r)" class="btn btn-outline-secondary">Show Details</button>
                </div>
            </div>
            <div class="w-100 d-flex border-bottom ms-4" style="padding: 3px 0 5px 0 ;">
                <div class="w-120p fw-bold small  "><i>Reason : </i></div>
                <div class="text-muted">@r.Reason</div>
            </div>
        }
    </div>

</div>


@code {
    [CascadingParameter] public UserClaimsModel Uc { get; set; } = new();
    [Parameter] public V12_102Obligation V { get; set; } = new();


    async Task ShowDtl(LeaveapplicationModel h)
    {
        @* var res = await _attreqdtl._02ByAttReqHdrIds(h.Id, Uc.SchemaUserPis, Uc.Conn);
        V.Attreqdtls = [];
        if (res != null && res.Count > 0)
        {
            V.Attreqdtls = res!;
            V.Attreqhdr = h;
        }

        ShowModal = true; *@
    }

    bool isMarkAll => (V.LvApps.Where(a => a.IsSelected == true).ToList().Count == V.LvApps.Count);
    string markAllCss => isMarkAll ? " disabled-div " : " ";
    bool isUnmarkAll => (V.LvApps.Where(a => a.IsSelected == false).ToList().Count == V.LvApps.Count);
    string unmarkAllCss => isUnmarkAll ? " disabled-div " : " ";
    bool isNoSelected => (V.LvApps.Where(a => a.IsSelected == true).ToList().Count > 0);
    string noSelectedCss => !isNoSelected ? " disabled-div " : " ";
    void MarkAll() { V.LvApps.ForEach(a => { a.IsSelected = true; }); }
    void UnmarkAll() { V.LvApps.ForEach(a => { a.IsSelected = false; }); }

}

