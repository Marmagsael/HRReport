@using HRApiLibrary.DataAccess._90_Utils
<div class="card p-0 small ">
    <div class="d-flex card-header px-1 gap-1 fw-bold text-center ">
        <div class="w-100p">TRN </div>
        <div class="w-100p">Leave Type </div>
        <div class="w-100p">Credit Period </div>
        <div class="w-150p text-start">Date Covered </div>
        <div class="w-150p">With Pay</div>
        <div class="">Reason </div>
    </div>
    @if(V.LeaveApplications.Count==0) {
        <div class="card-body p-1 text-center w-100 bg-secondary bg-opacity-10 text-primary "> Leave Request is empty. </div>
    }

    @{int i=0; }
    @foreach(LeaveapplicationModel d in V.LeaveApplications) {
        i++; 
        string css = i%2 == 0 ? " bg-dgray " : " "; 
        <div @onclick="() => SelectRecord(d)"
             class="d-flex card-body p-1 text-center cur-pointer @css  ">
            <div class="w-100p">@d.Id </div>
            <div class="w-100p">@( _02leaveType(d.LeaveTypeId)) </div>
            <div class="w-100p">@d.Yr </div>
            <div class="w-170p d-flex ">
                @d.LvStart.ToString("MM/dd/yyyy").Trim() - @d.LvEnd.Date.ToString("MM/dd/yyyy").Trim() 
            </div>
            <div class="w-100p ">@d.DaysWithPay </div>
            <div class="">@d.Reason </div>
        </div>
    }


</div>





@code {
    [CascadingParameter]    public UserClaimsModel      Uc              { get; set; }
    [CascadingParameter]    public V12_102Lv            V               { get; set; } = new();
    [Parameter]             public EventCallback        ChildAction     { get; set; } 


    string _02leaveType(int lvType) => V.LeaveTypes.FirstOrDefault(t => t.Id==lvType).LeaveName??"-";

    @* --- Functions -------------------------------------------------- *@

    async Task SelectRecord(LeaveapplicationModel lva) {
        MsdsDataAccess msds = new(); 
        V.LeaveApplication  = (LeaveapplicationModel)msds.ObjectMapper(lva, V.LeaveApplication);
        V.ShowMyReqquest    = false; 
        V.Action            = "LoadLvApplication"; 
        await ChildAction.InvokeAsync(); 
    }
}