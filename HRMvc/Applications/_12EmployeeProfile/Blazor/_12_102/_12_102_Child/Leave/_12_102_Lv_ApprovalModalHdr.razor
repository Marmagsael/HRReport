@using HRApiLibrary.DataAccess._10_Pis
@using HRMvc.Applications._00GeneralComponents


<div class="p-2">
    <div class="@divHdrcss">
        <div class="@lblcss  "> Control No </div>
        <div class="p-2 "> @hdr.Id </div>
    </div>

    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Date Requested </div>
        <div class="p-2 ">@hdr.DateApplied.ToString("MMM dd, yyyy")</div>
    </div>

    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Requestor Name </div>
        <div class="p-2 ">
            <h5>@hdr.RequestorName</h5>
        </div>
    </div>

    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Coverage </div>
        <div class="p-2 ">
            @hdr.LvStart.ToString("MMM dd, yyyy") -
            @hdr.LvEnd.ToString("MMM dd, yyyy")
        </div>
    </div>
    
    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Leave Type </div>
        <div class="p-2 fw-bold "> @hdr.Leavetypename </div>
    </div>

    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Duration </div>
        <div class="d-flex gap-2">  
            <div class="p-2 w-75p text-center ">@hdr.DaysCnt</div>

            <div class="bg mb-a-greenlight p-2 bordered-right bordered-left "> Days With Pay </div>
            <div class="p-2 w-75p text-center"> @hdr.DaysWithPay </div>
            
            <div class="bg mb-a-greenlight p-2 bordered-right bordered-left "> Leave Balance </div>
            <div class="p-2 "> @hdr.LvBalance </div>

        </div>
    </div>
    
    @* --- Approver ---------------------- *@
    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Approver </div>
        <div class="d-flex gap-2">
            <div class="py-2 px-4 text-center fw-bold small ">@hdr.Approver1Name</div>

            <div class="p-2 bordered-right bordered-left text-success "> Final Approver </div>
            <div class="p-2 fw-bold  small "> @hdr.Approver2Name </div>
            


        </div>
    </div>

    @* --- Current Approver ---------------------- *@
    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Current Approver </div>
        <div class="p-2 "> 
            @if(hdr.ApproverLevel == 1) { <span class="">@hdr.Approver1Name</span> <span class="text-primary">- [ First Approver ] </span> }
            else {   <span class="">@hdr.Approver2Name</span> <span class="text-primary">- [ Final Approver ] </span> }
        </div>
    </div>

    @* --- Reason ---------------------- *@
    <div class="@divHdrcss">
        <div class="bg mb-a-greenlight p-2 @lblcss "> Reason </div>
        <div class="p-2 "> @hdr.Reason </div>
    </div>

                
</div>

@inject IJSRuntime _js;
@inject IAtttemplatereqhdrDataAccess    _attreqhdr;

@code {
    [Parameter] public LeaveapplicationModel? hdr { get; set; } = new(); 
    [Parameter]          public V12_102Obligation       V  { get; set; } = new();

    string  divHdrcss   => " d-flex bordered-bottom ";
    string  lblcss      => " w-150p bg mb-a-greenlight p-2  ";


}



