<div class="card @BrdCss "> 
    <div class="card-header small fw-bold p-2 bg @BgCss text-white ">
        @HdrCaption 
    </div>
    <div class="card-body text-center p-1 text-success  small text-opacity-75 ">
        <div>No Pending Request</div>
    </div>
</div>
@code{
    [Parameter] public string?   HdrCaption      { get; set; } = "Request"; 
    [Parameter] public string?   BrdCss          { get; set; } = " b-blue "; 
    [Parameter] public string?   BgCss          { get; set; } = " mb-a-blue "; 


}