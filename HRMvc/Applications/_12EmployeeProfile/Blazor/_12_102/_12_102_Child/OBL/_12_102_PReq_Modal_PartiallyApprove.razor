@using Blazorise
@using HRApiLibrary.DataAccess._10_Pis.Interface

<div class="card m-1 b-dgray">
    
    <!-- Header -->
    <div class="d-flex justify-content-between bg-secondary p-1 bordered-bottom">
        <div class="d-flex align-items-center px-2 text-white ">Partially Approve</div>
        <div><button @onclick="Close" class="btn text-white">X</button></div>
    </div>

    <!-- Body -->
    <div class="d-flex gap-2 bg-success bg-opacity-10 p-2">
        
        <!-- Label -->
        <div class="d-flex align-items-center w-125p "> Approver <span class="text-danger">*</span> </div>

        <!-- Input + Button -->
        <div class="d-flex flex-grow-1 gap-1 w-100" style="min-width: 0;">
    
            <div class="w-75 p-1 d-flex gap-1" style="min-width: 0;">
                <div class="w-125p">
                    <input  @onblur="LocateApprover" 
                            type="text" 
                            @bind-value="approverNumber" 
                           placeholder="XXXXX" 
                           class="form-control" 
                           style="width: 100%; max-width: 100%;" />
                </div>
                <div class="d-flex flex-grow-1 ">
                    <input  type="text" 
                            @bind-value="V.Attreqhdr.ApproverName"  
                            disabled
                           class="form-control" 
                           style="width: 100%; max-width: 100%;" />
                </div>
                
            </div>

            <div class="w-25 d-flex align-items-center">
                <button @onclick="Submit" class="btn btn-secondary @submitCss">Submit</button>
            </div>

        </div>
    </div>

</div>

@inject IAttreqhdrDataAccess _arhdr;
@inject IEmpmasInternalDataAccess   _empmas; 

@code {
    [CascadingParameter] public UserClaimsModel Uc { get; set; }
    [Parameter] public V12_102Obligation V { get; set; } = new();
    [Parameter] public EventCallback Ec { get; set; }

    // ✅ Safe computed property (no null errors)
    string? submitCss => !string.IsNullOrWhiteSpace(V?.Attreqhdr?.ApproverName) ? "" : "disabled-div-50";
    // ✅ Optional: actual disabled state (recommended)
    bool IsDisabled => string.IsNullOrWhiteSpace(V?.Attreqhdr?.ApproverName);
    string? approverNumber = string.Empty; 

    async Task LocateApprover() {
        V.Attreqhdr.ApproverName = string.Empty; 
        List<EmpmasInternalModel?>? res = await _empmas._02byEmpnumber(approverNumber, Uc.SchemaUserPis, Uc.Conn); 
        if(res!=null && res.Count>0) {
            V.Attreqhdr.ApproverName = res?.FirstOrDefault().Fullname??string.Empty; 
        }        
    }

    async Task Close()
    {
        V.Action = "ClosePR";
        await Ec.InvokeAsync();
    }


    async Task Submit() {
        V.Action = "PR_PartiallyApproved";
        foreach (var h in V.Attreqhdrs.Where(h => h.IsSelected??false))
        {
            await _arhdr._03PartiallyApprove(h, approverNumber, Uc.SchemaUserPis, Uc.Conn);
        }
        await Ec.InvokeAsync();
    }


}