<div class="card-header"> Time Sheet Management </div>


<div class="w-100 mt-1 ">
   <div class="mb-tabs bordered-bottom-darkgreen ">
        <div @onclick="@(()=>TabClick(1))" class="mb-tab mb-a-blue @(tab==1?" active " : "")">Punch Request</div>
        <div @onclick="@(()=>TabClick(2))" class="mb-tab mb-a-blue @(tab==2?" active " : "") ">OT Request</div>
        <div @onclick="@(()=>TabClick(3))" class="mb-tab mb-a-blue @(tab==3?" active " : "") ">Change Schedule</div>
    </div>
</div>

@if(tab==1) {<div> <_12_102_TS_PunchRequest Uc="@Uc"  /> </div>}
@if(tab==2) {<div> <_12_102_TS_OTRequest Uc="@Uc"  /> </div>}
@if(tab==3) {<div> <_12_102_TS_ChangeScheduleRequest Uc="@Uc" /> </div>}



@code {

    [Parameter] public UserClaimsModel?         Uc  { get; set; } = new();

    protected override async void OnInitialized()
    {
        
    }

    int? tab = 1; 

    async Task TabClick(int? tno) {
        tab= tno; 
        //await Ec.InvokeAsync(tno); 
    }





    AttreqhdrModel          ArHdr   = new(); 
    AttreqdtlModel          ArDtl   = new(); 
    List<AttreqtypeModel>   ArTypes = []; 


    bool IsCoverageValid()
    {
        return ArHdr?.CovStart != null && ArHdr?.CovEnd != null && ArHdr.CovStart <= ArHdr.CovEnd;
    }

}
