@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._90_Utils
@using OfficeOpenXml.FormulaParsing.Excel.Functions.Math
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<div class="d-flex gap-1 p-1 border-bottom ">
    <div @onclick="New"                 class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
    <div @onclick="Save"                class="p-1 mb-cbtn mb-cbtn-blue card w-75p @(CanSave) "> Save  </div>
    <div @onclick="ShowSendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @(CanSend ) "> Send For Approval </div>
    <div @onclick="ShowCancel"          class="p-1 mb-cbtn mb-cbtn-red card w-100p @(CanCancel)"> Cancel </div>
    <div @onclick="ShowMyRequest"       class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
</div>

<div class="card mt-1">
    <div class="p-2 border-bottom">
        <div class="p-0 d-flex justify-content-between ">
            <div class="d-flex p-1">
                <div class="w-120p p-2">Control No.</div>
                <div class="w-175p border-bottom fw-bold text-center p-2 text-primary "> 
                    @(Hdr.Id < 1 ? "-" : Hdr.Id) 
                </div>
            </div>
            
            <div class="d-flex p-1">
                <div class="w-75p p-2">Status</div>
                <div class="w-175p   text-start p-2 text-primary "> 
                    @(Hdr.Status switch {"N" => "New", "S" => "Saved", "F" => "For Approval", "A" => "Approved", _ => "Unknown" } )
                </div>
            </div>
        </div>
        
        <div class="mb-a-blue d-flex ">
            <div class="w-120p p-2">Date</div>
            <RadzenDatePicker @bind-Value="Hdr.DateRequested" 
                @ref="dateRequestedPicker"
                DateFormat="MM/dd/yyyy"
                AllowInput="false"
                class="mb-date-accent w-150p" />
        </div>

        <div class="mb-a-blue d-flex mt-1">
            <div class="w-120p p-2">Effectivity</div>
            <div class="  ">
                <RadzenDatePicker 
                    @bind-Value="Hdr.Effectivity" 
                    DateFormat="MM/dd/yyyy"
                    AllowInput="false"
                    class="mb-date-accent w-150p" />
            </div>

        </div>

        <div class="d-flex mt-1">
            <div class="w-120p px-2"> Approver </div>
            <div class="w-150p "> 
                <RadzenTextBox 
                    @bind-Value="Hdr.EmpNumber_Approver"
                    Change="FetchApprover"
                    MaxLength="5"
                    class="mb-input-accent"
                    Style="width: 100%;" />
            </div>
            <div class="mb-a-blue flex-grow-1 px-1 "> 
                <RadzenTextBox 
                    @bind-Value="Hdr.ApproverName"
                    Disabled
                    class="mb-input-accent"
                    Style="width: 100%;" />
            </div>
        </div>
        
        <div class="d-flex">
            <div class="w-120p p-2"> Remarks </div>
            <div class=" flex-grow-1 py-1 "> 
                <RadzenTextArea 
                    @bind-Value="Hdr.Remarks"
                    MaxLength="120"
                    Rows="3"
                    class="mb-input-accent"
                    Style="width:100%;" />
            </div>
        </div>  
    </div>



    @* --- Details ------------------------------- *@
    <div class="card-body p-0">
        @* --- Header ----------------------------------------------------------------- *@
        <div class="d-flex"> 
            @* --- Current Header ----------------------------------------------------- *@
            <div class="w-50 txt mb-a-gray ">
                <div class="d-flex fw-bold py-2 border-bottom">
                    <div class="w-60 text-center bordered-right"></div>
                    <div class="w-40 text-center bordered-right">Current Schedule</div>
                </div>
                
                <div class="d-flex fw-bold py-2">
                    <div class="w-60 text-center bordered-right">Duty Type</div>
                    <div class="w-20 text-center bordered-right">IN</div>
                    <div class="w-20 text-center bordered-right">OUT</div>
                </div>
            </div>
            
            @* --- Request Header ----------------------------------------------------- *@
            <div class="w-50">
                <div class="d-flex fw-bold py-2 border-bottom">
                    <div class="w-100 text-center bordered-right">Request Schedule</div>
                </div>
                
                <div class="d-flex fw-bold py-2  border-bottom">
                    <div class="w-25 text-center bordered-right">Duty Type</div>
                    <div class="w-25 text-center bordered-right">IN</div>
                    <div class="w-25 text-center bordered-right">Duration</div>
                    <div class="w-25 text-center ">OUT</div>
                </div>
            </div>
            
        </div>
        
        @* --- Details -------------------------------------------------------- *@
        <div class="card-body p-0 ">
            <div class="d-flex">
                @* --- Current Details ---------------------------------------- *@
                <div class="w-50 txt mb-a-gray">
                    <_12_102_01_AT_Component
                        DayName="Monday"
                        DutyType="@Dtl?.D1_dutytype"
                        Duration="@Dtl?.D2_hrslength"
                        In="@Dtl?.D2_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Tuesday"
                        DutyType="@Dtl?.D2_dutytype"
                        Duration="@Dtl?.D3_hrslength"
                        In="@Dtl?.D3_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Wednesday"
                        DutyType="@Dtl?.D3_dutytype"
                        Duration="@Dtl?.D3_hrslength"
                        In="@Dtl?.D3_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Thursday"
                        DutyType="@Dtl?.D4_dutytype"
                        Duration="@Dtl?.D4_hrslength"
                        In="@Dtl?.D4_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Friday"
                        DutyType="@Dtl?.D5_dutytype"
                        Duration="@Dtl?.D5_hrslength"
                        In="@Dtl?.D5_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Saturday"
                        DutyType="@Dtl?.D6_dutytype"
                        Duration="@Dtl?.D6_hrslength"
                        In="@Dtl?.D6_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                    <_12_102_01_AT_Component
                        DayName="Sunday"
                        DutyType="@Dtl?.D7_dutytype"
                        Duration="@Dtl?.D7_hrslength"
                        In="@Dtl?.D7_in"
                        AttType="@Dtl?.AttendancetypeId"/>

                </div>

                @* --- Request Details ------------------------------------------------ *@
                <div class="w-50 ">
                    <div class="d-flex py-2 bordered-bottom">
                        
                        <div class="w-25 bordered-left text-center p-0 "> 
                            <RadzenDropDown 
                                Data="@dutyTypes"
                                @bind-Value="@Cs.Atttemplatereqdtl.D1_DutyType"
                                Style="width:90%; "
                                Placeholder="Select Duty Type" />
                        </div>
                        <div class="w-25 bordered-left"> 
                            <RadzenDropDown
                                Data="@timeOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@Cs.Atttemplatereqdtl.D1_In"
                                Placeholder="Select Time"
                                Style="width:97%" />
                        </div>
                        <div class="w-25 bordered-left"> 
                            <RadzenDropDown
                                Data="@timedurations"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@Cs.Atttemplatereqdtl.D1_HrsLength"
                                Placeholder="Select Duration"
                                Style="width:97%" />
                        </div>
                        <div class="w-25 bordered-left"> @DtlReq.D1_HrsLength</div>
                    </div>

                </div>

            </div>
        </div>


    </div>




</div>


@inject IAtttemplateDataAccess _atttemplate;



@code {

    [Parameter] public UserClaimsModel? Uc { get; set; } = new();   
    V12_102CS   Cs = new();
    
    
    
    protected override async Task OnInitializedAsync(){
        var res = await _atttemplate._02s(Uc.UserId, Uc.SchemaUserPis, Uc.Conn);
        if (res.Count > 0 ) {
            Cs.Atttemplate = res.FirstOrDefault()??new AtttemplateModel();
            AtttemplateModel? re = res.FirstOrDefault();
            Cs.Atttemplatereqdtl = AttTemplateReq_To_AttTemplate(re);
            


        }
        else { 
            var res1 = _atttemplate._02NoSchedule(Uc.UserId); 
            Cs.Atttemplate = res1;
        }

    }
    
    RadzenDatePicker<DateTime?>? dateRequestedPicker;

    void New() {

    }
    void Save() {

    }
    void ShowSendForApproval() {

    }
    void ShowCancel() {

    }
    void ShowMyRequest() {

    }
    void FetchApprover() {

    }


    bool CanSave => true;
    bool CanSend => true;
    bool CanCancel => true;

    AtttemplateModel                ctemp       => Cs.Atttemplate??new AtttemplateModel(); 
    AtttemplatereqhdrModel          Hdr         => Cs.Atttemplatereqhdr??new AtttemplatereqhdrModel();
    AtttemplatereqdtlModel          DtlReq      => Cs.Atttemplatereqdtl ?? new AtttemplatereqdtlModel();
    AtttemplateModel                Dtl      => Cs.Atttemplate ?? new AtttemplateModel();
    List<AtttemplatereqdtlModel>    Dtls        => Cs.Atttemplatereqdtls??[];
    List<string>                    dutyTypes = new() {"R","RD"}; 
    List<TimeoptionModel> times = Enumerable.Range(0, 48).Select(i =>    
                                    {   var time = DateTime.Today.AddMinutes(i * 30);
                                        return new TimeoptionModel { Value = i * 30, Text = time.ToString("hh:mm tt") };
                                    }).ToList();      
    List<TimeoptionModel> timeOptions =  MsdsDataAccess._02Hours();  
    List<TimedurationModel> timedurations = MsdsDataAccess._02HourDurations();      
    

    AtttemplatereqdtlModel AttTemplateReq_To_AttTemplate( AtttemplateModel at  ) 
    {
        AtttemplatereqdtlModel atreq = new AtttemplatereqdtlModel();

        atreq.Id                    = 0;
        atreq.AtttemplateReqHdrId   = Hdr.Id;

        atreq.EmpmasId              = at.Empmasid;
        atreq.AttendanceTypeId      = at.AttendancetypeId;

        atreq.D1_In = at.D1_in;
        atreq.D2_In = at.D2_in;
        atreq.D3_In = at.D3_in;
        atreq.D4_In = at.D4_in;
        atreq.D5_In = at.D5_in;
        atreq.D6_In = at.D6_in;
        atreq.D7_In = at.D7_in;

        atreq.D1_HrsLength =at.D1_hrslength; 
        atreq.D2_HrsLength =at.D2_hrslength; 
        atreq.D3_HrsLength =at.D3_hrslength; 
        atreq.D4_HrsLength =at.D4_hrslength; 
        atreq.D5_HrsLength =at.D5_hrslength; 
        atreq.D6_HrsLength =at.D6_hrslength; 
        atreq.D7_HrsLength =at.D7_hrslength; 

        atreq.D1_DutyType = at.D1_dutytype??string.Empty;
        atreq.D2_DutyType = at.D2_dutytype??string.Empty;
        atreq.D3_DutyType = at.D3_dutytype??string.Empty;
        atreq.D4_DutyType = at.D4_dutytype??string.Empty;
        atreq.D5_DutyType = at.D5_dutytype??string.Empty;
        atreq.D6_DutyType = at.D6_dutytype??string.Empty;
        atreq.D7_DutyType = at.D7_dutytype??string.Empty;

        return atreq;

    }










}