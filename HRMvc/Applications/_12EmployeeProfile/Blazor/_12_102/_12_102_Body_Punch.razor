@{
    var empmas = Oempmass.FirstOrDefault() ?? new OempmasModel();
    var currIn  = "00:00"; 
    var currOut = "00:00"; 
    var prevIn  = "00:00"; 
    var prevOut = "00:00"; 
    
    var currInDisabled   = false;
    var currOutDisabled  = false;
    var prevInDisabled   = false; 
    var prevOutDisabled  = false;
}


<div class="card w-100">
    <div class="card-header w-100 ">
        Punches and Duty Schedules
    </div>
        
    <div class="p-2 text-primary border-bottom "> Your system ID Number is <span class="text-success">@UserClaims.UserId</span>  </div>
        
    <div class="card-body">
        @*--- Punch In ----------------*@
        <div class=" d-flex gap-2 p-1">
            <div class="p-2 w-100p"> Punch IN </div>
            <div><RadzenTextBox @bind-Value="currIn" class="w-100p" Disabled /></div>
            <div class="p-1">
                <button class="btn btn-primary w-115p" @onclick="CPunchIn" disabled="@currInDisabled">Punch IN</button>
            </div>
            
        </div>
        
        @*--- Punch Out  ----------------*@
        <div class=" d-flex  gap-2 p-1">
            <div class="p-2  w-100p"> Punch OUT </div>
            <div><RadzenTextBox @bind-Value="currOut" class="w-100p" Disabled /></div>
            <div class="p-1">
                <button class="btn btn-warning w-115p" @onclick="CPunchOut" disabled="@currOutDisabled" >Punch Out</button>
            </div>
        </div>    
    </div>
    
</div>



@code {
    
    [Parameter] public UserClaimsModel?         UserClaims { get; set; } = new(); 
    [Parameter] public List<OempmasModel?>?     Oempmass   { get; set; } = [];

    void CPunchIn()
    {
        
    }
    void CPunchOut()
    {
        
    }
    
    

}