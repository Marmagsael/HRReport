@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.DataAccess._10_Pis.Interface
@using HRApiLibrary.DataAccess._90_Utils
@using HRApiLibrary.Models._10_Pis

@{ var ac = Attpunches1_Current; }

<div class="card w-100">
    <_12_102_Cardhdr caption="Punches and Duty Schedules" /> 

            
    @* <div class="p-2 text-primary border-bottom "> Your system ID Number is <span class="text-success">@UserClaims.UserId</span>  </div> *@
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary "> @v.Msg </div>
        <div class="p-2  text-success"> 
            @v.MsgVal  - 
            <span class="text-primary">@(Attpunches1_Current?.PunchInDate?.ToString("dddd") ?? "-")</span>
        </div>
    </div>
    
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary "> Login Template : </div>
        <div class="p-2  text-success"> 
            <span class="px-2 bordered-right">IN : @pSchedule.InTime</span>     
            <span class="px-2 bordered-right">Duration : @pSchedule.HrsLenght</span>     
        </div>
    </div>
    

    <div class="card-body">
        @if (Attpunches1_Current?.Status == "-")
        {
        @*--- Punch In ----------------*@
        <div class=" d-flex  gap-2 p-1 align-items-center justify-content-center">
            <div class="p-2 w-100p"> Punch IN </div>
            <div><RadzenTextBox id="pin" @bind-Value="v.CurrIn" class="w-150p text-center" Disabled /></div>

            <div class="card p-2 mb-cbtn mb-cbtn-blue d-flex w-125p" @onclick="CPunchIn">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="p-1 fa-solid fa-right-from-bracket fs-4 "></i>
                    <span class="p-0">Punch In</span>
                </div>                                
            </div>



            @* <div class="p-1">
                <button class="btn btn-primary w-115p" @onclick="CPunchIn" disabled="@v.currInDisabled">Punch IN</button>
            </div> *@
            
        </div>
        }
        else if (Attpunches1_Current != null)
        {
        @*--- Punch Out  ----------------*@
        <div class=" d-flex  gap-2 p-1 align-items-center justify-content-center">
            <div class="p-2  w-100p"> Punch OUT </div>
            <div><RadzenTextBox id="pout" @bind-Value="v.CurrOut" class="w-150p text-center" Disabled /></div>

            <div class="card p-2 mb-cbtn mb-cbtn-red d-flex" @onclick="CPunchOut">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="p-1 fa-solid fa-right-from-bracket fs-4 text-blue"></i>
                    <span class="p-0">Punch Out</span>
                </div>                                
            </div>
            @* <button class="p-2 card "  disabled="@v.currOutDisabled" >Punch Out</button> *@

        </div>    
        }
    </div>
    
</div>

@inject IAttdailyDataAccess _attdaily 
@inject IAttpunches1DataAccess _attpunches1  
@inject NavigationManager NavigationManager

@code {
    
    [Parameter] public UserClaimsModel?         uc                      { get; set; } = new(); 
    [Parameter] public List<OEmpmasModel?>?     OEmpmass                { get; set; } = [];
    [Parameter] public Attpunches1Model?        Attpunches1_Current     { get; set; } = new();
    [Parameter] public AtttemplateModel?        Atttemplate             { get; set; } = new();  

    V12_102BodyPunch v = new V12_102BodyPunch();
    PunchSchedule pSchedule = new PunchSchedule(0,0,0,"RD");

    @inject IJSRuntime JS


protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await JS.InvokeVoidAsync("startTextboxTime", "pout");
        await JS.InvokeVoidAsync("startTextboxTime", "pin");
    }
}

    async Task CPunchIn()
    {
        if (uc is null) return;

        string?         dayName     = DateTime.Now.DayOfWeek.ToString();
        int             dayNo       = MsdsDataAccess.GetDayNo(dayName);
        
        //--- Attendance Daily --------------
        var attDaily = new AttdailyModel()
        {
            Empmasid    = uc?.UserId ?? 0,      
            Empnumber   = uc?.OempNumber ?? "-", 
            Punchdate   = DateTime.Now.Date, 
            Dayno       = dayNo, 
            Timein      = DateTime.Now,
            Timeint     = pSchedule.HrsLenght, 
            Dutytypeid  = pSchedule.DutyType == "R" ? 1 : 2, 
            Inbyid = uc?.UserId ?? 0,
            
        };
        var ad = await _attdaily._01PunchIn(attDaily, uc.SchemaUserPis, uc.Conn!);

        //--- Attendance Punches ---------------------------------
        var ipAdd       = MsdsDataAccess.GetIPAddress();
        var id          = TimeZoneInfo.Local.Id;
        var timeZone        = MsdsDataAccess.Get_TimeZone_Id(id);
        var macAddress  = MsdsDataAccess.GetMacAddress();

        Attpunches1Model? ap1 = new Attpunches1Model(){
            EmpmasId        = uc?.UserId ?? 0,
            DayNo           = dayNo, 
            PunchInDate     = DateTime.Now,
            PunchT          = pSchedule.InTime, 
            SchedDuration   = pSchedule.HrsLenght, 
            DutyTypeId      = pSchedule.DutyType == "R" ? 1 : 2,
            TimeZoneIdIn   = timeZone, 
            IpAddressIn    = ipAdd, 
            MacAddressIn   = macAddress, 
            UserIdIn       = uc?.UserId ?? 0, 
            Status          = "N"
        }; 

        var res = await _attpunches1._01(ap1, uc.SchemaUserPis!, uc.Conn!);
        NavigationManager.NavigateTo(NavigationManager.Uri, true);    
    }

    async Task CPunchOut()
    {
        if (uc is null) return;
        if (Attpunches1_Current == null) return;

        string? dayName     = Attpunches1_Current.PunchInDate?.DayOfWeek.ToString();
        int dayNo           = MsdsDataAccess.GetDayNo(dayName);
        int hrs             = pSchedule.HrsLenght / 100;
        int mins            = pSchedule.HrsLenght % 100;

        int schedHour = pSchedule.InTime / 100;
        int schedMin  = pSchedule.InTime % 100;

        DateTime schedIn = Attpunches1_Current.PunchInDate?
            .Date
            .AddHours(schedHour)
            .AddMinutes(schedMin) ?? DateTime.MinValue;

        DateTime schedOut = schedIn
            .AddHours(hrs)
            .AddMinutes(mins);

        int OutSchedule = schedOut.Hour * 100 + schedOut.Minute;
            

        AttdailyModel attDaily = new AttdailyModel()
        {
            Empmasid    = uc?.UserId ?? 0,
            Empnumber   = uc?.OempNumber ?? "-",
            Punchdate   = DateTime.Now.Date,
            Dayno       = dayNo,
            Timein      = Attpunches1_Current?.PunchInDate??DateTime.Now,
            Timeint     = Attpunches1_Current.PunchT,
            Timeoutt    = OutSchedule, 
            Dutytypeid  = pSchedule.DutyType == "R" ? 1 : 2,
            Inbyid      = uc?.UserId ?? 0,
            Outbyid     = uc?.UserId ?? 0,
        };
        var conn = uc.Conn ?? "-";
        var ad = await _attdaily._01PunchOut(attDaily, uc.SchemaUserPis??"-", conn );

        var ipAdd       = MsdsDataAccess.GetIPAddress();
        var id          = TimeZoneInfo.Local.Id;
        var timeZone        = MsdsDataAccess.Get_TimeZone_Id(id);
        var macAddress  = MsdsDataAccess.GetMacAddress();

        Attpunches1Model? ap1 = new Attpunches1Model(){
            EmpmasId        = uc?.UserId ?? 0, 
            DayNo           = dayNo, 
            PunchInDate     = Attpunches1_Current.PunchInDate, 
            PunchOutDate    = DateTime.Now,
            TimeZoneIdOut   = timeZone, 
            IpAddressOut    = ipAdd, 
            MacAddressOut   = macAddress, 
            UserIdOut       = uc?.UserId ?? 0, 
            Status          = "L"
        }; 
        var res = await _attpunches1._03s(ap1, uc.SchemaUserPis??"-", uc.Conn);

        NavigationManager.NavigateTo(NavigationManager.Uri, true);
        

    }

    protected override void OnInitialized()
    {
        InitUI();
    }

    protected override void OnParametersSet()
    {
        LoadFromParams();
    }

    
    record PunchSchedule(int AttendanceTypeId, int InTime, int HrsLenght, string DutyType); 
    PunchSchedule _02PunchSchedule(int dayno, AtttemplateModel at)
    {
        return dayno switch
        {
            1 => new(at.AttendancetypeId, at.D1_in, at.D1_hrslength, at.D1_dutytype ?? "RD"),
            2 => new(at.AttendancetypeId, at.D2_in, at.D2_hrslength, at.D2_dutytype ?? "RD"),
            3 => new(at.AttendancetypeId, at.D3_in, at.D3_hrslength, at.D3_dutytype ?? "RD"),
            4 => new(at.AttendancetypeId, at.D4_in, at.D4_hrslength, at.D4_dutytype ?? "RD"),
            5 => new(at.AttendancetypeId, at.D5_in, at.D5_hrslength, at.D5_dutytype ?? "RD"),
            6 => new(at.AttendancetypeId, at.D6_in, at.D6_hrslength, at.D6_dutytype ?? "RD"),
            7 => new(at.AttendancetypeId, at.D7_in, at.D7_hrslength, at.D7_dutytype ?? "RD"),
            _ => new(0,0,0,"RD")
        };
    }
    


    void InitUI()
    {
        v.CurrIn  = "-"; 
        v.CurrOut = "-"; 
        v.PrevIn  = "00:00"; 
        v.PrevOut = "00:00"; 

        v.CurrInDisabled  = false;
        v.CurrOutDisabled = false;
        v.PrevInDisabled  = false; 
        v.PrevOutDisabled = false;

        v.Msg    = "Punch In for : ";
        v.MsgVal = DateTime.Now.ToString("yyyy-MM-dd");
    }
    void LoadFromParams()
    {

        v.Empmas = OEmpmass?.FirstOrDefault() ?? new OEmpmasModel();
        
        if (Attpunches1_Current?.Status == "-")
        {
            v.CurrInDisabled  = false;
            v.CurrOutDisabled = true;
        }
        else if (Attpunches1_Current != null)
        {
            v.CurrInDisabled  = true;
            v.CurrOutDisabled = false;
            
            v.CurrIn = Attpunches1_Current.PunchInDate?.ToString("hh:mm tt");
            v.Msg    = "Punch Out for : ";
            v.MsgVal = Attpunches1_Current.PunchInDate?.ToString("yyyy-MM-dd hh:mm tt");
            
        }
        
        string? dayName     = DateTime.Now.DayOfWeek.ToString();
        if (Attpunches1_Current?.PunchInDate != null) 
                dayName     = Attpunches1_Current.PunchInDate?.DayOfWeek.ToString();
        int     dayNo       = MsdsDataAccess.GetDayNo(dayName);

        pSchedule = _02PunchSchedule(dayNo, Atttemplate??new()); 
    }

    
    

}