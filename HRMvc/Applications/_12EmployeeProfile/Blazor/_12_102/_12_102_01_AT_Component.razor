@using HRApiLibrary.Models._10_Pis
@{
    var hdrcss = "text-success";
    var dutyType = DutyType switch
    {
        "R" => "Working day",
        "RD" => "Rest day",
        "RN" => "Regular day",
        _ => "Unknown"
    };
    if (DutyType == "RD") hdrcss = "text-danger";
    if (DutyType == "RN") hdrcss = "text-primary";
    
}

<div class="d-flex py-2 bordered-top @hdrcss">
    <div class="w-60 d-flex px-2 bordered-right">
         <span class="w-125p "> @DayName </span> <span class=""> [ @dutyType ] </span>
    </div>
    <div class="w-20 text-center bordered-right">
        
        @if (DutyType == "RD") { <span >-</span> }
        else
        {
            var inTime = (int)(In ?? 0);
            <div> @inTime.ToString("0000H") </div>
        }
    </div>
    <div class="w-20 text-center ">
        
        @if (DutyType == "RD") { <div>-</div> }
        else
        {
            var inTime = (int)(In ?? 0);
            <div>
                @if (Duration == 0 || AttType == 3)
                {
                    <span>-</span>
                }
                else
                {
                    @outTime.ToString("0000H")
                }
            </div>
        }
    </div>
    
    
</div>




    




@code {

    int outTime = 0; 

    [Parameter] public int?     AttType         { get; set; } = 1;
    [Parameter] public string?  DutyType        { get; set; } = "RD";
    [Parameter] public string?  DayName         { get; set; } = string.Empty;
    [Parameter] public int?     In              { get; set; } = 0;
    [Parameter] public int?     Duration        { get; set; } = 0; 

    protected override void OnParametersSet()
    {
        if (Duration > 0) outTime = In + Duration??0;
        if (outTime >= 2359) outTime = outTime - 2400; 
    }

}
