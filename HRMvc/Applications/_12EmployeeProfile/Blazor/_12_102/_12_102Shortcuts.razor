        </div>
    </div>

    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink4" @onclick="() => SetActiveLink(4)">
        <div class="d-flex gap-2 text-align-center">
            <div>
                <i class="fa-solid fa-money-bill-transfer fs-2 text-success"></i>
            </div>
            <div class="p-1">
                <span class="fw-semibold">My Obligation</span>
            </div>
        </div>
    </div>

</div>

<!-- ROW 2 -->
<div class="w-100 d-flex gap-3 px-2 py-1 bordered-bottom">

    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink5" @onclick="() => SetActiveLink(5)">
        <div class="d-flex gap-2 text-align-center">
            <div>
                <i class="fa-solid fa-building-columns fs-2 text-primary"></i>
            </div>
            <div class="p-1">
                <span class="fw-semibold">SSS Remittance</span>
            </div>
        </div>
    </div>

    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink6" @onclick="() => SetActiveLink(6)">
        <div class="d-flex gap-2 text-align-center">
            <div>
                <i class="fa-solid fa-notes-medical fs-2 text-danger"></i>
            </div>
            <div class="p-1">
                <span class="fw-semibold">PHIC Remittance</span>
            </div>
        </div>
    </div>

    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink7" @onclick="() => SetActiveLink(7)">
        <div class="d-flex gap-2 text-align-center">
            <div>
                <i class="fa-solid fa-house-circle-check fs-2 text-success"></i>
            </div>
            <div class="p-1">
                <span class="fw-semibold">PAGIBIG Remittance</span>
            </div>
        </div>
    </div>

    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink8" @onclick="() => SetActiveLink(8)">
        <div class="d-flex gap-2 text-align-center">
            <div>
                <i class="fa-solid fa-hand-holding-dollar fs-2 text-warning"></i>
            </div>
            <div class="p-1">
                <span class="fw-semibold">Loans</span>
            </div>
        </div>
    </div>

</div>

@inject NavigationManager _nav

@code {

    [Parameter] public EventCallback<int>        Ec     { get; set; } 

    string? activeLink = string.Empty; 
    string? alink1 = "", alink2 = "", alink3 = "", alink4 = "", alink5 = "", alink6 = "", alink7 = "", alink8 = "";

    async Task SetActiveLink(int? lnk)
    {
        alink2 = alink3 = alink4 = alink5 = alink6 = alink7 = alink8 = "";
        _ = lnk switch
        {
            2 => alink2 = " mb-btn-active ",
            3 => alink3 = " mb-btn-active ",
            4 => alink4 = " mb-btn-active ",
            5 => alink5 = " mb-btn-active ",
            6 => alink6 = " mb-btn-active ",
            7 => alink7 = " mb-btn-active ",
            8 => alink8 = " mb-btn-active ",
            _ => ""
        };

        if(lnk==1) _nav.NavigateTo("12/103",true); 
        await Ec.InvokeAsync(lnk??0); 
        
}










}
           
