@using OfficeOpenXml.FormulaParsing.Excel.Functions.Math

<!-- ROW 1 -->
<div class="w-100 d-flex gap-3  px-2 py-2">


    <div class="card p-2 w-25 text-center h-60p mb-btn mb-btn-blue @alink1" @onclick="() => SetActiveLink(1)">
