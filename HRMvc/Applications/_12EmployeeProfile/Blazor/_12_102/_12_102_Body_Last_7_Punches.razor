@using Microsoft.AspNetCore.Mvc
<div class="card w-100">
    <div class="card-header">
        Last 7 day Punches 
    </div>

    <div class="card-body">
        <div class="d-flex gap-1 p-2 fw-bold">
            <div class="w-25 text-center bordered-right">Date</div>
            <div class="w-20 text-center bordered-right">Time</div>
            <div class="w-20 text-center bordered-right">Out</div>
            <div class="w-15 text-center bordered-right">Total</div>
            <div class="w-20 text-center ">Tardiness  </div>
        </div>

        @foreach (var punch in V12_102.Attpunches1_7days)
        {
            var timein  = punch?.PunchInDate == null ?  "-" : @punch.PunchInDate.ToString("HH:mm:ss");
            var timeout = punch?.PunchOutDate == null || punch.PunchOutDate <= DateTime.Now.AddYears(-100) ? "-" : @punch.PunchOutDate.ToString("HH:mm:ss");


            <div class="d-flex border-top mb-2 pb-1">
                <div class="w-25 bordered-right text-center"> @punch.PunchInDate.ToString("yyyy-MM-dd") </div>
                <div class="w-20 bordered-right text-center">@timein</div>
                <div class="w-20 bordered-right text-center">@timeout</div>
                <div class="w-15 bordered-right text-center">0</div>
                <div class="w-20 text-center">0  </div>

                
            </div>
        }
    </div>
</div>



@code {

    [Parameter] public V12_102?                 V12_102     { get; set; } = new();

}
