@using Blazorise
@using Microsoft.AspNetCore.Mvc
@using OfficeOpenXml.FormulaParsing.Excel.Functions.DateTime
<div class="card w-100">
    <div class="card-header">
        Last 7 day Punches 
    </div>

    <div class="card-body">
        <div class="d-flex border-top p-1 gap-1 text-primary">
            <div class="w-20 text-center">Date  </div>
            <div class="w-20 text-center ">Time In</div>
            <div class="w-20 text-center ">Time Out</div>
            <div class="w-20 text-center ">Total <br /> Hrs. </div>
            <div class="w-20 text-center text-danger ">Tardiness <br /> ( mins ) </div>
        </div>

        @foreach (var punch in V12_102.Attpunches1_7days)
        {
            var timein  = punch?.PunchInDate == null ?  "-" : @punch.PunchInDate.ToString("HH:mm:ss");
            var timeout = punch?.PunchOutDate == null || punch.PunchOutDate <= DateTime.Now.AddYears(-100) ? "-" : @punch.PunchOutDate.ToString("HH:mm:ss");
            
            @* --- Tardiness IN ----------------------- *@
            double inTemplate      = 0.00;
            DateTime    scheduledInTime = punch.PunchInDate.Date; 
            double      punchIn_Hour    = 0.00;
            double      punchIn_Min     = 0.00; 
            int         tardiness       = 0;

            if (punch?.PunchInDate != null && punch?.PunchT != null)
            {
                inTemplate      = (double)punch.PunchT / 100.00; 
                punchIn_Hour    = Math.Floor(inTemplate);
                punchIn_Min     = (inTemplate - punchIn_Hour) * 100.00;
                scheduledInTime = punch.PunchInDate.Date
                                        .AddHours(punchIn_Hour)
                                        .AddMinutes(punchIn_Min); 

                if (punch.PunchInDate > scheduledInTime && punch?.DutyTypeId == 1)
                {
                    tardiness = (int)(punch.PunchInDate - scheduledInTime).TotalMinutes;
                }
            }

            @* --- Tardiness Out ----------------------- *@
            int outTardiness       = 0;
            if (punch?.DutyTypeId == 1 &&
                punch?.PunchOutDate  != null && 
                punch?.PunchInDate   != null &&
                (punch?.PunchOutDate  > DateTime.Now.AddYears(-2)) && 
               (punch?.PunchT        == null ? 0 : punch.PunchT) > 0 && 
               (punch?.SchedDuration == null ? 0 : punch.SchedDuration) > 0 ) 
            {
                DateTime actualOut      = punch.PunchOutDate;

                DateTime scheduleIn     = punch.PunchInDate.Date
                                          .AddHours(   punch.PunchT / 100 )
                                          .AddMinutes( punch.PunchT % 100 );
                DateTime scheduleOut    = scheduleIn
                                          .AddHours( punch.SchedDuration / 100 )
                                          .AddMinutes( punch.SchedDuration % 100 );

                if (actualOut < scheduleOut)
                {
                    outTardiness = (int)Math.Floor((scheduleOut - actualOut).TotalMinutes);
                    tardiness   += outTardiness;
                }

                
                
            }
            
            @* --- Company Duty Start -------------- *@


            @* --- Total ---------------------------------- *@
            double totHrs = 0.00;
            if(punch?.PunchOutDate != null && punch?.PunchInDate != null && punch.PunchOutDate > punch.PunchInDate){
                totHrs = (punch.PunchOutDate - punch.PunchInDate).TotalHours;
            }

            @* --- Tardiness Out ----------------------- *@

            <div class="d-flex border-top p-1 gap-1">
                <div class="w-25 bordered-right text-center"> 
                    @punch.PunchInDate.ToString("yyyy-MM-dd") 
                    <div class="@(punch?.DutyTypeId==1 ? "text-primary" : "text-danger")">
                        @(punch?.DutyTypeId == 1 ? "Reg" : "RD") - 
                        @punch.PunchInDate.ToString("ddd") 
                        
                    </div>
                </div>
                <div class="w-20 bordered-right text-center">
                    @timein
                </div>
                <div class="w-20 bordered-right text-center">
                    @timeout
                </div>
                <div class="w-20 bordered-right text-center"> 
                    @(totHrs==0 ? "-" : totHrs.ToString("0.00")) 
                </div>
                <div class="w-20 text-center text-danger"> 
                    @(tardiness==0 ? "-" : tardiness.ToString() )
                </div>
            </div>

                
            
        }
    </div>
</div>



@code {

    [Parameter] public V12_102?                 V12_102     { get; set; } = new();

}
