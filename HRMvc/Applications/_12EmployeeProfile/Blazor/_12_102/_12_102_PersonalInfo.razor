@using HRApiLibrary.Models._10_Pis.OPis

@{
    var empmas = Oempmass.FirstOrDefault();
    if (Oempmass.Count < 1) empmas = new OempmasModel(); 
}

<div class="d-flex gap-2">
    <div class="br-6">
        <img src="images/employee1.png"
             alt="Employee Image"
             width="175"
             height="150" />


    </div>
    
    <div class="mt-4 w-250p p-2 ">
        <div class="mt-2 ">
            <h5>@empmas.EmpFirstNm @empmas.EmpMidNm @empmas.EmpLastNm</h5>
            @* <div class="d-flex gap-2 w-100 p-1"> *@
            @*     <span class="w-75p">Emp. No. : </span> *@
            @*     <span class="text-success">@empmas.EmpNumber</span>     *@
            @* </div> *@
            <div class="mt-1 text-success ">@empmas.PositionName</div>
            
        </div>
    </div>
    
    
    
</div>


@code {

    [Parameter] public UserClaimsModel? UserClaims { get; set; }
    [Parameter] public List<OempmasModel?>?     Oempmass   { get; set; } = [];

}