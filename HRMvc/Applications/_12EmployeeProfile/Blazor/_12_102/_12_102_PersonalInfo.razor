@using HRApiLibrary.Models._10_Pis.OPis

@{
    var empmas = OEmpmass.FirstOrDefault();
    if (OEmpmass.Count < 1) empmas = new OEmpmasModel(); 
    
    var tenure = "";

    if (empmas.DateHired.HasValue)
    {
        var start = empmas.DateHired.Value.Date;
        var today = DateTime.Today;

        var years = today.Year - start.Year;
        var months = today.Month - start.Month;
        var days = today.Day - start.Day;

        if (days < 0)
        {
            months--;
            var prevMonth = today.AddMonths(-1);
            days += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }

        tenure = $"{years}y {months}m {days}d";
    }
}

<div class="d-flex gap-1 h-150p">
    <div class="br-6">
        <img src="images/employee1.png"
             alt="Employee Image"
             width="175"
             height="150" />
    </div>
    
    <div class="mt-4 w-250p p-2 ">
        <div class="mt-2 ">
            <h5>@empmas.EmpFirstNm @empmas.EmpMidNm @empmas.EmpLastNm</h5>
            <div class="mt-1 text-secondary ">
                <i class="fa-solid fa-user-tag small txt-fcolor1"></i> @(empmas.EmpNumber ?? "") /
                <i class="fa-solid fa-user-check small txt-fcolor1"></i> @(empmas.EmpStatus ?? "")
            </div>
            <div class="mt-1 text-secondary ">
                <i class="fa-solid fa-briefcase small txt-fcolor1"></i>
                @empmas.PositionName
            </div>

        </div>
    </div>
    
    <div class=" flex-grow-1 d-flex justify-content-center align-items-center">
        
        <div class="w-100 ">
            @* --- 1st Line  ---------------------------------------------*@
            
            <div class="d-flex gap-2  ">
                <div class="w-40 txt-fcolor1">
                    @* --- Date Hired --- *@
                    <div><i class="fa-solid fa-calendar-check "></i>
                        Date Hired
                    </div>
                    <div class="px-2 text-secondary">
                        <span> @(empmas.DateHired?.ToString("MMM dd, yyyy") ?? "")</span>
                    </div>

                </div>


                <div class="w-40 ">
                    @* --- Tenure --- *@
                    <div class="w-40 txt-fcolor1">
                        <i class="fa-solid fa-business-time"></i> Tenure
                    </div>
                    <div class="px-2 text-secondary">
                        @(tenure ?? "")
                    </div>
                </div>
            </div>
            
            @* --- 2nd Line  ---------------------------------------------*@
            <div class="d-flex gap-2 mt-2">
                <div class="w-40">
                    @* --- Gender --- *@
                    <div class="txt-fcolor1">
                        <span ><i class="fa-solid fa-address-card"></i> </span>
                        <span > Gender</span>
                    </div>
                    <div class="px-2 text-secondary">
                        <span> @(empmas.Sex_ switch { "M" => "Male", "F" => "Female", _   => "" })</span>
                    </div>
                    
                    
                </div>

                <div class="w-40">
                    @* --- Email --- *@
                    <div class="txt-fcolor1">
                        <span ><i class="fa-solid fa-envelope"></i> </span>
                        <span >Email</span>
                    </div>
                    <div class="px-2 text-secondary">
                        <span> @(empmas.Email ?? "")</span>
                    </div>
                </div>    
            </div>
        </div>
    </div>
</div>




@code {

    [Parameter] public UserClaimsModel? UserClaims { get; set; }
    [Parameter] public List<OEmpmasModel?>?     OEmpmass   { get; set; } = [];

}