@using Radzen.Blazor
@using Radzen.Documents.Spreadsheet


<RadzenSpreadsheet Workbook="@workbook" Style="height: 600px; width: 100%;" />

@code {

    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    Workbook workbook = new Workbook();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var sheet = workbook.AddSheet("Employees", 10, 5);

            @* sheet.Cells[0]. *@

            sheet.Cells["A1"].Value = "ID";
            sheet.Cells["B1"].Value = "Name";
            sheet.Cells["C1"].Value = "Department";
            sheet.Cells["D1"].Value = "Salary";

            sheet.Cells["A2"].Value = 1;
            sheet.Cells["B2"].Value = "Juan Dela Cruz";
            sheet.Cells["C2"].Value = "HR";
            sheet.Cells["D2"].Value = 25000;

            StateHasChanged();
        }
    }
}
