<div class="row g-3">

    @foreach (var s in stats)
    {
        <div class="col-12 col-sm-6 col-lg-3">

            <div class="card p-3 shadow-sm border-0 h-100">

                <div class="d-flex align-items-center gap-3 flex-wrap flex-sm-nowrap">

                    <!-- Icon -->
                    <div class="d-flex align-items-center justify-content-center bg-@s.Color bg-opacity-10 text-@s.Color rounded-3"
                         style="width:50px; height:50px; flex-shrink:0;">
                        <i class="fas @s.Icon fs-5"></i>
                    </div>

                    <!-- Text -->
                    <div class="min-w-0">
                        <div class="text-muted small text-truncate">
                            @s.Title
                        </div>

                        <div class="fw-bold fs-5">
                            @s.Value
                            <span class="text-muted fs-6">/ @s.Total</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public V12104Model V { get; set; } = new();


    private List<StatCard> stats => new()
    {
        new StatCard
        {
            Title = "Present",
            Value = V.PresentCount,
            Total = V.DaysCount - V.RestDayCount,
            Icon = "fa-calendar-check",
            Color = "success"
        },
        new StatCard
        {
            Title = "Late",
            Value = V.LateCount,
            Total = V.DaysCount - V.RestDayCount,
            Icon = "fa-calendar-times",
            Color = "warning"
        },
        new StatCard
        {
            Title = "Undertime",
            Value = V.UnderTimeCount,
            Total = V.DaysCount - V.RestDayCount,
            Icon = "fa-clock",
            Color = "purple"
        },
        new StatCard
        {
            Title = "Absent Days",
            Value = V.AbsentCount,
            Total =V.DaysCount - V.RestDayCount,
            Icon = "fa-user-xmark",
            Color = "danger"
        }
    };

    public class StatCard
    {
        public string? Title { get; set; }
        public int? Value { get; set; }
        public int? Total { get; set; }
        public string? Icon { get; set; }
        public string? Color { get; set; }
    }
}


<style>
    .bg-purple {
        background-color: rgba(111, 66, 193, 0.1);
    }

    .text-purple {
        color: #6f42c1;
    }
</style>