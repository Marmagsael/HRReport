<div class="day-top">
    <div class="d-flex justify-content-between align-items-center gap-2">

        <div class="fw-bold text-black @(D.IsOtherMonth ? "text-opacity-25" : "text-opacity-50")">
            @D.Date?.Day
        </div>

        @if (!D.IsOtherMonth)
        {
            <i class="@GetDayTypeIcon(D.DutyTypeCode) text-black text-opacity-25"
               style="font-size:.75em"
               title="@D.DutyTypeName">
            </i>
        }

    </div>
</div>

@code {
    [Parameter] public AttDayDetail D { get; set; } = new();

    private string GetDayTypeIcon(string code) => code?.ToUpper() switch
    {
        "R" => "fa-solid fa-person-digging text-primary text-opacity-25",
        "RN" => "fa-solid fa-street-view text-secondary text-opacity-25",
        "RD" => "fa-solid fa-moon text-info text-opacity-25",
        _ => ""
    };
}

<style>
    .day-top {
        position: absolute;
        top: 6px;
        left: 6px;
        right: 6px; 
    }

    .date-pill {
        min-width: 26px;
        height: 22px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>