@if (!D.Status.Contains("RD") && !D.AttendanceType.ToUpperInvariant().Replace(" ", "").Contains("EXEMPT"))
{ 
    <div class="block ">
        <span class="block-title">SCHED</span>
        <span class="exp time">@D.ExpTimeIn?.ToString(@"hh\:mm") </span> -
        <span class="exp time">@D.ExpTimeOut?.ToString(@"hh\:mm")</span>
    </div>
 } 


@code {
    [Parameter] public AttDayDetail D { get; set; } = new();
}

<style>


    .exp.time {
        font-size: 10px;
        color: #1e88e5;
        /* text-shadow: 0 0 6px rgba(30, 136, 229, 0.6); */
    }

</style>
