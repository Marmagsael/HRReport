
@if (D.ActualTimeIn.HasValue || D.ActualTimeIn != null)
{
    <span class="block">
        <span class="block-title">PUNCH</span>
        <span class="actual time">@D.ActualTimeIn?.ToString(@"HH\:mm")</span> -
        <span class="actual time">@D.ActualTimeOut?.ToString(@"HH\:mm")</span>
    </span>
}


@code {
    [Parameter] public AttDayDetail D { get; set; } = new();
}

<style>
    .actual.time {
        font-size: 10px;
        color: #2e7d32;
        text-shadow: 0 0 6px rgba(76, 175, 80, 0.5);
    }
</style>
