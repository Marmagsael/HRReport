

<div class="week-days">
    @foreach (var w in V.Weeks)
    {
        <div>@w</div>
    }
</div>

@code {
    [Parameter] public V12104Model V { get; set; } = new();
}

<style>
    .week-days{
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        text-align: center;
        padding: 10px 0;
        background: #f9fafb;
    }
   
</style>