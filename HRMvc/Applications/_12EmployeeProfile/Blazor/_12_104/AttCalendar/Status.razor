@{
    var statuses = (D.Status ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .Where(s => !string.IsNullOrWhiteSpace(s)
                 && !s.Contains("PRESENT")
                 && !s.Contains("LATE")
                 && !s.Contains("UNDERTIME"))
        .ToList();

}

<div class="d-flex align-items-center justify-content-center h-100 w-100 mt-2">
    <div class="d-flex flex-column  flex-wrap justify-content-center">
        @foreach (var s in statuses)
        {
            <span class="badge rounded-pill text-center px-0  @GetBadgeClass(s) " style="font-size:.72em">
                @GetStatusName(s)
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public V12104Model V { get; set; } = new();
    [Parameter] public AttDayDetail D { get; set; } = new();

    private string GetBadgeClass(string status)
    {
        var s = status.ToUpper();
        if (s.Contains("ABSENT")) return "text-danger text-opacity-75";
        return "text-dark text-opacity-50";
    }

    private string GetStatusName(string status)
    {
        var hideTypes = new[] { "R", "RN" };
        if (hideTypes.Contains(status.Trim().ToUpper())) return "";

        var found = V.AttyDutyTypes.FirstOrDefault(x => x.Code == status.Trim());
        return found?.Name ?? status;
    }
}