

@{
    string rs = D.Status ?? "";

    string status;

    if (rs.Contains("RD"))
    {
        status = "Rest Day";
    }
    else if (rs.Contains("PRESENT") || rs.Contains("LATE") || rs.Contains("UNDERTIME") )
    {
        status = "";
    }
    else
    {
        status = string.Join(", ", rs); 
    }
}


<div class="d-flex align-items-center justify-content-center h-100 w-100">
    <span class="status @(D.Status == "ABSENT" ? "text-danger" : "")">
        @status
    </span>
</div>

@code {
    [Parameter] public AttDayDetail D { get; set; } = new();
}

<style>
    .status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 500;
        text-align: center;
        color: #616161;
    }

</style>
