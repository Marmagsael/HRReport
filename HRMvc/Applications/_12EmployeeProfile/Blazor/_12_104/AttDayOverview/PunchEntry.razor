

<h6 class="fw-bold mb-1">Work Summary</h6>

<div class="small mb-2 d-flex flex-column gap-2">
    <div class="d-flex justify-content-between">
        <span class="text-muted">Time In</span>
        <strong>
             @V.DayDetail.ActualTimeIn?.ToString("dd MMM yyyy • HH:mm:ss") 
        </strong>
    </div>

    <div class="d-flex justify-content-between">
        <span class="text-muted">Time Out</span>
        <strong>
             @V.DayDetail.ActualTimeOut?.ToString("dd MMM yyyy • HH:mm:ss") 
        </strong>
    </div>
</div>

<hr />

@code {
    [Parameter] public V12104Model V { get; set; } = new();
}
