@if (!string.IsNullOrWhiteSpace(V.DayDetail.LeaveType))
{
    <h6 class="fw-bold mb-1">Leave Details</h6>

    <div class="text-muted small mb-3 d-flex flex-column gap-2">
        <div class="d-flex">
            <div style="width:120px">
                Leave Type:
            </div>
            <strong class="text-dark">@V.DayDetail.LeaveType</strong>
            @* <strong class="text-dark">hey @V.DayDetail.LeaveDayType</strong> *@
        </div>
        <div class="d-flex">
            <div style="width:120px">
                Reason:
            </div>
            <strong class="text-dark">@V.DayDetail.Reason</strong>
        </div>
        <div class="d-flex">
            <div style="width:120px">
                Schedule:
            </div>

            <strong class="text-dark">
                @V.DayDetail.LeaveStart?.ToString(@"hh\:mm")
                →
                @V.DayDetail.LeaveEnd?.ToString(@"hh\:mm")
            </strong>
        </div>

        @* <div class="d-flex">
        <div style="width:120px">
            Working Hours :
        </div>
        <strong class="text-dark">@V.DayDetail.ExpWorkingHrs</strong>

    </div> *@
    </div>
    <hr />
}


@code {
    [Parameter] public V12104Model V { get; set; } = new();
}
