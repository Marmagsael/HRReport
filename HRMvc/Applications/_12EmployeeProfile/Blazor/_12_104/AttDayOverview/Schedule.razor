
<div class="text-muted small mb-3 d-flex flex-column gap-2">
    <div class="d-flex">
        <div style="width:120px">
            Attendance Type:
        </div>
        <strong class="text-dark">@V.DayDetail.AttendanceType</strong> 
    </div>
    <div class="d-flex">
        <div style="width:120px">
            Duty Type:
        </div>
         <strong class="text-dark">@V.DayDetail.DutyTypeName</strong> 
    </div>
    <div class="d-flex">
        <div style="width:120px">
            Schedule:
        </div>

        <strong class="text-dark">
             @V.DayDetail.ExpTimeIn.ToString(@"hh\:mm") 
            →
             @V.DayDetail.ExpTimeOut.ToString(@"hh\:mm") 
        </strong>
    </div>

    <div class="d-flex">
        <div style="width:120px">
            Working Hours :
        </div>
         <strong class="text-dark">@V.DayDetail.ExpWorkingHrs</strong> 

    </div>
</div>

<hr />

@code {
    [Parameter] public V12104Model V { get; set; } = new();
}
