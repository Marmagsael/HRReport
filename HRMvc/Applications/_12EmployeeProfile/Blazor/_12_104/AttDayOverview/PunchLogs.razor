</button>

<!-- Punch Details -->
<div class="collapse mt-3" id="punchDetails">

    <div class="small">
        @{
            int ctr = 1;
        }
         @foreach (var l in V.DayDetail.Logs)
        {
            <div class="border rounded p-2 mb-2">
                <div class=" text-muted"><strong>Log @ctr</strong></div>
                <div class="small mt-1 mb-2 d-flex flex-column gap-1">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Time In</span>
                        <strong>
                            @l.PunchInDate?.ToString("dd MMMM yyyy • hh:mm:ss tt")
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Time Out</span>
                        <strong>
                            @l.PunchOutDate?.ToString("dd MMMM yyyy • hh:mm:ss tt")
                        </strong>
                    </div>
                </div>
            </div>
            ctr++;
        } 
    </div>
</div>

@code {
    [Parameter] public V12104Model V { get; set; } = new();
} *@
