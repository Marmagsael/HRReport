@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars

@if (D.TimeIn.HasValue)
{
   
    <span class="block">
        <span class="block-title">PUNCH</span>
        <span class="actual time">@D.TimeIn?.ToString(@"HH\:mm")</span> -
        <span class="actual time">@D.TimeOut?.ToString(@"HH\:mm")</span>
    </span>

}




@code {
    [Parameter] public DailyAttendance D { get; set; } = new();
}

<style>
    .actual.time {
        font-size: 10px;
        color: #2e7d32;
        text-shadow: 0 0 6px rgba(76, 175, 80, 0.5);
       
    }
</style>
