@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars



@if (!D.Status.Contains("rd"))
{
    <div class="block ">
        <span class="block-title">SCHED</span>
        <span class="exp time">@D.ExpectedTimeIn.ToString(@"hh\:mm") </span> -
        <span class="exp time">@D.ExpectedTimeOut.ToString(@"hh\:mm")</span>
    </div> 
}


@code {
    [Parameter] public DailyAttendance D { get; set; } = new();
}

<style>


    .exp.time {
        font-size: 10px;
        color: #1e88e5;
        /* text-shadow: 0 0 6px rgba(30, 136, 229, 0.6); */
    }


</style>
