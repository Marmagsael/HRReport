@using HRMvc.Applications._12EmployeeProfile.Blazor.Vars


@{
    string status = D.Status == "rd" ? "Rest Day" :  D.Status == "absent" ? "Absent" : "";
}


<div class="d-flex align-items-center justify-content-center h-100 w-100">
    <span class="status @D.Status">@status</span>
</div>
@code {
    [Parameter] public DailyAttendance D { get; set; } = new();

}

<style>
    .status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 500;
        text-align: center;
         color: #616161;
    }

   
</style>

