@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption=" Reference" />

    <div class=" p-2">
        <div class="card p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-30 text-left bordered-right ps-3">Name</div>
                <div class="w-30 text-left bordered-right ps-3">Address</div>
                <div class="w-20 text-left bordered-right ps-3">Telephone</div>
                <div class="w-20 text-left ps-3">Occupation</div>
            </div>

            <div class="card-body p-0 ">
                @foreach (var r in V12_103.ORefers)
                {
                    <div class="d-flex  py-2 border-top">
                        <div class="w-30 text-left bordered-right ps-3">@(!string.IsNullOrWhiteSpace(r.Name) ? r.Name : "N/A") </div>
                        <div class="w-30 text-left bordered-right ps-3">@(!string.IsNullOrWhiteSpace(r.Addr) ? r.Addr : "N/A")</div>
                        <div class="w-20 text-left bordered-right ps-3">@(!string.IsNullOrWhiteSpace(r.Tel) ? r.Tel : "N/A")</div>
                        <div class="w-20 text-left ps-3">@(!string.IsNullOrWhiteSpace(r.Position) ? r.Position : "N/A")</div>
                    </div>
                }

            </div>
        </div>


    </div>

</div>
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
