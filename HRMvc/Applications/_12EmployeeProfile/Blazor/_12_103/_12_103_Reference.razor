@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption=" Reference" />

    <div class=" p-2">
        <div class="card p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-30 text-center bordered-right">Name</div>
                <div class="w-30 text-center bordered-right">Address</div>
                <div class="w-20 text-center bordered-right">Telephone</div>
                <div class="w-20 text-center">Occupation</div>
            </div>

            <div class="card-body p-0 ">
                @foreach (var r in V12_103.ORefers)
                {
                    <div class="d-flex  py-2">
                        <div class="w-30 text-center bordered-right">@r.Name</div>
                        <div class="w-30 text-center bordered-right">@r.Addr</div>
                        <div class="w-20 text-center bordered-right">@r.Tel</div>
                        <div class="w-20 text-center ">@r.Position</div>
                    </div>
                }

            </div>
        </div>


    </div>

</div>
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
