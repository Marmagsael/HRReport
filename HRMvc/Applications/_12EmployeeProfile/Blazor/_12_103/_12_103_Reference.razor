@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption="Reference" />
    <div class="p-2">
        <div class="card p-0">
            <div class="d-flex fw-bold py-2 border-bottom">
                <div class="w-30 bordered-right ps-3">Name</div>
                <div class="w-30 bordered-right ps-3">Address</div>
                <div class="w-20 bordered-right ps-3">Telephone</div>
                <div class="w-20 ps-3">Occupation</div>
            </div>
            <div class="card-body p-0">
               

                @if (V12_103.ORefers.Any())
                {
                    @foreach (var r in V12_103?.ORefers )
                    {
                        <div class="d-flex py-2 border-bottom">
                            <div class="w-30 bordered-right ps-3">@r.Name</div>
                            <div class="w-30 bordered-right ps-3">@r.Addr</div>
                            <div class="w-20 bordered-right ps-3">@r.Tel</div>
                            <div class="w-20 ps-3">@r.Position</div>
                        </div>
                    }
                }

                else
                {
                    <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                        No records to display.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}