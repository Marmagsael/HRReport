@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption="Reference" />
    @foreach (var c in V12_103.ORefers)
    {
        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary ">  Name  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.NAME</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Address  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.ADDR</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Telephone  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.TEL</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Occupation  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.POSITION</span>
            </div>
        </div>


       
    }
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
