@using HRApiLibrary.Models._10_Pis.OPis



@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Government" />
        <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3 w-140p border-end "> SSS  </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Sss) ? oempmas.Sss : "N/A")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> TIN  </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Tin) ? oempmas.Tin : "N/A")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> PAG-IBIG No.  </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.PagIbigNo) ? oempmas.PagIbigNo : "N/A")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3 w-140p border-end "> PhilHealth No. </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Phic) ? oempmas.Phic : "N/A")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> Driver's License  </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Drv_License) ? oempmas.Drv_License : "N/A")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> Drv Lic Expiration  </div>
                <div class="p-2  ">
                <span class="px-2">@(oempmas.Drv_Exp?.ToString("MM/dd/yyyy") ?? "N/A")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> HMDF </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.PagIbigNo) ? oempmas.PagIbigNo : "N/A")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> Bank Account No. </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.AcctCode) ? oempmas.AcctCode : "N/A")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-140p border-end "> Bank/Branch </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Bank) ? oempmas.Bank : "N/A")</span>
                </div>
            </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3 w-140p border-end "> Tax Table Code </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.TaxCode) ? oempmas.TaxCode : "N/A")</span>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();
}
