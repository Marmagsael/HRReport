@using HRApiLibrary.Models._10_Pis.OPis
@using global::HRMvc.Applications.Vars




@if (V12_103.OEmpmass.Count() > 0)
{
    var OEmpmas = V12_103.OEmpmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Government" />
        <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3 w-175p border-end "> SSS  </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Sss) ? OEmpmas.Sss : "")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> TIN  </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Tin) ? OEmpmas.Tin : "")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> PAG-IBIG No.  </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.PagIbigNo) ? OEmpmas.PagIbigNo : "")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3 w-175p border-end "> PhilHealth No. </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Phic) ? OEmpmas.Phic : "")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> Driver's License  </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Drv_License) ? OEmpmas.Drv_License : "")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> Drv Lic Expiration  </div>
                <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Drv_Exp?.ToString("MM/dd/yyyy") ?? "")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> HMDF </div>
                <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.PagIbigNo) ? OEmpmas.PagIbigNo : "")</span>
                </div>
            </div>


            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> Bank Account No. </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.AcctCode) ? OEmpmas.AcctCode : "")</span>
                </div>
            </div>

            <div class=" d-flex gap-2 border-bottom ">
                <div class="p-2 ps-3  w-175p border-end "> Bank/Branch </div>
                <div class="p-2  ">
                    <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Bank) ? OEmpmas.Bank : "")</span>
                </div>
            </div>


        <div class=" d-flex gap-2  ">
            <div class="p-2 ps-3 w-175p border-end "> Tax Table Code </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.TaxCode) ? OEmpmas.TaxCode : "")</span>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}

