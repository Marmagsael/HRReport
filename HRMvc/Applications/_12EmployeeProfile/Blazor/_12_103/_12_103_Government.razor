@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Government" />
        <LabelValueRow Label="SSS"                  Value="@e.Sss" />
        <LabelValueRow Label="TIN"                  Value="@e.Tin" />
        <LabelValueRow Label="PAG-IBIG No."         Value="@e.PagIbigNo" />
        <LabelValueRow Label="PhilHealth No."       Value="@e.Phic" />
        <LabelValueRow Label="Driver's License"     Value="@e.Drv_License" />
        <LabelValueRow Label="Drv Lic Expiration"   Value="@e.Drv_Exp?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="HMDF"                 Value="@e.Hdmf" />
        <LabelValueRow Label="Bank Account No."     Value="@e.AcctCode" />
        <LabelValueRow Label="Bank/Branch"          Value="@e.Bank" />
        <LabelValueRow Label="Tax Table Code"       Value="@e.TaxCode" IsLast />
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}