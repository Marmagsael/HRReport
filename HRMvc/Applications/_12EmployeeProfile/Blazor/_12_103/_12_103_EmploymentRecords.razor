<div class="card w-100">
    <_12_102_Cardhdr caption="Employment Records" />

    <div class="p-2">
        <div class="card p-0">
            <div class="overflow-auto">

                <div class="d-flex fw-bold py-2 table-row flex-nowrap">
                    <div class="col-company ps-3 bordered-right">Company</div>
                    <div class="col-address ps-3 bordered-right">Address 1</div>
                    <div class="col-address ps-3 bordered-right">Address 2</div>
                    <div class="col-telephone ps-3 bordered-right">Telephone</div>
                    <div class="col-position ps-3 bordered-right">Position</div>
                    <div class="col-year text-center bordered-right">Year</div>
                    <div class="col-salary ps-3 bordered-right">Salary</div>
                    <div class="col-remarks ps-3 bordered-right">Remarks 1</div>
                    <div class="col-remarks ps-3">Remarks 2</div>
                </div>

                <div class="card-body p-0">
                    @foreach (var e in V12_103.OEmploys)
                    {
                        <div class="d-flex py-2 border-top table-row flex-nowrap">
                            <div class="col-company ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Comp) ? e.Comp :"")</div>
                            <div class="col-address ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Addr1) ? e.Addr1 :"")</div>
                            <div class="col-address ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Addr2) ? e.Addr2 :"")</div>
                            <div class="col-telephone ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Tel) ? e.Tel :"")</div>
                            <div class="col-position ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Posi) ? e.Posi :"")</div>
                            <div class="col-year text-center bordered-right">@($"{e.From_} - {e.To_}")</div>
                            <div class="col-salary ps-3 bordered-right">@e.Sal</div>
                            <div class="col-remarks ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Rem1) ? e.Rem1 :"")</div>
                            <div class="col-remarks ps-3">@(!string.IsNullOrWhiteSpace(e.Rem2) ? e.Rem2 :"")</div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

  
}


<style>
    .table-row {
        min-width: 2000px; 
    }

    .col-company {
        min-width: 260px;
    }

    .col-address {
        min-width: 260px;
    }

    .col-telephone {
        min-width: 180px;
    }

    .col-position {
        min-width: 220px;
    }

    .col-year {
        min-width: 160px;
    }

    .col-salary {
        min-width: 140px;
    }

    .col-remarks {
        min-width: 260px;
    }

    .bordered-right {
        border-right: 1px solid #dee2e6;
    }

</style>