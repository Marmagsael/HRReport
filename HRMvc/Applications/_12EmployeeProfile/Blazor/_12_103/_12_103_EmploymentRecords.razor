@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption="Employment Records" />
    @foreach (var c in V12_103.OEmploys)
    {
        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Company Name  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.COMP</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Position  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.POSI</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Salary  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.SAL</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Address 1  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.ADDR1</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Address 2  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.ADDR2</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Telephone  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.TEL</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Remarks 1 </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.REM1</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Remarks 2 </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.REM2</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
