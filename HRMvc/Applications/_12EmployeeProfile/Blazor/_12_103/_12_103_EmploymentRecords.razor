@using HRApiLibrary.Models._10_Pis.OPis

<div class="card w-100">
    <_12_102_Cardhdr caption=" Employment Records" />

    <div class="card p-2 ">
        <div class="card-body overflow-auto border p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-30 text-center bordered-right">Company</div>
                <div class="w-20 text-center bordered-right">Address 1</div>
                <div class="w-10 text-center bordered-right">Telephone</div>
                <div class="w-20 text-center bordered-right">Position</div>
                <div class="w-20 text-center bordered-right">Year</div>
                <div class="w-10 text-center bordered-right">Salary</div>
                <div class="w-20 text-center bordered-right">Remarks</div>
            </div>

            <div class="card-body p-0 ">
                @foreach (var e in V12_103.OEmploys)
                {
                    <div class="d-flex  py-2">
                        <div class="w-30 text-center bordered-right">@e.COMP</div>
                        <div class="w-20 text-center bordered-right">@e.ADDR1</div>
                        <div class="w-10 text-center bordered-right">@e.TEL</div>
                        <div class="w-20 text-center bordered-right">@e.POSI</div>
                        <div class="w-20 text-center bordered-right">@e.FROM_ - @e.TO_</div>
                        <div class="w-10 text-center bordered-right">@e.SAL</div>
                        <div class="w-20 text-center bordered-right">
                            @e.REM1
                       </div>
                    </div>
                }

            </div>
        </div>


    </div>

</div>
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
