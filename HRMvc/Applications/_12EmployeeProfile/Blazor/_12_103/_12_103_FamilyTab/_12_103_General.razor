@using HRApiLibrary.Models._10_Pis.OPis

<div class="p-2 pt-0">

    <div class="card overflow-auto mb-3">
        <div class="card-header">Parent Information</div>
        <div class="card-body p-0">
            <div class="d-flex fw-bold border-bottom bg-light py-2">
                <div class="w-20 bordered-right ps-3">Relation</div>
                <div class="w-20 bordered-right ps-3">Name</div>
                <div class="w-10 text-center bordered-right">Age</div>
                <div class="w-30 bordered-right ps-3">Occupation</div>
                <div class="w-40 ps-3">Address</div>
            </div>
          

            @if (V12_103.OParents.Any())
            {
                @foreach (var p in V12_103?.OParents)
                {
                    <div class="d-flex border-bottom py-2">
                        <div class="w-20 bordered-right ps-3">@(p.Code == "M" ? "Mother" : "Father")</div>
                        <div class="w-20 bordered-right ps-3">@p.Name</div>
                        <div class="w-10 text-center bordered-right">@p.Age</div>
                        <div class="w-30 bordered-right ps-3">@p.Occ</div>
                        <div class="w-40 ps-3">@p.Addr</div>
                    </div>
                }
            }

            else
            {
                <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                    No records to display.
                </div>
            }
        </div>
    </div>

    <div class="card overflow-auto">
        <div class="card-header">Children Information</div>
        <div class="card-body p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-30 bordered-right ps-3">Name</div>
                <div class="w-20 ps-3">Birth</div>
            </div>
          

            @if (V12_103.OChildrens.Any())
            {
                @foreach (var c in V12_103?.OChildrens)
                {
                    <div class="d-flex py-2 border-top">
                        <div class="w-30 bordered-right ps-3">@c.Name</div>
                        <div class="w-20 ps-3">@c.BDay.ToString("MMMM dd, yyyy")</div>
                    </div>
                }
            }

            else
            {
                <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                    No records to display.
                </div>
            }
        </div>
    </div>

</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}