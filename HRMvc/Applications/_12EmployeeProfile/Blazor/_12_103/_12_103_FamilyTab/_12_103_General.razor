@using HRApiLibrary.Models._10_Pis.OPis


    <div class="p-2 pt-0">
        <!-- PARENT INFORMATION -->
        <div class=" card overflow-auto mb-3">
            <div class="card-header">Parent Information</div>

            <div class="card-body  p-0">
                <div class="d-flex fw-bold py-2">
                    <div class="w-20 text-left bordered-right ps-3">Relation</div>
                    <div class="w-20 text-left bordered-right ps-3">Name</div>
                    <div class="w-10 text-center bordered-right">Age</div>
                    <div class="w-30 text-left bordered-right ps-3">Occupation</div>
                    <div class="w-40 text-left ps-3">Address</div>
                </div>

                @foreach (var p in V12_103?.OParents)
                {
                    <div class="d-flex py-2 border-top">
                        <div class="w-20 text-left bordered-right ps-3">
                            @(p.Code == "M" ? "Mother" : "Father")
                        </div>
                        <div class="w-20 text-left bordered-right ps-3">
                            @(string.IsNullOrWhiteSpace(p.Name) ? "N/A" : p.Name)
                        </div>
                        <div class="w-10 text-center bordered-right"> @p.Age</div>
                        <div class="w-30 text-left bordered-right ps-3"> @(string.IsNullOrWhiteSpace(p.Occ) ? "N/A" : p.Occ)</div>
                        <div class="w-40 text-left ps-3">@(string.IsNullOrWhiteSpace(p.Addr) ? "N/A" : p.Addr)</div>
                    </div>
                }
            </div>
        </div>

        <!-- CHILDREN INFORMATION -->
        <div class=" card overflow-auto">
            <div class="card-header pt-2">Children Information</div>

            <div class="card-body p-0">
                <div class="d-flex fw-bold py-2">
                    <div class="w-30 text-left bordered-right ps-3">Name</div>
                    <div class="w-20 text-center  ">Birth</div>
                </div>

                @foreach (var c in V12_103?.OChildrens)
                {
                    <div class="d-flex py-2 border-top">
                    <div class="w-30 text-left bordered-right ps-3">@(string.IsNullOrWhiteSpace(c.Name) ? "N/A" : c.Name)</div>
                        <div class="w-20 text-center ">
                        @(c.BDay.ToString("MM/dd/yyyy") ?? "N/A")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
