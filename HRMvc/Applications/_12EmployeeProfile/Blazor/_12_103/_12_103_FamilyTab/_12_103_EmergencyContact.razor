@using HRApiLibrary.Models._10_Pis.OPis

<div class="p-2 pt-0">


    <div class="card overflow-auto">
        <div class="card-header">Contact Person</div>
        <div class="card-body p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-30 bordered-right ps-3">Name</div>
                <div class="w-20 bordered-right ps-3">Address</div>
                <div class="w-20 bordered-right ps-3">Telephone No.</div>
                <div class="w-20 ps-3">Relationship</div>
            </div>


            @if (V12_103.OEmergencs.Any())
            {
                @foreach (var c in V12_103?.OEmergencs)
                {
                    <div class="d-flex py-2 border-top">
                        <div class="w-30 bordered-right ps-3">@c.Name</div>
                        <div class="w-20 bordered-right ps-3">@c.Addr</div>
                        <div class="w-20 bordered-right ps-3">@c.Tel</div>
                        <div class="w-20 ps-3">@c.Rela</div>
                    </div>
                }
            }

            else
            {
                <div class="d-flex align-items-center justify-content-center py-2 text-muted">
                    No records to display.
                </div>
            }
        </div>
    </div>

</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}