@using HRApiLibrary.Models._10_Pis.OPis

@{
    var oemergency = V12_103.OEmergencs.FirstOrDefault();
    if (V12_103.OEmergencs.Count() < 1) oemergency = new OEmergencModel();
}
    <div class="p-2">
        <div class=" card overflow-auto mb-3">
            <div class="card-header">Emergency Contact</div>

            <div class="card-body  p-0">
                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2 ps-3  w-175p border-end "> Contact Person  </div>
                    <div class="p-2  ">
                        <span class="px-2"> @(oemergency.NAME ?? "N/A")</span>
                    </div>
                </div>

                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2 ps-3  w-175p border-end "> Address  </div>
                    <div class="p-2  ">
                        <span class="px-2"> @(oemergency.ADDR ?? "N/A")</span>
                    </div>
                </div>

                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2 ps-3  w-175p border-end "> Telephone  </div>
                    <div class="p-2  ">
                        <span class="px-2"> @(oemergency.TEL ?? "N/A")</span>
                    </div>
                </div>

                <div class=" d-flex gap-2 ">
                    <div class="p-2 ps-3  w-175p border-end "> Relationship  </div>
                    <div class="p-2  ">
                        <span class="px-2"> @(oemergency.RELA ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
      </div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
