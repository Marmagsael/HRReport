@using HRApiLibrary.Models._10_Pis.OPis


<div class="p-2 pt-0">
    <div class=" card overflow-auto">
        <div class="card-header">Other Family Members</div>

        <div class="card-body  p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-20 text-left bordered-right ps-3">Relation</div>
                <div class="w-60 text-left bordered-right ps-3">Name</div>
                <div class="w-20 text-center ">Birth</div>
            </div>

            @foreach (var p in V12_103?.OFamilys)
            {
                <div class="d-flex py-2 border-top">
                    <div class="w-20 text-left bordered-right ps-3">
                        @(string.IsNullOrWhiteSpace(p.Relation) ? "N/A" : p.Relation)
                    </div>
                    <div class="w-60 text-left bordered-right ps-3">
                        @(string.IsNullOrWhiteSpace(p.Name) ? "N/A" : p.Name)
                    </div>
                    <div class="w-20 text-center "> @(p.Birth?.ToString("MM/dd/yyyy") ?? "N/A")</div>
                </div>
            }
        </div>
    </div>

  
</div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
