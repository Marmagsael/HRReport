<div class="w-100  p-2 pb-0">

    <div class="mb-tabs1 d-flex flex-wrap">
        
        <div @onclick="@(()=>TabClick(1))" class=" mb-tab mb-a-gray @(tab==1?" active " : "")">
            <div class=" text-center">
                <div class="pt-1"> <span class="fw-semibold ">General</span> </div>
            </div>
        </div>

        <div @onclick="@(() => TabClick(2))" class="mb-tab mb-a-gray @(tab == 2 ? " active " : "")">
            <div class=" text-center">
                <div class="pt-1"> <span class="fw-semibold ">Emergency Contact</span> </div>
            </div>
        </div>

        <div @onclick="@(() => TabClick(3))" class="mb-tab mb-a-gray @(tab == 3 ? " active " : "")">
            <div class=" text-center">
                <div class="pt-1"> <span class="fw-semibold ">Other Information</span> </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<int> TabChanged { get; set; }

    int tab = 1;

    async Task TabClick(int tno)
    {
        tab = tno;
        await TabChanged.InvokeAsync(tno);
    }
}
