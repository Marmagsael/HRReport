@inject NavigationManager _nav

@code {

    [Parameter] public EventCallback<int>        Ec     { get; set; } 

    string activeLink = string.Empty; 
    string alink1 = "", alink2 = "", alink3 = "", alink4 = "", alink5 = "", alink6 = "", alink7 = "", alink8 = "", alink9 = "", alink10 = "", alink11 = "", alink12 = "";

    async Task SetActiveLink(int lnk)
    {
        alink2 = alink3 = alink4 = alink5 = alink6 = alink7 = alink8 = alink9 = alink10 = alink11 = alink12 = "";
        _ = lnk switch
        {
            2 => alink2 = " mb-btn-active ",
            3 => alink3 = " mb-btn-active ",
            4 => alink4 = " mb-btn-active ",
            5 => alink5 = " mb-btn-active ",
            6 => alink6 = " mb-btn-active ",
            7 => alink7 = " mb-btn-active ",
            8 => alink8 = " mb-btn-active ",
            9 => alink9 = " mb-btn-active ",
            10 => alink10 = " mb-btn-active ",
            11 => alink11 = " mb-btn-active ",
            12 => alink12 = " mb-btn-active ",
            _ => ""
        };

        await Ec.InvokeAsync(lnk); 
}










}
           
