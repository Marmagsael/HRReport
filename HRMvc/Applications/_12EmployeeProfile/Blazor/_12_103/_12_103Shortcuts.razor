
<div class="w-100 border-bottom p-2">

    <div class="mb-tabs1 d-flex flex-wrap">
        
        <div @onclick="@(()=>TabClick(1))" class="mb-1 mb-tab mb-a-blue @(tab==1?" active " : "")">
            <div class=" text-center">
                <div class=""> <i class="fa-solid fa-user-circle fs-4 text-success"></i> </div>
                <div class="pt-1"> <span class="fw-semibold ">Personal Information</span> </div>
            </div>
        </div>

        <div @onclick="@(()=>TabClick(2))" class="mb-1 mb-tab mb-a-blue @(tab==2?" active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid fa-house fs-4 txt-maroon"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Address</span> </div>
            </div>
        </div>
        
        <div @onclick="@(() => TabClick(3))" class="mb-1 mb-tab mb-a-blue @(tab == 3 ? " active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid fa-people-roof fs-4 text-primary"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Family</span> </div>
            </div>
        </div>
        <div @onclick="@(() => TabClick(4))" class="mb-1 mb-tab mb-a-blue @(tab == 4 ? " active " : "")">
            <div class=" text-center w-175p ">
                <div> <i class="fa-solid fa-graduation-cap fs-4 txt-maroon"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Educational Background</span> </div>
            </div>
        </div>


        <div @onclick="@(() => TabClick(5))" class="mb-1 mb-tab mb-a-blue @(tab == 5 ? " active " : "")">
            <div class=" text-center w-175p ">
                <div class=""> <i class="fa-solid fa-clipboard-user fs-4 text-primary"></i> </div>
                <div class="pt-1"> <span class="fw-semibold pt-1">Employment Record</span> </div>
            </div>

        </div>
        <div @onclick="@(() => TabClick(6))" class="mb-1 mb-tab mb-a-blue @(tab == 6 ? " active " : "")">
            <div class=" text-center w-175p ">
                <div> <i class="fa-solid  fa-file-lines fs-4 text-success"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Employment Details</span> </div>
            </div>
        </div>
        <div @onclick="@(() => TabClick(7))" class="mb-1 mb-tab mb-a-blue @(tab == 7 ? " active " : "")">
            <div class=" text-center w-175p ">
                <div> <i class="fa-solid  fa-person-chalkboard fs-4 text-primary"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Training/Seminars</span> </div>
            </div>
        </div>

        <div @onclick="@(() => TabClick(8))" class="mb-1 mb-tab mb-a-blue @(tab == 8 ? " active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid  fa-building-columns fs-4 text-danger"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Government</span> </div>
            </div>
        </div>
        <div @onclick="@(() => TabClick(9))" class="mb-1 mb-tab mb-a-blue @(tab == 9 ? " active " : "")">
            <div class=" text-center w-175p ">
                <div class=""> <i class="fa-solid  fa-user-shield fs-4 text-success"></i> </div>
                <div class="pt-1"> <span class="fw-semibold pt-1">Insurance</span> </div>
            </div>

        </div>
        <div @onclick="@(() => TabClick(10))" class="mb-1 mb-tab mb-a-blue @(tab == 10 ? " active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid  fa-users-between-lines fs-4 text-primary"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Reference</span> </div>
            </div>
        </div>
        <div @onclick="@(() => TabClick(11))" class="mb-1 mb-tab mb-a-blue @(tab == 11 ? " active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid  fa-clipboard-check fs-4 txt-maroon"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Clearance</span> </div>
            </div>
        </div>

        <div @onclick="@(() => TabClick(12))" class="mb-1 mb-tab mb-a-blue @(tab == 12 ? " active " : "")">
            <div class=" text-center w-125p ">
                <div> <i class="fa-solid  fa-image  fs-4 text-primary"></i> </div>
                <div class="pt-1"> <span class="fw-semibold">Image</span> </div>
            </div>
        </div>

    </div>
</div>


@inject NavigationManager _nav

@code {

    [Parameter] public EventCallback<int>        Ec     { get; set; } 

    int tab = 1; 

   async Task TabClick(int tno){
        tab= tno; 
        await Ec.InvokeAsync(tno);
    }
}

           
