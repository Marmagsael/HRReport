@using HRApiLibrary.Models._10_Pis.OPis


@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Address" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Present Address : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.Addr1</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> City/Municiplaity : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.MLACODE_</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Gender : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.Tel1</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Provincial Address : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.Addr2</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> City/Municiplaity : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.PROCODE_</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Gender : </div>
            <div class="p-2  text-success">
                <span class="px-2">@oempmas.Tel2</span>
            </div>
        </div>
      

    </div>
}

@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();

}
