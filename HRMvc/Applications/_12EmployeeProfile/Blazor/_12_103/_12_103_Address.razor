@using HRApiLibrary.Models._10_Pis.OPis

<h2 class="form-section-caption mt-0">Address</h2>

<div class="p-3">
    <RadzenTemplateForm TItem="OempmasModel" Data="@Oempmas">

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack>
                    <RadzenFieldset Text="Present">
                        <RadzenStack Gap="1rem">
                            @*--- Addr1 ---*@
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Address1" Component="Address1" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Oempmas.Address1" Style="width: 100%;" Name="Address1" />
                                </RadzenColumn>
                            </RadzenRow>


                            @*--- Tel 1 ---*@
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Tel1" Component="Tel1" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Oempmas.Tel1" Style="width: 100%;" Name="Tel1" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack>
                        <RadzenFieldset Text="Present">
                            <RadzenStack Gap="1rem">
                                @*--- Addr2 ---*@
                                <RadzenRow AlignItems="AlignItems.Center">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="Address2" Component="Address2" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenTextBox @bind-Value="Oempmas.Address2" Style="width: 100%;" Name="Address2" />
                                    </RadzenColumn>
                                </RadzenRow>


                                @*--- Tel 2 ---*@
                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="Tel2" Component="Tel2" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenTextBox @bind-Value="Oempmas.Tel2" Style="width: 100%;" Name="Tel2" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenStack>
                </RadzenColumn>

        </RadzenRow>

    </RadzenTemplateForm>

</div>



@code {
    [Parameter] public OempmasModel Oempmas { get; set; }
}
