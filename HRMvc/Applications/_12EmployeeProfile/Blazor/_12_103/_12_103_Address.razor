@using HRApiLibrary.Models._10_Pis.OPis

<h2 class="form-section-caption mt-0">Address</h2>

<div class="p-3">
   
    <RadzenTemplateForm TItem="OempmasModel" Data="@Oempmas" >
        <RadzenFieldset Text="Present Address">
            <RadzenRow Gap="1rem" AlignItems="AlignItems.Center" class="ps-5">
                <!-- Address 1 -->
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Address 1" Component="Addr1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox @bind-Value="Oempmas.Addr1" Name="Addr1" Style="width:100%;" />
                </RadzenColumn>

                <!-- Tel 1 -->
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Tel 1" Component="Tel1" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox @bind-Value="Oempmas.Tel1" Name="Tel1" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <RadzenFieldset Text="Permanent Address">
            <RadzenRow Gap="1rem" AlignItems="AlignItems.Center" class="ps-5">
                <!-- Address 2 -->
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Addr2" Component="Addr2" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox @bind-Value="Oempmas.Addr2" Name="Addr2" Style="width:100%;" />
                </RadzenColumn>

                <!-- Tel 2 -->
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Tel 2" Component="Tel2" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox @bind-Value="Oempmas.Tel2" Name="Tel2" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

    </RadzenTemplateForm>
</div>



@code {
    [Parameter] public OempmasModel Oempmas { get; set; }
}
