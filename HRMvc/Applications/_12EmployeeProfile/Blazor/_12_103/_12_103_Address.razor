@using HRApiLibrary.Models._10_Pis.OPis


@if (OEmpmass.Count() > 0)
{
    var OEmpmas = OEmpmass.FirstOrDefault();

    <div class="card w-100 ">
        <_12_102_Cardhdr caption="Address" />

       <div class=" p-2">

           <div class="card mb-2">
                <div class="card-header">Present</div>
                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2  ps-3 w-175p border-end ">  Address </div>
                    <div class="p-2  ">
                        <span class="px-2 "> @(!string.IsNullOrWhiteSpace(OEmpmas.Addr1) ? OEmpmas.Addr1 : "")</span>
                    </div>
                </div>

                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2  ps-3 w-175p border-end"> City/Municiplaity  </div>
                    <div class="p-2  ">
                        <span class="px-2">
                            @(V12_103.OMlaCode == null ? "" : V12_103.OMlaCode.Where(g => g.Code == OEmpmas.MlaCode_) .FirstOrDefault()?.Name )
                        </span>
                    </div>
                </div>

                <div class=" d-flex gap-2  ">
                    <div class="p-2  ps-3 w-175p border-end"> Telephone No.  </div>
                    <div class="p-2  ">
                        <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Tel1) ? OEmpmas.Tel1 : "")</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Provincial</div>
                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2  ps-3 w-175p border-end">  Address</div>
                    <div class="p-2  ">
                        <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Addr2) ? OEmpmas.Addr2 : "")</span>
                    </div>
                </div>

                <div class=" d-flex gap-2 border-bottom ">
                    <div class="p-2  ps-3 w-175p border-end"> City/Municiplaity </div>
                    <div class="p-2  ">
                        <span class="px-2">
                            @(V12_103.OProcode == null ? "" : V12_103.OProcode.Where(g => g.Code == OEmpmas.ProCode_) .FirstOrDefault()?.Name )
                        </span>
                    </div>
                </div>

                <div class=" d-flex gap-2  ">
                    <div class="p-2  ps-3 w-175p border-end"> Telephone No. </div>
                    <div class="p-2  ">
                        <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Tel2) ? OEmpmas.Tel2 : "")</span>
                    </div>
                </div>
            </div>

           </div>
          
        </div>
}

@code {
    [Parameter] public List<OEmpmasModel?>? OEmpmass    { get; set; } = new();
    [Parameter] public V12_103?             V12_103     { get; set; } = new();

}
