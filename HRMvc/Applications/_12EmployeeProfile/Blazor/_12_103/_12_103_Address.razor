@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Address" />
        <div class="p-2">

            <div class="card mb-2">
                <div class="card-header">Present</div>
                <LabelValueRow Label="Address"              Value="@e.Addr1" />
                <LabelValueRow Label="City/Municipality"    Value="@(V12_103.OMlaCode?.FirstOrDefault(g => g.Code == e.MlaCode_)?.Name)" />
                <LabelValueRow Label="Telephone No."        Value="@e.Tel1" IsLast />
            </div>

            <div class="card">
                <div class="card-header">Provincial</div>
                <LabelValueRow Label="Address"              Value="@e.Addr2" />
                <LabelValueRow Label="City/Municipality"    Value="@(V12_103.OProcode?.FirstOrDefault(g => g.Code.Trim() == e.ProCode_?.Trim())?.Name)" />
                <LabelValueRow Label="Telephone No."        Value="@e.Tel2" IsLast />
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}