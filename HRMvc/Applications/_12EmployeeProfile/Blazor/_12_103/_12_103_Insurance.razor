@using HRApiLibrary.Models._10_Pis.OPis


@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Insurance" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2  w-140p border-end "> Insurance  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.Insurance</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2  w-140p border-end "> Policy Number </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.PolicyNumber</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2  w-140p border-end "> Face Value  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.FaceValue</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2  w-140p border-end "> Premium  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.Premium</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2  w-140p border-end "> Expiry Date  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.InsuranceExpiry</span>
            </div>
        </div>

       
    </div>
}

@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();
}
