@using HRApiLibrary.Models._10_Pis.OPis
@using global::HRMvc.Applications.Vars




@if (V12_103.OEmpmass.Count() > 0)
{
    var OEmpmas = V12_103.OEmpmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Insurance" />
        <div class="d-flex gap-2 border-bottom">
            <div class="p-2 ps-3 w-175p border-end">Insurance</div>
            <div class="p-2">
                <span class="px-2">@(OEmpmas.Insurance ?? "")</span>
            </div>
        </div>
        <div class="d-flex gap-2 border-bottom">
            <div class="p-2 ps-3 w-175p border-end">Policy No.</div>
            <div class="p-2">
                <span class="px-2">@(OEmpmas.PolicyNo ?? "")</span>
            </div>
        </div>
        <div class="d-flex gap-2 border-bottom">
            <div class="p-2 ps-3 w-175p border-end">Face Value</div>
            <div class="p-2">
                <span class="px-2">@(OEmpmas.FaceValue?.ToString("N2") ?? "0.00")</span>
            </div>
        </div>
        <div class="d-flex gap-2 border-bottom">
            <div class="p-2 ps-3 w-175p border-end">Premium</div>
            <div class="p-2">
                <span class="px-2">@(OEmpmas.Premium?.ToString("N2") ?? "0.00")</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <div class="p-2 ps-3 w-175p border-end">Expiration</div>
            <div class="p-2">
                <span class="px-2">@(OEmpmas.InsExpire?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


    </div>
}
@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}
