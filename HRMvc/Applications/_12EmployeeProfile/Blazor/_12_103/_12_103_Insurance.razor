@using HRApiLibrary.Models._10_Pis.OPis


@if (OEmpmass.Count() > 0)
{
    var OEmpmas = OEmpmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Insurance" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3   w-140p border-end "> Insurance  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Insurance) ? OEmpmas.Insurance : "") </span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3   w-140p border-end "> Policy Number </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.PolicyNo) ? OEmpmas.PolicyNo : "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3   w-140p border-end "> Face Value  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.FaceValue) ? OEmpmas.FaceValue : "")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3   w-140p border-end "> Premium  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(OEmpmas.Premium) ? OEmpmas.Premium : "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 ">
            <div class="p-2 ps-3   w-140p border-end "> Expiry Date  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.InsExpire?.ToString("MM/dd/yyyy") ?? "")  </span>
            </div>
        </div>

       
    </div>
}

@code {
    [Parameter] public List<OEmpmasModel?>? OEmpmass { get; set; } = new();
}
