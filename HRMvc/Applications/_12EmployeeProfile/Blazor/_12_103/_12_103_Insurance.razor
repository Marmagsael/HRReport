@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Insurance" />
        <LabelValueRow Label="Insurance"    Value="@e.Insurance" />
        <LabelValueRow Label="Policy No."   Value="@e.PolicyNo" />
        <LabelValueRow Label="Face Value"   Value="@(e.FaceValue?.ToString("N2") ?? "0.00")" />
        <LabelValueRow Label="Premium"      Value="@(e.Premium?.ToString("N2") ?? "0.00")" />
        <LabelValueRow Label="Expiration"   Value="@e.InsExpire?.ToString("MM/dd/yyyy")" IsLast />
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}