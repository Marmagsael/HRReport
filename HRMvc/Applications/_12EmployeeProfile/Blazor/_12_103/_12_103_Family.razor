@using HRApiLibrary.Models._10_Pis.OPis


    <div class="card w-100">
        <_12_102_Cardhdr caption="Family" />

        <div class="card p-2 overflow-auto">
            <div class="card-header text-primary"> Parent Information </div>
            <div class="card-body border p-0">
                <div class="d-flex fw-bold py-2">
                    <div class="w-20 text-center bordered-right">Relation</div>
                    <div class="w-20 text-center bordered-right">Name</div>
                    <div class="w-20 text-center bordered-right">Age</div>
                    <div class="w-30 text-center bordered-right">Occupation</div>
                    <div class="w-40 text-center ">Address</div>
                </div>

                <div class="card-body p-0 ">
                    @foreach (var p in V12_103.OParents)
                    {
                        <div class="d-flex  py-2">
                            <div class="w-20 text-center bordered-right">@(p.CODE == "M" ? "Mother" : "Father")</div>
                            <div class="w-20 text-center bordered-right">
                                @(string.IsNullOrWhiteSpace(p.NAME) ? "-" : p.NAME)
                            </div>
                            <div class="w-20 text-center bordered-right">@p.AGE</div>
                            <div class="w-30 text-center bordered-right">@p.OCC</div>
                            <div class="w-40 text-center ">@p.ADDR</div>
                        </div>
                    }

                </div>
            </div>

            <div class="card-header text-primary pt-2"> Children Information </div>
            <div class="card-body border p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-20 text-center bordered-right">Name</div>
                <div class="w-20 text-center bordered-right">Birth</div>
            </div>

            <div class="card-body p-0 ">
                @foreach (var c in V12_103.OChildrens)
                {
                    <div class="d-flex  py-2">
                        <div class="w-20 text-center bordered-right">@c.name</div>
                        <div class="w-20 text-center bordered-right">@c.bday.ToString("MM-dd-yyyy")</div>
                    </div>
                }

            </div>
        </div>

        </div>
      
    </div>




@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

}
