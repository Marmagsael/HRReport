@using HRApiLibrary.Models._10_Pis.OPis


@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Employment Details" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Prof. License  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.SecLicense) ? oempmas.SecLicense :"")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Badge Number  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.BadgeNo) ? oempmas.BadgeNo :"")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> License Expiration  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.Licexpire?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Position  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.PositionName) ? oempmas.PositionName :"")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Years of Practice  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.GuardNoYrs) ? oempmas.GuardNoYrs :"")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Employee Status  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.EmpStatus) ? oempmas.EmpStatus :"")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Date Hired  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.DateHired?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Date of Regularization </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.RegRef?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Date of Separated </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.Separate?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-175p border-end "> Gov. Service (yrs)  </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.MilitaryNoYr) ? oempmas.MilitaryNoYr :"")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 ">
            <div class="p-2 ps-3  w-175p border-end "> Remarks </div>
            <div class="p-2  ">
                <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Remarks) ? oempmas.Remarks :"")</span>
            </div>
        </div>

    </div>
}

@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();
}
