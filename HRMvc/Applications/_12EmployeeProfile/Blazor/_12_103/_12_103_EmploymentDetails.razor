@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Employment Details" />
        <LabelValueRow Label="Prof. License"            Value="@e.SecLicense" />
        <LabelValueRow Label="Badge Number"             Value="@e.BadgeNo" />
        <LabelValueRow Label="License Expiration"       Value="@e.Licexpire?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Position"                 Value="@e.PositionName" />
        <LabelValueRow Label="Years of Practice"        Value="@e.GuardNoYrs" />
        <LabelValueRow Label="Employee Status"          Value="@e.EmpStatus" />
        <LabelValueRow Label="Date Hired"               Value="@e.DateHired?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Date of Regularization"   Value="@e.RegRef?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Date of Separated"        Value="@e.Separate?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Gov. Service (yrs)"       Value="@e.MilitaryNoYr" />
        <LabelValueRow Label="Remarks"                  Value="@e.Remarks" IsLast />
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}