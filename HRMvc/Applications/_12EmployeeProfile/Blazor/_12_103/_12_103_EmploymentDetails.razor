@using HRApiLibrary.Models._10_Pis.OPis


@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Employment Details" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Prof. License  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.SecurityLicense</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Badge Number  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.BadgeNumber</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> License Expiration  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.LicenseExpiry</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Position  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.PositionName</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Years of Practice  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.GuardNoYrs</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Gender  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.Tel2</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Employment Status  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.EmpStat_</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Date Hired  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.DateHired</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Date of Regularization </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.RegRef.ToString()</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Date of Separated </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.SeparationDate</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Gov. Service (yrs)  </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.MilitaryNoYr</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Remarks </div>
            <div class="p-2  ">
                <span class="px-2">@oempmas.Remarks</span>
            </div>
        </div>

    </div>
}

@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();
}
