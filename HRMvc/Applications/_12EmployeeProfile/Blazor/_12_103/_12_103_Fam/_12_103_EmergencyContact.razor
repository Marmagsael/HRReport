@using HRApiLibrary.Models._10_Pis.OPis

<h2 class="form-section-caption mt-0">Education</h2>

<div class="p-3">

    <RadzenDataGrid Data="@Oemergencs"
                    TItem="OemergencModel"
                    @ref="OemergencGrid"
                    EditMode="DataGridEditMode.Single"
                    AllowSorting=true
                    AllowPaging=true
                    PageSize="10"
                    PageSizeOptions=@(new int[]{5, 10, 20, 30})
                    ColumnWidth="200px">
        <Columns>
            <RadzenDataGridColumn TItem="OemergencModel" Property="NAME" Title="NAME" Width="150px" />
            <RadzenDataGridColumn TItem="OemergencModel" Property="ADDR" Title="ADDRESS" />
            <RadzenDataGridColumn TItem="OemergencModel" Property="RELA" Title="RELATION" Width="100px" />
            <RadzenDataGridColumn TItem="OemergencModel" Property="TEL" Title="TEL. NO." Width="100px" />
        </Columns>
    </RadzenDataGrid>
</div>



@code {
    [Parameter] public List<OemergencModel> Oemergencs { get; set; }
    RadzenDataGrid<OemergencModel?>? OemergencGrid = new();
}
