@using HRApiLibrary.Models._10_Pis.OPis

<h2 class="form-section-caption mt-0">Education</h2>

<div class="p-3">

    <RadzenDataGrid Data="@Ofamily"
                    TItem="OfamilyModel"
                    @ref="OfamilyGrid"
                    EditMode="DataGridEditMode.Single"
                    AllowSorting=true
                    AllowPaging=true
                    PageSize="10"
                    PageSizeOptions=@(new int[]{5, 10, 20, 30})
                    ColumnWidth="200px">
        <Columns>
            <RadzenDataGridColumn TItem="OfamilyModel" Property="NAME" Title="NAME" />
            <RadzenDataGridColumn TItem="OfamilyModel" Property="BIRTH" Title="BIRTH" />
            <RadzenDataGridColumn TItem="OfamilyModel" Property="RELATION" Title="RELATION" />
        </Columns>
    </RadzenDataGrid>
</div>




@code {
    [Parameter] public List<OfamilyModel> Ofamily { get; set; }
    RadzenDataGrid<OfamilyModel?>? OfamilyGrid = new();
}
