@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component


@if (V12_103?.OEmpmass?.Any() == true)
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    var s = V12_103.OSeclic ?? new OSeclicModel();


        <div class="card w-100">
            <_12_102_Cardhdr caption="Security" />

            <div class="p-2">

                <div class="card mb-2">
                    <LabelValueRow Label="Security License" Value="@e.SecLicense" />
                    <LabelValueRow Label="Expiration" Value="@e.Licexpire?.ToString("MM/dd/yyyy")" />
                    <LabelValueRow Label="Badge No." Value="@e.BadgeNo" />
                    <LabelValueRow Label="OP No." Value="@s.Opno" />
                    <LabelValueRow Label="SBR No." Value="@s.Sbrno" />
                    <LabelValueRow Label="Guard # of Yrs" Value="@e.GuardNoYrs" />
                    <LabelValueRow Label="Military # of Yrs" Value="@e.MilitaryNoYr" IsLast />
                    <LabelValueRow Label="Remarks" Value="@e.Remarks" IsLast />
                </div>

                <div class="card mb-2">
                    <div class="card-header">License Verification</div>

                    <LabelValueRow Label="Validation Status" Value="@s.ValStatus" />
                    <LabelValueRow Label="Date Validated" Value="@s.Validated?.ToString("MM/dd/yyyy")" />
                    <LabelValueRow Label="Date Re-validated" Value="@s.Revalidated?.ToString("MM/dd/yyyy")" />
                    <LabelValueRow Label="Lic. Date Issued" Value="@s.LicDateIssued?.ToString("MM/dd/yyyy")" />
                </div>

            </div>
        </div>
    
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}