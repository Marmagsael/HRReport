
    <div class="card w-100">
    <_12_102_Cardhdr caption="Trainings/Seminars Attended" />


        <div class="card p-2">
            <div class="card-body border p-0">
                <div class="d-flex fw-bold py-2">
                    <div class="w-30 text-center bordered-right">Program</div>
                    <div class="w-20 text-center bordered-right">Date Taken</div>
                    <div class="w-30 text-center bordered-right">Venue</div>
                    <div class="w-20 text-center bordered-right">Type</div>
                    <div class="w-30 text-center bordered-right">Trainor</div>
                </div>

                <div class="card-body p-0 ">
                    @foreach (var t in V12_103.OTrains)
                    {
                        <div class="d-flex  py-2">
                        <div class="w-30 text-center bordered-right">@t.PROGRAM</div>
                        <div class="w-20 text-center bordered-right">@t.TAKEN</div>
                        <div class="w-30 text-center bordered-right">@t.SCHOOL</div>
                        <div class="w-20 text-center bordered-right">@t.TYPE</div>
                        <div class="w-30 text-center bordered-right">@t.TRAINOR</div>
                        </div>
                    }

                </div>
            </div>


        </div>

    </div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}