
<div class="card w-100">
    <_12_102_Cardhdr caption="Trainings/Seminars Attended" />
    @foreach (var c in V12_103.OTrains)
    {
        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Program  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.PROGRAM</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Date Taken  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.TAKEN</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Venue  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.SCHOOL</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Trainor  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.TRAINOR</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 text-primary "> Type  </div>
            <div class="p-2  text-success">
                <span class="px-2">@c.TYPE</span>
            </div>
        </div>
    }
</div>



@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}