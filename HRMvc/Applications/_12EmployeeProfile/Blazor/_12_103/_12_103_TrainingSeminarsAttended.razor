<div class="card w-100">
    <_12_102_Cardhdr caption="Employment Records" />

    <div class="p-2">
        <div class="card p-0">
            <div class="overflow-auto">

                <div class="d-flex fw-bold py-2 table-row flex-nowrap">
                    <div class="col-program     ps-3 bordered-right">Program</div>
                    <div class="col-venue       ps-3 bordered-right">Venue</div>
                    <div class="col-trainor     ps-3 bordered-right">Trainor</div>
                    <div class="col-date-taken  ps-3 bordered-right">Date Taken</div>
                    <div class="col-type        ps-3 ">Type</div>
                </div>

                <div class="card-body p-0">
                    @foreach (var e in V12_103.OTrains)
                    {
                        <div class="d-flex py-2 border-top table-row flex-nowrap">
                            <div class="col-program     ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Program) ? e.Program : "N/A")</div>
                            <div class="col-venue       ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.School) ? e.School : "N/A")</div>
                            <div class="col-trainor     ps-3 bordered-right">@(!string.IsNullOrWhiteSpace(e.Trainor) ? e.Trainor : "N/A")</div>
                            <div class="col-date-taken  ps-3 bordered-right">Date Taken</div>
                            <div class="col-type        ps-3 ">@(!string.IsNullOrWhiteSpace(e.Type) ? e.Type : "N/A")</div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>


@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

   
}


<style>
    .table-row {
        min-width: 1060px;
    }

    .col-program {
        min-width: 260px;
    }

    .col-date-taken {
        min-width: 150px;
    }

    .col-venue {
        min-width: 260px;
    }

    .col-type {
        min-width:150px;
    }

    .col-trainor {
        min-width: 260px;
    }



</style>