@using HRApiLibrary.Models._10_Pis.OPis

  <h2 class="form-section-caption mt-0">Education</h2>

  <div class="p-3">

    <RadzenDataGrid Data="@Oeducates"
                    TItem="OeducateModel"
                    @ref="OempmaseducatesGrid"
                    EditMode="DataGridEditMode.Single"
                    AllowSorting=true
                    AllowPaging=true
                    PageSize="10"
                    PageSizeOptions=@(new int[]{5, 10, 20, 30})
                    ColumnWidth="200px">
        <Columns>
            <RadzenDataGridColumn TItem="OeducateModel" Property="LEVEL"  Title="LEVEL" Width="100px" />
            <RadzenDataGridColumn TItem="OeducateModel" Property="COURSE" Title="COURSE" />
            <RadzenDataGridColumn TItem="OeducateModel" Property="SCHOOL" Title="School" Width="350px" />
            <RadzenDataGridColumn TItem="OeducateModel" Property="FROM_"  Title="From"  Width="100px" />
            <RadzenDataGridColumn TItem="OeducateModel" Property="TO_"    Title="To"    Width="100px" />
        </Columns>
    </RadzenDataGrid> 
    </div>
 


  

@code {
    [Parameter] public List<OeducateModel?>? Oeducates      { get; set; }
    RadzenDataGrid<OeducateModel?>? OempmaseducatesGrid = new();
}
