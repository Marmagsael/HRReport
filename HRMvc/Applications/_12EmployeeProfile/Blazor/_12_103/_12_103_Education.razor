@{
    var educateRef = new List<EducationRefModel>
    {
        new EducationRefModel { Name = "Primary", Code = "P" },
        new EducationRefModel { Name = "Elementary", Code = "E" },
        new EducationRefModel { Name = "High School", Code = "H" },
        new EducationRefModel { Name = "College", Code = "C" },
        new EducationRefModel { Name = "Vocational", Code = "V" },
        new EducationRefModel { Name = "Master", Code = "M" },
        new EducationRefModel { Name = "Doctorate", Code = "D" }
    };
}

<div class="card w-100">
    <_12_102_Cardhdr caption="Education Background" />

    <div class=" p-2">
        <div class="card  p-0">
            <div class="d-flex fw-bold py-2">
                <div class="w-20 text-left bordered-right ps-3">Level</div>
                <div class="w-40 text-left bordered-right ps-3">School</div>
                <div class="w-20 text-center bordered-right">Year</div>
                <div class="w-20 text-left bordered-right ps-3">Course</div>
                <div class="w-20 text-left ps-3">Remarks</div>
            </div>

            <div class="card-body p-0 ">
                @foreach (var s in V12_103.OEductates)
                {
                    <div class="d-flex py-2 border-top">
                        <div class="w-20 text-left bordered-right ps-3">
                            @(educateRef.FirstOrDefault(er => er.Code == s.CODE)?.Name ?? "-")
                        </div>
                        <div class="w-40 text-left bordered-right ps-3"> @(!string.IsNullOrWhiteSpace(s.SCHOOL) ? s.SCHOOL : "-") </div>
                        <div class="w-20 text-center bordered-right">@s.FROM_ - @s.TO_</div>
                        <div class="w-20 text-left bordered-right ps-3">@(!string.IsNullOrWhiteSpace(s.COURSE) ? s.COURSE : "—")</div>
                        <div class="w-20 text-left ps-3">@(!string.IsNullOrWhiteSpace(s.LEVEL) ? s.LEVEL : "—")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();

    public class EducationRefModel
    {
        public string Name { get; set; }
        public string Code { get; set; }
    }
}
