<div class="d-flex gap-2 @(IsLast ? "" : "border-bottom")">
    <div class="p-2 ps-3 w-175p border-end">@Label</div>
    <div class="p-2 px-3">@(string.IsNullOrWhiteSpace(Value) ? "—" : Value)</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool IsLast { get; set; } = false;
}
