@using HRApiLibrary.Models._10_Pis.OPis


@{
    var oempmas = Oempmass.FirstOrDefault();
    if (Oempmass.Count() < 1) oempmas = new OempmasModel();
 }
 
 <div class="card w-100">
    <_12_102_Cardhdr caption="Personal Information" />

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3  w-125p border-end "> Birth Date  </div>
        <div class="p-2  ">
            <span class="px-2"> @oempmas.EmpBirth?.ToString("MMMM dd, yyyy")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end  "> Birth Place  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.BirthPlace) ? oempmas.BirthPlace : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end  "> Age  </div>
        <div class="p-2  ">
            <span class="px-2">@oempmas.Age</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end  "> Gender  </div>
        <div class="p-2  ">
             <span class="px-2">
                @(V12_103.OGenders == null ? "" : V12_103.OGenders.Where(g => g.Code == oempmas.Sex_).FirstOrDefault()?.Name)
            </span>

        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end  "> Citizenship  </div>
        <div class="p-2  ">
            <span class="px-2"> @oempmas.Citizenship </span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Civil Status  </div>
        <span class="px-2"> @(V12_103.OCivstats == null ? "" : V12_103.OCivstats.Where(g => g.Code == oempmas.CivStat_).FirstOrDefault()?.Name)</span>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Religion  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Religion) ? oempmas.Religion : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Height  </div>
        <div class="p-2  ">
            <span class="px-2">@oempmas.Height</span><span>ft</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Weight  </div>
        <div class="p-2  ">
            <span class="px-2">@oempmas.Weight</span><span>lbs</span>
        </div>
    </div>
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end  w-125p border-end  "> Hair Color</div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Hair) ? oempmas.Hair : "")</span>
        </div>
    </div>
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Eye Color  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Eyes) ? oempmas.Eyes : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Complexion  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Complexion) ? oempmas.Complexion : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Marks  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Marks) ? oempmas.Marks : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Blood Type  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.BloodType) ? oempmas.BloodType : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Spouse  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Spouse) ? oempmas.Spouse : "")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 ps-3 w-125p border-end "> Occupation  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.Occupation) ? oempmas.Occupation : "")</span>
        </div>
    </div>


    <div class=" d-flex gap-2  ">
        <div class="p-2 ps-3 w-125p border-end "> No. of Children  </div>
        <div class="p-2  ">
            <span class="px-2">@(!string.IsNullOrWhiteSpace(oempmas.NoChildren) ? oempmas.NoChildren : "0")</span>
        </div>
    </div>

   
</div>

@code {
    [Parameter] public List<OempmasModel?>?     Oempmass    { get; set; } = new();
    [Parameter] public V12_103?                 V12_103     { get; set; } = new();
}
