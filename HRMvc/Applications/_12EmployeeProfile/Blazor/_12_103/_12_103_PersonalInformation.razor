@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Personal Data" />
        <LabelValueRow Label="Birth Date"       Value="@e.EmpBirth?.ToString("MMMM dd, yyyy")" />
        <LabelValueRow Label="Birth Place"      Value="@e.BirthPlace" />
        <LabelValueRow Label="Age"              Value="@e.Age?.ToString()" />
        <LabelValueRow Label="Gender"           Value="@(V12_103.OGenders?.FirstOrDefault(g => g.Code == e.Sex_)?.Name)" />
        <LabelValueRow Label="Citizenship"      Value="@e.Citizen" />
        <LabelValueRow Label="Civil Status"     Value="@(V12_103.OCivstats?.FirstOrDefault(g => g.Code == e.CivStat_)?.Name)" />
        <LabelValueRow Label="Religion"         Value="@e.Religion" />
        <LabelValueRow Label="Height"           Value="@(string.Join(" ", new[] { e.Height != null ? $"{e.Height} ft" : null }))" />
        <LabelValueRow Label="Weight"           Value="@(e.Weight != null ? $"{e.Weight} lbs" : null)" />
        <LabelValueRow Label="Hair Color"       Value="@e.Hair" />
        <LabelValueRow Label="Eye Color"        Value="@e.Eyes" />
        <LabelValueRow Label="Complexion"       Value="@e.Complexion" />
        <LabelValueRow Label="Marks"            Value="@e.Marks" />
        <LabelValueRow Label="Blood Type"       Value="@e.BloodType" />
        <LabelValueRow Label="Spouse"           Value="@e.Spouse" />
        <LabelValueRow Label="Occupation"       Value="@e.Occupation" />
        <LabelValueRow Label="No. of Children"  Value="@e.NoChildren?.ToString()" IsLast />
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}