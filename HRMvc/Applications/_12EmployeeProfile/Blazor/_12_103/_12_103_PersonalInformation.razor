@using HRApiLibrary.Models._10_Pis.OPis


@{
    var oempmas = Oempmass.FirstOrDefault();
    if (Oempmass.Count() < 1) oempmas = new OempmasModel();
 }
 
 <div class="card w-100">
    <_12_102_Cardhdr caption="Personal Information" />

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Birth Date  </div>
        <div class="p-2  text-success">
            <span class="px-2"> @oempmas.EmpBirth?.ToString("MMMM dd, yyyy")</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p  "> Birth Place  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.BirthPlace</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p  "> Gender  </div>
        <div class="p-2  text-success">
            <span class="px-2">@V12_103.OGenders.Where(g => g.Code == oempmas.Sex_).FirstOrDefault().Name</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p  "> Citizenship  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Citizen</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Civil Status  </div>
        <div class="p-2  text-success">
            <span class="px-2">@V12_103.OCivstats.Where(c => c.Code == oempmas.CivStat_).FirstOrDefault().Name</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Religion  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Religion</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Height  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Height</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Weight  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Weight</span>
        </div>
    </div>
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p  w-100p  "> Hair Color</div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Hair</span>
        </div>
    </div>
    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Eye Color  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Eyes</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Complexion  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Complexion</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Marks  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.Marks</span>
        </div>
    </div>

    <div class=" d-flex gap-2 border-bottom ">
        <div class="p-2 text-primary w-100p "> Blood Type  </div>
        <div class="p-2  text-success">
            <span class="px-2">@oempmas.BloodType</span>
        </div>
    </div>

   
</div>

@code {
    [Parameter] public List<OempmasModel?>?     Oempmass    { get; set; } = new();
    [Parameter] public V12_103?                 V12_103     { get; set; } = new();
}
