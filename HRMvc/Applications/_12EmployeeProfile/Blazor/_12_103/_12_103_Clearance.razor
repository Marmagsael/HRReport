@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103._12_103_Component

@if (V12_103.OEmpmass.Any())
{
    var e = V12_103.OEmpmass.FirstOrDefault();
    <div class="card w-100">
        <_12_102_Cardhdr caption="Clearance" />
        <LabelValueRow Label="NBI Expire"       Value="@e.Exp_Nbi?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Police Expire"    Value="@e.Exp_Police?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="PNP Expire"       Value="@e.Exp_Pnp?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Barangay Expire"  Value="@e.Exp_Brgy?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Neuro Expire"     Value="@e.Exp_Neuro?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Drug Test Expire" Value="@e.Exp_Drug?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Court Expire"     Value="@e.Exp_Court?.ToString("MM/dd/yyyy")" />
        <LabelValueRow Label="Medical Expire"   Value="@e.ExpMed?.ToString("MM/dd/yyyy")" IsLast />
    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}