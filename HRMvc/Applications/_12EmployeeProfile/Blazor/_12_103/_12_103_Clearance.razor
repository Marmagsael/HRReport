@using HRApiLibrary.Models._10_Pis.OPis
@using global::HRMvc.Applications.Vars


@if (V12_103.OEmpmass.Count() > 0)
{
    var OEmpmas = V12_103.OEmpmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Clearance" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-140p border-end "> NBI Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Nbi?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  ps-3  w-140p border-end "> Police Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Police?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-140p border-end "> PNP Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Pnp?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3 w-140p border-end "> Barangay Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Brgy?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-140p border-end "> Neuro Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Neuro?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-140p border-end "> Drug Test Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Drug?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 ps-3  w-140p border-end "> Court Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.Exp_Court?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


        <div class=" d-flex gap-2  ">
            <div class="p-2 ps-3  w-140p border-end "> Medical Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(OEmpmas.ExpMed?.ToString("MM/dd/yyyy") ?? "")</span>
            </div>
        </div>


    </div>
}

@code {
    [Parameter] public V12_103? V12_103 { get; set; } = new();
}

