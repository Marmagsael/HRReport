@using HRApiLibrary.Models._10_Pis.OPis


@if (Oempmass.Count() > 0)
{
    var oempmas = Oempmass.FirstOrDefault();

    <div class="card w-100">
        <_12_102_Cardhdr caption="Clearance" />

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> NBI Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_PNP?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Police Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_POLICE?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> PNP Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_PNP?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Barangay Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_BRGY?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Neuro Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_NEURO?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Drug Test Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_DRUG?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Court Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXP_COURT?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>


        <div class=" d-flex gap-2 border-bottom ">
            <div class="p-2 w-140p border-end "> Medical Expire  </div>
            <div class="p-2  ">
                <span class="px-2">@(oempmas.EXPMED?.ToString("MM/dd/yyyy") ?? "N/A")</span>
            </div>
        </div>


    </div>
}

@code {
    [Parameter] public List<OempmasModel?>? Oempmass { get; set; } = new();

}
