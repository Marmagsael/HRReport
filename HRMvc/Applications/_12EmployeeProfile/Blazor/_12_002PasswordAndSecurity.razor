                        ================================================= *@
                        <TabStripTab Id="useraccess" Title="User Manager">
                            <_12_002UseManager/>
                        </TabStripTab>


                    </TelerikTabStrip>
                </CardBody>
            </TelerikCard>
         </CascadingValue>
    </CascadingValue>

     


</TelerikRootComponent>

@inject I_00UsersAccess _user
@code {
    [Parameter] public UserClaimsModel Uc { get; set; } = new();
    private V12_002Model v { get; set; } = new();


    private TelerikNotification? NotificationRef;

    private string tab = "password";


    protected override  Task OnInitializedAsync()
    {
        if (Uc == null || Uc.Conn == null || Uc.OpisDb == null || Uc.OpayDb == null || Uc.SchemaMain == null)
        {
            v.UcLoaded = false;
            NotificationRef?.Show("Something went wrong. Please try again.", ThemeConstants.Notification.ThemeColor.Error);
            return;

        }

        v.OPisdb = Uc.OpisDb;
        v.OPaydb = Uc.OpayDb;
        v.Maindb = Uc.SchemaMain;
        v.Conn = Uc.Conn;

        v.UcLoaded = true;

        
    }

