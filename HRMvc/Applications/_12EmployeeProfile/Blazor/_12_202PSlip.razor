@using HRApiLibrary.Models._20_PayGeneric
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_202
<div class="ms-2 mt-1 w-960p card b-dgray vh-95min body-wrapper position-relative">

    @if (V.Loading)
    {
        <div class="pay-loading" aria-live="polite">
            <div class="pay-loading-box">
                <div class="pay-loading-rings">
                    <span></span><span></span><span></span>
                    <i class="fa-solid fa-file-invoice"></i>
                </div>
                <div class="pay-loading-title">Loading your payslip</div>
                <div class="pay-loading-msg">Please wait…</div>
                <div class="pay-loading-bar"><div></div></div>
            </div>
        </div>
    }

    
    <div class="card-header">
        <HRMvc.Applications.EPortal.Blazor._12_102._12_102_PersonalInfo OEmpmass="@V.OEmpmas" />
    </div> 
    <div class="card-body p-0">
        <div class="card-header bg-white"><div class="mt-2"><h5>My Payslip</h5></div></div>
        
        <_12_202_Buttons V="@V" ChildAction="ChildActionHandler" />

        @if (V.Tbltrans != null && V.Tbltrans.Count > 0)
        {
            var tbltrans_trn = V.Tbltrans.Select(t => t.Trn).Distinct().ToList();
            foreach (var trn in tbltrans_trn)
            {

                List<GTbltranModel?>? gTbltrans = V.Tbltrans.Where(t => t.Trn == trn).ToList();
                List<GTbltrandtlModel?>? gTbltrandtls = V.Tbltrandtls.Where(t => t.Trn == trn).ToList();
                var pmhdr = V.Paymainhdrs.FirstOrDefault(p => p.Trn == trn);
                <div class="bordered-bottom">
                    <_12_202_Payslip_Details GTbltrans="@gTbltrans" GTbltrandtls="@gTbltrandtls" GPaymainhdr="@(pmhdr ?? new())" />
                </div>
            }
        }
       


       
        @* else if (V.initialmsg != string.Empty && !V.Tbltrans.Any())
        {
            <p class="text-muted text-center pt-5">@V.initialmsg</p>
        }
         *@

       


       
    </div>
</div>




<style>
    .pay-loading {
        position: absolute; inset: 0; z-index: 20;
        display: flex; align-items: center; justify-content: center;
        background: rgba(220, 224, 228, .30);
        backdrop-filter: blur(2px);
    }
    .pay-loading-box { width: 280px; padding: 26px 22px 20px; background: #fff; border-radius: 14px; text-align: center; box-shadow: 0 18px 50px rgba(0,0,0,.25); }
    .pay-loading-rings { position: relative; width: 84px; height: 84px; margin: 0 auto 16px; }
    .pay-loading-rings span { position: absolute; inset: 0; border-radius: 50%; border: 4px solid transparent; border-top-color: #047959; animation: pay-spin 1.1s cubic-bezier(.5,.1,.5,.9) infinite; }
    .pay-loading-rings span:nth-child(2) { inset: 10px; border-top-color: #34b38a; animation-duration: 1.5s; animation-direction: reverse; }
    .pay-loading-rings span:nth-child(3) { inset: 20px; border-top-color: #9ad9c3; animation-duration: 1.9s; }
    .pay-loading-rings i { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #047959; font-size: 18px; }
    .pay-loading-title { font-weight: 600; font-size: 1.05rem; color: #1f2d27; }
    .pay-loading-msg { font-size: .85rem; color: #6b7a74; margin-top: 2px; }
    .pay-loading-bar { height: 4px; margin-top: 16px; border-radius: 4px; background: #e6f2ee; overflow: hidden; }
    .pay-loading-bar div { width: 40%; height: 100%; border-radius: 4px; background: #047959; animation: pay-bar 1.4s ease-in-out infinite; }
    @@keyframes pay-spin { to { transform: rotate(360deg); } }
    @@keyframes pay-bar { 0% { transform: translateX(-110%); } 100% { transform: translateX(260%); } }
</style>

@code {

    [Parameter] public V12_202?                 V    { get; set; } = new();

    void ChildActionHandler()
    {
        StateHasChanged();
    }

   

}
