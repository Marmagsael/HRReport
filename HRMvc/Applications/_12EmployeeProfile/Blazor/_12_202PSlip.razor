@using HRApiLibrary.Models._20_PayGeneric
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_202
<div class="ms-2 mt-1 w-960p card b-dgray vh-95min body-wrapper">
    
    <div class="card-header">
        <_12_102_PersonalInfo OEmpmass="@V.OEmpmas" ></_12_102_PersonalInfo>
    </div> 
    <div class="card-body p-0">
        <div class="card-header bg-white"><div class="mt-2"><h5>My Payslip</h5></div></div>
        
        <_12_202_Buttons V="@V" ChildAction="ChildActionHandler" />
        
        @if(V.Tbltrans != null && V.Tbltrans.Count > 0) {

             var tbltrans_trn       = V.Tbltrans.Select(t=> t.Trn).Distinct().ToList(); 
            foreach(var trn in tbltrans_trn)
            {
                
                List<GTbltranModel?>?       gTbltrans       = V.Tbltrans.Where(t=> t.Trn == trn).ToList();
                List<GTbltrandtlModel?>?    gTbltrandtls    = V.Tbltrandtls.Where(t=> t.Trn == trn).ToList();
                var pmhdr = V.Paymainhdrs.FirstOrDefault(p=> p.Trn == trn); 
                <div class="bordered-bottom">
                    <_12_202_Payslip_Details GTbltrans="@gTbltrans" GTbltrandtls="gTbltrandtls" GPaymainhdr="@(pmhdr??new())"   />   
                </div>
            }
        }

    </div>
</div>




@code {

    [Parameter] public V12_202?                 V    { get; set; } = new();

    void ChildActionHandler()
    {
        StateHasChanged();
    }
    
}
