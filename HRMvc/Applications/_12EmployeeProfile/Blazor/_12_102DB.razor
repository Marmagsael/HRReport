@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Views.BlazorPages.Vars
@namespace HRMvc.Applications._12EmployeeProfile.Blazor




<div class="ms-2 mt-1 w-960p card b-dgray vh-95min body-wrapper">
    
    <div class="card-header">
        <_12_102_PersonalInfo Oempmass="Oempmass" ></_12_102_PersonalInfo>
    </div> 
    <_12_102Shortcuts> </_12_102Shortcuts>
    
    
    <div class="card-body w-100">
        <div class="w-100">
            <_12_102_Body_Clock  Oempmass="@Oempmass" > </_12_102_Body_Clock>    
        </div>
        
        <div class="d-flex gap-2 w-100 mt-3">
            @*--- Left ---*@
            <div class="w-50">
                <div>
                    <_12_102_Body_Punch Oempmass="@Oempmass" UserClaims="@UserClaims"></_12_102_Body_Punch>
                </div>
                <div class="mt-2">
                    <_12_102_AttTemplate />
                </div>
                
                
            </div>

            @*--- Right ---*@
            <div class="w-50">
                <_12_102_Body_Action></_12_102_Body_Action>
            </div>            
        </div>
        
    </div>
    

</div>


<div> 12.102 * empNumber :  @UserClaims.OempNumber </div>
<div> 12.102 * Conn :       @UserClaims.Conn   </div>
<div> 12.102 * PisDb :      @UserClaims.SchemaUserPis </div>
<div> 12.102 * User ID :    @UserClaims.SchemaUserPay </div>
<hr />
<div> Old PIS :    @UserClaims.OpisDb </div>


<div> Empmas Count : @Oempmass.Count </div>

@if (Oempmass.Count > 0)
{
    <div> EmpLast Name : @Oempmass.First().EmpFirstNm </div>    
}





@code {

    [Parameter] public UserClaimsModel?         UserClaims  { get; set; }
    [Parameter] public List<OempmasModel?>?     Oempmass    { get; set; } = [];
    [Parameter] public V131?                    v           { get; set; } = new();
    
        
    
    
    

}