@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103
@using HRMvc.StartupConfig.Library


<div class="ms-2 mt-1 w-960p card b-dgray vh-95min body-wrapper">

    <div class="card-header">
        <_12_102_PersonalInfo OEmpmass="OEmpmass"></_12_102_PersonalInfo>
    </div>
    <_12_103Shortcuts Ec="@Ec"/>

   


    <div class="card-body w-100">
        @if (lnk == 1)
        {
            <div class="w-100">
                <_12_103_PersonalInformation OEmpmass="OEmpmass" V12_103="V12_103" />
            </div>
        }

        @if (lnk == 2)
        {
            <div class="w-100">
                <_12_103_Address OEmpmass="OEmpmass" V12_103="V12_103" />
            </div>
        }
        @if (lnk == 3)
        {
            <div class="w-100">
                <_12_103_Family V12_103="V12_103" />
            </div>
        }
        @if (lnk == 4)
        {
            <div class="w-100">
                <_12_103_Education V12_103="V12_103" />
            </div>
        }
        @if (lnk == 5)
        {
            <div class="w-100">
                <_12_103_EmploymentRecords V12_103="V12_103" />
            </div>
        } 
        @if (lnk == 6)
        {
            <div class="w-100">
                <_12_103_EmploymentDetails OEmpmass ="OEmpmass" />
            </div>
        }
        @if (lnk == 7)
        {
            <div class="w-100">
                <_12_103_TrainingSeminarsAttended V12_103="V12_103" />
            </div>
        }
        @if (lnk == 8)
        {
            <div class="w-100">
                <_12_103_Government OEmpmass="OEmpmass" />
            </div>
        }
        @if (lnk == 9)
        {
            <div class="w-100">
                <_12_103_Insurance OEmpmass ="OEmpmass" />
            </div>
        }
        @if (lnk == 10)
        {
            <div class="w-100">
                <_12_103_Reference V12_103="V12_103" />
            </div>
        }
        @if (lnk == 11)
        {
            <div class="w-100">
                <_12_103_Clearance  OEmpmass="OEmpmass" />
            </div>
        }
        @if (lnk == 12)
        {
            <div class="w-100">
            </div>
        }


       


        
    </div>


</div>

@inject L12_103 L103

@code {
    [Parameter] public UserClaimsModel?             UserClaims  { get; set; }
    List<OEmpmasModel?>?         OEmpmass    { get; set; }   = [];
    V12_103?                     V12_103     { get; set; }   = new();

    int lnk = 1;

    void Ec(int val)
    {
        lnk = val;

    }

    protected async override Task OnInitializedAsync()
    {
        OEmpmass = await L103._02OEmpmass(UserClaims);
        V12_103 = await L103.V12_103(UserClaims);
    }

}
