@using HRApiLibrary.DataAccess._10_Pis.OPis
@using HRApiLibrary.Models._10_Pis.OPis
@using HRMvc.Applications._12EmployeeProfile.Blazor
@using HRMvc.Applications._12EmployeeProfile.Blazor._12_103


<div class="ms-2 mt-1 w-960p card b-dgray vh-95min body-wrapper">

    <div class="card-header">
        <_12_102_PersonalInfo Oempmass="Oempmass"></_12_102_PersonalInfo>
    </div>
    <_12_103Shortcuts Ec="@Ec"/> 


    <div class="card-body w-100">

        @if (lnk == 2)
        {
            <div class="w-100">
                <_12_103_Address Oempmass="Oempmass" />
            </div>
        }
        @if (lnk == 3)
        {
            <div class="w-100">
                <_12_103_Family V12_103="V12_103" />
            </div>
        }
        @if (lnk == 4)
        {
            <div class="w-100">
                <_12_103_Education V12_103="V12_103" />
            </div>
        }
        @if (lnk == 5)
        {
            <div class="w-100">
                <_12_103_EmploymentRecords V12_103="V12_103" />
            </div>
        } 
        @if (lnk == 6)
        {
            <div class="w-100">
                <_12_103_EmploymentDetails Oempmass ="Oempmass" />
            </div>
        }
        @if (lnk == 7)
        {
            <div class="w-100">
                <_12_103_TrainingSeminarsAttended V12_103="V12_103" />
            </div>
        }
        @if (lnk == 8)
        {
            <div class="w-100">
                <_12_103_Government Oempmass="Oempmass" />
            </div>
        }
        @if (lnk == 9)
        {
            <div class="w-100">
                <_12_103_Insurance Oempmass ="Oempmass" />
            </div>
        }
        @if (lnk == 10)
        {
            <div class="w-100">
                <_12_103_Reference V12_103="V12_103" />
            </div>
        }
        @if (lnk == 11)
        {
            <div class="w-100">
                <_12_103_Clearance  Oempmass="Oempmass />
            </div>
        }
        @if (lnk == 12)
        {
            <div class="w-100">
            </div>
        }


        @if(lnk==0) {
            <div class="w-100">
                    <_12_103_PersonalInformation Oempmass="Oempmass" />
            </div>
        }


        
    </div>


</div>

@inject IOempmasDataAccess _oempmas;

@code {
    [Parameter] public UserClaimsModel?             UserClaims  { get; set; }
    [Parameter] public List<OempmasModel?>?         Oempmass    { get; set; }   = new();
    [Parameter] public V12_103?                     V12_103     { get; set; } = new();

    int lnk = 0;

    void Ec(int val)
    {
        lnk = val;

    }
  
}
