@using HRApiLibrary.DataAccess._20_Pay.Interface
@using HRApiLibrary.Models._20_Pay
@using HRMvc.Applications._03Payroll.Views.BlazorPages._00_Utility
@using HRMvc.Applications._03Payroll.Views.BlazorPages._05_Management._0501
@using Microsoft.AspNetCore.Components.Forms

@inject DialogService _DialogService
@inject NotificationService _NotificationService;

<RadzenDialog />
<RadzenNotification />

<div class="r-container">
    <_DtlHdr caption="Company Settings" />

    <div class="card shadow bordered-darkgreen mt-3">
        <div class="card-header text-white fw-bold " style="background-color: darkslategrey">
            Company Details
        </div>

        <!-- Buttons -->
        <div class="bordered bg-black bg-opacity-10 px-2 py-1 bordered-bottom-darkgreen">
            <button onclick="@Save" class="btn btn-success btn-sm me-1">Save</button>
        </div>

        @* ============ Company Name (char(15)) ============ *@
        <div class="bordered bg-secondary bg-opacity-10 px-2 py-1 bordered-bottom">
            Company Name
        </div>

        <div class="d-flex">
            @* ============ Company Details ============ *@
            <div class="w-80">


                <div class="card-body">
                    @* ----- CoShortName (char(15))----------*@
                    <div class="d-flex flex-wrap p-sm-0">
                        <div class="p-2 @lblwidth rw-sm">Short Name </div>
                        <div class="w-sm-40 w-sm-175p ">
                            <RadzenTextBox Placeholder="Morpheusbox"
                                           class="w-100"
                                           MaxLength="15"
                                           @bind-Value="@Settings.CoShortName" />
                        </div>
                    </div>

                    @* ----- CoFullName (char(80))----------*@
                    <div class="d-flex flex-wrap py-1">
                        <div class="p-2 w-125p w-sm-100 ">Payroll Name </div>
                        <div class="w-650p rw-sm ">
                            <RadzenTextBox Placeholder="Morpheusbox Software Development Services"
                                           class="w-100"
                                           MaxLength="80"
                                           @bind-Value="@Settings.CoFullName" />
                        </div>
                    </div>

                    @* ----- CoAddress (char(160))----------*@
                    <div class="d-flex flex-wrap">
                        <div class="p-2 @lblwidth rw-sm">Address </div>
                        <div class="w-650p rw-sm ">
                            <RadzenTextArea Placeholder="Co. Address"
                                            class="w-100"
                                            Rows="3"
                                            MaxLength="160"
                                            @bind-Value="@Settings.CoAddress" />
                        </div>
                    </div>

                    @* ----- CoContactNos (char(80))----------*@
                    <div class="d-flex flex-wrap">
                        <div class="p-2 @lblwidth rw-sm">Contact Nos. </div>
                        <div class="w-350p rw-sm ">
                            <RadzenTextBox Placeholder="Contact Nos."
                                           class="w-100"
                                           MaxLength="80"
                                           @bind-Value="@Settings.CoContactNos" />
                        </div>


                    </div>

                </div>
            </div>


            @* ============ Image Upload ============ *@
            <div class="d-flex flex-wrap mt-3">
                <div style="width:180px; height:180px">
                    <div class="border rounded overflow-hidden position-relative ratio ratio-1x1 img-container">

                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl"
                                 class="w-100 h-100 object-fit-cover" />

                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white img-hover-overlay"
                                 style="background: rgba(0,0,0,0.4); cursor: pointer;">

                                <InputFile OnChange="OnInputFileChange"
                                           class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                           accept="image/*" />

                                <span class="btn btn-primary mb-2" style="pointer-events: none;">
                                    Upload Image
                                </span>

                                <!-- Remove button -->
                                <button class="btn btn-sm btn-danger mt-2" @onclick="RemoveImage" style="z-index: 10;">
                                    Remove Image
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center">
                                <span class=" text-center text-muted">
                                    Click to upload image
                                </span>
                            </div>
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white img-hover-overlay"
                                 style="background: rgba(0,0,0,0.4); cursor: pointer;">


                                <InputFile OnChange="OnInputFileChange"
                                           class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                           accept="image/*" />

                                <span class="btn btn-primary mb-2" style="pointer-events: none;">
                                    Upload Image
                                </span>


                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>



        @* ============ Registration Details ============ *@
        <div class="bordered bg-secondary bg-opacity-10 px-2 py-1 bordered-bottom ">
            Registration Details
        </div>

        <div class="card-body">
            @* --- 1st line  ------------------------- *@
            <div class="d-flex flex-wrap">
                <div class="w-35 px-1  rw-sm">
                    @* ----- RegNo (char(25))----------*@
                    <div>Reg. No. </div>
                    <div>
                        <RadzenTextBox Placeholder="RegNo"
                                       class="w-100"
                                       MaxLength="25"
                                       @bind-Value="@Settings.RegNo" />
                    </div>
                </div>
                <div class="w-35 px-1 rw-sm">
                    @* ----- TIN (char(25))----------*@
                    <div>T.I.N. </div>
                    <div>
                        <RadzenTextBox Placeholder="TIN"
                                       class="w-100"
                                       MaxLength="25"
                                       @bind-Value="@Settings.Tin" />
                    </div>
                </div>

            </div>

            @* --- 2nd line  ------------------------- *@
            <div class="d-flex flex-wrap">
                <div class="w-35 px-1  rw-sm mt-2 ">
                    @* ----- SSSNo (char(25))----------*@
                    <div class="">SSS No. </div>
                    <div>
                        <RadzenTextBox Placeholder="SSSNo"
                                       class="w-100"
                                       MaxLength="25"
                                       @bind-Value="@Settings.SssNo" />
                    </div>
                </div>
                <div class="w-35 px-1 rw-sm mt-2">
                    @* ----- PhicNo (char(25))----------*@
                    <div>PHIC No. </div>
                    <div>
                        <RadzenTextBox Placeholder="PhicNo"
                                       class="w-100"
                                       MaxLength="25"
                                       @bind-Value="@Settings.PhicNo" />
                    </div>
                </div>

                <div class="w-30 px-1 rw-sm mt-2">
                    @* ----- PagibigNo (char(25))----------*@
                    <div>Pagibig No. </div>
                    <div>
                        <RadzenTextBox Placeholder="PagibigNo"
                                       class="w-100"
                                       MaxLength="25"
                                       @bind-Value="@Settings.PagibigNo" />
                    </div>
                </div>

            </div>

        </div>

        @* ============ Days Converstion ============ *@
        <div class="bordered bg-secondary bg-opacity-10 px-2 py-1 bordered-bottom ">
            Day Conversation
        </div>

        <div class="card-body bordered-bottom">

            @* ----- Yeartodays (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap">
                <div class="p-2 w-250p">Total Working Days in a Year </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.Yeartodays"
                                   Max="365"
                                   TextAlign="TextAlign.Center"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

            @* ----- Semiannualtodays (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap mt-1">
                <div class="p-2 w-250p ">Total Working Days in Half Year  </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   TextAlign="TextAlign.Center"
                                   Max="183"
                                   @bind-Value=@Settings.Semiannualtodays
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

            @* ----- Monthtodays (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap mt-1">
                <div class="p-2 w-250p ">Total Working Days in Month  </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   Max="31"
                                   TextAlign="TextAlign.Center"
                                   @bind-Value="@Settings.Monthtodays"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

            @* ----- SemiMonthtodays (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap mt-1">
                <div class="p-2 w-250p ">Total Working Days Half-Month  </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   Max="15"
                                   TextAlign="TextAlign.Center"
                                   @bind-Value="@Settings.SemiMonthtodays"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

            @* ----- DaysPerWeek (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap mt-1">
                <div class="p-2 w-250p ">Total Working Days in a Week  </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.DaysPerWeek"
                                   Max="7"
                                   TextAlign="TextAlign.Center"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

            @* ----- Daytohours (int(10) unsigned)----------*@
            <div class="d-flex flex-wrap mt-1">
                <div class="p-2 w-250p ">Total Working Hours in a Day  </div>
                <div class="w-150p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.Daytohours"
                                   Max="12"
                                   TextAlign="TextAlign.Center"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

        </div>

        @* ============ Payroll Type ============ *@
        <div class="bordered bg-secondary bg-opacity-10 px-3 py-1 bordered-bottom ">

            <div class="d-flex flex-wrap">
                @* ----- PayrollType (char(10))----------*@
                <div class="w-175p py-2">Payroll Type </div>
                <div>
                    @*<RadzenTextBox Placeholder="PayrollType" class="w-100"
                                           @bind-Value="@Settings.PayrollType"/>*@
                    <RadzenDropDown @bind-Value="@Settings.PayrollType"
                                    Data="@payrollType"
                                    Placeholder="Select Payroll Type"
                                    Style="width: 200px"
                                    AllowClear="false" />
                </div>
            </div>



            <div class="bordered-bottom bordered-top pb-1 ps-2 mt-2">
                <div class="d-flex flex-wrap mt-1">
                    @* ----- Tax Template (char(3))----------*@
                    <div class="w-170p py-2">Tax Template </div>
                    <div>
                        <RadzenDropDown @bind-Value="@Settings.TaxPeriodCode"
                                        Data="@taxPattern"
                                        Placeholder="Tax Template"
                                        Style="width: 125px"
                                        AllowClear="false" />
                    </div>
                </div>

            </div>

            <div class="w-100 p-1 bordered-bottom mt-1 bg-gray-90 ">
                Government Compliance Pattern
            </div>
            <div class="bordered-bottom pb-1 ps-2 mt-2">



                <div class="d-flex flex-wrap mt-1">
                    @* ----- Tax Revision ----------*@
                    <div class="w-170p py-2">Tax Rev. Table </div>
                    <div>
                        <RadzenDropDown @bind-Value="@Settings.RevTax"
                                        Data="@taxRevision"
                                        Placeholder="Tax Revision"
                                        Style="width: 125px"
                                        AllowClear="false" />
                    </div>
                </div>

                <div class="d-flex flex-wrap mt-1">
                    @* ----- SSS Revision  ----------*@
                    <div class="w-170p py-2">SSS Rev. Table </div>
                    <div>
                        <RadzenDropDown @bind-Value="@Settings.RevSss"
                                        Data="@sssRevision"
                                        Placeholder="SSS Revision"
                                        Style="width: 125px"
                                        AllowClear="false" />
                    </div>
                </div>

                <div class="d-flex flex-wrap mt-1">
                    @* ----- PHIC Revision  ----------*@
                    <div class="w-170p py-2">PHIC Rev. Table </div>
                    <div>
                        <RadzenDropDown @bind-Value="@Settings.RevPhic"
                                        Data="@phicRevision"
                                        Placeholder="PHIC Revision"
                                        Style="width: 125px"
                                        AllowClear="false" />
                    </div>
                </div>

                <div class="d-flex flex-wrap mt-1 bordered p-1 br-5 bg-gray-90 ">
                    @* ----- Contribution Basis  ----------*@
                    <div class="w-170p p-2 t-maroon ">Contribution Basis </div>
                    <div>
                        <RadzenDropDown TValue="int"
                                        Data="@pcs"
                                        TextProperty="Source"
                                        ValueProperty="Id"
                                        @bind-Value="Settings.PremContSourceId"
                                        Placeholder="Basis of Premiums"
                                        Style="width: 250px"
                                        AllowClear="false" />

                    </div>
                </div>


            </div>




            <div class="d-flex flex-wrap mt-1">
                @* ----- PayrollType (char(10))----------*@
                <div class="w-175p py-2">Month Period Open </div>
                <div class="w-100p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.AllowedMoPrd"
                                   TextAlign="TextAlign.Center"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
            </div>

        </div>

        <div class="card-body bordered-bottom">
            <div class="d-flex flex-wrap">
                @* ----- NDStart (int(10) unsigned)----------*@
                <div class="w-125p py-2">ND Start </div>
                <div class="w-100p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.NdStart"
                                   TextAlign="TextAlign.End"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
                <div class="p-2">Hour</div>


            </div>
            <div class="d-flex flex-wrap mt-1">
                @* ----- NDEnd (int(10) unsigned)----------*@
                <div class="w-125p py-2">ND End </div>
                <div class="w-100p">
                    <RadzenNumeric Placeholder="0"
                                   Step="1"
                                   @bind-Value="@Settings.NdEnd"
                                   Max="700"
                                   Min="100"
                                   TextAlign="TextAlign.End"
                                   InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" />
                </div>
                <div class="p-2">Hour</div>
            </div>
        </div>

        <_0501_DutyRenderedAccounts UserClaims="@UserClaims"></_0501_DutyRenderedAccounts>


    </div>



</div>

@inject ISettingsDataAccess _settings;


@code {
    [Parameter] public UserClaimsModel UserClaims { get; set; } = new();

    SettingsModel? Settings = new();
    string? pisdb = string.Empty;
    string? paydb = string.Empty;
    string? conn = string.Empty;
    string? lblwidth = "w-125p";

    List<string?>? payrollType = ["Monthly", "Bi-Monthly", "Weekly"];
    List<string?>? taxPattern = ["Wk", "SM", "Mo"];
    List<string?>? taxRevision = ["2023-01"];
    List<string?>? sssRevision = ["2025-01"];
    List<string?>? phicRevision = ["2025-01"];

    List<PremcontsourceModel> pcs = new()
    {
        new PremcontsourceModel { Id = 1, Source = "Actual Earnings" },
        new PremcontsourceModel { Id = 2, Source = "Deployment Monthly Rate" }
    };




    bool NotRerender = true;

    protected override async void OnParametersSet()
    {
        if (UserClaims == null) return;
        pisdb = UserClaims.SchemaUserPis;
        paydb = UserClaims.SchemaUserPay;
        conn = UserClaims.Conn;

        if (conn == null) return;
        if (pisdb == null) return;
        if (paydb == null) return;

        if (NotRerender) await LoadSettings();
    }

    async Task LoadSettings()
    {


        Settings = await _settings._02(1, paydb!, conn!);

        imagePreviewUrl = Settings.LogoAddress ?? "";
        NotRerender = false;
        StateHasChanged();
    }

    // ----- File Upload State -----
    private string? imagePreviewUrl = string.Empty;
    private string? errorMessage;
    private byte[] buffer = Array.Empty<byte>();
    private string folderPath = "";
    private string filePath = "";
    private string fileName = "";



    private async Task Save()
    {

        try
        {


            await _settings._03(1, Settings!, paydb!, conn!);

            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "",
                Detail = "Record Saved.",
                Duration = 3000
            });

        }
        catch (Exception ex)
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to save: {ex.Message}",
                Duration = 5000
            });
        }
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // 1 MB limit
        long maxFileSize = 1 * 1024 * 1024;
        if (file.Size > maxFileSize)
        {
            errorMessage = "File is too large. Maximum size is 1 MB.";
            imagePreviewUrl = null;
            return;
        }

        errorMessage = null;
        fileName = file.Name;

        // Read file into memory
        buffer = new byte[file.Size];
        using (var stream = file.OpenReadStream(maxAllowedSize: maxFileSize))
        {
            int totalRead = 0;
            while (totalRead < buffer.Length)
            {
                int read = await stream.ReadAsync(buffer.AsMemory(totalRead, buffer.Length - totalRead));
                if (read == 0) break;
                totalRead += read;
            }
        }

        // Generate Base64 preview
        var base64 = Convert.ToBase64String(buffer);
        imagePreviewUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private async Task UploadImage()
    {
        // Determine user folder
        string uc   = UserClaims.DefCompanyId ?? "-";

        folderPath  = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", uc);
        filePath    = Path.Combine(folderPath, fileName); // path for new upload

        // Relative path for DB
        string relativePath = Path.Combine("/complogo", uc, fileName).Replace("\\", "/");


        if (!Directory.Exists(folderPath))
        {
            Directory.CreateDirectory(folderPath);
        }


        string prefix = "complogo";

        DeleteFileIfExistsByPrefix(folderPath, prefix);

        
        // Save new file
        await File.WriteAllBytesAsync(filePath, buffer);
           
        Settings.LogoAddress = relativePath;



        await _settings._03(1, Settings.LogoAddress!, paydb!, conn!);

        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "",
            Detail = "Logo Saved.",
            Duration = 3000
        });
    }

    void DeleteFileIfExistsByPrefix(string folderPath, string prefix)
    {
        if (!Directory.Exists(folderPath))
            return;

        // Get all files starting with the prefix
        var files = Directory.GetFiles(folderPath, prefix + "*");

        foreach (var file in files)
        {
            File.Delete(file);
        }
    }

    private async Task RemoveImage()
    {
        Settings.LogoAddress = "";
        await _settings._03(1, Settings.LogoAddress!, paydb!, conn!);
        

        _NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "",
            Detail = "Logo Removed.",
            Duration = 3000
        });

        imagePreviewUrl = null;
    }

}

<style>
    .img-hover-overlay {
        opacity: 0;
        transition: opacity .2s ease;
        background: rgba(0,0,0,.45);
    }

    .img-container:hover .img-hover-overlay {
        opacity: 1;
    }

    .remove-btn {
        z-index: 10;
        pointer-events: auto;
    }
</style>
