@{
    Layout              = "~/Applications/_01Register/Pages/_01RegisterLayout.cshtml";
    ViewData["Title"]   = "Create an Account";
}

<div>
    <h2 class="page-title">Create an Account</h2>
    <p class="body-text-lg mt-2">How will you use the system?</p>
</div>

<div class="d-flex flex-wrap gap-3">
    <a href="~/signup/employee" class="reg01-choice">
        <i class="fa-solid fa-id-badge"></i>
        <div class="reg01-choice-title">Register as Employee</div>
        <div class="reg01-choice-desc">Your company already uses the system. You need the company code and your employee number.</div>
    </a>

    <a href="~/signup/owner" class="reg01-choice">
        <i class="fa-solid fa-building"></i>
        <div class="reg01-choice-title">Register as Company Owner</div>
        <div class="reg01-choice-desc">Set up a new company. You will get a company code to share with your employees.</div>
    </a>
</div>

