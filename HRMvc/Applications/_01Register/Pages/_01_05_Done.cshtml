@{
    Layout              = "~/Applications/_01Register/Pages/_01RegisterLayout.cshtml";
    ViewData["Title"]   = "Registration Complete";
    var isOwner         = (ViewData["Purpose"] as string) == "REG-OWNER";
}

<div class="text-center d-flex flex-column align-items-center gap-3">
    <i class="fa-solid fa-circle-check" style="font-size:3.5rem; color:#047959"></i>

    @if (isOwner)
    {
        <h2 class="page-title">Your company is ready</h2>
        <p class="body-text-lg">Your email is verified. You can now log in and share your company code with your employees.</p>
    }
    else
    {
        <h2 class="page-title">Registration submitted</h2>
        <p class="body-text-lg">Your email is verified. Your company will review your registration, and you can log in once it is approved.</p>
    }

    <a href="~/login" class="btn b-btn-primary px-5">Go to Login</a>
</div>
