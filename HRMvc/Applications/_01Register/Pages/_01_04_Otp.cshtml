@model V01RegisterOtp

@{
    Layout              = "~/Applications/_01Register/Pages/_01RegisterLayout.cshtml";
    ViewData["Title"]   = "Verify your Email";
    var email           = ViewData["Email"] as string;
    var devOtp          = TempData["DevOtp"] as string;
    var resent          = TempData["OtpResent"] as string;
}

@*---- Register:ShowOtpOnScreen : the code is shown here until email sending is set up ----*@
@{ var onScreen = !string.IsNullOrEmpty(devOtp); }

<div>
    <h2 class="page-title">Verify your Email</h2>
    @if (onScreen)
    {
        <p class="body-text-lg mt-2">Enter the 6-digit verification code for <b>@email</b> shown below. The code expires in 10 minutes.</p>
    }
    else
    {
        <p class="body-text-lg mt-2">We sent a 6-digit code to <b>@email</b>. The code expires in 10 minutes.</p>
    }
</div>

@if (!string.IsNullOrEmpty(resent))
{
    <div class="reg01-alert reg01-alert-info"><i class="fa-solid fa-envelope-circle-check"></i><span>@(onScreen ? "A new code has been generated." : resent)</span></div>
}
@if (onScreen)
{
    <div class="reg01-alert reg01-alert-dev"><i class="fa-solid fa-key"></i><span>Your verification code: <b>@devOtp</b></span></div>
}

<form id="regOtpForm" action="~/signup/otp" method="post" class="d-flex flex-column gap-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <label asp-for="Code" class="reg01-label reg01-req"></label>
        <input asp-for="Code" class="form-control text-center fs-4" maxlength="6" inputmode="numeric" autocomplete="one-time-code" style="letter-spacing:.4em" />
        <span asp-validation-for="Code" class="err-input-msg text-danger"></span>
    </div>
    <input type="submit" value="Verify" class="btn b-btn-primary w-100" />
</form>

<form action="~/signup/otp/resend" method="post" class="text-center small">
    @Html.AntiForgeryToken()
    Didn't get the code? <button type="submit" class="btn btn-link p-0 reg01-link small align-baseline">Send a new code</button>
</form>

@*---- Loading overlay : creating the company tables takes a while (same as the login overlay) ----*@
<div id="regOtpLoading" class="reg01-loading" aria-live="polite">
    <div class="reg01-loading-box">
        <div class="reg01-loading-rings"><span></span><span></span><span></span><i class="fa-solid fa-building"></i></div>
        <div class="fw-semibold">Setting up your account</div>
        <div class="small text-muted">This may take a minute. Please don't close this page.</div>
    </div>
</div>


@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(function () {
            $('#regOtpForm').on('submit', function () {
                if ($(this).valid()) $('#regOtpLoading').addClass('show');
            });
        });
    </script>
}
