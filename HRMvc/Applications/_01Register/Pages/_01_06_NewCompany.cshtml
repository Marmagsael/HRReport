@model V01NewCompany

@{
    Layout              = "~/Views/Shared/_EPortalLayout.cshtml";
    ViewData["Title"]   = "Create New Company";
    var countries       = ViewData["Country"]  as IEnumerable<HRApiLibrary.Models._00_Main.CountryModel>  ?? [];
    var currencies      = ViewData["Currency"] as IEnumerable<HRApiLibrary.Models._00_Main.CurrencyModel> ?? [];
}

<div class="ms-2 mt-1 vh-95min body-wrapper eng12">
    <div class="mb-3">
        <a href="~/12/003" class="reg01-link small"><i class="fa-solid fa-arrow-left"></i> Back</a>
        <h3 class="m-0 mt-2">Create New Company</h3>
    </div>

    <form id="newCoForm" action="~/company/new" method="post" class="d-flex flex-column gap-2 eng12-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="CompanyCode" class="reg01-label reg01-req"></label>
                <div class="input-group">
                    <input asp-for="CompanyCode" class="form-control text-uppercase" autocomplete="off" />
                    <button type="button" id="newCoCheck" class="btn btn-outline-success">Check</button>
                </div>
                <span asp-validation-for="CompanyCode" class="err-input-msg text-danger"></span>
                <div id="newCoCodeOk" class="small text-success d-none"><i class="fa-solid fa-circle-check"></i> Company code is available</div>
            </div>
            <div class="col-md-7">
                <label asp-for="CompanyName" class="reg01-label reg01-req"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="err-input-msg text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CountryId" class="reg01-label reg01-req"></label>
                <select asp-for="CountryId" class="form-select">
                    <option value="">-- Select --</option>
                    @foreach (var c in countries)
                    {
                        <option value="@c.Id" data-code="@c.Code">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="CountryId" class="err-input-msg text-danger"></span>
                <div id="newCoCountryNa" class="reg01-alert reg01-alert-warn d-none mt-2 py-1">
                    <i class="fa-solid fa-triangle-exclamation"></i><span></span>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="CurrencyId" class="reg01-label reg01-req"></label>
                <select asp-for="CurrencyId" class="form-select">
                    <option value="">-- Select --</option>
                    @foreach (var c in currencies)
                    {
                        <option value="@c.Id">@c.Code - @c.Name</option>
                    }
                </select>
                <span asp-validation-for="CurrencyId" class="err-input-msg text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <input type="submit" id="newCoSubmit" value="Create Company" class="btn b-btn-primary" disabled title="Check the company code first" />
            <a href="~/12/003" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@*---- Loading overlay : creating the company tables takes a while ----*@
<div id="newCoLoading" class="reg01-loading" aria-live="polite">
    <div class="reg01-loading-box">
        <div class="reg01-loading-rings"><span></span><span></span><span></span><i class="fa-solid fa-building"></i></div>
        <div class="fw-semibold">Setting up your company</div>
        <div class="small text-muted">This may take a minute. Please don't close this page.</div>
    </div>
</div>


@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(function () {
            const $code = $('#CompanyCode');
            const $msg  = $('[data-valmsg-for="CompanyCode"]');
            let codeOk      = false;
            let countryNa   = false;

            function showCodeError(text) {
                $msg.text(text || '').toggleClass('field-validation-error', !!text).toggleClass('field-validation-valid', !text);
            }

            // -- Create stays disabled until the code passes the check (and the country is available) --
            function refreshSubmit() {
                $('#newCoSubmit').prop('disabled', !codeOk || countryNa)
                                 .attr('title', codeOk ? '' : 'Check the company code first');
            }

            function setCodeOk(on) {
                codeOk = on;
                $('#newCoCodeOk').toggleClass('d-none', !on);
                refreshSubmit();
            }

            // -- Any change to the code needs a new Check --
            $code.on('input', () => setCodeOk(false));

            // -- Company code available (the save checks it again) --
            $('#newCoCheck').on('click', function () {
                if (!$('#newCoForm').validate().element('#CompanyCode')) return;
                const $btn = $(this).prop('disabled', true);

                $.post('@Url.Content("~/company/new/check")', {
                    __RequestVerificationToken: $('#newCoForm input[name="__RequestVerificationToken"]').val(),
                    companyCode: $code.val()
                })
                .done(r => { showCodeError(r.ok ? '' : r.error); setCodeOk(r.ok); })
                .fail(() => { showCodeError('Unable to check right now. Please try again.'); setCodeOk(false); })
                .always(() => $btn.prop('disabled', false));
            });

            // -- Only the Philippines is available for now --
            $('#CountryId').on('change', function () {
                const $opt  = $(this).find(':selected');
                const na    = !!$opt.val() && $opt.data('code') !== 'PHL';
                $('#newCoCountryNa').toggleClass('d-none', !na)
                    .find('span').text(na ? $opt.text() + ' is not available yet. Only the Philippines is supported for now.' : '');
                countryNa = na;
                refreshSubmit();
            });

            $('#newCoForm').on('submit', function () {
                if ($(this).valid()) $('#newCoLoading').addClass('show');
            });
        });
    </script>
}
