<div class="d-flex gap-2 w-100 mt-3">
     <div class="card w-100 p-0 ">
          <div class="card-header d-flex gap-2 w-100 p-0 py-2 fw-bold text-center">
               <div class="w-100p p-2 bordered-right ">Year</div>
               <div class="w-100p p-2 bordered-right ">Month</div>
               <div class="w-100p p-2 bordered-right ">Period</div>
               <div class="w-150p p-2 bordered-right">Amount</div>
               
          </div>

          <div class="card-body p-0">
               @{ 
                    int? i = 0; var ts = Tbltrans??[]; 
                    double total = 0;
                }
                <div class="vh-max vh55" >
                @foreach(var t in ts){
                    var rowClass = i++ % 2 == 0 ? "" : "bg-lightgray";
                    total += ((double?)t.Amount)??0;
                    
                    <div class="d-flex gap-2 w-100  @rowClass p-0">
                         <div class="w-100p p-2 bordered-right text-center"> @($"20{t.Trn?.Substring(0,2) ?? ""}") </div>
                         <div class="w-100p p-2 bordered-right text-center"> @t.Trn.Substring(2,2) </div>
                         <div class="w-100p p-2 bordered-right text-center"> @t.Trn.Substring(4,2) </div>
                         <div class="w-150p p-2 bordered-right text-end px-3">@t.Amount.ToString("N2")</div>
                    </div>
               } 
               </div >

               <div class="d-flex gap-2 w-100  p-0 bg-lightgray bordered-top">
                    <div class="w-100p p-2  text-center"> &nbsp;  </div>
                    <div class="w-100p p-2  text-center">  </div>
                    <div class="w-100p p-2 bordered-right text-center fw-bold"> Total </div>
                    <div class="w-150p p-2 bordered-right text-end px-3">@total.ToString("N2")</div>
               </div>

          </div>
          

     </div>

</div>

@code {

    [Parameter] public List<GTbltranModel>  Tbltrans  { get; set; } = []; 

}
