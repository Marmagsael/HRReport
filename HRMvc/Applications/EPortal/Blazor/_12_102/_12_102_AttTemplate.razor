@using HRApiLibrary.Models._10_Pis
<div class="card">
    <_12_102_Cardhdr caption="My Schedule Template" /> 
    
    <div class="card-body p-0">
        <div class="d-flex fw-bold py-2 txt-gray-30">
            <div class="w-60 text-center bordered-right">Day/Type</div>
            <div class="w-20 text-center bordered-right">IN</div>
            <div class="w-20 text-center">OUT</div>
        </div>
        
        <div class="card-body p-0 ">
        
            <_12_102_01_AT_Component
                DayName="Monday"
                DutyType="@AttTemplate?.D2_dutytype"
                Duration="@AttTemplate?.D2_hrslength"
                In="@AttTemplate?.D2_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Tuesday"
                DutyType="@AttTemplate?.D3_dutytype"
                Duration="@AttTemplate?.D3_hrslength"
                In="@AttTemplate?.D3_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Wednesday"
                DutyType="@AttTemplate?.D4_dutytype"
                Duration="@AttTemplate?.D4_hrslength"
                In="@AttTemplate?.D4_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Thursday"
                DutyType="@AttTemplate?.D5_dutytype"
                Duration="@AttTemplate?.D5_hrslength"
                In="@AttTemplate?.D5_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Friday"
                DutyType="@AttTemplate?.D6_dutytype"
                Duration="@AttTemplate?.D6_hrslength"
                In="@AttTemplate?.D6_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Saturday"
                DutyType="@AttTemplate?.D7_dutytype"
                Duration="@AttTemplate?.D7_hrslength"
                In="@AttTemplate?.D7_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

            <_12_102_01_AT_Component
                DayName="Sunday"
                DutyType="@AttTemplate?.D1_dutytype"
                Duration="@AttTemplate?.D1_hrslength"
                In="@AttTemplate?.D1_in"
                AttType="@AttTemplate?.AttendancetypeId"/>

        </div>


    </div>

        


</div>

@code {

    [Parameter] public AtttemplateModel AttTemplate { get; set; } = new(); 

}
