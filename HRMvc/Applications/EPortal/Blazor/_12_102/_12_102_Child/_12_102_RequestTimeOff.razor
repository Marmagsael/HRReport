</CascadingValue>
</CascadingValue>



@inject ILeavetypeDataAccess            _lvtype; 
@inject IAtttemplateDataAccess          _attTemplate; 
@inject ILeavegrpapproverDataAccess     _lvgrpApprover; 
@inject ILeaveapplicationDataAccess     _lvApplication; 
@inject ILeaveapplicationdtlDataAccess  _lvaDtls; 
@inject ISettingsDataAccess             _settings; 
@inject IEmpmasInternalDataAccess       _empmasInternal; 
@inject I_10_EmpmasDataAccess           _empmas; 
@inject ILeavedaytypeDataAccess         _lvdaytype;



@inject ILeaveapplicationdtlDataAccess  _lvApplicationdtl; 

@code {
    [Parameter] public UserClaimsModel Uc { get; set; }
    V12_102Lv   v = new();
    V00_RepVars rv = new(); 
    int? ctr = 0; 
    bool isLoading = false;

    void MarkPayable() {
        int ctr = 1; 
        foreach(var d in v.LeaveApplicationdtls) {
            
            if(d.DutyType == "R" && ctr <= lva.LvBalance) { 
                ctr++;
                d.IsPayableB = true; 
            }
        }
    }

    @* =================================================== *@
    async Task ChildActionCatcher() {
        if(v.Action=="LoadLvApplication") await LoadLvApplication(); 
        v.Action = string.Empty; 
    }

    async Task LoadLvApplication() {
        v.LeaveApplicationdtl = new();
        v.LeaveApplicationdtls = [];

        await Populatedtls();
        await _02LeaveBalance();
        StateHasChanged();
    }

    async Task New() { 
       
        v.LeaveApplication      = new(); 
        v.LeaveApplicationdtl   = new(); 
        v.LeaveApplicationdtls  = []; 

        await Populatedtls(); 
        await _02LeaveBalance(); 
        StateHasChanged(); 

    }

    @* --- Save button: same Save(), plus a notification of the result --- *@
    async Task SaveClick()
    {
        try {
            if (!await Save()) return;
            _NotificationService.Notify(new NotificationMessage {
                Severity = NotificationSeverity.Success,
                Summary  = "Saved",
                Detail   = "Leave application has been saved.",
                Duration = 4000
            });
        }
        catch (Exception ex) {
            _NotificationService.Notify(new NotificationMessage {
                Severity = NotificationSeverity.Error,
                Summary  = "Save Failed",
                Detail   = ex.Message,
                Duration = 6000
            });
        }
    }

    async Task<bool> Save()
    {

        @* --- Check for Overlapping Leave Applications --- *@
        var resOverlapping = await _lvApplication._02Overlapping(Uc.EmpmasId, v.LeaveApplication.Id, v.LeaveApplication.LvStart, v.LeaveApplication.LvEnd, Uc.SchemaUserPis, Uc.Conn);
        if(resOverlapping!=null && resOverlapping.Any()) {
            await _DialogService.Alert(
            @"The leave application could not be saved because the selected dates overlap with an existing leave application. 
                        Please review your current leave applications and modify the dates to avoid any overlap.",
                "Overlapping Leave Application",    new AlertOptions() { OkButtonText = "OK" });
            return false;
        }
        @* =================================================================================== *@


        var lvapp = v.LeaveApplication;
        lvapp.Status      = "S";
        lvapp.EmpmasId    = Uc.EmpmasId;
        lvapp.DaysWithPay = lvWPay;

        /*--- Insert -----------------------------------------------------*/
        if (lva.Id == 0)
        {
            var res = await _lvApplication._01(lva, Uc.SchemaUserPis, Uc.Conn);
            lvapp.Id = res.Id ?? 0; 
        }
        
        /*--- Update -----------------------------------------------------*/
        if (lva.Id > 0)
        {
            await _lvApplication._03(lva.Id, lva, Uc.SchemaUserPis, Uc.Conn);
            await _lvaDtls._04OutRange(lva.Id,lva.LvStart.Date, lva.LvEnd.Date, Uc.SchemaUserPis, Uc.Conn); 
        }
        
        foreach(var d in v.LeaveApplicationdtls) {
            d.LeaveApplicationId    = lva.Id; 
            d.EmpmasId              = Uc.EmpmasId; 
            d.EmpNumber             = Uc.OempNumber??"";
            d.DutyType              = " ";

            if(d.Id == 0)   { await _lvaDtls._01(d, Uc.SchemaUserPis, Uc.Conn);  } 
            else            { await _lvaDtls._03(d.Id??0, d, Uc.SchemaUserPis, Uc.Conn); }; 
        }
        
        var resd = await _lvaDtls._02ByLvApplicationId(lva.Id, Uc.SchemaUserPis, Uc.Conn); 
        if(resd!=null) v.LeaveApplicationdtls = resd!;

        return true;
    }

    async Task ShowSendForApproval() { 
        @* v.ShowSendForApproval   = true;  *@

        var option = await _DialogService.Confirm("Send Request for Approval?", "Send for Approval",
                    new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (option == true)
        {
            await Save(); 
            var res = await _lvApplication._03SendForApproval(v.LeaveApplication,Uc.SchemaUserPis, Uc.Conn); 
            v.LeaveApplication.Status = res.Status??"";
        }

        await _lvApplication._03(1,v.LeaveApplication,Uc.SchemaUserPis, Uc.Conn); 
    }

    async Task ShowCancel() {
        var option = await _DialogService.Confirm("Cancel current Leave Application and delete details?", "Cancel Leave Application",
                    new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (option == true)
        {
            @* await _lvApplication._04(lva.Id, Uc.SchemaUserPis, Uc.Conn);  *@
            await New(); 
        }
    }
    async Task ShowMyRequest() 
    { 
        v.ShowMyReqquest = true; 

        v.IsLoading = true;
        var res = await _lvApplication._02ByRequest(Uc.EmpmasId,Uc.SchemaUserPis, Uc.Conn); 
        v.IsLoading = false;
        
        if(res!=null) v.LeaveApplications = res!; 


    }
    @* --- Print : Reports/_02HR/K_12_102_LF.trdp ( Personnel + Employee copy ), shown in a maximized modal like OB --- *@
    async Task Print()
    {
        var co          = await _settings._02(1, Uc.SchemaUserPay, Uc.Conn);
        var emp         = await _empmasInternal._02(Uc.EmpmasId, Uc.SchemaUserPis, Uc.Conn);
        var deprec      = (await _empmas._02Deprecs(Uc.EmpmasId, Uc.SchemaUserPis, Uc.Conn))?.FirstOrDefault();

        double daysCnt  = v.LeaveApplicationdtls.Count;
        double withPay  = lva.DaysWithPay > 0 ? lva.DaysWithPay : lvWPay;

        ctr++;
        rv.RelativePath = "Reports/_02HR/K_12_102_LF.trdp";
        rv.MCaption     = "Leave Application";
        rv.ReportData   = new List<object> { lva };       // one form ( the report has no detail fields )

        rv.ReportParams = new() {
            ["CoName"]          = co?.CoFullName ?? "-",
            ["CoAddress"]       = co?.CoAddress ?? "-",
            ["ReportTitle"]     = "Leave Application",
            ["RunDate"]         = DateTime.Now,
            ["DateFiled"]       = lva.DateApplied.ToString("MMM dd, yyyy"),
            ["Position"]        = deprec?.Positionname ?? "-",
            ["Department"]      = deprec?.Depname ?? "-",
            ["EmpNumber"]       = emp?.EmpNumber ?? Uc.OempNumber ?? "-",
            ["EmpName"]         = emp?.Fullname ?? "-",
            ["TypeOfLeave"]     = _02LvTypeName(lva.LeaveTypeId),
            ["DaysCount"]       = daysCnt.ToString("N2"),
            ["LvTime"]          = lva.LvTime ?? "",
            ["DateFrom"]        = lva.LvStart.ToString("MMM dd, yyyy"),
            ["DateTo"]          = lva.LvEnd.ToString("MMM dd, yyyy"),
            ["Reason"]          = lva.Reason ?? "",
            ["AddressContact"]  = string.Join(" / ", new[] { lva.Address, lva.TelNo }.Where(t => !string.IsNullOrWhiteSpace(t))),
            ["LvBalance"]       = lva.LvBalance.ToString("N2"),
            ["DaysWithPay"]     = withPay.ToString("N2"),
            ["Payment"]         = withPay > 0 ? $"With Pay ({withPay:N2} day/s)" : "Without Pay",
        };

        rv.RefreshToken = 12102000 + ctr;
        v.ShowPrint     = true;
    }

    AtttemplateModel at => v.AttTemplate;
    LeaveapplicationModel lva => v.LeaveApplication;

    string center_xy => "d-flex justify-content-center align-items-center";
    bool IsCanSave => lva != null
               && lva.Status is "N" or "S"
               && (v.LeaveApplicationdtls.Count > 0)
               && (lva.LeaveTypeId) > 0
               && lva.LvEnd >= lva.LvStart
               && !string.IsNullOrWhiteSpace(lva.Address)
               && !string.IsNullOrWhiteSpace(lva.Reason)
               && !string.IsNullOrWhiteSpace(lva.TelNo) ;

    bool IsCanSend  =>  lva != null
                        && lva.Status is "S"
                        && (lva.LeaveTypeId) > 0
                        && lva.LvEnd >= lva.LvStart
                        && !string.IsNullOrWhiteSpace(lva.Address)
                        && !string.IsNullOrWhiteSpace(lva.Reason)
                        && !string.IsNullOrWhiteSpace(lva.TelNo) 
                        && lva.Approver2Id > 0;

    bool IsCanCancel    => lva != null
                        && lva.Status is "S"; 

    bool IsCanPrint     => lva != null
                            && (lva.Status is "S" or "FA" or "F"); 
                            
    bool IsLocked     =>  lva != null
                            && (lva.Status is "N" or "S"); 


    string? CanSaveCss =>    IsCanSave ? "" : " disabled-div ";
    string? CanSendCss =>    IsCanSend ? "" : " disabled-div ";
    string? CanCancelCss =>  IsCanCancel ? "" : " disabled-div ";
    string? CanPrintCss =>  IsCanPrint ? "" : " disabled-div ";
    string? DivLocked =>  IsLocked ? "" : " disabled-div-75 ";
    
    @* =================================================== *@
    async Task _02LeaveBalance() {
        var res = await _lvApplication
                    ._02LvBalance(v.LeaveApplication.LeaveTypeId, 
                                  Uc.UserId, 
                                  v.LeaveApplication.Yr, Uc.SchemaUserPis, Uc.Conn); 
        v.LeaveApplication.LvBalance = res; 

    }

    async Task Populatedtls()
    {
        v.LeaveApplicationdtls = [];
        
        if (v.LeaveApplication.LvStart.Date > v.LeaveApplication.LvEnd.Date) return;
        var leaveApp = v.LeaveApplication;
		for (DateTime date = leaveApp.LvStart; date < leaveApp.LvEnd.AddDays(1); date = date.AddDays(1))
        {
			string?                      ddd    = date.ToString("ddd");
            LeaveapplicationdtlModel?   dtl     = _02LA(ddd);
			dtl.Date                            = date;
            dtl.LeaveDayTypeId                  = 1;
            @* if (dtl.DutyType == "R") dtl.IsPayableB = true; *@
            v.LeaveApplicationdtls.Add(dtl);
        }

        @* --- Populate details from existing records --------------------------------- *@
        int? lvaId = lva.Id??0; 
        if(lvaId>0) {
            isLoading = true;
            var res = await _lvaDtls._02ByLvApplicationId(lva.Id, Uc.SchemaUserPis, Uc.Conn); 
            isLoading = false;

            res.ForEach(r =>{
                v.LeaveApplicationdtls.ForEach(d => {
                    if(d.Date == r.Date) {
                        d.Id                    = r.Id; 
                        d.LeaveApplicationId    = r.LeaveApplicationId; 
                        d.LeaveDayTypeId        = r.LeaveDayTypeId; 
                        d.IsPayableB            = r.IsPayableB; 
                    }
                });
            }); 
        }

        @* --- Days Count -------------------------------- *@
        if(lva.LvEnd.Date < lva.LvStart.Date) { v.LeaveApplication.DaysCnt = 0; }
        else { v.LeaveApplication.DaysCnt = (lva.LvEnd - lva.LvStart).TotalDays + 1;  }
    }

    void ComputeEnd(LeaveapplicationdtlModel ld) {
        

    }
    
    protected override async Task OnParametersSetAsync()
    {
        
        if (Uc == null) return;
        await LoadDatas(); 
        await _02LeaveBalance();
        await Populatedtls(); 
        
    }

    async Task LoadDatas() {
        
        if(!v.LeaveTypes.Any())  {
            var res  = await _lvtype._02(Uc.SchemaUserPis, Uc.Conn) ?? [];
            if (res != null && res.Any()) v.LeaveTypes = res!; 

            v.Hrs       = MsdsDataAccess._02Hours() ; 
            v.Durations  = MsdsDataAccess._02HourDurations(); 
            v.AttTemplate = await _attTemplate._02(Uc.UserId, Uc.SchemaUserPis, Uc.Conn); 

            v.LvYrs = []; 
            v.LvYrs.Add(DateTime.Now.Year); 
            v.LvYrs.Add(DateTime.Now.Year-1); 
        }

        var resApprovers = await _lvgrpApprover._02ByEmpmasId(Uc.EmpmasId, Uc.SchemaUserPis, Uc.Conn);
        var firstApprovers = (resApprovers.Where(a=> a.ApproverLevel==1).ToList()) ??[];
        v.LvFirstApprovers = firstApprovers!;
        v.LvFirstApprovers.Insert(0, new(){ApproverId=0, ApproverName="No Assigned Approver"});

        
        var finalApprovers = (resApprovers.Where(a=> a.ApproverLevel==2).ToList()) ??[];
        v.LvFinalApprovers = finalApprovers!; 
        v.LvFinalApprovers.Insert(0, new() { ApproverId = 0, ApproverName = "No Assigned Approver" });

        v.LeaveDayTypes = [];
        var resLvDayTypes = await _lvdaytype._02(Uc.SchemaUserPis, Uc.Conn);
        if(resLvDayTypes!=null && resLvDayTypes.Any()) v.LeaveDayTypes = resLvDayTypes!;




    }

    private async Task MarkPayable(ChangeEventArgs e, LeaveapplicationdtlModel l)
    {
        var val = (bool)(e.Value??false); 
        l.IsPayableB = val;

        @* var cHrs = (decimal?)((decimal?)(l.TimeDuration)/100); 
        if(val) { l.CreditedHrs = (cHrs>=5 ? cHrs -1 : cHrs)??0 ; }
        else l.CreditedHrs = 0;  *@
        
    }

    string? _02DutyType(string? ddd) => ddd switch {
        "Mon" => v?.AttTemplate?.D2_dutytype??"",
        "Tue" => v?.AttTemplate?.D3_dutytype??"",
        "Wed" => v?.AttTemplate?.D4_dutytype??"",
        "Thu" => v?.AttTemplate?.D5_dutytype??"",
        "Fri" => v?.AttTemplate?.D6_dutytype??"",
        "Sat" => v?.AttTemplate?.D7_dutytype??"",
        "Sun" => v?.AttTemplate?.D1_dutytype??"",
        _ => "Unknown"
    };

    string? DTypeCss(string? ddd) => _02DutyType(ddd) == "RD" ? " text-danger " : "";

    double lvWPay => v.LeaveApplicationdtls 
                        .Where(l => l.IsPayableB)
                        .Sum(l => l.LeaveDayTypeId == 1  ? 1 : .5 ); 

    LeaveapplicationdtlModel _02LA(string? ddd) => ddd switch
    {
        "Mon" => new LeaveapplicationdtlModel { DutyType = at?.D2_dutytype},
        "Tue" => new LeaveapplicationdtlModel { DutyType = at?.D3_dutytype},
        "Wed" => new LeaveapplicationdtlModel { DutyType = at?.D4_dutytype},
        "Thu" => new LeaveapplicationdtlModel { DutyType = at?.D5_dutytype},
        "Fri" => new LeaveapplicationdtlModel { DutyType = at?.D6_dutytype},
        "Sat" => new LeaveapplicationdtlModel { DutyType = at?.D7_dutytype},
        "Sun" => new LeaveapplicationdtlModel { DutyType = at?.D1_dutytype},
        _ => new LeaveapplicationdtlModel() 
    };
    
    string? _02LvTypeName(int? lvTypeId)  => (v?.LeaveTypes.FirstOrDefault(l=>l.Id == lvTypeId).LeaveName)??"-";
    string? _02LvStatus(string? code)     => code switch { "N" => "New", "S" => "Save", "F" => "For Approval", "C" => "Cancelled", "A" => "Approved", _ => "Unknown" };

    
}
