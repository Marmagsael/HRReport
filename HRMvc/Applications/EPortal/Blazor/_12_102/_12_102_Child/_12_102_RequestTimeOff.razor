                                <div class="w-50p p-2 d-flex align-items-center">End<span class="txt-red">*</span></div>
                                <div class="w-150p ">
                                    <RadzenDatePicker 
                                        @bind-Value="v.LeaveApplication.LvEnd" 
                                        Change="Populatedtls"
                                        DateFormat="MM/dd/yyyy"
                                        AllowInput="false"
                                        class="mb-date-accent w-150p" />
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>

                @* --- Address ------------------------------------ *@
                <tr>
                    <td class="w-150p">Address<spa class="txt-red">*</spa> </td>
                    <td class="p-1">
                        <RadzenTextArea @bind-Value="v.LeaveApplication.Address" MaxLength="150" Rows="2" Style="width:100%;" /> 
                    </td>
                </tr>
                
                @* --- Telephone Number ------------------------------------ *@
                <tr>
                    <td class="w-150p ">Contact # <spa class="txt-red">*</spa></td>
                    <td class="p-1">
                        <RadzenTextBox 
                            @bind-Value="@v.LeaveApplication.TelNo"
                            MaxLength="45" 
                            Style="width:250px;" /> 
                            
                    </td>
                </tr>
                
                @* --- Reason ------------------------------------ *@
                <tr>
                    <td class="w-150p">Reason <spa class="txt-red">*</spa></td>
                    <td class="p-1">
                        <RadzenTextArea @bind-Value="v.LeaveApplication.Reason" MaxLength="150" Rows="2" Style="width:100%;" /> 
                    </td>
                </tr>

                <tr>
                    <td>Approvers</td>
                    <td class="p-0">
                        <div class="w-100 d-flex ">
                            @* --- First Approver *@
                            <div class="w-50 p-1">
                                <div>
                                    <RadzenDropDown Data="@v.LvFirstApprovers" 
                                        TextProperty="ApproverName"
                                        ValueProperty="ApproverId" 
                                        @bind-Value="v.LeaveApplication.Approver1Id" 
                                        Placeholder="First Approver" 
                                        Style="width:100%"
                                        PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;" >
                                        
                                        <Template Context="item">
                                            <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                                @item.ApproverName
                                            </div>
                                        </Template>


                                    </RadzenDropDown>
                                </div>
                                <div class="text-center">
                                    Approver
                                </div>
                            </div>
                            
                            @* --- Second Approver *@
                            <div class="w-50 p-1">
                                <div>
                                    <RadzenDropDown Data="@v.LvFinalApprovers" 
                                        TextProperty="ApproverName"
                                        ValueProperty="ApproverId" 
                                        @bind-Value="v.LeaveApplication.Approver2Id" 
                                        Placeholder="Final Approver" 
                                        Style="width:100%"
                                        PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;">
                                        
                                        <Template Context="item">
                                            <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                                @item.ApproverName
                                            </div>
                                        </Template>
                                        
                                    </RadzenDropDown>
                                </div>
                                <div class="text-center">
                                    Final Approver <span class="text-danger">*</span>
                                </div>
                            </div>



                        </div>
                    </td>
                    
                </tr>



                @* --- Parameters ------------------------------------------- *@
                <tr>
                    <td>Parameter</td>
                    <td>
                    <div class="d-flex gap-2">
                            
                            @* --- Leave Balance --------- *@
                            <div class="text-primary">Leave Balance : </div>
                            <div class="text-center">
                                @lva.LvBalance.ToString("N2")
                            </div>
                            @* --- Available Credit --------- *@
                            <div class="text-primary">Days Count : </div>
                            <div class="text-center">
                                @(v.LeaveApplicationdtls.Count)
                                @* @lva.DaysCnt.ToString("N2") *@
                            </div>
                            @* --- Leave with Pay *@
                            <div class="text-primary">With Pay : </div>
                            <div class="text-center">
                                @lvWPay.ToString("N2")  
                            </div>


                    </div> 
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    @* --- Leave Details ----------------------------------------- *@
    <div class="@DivLocked ">
        <div class="card-header bg mb-a-green fw-bold  ">Leave Details</div>
        @if(v.LeaveApplicationdtls.Count > 5 && v.LeaveApplication.Status is not "F" and not "A")
        {
            <div class="card-header bg mb-a-green   ">
                <div @onclick="MarkPayable" class="p-1 mb-cbtn mb-cbtn-gray card w-200p ">Mark Regular Day Payable </div>
            </div>
        }
        

        <div class="card-body p-0">



                <div class="w-100 d-flex gap-1 py-2 border-bottom">
                    <div class="w-75p text-center bg-dgray ">Entry #</div>
                    <div class="w-130p text-center ">Date</div>
                    <div class="w-75p text-center text-primary "> Day </div>
                    <div class="w-75p text-center text-primary "> Duty Type </div>
                    <div class="w-150p text-center">Credited Hrs.</div>
                    <div class="w-100p text-center">Payable</div>
                </div>

                

                @foreach (LeaveapplicationdtlModel lvd in v.LeaveApplicationdtls)
                {
                    string? dtype    = _02DutyType(@lvd.Date?.ToString("ddd")); 
                    string? dTypeCss = dtype=="RD" ? " text-danger disabled-div-50 " : ""; 

                    <div class="w-100 d-flex p-0 mt-1 gap-1 ">
                        <div class="w-75p  bg-dgray @center_xy ">@(lvd.Id==0 ? "-" : lvd.Id.ToString())</div>
                        <div class="w-130p @center_xy ">@lvd.Date?.ToString("MMM dd, yyyy")</div>
                        <div class="w-75p d-flex @center_xy ">  @lvd.Date?.ToString("ddd") </div>
                        <div class="w-75p d-flex @center_xy" ">  @dtype </div>
                        <div class="w-155p text-center">
                            <RadzenDropDown 
