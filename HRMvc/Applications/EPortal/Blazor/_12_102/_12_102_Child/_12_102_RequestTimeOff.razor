<CascadingValue Value="Uc" IsFixed="true">
<CascadingValue Value="v">
    
        <div class="d-flex gap-1 p-1 border-bottom ">
            <div @onclick="New" class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
            <div @onclick="SaveClick" class="p-1 mb-cbtn mb-cbtn-blue card w-75p @(CanSaveCss) "> Save </div>
            <div @onclick="ShowSendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @(CanSendCss) "> 
                Send For Approval 
            </div>
            <div @onclick="ShowCancel" class="p-1 mb-cbtn mb-cbtn-red card w-100p @(CanCancelCss)"> Cancel </div>
            <div @onclick="ShowMyRequest" class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
            <div @onclick="Print" class="p-1 mb-cbtn mb-cbtn-blue card w-80p @CanPrintCss "> Print </div>
        </div>
        
    <_12_102_Lv_Modal ChildAction="ChildActionCatcher" Uc="@Uc" V="@v" Rv="@rv" />

    @* <div>Count : @v.LeaveApplicationdtls.Count * @Uc.UserId </div> *@
    
    <div class="card-body p-0 @DivLocked ">
        <table class="table table-small table-bordered">
            <tbody>
                <tr>
