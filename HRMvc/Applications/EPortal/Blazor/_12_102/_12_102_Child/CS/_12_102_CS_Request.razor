@using HRApiLibrary.DataAccess._10_Pis
@using HRApiLibrary.Models._10_Pis
<div class="d-flex p-1 fw-bold card-header small  ">
    <div class="w-120p ">Date Requested</div>
        <div class="w-120p ">Effectivity</div>
        <div class="w-220p ">Approver </div>
        <div class="w-120p ">Status</div>
        <div class="w-220p ">Remarks</div>
    </div>

@{int i = 0; }
@foreach(AtttemplatereqhdrModel h in hdrs) {
    i++; 
    var rowClass = (i % 2 == 0) ? "bg-light" : "";
    <div @onclick="()=>PickData(h)"  class="d-flex p-1 small cur-pointer @rowClass text-start @(h.Id == hdrId ? " fw-bold " : "") ">
        <div class="w-120p ">@h.DateRequested?.ToString("MMM dd, yyyy")</div>
        <div class="w-120p ">@h.Effectivity?.ToString("MMM dd, yyyy")</div>
        <div class="w-220p ">@h.ApproverName</div>
        <div class="w-120p ">@h.Status</div>
        <div class="w-220p ">@h.Remarks</div>
    </div>
}


@if(hdrId<1) { return; } 

<div class="w-100 p-2 border-bottom mt-4">
    <div @onclick="LoadRequest" class="mb-cbtn mb-cbtn-gray p-1 card w-125p">
        Load Data
    </div>
</div>

