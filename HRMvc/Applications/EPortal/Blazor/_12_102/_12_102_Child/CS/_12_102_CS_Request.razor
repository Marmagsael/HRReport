@inject     IAtttemplatereqdtlDataAccess _dtl ;  



@code {
    [Parameter] public UserClaimsModel  Uc      { get; set; } = new(); 
    [Parameter] public V12_102CS        Cs      { get; set; } = new(); 
    [Parameter] public EventCallback    Ec      { get; set; } 
    AtttemplatereqhdrModel hdrSelected = new();


    List<AtttemplatereqhdrModel?> hdrs => Cs.Atttemplatereqhdrs;  
    AtttemplatereqdtlModel dtl = new(); 
    int? hdrId = 0; 
    

    async Task PickData(AtttemplatereqhdrModel hdr) {
        hdrId       = hdr?.Id??0; 
        hdrSelected = hdr; 

        Cs.Atttemplatereqhdr    = hdr ; 
        dtl    = new AtttemplatereqdtlModel() ; 

        var res = await _dtl._02ByAtttemplateReqHdrId(hdr.Id??0, Uc.SchemaUserPis, Uc.Conn); 
        if(res!=null) dtl = res.FirstOrDefault();     
    }

    async Task LoadRequest() {
        Cs.Atttemplatereqhdr    = hdrSelected; 
        Cs.Atttemplatereqdtl    = dtl??new(); 
        Cs.ShowMyReqquest       = false; 
        await Ec.InvokeAsync(); 


    }




    string? dutyTypeCss(string? dt) => dt=="RD" ? " text-danger " : "" ;
    string? outRes(string? dutyType, int? pin, int? duration) => outSched(dutyType, pin, duration);

    string? outSched(string? dutyType, int? pin, int? duration)
    {
        if(dutyType==null)  return "-"; 
        if(pin==null)       return "-"; 

        int? punchin      = pin ?? 0;
        double duration1 = (duration ?? 0) / 100.0;

        int? hr  = punchin / 100;
        int? min = punchin % 100;

        DateTime dt = new DateTime(2000, 1, 1, hr??0, min??0, 0);

        dt = dt.AddHours(duration1);

        return dt.ToString("h:mm tt");
    }
    
}