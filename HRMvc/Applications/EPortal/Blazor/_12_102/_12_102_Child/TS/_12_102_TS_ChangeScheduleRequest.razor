    // --- Approved By : partial / final approvals from history ; current approver as Pending while For Approval
    async Task<string> ApprovedByText()
    {
        var hist  = await _attTemplateReqhdr._02ApprovalsByHdrId(Hdr.Id, Uc?.SchemaUserPis, Uc?.OpisDb, Uc?.Conn) ?? [];
        var lines = hist.Where(h => h != null)
                        .Select(h => $"{Name(h!.ApproverName, h.Empnumber_Approver)}  -  " +
                                     $"{(h.SetStatusTo == "A" || h.Remarks == "Aproved" ? "Approved" : "Partially Approved")}  -  " +
                                     $"{h.DActionTaken:MMM dd, yyyy}")
                        .ToList();

        if (Hdr.Status is "F" or "FA")
            lines.Add($"{Name(Hdr.ApproverName, Hdr.EmpNumber_Approver)}  -  Pending");

        return lines.Count == 0 ? "-" : string.Join(Environment.NewLine, lines.Select((l, i) => $"{i + 1}.  {l}"));

        static string Name(string? name, string? empNumber) => string.IsNullOrWhiteSpace(name) ? (empNumber ?? "-") : name.Trim();
    }

    CsPrintRow PrintRow(string day, string? cDt, int? cIn, int? cLen, string? rDt, int? rIn, int? rLen) => new(
        day,
        string.IsNullOrEmpty(cDt) ? "-" : cDt,
        IsWorkDay(cDt) ? outSched(cDt, cIn, 0) ?? "-" : "-",
        IsWorkDay(cDt) ? ((cLen ?? 0) / 100.00).ToString("0.#") + " H" : "-",
        string.IsNullOrEmpty(rDt) ? "-" : rDt,
        IsWorkDay(rDt) ? outSched(rDt, rIn, 0) ?? "-" : "-",
        IsWorkDay(rDt) ? ((rLen ?? 0) / 100.00).ToString("0.#") + " H" : "-",
        IsWorkDay(rDt) ? outSched(rDt, rIn, rLen) ?? "-" : "-");

