<div class="d-flex gap-1 p-1 border-bottom ">
    <div @onclick="New"                 class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
    <div @onclick="Save"                class="p-1 mb-cbtn mb-cbtn-blue card w-75p @CanSave1 "> Save  </div>
    <div @onclick="ShowSendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @CanSend "> Send For Approval </div>
    <div @onclick="ShowCancel"          class="p-1 mb-cbtn mb-cbtn-red card w-100p  @CanCancel "> Cancel </div>
    <div @onclick="ShowMyRequest"       class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
    <div @onclick="Print"               class="p-1 mb-cbtn mb-cbtn-blue card w-80p @(CanPrint ? "" : " disabled-div ") "> Print </div>
</div>

@* --- Print : Reports/_02HR/ChangeSchedule.trdp ( same flow as OB ) --- *@
@if(showPrint)
{
    <_00Modal ModuleCaption="Change Schedule Request" Maximized="true" ChildAction="@(() => showPrint = false)">
        <Content>
            <_ReportRenderer DataSource         ="@rv.ReportData"
                             ReportRelativePath ="@rv.RelativePath"
                             OutputFormat       ="@rv.SelectedFormat"
                             Parameters         ="@rv.ReportParams"
                             AutoGenerate       ="@(rv.ReportData?.Any() == true)"
                             RefreshToken       ="@rv.RefreshToken" />
        </Content>
    </_00Modal>
}


<_12_102_ChangeSchedule Cs="@Cs" Uc="@Uc" Ec="@EcCatcher" />

@* --- Returned by the approver : show the reason --- *@
@if(Hdr.Status == "R" && !string.IsNullOrWhiteSpace(Hdr.ApprRemarks))
{
    <div class="p-2 border-bottom small bg-danger bg-opacity-10">
        <span class="fw-bold text-danger">Returned by approver : </span> @Hdr.ApprRemarks
    </div>
}

<div class="card mt-1">
    <div class="p-2 border-bottom">
        <div class="p-0 d-flex justify-content-between ">
            <div class="d-flex p-1">
                <div class="w-120p p-2">Control No.</div>
                <div class="w-175p border-bottom fw-bold text-center p-2 text-primary "> 
                    @(Hdr.Id < 1 ? "-" : Hdr.Id) 
                </div>
            </div>
            
            <div class="d-flex p-1">
                <div class="w-75p p-2">Status</div>
                <div class="w-175p   text-start p-2 text-primary "> 
                    @(Hdr.Status switch {"N" => "New", "S" => "Saved", "F" => "For Approval", "A" => "Approved", "R" => "Returned", _ => "Unknown" } )
                </div>
            </div>
        </div>
        
        <div class="mb-a-blue d-flex ">
            <div class="w-120p p-2">Date</div>
            <RadzenDatePicker @bind-Value="Hdr.DateRequested" 
                @ref="dateRequestedPicker"
                Disabled="@IsLocked"
                DateFormat="MM/dd/yyyy"
                AllowInput="false"
                class="mb-date-accent w-150p" />
        </div>

        <div class="mb-a-blue d-flex mt-1">
            <div class="w-120p p-2">Effectivity * </div>
            <div class="  ">
                <RadzenDatePicker 
                    @bind-Value="Hdr.Effectivity" 
                    Disabled="@IsLocked"
                    DateRender="@(args => { if (args.Date.Date < MinEffectivity) args.Disabled = true; })"
                    DateFormat="MM/dd/yyyy"
                    AllowInput="false"
                    class="mb-date-accent w-150p" />
            </div>

        </div>

        <div class="mb-a-blue d-flex mt-1">
            <div class="w-120p p-2">Schedule * </div>
            <div class="flex-grow-1 ">
                <RadzenDropDown 
                    Data="@weeklyHdrs"
                    TextProperty="Description"
                    ValueProperty="Id"
                    TValue="int?"
                    Value="@Hdr.AttSchedWeeklyHdrId"
                    ValueChanged="@((int? val) => OnTemplateChanged(val))"
                    Disabled="@IsLocked"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    Placeholder="-- Select Schedule --"
                    class="mb-input-accent"
                    Style="width:100%;" />
            </div>
        </div>

        <div class="d-flex mt-1">
            <div class="w-120p px-2"> Approver </div>
            <div class="w-150p "> 
                <RadzenTextBox 
                    @bind-Value="Hdr.EmpNumber_Approver"
                    Change="FetchApprover"
                    Disabled="@IsLocked"
                    MaxLength="5"
                    class="mb-input-accent"
                    Style="width: 100%;" />
            </div>
            <div class="mb-a-blue flex-grow-1 px-1 "> 
                <RadzenTextBox 
                    @bind-Value="Hdr.ApproverName"
                    Disabled
                    class="mb-input-accent"
                    Style="width: 100%;" />
            </div>
        </div>
        
        <div class="d-flex">
            <div class="w-120p p-2"> Remarks </div>
            <div class=" flex-grow-1 py-1 "> 
                <RadzenTextArea 
                    @bind-Value="Hdr.Remarks"
                    Disabled="@IsLocked"
                    MaxLength="120"
                    Rows="3"
                    class="mb-input-accent"
                    Style="width:100%;" />
            </div>
        </div>  

        @{ bool effWarn = Hdr.Effectivity != null && !IsEffectivityValid; }
        <div class="cs-note d-flex align-items-start gap-2 mt-2 @(effWarn ? "cs-note-warn" : "")">
            <i class="fa @(effWarn ? "fa-triangle-exclamation" : "fa-circle-info") mt-1"></i>
            <div>
                <span class="fw-bold">Note:</span>
                Effectivity must be at least 7 days in advance
                (on or after <span class="fw-bold">@MinEffectivity.ToString("MMM dd, yyyy")</span>).
            </div>
        </div>
    </div>


