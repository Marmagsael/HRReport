@inject IAtttemplateDataAccess          _atttemplate;
@inject IOEmpmasDataAccess              _empmas; 
@inject IAtttemplatereqhdrDataAccess    _attTemplateReqhdr; 
@inject IAtttemplatereqdtlDataAccess    _attTemplateReqdtl; 
@inject IAttschedweeklyhdrDataAccess   _weeklyHdr; 
@inject IAttschedweeklydtlDataAccess   _weeklyDtl; 
@inject ISettingsDataAccess             _settings; 
@inject IEmpmasInternalDataAccess       _empmasInternal; 
@inject I_10_EmpmasDataAccess           _empmasPis; 


@code {

    [Parameter] public  UserClaimsModel?    Uc          { get; set; } = new();   
    [Parameter] public  EventCallback       Ec          { get; set; } 
    V12_102CS   Cs = new();
    string saveRemarks = string.Empty; 
    AtttemplatereqhdrModel attTempReqHdr = new(); 
    
    
    
    protected override async Task OnInitializedAsync(){
        Cs.Atttemplatereqhdr = new();
        var res = await _atttemplate._02s(Uc.UserId, Uc.SchemaUserPis, Uc.Conn);
        if (res.Count > 0 ) {
            Cs.Atttemplate = res.FirstOrDefault()??new AtttemplateModel();
            AtttemplateModel? re = res.FirstOrDefault();
            Cs.Atttemplatereqdtl = AttTemplateReq_To_AttTemplate(re);
        }
        else { 
            var res1 = _atttemplate._02NoSchedule(Uc.UserId); 
            Cs.Atttemplate = res1;
        }

        weeklyHdrs = (await _weeklyHdr._02s(Uc.SchemaUserPis!, Uc.Conn!) ?? [])
                     .Where(x => x is not null).Cast<AttschedweeklyhdrModel>().ToList();

    }
    
    RadzenDatePicker<DateTime?>? dateRequestedPicker;

    void EcCatcher() {

    }

    void New() {
        Cs.Atttemplatereqhdr = new(); 
        Cs.Atttemplatereqdtl = new(); 
        //Cs.Atttemplatereqdtl = AttTemplateReq_To_AttTemplate(Cs.Atttemplate);
    }
    async Task Save() {
        try 
        {
            if (!await SaveCore()) return; 
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Saved", Detail = "Change schedule request has been saved.", Duration = 3000 }); 
        }
        catch (Exception ex) 
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save failed", Detail = ex.Message, Duration = 6000 }); 
        }
    }

    async Task<bool> SaveCore() {
        if(Hdr==null || Uc==null ) return false; 

        DateTime effectivity = Hdr.Effectivity??DateTime.MinValue; 
        List<AtttemplatereqhdrModel?>? res = await _attTemplateReqhdr._02ByUserId_ByEffectivity(Uc.UserId, effectivity, Uc.SchemaUserPis, Uc.Conn); 


        if(Hdr.Id == 0) {
            
            if (res != null && res.Count > 0)
            {
                saveRemarks = "Invalid Effectivity date."; 
                await _DialogService.Alert("Unable to proceed. A saved request with the same effectivity date already exists.",
                                            "Existing Request", new AlertOptions() { OkButtonText = "OK" });
                return false;
            }


            @* --- Save header ------------------------- *@
            AtttemplatereqhdrModel? h = Cs.Atttemplatereqhdr; 
            h.UserId = Uc.UserId; 
            h.EmpNumber = Uc.OempNumber; 
            h.Status = "S"; 

            AtttemplatereqhdrModel reshdr = await _attTemplateReqhdr._01_02(Hdr, Uc.SchemaUserPis, Uc.Conn); 
            Cs.Atttemplatereqhdr = reshdr; 

            @* --- Save Details -------------------------- *@
            AtttemplatereqdtlModel? d = Cs.Atttemplatereqdtl; 
            d.AtttemplateReqHdrId = reshdr.Id; 
            d.EmpmasId = Uc.UserId; 
            d.AttendanceTypeId = 1; // --- Fixed Punch Period  
            RD_To_0Sched(); 
            await _attTemplateReqdtl._01(DtlReq, Uc.SchemaUserPis, Uc.Conn); 
            List<AtttemplatereqdtlModel?>? resd = await _attTemplateReqdtl._02ByAtttemplateReqHdrId(reshdr?.Id??0, Uc.SchemaUserPis, Uc.Conn); 
            Cs.Atttemplatereqdtl = resd.FirstOrDefault()??new(); 


        }

        if(Hdr.Id > 0) {

            var r =res.FirstOrDefault(); 
            if (r?.Id is not null && r?.Id != Hdr.Id)
            {
                await _DialogService.Alert(
                    "Unable to update. A saved request with the same effectivity date already exists.",
                    "Existing Request",
                    new AlertOptions() { OkButtonText = "OK" });

                var res1 = await _attTemplateReqhdr._02s(Hdr.Id, Uc.SchemaUserPis, Uc.Conn); 

                Cs.Atttemplatereqhdr = res1.FirstOrDefault() ?? new();
                saveRemarks = "Invalid Effectivity date.";
                return false;
            }

            @* --- Update Header ----------------------- *@
