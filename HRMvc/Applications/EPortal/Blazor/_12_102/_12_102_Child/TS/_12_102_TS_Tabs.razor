<div class="w-100 mt-1 ">
   <div class="mb-tabs bordered-bottom-darkgreen">
        <div @onclick="@(()=>TabClick(1))" class="mb-tab mb-a-blue @(tab==1?" active " : "")">Punch Request</div>
        <div @onclick="@(()=>TabClick(2))" class="mb-tab mb-a-blue @(tab==2?" active " : "") ">OT Request</div>
        <div @onclick="@(()=>TabClick(3))" class="mb-tab mb-a-blue @(tab==3?" active " : "") ">Change Schedule</div>
    </div>
</div>



@code {

    int? tab = 1; 

    async Task TabClick(int? tno) {
        tab= tno; 
        //await Ec.InvokeAsync(tno); 
    }

}