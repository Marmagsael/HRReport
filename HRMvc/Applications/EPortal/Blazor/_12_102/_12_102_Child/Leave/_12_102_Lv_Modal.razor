@using HRMvc.Applications._00GeneralComponents
@using HRMvc.Applications.PayrollReport.Views.Blazor.Components

<CascadingValue Value="V" IsFixed="true">

@* === Show Request ================================================================ *@
@if(V.ShowMyReqquest) {
    
    <_00Modal ModuleCaption="Leave Request" ChildAction="@(()=>CloseModal())" > 
        <Content>
                @if (V.IsLoading)
                {
                    <div class="d-flex flex-column justify-content-center align-items-center gap-2" style="height: 200px;">
                        <i class="fa-solid fa-circle-notch fa-spin fa-2x text-primary"></i>
                        <small class="text-muted">Loading...</small>
                    </div>
                }
                else if (V.LeaveApplications != null && V.LeaveApplications.Any())
                {
                    <_12_102_Lv_Modal_Request ChildAction="ChildAction" />
                }
                else
                {
                    <div class="alert alert-info m-3" role="alert">
                        No leave applications found.
                    </div>
                }
            
        </Content>
    </_00Modal> 
}

@* === Send For Approval ================================================================ *@
@if(V.ShowPrint)
{
    <div class="w-100">
        <div class="text-end bordered-bottom p-2"> <button @onclick="CloseModal" class="btn btn-sm btn-outline-danger">x</button> </div>        

            <_ReportRenderer DataSource     ="@Rv.ReportData"
                        ReportRelativePath    ="@Rv.RelativePath"
                        OutputFormat          ="@Rv.SelectedFormat"
                        Parameters            ="@Rv.ReportParams"
                        AutoGenerate          ="@(Rv.ReportData?.Any() == true)"
                        RefreshToken          ="@Rv.RefreshToken" />


    </div>
}

@* === Cancel Request ================================================================ *@
@if(V.ShowCancel)
{
    <_00Modal ModuleCaption="Leave Cancel" ChildAction="CloseModal" > 
        <Content>

        </Content>
    </_00Modal> 
}
</CascadingValue>


@code {
    [Parameter] public UserClaimsModel  Uc              { get; set; }
    [Parameter] public V12_102Lv        V               { get; set; } = new();
    [Parameter] public V00_RepVars      Rv              { get; set; } = new();

    [Parameter] public EventCallback    ChildAction     { get; set; } 

    
    async Task CloseModal() {
        V.ShowMyReqquest        = false; 
        V.ShowSendForApproval   = false; 
        V.ShowCancel            = false; 
        V.ShowPrint             = false; 
        await ChildAction.InvokeAsync(); 

    }

}