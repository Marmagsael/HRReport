@using HRApiLibrary.DataAccess._10_Pis.Interface
@using Radzen
@using Radzen.Blazor

@* =====================================================================================
   OB ( Official Business ) Request  -  UI only
   TODO: Wire Save / Send / Cancel / Show Request once the OB table structure is final.
   ===================================================================================== *@

@if(msg.Length > 0) { <div class="text-primary p-2 border-bottom small"> @msg </div> }

<div class="d-flex gap-1 p-1 border-bottom ">
    <div @onclick="New" class="p-1 mb-cbtn mb-cbtn-gray card w-100p ">Clear Form </div>
    <div @onclick="Save" class="p-1 mb-cbtn mb-cbtn-blue card w-75p @(CanSave ? "" : " disabled-div ") "> Save </div>
    <div @onclick="SendForApproval" class="p-1 mb-cbtn mb-cbtn-blue card w-165p @(CanSend ? "" : " disabled-div ") "> Send For Approval </div>
    <div @onclick="CancelOB" class="p-1 mb-cbtn mb-cbtn-red card w-100p @(ob.Status=="S" ? "" : " disabled-div ")"> Cancel </div>
    <div @onclick="ShowMyRequest" class="p-1 mb-cbtn mb-cbtn-gray card w-140p "> Show My Request </div>
</div>

<div class="card-body p-0 @(IsLocked ? "" : " disabled-div-75 ")">
    <table class="table table-small table-bordered">
        <tbody>
            @* --- Control No. / Status ------------------------------------ *@
            <tr>
                <td class="w-150p p-2">
                    <div class="mt-1">TRN #</div>
                </td>
                <td class="p-2 d-flex justify-content-between">
                    <div class="border-bottom w-100p text-center p-1">
                        <h6> @(ob.Id < 1 ? "-" : ob.Id) </h6>
                    </div>
                    <div class="w-175p d-flex p-1">
                        <div> Status : </div>
                        <div class="ms-2 bordered-bottom text-center text-primary"> @_02Status(ob.Status) </div>
                    </div>
                </td>
            </tr>

            @* --- Date Filed ------------------------------------ *@
            <tr>
                <td class="w-150p align-middle">Date Filed<span class="txt-red">*</span></td>
                <td class="p-1">
                    <RadzenDatePicker @bind-Value="ob.DateApplied"
                        DateFormat="MM/dd/yyyy"
                        AllowInput="false"
                        class="mb-date-accent w-150p" />
                </td>
            </tr>

            @* --- Date Covered ------------------------------------ *@
            <tr>
                <td class="align-middle">Date Covered<span class="txt-red">*</span></td>
                <td class="p-1">
                    <div class="d-flex gap-2">
                        <div class="w-50p p-2 d-flex align-items-center">Start<span class="txt-red">*</span></div>
                        <div class="w-150p">
                            <RadzenDatePicker @bind-Value="ob.ObStart"
                                Change="PopulateDtls"
                                DateFormat="MM/dd/yyyy"
                                AllowInput="false"
                                class="mb-date-accent w-150p" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-1">
                        <div class="w-50p p-2 d-flex align-items-center">End<span class="txt-red">*</span></div>
                        <div class="w-150p">
                            <RadzenDatePicker @bind-Value="ob.ObEnd"
                                Change="PopulateDtls"
                                DateFormat="MM/dd/yyyy"
                                AllowInput="false"
                                class="mb-date-accent w-150p" />
                        </div>
                    </div>
                </td>
            </tr>

            @* --- Destination ------------------------------------ *@
            <tr>
                <td class="w-150p">Destination<span class="txt-red">*</span></td>
                <td class="p-1">
                    <RadzenTextArea @bind-Value="ob.Destination" MaxLength="150" Rows="2" Style="width:100%;" />
                </td>
            </tr>

            @* --- Purpose ------------------------------------ *@
            <tr>
                <td class="w-150p">Purpose<span class="txt-red">*</span></td>
                <td class="p-1">
                    <RadzenTextArea @bind-Value="ob.Purpose" MaxLength="250" Rows="3" Style="width:100%;" />
                </td>
            </tr>

            @* --- Contact Person ------------------------------------ *@
            <tr>
                <td class="w-150p">Contact Person</td>
                <td class="p-1">
                    <RadzenTextBox @bind-Value="ob.ContactPerson" MaxLength="100" Style="width:250px;" />
                </td>
            </tr>

            @* --- Contact # ------------------------------------ *@
            <tr>
                <td class="w-150p">Contact #<span class="txt-red">*</span></td>
                <td class="p-1">
                    <RadzenTextBox @bind-Value="ob.TelNo" MaxLength="45" Style="width:250px;" />
                </td>
            </tr>

            @* --- Remarks ------------------------------------ *@
            <tr>
                <td class="w-150p">Remarks</td>
                <td class="p-1">
                    <RadzenTextArea @bind-Value="ob.Remarks" MaxLength="250" Rows="2" Style="width:100%;" />
                </td>
            </tr>

            @* --- Approvers ------------------------------------ *@
            <tr>
                <td>Approvers</td>
                <td class="p-0">
                    <div class="w-100 d-flex">
                        @* --- First Approver *@
                        <div class="w-50 p-1">
                            <RadzenDropDown Data="@firstApprovers"
                                TextProperty="ApproverName"
                                ValueProperty="ApproverId"
                                @bind-Value="ob.Approver1Id"
                                Placeholder="First Approver"
                                Style="width:100%"
                                PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;" >
                                <Template Context="item">
                                    <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                        @item.ApproverName
                                    </div>
                                </Template>
                            </RadzenDropDown>
                            <div class="text-center">Approver</div>
                        </div>

                        @* --- Final Approver *@
                        <div class="w-50 p-1">
                            <RadzenDropDown Data="@finalApprovers"
                                TextProperty="ApproverName"
                                ValueProperty="ApproverId"
                                @bind-Value="ob.Approver2Id"
                                Placeholder="Final Approver"
                                Style="width:100%"
                                PopupStyle="min-height: 200px; max-height: 600px;  overflow-y: auto;" >
                                <Template Context="item">
                                    <div class="@(item.ApproverId == 0 ? " text-secondary text-opacity-50 " : "")">
                                        @item.ApproverName
                                    </div>
                                </Template>
                            </RadzenDropDown>
                            <div class="text-center">Final Approver <span class="text-danger">*</span></div>
                        </div>
                    </div>
                </td>
            </tr>

            @* --- Parameters ------------------------------------ *@
            <tr>
                <td>Parameter</td>
                <td>
                    <div class="d-flex gap-2">
                        <div class="text-primary">Days Count : </div>
                        <div class="text-center">@ob.Dtls.Count</div>
                        <div class="text-primary ms-3">Days With Pay : </div>
                        <div class="text-center">@DaysWithPay.ToString("N2")</div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@* --- OB Details ( one row per day ) ----------------------------------------- *@
<div class="@(IsLocked ? "" : " disabled-div-75 ")">
    <div class="card-header bg mb-a-green fw-bold">OB Details</div>

    <div class="card-body p-0">
        <div class="w-100 d-flex gap-1 py-2 border-bottom">
            <div class="w-130p text-center">Date</div>
            <div class="w-75p text-center text-primary">Day</div>
            <div class="w-75p text-center text-primary">Duty Type</div>
            <div class="w-155p text-center">Day Type</div>
            <div class="w-75p text-center">Payable</div>
        </div>

        @if(!ob.Dtls.Any()) {
            <div class="text-center text-danger small p-3"> Select the Date Covered to generate the OB details. </div>
        }

        @foreach(var d in ob.Dtls)
        {
            var isRD = d.DutyType == "RD";
            <div class="w-100 d-flex p-0 mt-1 gap-1 @(isRD ? " text-danger " : "")">
                <div class="w-130p @center_xy">@d.Date.ToString("MMM dd, yyyy")</div>
                <div class="w-75p @center_xy">@d.Date.ToString("ddd")</div>
                <div class="w-75p @center_xy">@d.DutyType</div>
                <div class="w-155p">
                    <RadzenDropDown
                        Data="@dayTypes"
                        TValue="int"
                        TextProperty="Name"
                        ValueProperty="Id"
                        @bind-Value="d.DayTypeId"
                        Change="@(_ => ApplyDayType(d))"
                        Style="width:150px" />
                </div>
                <div class="w-75p @center_xy">
                    <input class="form-check-input" type="checkbox" @bind="d.IsPayable" />
                </div>
            </div>
        }

    </div>
</div>


@code {
    [Parameter] public UserClaimsModel? Uc { get; set; } = new();

    // --- Temporary UI models; replace with the real OB model/DA once the table structure is given --- //
    class ObForm {
        public int          Id              { get; set; } = 0;
        public string       Status          { get; set; } = "N";
        public DateTime     DateApplied     { get; set; } = DateTime.Today;
        public DateTime     ObStart         { get; set; } = DateTime.Today;
        public DateTime     ObEnd           { get; set; } = DateTime.Today;
        public string?      Destination     { get; set; } = "";
        public string?      Purpose         { get; set; } = "";
        public string?      ContactPerson   { get; set; } = "";
        public string?      TelNo           { get; set; } = "";
        public int?         Approver1Id     { get; set; } = 0;
        public int?         Approver2Id     { get; set; } = 0;
        public string?      Remarks         { get; set; } = "";
        public List<ObDtl>  Dtls           { get; set; } = [];
    }
    class ObDtl {
        public DateTime     Date            { get; set; }
        public string?      DutyType        { get; set; } = "R";    // from schedule: R = working day, RD = rest day
        public DateTime?    SchedIn         { get; set; }
        public DateTime?    SchedOut        { get; set; }
        public int          DayTypeId       { get; set; } = 1;      // 1 Whole day, 2 First-Half, 3 Second-Half
        public DateTime?    TimeStart       { get; set; }
        public DateTime?    TimeEnd         { get; set; }
        public bool         IsPayable       { get; set; } = true;
    }
    record DayTypeItem(int Id, string Name);

    ObForm                          ob              = new();
    AtttemplateModel?               at              = null;
    List<LeavegrpapproverModel?>    firstApprovers  = [];
    List<LeavegrpapproverModel?>    finalApprovers  = [];
    List<DayTypeItem>   dayTypes        = [ new(1, "Whole day"), new(2, "First-Half"), new(3, "Second-Half") ];
    string              msg             = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        @* --- Employee schedule ( same source as "My Schedule Template" ) --- *@
        at = await _attTemplate._02(Uc?.UserId, Uc?.SchemaUserPis, Uc?.Conn) ?? _attTemplate._02NoSchedule(Uc?.UserId);
        PopulateDtls();

        @* --- Approvers ( same as Leave: LeaveGrpApprover, level 1 = first, level 2 = final ) --- *@
        var resApprovers = await _lvgrpApprover._02ByEmpmasId(Uc?.EmpmasId, Uc?.SchemaUserPis, Uc?.Conn) ?? [];

        firstApprovers = resApprovers.Where(a => a?.ApproverLevel == 1).ToList();
        firstApprovers.Insert(0, new() { ApproverId = 0, ApproverName = "No Assigned Approver" });

        finalApprovers = resApprovers.Where(a => a?.ApproverLevel == 2).ToList();
        finalApprovers.Insert(0, new() { ApproverId = 0, ApproverName = "No Assigned Approver" });
    }

    void New() { ob = new(); msg = string.Empty; PopulateDtls(); }

    void PopulateDtls()
    {
        var existing = ob.Dtls.ToDictionary(d => d.Date.Date);
        ob.Dtls = [];
        if (ob.ObStart.Date > ob.ObEnd.Date) return;

        for (var date = ob.ObStart.Date; date <= ob.ObEnd.Date; date = date.AddDays(1))
        {
            // keep what the user already typed for dates still in range
            if (existing.TryGetValue(date, out var keep)) { ob.Dtls.Add(keep); continue; }

            var (dutyType, inHHmm, lenHHmm) = _02Sched(date.DayOfWeek);
            var d = new ObDtl { Date = date, DutyType = dutyType };

            if (dutyType != "RD" && lenHHmm > 0) {
                d.SchedIn   = date + HHmm(inHHmm);
                d.SchedOut  = d.SchedIn + HHmm(lenHHmm);
            }
            d.IsPayable = dutyType != "RD";     // rest day is allowed but unchecked by default
            ApplyDayType(d);
            ob.Dtls.Add(d);
        }
    }

    @* --- Whole day = full schedule; First-Half / Second-Half = split the schedule in two --- *@
    void ApplyDayType(ObDtl d)
    {
        if (d.SchedIn is null || d.SchedOut is null) { d.TimeStart = null; d.TimeEnd = null; return; }

        var mid = d.SchedIn.Value + (d.SchedOut.Value - d.SchedIn.Value) / 2;
        (d.TimeStart, d.TimeEnd) = d.DayTypeId switch {
            2 => (d.SchedIn, mid),
            3 => (mid, d.SchedOut),
            _ => (d.SchedIn, d.SchedOut)
        };
    }

    (string? dutyType, int inHHmm, int lenHHmm) _02Sched(DayOfWeek dow) => dow switch {
        DayOfWeek.Sunday    => (at?.D1_dutytype, at?.D1_in ?? 0, at?.D1_hrslength ?? 0),
        DayOfWeek.Monday    => (at?.D2_dutytype, at?.D2_in ?? 0, at?.D2_hrslength ?? 0),
        DayOfWeek.Tuesday   => (at?.D3_dutytype, at?.D3_in ?? 0, at?.D3_hrslength ?? 0),
        DayOfWeek.Wednesday => (at?.D4_dutytype, at?.D4_in ?? 0, at?.D4_hrslength ?? 0),
        DayOfWeek.Thursday  => (at?.D5_dutytype, at?.D5_in ?? 0, at?.D5_hrslength ?? 0),
        DayOfWeek.Friday    => (at?.D6_dutytype, at?.D6_in ?? 0, at?.D6_hrslength ?? 0),
        _                   => (at?.D7_dutytype, at?.D7_in ?? 0, at?.D7_hrslength ?? 0),
    };

    @* --- Schedule values are stored as HHmm ints ( 800 = 08:00, 900 = 9h00m ) --- *@
    static TimeSpan HHmm(int v) => new(v / 100, v % 100, 0);

    // --- Stubs ( no table yet ) --- //
    void Save()             { ob.Status = "S"; msg = "UI only: OB table not yet connected. Nothing was saved."; }
    void SendForApproval()  { msg = "UI only: Send For Approval is not yet connected."; }
    void CancelOB()         { msg = "UI only: Cancel is not yet connected."; }
    void ShowMyRequest()    { msg = "UI only: Show My Request is not yet connected."; }

    double ComputeHours(ObDtl d)
    {
        if (d.TimeStart is null || d.TimeEnd is null) return 0;
        var hrs = (d.TimeEnd.Value.TimeOfDay - d.TimeStart.Value.TimeOfDay).TotalHours;
        if (hrs < 0) hrs += 24;     // schedule that crosses midnight
        return hrs;
    }
    double DaysWithPay => ob.Dtls.Where(d => d.IsPayable)
                                 .Sum(d => d.DayTypeId == 1 ? 1 : .5);

    string? _02Status(string? code) => code switch { "N" => "New", "S" => "Saved", "F" => "For Approval", "A" => "Approved", "C" => "Cancelled", _ => "Unknown" };
    string  center_xy => "d-flex justify-content-center align-items-center";

    bool IsLocked => ob.Status is "N" or "S";
    bool IsHdrValid => ob.ObEnd.Date >= ob.ObStart.Date
                    && ob.Dtls.Any()
                    && !string.IsNullOrWhiteSpace(ob.Destination)
                    && !string.IsNullOrWhiteSpace(ob.Purpose)
                    && !string.IsNullOrWhiteSpace(ob.TelNo);
    bool CanSave => IsLocked && IsHdrValid;
    bool CanSend => ob.Status is "S" && IsHdrValid && ob.Approver2Id > 0
                    && ob.Dtls.Where(d => d.IsPayable && d.DutyType != "RD").All(d => ComputeHours(d) > 0);
}

@inject IAtttemplateDataAccess      _attTemplate
@inject ILeavegrpapproverDataAccess _lvgrpApprover
