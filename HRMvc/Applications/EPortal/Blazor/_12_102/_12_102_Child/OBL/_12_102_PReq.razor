@using HRApiLibrary.Models._10_Pis
@inject DialogService _DialogService
<RadzenDialog />


@* <div> V.Attreqhdrs?.Count : @V.Attreqhdrs?.Count ** V.ShowPartiallyApproved_PR : @V.ShowPartiallyApproved_PR</div> *@

@if(ShowModal) { <div> <_12_102_PReq_Modal V="@V" Ec="EC_Catcher" />  </div> }


<div class="card b-blue">
    <div class="card-header p-0  ">
        <div class="bordered-bottom py-2 small fw-bold text-white bg mb-a-blue px-2  ">
            Punch Request
        </div>

        <div class="p-1 d-flex gap-2 small ">
            <button @onclick="MarkAll" class="btn text-primary w-80p bordered-bottom p-1 @markAllCss ">Mark All </button>
            <button @onclick="UnmarkAll"  class="btn text-primary w-90p bordered-bottom p-1 @unmarkAllCss ">Unmark All </button>
            <div class="w-10p bordered-left">&nbsp; </div>
            <button @onclick="Approve_PR" class="btn text-successw  w-130p bordered-bottom p-1 @noSelectedCss ">Approve Selected </button>
            <button @onclick="PartiallyApprove" class="btn text-success w-130p bordered-bottom p-1 @noSelectedCss ">Partially Approve </button>
            
        </div>
    </div>

    @if (V.ShowPartiallyApproved_PR && SelectedRec>0) { <_12_102_PReq_Modal_PartiallyApprove V="@V" Ec="@EC_Catcher1" /> }

    <div class="card-body">
        
        <div class="d-flex gap-2 small fw-bold border-bottom  py-1">
            <div class="w-200p">Requestor</div>
            <div class="w-50p">TRN</div>
            <div class="w-100p">Requested</div>
            <div class="d-flex flex-grow-1 ">Remarks</div>
            
        </div>

        @foreach(var r in V.Attreqhdrs) {
            <div class="d-flex gap-2 mt-1">
                <div class="w-200p py-1 d-flex gap-1">
                    <div>
                        <RadzenCheckBox @bind-Value=@r.IsSelected  TValue="bool?" />
                    </div>
                    <div>@r.RequestorName</div>
                </div>
                <div class="w-50p" py-1>@r.Id</div>
                <div class="w-100p py-1">@r.DateRequested.ToShortDateString()</div>
                <div class="d-flex flex-grow-1 ">
                    <div class="w-75 py-1">@r.Remarks</div>
                    <div class="w-25">
                        <button @onclick="()=>ShowDtl(r)" class="btn btn-outline-secondary">Show Details</button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>


@inject IAttreqdtlDataAccess _attreqdtl; 
@inject IAttreqhdrDataAccess _attreqhdr; 


@code {
    [CascadingParameter]    public UserClaimsModel          Uc          { get; set; } = new(); 
    [Parameter]             public V12_102Obligation        V           { get; set; } = new();

    bool                    ShowModal       = false; 
    bool                    ShowProcessing  = false;


    bool isMarkAll => (V.Attreqhdrs.Where(a=>a.IsSelected==true).ToList().Count == V.Attreqhdrs.Count ); 
    string? markAllCss => isMarkAll ? " disabled-div " : " ";
    bool isUnmarkAll => (V.Attreqhdrs.Where(a=>a.IsSelected==false).ToList().Count == V.Attreqhdrs.Count ); 
    string? unmarkAllCss => isUnmarkAll ? " disabled-div " : " ";
    
    bool isNoSelected => (V.Attreqhdrs.Where(a=>a.IsSelected==true).ToList().Count > 0 ); 
    string? noSelectedCss => !isNoSelected ? " disabled-div " : " ";

    int     SelectedRec => V.Attreqhdrs?.Count??0 ; 


    @* --- Functions --------------------------------------------------------------------------------- *@
    void PartiallyApprove() { V.ShowPartiallyApproved_PR = true; }

    async Task Approve_PR() {
        var result = await _DialogService.Confirm("Approve selected punch IN/OUT Request?", "Confirm", 
                            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" } );
        if (result == true)
        {
            ShowProcessing = true; 
            foreach(var h in V.Attreqhdrs.Where(hdr => hdr.IsSelected==true)) {
                await _attreqhdr._03Approve(h, Uc.OempNumber,Uc.UserId??0, Uc.SchemaUserPis, Uc.Conn); 
            }

            V.Attreqhdrs = []; 
            var res = await _attreqhdr._02ForApproval_PerApprover(Uc.OempNumber, Uc.SchemaUserPis, Uc.Conn); 
            if(res!=null && res.Count>0) V.Attreqhdrs =res!; 
            StateHasChanged(); 

            ShowProcessing = false;
        }
    }

    async Task EC_Catcher1() { 
        if (V.Action == "ClosePR")                  ClosePA_PR(); 
        if (V.Action == "PR_PartiallyApproved")     await PartiallApprove_PR();
        V.Action=string.Empty; 
    }

    async Task PartiallApprove_PR() {
        
        V.Attreqhdrs = [];        
        List<AttreqhdrModel?>? res = await _attreqhdr._02ForApproval_PerApprover(Uc.OempNumber, Uc.SchemaUserPis, Uc.Conn);
        if (res != null && res.Count > 0) V.Attreqhdrs = res!;
        StateHasChanged(); 

    }

    void ClosePA_PR() { V.ShowPartiallyApproved_PR = false;  }

    async Task ShowDtl(AttreqhdrModel h) {
        var res = await _attreqdtl._02ByAttReqHdrIds(h.Id, Uc.SchemaUserPis, Uc.Conn); 
        V.Attreqdtls = []; 
        if (res!=null && res.Count > 0) {
            V.Attreqdtls    = res!;
            V.Attreqhdr     = h; 
        }

        ShowModal = true; 
    }

    void EC_Catcher(bool ans) {
        
        
        
        
        ShowModal = ans; 
    }

    void MarkAll() { V.Attreqhdrs.ForEach(a=> {a.IsSelected=true; });  }
    void UnmarkAll() { V.Attreqhdrs.ForEach(a=> {a.IsSelected=false; });  }

    

}
