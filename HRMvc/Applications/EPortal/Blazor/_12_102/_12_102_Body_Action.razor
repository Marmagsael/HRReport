<div class="card w-100">
    <_12_102_Cardhdr caption="Actions and Schedules" /> 
    
    @if(V12_102.Attpunches1_Wo_Out.Count < 1 )
    {
        <div class="card-body">
            <div class="alert alert-success m-0 p-2" role="alert">
                <strong>No actions needed!</strong> 
            </div>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="alert alert-warning m-0 p-2" role="alert">
                <strong>Warning!</strong> You have @V12_102.Attpunches1_Wo_Out.Count punch(es) without an OUT time. 
            </div>
        </div>

        
    }
    
</div>

        

@code {

    [Parameter] public V12_102?                 V12_102     { get; set; } = new();
    

}