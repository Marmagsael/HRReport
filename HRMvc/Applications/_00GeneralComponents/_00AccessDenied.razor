<div style="
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    padding: 2rem;
    background-color: #F4F6F8;
">
    <section style="
        width: 100%;
        max-width: 520px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        padding: 3rem 2.5rem 2.5rem;
        background-color: #FFFFFF;
        border: 1px solid #E1E6EB;
        border-radius: 20px;
        box-shadow: 0 1px 2px rgba(20,32,43,0.04), 0 12px 32px rgba(20,32,43,0.06);
    ">
        <svg width="132" height="132" viewBox="0 0 132 132" fill="none" role="img" aria-label="Access denied">
            <circle cx="66" cy="66" r="64" fill="#E6F2F0" />
            <circle cx="66" cy="66" r="46" fill="#CFE6E2" />
            <path d="M66 28l28 10v22c0 17-11 30-28 38-17-8-28-21-28-38V38z" fill="#0F766E" />
            <rect x="53" y="60" width="26" height="22" rx="5" fill="#FFFFFF" />
            <path d="M58 60v-6a8 8 0 0116 0v6" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" />
            <circle cx="66" cy="71" r="3" fill="#0F766E" />
        </svg>

        <span style="
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #B42318;
            background-color: #FDECEA;
            padding: 0.4rem 0.8rem;
            border-radius: 999px;
        ">
            Error 403
        </span>

        <h1 style="
            margin: 0;
            font-size: 2.1rem;
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: #14202B;
        ">
            Access denied
        </h1>

        <p style="
            margin: 0;
            font-size: 1rem;
            color: #4A5868;
            max-width: 400px;
            line-height: 1.6;
        ">
            @if (!string.IsNullOrWhiteSpace(Module))
            {
                <span>You don’t have permission to open <strong>@Module</strong>.</span>
            }
            else
            {
                <span>You don’t have permission to open this module.</span>
            }
            If you think this is a mistake, ask your administrator to grant you access.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 0.75rem;">

            <button type="button"
                    style="min-height: 44px; padding: 0 1.4rem; border: 0; border-radius: 10px; background-color: #0F766E; color: #FFFFFF; font-weight: 600; font-size: 0.95rem; cursor: pointer;">
                Request access
            </button>

            <button type="button"
                    onclick="history.back()"
                    style="min-height: 44px; padding: 0 1.4rem; border: 1px solid #C9D1D9; border-radius: 10px; background-color: #FFFFFF; color: #14202B; font-weight: 600; font-size: 0.95rem; cursor: pointer;">
                Go back
            </button>
        </div>

        <a href="/12/102" style="margin-top: 0.5rem; font-size: 0.875rem; color: #4A5868;">Return to dashboard</a>
    </section>
</div>

@code {
    [Parameter]
    public string? Module { get; set; }

    // Optional: when provided, a "Request access" button is shown.
    [Parameter]
    public EventCallback OnRequestAccess { get; set; }
}
