
<div style="
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    padding: 2rem;
    text-align: center;
    background-color: #f9f9f9;
">
    <img src="images/access-denied.png"
         alt="Access Denied"
         style="width: 250px; margin-bottom: 1.5rem;" />

    <h1 style="
        font-size: 2.5rem;
        color: #c0392b;
        margin-bottom: 1rem;
    ">
        Access Denied
    </h1>

    <p style="
        font-size: 1.2rem;
        color: #555;
        max-width: 500px;
        margin-bottom: 1rem;
    ">
        You do not have the necessary permissions to access this module.
        Please contact your administrator to request access.
    </p>
</div>

@code {
    [Parameter]
    public string? Module { get; set; }
}
