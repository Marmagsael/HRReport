@if (Rv.Isloaded)
{
    <div class="loading-overlay">
        <div class="loading-content">
            <i class="fa-solid fa-hourglass-half fa-spin fa-2x text-success"></i>
            <p>Loading data...</p>
        </div>
    </div>
}

@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
}


<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.3); 
        z-index: 9999; 
    }

    .loading-content {
        background: white;
        padding: 20px 30px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
    }
</style>
