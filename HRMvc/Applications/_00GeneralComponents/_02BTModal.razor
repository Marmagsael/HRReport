@using HRMvc.Applications.PayrollReport.Views.Blazor.Components


@if(ShowModal) { 
    <div id="mb-modal" class="">
        <div id="mb-modal-content">
            
             <div class="modal-header  bg-opacity-75">
                <h1 class="modal-title fs-5" >@MCaption</h1>
                <button type="button" class="btn-close" @onclick="@(()=>ShowHideModal(false))" data-bs-dismiss="modal" aria-label="Close"></button>
            </div> 

            <div>

                @Details  


            </div>
            
        </div>
    </div>
}


@code {

    [Parameter] public string?                  MCaption        { get; set; }
    [Parameter] public RenderFragment?          Details         { get; set; }
    [Parameter] public bool                     ShowModal       { get; set; } = false; 
    [Parameter] public EventCallback<bool>      ChildAction     { get; set; } 

    async Task ShowHideModal(bool action)   { await ChildAction.InvokeAsync(action);  }

}
