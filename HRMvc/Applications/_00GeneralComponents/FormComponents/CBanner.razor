<div class="d-flex align-items-center gap-3 rounded-3 px-3 py-2"
     style="background-color:@BgColor;">

@* <div style="width:32px; height:32px; min-width:32px; border-radius:50%; background-color:@IconBgColor; display:flex; align-items:center; justify-content:center;">
        <TelerikFontIcon Icon="@Icon" Size="@ThemeConstants.FontIcon.Size.Small" />
    </div>  *@

    <div class="k-d-flex k-flex-col">
        <span class="k-font-weight-semibold k-fs-sm k-text-body">
            @Title
        </span>

        <span class="k-fs-xs k-text-subtle">
            @Message
        </span>
    </div>

</div>




@code {

    public enum BannerColor
    {
        Info,
        Success,
        Warning,
        Error
    }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public FontIcon Icon { get; set; } = FontIcon.CheckCircle;

    [Parameter]
    public BannerColor Theme { get; set; } = BannerColor.Info;

    private string BgColor => Theme switch
    {
        BannerColor.Success => "#ecfdf5",
        BannerColor.Warning => "#fffbeb",
        BannerColor.Error => "#fef2f2",
        _ => "#eaf1ff"
    };

    private string IconBgColor => Theme switch
    {
        BannerColor.Success => "#10b981",
        BannerColor.Warning => "#f59e0b",
        BannerColor.Error => "#ef4444",
        _ => "#2563eb"
    };

}

   