<TelerikMediaQuery Media="(max-width: 767px)"
                   OnChange="@((bool matches) => IsMobile = matches)" />

<TelerikStackLayout Orientation="@(IsMobile
                                                            ? StackLayoutOrientation.Vertical
                                                            : StackLayoutOrientation.Horizontal)"
                    VerticalAlign="@StackLayoutVerticalAlign.Center"
                    Spacing="8px"
                    Class="@($"cform-field mb-3 {Class}")">

    <label for="@Id"
           class="k-label k-form-label cform-label">
        @Label
    </label>

    <div class="cform-control">
        @ChildContent
    </div>

</TelerikStackLayout>

@code {
    private bool IsMobile;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public string? Class { get; set; }
}

<style>
    /* =========================
    BASE
    ========================= */

    .cform-field {
        width: 100%;
    }

    .cform-label {
        width: 150px;
        min-width: 150px;
        flex: 0 0 150px;
        font-size: 1em;
        font-weight: 500;
    }

    .cform-control {
        min-width: 0;
    }


    .cfield-invalid,
    .cfield-invalid.k-input,
    .cfield-invalid.k-textbox,
    .cfield-invalid .k-input-inner {
        border-color: #dc3545 !important;
    }

    .cfield-invalid:focus-within {
        box-shadow: 0 0 0 0.15rem rgba(220, 53, 69, 0.15) !important;
    }

    /* =========================
    MOBILE
    ========================= */

    @@media (max-width: 767px) {

        .cform-label {
            width: 100%;
            min-width: 0;
            flex: none;
        }

        .cform-control {
            width: 100%;
        }
    }


    /* =========================
    TABLET
    ========================= */

    @@media (min-width: 768px) and (max-width: 991px) {

        .cform-label {
            width: 120px;
            min-width: 120px;
            flex: 0 0 120px;
        }
    }


    /* =========================
    DESKTOP
    ========================= */

    @@media (min-width: 992px) and (max-width: 1199px) {

        .cform-label {
            width: 130px;
            min-width: 130px;
            flex: 0 0 130px;
        }
    }


    /* =========================
    LARGE DESKTOP
    ========================= */

    @@media (min-width: 1200px) {

        .cform-label {
            width: 150px;
            min-width: 150px;
            flex: 0 0 150px;
        }
    }
</style>