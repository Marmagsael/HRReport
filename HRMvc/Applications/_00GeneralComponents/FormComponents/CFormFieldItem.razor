<FormItem Field="@Field">

    <Template>

        <div class="d-flex flex-column flex-md-row gap-2 gap-lg-3">

            <label for="@Id"
                   class="k-label k-form-label cform-label">
                @Label
            </label>

            <div class="k-form-field-wrap cform-control @Class">
                @ChildContent
            </div>

        </div>

    </Template>

</FormItem>


@code {

    [Parameter, EditorRequired]
    public string Field { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public string? Class { get; set; }

}

<style>

   
    .cform-control {
        width: 100%;
        min-width: 0;
    }

    .cform-label {
        width: 100%;
        padding-top: 0;
    }

    .form-full,
    .form-half,
    .form-third,
    .form-quarter {
        width: 100%;
    }



    @@media (min-width: 768px) and (max-width: 991px) {

        .cform-label {
            width: 120px;
            min-width: 120px;
            flex: 0 0 120px;
            padding-top: 8px;
        }

        .form-half {
            width: 60%;
        }

        .form-third {
            width: 40%;
        }

        .form-quarter {
            width: 30%;
        }
    }


    @@media (min-width: 992px) and (max-width: 1199px) {

        .cform-label {
            width: 130px;
            min-width: 130px;
            flex: 0 0 130px;
            padding-top: 8px;
        }

        .form-half {
            width: 50%;
        }

        .form-third {
            width: 33.333%;
        }

        .form-quarter {
            width: 25%;
        }
    }


   
    @@media (min-width: 1200px) {

        .cform-label {
            width: 150px;
            min-width: 150px;
            flex: 0 0 150px;
            padding-top: 8px;
        }

        .form-half {
            width: 40%;
        }

        .form-third {
            width:30%;
        }

        .form-quarter {
            width: 22%;
        }
    }

</style>
