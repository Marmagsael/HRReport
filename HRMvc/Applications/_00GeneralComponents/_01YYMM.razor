@{ var cp = ClassParams; }

<div class="d-flex flex-column gap-1">

    @* --- Year ------------------------------ *@
    <div class="flex">
        <div class="@cp["CYear"]">Year</div>
        <div class="@cp["DDYear"]">
            <RadzenDropDown Data="@Rv.Years"
                            TextProperty="Name"
                            ValueProperty="Year"
                            @bind-Value="Rv.Year"
                            Change="@(_ => ValueChanged())"
                            Placeholder="Year"
                            Style="width:100%" />
        </div>
    </div>
   

    @* --- Month ----------------------------- *@
    <div class="flex">
        <div class="@cp["CMonth"]">Month</div>
        <div class="@cp["DDMonth"]">
            <RadzenDropDown Data="@Rv.Months"
                            TextProperty="Name"
                            ValueProperty="Code"
                            @bind-Value="Rv.Month"
                            Change="@(_ => ValueChanged())"
                            Placeholder="Month"
                            Style="width:100%" />
        </div>
    </div>
   

</div>



@code {
    
    [Parameter] public V00_RepVars                  Rv              { get; set; } = new(); 
    [Parameter] public EventCallback<V00_RepVars>   ChildAction     { get; set; } = new();
    public Dictionary<string, object>               ClassParams     { get; set; } = new()
    {
        ["CYear"]       = " p-2 w-50p ",
        ["DDYear"]      = " w-120p ",
        
        ["CMonth"]      = " p-2 w-70p ",
        ["DDMonth"]     = " w-175p ",
        
        ["CPeriod"]     = " p-2 w-75p ",
        ["DDPeriod"]    = " w-75p ",

    };

    async Task ValueChanged() {
        await ChildAction.InvokeAsync(Rv); 
    }



}