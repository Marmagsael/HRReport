@{ var cp = ClassParams; }

<div class="d-flex gap-2">

    @* --- Year ------------------------------ *@
    <div class="@cp["CYear"]">Year</div>
    <div class="@cp["DDYear"]">
        <RadzenDropDown
            Data="@Rv.Years"
            TextProperty="Name"
            ValueProperty="Year"
            @bind-Value="Rv.Year"
            Change="@(_ => ValueChanged())"
            Placeholder="Year"
            Style="width:100%" />
    </div>

    @* --- Month ----------------------------- *@
    <div class="@cp["CMonth"]">Month</div>
    <div class="@cp["DDMonth"]">
        <RadzenDropDown
            Data="@Rv.Months"
            TextProperty="Name"
            ValueProperty="Code"
            @bind-Value="Rv.Month"
            Change="@(_ => ValueChanged())"
            Placeholder="Month"
            Style="width:100%" />
    </div>

</div>



@code {
    
    [Parameter] public V00_RepVars                  Rv              { get; set; } = new(); 
    [Parameter] public EventCallback<V00_RepVars>   ChildAction     { get; set; } = new();
    public Dictionary<string, object>               ClassParams     { get; set; } = new()
    {
        ["CYear"]       = " p-2 w-75p ",
        ["DDYear"]      = " w-125p ",
        
        ["CMonth"]      = " p-2 w-75p ",
        ["DDMonth"]     = " w-125p ",
        
        ["CPeriod"]     = " p-2 w-75p ",
        ["DDPeriod"]    = " w-75p ",

    };

    async Task ValueChanged() {
        await ChildAction.InvokeAsync(Rv); 
    }



}