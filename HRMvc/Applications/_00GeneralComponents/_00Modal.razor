<div class="msds-modal ">
    <div class="msds-modal-content"
         style="@(Maximized ? "width: 100%; max-width: 100%; margin: 0; top: 0;" : $"width: {ModalWidth}; max-width: 95vw;")">


        <div class="modal-content bg-opacity-75">

            <div class="modal-header bg-opacity-75">
                <h1 class="modal-title fs-5">@ModuleCaption</h1>

                <button type="button"
                        class="btn-close"
                        @onclick="@(() => ShowHideModal(false))"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body overflow-auto">
                @Content
            </div>

            <div class="modal-footer p-0">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="@(() => ShowHideModal(false))"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<bool> ChildAction { get; set; }

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public string? ModuleCaption { get; set; } = "Module Caption";

    [Parameter]
    public string ModalWidth { get; set; } = "1180px";

    // --- true : full width, top 0 ( e.g. report printing ); ModalWidth is ignored
    [Parameter]
    public bool Maximized { get; set; } = false;

    private async Task ShowHideModal(bool action)
    {
        await ChildAction.InvokeAsync(action);
    }
}
