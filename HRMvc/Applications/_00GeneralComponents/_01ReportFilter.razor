
    <RadzenRadioButtonList @bind-Value="Rv.SelectedFilter"
                           Data="@Rv.DataFilters"
                           TextProperty="Name"
                           ValueProperty="Code"
                           TValue="int"
                            Orientation="@Orientation"
                           Change="@(_ =>ValueChanged())" />


@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public EventCallback<object> ChildAction { get; set; } = new();
    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFilter);
    }
}
