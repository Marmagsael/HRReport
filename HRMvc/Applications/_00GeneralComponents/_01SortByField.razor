<button class="btn btn-link p-0 text-decoration-none shadow-none" @onclick="@(() => SortBy(ColName, "asc"))"><i class="fa fa-arrow-up"></i></button>
<button class="btn btn-link p-0 text-decoration-none shadow-none" @onclick="@(() => SortBy(ColName, "desc"))"><i class="fa fa-arrow-down"></i></button>


@code {

    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public string ColName { get; set; } = string.Empty;
    [Parameter] public EventCallback<V00_RepVars> ChildAction { get; set; } = new();


    async Task SortBy(string fld, string odr)
    {
        Rv.SortFld = fld;
        Rv.SortOdr = odr;

        await ChildAction.InvokeAsync(Rv);
    }

}