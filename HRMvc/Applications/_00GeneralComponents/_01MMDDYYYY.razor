@{
    var cp = ClassParams;
}

<div class="d-flex gap-1 @cp.GetValueOrDefault("FlexDirection") ">

    <div class="d-flex gap-1">
        <div class="@cp.GetValueOrDefault("CStart")" style="min-width:@cp.GetValueOrDefault("CStartMin")">Start</div>
        <div class="@cp.GetValueOrDefault("DStart")" style="min-width:@cp.GetValueOrDefault("DStartMin")">
            <RadzenDatePicker @bind-Value="@Rv.DStart"
                              DateFormat="MM/dd/yyyy"
                              Change="@(_ => ValueChanged())"
                              Style="width:100%" />
        </div>
    </div>
    

    <div class="d-flex gap-1">
        <div class="@cp.GetValueOrDefault("CEnd")" style="min-width:@cp.GetValueOrDefault("CEndMin")">End</div>
        <div class="@cp.GetValueOrDefault("DEnd")" style="min-width:@cp.GetValueOrDefault("DEndMin")">
            <RadzenDatePicker @bind-Value="@Rv.DEnd"
                              DateFormat="MM/dd/yyyy"
                              Min="@Rv.DStart"
                              Change="@(_ => ValueChanged())"
                              Style="width:100%" />
        </div>
    </div>
    
    
</div>

@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public EventCallback<V00_RepVars> ChildAction { get; set; } = new();

    [Parameter]
    public Dictionary<string, object> ClassParams { get; set; } = new()
    {


        ["FlexDirection"] = "",

        ["CStart"] = " p-2 w-60p text-end",
        ["DStart"] = " w-160p ",
        ["CStartMin"] = "",
        ["DStartMin"] = "auto",

        ["CEnd"] = " p-2 w-60p text-end",
        ["DEnd"] = " w-160p ",
        ["CEndMin"] = "",
        ["DEndMin"] = "auto",
    };

    protected override void OnParametersSet()
    {
        if (ClassParams.GetValueOrDefault("FlexDirection")?.ToString() == "flex-column")
        {
            ClassParams["CStart"] = " py-2 w-60p";
            ClassParams["CStartMin"] = "80px";
            ClassParams["DStart"] = "w-160p";
            ClassParams["DStartMin"] = "0px";

            ClassParams["CEnd"] = " py-2 w-60p";
            ClassParams["CEndMin"] = "80px";
            ClassParams["DEnd"] = " w-160p";
            ClassParams["DEndMin"] = "0px";
        }
    }
    async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv);
    }
}
