
<RadzenDropDown TValue="string"
                Data="@Rv.ReportFormats"
                @bind-Value="Rv.SelectedFormat"
                Placeholder="Select output"
                Change="@(_ => ValueChanged())" />


@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public EventCallback<string> ChildAction { get; set; } = new();

    async Task ValueChanged()
    {
        await ChildAction.InvokeAsync(Rv.SelectedFormat);
    }
}
