
<div>
    <RadzenDropDown TValue="string"
                    Data="@Rv.ReportFormats"
                    @bind-Value="Rv.SelectedFormat"
                    Placeholder="Select output"
                    Change="@ValueChanged"
                    class="margin-0"/>
</div>


@code {
    [Parameter] public V00_RepVars Rv { get; set; } = new();
    [Parameter] public EventCallback<object> ChildAction { get; set; } = new();

    async Task ValueChanged()
    {
        Rv.ShowReport = false;
        Rv.ReportData = [];
        await ChildAction.InvokeAsync(Rv);
    }
}
<style>
    .rz-radio-btn{
        margin: .5rem 0 !important; 
    }
</style>